import enum
from collections.abc import Mapping
from typing import Any

gAppKitAvailable: bool

class MissingDependency(ImportError): ...

class ColorSpace(enum.Enum):
    SRGB = "sRGB"
    CALIBRATED = "Calibrated"
    P3 = "P3"

class Color:
    def __init__(
        self,
        r: int = 0,
        g: int = 0,
        b: int = 0,
        a: int = 255,
        color_space: ColorSpace = ...,
    ) -> None: ...
    @staticmethod
    def from_trigger(s: str) -> Color | None: ...
    @staticmethod
    def from_hex(s: str) -> Color | None: ...
    @staticmethod
    def from_cocoa(b: str) -> Color | None: ...
    @staticmethod
    def from_legacy_trigger(s: str) -> tuple[Any, Any]: ...
    @property
    def red(self) -> int: ...
    @red.setter
    def red(self, value: int) -> None: ...
    @property
    def green(self) -> int: ...
    @green.setter
    def green(self, value: int) -> None: ...
    @property
    def blue(self) -> int: ...
    @blue.setter
    def blue(self, value: int) -> None: ...
    @property
    def alpha(self) -> int: ...
    @alpha.setter
    def alpha(self, value: int) -> None: ...
    @property
    def color_space(self) -> ColorSpace: ...
    @color_space.setter
    def color_space(self, value: ColorSpace) -> None: ...
    def get_dict(self) -> dict[str, Any]: ...
    def from_dict(self, input_dict: Mapping[str, Any]) -> None: ...
    @property
    def json(self) -> str: ...
    @property
    def hex(self) -> str: ...
