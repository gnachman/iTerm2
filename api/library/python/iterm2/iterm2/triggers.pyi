    @property
    def encode(self) -> dict[str, Any]: ...
    def toJSON(self) -> str: ...
    @staticmethod
    def deserialize(action_name: str, param: Any, enabled: bool, event_params: Mapping[str, Any] | None, action_classes: Mapping[str, type[Trigger]]) -> EventTrigger: ...

