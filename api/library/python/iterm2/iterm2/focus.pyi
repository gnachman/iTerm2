import enum
from types import TracebackType
from typing import Self

from . import api_pb2
from .connection import Connection

class FocusUpdateApplicationActive:
    def __init__(self, active: bool) -> None: ...
    @property
    def application_active(self) -> bool: ...

class FocusUpdateWindowChanged:
    class Reason(enum.Enum):
        TERMINAL_WINDOW_BECAME_KEY = 0
        TERMINAL_WINDOW_IS_CURRENT = 1
        TERMINAL_WINDOW_RESIGNED_KEY = 2

    def __init__(self, window_id: str, event: Reason) -> None: ...
    @property
    def window_id(self) -> str: ...
    @property
    def event(self) -> Reason: ...

class FocusUpdateSelectedTabChanged:
    def __init__(self, tab_id: str) -> None: ...
    @property
    def tab_id(self) -> str: ...

class FocusUpdateActiveSessionChanged:
    def __init__(self, session_id: str) -> None: ...
    @property
    def session_id(self) -> str: ...

class FocusUpdate:
    def __init__(
        self,
        application_active: FocusUpdateApplicationActive | None = None,
        window_changed: FocusUpdateWindowChanged | None = None,
        selected_tab_changed: FocusUpdateSelectedTabChanged | None = None,
        active_session_changed: FocusUpdateActiveSessionChanged | None = None,
    ) -> None: ...
    @property
    def application_active(self) -> None | FocusUpdateApplicationActive: ...
    @property
    def window_changed(self) -> None | FocusUpdateWindowChanged: ...
    @property
    def selected_tab_changed(self) -> None | FocusUpdateSelectedTabChanged: ...
    @property
    def active_session_changed(self) -> None | FocusUpdateActiveSessionChanged: ...

class FocusMonitor:
    def __init__(self, connection: Connection) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        _tb: TracebackType | None,
    ) -> None: ...
    async def async_get_next_update(self) -> FocusUpdate: ...
    def handle_proto(self, proto: api_pb2.FocusChangedNotification) -> FocusUpdate: ...
