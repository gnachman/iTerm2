from collections.abc import Mapping
from typing import Any

from . import api_pb2

class Size:
    def __init__(self, width: int, height: int) -> None: ...
    @property
    def width(self) -> int: ...
    @width.setter
    def width(self, value: int) -> None: ...
    @property
    def height(self) -> int: ...
    @height.setter
    def height(self, value: int) -> None: ...
    @property
    def dict(self) -> dict[str, int]: ...
    def load_from_dict(self, dictionary: Mapping[str, int]) -> None: ...
    @property
    def json(self) -> str: ...
    @property
    def proto(self) -> api_pb2.Size: ...

class Point:
    def __init__(self, x: int, y: int) -> None: ...
    @staticmethod
    def from_coord_proto(proto: api_pb2.Coord) -> Point: ...
    @property
    def x(self) -> int: ...
    @x.setter
    def x(self, value: int) -> None: ...
    @property
    def y(self) -> int: ...
    @y.setter
    def y(self, value: int) -> None: ...
    @property
    def dict(self) -> dict[str, int]: ...
    def load_from_dict(self, dict: Mapping[str, int]) -> None: ...
    @property
    def json(self) -> str: ...
    @property
    def proto(self) -> api_pb2.Coord: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Frame:
    def __init__(self, origin: Point = ..., size: Size = ...) -> None: ...
    @property
    def origin(self) -> Point: ...
    @origin.setter
    def origin(self, value: Point) -> None: ...
    @property
    def size(self) -> Size: ...
    @size.setter
    def size(self, value: Size) -> None: ...
    def load_from_dict(self, dict: Mapping[str, Mapping[str, int]]) -> None: ...
    @property
    def dict(self) -> dict[str, dict[str, int]]: ...
    @property
    def json(self) -> str: ...

def frame_str(frame: Frame | None) -> str: ...
def size_str(size: Size | None) -> str: ...
def point_str(point: Point | None) -> str: ...
def distance(point_a: Point, point_b: Point, grid_width: int) -> int: ...

class CoordRange:
    def __init__(self, start: Point, end: Point) -> None: ...
    @staticmethod
    def from_proto(proto: api_pb2.CoordRange) -> CoordRange: ...
    @property
    def start(self) -> Point: ...
    @property
    def end(self) -> Point: ...
    @property
    def proto(self) -> api_pb2.CoordRange: ...
    def length(self, width: int) -> int: ...

class Range:
    def __init__(self, location: int, length: int) -> None: ...
    @property
    def location(self) -> int: ...
    @property
    def length(self) -> int: ...
    @property
    def max(self) -> int: ...
    @property
    def proto(self) -> api_pb2.Range: ...
    @property
    def toSet(self) -> set[int]: ...
    @property
    def to_set(self) -> set[int]: ...

class WindowedCoordRange:
    def __init__(
        self, coordRange: CoordRange, columnRange: Range | None = None
    ) -> None: ...
    @property
    def coordRange(self) -> CoordRange: ...
    @property
    def columnRange(self) -> Range: ...
    @property
    def proto(self) -> api_pb2.WindowedCoordRange: ...
    @property
    def start(self) -> Point: ...
    @property
    def end(self) -> Point: ...
    @property
    def right(self) -> int: ...
    @property
    def left(self) -> int: ...
    @property
    def hasWindow(self) -> bool: ...
    @property
    def has_window(self) -> bool: ...

async def async_wait_forever() -> None: ...
def iterm2_encode_str(s: str) -> str: ...
def iterm2_encode_list(obj: list[Any]) -> str: ...
def iterm2_encode(obj: Any) -> str: ...
def invocation_string(method_name: str, argdict: Mapping[str, Any]) -> str: ...
