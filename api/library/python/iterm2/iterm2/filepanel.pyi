from enum import Enum

from .connection import Connection

class OpenPanel:
    class Options(Enum):
        CAN_CREATE_DIRECTORIES = 1
        TREATS_FILE_PACKAGES_AS_DIRECTORIES = 2
        SHOWS_HIDDEN_FILES = 4
        RESOLVES_ALIASES = 4294967296
        CAN_CHOOSE_DIRECTORIES = 8589934592
        ALLOWS_MULTIPLE_SELECTION = 17179869184
        CAN_CHOOSE_FILES = 34359738368

    class Result:
        def __init__(self, files: list[str]) -> None: ...
        @property
        def files(self) -> list[str]: ...

    def __init__(self) -> None: ...
    @property
    def path(self) -> str | None: ...
    @path.setter
    def path(self, value: str) -> None: ...
    @property
    def options(self) -> list[OpenPanel.Options]: ...
    @options.setter
    def options(self, value: list[OpenPanel.Options]) -> None: ...
    @property
    def extensions(self) -> list[str] | None: ...
    @extensions.setter
    def extensions(self, value: list[str] | None) -> None: ...
    @property
    def prompt(self) -> str | None: ...
    @prompt.setter
    def prompt(self, value: str) -> None: ...
    @property
    def message(self) -> str | None: ...
    @message.setter
    def message(self, value: str) -> None: ...
    async def async_run(self, connection: Connection) -> OpenPanel.Result | None: ...

