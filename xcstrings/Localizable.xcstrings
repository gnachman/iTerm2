    "Tip.0085.Body" : {
      "comment" : "Tip of the day body, id 0085",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugen Sie Befehle mithilfe von KI, indem Sie im Composer eine Eingabeaufforderung eingeben und „Bearbeiten > Künstliche Intelligenz aktivieren“ wählen. Für diese Funktion ist ein OpenAI-API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Generate commands using AI by entering a prompt in the composer and selecting “Edit > Engage Artificial Intelligence”. An OpenAI API key is required for this functionality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera comandos con IA escribiendo un prompt en el compositor y seleccionando “Edición > Activar inteligencia artificial”. Esta función requiere una clave de API de OpenAI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez des commandes avec l’IA en saisissant un prompt dans le compositeur et en choisissant « Édition > Activer l’intelligence artificielle ». Une clé d’API OpenAI est requise pour cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera comandi con l’IA inserendo un prompt nel compositore e selezionando “Modifica > Attiva l’intelligenza artificiale”. Per questa funzione è necessaria una chiave API di OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンポーザーにプロンプトを入力して「編集 > 人工知能を利用する」を選択すると、AIを使ってコマンドを生成できます。この機能を使うにはOpenAI APIキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴포저에 프롬프트를 입력하고 “편집 > 인공지능 사용”을 선택하면 AI로 명령을 생성할 수 있습니다. 이 기능을 사용하려면 OpenAI API 키가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gere comandos usando IA digitando um prompt no compositor e selecionando “Edit > Engage Artificial Intelligence”. Uma chave de API da OpenAI é necessária para essa funcionalidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте команды с помощью ИИ, введя запрос в Композере и выбрав «Правка > Задействовать искусственный интеллект». Для этой функции требуется ключ API OpenAI."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucu’ya bir istem girip “Düzen > Yapay Zekâyı Devreye Sok”u seçerek YZ ile komut oluşturun. Bu işlev için bir OpenAI API anahtarı gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过在 composer中输入提示词并选择“编辑 > 启用人工智能”，使用AI生成命令。此功能需要OpenAI API密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編寫器中輸入提示詞並選擇「編輯 > 啟用人工智慧」，即可使用 AI 產生指令。此功能需要 OpenAI API 金鑰。"
          }
        }
      }
    },
    "Tip.0085.Title" : {
