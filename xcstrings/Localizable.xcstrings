    "StatusBarRPC.ComponentFailedFormat" : {
      "comment" : "Error message when a status bar script component fails; placeholders are the description, unique identifier, invocation, error description, and optional failure reason",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Statusleistenkomponente „%1$@“ (%2$@) ist fehlgeschlagen.\n\nBei diesem Funktionsaufruf ist ein Fehler aufgetreten:\n\n%3$@\n\nDer Fehler lautete:\n\n%4$@\n\n%5$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Status bar component “%1$@” (%2$@) failed.\n\nThis function call had an error:\n\n%3$@\n\nThe error was:\n\n%4$@\n\n%5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El componente de la barra de estado “%1$@” (%2$@) falló.\n\nEsta llamada a función tuvo un error:\n\n%3$@\n\nEl error fue:\n\n%4$@\n\n%5$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le composant de la barre d’état « %1$@ » (%2$@) a échoué.\n\nCet appel de fonction a provoqué une erreur :\n\n%3$@\n\nL’erreur était :\n\n%4$@\n\n%5$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il componente della barra di stato “%1$@” (%2$@) non è riuscito.\n\nQuesta chiamata di funzione ha prodotto un errore:\n\n%3$@\n\nErrore:\n\n%4$@\n\n%5$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーのコンポーネント「%1$@」(%2$@) が失敗しました。\n\nこの関数呼び出しでエラーが発生しました:\n\n%3$@\n\nエラー内容:\n\n%4$@\n\n%5$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대 구성 요소 “%1$@”(%2$@)이(가) 실패했습니다.\n\n이 함수 호출에서 오류가 발생했습니다:\n\n%3$@\n\n오류:\n\n%4$@\n\n%5$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O componente da barra de status “%1$@” (%2$@) falhou.\n\nEsta chamada de função teve um erro:\n\n%3$@\n\nO erro foi:\n\n%4$@\n\n%5$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбой компонента строки состояния «%1$@» (%2$@).\n\nПри вызове этой функции произошла ошибка:\n\n%3$@\n\nОшибка:\n\n%4$@\n\n%5$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) durum çubuğu bileşeni başarısız oldu.\n\nBu işlev çağrısında bir hata oluştu:\n\n%3$@\n\nHata:\n\n%4$@\n\n%5$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态栏组件“%1$@” (%2$@) 失败。\n\n此函数调用出现错误：\n\n%3$@\n\n错误内容：\n\n%4$@\n\n%5$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態列元件「%1$@」（%2$@）失敗。\n\n此函式呼叫發生錯誤：\n\n%3$@\n\n錯誤如下：\n\n%4$@\n\n%5$@"
          }
        }
      }
    },
