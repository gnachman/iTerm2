    "ClaudeCodeOnboarding.RemoteConfigResolutionFailedBody" : {
      "comment" : "Body of the alert shown when iTerm2 could not read CLAUDE_CONFIG_DIR on a remote host; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte CLAUDE_CONFIG_DIR nicht aus Ihrer Login-Shell auf %@ lesen und weiß daher nicht, wo Claude Code dort seine Einstellungen speichert. Erneut versuchen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t read CLAUDE_CONFIG_DIR from your login shell on %@, so it doesn’t know where Claude Code keeps its settings there. Try again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo leer CLAUDE_CONFIG_DIR desde tu shell de inicio de sesión en %@, así que no sabe dónde guarda Claude Code sus ajustes allí. ¿Volver a intentarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu lire CLAUDE_CONFIG_DIR depuis votre shell de connexion sur %@, il ne sait donc pas où Claude Code y conserve ses réglages. Réessayer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto leggere CLAUDE_CONFIG_DIR dalla tua shell di login su %@, quindi non sa dove Claude Code conserva lì le sue impostazioni. Riprovare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は%@のログインシェルからCLAUDE_CONFIG_DIRを読み取れなかったため、そこでClaude Codeが設定をどこに保存しているかわかりません。もう一度試しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 %@의 로그인 셸에서 CLAUDE_CONFIG_DIR을 읽을 수 없어 그곳에서 Claude Code가 설정을 어디에 보관하는지 알 수 없습니다. 다시 시도하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu ler CLAUDE_CONFIG_DIR do seu shell de login em %@, portanto não sabe onde o Claude Code guarda as configurações lá. Tentar novamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не смог прочитать CLAUDE_CONFIG_DIR из вашей оболочки входа на %@, поэтому не знает, где Claude Code хранит там настройки. Попробовать снова?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, %@ ana makinesindeki oturum açma kabuğunuzdan CLAUDE_CONFIG_DIR değerini okuyamadı; bu yüzden Claude Code’un orada ayarlarını nerede sakladığını bilmiyor. Yeniden denensin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法从 %@ 上的登录 Shell 读取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 在那里将设置保存在何处。要重试吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法從 %@ 上的登入 shell 讀取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 在該處將設定儲存在何處。要再試一次嗎？"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.RemoteDisconnected" : {
      "comment" : "Shown when the remote host disconnected before the Claude Code hook could be installed; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung zu %@ wurde beendet. Stellen Sie die Verbindung wieder her und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The connection to %@ has ended. Reconnect and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión con %@ ha terminado. Vuelve a conectarte e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à %@ est terminée. Reconnectez-vous et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione a %@ si è conclusa. Riconnettiti e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@への接続が終了しました。再接続してもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연결이 종료되었습니다. 다시 연결한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com %@ foi encerrada. Reconecte e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение к %@ завершено. Подключитесь снова и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ana makinesiyle bağlantı sona erdi. Yeniden bağlanıp tekrar deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 %@ 的连接已结束。请重新连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 %@ 的連線已結束。請重新連線後再試一次。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.RemoteHostAlreadyAllowed" : {
      "comment" : "Shown in the remote install step when the host already has an always-allow grant; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ darf die iTerm2-API bereits dauerhaft verwenden. Sie können dies unter Einstellungen > Allgemein > Magie > API-Zugriff über SSH ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ is already always allowed to use the iTerm2 API. You can change that in Settings > General > Magic > API access over ssh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene permiso permanente para usar la API de iTerm2. Puedes cambiarlo en Ajustes > General > Magia > Acceso a la API por SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà toujours autorisé à utiliser l’API d’iTerm2. Vous pouvez le modifier dans Réglages > Général > Magie > Accès à l’API via SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già sempre autorizzato a usare l’API di iTerm2. Puoi modificarlo in Impostazioni > Generali > Magia > Accesso all’API tramite ssh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでにiTerm2 APIの使用を常に許可されています。これは「設定 > 一般 > Magic > SSH経由のAPIアクセス」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이미 iTerm2 API를 항상 사용하도록 허용되어 있습니다. 설정 > 일반 > 매직 > SSH를 통한 API 접근에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já tem permissão permanente para usar a API do iTerm2. Você pode alterar isso em Ajustes > Geral > Magic > Acesso à API via SSH."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже всегда разрешено использовать API iTerm2. Это можно изменить в разделе Настройки > Общие > Магия > Доступ к API через SSH."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ana makinesine iTerm2 API’sini kullanma izni zaten her zaman verilmiş. Bunu Ayarlar > Genel > Sihir > SSH üzerinden API erişimi bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被始终允许使用 iTerm2 API。你可以在“设置 > 通用 > Magic > 通过 SSH 访问 API”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被一律允許使用 iTerm2 API。你可以在「設定 > 一般 > 魔法 > 透過 ssh 存取 API」中變更。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.RemoteIdentityUnknown" : {
      "comment" : "Shown when the remote install could not determine whether the ssh host is this Mac, so it made no changes; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte nicht feststellen, ob %@ dieser Mac ist, daher hat es die Einstellungen von Claude Code dort nicht verändert. Stellen Sie die Verbindung wieder her und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t tell whether %@ is this Mac, so it didn’t change Claude Code’s settings there. Reconnect and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo determinar si %@ es este Mac, así que no cambió allí los ajustes de Claude Code. Vuelve a conectarte e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu déterminer si %@ est ce Mac, il n’y a donc pas modifié les réglages de Claude Code. Reconnectez-vous et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto stabilire se %@ sia questo Mac, quindi non ha modificato lì le impostazioni di Claude Code. Riconnettiti e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は%@がこのMacかどうかを判断できなかったため、そこにあるClaude Codeの設定を変更しませんでした。再接続してもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 %@이(가) 이 Mac인지 확인할 수 없어 그곳의 Claude Code 설정을 변경하지 않았습니다. 다시 연결한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu determinar se %@ é este Mac, por isso não alterou os ajustes do Claude Code lá. Reconecte e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не смог определить, является ли %@ этим Mac, поэтому не стал изменять настройки Claude Code на нём. Подключитесь снова и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, %@ ana makinesinin bu Mac olup olmadığını belirleyemedi; bu yüzden oradaki Claude Code ayarlarını değiştirmedi. Yeniden bağlanıp tekrar deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法判断 %@ 是否就是这台 Mac，因此未更改该处的 Claude Code 设置。请重新连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法判斷 %@ 是否就是這部 Mac，因此未變更該處的 Claude Code 設定。請重新連線後再試一次。"
          }
        }
      }
    },
