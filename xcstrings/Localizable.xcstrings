    "Tip.0089.Body" : {
      "comment" : "Tip of the day body, id 0089",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachovejte přehlednost aktivního okna a přitom užívejte průhlednost oken na pozadí pomocí „Zobrazení > Vypnout průhlednost pro aktivní okno“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevar klarheden i dit aktive vindue, og nyd gennemsigtighed i baggrundsvinduer ved at bruge “Oversigt > Slå gennemsigtighed fra for aktivt vindue”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten Sie die Klarheit Ihres aktiven Fensters bei und genießen Sie dennoch Transparenz in Hintergrundfenstern, indem Sie „Ansicht > Transparenz im aktiven Fenster deaktivieren“ verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maintain clarity in your active window while enjoying transparency in background windows by using 'View > Disable transparency in key window'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la claridad en tu ventana activa y disfruta de la transparencia en las ventanas en segundo plano con “Visualización > Desactivar transparencia en la ventana activa”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä aktiivisen ikkunan selkeys ja nauti taustaikkunoiden läpinäkyvyydestä komennolla ”Näytä > Poista läpinäkyvyys käytöstä aktiivisessa ikkunassa”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez une fenêtre active bien nette tout en profitant de la transparence des fenêtres d’arrière-plan avec « Présentation > Désactiver la transparence pour la fenêtre active »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la chiarezza nella finestra attiva e goditi la trasparenza nelle finestre in secondo piano usando “Vista > Disabilita trasparenza per la finestra attiva”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「表示 > キーウィンドウで透明度を無効化」を使うと、バックグラウンドウィンドウの透明度を楽しみながら、アクティブウィンドウの見やすさを保てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘보기 > 키 윈도우에서 투명도 끄기’를 사용하면 배경 윈도우의 투명도는 유지하면서 활성 윈도우는 선명하게 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold klarheten i det aktive vinduet mens du nyter gjennomsiktighet i bakgrunnsvinduer ved å bruke «Vis > Deaktiver gjennomsiktighet for aktivt vindu»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je actieve venster helder en geniet van transparantie in achtergrondvensters met ‘Weergave > Schakel transparantie uit voor actief venster’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj czytelność aktywnego okna, ciesząc się przezroczystością okien w tle, dzięki „Widok > Wyłącz przezroczystość dla aktywnego okna”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a nitidez na janela ativa enquanto aproveita a transparência nas janelas de fundo usando 'View > Disable transparency in key window'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте чёткость активного окна, наслаждаясь прозрачностью фоновых окон, с помощью «Вид > Отключить прозрачность в активном окне»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachovajte prehľadnosť aktívneho okna a užívajte si priehľadnosť okien na pozadí pomocou položku „Zobraziť > Vypnúť priehľadnosť pre aktívne okno“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranite jasnost aktivnega okna in uživajte v prosojnosti oken v ozadju z »Prikaz > Onemogoči prosojnost za dejavno okno«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåll tydligheten i ditt aktiva fönster samtidigt som du njuter av transparens i bakgrundsfönster genom att använda ”Innehåll > Avaktivera transparens för aktivt fönster”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Görüntü > Etkin Pencere İçin Saydamlığı Devre Dışı Bırak” ile etkin pencerenizde netliği korurken arka plandaki pencerelerde saydamlığın keyfini çıkarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ cửa sổ đang hoạt động rõ nét trong khi vẫn tận hưởng độ trong suốt ở các cửa sổ nền bằng cách dùng “Xem > Tắt độ trong suốt cho cửa sổ đang dùng”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“显示 > 在主窗口中停用透明度”可保持当前活动窗口清晰，同时保留背景窗口的透明度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「顯示方式 > 在主要視窗中停用透明度」，可讓使用中的視窗保持清晰，同時背景視窗仍維持透明。"
          }
        }
      }
    },
