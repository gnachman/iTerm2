    "ProfilesGeneral.CommandNotFoundWarning" : {
      "comment" : "Warning shown when the command is not found on PATH; %@ is the list of folders in the search path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl nicht gefunden. Möglicherweise müssen Sie den vollständigen Pfad angeben, da Ihre Shell beim Ausführen dieses Befehls nicht verwendet wird. Der Suchpfad enthält die folgenden Ordner: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command not found. You may need to specify the full path because your shell is not used when running this command. The search path contains the following folders: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando no encontrado. Puede que necesites especificar la ruta completa porque tu shell no se usa al ejecutar este comando. La ruta de búsqueda contiene las siguientes carpetas: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande introuvable. Vous devrez peut-être indiquer le chemin complet, car votre shell n’est pas utilisé pour exécuter cette commande. Le chemin de recherche contient les dossiers suivants : %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando non trovato. Potrebbe essere necessario specificare il percorso completo perché la shell non viene usata per eseguire questo comando. Il percorso di ricerca contiene le seguenti cartelle: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドが見つかりません。このコマンドの実行時にはシェルが使用されないため、フルパスを指定する必要があるかもしれません。検索パスには次のフォルダが含まれています: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 찾을 수 없습니다. 이 명령을 실행할 때는 셸을 사용하지 않으므로 전체 경로를 지정해야 할 수 있습니다. 검색 경로에는 다음 폴더가 포함되어 있습니다: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando não encontrado. Talvez você precise especificar o caminho completo, pois seu shell não é usado ao executar este comando. O caminho de busca contém as seguintes pastas: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда не найдена. Возможно, потребуется указать полный путь, так как при выполнении этой команды оболочка не используется. Путь поиска содержит следующие папки: %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut bulunamadı. Bu komutu çalıştırırken kabuğunuz kullanılmadığından tam yolu belirtmeniz gerekebilir. Arama yolu şu klasörleri içerir: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到命令。由于运行此命令时不使用你的 shell，你可能需要指定完整路径。搜索路径包含以下文件夹：%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到指令。由於執行此指令時不會使用你的 shell，你可能需要指定完整路徑。搜尋路徑包含以下檔案夾：%@。"
          }
        }
      }
    },
