    "AdvancedSetting.badgeMaxHeightFraction" : {
      "comment" : "Advanced setting: badgeMaxHeightFraction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Höhe des Badges\nAls Anteil der Höhe des Terminals, zwischen 0 und 1,0. Dies ist der Standardwert, wenn ein Profil keine Einstellung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum height of the badge\nAs a fraction of the height of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima de la insignia\nComo fracción de la altura de la terminal, entre 0 y 1,0. Es el valor predeterminado si un perfil no tiene este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur maximale du badge\nEn fraction de la hauteur du terminal, entre 0 et 1,0. C’est la valeur par défaut si un profil n’a pas de réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza massima del badge\nCome frazione dell’altezza del terminale, tra 0 e 1,0. È il valore predefinito se un profilo non ha un’impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジの最大高さ\nターミナルの高さに対する割合で指定します (0 から 1.0)。プロファイルに設定がない場合のデフォルト値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배지 최대 높이\n터미널 높이에 대한 비율이며 0에서 1.0 사이입니다. 프로파일에 설정이 없을 때 사용하는 기본값입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima do selo\nComo uma fração da altura do terminal, entre 0 e 1.0. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная высота плашки\nВ виде доли высоты терминала, от 0 до 1,0. Это значение по умолчанию, если оно не задано в профиле."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozetin en büyük yüksekliği\nTerminal yüksekliğinin 0 ile 1,0 arasında bir kesri olarak. Bir profilde ayar yoksa varsayılan değer budur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角标的最大高度\n以终端高度的百分比表示，范围为0到1.0。若配置文件未设置该值，则采用此默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標記牌的最大高度\n以終端機高度的比例表示，介於 0 到 1.0 之間。描述檔未設定時，會使用此預設值。"
          }
        }
      }
    },
