    "AdvancedSetting.sshURLsSupportPath" : {
      "comment" : "Advanced setting: sshURLsSupportPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-URLs berücksichtigen den Pfad.\nSie führen den Befehl aus: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SSH URLs respect the path.\nThey run the command: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las URLs de SSH respetan la ruta.\nEjecutan el comando: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les URL SSH respectent le chemin.\nElles exécutent la commande : ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli URL SSH rispettano il percorso.\nEseguono il comando: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH URLがパスを尊重する。\n次のコマンドを実行します：ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH URL에서 경로를 반영합니다.\n다음 명령을 실행합니다: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLs SSH respeitam o caminho.\nElas executam o comando: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылки SSH учитывают путь.\nВыполняется команда: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH URL’leri yolu dikkate alır.\nŞu komutu çalıştırırlar: ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH URL会遵循路径。\n它们运行以下命令：ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH URL 會遵循路徑。\n它們會執行指令：ssh -t \"cd $$PATH$$; exec \\$SHELL -l\""
          }
        }
      }
    },
