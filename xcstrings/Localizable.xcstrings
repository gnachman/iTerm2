    "AIPluginClient.VersionMismatch" : {
      "comment" : "Error message when the AI plugin version does not match the version iTerm2 expects",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Plugin hat Version %1$@, aber iTerm2 erwartet %2$@. Aktualisieren Sie eines von beiden oder beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plugin has version %1$@ but iTerm2 expects %2$@. Upgrade one or both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin tiene la versión %1$@, pero iTerm2 espera la %2$@. Actualiza uno de los dos o ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le module est en version %1$@, mais iTerm2 attend la version %2$@. Mettez à jour l’un des deux, ou les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plug-in ha la versione %1$@ ma iTerm2 si aspetta la %2$@. Aggiorna uno dei due o entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインのバージョンは%1$@ですが、iTerm2は%2$@を想定しています。どちらか、または両方をアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인 버전은 %1$@이지만 iTerm2는 %2$@ 버전을 요구합니다. 둘 중 하나 또는 둘 다 업그레이드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plugin tem a versão %1$@, mas o iTerm2 espera a %2$@. Atualize um ou ambos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия плагина %1$@, но iTerm2 ожидает %2$@. Обновите один из компонентов или оба."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentinin sürümü %1$@, ancak iTerm2 %2$@ sürümünü bekliyor. Birini veya her ikisini güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件版本为%1$@，但iTerm2期望%2$@。请升级其中一个或两个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛程式的版本為 %1$@，但 iTerm2 需要 %2$@。請升級其中一個或兩者。"
          }
        }
      }
    },
    "AIPluginClient.VersionUnknown" : {
      "comment" : "Error message when iTerm2 cannot determine the AI plugin version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Version des KI-Plugins kann nicht ermittelt werden. Installieren Sie es neu und aktualisieren Sie nach Möglichkeit iTerm2."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unable to determine version of AI plugin. Reinstall it and upgrade iTerm2 if possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo determinar la versión del plugin de IA. Reinstálalo y, si es posible, actualiza iTerm2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer la version du module d’IA. Réinstallez-le et mettez iTerm2 à jour si possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile determinare la versione del plug-in IA. Reinstallalo e, se possibile, aggiorna iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプラグインのバージョンを確認できません。可能であれば再インストールし、iTerm2をアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 플러그인의 버전을 확인할 수 없습니다. 플러그인을 다시 설치하고 가능하면 iTerm2를 업그레이드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível determinar a versão do plugin de IA. Reinstale-o e atualize o iTerm2, se possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить версию плагина ИИ. Переустановите его и, если возможно, обновите iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ eklentisinin sürümü belirlenemedi. Eklentiyi yeniden yükleyin ve mümkünse iTerm2’yi güncelleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确定AI插件的版本。请重新安装并尽可能升级iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法判斷 AI 外掛程式的版本。請重新安裝，並盡可能升級 iTerm2。"
          }
        }
      }
    },
