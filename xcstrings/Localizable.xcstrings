    "Tip.0115.Body" : {
      "comment" : "Tip of the day body, id 0115",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihen Sie mit ⌥-Eingabe einen Befehl im Eingabefenster ein, der gesendet wird, sobald der aktuelle Befehl abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
