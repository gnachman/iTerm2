    "PTYSession.OptionKeyFrustrationLeft" : {
      "comment" : "Prompt offering to change the left option key behavior",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie scheinen frustriert zu sein. Möchten Sie, dass die linke Wahltaste esc+Tastenanschlag sendet?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You seem frustrated. Would you like the left option key to send esc+keystroke?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pareces frustrado. ¿Quieres que la tecla Opción izquierda envíe Esc+tecla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez frustré. Voulez-vous que la touche Option gauche envoie Échap + la touche ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembri frustrato. Vuoi che il tasto Opzione sinistro invii Esc+tasto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お困りのようですね。左のoptionキーをesc+キーストロークとして送信するようにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답답하신 것 같습니다. 왼쪽 Option 키가 Esc+키 입력을 보내도록 하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você parece frustrado. Deseja que a tecla option esquerda envie esc+tecla?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы расстроены. Хотите, чтобы левая клавиша Option отправляла esc+клавишу?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinirlenmiş gibisiniz. Sol Option tuşunun Esc+tuş vuruşu göndermesini ister misiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您似乎很沮丧。希望左选项键能发送 esc+按键输入？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你似乎感到沮喪。要讓左側 Option 鍵傳送 esc+按鍵嗎？"
          }
        }
      }
    },
