          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật bộ điều khiển trạng thái có thể khôi phục?\nGiúp khôi phục cửa sổ đáng tin cậy hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用可恢复状态控制器？\n这会使窗口恢复更加可靠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
