          }
        }
      }
    },
    "AdvancedSetting.neverWarnAboutMeta" : {
      "comment" : "Advanced setting: neverWarnAboutMeta",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
