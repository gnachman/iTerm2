    "ChatViewController.NoLinkedSessionUserNoticeBrowser" : {
      "comment" : "Notice shown when AI tries to act but no web browser session is linked",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI hat versucht, eine Aktion auszuführen, aber diesem Chat ist keine Webbrowser-Sitzung verknüpft, daher ist sie fehlgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI attempted to perform an action, but no web browser session is linked to this chat so it failed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA intentó realizar una acción, pero no hay ninguna sesión de navegador web vinculada a este chat, por lo que falló."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA a tenté d’effectuer une action, mais aucune session de navigateur web n’est liée à ce chat, donc l’action a échoué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA ha tentato di eseguire un’azione, ma nessuna sessione del browser web è collegata a questa chat, quindi l’azione non è riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIが操作を実行しようとしましたが、このチャットにはWebブラウザセッションがリンクされていないため失敗しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 동작을 수행하려고 했지만 이 채팅에 연결된 웹 브라우저 세션이 없어 실패했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA tentou realizar uma ação, mas nenhuma sessão de navegador da web está vinculada a este chat, então falhou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ попытался выполнить действие, но к этому чату не привязана сессия веб-браузера, поэтому попытка не удалась."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ bir eylem gerçekleştirmeyi denedi, ancak bu sohbete bağlı bir web tarayıcı oturumu olmadığı için başarısız oldu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI尝试执行操作，但由于当前聊天未绑定网络浏览器会话，因此失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 嘗試執行動作，但此聊天未連結任何網頁瀏覽器工作階段，因此失敗。"
          }
