          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 엔드포인트에는 API 키를 보내지 않습니다. 인증이 필요하면 사용자 지정 헤더를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de API é enviada a um endpoint local. Se ele exigir autenticação, use um cabeçalho personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API не отправляется на локальную конечную точку. Если ей требуется аутентификация, используйте пользовательский заголовок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会向本地端点发送 API 密钥。如果它需要身份验证，请使用自定义头信息。"
          }
        }
      }
    },
    "AIKeyHint.UnrecognizedHost" : {
      "comment" : "Hint shown when a manual AI model’s endpoint is not its provider’s own server (for example a third-party gateway), where the automatic API key choice sends no key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nicht automatisch ein API-Schlüssel gesendet, da dieser Endpunkt nicht vom Anbieter des Modells betrieben wird. Wählen Sie den benötigten Schlüssel aus oder verwenden Sie einen benutzerdefinierten Header."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No API key is sent automatically, since this endpoint is not run by the model’s provider. Choose the key it needs, or use a custom header."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンドポイントはモデルのプロバイダーが運営していないため、APIキーは自動では送信されません。必要なキーを選択するか、カスタムヘッダーを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 엔드포인트는 모델 제공업체가 운영하지 않으므로 API 키가 자동으로 전송되지 않습니다. 필요한 키를 선택하거나 사용자 지정 헤더를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de API é enviada automaticamente, pois este endpoint não é operado pelo provedor do modelo. Escolha a chave necessária ou use um cabeçalho personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API не отправляется автоматически, так как эта конечная точка не обслуживается поставщиком модели. Выберите нужный ключ или используйте пользовательский заголовок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于此端点并非由模型的提供商运营，因此不会自动发送 API 密钥。请选择它所需的密钥，或使用自定义头信息。"
          }
        }
      }
    },
