    "BrowserScriptingPermissions.AddInfo" : {
      "comment" : "Explains the dialog for adding a website that scripts may control; the buttons say what they will be able to do",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte webovou stránku, například https://example.com. Skripty na ní budou moci provádět tuto akci bez dotazu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv et websted, f.eks. https://example.com. Instrukser kan gøre dette på det uden at spørge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine Website ein, zum Beispiel https://example.com. Skripte können dies dann dort ohne Nachfrage tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter a website, such as https://example.com. Scripts will be able to do this on it without asking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un sitio web, como https://example.com. Los scripts podrán hacer esto en él sin preguntar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna verkkosivusto, esimerkiksi https://example.com. Skriptit voivat tehdä tämän siellä kysymättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un site web, par exemple https://example.com. Les scripts pourront y effectuer cette action sans demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un sito web, ad esempio https://example.com. Gli script potranno farlo su di esso senza chiedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://example.com のようにWebサイトを入力してください。スクリプトは確認なしでこのWebサイトに対してこの操作を行えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://example.com과 같이 웹 사이트를 입력하십시오. 스크립트가 묻지 않고 해당 웹 사이트에서 이 작업을 할 수 있게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn et nettsted, f.eks. https://example.com. Skript kan da gjøre dette på det uten å spørre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een website in, zoals https://example.com. Scripts kunnen dit dan zonder te vragen op die website doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz stronę internetową, na przykład https://example.com. Skrypty będą mogły to robić na niej bez pytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um site, como https://example.com. Os scripts poderão fazer isso nele sem perguntar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите веб-сайт, например https://example.com. Скрипты смогут делать это на нём без запроса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
