    "PTYSession.OptionKeyFrustrationLeft" : {
      "comment" : "Prompt offering to change the left option key behavior",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že vás to rozčiluje. Má levá klávesa Option odesílat Esc+stisk klávesy?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du virker frustreret. Vil du have, at den venstre alternativtast sender esc+tastetryk?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie scheinen frustriert zu sein. Möchten Sie, dass die linke Wahltaste esc+Tastenanschlag sendet?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You seem frustrated. Would you like the left option key to send esc+keystroke?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pareces frustrado. ¿Quieres que la tecla Opción izquierda envíe Esc+tecla?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikutat turhautuneelta. Haluatko, että vasen optionäppäin lähettää esc+näppäinpainalluksen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez frustré. Voulez-vous que la touche Option gauche envoie Échap + la touche ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembri frustrato. Vuoi che il tasto Opzione sinistro invii Esc+tasto?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お困りのようですね。左のoptionキーをesc+キーストロークとして送信するようにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답답하신 것 같습니다. 왼쪽 Option 키가 Esc+키 입력을 보내도록 하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du virker frustrert. Vil du at Tilvalg-tasten til venstre skal sende esc+tastetrykk?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lijkt gefrustreerd. Wil je dat de linker Option-toets esc+toetsaanslag verstuurt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że coś cię frustruje. Czy lewy klawisz Option ma wysyłać esc+klawisz?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você parece frustrado. Deseja que a tecla option esquerda envie esc+tecla?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы расстроены. Хотите, чтобы левая клавиша Option отправляла esc+клавишу?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že ste frustrovaní. Chcete, aby ľavý kláves Option odosielal Esc+stlačený kláves?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da ste razočarani. Želite, da leva tipka Option pošlje Esc+tipka?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verkar frustrerad. Vill du att vänster alternativtangent skickar esc+tangenttryckning?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinirlenmiş gibisiniz. Sol Option tuşunun Esc+tuş vuruşu göndermesini ister misiniz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ bạn đang bực bội. Bạn có muốn phím Option bên trái gửi Esc+phím không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您似乎很沮丧。希望左选项键能发送 esc+按键输入？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你似乎感到沮喪。要讓左側 Option 鍵傳送 esc+按鍵嗎？"
          }
        }
      }
    },
