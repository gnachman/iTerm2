        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Примечание: вывод команды был обрезан, так как превысил максимальное количество строк, поддерживаемое чатом ИИ*"
          }
        },
        "tr" : {
          "stringUnit" : {
