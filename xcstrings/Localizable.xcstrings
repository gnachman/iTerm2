    "ToolStatus.WatchingTooltipSession" : {
      "comment" : "Tooltip for the notify button when armed and targeting the selected session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwacht die ausgewählte Sitzung auf eine Statusänderung. Bei der nächsten Änderung erscheint ein Hinweis, danach wird dies wieder deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watching the selected session for a status change. An alert will appear on the next change, then turn this off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigilando el cambio de estado de la sesión seleccionada. Aparecerá una alerta en el próximo cambio y después esto se desactivará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillance de la session sélectionnée en cas de changement d’état. Une alerte apparaîtra au prochain changement, puis cette option sera désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo del cambio di stato della sessione selezionata. Al prossimo cambio apparirà un avviso, poi questa opzione si disattiverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したセッションのステータス変化を監視しています。次に変化したときにアラートが表示され、その後この機能はオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 세션의 상태 변경을 감시하는 중입니다. 다음 변경 시 경고가 나타난 후 이 기능은 꺼집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitorando a mudança de status da sessão selecionada. Um alerta aparecerá na próxima mudança, e então isto será desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживание изменения статуса выбранного сеанса. При следующем изменении появится оповещение, после чего отслеживание отключится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili oturumun durum değişikliği izleniyor. Bir sonraki değişiklikte bir uyarı görünür, ardından bu özellik kapanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在监视所选会话的状态更改。下一次更改时会出现提醒，然后此选项会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在監看所選工作階段的狀態變更。下次變更時會出現警示，然後此選項會關閉。"
          }
        }
      }
    },
