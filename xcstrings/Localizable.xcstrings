    "AIConnectionTester.UnparseableReply" : {
      "comment" : "Result of the AI connection test when the server's reply could not be parsed; the placeholder is an error description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat geantwortet, aber seine Antwort war nicht verständlich: %@"
          }
        },
        "en" : {
