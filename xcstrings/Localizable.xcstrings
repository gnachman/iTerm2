    "TipController.PermissionInformative" : {
      "comment" : "Explanatory text for the alert asking permission to show Tip of the Day messages.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann Ihnen eine Nachricht mit dem Tipp des Tages anzeigen, damit Sie die vielen Funktionen kennenlernen. Möchten Sie das?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can show you a Tip of the Day message to help you learn about its many features. Are you interested?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 puede mostrarte un mensaje con el Consejo del día para ayudarte a conocer sus muchas funciones. ¿Te interesa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut vous afficher une astuce du jour pour vous aider à découvrir ses nombreuses fonctionnalités. Cela vous intéresse-t-il ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può mostrarti un messaggio con il suggerimento del giorno per aiutarti a scoprire le sue numerose funzioni. Ti interessa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、多くの機能について学べる「今日のヒント」メッセージを表示できます。表示してみますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 다양한 기능을 익힐 수 있도록 오늘의 팁 메시지를 보여 줄 수 있습니다. 관심이 있습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode mostrar uma mensagem de Dica do Dia para ajudar você a conhecer seus muitos recursos. Você tem interesse?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может показывать вам сообщения «Совет дня», чтобы помочь вам узнать о его многочисленных возможностях. Хотите включить эту функцию?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, birçok özelliğini öğrenmenize yardımcı olmak için size Günün İpucu iletisi gösterebilir. İlgilenir misiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以向你显示“每日提示”消息，帮助你了解其众多功能。你有兴趣吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以顯示「每日小技巧」訊息，協助你認識它的眾多功能。你有興趣嗎？"
          }
        }
      }
    },
