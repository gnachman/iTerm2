    "AIPluginClient.VersionMismatch" : {
      "comment" : "Error message when the AI plugin version does not match the version iTerm2 expects",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug-in má verzi %1$@, ale iTerm2 očekává %2$@. Aktualizujte jeden z nich nebo oba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluginet har version %1$@, men iTerm2 forventer %2$@. Opdater det ene eller begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Plugin hat Version %1$@, aber iTerm2 erwartet %2$@. Aktualisieren Sie eines von beiden oder beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plugin has version %1$@ but iTerm2 expects %2$@. Upgrade one or both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plugin tiene la versión %1$@, pero iTerm2 espera la %2$@. Actualiza uno de los dos o ambos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitännäisen versio on %1$@, mutta iTerm2 odottaa versiota %2$@. Päivitä jompikumpi tai molemmat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le module est en version %1$@, mais iTerm2 attend la version %2$@. Mettez à jour l’un des deux, ou les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plug-in ha la versione %1$@ ma iTerm2 si aspetta la %2$@. Aggiorna uno dei due o entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインのバージョンは%1$@ですが、iTerm2は%2$@を想定しています。どちらか、または両方をアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인 버전은 %1$@이지만 iTerm2는 %2$@ 버전을 요구합니다. 둘 중 하나 또는 둘 다 업그레이드하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillegget har versjon %1$@, men iTerm2 forventer %2$@. Oppgrader det ene eller begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De plug-in heeft versie %1$@, maar iTerm2 verwacht %2$@. Werk een of beide bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczka ma wersję %1$@, ale iTerm2 oczekuje wersji %2$@. Uaktualnij jedno z nich lub oba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plugin tem a versão %1$@, mas o iTerm2 espera a %2$@. Atualize um ou ambos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия плагина %1$@, но iTerm2 ожидает %2$@. Обновите один из компонентов или оба."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin má verziu %1$@, ale iTerm2 očakáva %2$@. Aktualizujte jedno alebo obe."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vtičnik ima različico %1$@, iTerm2 pa pričakuje %2$@. Posodobite enega ali oba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluginet har version %1$@ men iTerm2 förväntar sig %2$@. Uppgradera det ena eller båda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentinin sürümü %1$@, ancak iTerm2 %2$@ sürümünü bekliyor. Birini veya her ikisini güncelleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình cắm có phiên bản %1$@ nhưng iTerm2 mong đợi %2$@. Hãy nâng cấp một hoặc cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件版本为%1$@，但iTerm2期望%2$@。请升级其中一个或两个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛程式的版本為 %1$@，但 iTerm2 需要 %2$@。請升級其中一個或兩者。"
          }
        }
      }
    },
    "AIPluginClient.VersionUnknown" : {
      "comment" : "Error message when iTerm2 cannot determine the AI plugin version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzi plug-inu AI se nepodařilo zjistit. Přeinstalujte jej a pokud je to možné, aktualizujte iTerm2."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke fastslå versionen af AI-pluginet. Geninstaller det, og opdater om muligt iTerm2."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Version des KI-Plugins kann nicht ermittelt werden. Installieren Sie es neu und aktualisieren Sie nach Möglichkeit iTerm2."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unable to determine version of AI plugin. Reinstall it and upgrade iTerm2 if possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo determinar la versión del plugin de IA. Reinstálalo y, si es posible, actualiza iTerm2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-liitännäisen versiota ei voitu selvittää. Asenna se uudelleen ja päivitä iTerm2, jos mahdollista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer la version du module d’IA. Réinstallez-le et mettez iTerm2 à jour si possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile determinare la versione del plug-in IA. Reinstallalo e, se possibile, aggiorna iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプラグインのバージョンを確認できません。可能であれば再インストールし、iTerm2をアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 플러그인의 버전을 확인할 수 없습니다. 플러그인을 다시 설치하고 가능하면 iTerm2를 업그레이드하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke fastslå versjonen av KI-tillegget. Installer det på nytt og oppgrader iTerm2 hvis mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de versie van de AI-plug-in niet bepalen. Installeer de plug-in opnieuw en werk indien mogelijk iTerm2 bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można ustalić wersji wtyczki AI. Zainstaluj ją ponownie i, jeśli to możliwe, uaktualnij iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível determinar a versão do plugin de IA. Reinstale-o e atualize o iTerm2, se possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить версию плагина ИИ. Переустановите его и, если возможно, обновите iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa zistiť verziu pluginu AI. Preinštalujte ho a ak je to možné, aktualizujte iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različice vtičnika AI ni mogoče ugotoviti. Znova ga namestite in po možnosti posodobite iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte fastställa AI-pluginets version. Installera om det och uppgradera iTerm2 om möjligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ eklentisinin sürümü belirlenemedi. Eklentiyi yeniden yükleyin ve mümkünse iTerm2’yi güncelleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác định phiên bản của trình cắm AI. Hãy cài đặt lại nó và nâng cấp iTerm2 nếu có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确定AI插件的版本。请重新安装并尽可能升级iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法判斷 AI 外掛程式的版本。請重新安裝，並盡可能升級 iTerm2。"
