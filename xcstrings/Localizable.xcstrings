    "PTYSession.UnsafeBadgeFormat" : {
      "comment" : "Warning that a badge format was rejected because it contained a function call",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace se pokusila nastavit odznak na hodnotu, která by vyvolala volání funkce. Z bezpečnostních důvodů to není povoleno a odznak nebyl aktualizován."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmet forsøgte at sætte etiketten til en værdi, der ville udføre et funktionskald. Af sikkerhedshensyn er det ikke tilladt, og etiketten blev ikke opdateret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung hat versucht, das Badge auf einen Wert zu setzen, der einen Funktionsaufruf auslösen würde. Aus Sicherheitsgründen ist dies nicht zulässig, und das Badge wurde nicht aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The application attempted to set the badge to a value that would invoke a function call. For security reasons, this is not allowed and the badge was not updated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación intentó establecer la insignia con un valor que invocaría una llamada a función. Por motivos de seguridad, esto no está permitido y la insignia no se actualizó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellus yritti asettaa kyltin arvoon, joka kutsuisi funktiota. Tämä ei ole sallittua turvallisuussyistä, eikä kylttiä päivitetty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application a tenté de définir le badge sur une valeur qui appellerait une fonction. Pour des raisons de sécurité, c’est interdit et le badge n’a pas été mis à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’applicazione ha tentato di impostare il badge su un valore che richiamerebbe una funzione. Per motivi di sicurezza questo non è consentito e il badge non è stato aggiornato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションが関数呼び出しを実行する値にバッジを設定しようとしました。セキュリティ上の理由からこれは許可されておらず、バッジは更新されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 함수 호출을 일으키는 값으로 배지를 설정하려고 했습니다. 보안상의 이유로 이는 허용되지 않으며 배지가 업데이트되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmet forsøkte å sette skiltet til en verdi som ville utløse et funksjonskall. Av sikkerhetshensyn er dette ikke tillatt, og skiltet ble ikke oppdatert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De applicatie probeerde de badge in te stellen op een waarde die een functieaanroep zou uitvoeren. Om veiligheidsredenen is dit niet toegestaan en is de badge niet bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja próbowała ustawić plakietkę na wartość wywołującą funkcję. Ze względów bezpieczeństwa jest to niedozwolone, więc plakietka nie została uaktualniona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo tentou definir o selo com um valor que invocaria uma chamada de função. Por motivos de segurança, isso não é permitido e o selo não foi atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение попыталось установить для значка значение, которое вызвало бы вызов функции. В целях безопасности это не разрешено, и значок не был обновлён."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia sa pokúsila nastaviť odznak na hodnotu, ktorá by vyvolala volanie funkcie. Z bezpečnostných dôvodov to nie je povolené a odznak sa neaktualizoval."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija je poskušala nastaviti značko na vrednost, ki bi sprožila klic funkcije. Iz varnostnih razlogov to ni dovoljeno in značka ni bila posodobljena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmet försökte sätta brickan till ett värde som skulle anropa en funktion. Av säkerhetsskäl är detta inte tillåtet och brickan uppdaterades inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, rozeti bir işlev çağrısı yapacak bir değere ayarlamaya çalıştı. Güvenlik nedeniyle buna izin verilmez ve rozet güncellenmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đã cố đặt huy hiệu thành một giá trị sẽ gọi một hàm. Vì lý do bảo mật, điều này không được phép và huy hiệu đã không được cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用试图将角标设置为会触发函数调用的值。出于安全原因，此操作不被允许，角标未更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 App 嘗試將標記牌設為會叫用函式呼叫的值。基於安全考量，不允許此操作，標記牌未更新。"
          }
        }
      }
    },
    "PTYSession.UnsupportedUploadFormat" : {
      "comment" : "Warning that an upload used an unsupported archive format",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bylo vyžádáno nahrávání s nepodporovaným formátem archivu. Možná potřebujete novější verzi iTerm2."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev anmodet om en overførsel med et arkivformat, som ikke understøttes. Du har muligvis brug for en nyere version af iTerm2."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Upload mit einem nicht unterstützten Archivformat wurde angefordert. Möglicherweise benötigen Sie eine neuere Version von iTerm2."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An upload with an unsupported archive format was requested. You may need a newer version of iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solicitó una subida con un formato de archivo comprimido no compatible. Puede que necesites una versión más reciente de iTerm2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydettiin lähetystä, jonka arkistomuotoa ei tueta. Saatat tarvita iTerm2:n uudemman version."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un téléversement avec un format d’archive non pris en charge a été demandé. Une version plus récente d’iTerm2 est peut-être nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato richiesto un caricamento con un formato di archivio non supportato. Potrebbe essere necessaria una versione più recente di iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされていないアーカイブ形式でのアップロードが要求されました。新しいバージョンのiTerm2が必要な場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되지 않는 아카이브 형식으로 업로드가 요청되었습니다. 최신 버전의 iTerm2가 필요할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ble bedt om en opplasting med et arkivformat som ikke støttes. Du trenger kanskje en nyere versjon av iTerm2."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een upload met een niet-ondersteund archiefformaat aangevraagd. Mogelijk heb je een nieuwere versie van iTerm2 nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zażądano wysłania z nieobsługiwanym formatem archiwum. Może być potrzebna nowsza wersja iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foi solicitado um envio com um formato de arquivo compactado não suportado. Talvez você precise de uma versão mais recente do iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошена отправка файла в неподдерживаемом формате архива. Возможно, вам нужна более новая версия iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bolo vyžiadané odoslanie s nepodporovaným formátom archívu. Možno potrebujete novšiu verziu iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtevano je bilo nalaganje z nepodprto obliko arhiva. Morda potrebujete novejšo različico aplikacije iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En överföring med ett arkivformat som inte stöds begärdes. Du kan behöva en nyare version av iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteklenmeyen arşiv biçimine sahip bir yükleme istendi. iTerm2’nin daha yeni bir sürümüne ihtiyacınız olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có yêu cầu tải lên với định dạng lưu trữ không được hỗ trợ. Bạn có thể cần phiên bản iTerm2 mới hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求的上传使用了不支持的压缩格式。你可能需要更新版本的 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收到使用不支援的封存格式的上傳要求。你可能需要較新版本的 iTerm2。"
          }
        }
      }
    },
