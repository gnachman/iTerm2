    "Tip.0086.Body" : {
      "comment" : "Tip of the day body, id 0086",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanovte si cíle v terminálu a dosáhněte jich pomocí „Codecierge“, funkce pásu nástrojů, která vás provede krok za krokem podle vaší aktivity v terminálu. Tato funkce vyžaduje API klíč OpenAI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt og nå mål i terminalen med “Codecierge”, en funktion i værktøjsbæltet, der guider dig trin for trin ud fra din terminalaktivitet. Til denne funktion kræves en OpenAI API-nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie mit „Codecierge“, einer Funktion im Werkzeugkasten, Terminalziele fest und erreichen Sie sie. Sie werden dabei anhand Ihrer Terminalaktivität Schritt für Schritt begleitet. Für diese Funktion ist ein OpenAI-API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set and achieve terminal goals with “Codecierge”, a Toolbelt feature that guides you step-by-step based on your terminal activity. An OpenAI API key is necessary for this feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija y alcanza objetivos en la terminal con “Codecierge”, una función de la Caja de herramientas que te guía paso a paso según tu actividad en la terminal. Esta función requiere una clave de API de OpenAI."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta ja saavuta päätetavoitteita ”Codeciergellä”, työkaluvyön ominaisuudella, joka opastaa sinua vaihe vaiheelta päätetoimintasi perusteella. Tämä ominaisuus vaatii OpenAI API -avaimen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixez-vous des objectifs dans le terminal et atteignez-les avec « Codecierge », une fonctionnalité de la boîte à outils qui vous guide pas à pas selon votre activité dans le terminal. Une clé d’API OpenAI est nécessaire pour cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definisci e raggiungi obiettivi nel terminale con “Codecierge”, una funzione della Cassetta attrezzi che ti guida passo dopo passo in base alla tua attività nel terminale. Per questa funzione è necessaria una chiave API di OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Codecierge」を使うと、ターミナルでの目標を設定して達成できます。これはターミナルでの操作に基づいて段階的に案内してくれるツールベルトの機能です。この機能にはOpenAI APIキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 활동을 바탕으로 단계별로 안내해 주는 도구 벨트 기능인 “Codecierge”로 터미널 작업 목표를 설정하고 달성하십시오. 이 기능에는 OpenAI API 키가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett og nå mål i terminalen med «Codecierge», en funksjon i Verktøybeltet som veileder deg trinn for trinn basert på aktiviteten din i terminalen. Det kreves en OpenAI API-nøkkel for denne funksjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel doelen in de terminal en bereik ze met ‘Codecierge’, een functie van de Gereedschapsriem die je stap voor stap begeleidt op basis van je terminalactiviteit. Hiervoor is een OpenAI-API-sleutel nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyznaczaj i osiągaj cele w terminalu z „Codecierge”, funkcją pasa narzędzi, która prowadzi cię krok po kroku na podstawie twojej aktywności w terminalu. Ta funkcja wymaga klucza API OpenAI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina e alcance metas no terminal com o “Concierge de código”, um recurso da Caixa de ferramentas que orienta você passo a passo com base na sua atividade no terminal. Uma chave de API da OpenAI é necessária para esse recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте и достигайте целей в терминале с помощью «Codecierge», инструмента панели инструментов, который пошагово направляет вас на основе вашей активности в терминале. Для этой функции необходим ключ API OpenAI."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanovte si a dosiahnite ciele v termináli pomocou „Codecierge“, funkcie Pásu s nástrojmi, ktorá vás podľa vašej aktivity v termináli sprevádza krok za krokom. Táto funkcia vyžaduje API kľúč OpenAI."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Določite in dosezite terminalske cilje s »Codecierge«, funkcijo Pasu z orodji, ki vas vodi korak za korakom glede na vašo dejavnost v terminalu. Za to funkcijo je potreben ključ API OpenAI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätt upp och nå terminalmål med ”Codecierge”, en funktion i verktygsbältet som guidar dig steg för steg utifrån din terminalaktivitet. Den här funktionen kräver en OpenAI API-nyckel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal etkinliğinize göre sizi adım adım yönlendiren bir Araç Kemeri özelliği olan “Codecierge” ile terminal hedefleri belirleyin ve bunlara ulaşın. Bu özellik için bir OpenAI API anahtarı gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt và đạt được mục tiêu terminal với “Codecierge”, một tính năng của Đai công cụ hướng dẫn bạn từng bước dựa trên hoạt động terminal của bạn. Tính năng này cần có khóa API OpenAI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Codecierge”是一个工具包功能，根据你的终端活动逐步指导你实现终端目标。此功能需要OpenAI API密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「Codecierge」設定並達成終端機目標，這是一項工具帶功能，會根據你的終端機活動逐步引導你。此功能需要 OpenAI API 金鑰。"
          }
        }
      }
    },
