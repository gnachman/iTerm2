          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新工作階段的預設定位停駐點寬度。\n注意：這會破壞 emacs 和其他 App 的繪製。"
          }
        }
      }
    },
