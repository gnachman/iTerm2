    "PreviousState.CantSwitchDescription" : {
      "comment" : "Notification body explaining why the app can't be brought back to the front; %@ is the app name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann nicht zu %@ zurückwechseln, da eine andere App die sichere Tastatureingabe aktiviert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Can’t switch back to %@ because another app has enabled secure keyboard entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede volver a %@ porque otra app ha activado la entrada segura de teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de revenir à %@, car une autre app a activé l’entrée clavier sécurisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile tornare a %@ perché un’altra app ha attivato l’inserimento sicuro da tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリがセキュアキーボード入力を有効にしているため、%@に切り替えることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 보안 키보드 입력을 활성화했기 때문에 %@(으)로 다시 전환할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível voltar para %@ porque outro app ativou a entrada segura de teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся переключиться обратно на %@, так как другое приложение включило безопасный ввод с клавиатуры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama güvenli klavye girişini etkinleştirdiği için %@ uygulamasına geri dönülemiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换回 %@，因为其他应用已启用安全键盘输入功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法切換回 %@，因為另一個 App 已啟用安全鍵盤輸入。"
          }
        }
      }
    },
