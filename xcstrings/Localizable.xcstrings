    "Tip.0067.Body" : {
      "comment" : "Tip of the day body, id 0067",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie eine Schriftart verwenden, die Ligaturen unterstützt, können Sie die Ligaturunterstützung unter „Einstellungen > Profile > Text“ aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you use a font that supports ligatures, you can enable ligature support in Settings > Profiles > Text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リガチャに対応したフォントを使っている場合は、設定 > プロファイル > テキストでリガチャのサポートを有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합자를 지원하는 서체를 사용하는 경우 설정 > 프로파일 > 텍스트에서 합자 지원을 켤 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você usa uma fonte que suporta ligaduras, pode ativar o suporte a ligaduras em Ajustes > Perfis > Texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы используете шрифт с поддержкой лигатур, вы можете включить их поддержку в «Настройки > Профили > Текст»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您使用支持连字效果的字体，可以在设置中的“Profiles > Text”里启用连字支持。"
          }
        }
      }
    },
