    "ShellIntegrationInstaller.DiscoveredHelperShell" : {
      "comment" : "Shown when discovering the shell finds a helper shell (with a “>> ” prompt) that a canceled shell integration install left running in the terminal, instead of the user's own shell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminál je v pomocném shellu, který zůstal spuštěný po dřívější instalaci, ne ve vašem vlastním shellu. Zadávejte „exit“, dokud se nevrátí výzva vašeho shellu, a pak to zkuste znovu kliknutím na „Pokračovat“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminalen kører i en hjælpeshell, som en tidligere installation efterlod kørende, og ikke i din egen shell. Skriv “exit”, indtil prompten fra din egen shell er tilbage, og vælg derefter “Fortsæt” for at prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Das Terminal befindet sich in einer Hilfs-Shell, die eine frühere Installation offen gelassen hat, nicht in Ihrer eigenen Shell. Geben Sie „exit“ ein, bis die Eingabeaufforderung Ihrer eigenen Shell wieder erscheint, und wählen Sie dann „Fortfahren“, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🛑 The terminal is in a helper shell that an earlier install left running, not in your own shell. Enter “exit” until your own shell’s prompt is back, then select “Continue” to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 La terminal está en un shell auxiliar que una instalación anterior dejó en ejecución, no en tu propio shell. Introduce “exit” hasta que vuelva el prompt de tu propio shell y luego selecciona “Continuar” para volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Pääte on apukomentotulkissa, jonka aiempi asennus jätti käyntiin, eikä omassa komentotulkissasi. Kirjoita ”exit”, kunnes oman komentotulkkisi kehote palaa, ja yritä uudelleen valitsemalla ”Jatka”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Le terminal est dans un shell auxiliaire laissé en cours d’exécution par une installation précédente, et non dans votre propre shell. Saisissez « exit » jusqu’à ce que l’invite de votre shell réapparaisse, puis sélectionnez « Continuer » pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Il terminale si trova in una shell ausiliaria lasciata in esecuzione da un’installazione precedente, non nella tua shell. Inserisci “exit” finché non torna il prompt della tua shell, poi seleziona “Continua” per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 ターミナルは、以前のインストールが残したヘルパーシェルの中にあり、ご自分のシェルではありません。ご自分のシェルのプロンプトが戻るまで“exit”を入力してから、「続ける」を選択してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 터미널이 사용자 셸이 아니라 이전 설치에서 실행된 채로 남은 도우미 셸에 있습니다. 사용자 셸의 프롬프트가 돌아올 때까지 “exit”를 입력한 다음 “계속”을 선택하여 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminalen kjører et hjelpeskall som en tidligere installering lot stå igjen, ikke ditt eget skall. Skriv «exit» til ledeteksten i ditt eget skall er tilbake, og velg deretter «Fortsett» for å prøve igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 De terminal bevindt zich in een hulpshell die een eerdere installatie heeft laten draaien, niet in je eigen shell. Voer ‘exit’ in tot de prompt van je eigen shell terug is en kies dan ‘Ga door’ om het opnieuw te proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminal działa w pomocniczej powłoce pozostawionej przez wcześniejszą instalację, a nie w twojej własnej powłoce. Wpisuj „exit”, aż wróci znak zachęty twojej powłoki, a następnie wybierz „Kontynuuj”, aby spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 O terminal está em um shell auxiliar que uma instalação anterior deixou em execução, não no seu próprio shell. Digite “exit” até que o prompt do seu shell volte e selecione “Continuar” para tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Терминал находится во вспомогательной оболочке, которую оставила запущенной предыдущая установка, а не в вашей оболочке. Вводите «exit», пока не вернётся приглашение вашей оболочки, затем нажмите «Продолжить», чтобы повторить попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminál je v pomocnom shelli, ktorý po skoršej inštalácii zostal spustený, nie vo vašom vlastnom shelli. Zadávajte „exit“, kým sa nevráti výzva vášho shellu, potom výberom možnosti „Pokračovať“ skúste znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminal je v pomožni lupini, ki jo je pustila zagnano prejšnja namestitev, ne v vaši lastni lupini. Vnašajte »exit«, dokler se ne vrne ukazni poziv vaše lupine, nato izberite »Nadaljuj« za ponoven poskus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminalen kör ett hjälpskal som en tidigare installation lämnade igång, inte ditt eget skal. Skriv ”exit” tills ditt eget skals prompt är tillbaka och välj sedan ”Fortsätt” för att försöka igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminal, kendi kabuğunuzda değil, önceki bir yüklemenin çalışır durumda bıraktığı bir yardımcı kabuktadır. Kendi kabuğunuzun istemi gelene kadar “exit” girin, ardından yeniden denemek için “Devam Et”i seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminal đang ở trong một shell phụ do lần cài đặt trước để lại, không phải shell của chính bạn. Hãy nhập “exit” cho đến khi dấu nhắc của shell bạn xuất hiện lại, rồi chọn “Tiếp tục” để thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 终端当前处于之前的安装遗留下来的辅助 shell 中，而不是你自己的 shell。请输入“exit”，直到你自己的 shell 提示符重新出现，然后选择“继续”重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 終端機目前位於先前安裝時遺留的輔助 shell 中，而不是你自己的 shell。請輸入「exit」直到回到你自己的 shell 提示符號，然後按一下「繼續」再試一次。"
          }
        }
      }
    },
