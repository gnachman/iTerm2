    "ClaudeCodeOnboarding.RemoteIdentityUnknown" : {
      "comment" : "Shown when the remote install could not determine whether the ssh host is this Mac, so it made no changes; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal zjistit, zda je hostitel %@ tento Mac, proto tam nastavení Claude Code nezměnil. Připojte se znovu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke afgøre, om %@ er denne Mac, så den ændrede ikke Claude Codes indstillinger der. Opret forbindelse igen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte nicht feststellen, ob %@ dieser Mac ist, daher hat es die Einstellungen von Claude Code dort nicht verändert. Stellen Sie die Verbindung wieder her und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t tell whether %@ is this Mac, so it didn’t change Claude Code’s settings there. Reconnect and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo determinar si %@ es este Mac, así que no cambió allí los ajustes de Claude Code. Vuelve a conectarte e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei pystynyt selvittämään, onko %@ tämä Mac, joten se ei muuttanut Claude Coden asetuksia siellä. Muodosta yhteys uudelleen ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu déterminer si %@ est ce Mac, il n’y a donc pas modifié les réglages de Claude Code. Reconnectez-vous et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto stabilire se %@ sia questo Mac, quindi non ha modificato lì le impostazioni di Claude Code. Riconnettiti e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は%@がこのMacかどうかを判断できなかったため、そこにあるClaude Codeの設定を変更しませんでした。再接続してもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 %@이(가) 이 Mac인지 확인할 수 없어 그곳의 Claude Code 설정을 변경하지 않았습니다. 다시 연결한 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke avgjøre om %@ er denne Macen, så innstillingene for Claude Code der ble ikke endret. Koble til på nytt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kon niet bepalen of %@ deze Mac is en heeft de instellingen van Claude Code daar niet gewijzigd. Maak opnieuw verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się ustalić, czy %@ to ten Mac, więc iTerm2 nie zmienił tam ustawień Claude Code. Połącz się ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu determinar se %@ é este Mac, por isso não alterou os ajustes do Claude Code lá. Reconecte e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не смог определить, является ли %@ этим Mac, поэтому не стал изменять настройки Claude Code на нём. Подключитесь снова и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal zistiť, či je %@ tento Mac, preto tam nezmenil nastavenia Claude Code. Pripojte sa znovu a skúste to ešte raz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ni mogel ugotoviti, ali je %@ ta Mac, zato tam ni spremenil nastavitev za Claude Code. Znova se povežite in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunde inte avgöra om %@ är den här Macen, så Claude Codes inställningar där ändrades inte. Anslut igen och försök på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, %@ ana makinesinin bu Mac olup olmadığını belirleyemedi; bu yüzden oradaki Claude Code ayarlarını değiştirmedi. Yeniden bağlanıp tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 không thể xác định %@ có phải là Mac này không, nên đã không thay đổi cài đặt Claude Code ở đó. Hãy kết nối lại và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法判断 %@ 是否就是这台 Mac，因此未更改该处的 Claude Code 设置。请重新连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法判斷 %@ 是否就是這部 Mac，因此未變更該處的 Claude Code 設定。請重新連線後再試一次。"
          }
        }
      }
    },
