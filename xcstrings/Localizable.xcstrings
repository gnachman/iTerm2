    "MultiClient.RequiredFileMissingBody" : {
      "comment" : "Body of alert shown when iTermServer is missing from the bundle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausführbare Datei iTermServer fehlt im Programmpaket. Dies deutet darauf hin, dass iTerm2 beschädigt oder unvollständig ist. Bitte installieren Sie iTerm2 von der offiziellen Website neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The iTermServer executable is missing from the application bundle. This indicates iTerm2 is corrupted or incomplete. Please reinstall iTerm2 from the official website."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el ejecutable iTermServer en el paquete de la aplicación. Esto indica que iTerm2 está dañado o incompleto. Vuelve a instalar iTerm2 desde el sitio web oficial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exécutable iTermServer est absent du bundle de l’application. Cela indique qu’iTerm2 est corrompu ou incomplet. Veuillez réinstaller iTerm2 depuis le site web officiel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eseguibile iTermServer manca nel pacchetto dell’applicazione. Questo indica che iTerm2 è danneggiato o incompleto. Reinstalla iTerm2 dal sito web ufficiale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTermServer実行ファイルがアプリケーションバンドルにありません。これはiTerm2が破損しているか不完全であることを示しています。公式サイトからiTerm2を再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램 번들에 iTermServer 실행 파일이 없습니다. iTerm2가 손상되었거나 불완전하다는 의미입니다. 공식 웹사이트에서 iTerm2를 다시 설치하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O executável iTermServer está ausente do pacote do aplicativo. Isso indica que o iTerm2 está corrompido ou incompleto. Reinstale o iTerm2 a partir do site oficial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исполняемый файл iTermServer отсутствует в пакете приложения. Это означает, что iTerm2 повреждён или неполный. Пожалуйста, переустановите iTerm2 с официального сайта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTermServer yürütülebilir dosyası uygulama paketinde eksik. Bu, iTerm2’nin bozuk veya eksik olduğunu gösterir. Lütfen iTerm2’yi resmi web sitesinden yeniden yükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用包中缺少 iTermServer 可执行文件。这表明 iTerm2 已损坏或不完整。请从官方网站重新安装 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 套件中缺少 iTermServer 可執行檔。這表示 iTerm2 已損毀或不完整。請從官方網站重新安裝 iTerm2。"
          }
        }
      }
    },
