    "PTYSession.CommandSelectionInfo" : {
      "comment" : "Informational message explaining command selection and how to disable it; contains an HTML link",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrali jste příkaz kliknutím na něj. Hledání, filtrování a Vybrat vše se tím omezí na obsah příkazu. Tuto funkci můžete vypnout v části „Nastavení > Obecné > Výběr“. <a href=\"iterm2:disable-command-selection\">Kliknutím sem tuto funkci vypnete.</a>"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har markeret en kommando ved at klikke på den. Det begrænser Find, Filtrer og Vælg alle til kommandoens indhold. Du kan slå denne funktion fra i Indstillinger > Generelt > Markering. <a href=\"iterm2:disable-command-selection\">Klik her for at slå denne funktion fra.</a>"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben einen Befehl durch Anklicken ausgewählt. Dadurch werden Suchen, Filtern und Alles auswählen auf den Inhalt des Befehls beschränkt. Sie können diese Funktion unter Einstellungen > Allgemein > Auswahl deaktivieren. <a href=\"iterm2:disable-command-selection\">Klicken Sie hier, um diese Funktion zu deaktivieren.</a>"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You’ve selected a command by clicking on it. This restricts Find, Filter, and Select All to the content of the command. You can turn this feature off in Settings > General > Selection. <a href=\"iterm2:disable-command-selection\">Click here to disable this feature.</a>"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has seleccionado un comando haciendo clic en él. Esto limita Buscar, Filtrar y Seleccionar todo al contenido del comando. Puedes desactivar esta función en Ajustes > General > Selección. <a href=\"iterm2:disable-command-selection\">Haz clic aquí para desactivar esta función.</a>"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet valinnut komennon klikkaamalla sitä. Tämä rajaa Etsi-, Suodata- ja Valitse kaikki -toiminnot komennon sisältöön. Voit poistaa ominaisuuden käytöstä kohdassa Asetukset > Yleiset > Valinta. <a href=\"iterm2:disable-command-selection\">Poista ominaisuus käytöstä klikkaamalla tästä.</a>"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez sélectionné une commande en cliquant dessus. Rechercher, Filtrer et Tout sélectionner sont donc limités au contenu de la commande. Vous pouvez désactiver cette fonctionnalité dans Réglages > Général > Sélection. <a href=\"iterm2:disable-command-selection\">Cliquez ici pour désactiver cette fonctionnalité.</a>"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato un comando facendo clic su di esso. Questo limita Trova, Filtra e Seleziona tutto al contenuto del comando. Puoi disattivare questa funzione in Impostazioni > Generali > Selezione. <a href=\"iterm2:disable-command-selection\">Fai clic qui per disattivare questa funzione.</a>"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドをクリックして選択しました。これにより、検索、フィルター、すべてを選択の対象がそのコマンドの内容に限定されます。この機能は設定 > 一般 > 選択でオフにできます。<a href=\"iterm2:disable-command-selection\">この機能を無効にするにはここをクリックしてください。</a>"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 클릭하여 선택했습니다. 이렇게 하면 찾기, 필터 및 모두 선택이 해당 명령의 내용으로 제한됩니다. 이 기능은 설정 > 일반 > 선택에서 끌 수 있습니다. <a href=\"iterm2:disable-command-selection\">이 기능을 끄려면 여기를 클릭하십시오.</a>"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har markert en kommando ved å klikke på den. Dette begrenser Finn, Filtrer og Marker alt til innholdet i kommandoen. Du kan slå av denne funksjonen i «Innstillinger > Generelt > Markering». <a href=\"iterm2:disable-command-selection\">Klikk her for å deaktivere denne funksjonen.</a>"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt een commando geselecteerd door erop te klikken. Hierdoor worden Zoek, Filter en Selecteer alles beperkt tot de inhoud van het commando. Je kunt dit uitschakelen via Instellingen > Algemeen > Selectie. <a href=\"iterm2:disable-command-selection\">Klik hier om deze functie uit te schakelen.</a>"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznaczono polecenie przez kliknięcie. Ogranicza to Znajdź, Filtruj i Zaznacz wszystko do zawartości polecenia. Możesz wyłączyć tę funkcję w Ustawienia > Ogólne > Zaznaczanie. <a href=\"iterm2:disable-command-selection\">Kliknij tutaj, aby ją wyłączyć.</a>"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você selecionou um comando clicando nele. Isso restringe Buscar, Filtrar e Selecionar tudo ao conteúdo do comando. Você pode desativar esse recurso em Ajustes > Geral > Seleção. <a href=\"iterm2:disable-command-selection\">Clique aqui para desativar esse recurso.</a>"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выбрали команду, щёлкнув по ней. Это ограничивает область действия команд «Найти», «Фильтр» и «Выделить всё» содержимым этой команды. Вы можете отключить эту функцию в Настройки > Общие > Выделение. <a href=\"iterm2:disable-command-selection\">Нажмите здесь, чтобы отключить эту функцию.</a>"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označili ste príkaz kliknutím naň. Funkcie Nájsť, Filtrovať a Označiť všetko sa tým obmedzia na obsah príkazu. Túto funkciu môžete vypnúť v časti „Nastavenia > Všeobecné > Výber“. <a href=\"iterm2:disable-command-selection\">Kliknutím sem túto funkciu vypnete.</a>"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrali ste ukaz s klikom nanj. Zaradi tega so Poišči, Filtriraj in Izberi vse omejeni na vsebino ukaza. To funkcijo lahko izklopite v »Nastavitve > Splošno > Izbor«. <a href=\"iterm2:disable-command-selection\">Kliknite tukaj, da izklopite to funkcijo.</a>"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har markerat ett kommando genom att klicka på det. Då begränsas Sök, Filtrera och Markera alla till kommandots innehåll. Du kan stänga av den här funktionen i ”Inställningar > Allmänt > Markering”. <a href=\"iterm2:disable-command-selection\">Klicka här för att avaktivera funktionen.</a>"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir komutu üzerine tıklayarak seçtiniz. Bu, Bul, Filtrele ve Tümünü Seç işlemlerini komutun içeriğiyle sınırlar. Bu özelliği Ayarlar > Genel > Seçim bölümünden kapatabilirsiniz. <a href=\"iterm2:disable-command-selection\">Bu özelliği devre dışı bırakmak için buraya tıklayın.</a>"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã chọn một lệnh bằng cách bấm vào nó. Điều này giới hạn Tìm, Lọc và Chọn tất cả trong nội dung của lệnh. Bạn có thể tắt tính năng này trong Cài đặt > Chung > Vùng chọn. <a href=\"iterm2:disable-command-selection\">Bấm vào đây để tắt tính năng này.</a>"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您通过点击命令来选中它。此功能会限制“查找”、“筛选”和“全选”操作仅针对该命令的内容。您可以在设置 > 通用 > 选择中关闭此功能。<a href=\"iterm2:disable-command-selection\">点击此处禁用此功能。</a>"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已按一下選取了一個指令。這會將尋找、篩選與全選限制在該指令的內容範圍內。你可以在「設定 > 一般 > 選取範圍」中關閉此功能。<a href=\"iterm2:disable-command-selection\">按一下這裡以停用此功能。</a>"
          }
        }
      }
    },
