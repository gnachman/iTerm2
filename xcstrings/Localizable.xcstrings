    "TransferrableFile.FileExistsPrompt" : {
      "comment" : "Prompt shown when a downloaded file name already exists; %@ is the file name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor s názvem %@ již existuje. Ponechat oba soubory, nebo existující soubor nahradit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes allerede et arkiv med navnet %@. Vil du beholde begge arkiver eller erstatte det eksisterende?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei namens %@ existiert bereits. Beide Dateien behalten oder die vorhandene Datei ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A file named %@ already exists. Keep both files or replace the existing file?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo llamado %@. ¿Quieres conservar ambos archivos o reemplazar el existente?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedosto nimeltä %@ on jo olemassa. Säilytetäänkö molemmat tiedostot vai korvataanko olemassa oleva tiedosto?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier nommé %@ existe déjà. Conserver les deux fichiers ou remplacer le fichier existant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file chiamato %@. Vuoi mantenere entrambi i file o sostituire quello esistente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@という名前のファイルはすでに存在します。両方のファイルを残しますか、それとも既存のファイルを置き換えますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)라는 파일이 이미 있습니다. 두 파일을 모두 유지하겠습니까, 아니면 기존 파일을 대치하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes allerede en fil med navnet %@. Vil du beholde begge filene eller erstatte den eksisterende?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een bestand met de naam %@. Wil je beide bestanden bewaren of het bestaande bestand vervangen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik o nazwie %@ już istnieje. Zachować oba pliki czy zastąpić istniejący?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um arquivo chamado %@. Manter ambos os arquivos ou substituir o arquivo existente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл с именем %@ уже существует. Оставить оба файла или заменить существующий?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor s názvom %@ už existuje. Chcete ponechať oba súbory, alebo nahradiť existujúci?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteka z imenom %@ že obstaja. Želite obdržati obe datoteki ali zamenjati obstoječo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil med namnet %@ finns redan. Vill du behålla båda filerna eller ersätta den befintliga filen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adlı bir dosya zaten var. Her iki dosya da korunsun mu, yoksa mevcut dosya değiştirilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có một tệp tên %@. Giữ cả hai tệp hay thay thế tệp hiện có?"
