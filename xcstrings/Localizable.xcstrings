    "NaggingController.MouseReportingFrustration" : {
      "comment" : "Prompt asking whether to disable mouse reporting when it blocks selection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že se pokoušíte kopírovat do schránky, ale hlášení myši výběru zabránilo. Vypnout hlášení myši?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at du prøver at kopiere til udklipsholderen, men rapportering af mus har forhindret markeringen. Vil du slå rapportering af mus fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht so aus, als würden Sie versuchen, etwas in die Zwischenablage zu kopieren, aber die Mausberichterstattung hat die Auswahl verhindert. Mausberichterstattung deaktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like you’re trying to copy to the pasteboard, but mouse reporting has prevented making a selection. Disable mouse reporting?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que intentas copiar al portapapeles, pero el informe del ratón ha impedido hacer una selección. ¿Desactivar el informe del ratón?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää siltä, että yrität kopioida leikepöydälle, mutta hiiren raportointi esti valinnan tekemisen. Poistetaanko hiiren raportointi käytöstä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous essayiez de copier dans le presse-papiers, mais le signalement de la souris a empêché la sélection. Désactiver le signalement de la souris ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu stia cercando di copiare negli Appunti, ma la segnalazione del mouse ha impedito di effettuare una selezione. Disabilitare la segnalazione del mouse?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストボードにコピーしようとしているようですが、マウスレポートが有効なため選択できないようです。マウスレポートを無効にしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드에 복사하려는 것 같지만 마우스 리포팅 때문에 선택할 수 없습니다. 마우스 리포팅을 끄겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at du prøver å kopiere til utklippstavlen, men musrapportering har hindret markering. Vil du slå av musrapportering?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat je naar het klembord wilt kopiëren, maar muisrapportage heeft het maken van een selectie verhinderd. Wil je muisrapportage uitschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że próbujesz skopiować do schowka, ale raportowanie myszy uniemożliwiło zaznaczenie. Wyłączyć raportowanie myszy?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está tentando copiar para a área de transferência, mas o relatório do mouse impediu a seleção. Desativar o relatório do mouse?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы пытаетесь скопировать текст в буфер обмена, но отчёты о мыши мешают сделать выделение. Отключить отчёты о мыши?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že sa snažíte kopírovať do schránky, ale hlásenie myši zabránilo vytvoreniu výberu. Vypnúť hlásenie myši?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da poskušate kopirati v odložišče, vendar je poročanje miške preprečilo izbor. Želite onemogočiti poročanje miške?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut som att du försöker kopiera till urklipp, men musrapporteringen har hindrat markeringen. Vill du avaktivera musrapportering?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoya kopyalamaya çalışıyor gibisiniz ancak fare raporlama seçim yapılmasını engelledi. Fare raporlama devre dışı bırakılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ bạn đang cố sao chép vào bảng nhớ tạm, nhưng báo cáo chuột đã ngăn việc tạo vùng chọn. Tắt báo cáo chuột?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来你想拷贝到剪贴板，但鼠标报告功能阻止了选区操作。要停用鼠标报告吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起來你想拷貝到剪貼簿，但滑鼠回報使你無法進行選取。要停用滑鼠回報嗎？"
          }
        }
      }
    },
