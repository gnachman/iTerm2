    "AdvancedSetting.suppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline" : {
      "comment" : "Advanced setting: suppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat upozornění na vkládání více řádků při vkládání jednoho řádku končícího novým řádkem.\nPotlačí všechna upozornění na vkládání více řádků, když se vkládá jeden řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul advarsel om indsætning af flere linjer, når der indsættes en enkelt linje, der slutter med et linjeskift.\nDet skjuler alle advarsler om indsætning af flere linjer, når en enkelt linje indsættes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über mehrzeiliges Einfügen unterdrücken, wenn eine einzelne Zeile eingefügt wird, die mit einem Zeilenumbruch endet.\nDies unterdrückt alle Warnungen über mehrzeiliges Einfügen, wenn eine einzelne Zeile eingefügt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line paste when pasting a single line ending with a newline.\nThis suppresses all multi-line paste warnings when a single line is being pasted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la advertencia sobre pegados de varias líneas al pegar una sola línea que termina en un salto de línea.\nSuprime todas las advertencias de pegado de varias líneas cuando se pega una sola línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaimenna varoitus usean rivin sijoituksesta, kun sijoitetaan yksi rivinvaihtoon päättyvä rivi.\nTämä vaimentaa kaikki usean rivin sijoituksen varoitukset, kun sijoitetaan yksi rivi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’avertissement sur le collage de plusieurs lignes lors du collage d’une seule ligne se terminant par un saut de ligne.\nCela désactive tous les avertissements de collage de plusieurs lignes lorsqu’une seule ligne est collée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso sull’incolla su più righe quando si incolla una singola riga che termina con un a capo.\nDisattiva tutti gli avvisi di incolla su più righe quando viene incollata una singola riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改行で終わる1行を貼り付けるときの複数行の貼り付けに関する警告を表示しない。\nこれは1行のみが貼り付けられる場合に、すべての複数行貼り付け警告を抑制します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄바꿈으로 끝나는 한 줄을 붙여넣을 때 여러 줄 붙여넣기 경고 표시 안 함.\n한 줄을 붙여넣을 때는 모든 여러 줄 붙여넣기 경고를 표시하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis advarsel om innliming av flere linjer når én linje som slutter med linjeskift limes inn.\nDette skjuler alle advarsler om innliming av flere linjer når én enkelt linje limes inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk de waarschuwing over plakken van meerdere regels bij het plakken van één regel die eindigt op een nieuwe regel.\nDit onderdrukt alle waarschuwingen over plakken van meerdere regels wanneer één regel wordt geplakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pokazuj ostrzeżenia o wklejaniu wielu wierszy przy wklejaniu jednego wiersza zakończonego znakiem nowego wiersza.\nWyłącza wszystkie ostrzeżenia o wklejaniu wielu wierszy, gdy wklejany jest jeden wiersz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagem de várias linhas ao colar uma única linha terminada com uma quebra de linha.\nIsso suprime todos os avisos de colagem de várias linhas quando uma única linha está sendo colada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение о многострочной вставке при вставке одной строки, заканчивающейся переносом строки.\nЭто отключает все предупреждения о многострочной вставке, когда вставляется одна строка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať upozornenie na viacriadkové vkladanie pri vkladaní jedného riadka končiaceho znakom nového riadka.\nPotlačí všetky upozornenia na viacriadkové vkladanie, keď sa vkladá jeden riadok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži opozorila o večvrstičnem lepljenju pri lepljenju ene vrstice, ki se konča z novo vrstico.\nTo utiša vsa opozorila o večvrstičnem lepljenju, ko se lepi ena vrstica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj varningen om inklistring av flera rader när en enda rad som slutar med nyrad klistras in.\nDet döljer alla varningar om inklistring av flera rader när en enda rad klistras in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni satırla biten tek satır yapıştırılırken çok satırlı yapıştırma uyarısını bir daha gösterme.\nTek satır yapıştırılırken tüm çok satırlı yapıştırma uyarılarını gizler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị cảnh báo dán nhiều dòng khi dán một dòng kết thúc bằng ký tự xuống dòng.\nĐiều này ẩn mọi cảnh báo dán nhiều dòng khi chỉ dán một dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在粘贴以换行符结尾的单行内容时，是否应忽略多行粘贴警告？  \n这会消除单行粘贴时的所有多行粘贴警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上以換行結尾的單行時，不再顯示多行貼上的警告。\n貼上單行時，這會隱藏所有多行貼上的警告。"
          }
        }
      }
    },
    "AdvancedSetting.suppressRestartAnnouncement" : {
      "comment" : "Advanced setting: suppressRestartAnnouncement",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat nabídku restartování relace.\nKdyž se relace ukončí, nabídne restartování. Zapnutím nabídku trvale potlačíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul tilbuddet om at starte sessionen igen.\nNår en session afsluttes, tilbyder den at starte sig selv igen. Slå dette til for at skjule tilbuddet permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angebot zum Neustart der Sitzung unterdrücken.\nWenn eine Sitzung endet, wird angeboten, sie neu zu starten. Aktivieren Sie dies, um das Angebot dauerhaft zu unterdrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress the Restart Session offer.\nWhen a session terminates, it will offer to restart itself. Turn this on to suppress the offer permanently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la oferta de reiniciar la sesión.\nCuando una sesión termina, ofrecerá reiniciarse. Actívalo para suprimir la oferta de forma permanente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaimenna Käynnistä istunto uudelleen -tarjous.\nKun istunto päättyy, se tarjoutuu käynnistymään uudelleen. Laita tämä päälle vaimentaaksesi tarjouksen pysyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver la proposition de redémarrer la session.\nLorsqu’une session se termine, elle propose de se redémarrer. Activez cette option pour désactiver définitivement cette proposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva la proposta di riavviare la sessione.\nQuando una sessione termina, propone di riavviarsi. Attiva questa opzione per disattivare la proposta in modo permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart Sessionの提案を表示しない。\nセッションが終了すると、再起動を提案します。これを有効にすると、その提案を永続的に抑制します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 재시작 제안 표시 안 함.\n세션이 종료되면 세션을 재시작할지 제안합니다. 이 제안을 영구적으로 표시하지 않으려면 이 설정을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis tilbudet om å starte økten på nytt.\nNår en økt avsluttes, tilbyr den å starte seg selv på nytt. Slå dette på for å skjule tilbudet permanent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk het aanbod ‘Start sessie opnieuw’.\nWanneer een sessie eindigt, biedt die aan zichzelf opnieuw te starten. Schakel dit in om het aanbod permanent te onderdrukken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pokazuj oferty ponownego uruchomienia sesji.\nGdy sesja się zakończy, zaoferuje ponowne uruchomienie. Włącz, aby na stałe wyłączyć tę ofertę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir a oferta de Reiniciar sessão.\nQuando uma sessão termina, ela oferecerá reiniciar a si mesma. Ative isto para suprimir a oferta permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предложение перезапустить сеанс.\nПри завершении сеанса будет предложено перезапустить его. Включите этот параметр, чтобы отключить это предложение навсегда."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať ponuku Reštartovať reláciu.\nKeď sa relácia ukončí, ponúkne svoj reštart. Zapnutím túto ponuku trvalo potlačíte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži ponudbe Znova zaženi sejo.\nKo se seja konča, ponudi ponovni zagon. Vklopite za trajno utišanje ponudbe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj erbjudandet Starta om session.\nNär en session avslutas erbjuder den att starta om sig själv. Slå på det här för att dölja erbjudandet permanent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu Yeniden Başlat önerisini bir daha gösterme.\nBir oturum sonlandığında kendini yeniden başlatmayı önerir. Öneriyi kalıcı olarak gizlemek için bunu açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị đề nghị Khởi động lại phiên.\nKhi một phiên kết thúc, nó sẽ đề nghị tự khởi động lại. Bật tùy chọn này để không hiển thị đề nghị đó vĩnh viễn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应隐藏“重启会话”选项？  \n当会话终止时，会提供重新启动的选项。开启此选项可永久隐藏该选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示「重新啟動工作階段」建議。\n工作階段結束時，會提示是否重新啟動。開啟此項可永久不再顯示該建議。"
          }
        }
      }
    },
    "AdvancedSetting.swapFindNextPrevious" : {
      "comment" : "Advanced setting: swapFindNextPrevious",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohodit Hledat další a Hledat předchozí.\nPokud je zapnuto, Hledat další hledá nahoru a Hledat předchozí hledá dolů (tradiční chování iTerm2, které se odchyluje od standardu macOS). Pokud je vypnuto, hledání se chová jako v běžné aplikaci macOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt om på Find næste og Find forrige.\nHvis det er slået til, søger Find næste opad, og Find forrige søger nedad (den traditionelle adfærd i iTerm2, som afviger fra macOS’ standard). Når det er slået fra, opfører søgning sig som i en almindelig macOS-app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weitersuchen“ und „Vorherige suchen“ vertauschen.\nWenn aktiviert, sucht „Weitersuchen“ aufwärts und „Vorherige suchen“ abwärts (das traditionelle Verhalten von iTerm2, das vom macOS-Standard abweicht). Wenn deaktiviert, verhält sich die Suche wie in einer normalen macOS-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swap Find Next and Find Previous.\nIf enabled, Find Next will search up and Find Previous will search down (iTerm2's traditional behavior, which is a departure from macOS's standard). When disabled, search behaves like a normal macOS app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia Buscar siguiente y Buscar anterior.\nSi está activado, Buscar siguiente buscará hacia arriba y Buscar anterior hacia abajo (el comportamiento tradicional de iTerm2, que se aparta del estándar de macOS). Si está desactivado, la búsqueda se comporta como en una app normal de macOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda Etsi seuraava ja Etsi edellinen keskenään.\nJos käytössä, Etsi seuraava hakee ylöspäin ja Etsi edellinen alaspäin (iTerm2:n perinteinen toiminta, joka poikkeaa macOS:n standardista). Kun ei käytössä, haku toimii kuin tavallisessa macOS-sovelluksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverser Rechercher le suivant et Rechercher le précédent.\nSi activé, Rechercher le suivant cherche vers le haut et Rechercher le précédent vers le bas (comportement traditionnel d’iTerm2, qui s’écarte de la norme de macOS). Si désactivé, la recherche se comporte comme dans une app macOS normale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia Trova successivo e Trova precedente.\nSe attivo, Trova successivo cercherà verso l’alto e Trova precedente verso il basso (il comportamento tradizionale di iTerm2, che si discosta dallo standard di macOS). Se disattivato, la ricerca si comporta come in una normale app macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次を検索」と「前を検索」を入れ替える。\n有効にすると、「次を検索」は上方向、「前を検索」は下方向に検索します（macOSの標準とは異なる、iTerm2の従来の動作です）。無効にすると、検索は通常のmacOSアプリと同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 찾기와 이전 찾기 바꾸기.\n켜져 있으면 다음 찾기는 위쪽으로, 이전 찾기는 아래쪽으로 검색합니다(macOS 표준과 다른 iTerm2의 전통적인 동작). 꺼져 있으면 일반적인 macOS 앱처럼 검색합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt om Finn neste og Finn forrige.\nHvis dette er aktivert, søker Finn neste oppover og Finn forrige nedover (iTerm2s tradisjonelle oppførsel, som avviker fra macOS-standarden). Når det er deaktivert, oppfører søket seg som i et vanlig macOS-app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwissel Zoek volgende en Zoek vorige.\nAls dit is ingeschakeld, zoekt Zoek volgende omhoog en Zoek vorige omlaag (het traditionele gedrag van iTerm2, dat afwijkt van de standaard van macOS). Als dit is uitgeschakeld, gedraagt zoeken zich als in een gewone macOS-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamień Znajdź następne i Znajdź poprzednie.\nJeśli włączone, Znajdź następne będzie szukać w górę, a Znajdź poprzednie w dół (tradycyjne zachowanie iTerm2, odbiegające od standardu macOS). Gdy wyłączone, wyszukiwanie działa jak w zwykłej aplikacji macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar Buscar próximo e Buscar anterior.\nSe ativado, Buscar próximo buscará para cima e Buscar anterior buscará para baixo (o comportamento tradicional do iTerm2, que se afasta do padrão do macOS). Quando desativado, a busca se comporta como em um app normal do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поменять местами «Найти следующее» и «Найти предыдущее».\nЕсли включено, «Найти следующее» будет искать вверх, а «Найти предыдущее» — вниз (традиционное поведение iTerm2, отличающееся от стандартного для macOS). Если выключено, поиск ведёт себя как в обычном приложении macOS."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymeniť Nájsť ďalšie a Nájsť predošlé.\nKeď je zapnuté, Nájsť ďalšie hľadá smerom hore a Nájsť predošlé smerom dole (tradičné správanie iTerm2, ktoré sa odchyľuje od štandardu macOS). Keď je vypnuté, vyhľadávanie sa správa ako v bežnej aplikácii macOS."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamenjaj Poišči naslednje in Poišči prejšnje.\nČe je omogočeno, Poišči naslednje išče navzgor in Poišči prejšnje navzdol (tradicionalno vedenje iTerm2, ki odstopa od standarda sistema macOS). Če je onemogočeno, se iskanje obnaša kot v običajni aplikaciji macOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt Sök nästa och Sök föregående.\nOm det är aktiverat söker Sök nästa uppåt och Sök föregående nedåt (iTerm2:s traditionella beteende, som avviker från macOS standard). När det är avaktiverat beter sig sökningen som i en vanlig macOS-app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonrakini Bul ile Öncekini Bul’u değiş tokuş et.\nEtkinse Sonrakini Bul yukarı, Öncekini Bul aşağı arar (iTerm2’nin geleneksel davranışı; macOS standardından bir sapmadır). Devre dışıyken arama normal bir macOS uygulaması gibi davranır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoán đổi Tìm tiếp và Tìm trước.\nNếu bật, Tìm tiếp sẽ tìm lên và Tìm trước sẽ tìm xuống (hành vi truyền thống của iTerm2, khác với chuẩn của macOS). Khi tắt, tìm kiếm hoạt động như ứng dụng macOS thông thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应交换“查找下一个”和“查找上一个”。  \n若启用，“查找下一个”会向上搜索，而“查找上一个”会向下搜索（这是 iTerm2 的传统行为，与 macOS 标准不同）。禁用后，搜索行为类似普通 macOS 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對調「尋找下一個」和「尋找上一個」。\n啟用後，「尋找下一個」會向上搜尋，「尋找上一個」會向下搜尋（這是 iTerm2 的傳統行為，與 macOS 的標準不同）。停用時，搜尋的行為與一般 macOS App 相同。"
          }
        }
      }
    },
    "AdvancedSetting.synchronizeQueryWithFindPasteboard" : {
      "comment" : "Advanced setting: synchronizeQueryWithFindPasteboard",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizovat hledané výrazy napříč okny a aplikacemi.\nObvykle se při zadání hledaného výrazu do pole hledání aktualizují všechna pole hledání ve všech aplikacích na stejnou hodnotu. To je naprostý nesmysl a lze to vypnout nastavením této volby na Ne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniser søgeforespørgsler på tværs af vinduer og programmer.\nNormalt opdateres alle søgefelter i alle programmer til den samme værdi, når du skriver en søgeforespørgsel i et søgefelt. Det er det rene vrøvl og kan slås fra ved at sætte denne indstilling til Nej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchanfragen zwischen Fenstern und Anwendungen synchronisieren.\nNormalerweise werden beim Eingeben einer Suchanfrage in ein Suchfeld alle Suchfelder in allen Anwendungen mit demselben Wert aktualisiert. Das ist völliger Unsinn und kann deaktiviert werden, indem diese Einstellung auf „Nein“ gesetzt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Synchronize search queries across windows and applications.\nNormally, when you enter a search query in a Find field all find fields in all applications get updated to hold the same value. This is utter nonsense, and can be disabled by setting this preference to No."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza las consultas de búsqueda entre ventanas y aplicaciones.\nNormalmente, al escribir una consulta en un campo de búsqueda, todos los campos de búsqueda de todas las aplicaciones se actualizan con el mismo valor. Es un disparate y se puede desactivar poniendo este ajuste en No."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronoi hakukyselyt ikkunoiden ja sovellusten välillä.\nNormaalisti kun kirjoitat hakukyselyn Etsi-kenttään, kaikki kaikkien sovellusten etsi-kentät päivittyvät sisältämään saman arvon. Tämä on täyttä hölynpölyä, ja sen voi poistaa käytöstä asettamalla tämän asetuksen arvoon Ei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniser les requêtes de recherche entre les fenêtres et les apps.\nNormalement, lorsque vous saisissez une requête dans un champ de recherche, tous les champs de recherche de toutes les apps sont mis à jour avec la même valeur. C’est absurde, et vous pouvez le désactiver en réglant cette préférence sur Non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza le query di ricerca tra finestre e applicazioni.\nNormalmente, quando inserisci una query in un campo di ricerca, tutti i campi di ricerca di tutte le applicazioni vengono aggiornati con lo stesso valore. È una totale assurdità e si può disabilitare impostando questa preferenza su No."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索クエリをウィンドウやアプリケーション間で同期する。\n通常、検索フィールドにクエリを入力すると、すべてのアプリケーションのすべての検索フィールドが同じ値で更新されます。これはまったくのナンセンスであり、この設定を「いいえ」にすることで無効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우와 앱 간에 검색어를 동기화합니다.\n일반적으로 찾기 필드에 검색어를 입력하면 모든 앱의 모든 찾기 필드가 같은 값으로 업데이트됩니다. 이는 전혀 말이 되지 않으므로 이 설정을 아니요로 지정하여 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniser søkespørringer på tvers av vinduer og apper.\nNormalt, når du skriver en søkespørring i et søkefelt, oppdateres alle søkefelt i alle apper til å inneholde samme verdi. Dette er fullstendig meningsløst, og kan deaktiveres ved å sette denne innstillingen til Nei."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseer zoekopdrachten tussen vensters en apps.\nNormaal worden, wanneer je een zoekopdracht in een zoekveld invoert, alle zoekvelden in alle apps bijgewerkt met dezelfde waarde. Dit is complete onzin en kan worden uitgeschakeld door deze voorkeur op Nee te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuj zapytania wyszukiwania między oknami i aplikacjami.\nZwykle po wpisaniu zapytania w polu wyszukiwania wszystkie pola wyszukiwania we wszystkich aplikacjach są aktualizowane do tej samej wartości. To kompletny nonsens i można to wyłączyć, ustawiając tę opcję na Nie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar consultas de busca entre janelas e aplicativos.\nNormalmente, quando você digita uma consulta de busca em um campo de busca, todos os campos de busca em todos os aplicativos são atualizados para conter o mesmo valor. Isso é um completo absurdo e pode ser desativado definindo esta preferência como Não."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизировать поисковые запросы между окнами и приложениями.\nОбычно при вводе поискового запроса в поле поиска все поля поиска во всех приложениях обновляются, получая то же значение. Это полная бессмыслица, и её можно отключить, установив этот параметр в «Нет»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizovať vyhľadávané výrazy medzi oknami a aplikáciami.\nBežne sa po zadaní hľadaného výrazu do poľa Nájsť aktualizujú všetky polia na hľadanie vo všetkých aplikáciách na rovnakú hodnotu. Je to úplný nezmysel a dá sa to vypnúť nastavením tejto voľby na No."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinhroniziraj iskalne poizvedbe med okni in aplikacijami.\nObičajno se ob vnosu iskalne poizvedbe v polje za iskanje posodobijo vsa polja za iskanje v vseh aplikacijah, da vsebujejo isto vrednost. To je popoln nesmisel in ga lahko onemogočite z nastavitvijo te možnosti na Ne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisera sökfrågor mellan fönster och program.\nNormalt, när du anger en sökfråga i ett sökfält, uppdateras alla sökfält i alla program till samma värde. Det är rent nonsens, och kan avaktiveras genom att ställa in den här inställningen på Nej."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama sorgularını pencereler ve uygulamalar arasında eşzamanla.\nNormalde bir Bul alanına sorgu girdiğinizde tüm uygulamalardaki tüm bul alanları aynı değeri tutacak şekilde güncellenir. Bu tamamen saçmalıktır ve bu tercih Hayır yapılarak devre dışı bırakılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng bộ truy vấn tìm kiếm giữa các cửa sổ và ứng dụng.\nThông thường, khi bạn nhập truy vấn vào một ô Tìm, tất cả các ô tìm trong mọi ứng dụng được cập nhật để giữ cùng giá trị. Điều này hoàn toàn vô lý, và có thể tắt bằng cách đặt tùy chọn này thành Không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应在窗口和应用程序间同步搜索查询？  \n通常，在查找字段输入搜索词后，所有应用的查找字段会更新为相同值。此设置完全无用，可通过将此偏好设为“否”来禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在各視窗和 App 之間同步搜尋字串。\n一般而言，當你在尋找欄位中輸入搜尋字串時，所有 App 中的所有尋找欄位都會更新為相同的值。這完全是無稽之談，可將此偏好設定設為「否」來停用。"
          }
        }
      }
    },
    "AdvancedSetting.synergyModifierRemappingEnabled" : {
      "comment" : "Advanced setting: synergyModifierRemappingEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporovat přemapování modifikačních kláves u úhozů pocházejících ze Synergy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøt omtildeling af kombitaster for tastetryk, der stammer fra Synergy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbelegung von Modifizierertasten für von Synergy stammende Tastenanschläge unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support modifier remapping for keystrokes originated by Synergy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admite la reasignación de modificadores para pulsaciones originadas por Synergy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tue muuntonäppäinten uudelleenmääritystä Synergyn tuottamille näppäinpainalluksille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre en charge le remappage des modificateurs pour les frappes provenant de Synergy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporta la rimappatura dei tasti modificatori per i tasti premuti provenienti da Synergy."
