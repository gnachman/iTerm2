    "PasswordArchive.NoKeychainScope" : {
      "comment" : "Shown when the user opens a passwords file while neither the terminal nor the browser password manager uses the Keychain",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter können nur in den Passwort-Manager „macOS-Schlüsselbund“ importiert werden. Öffnen Sie dazu den Passwort-Manager, wählen Sie im Zahnradmenü „macOS-Schlüsselbund“ und öffnen Sie diese Datei dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Passwords can be imported only into the macOS Keychain password manager. To import them, open the password manager, choose macOS Keychain from its gear menu, and then open this file again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas solo se pueden importar en el gestor de contraseñas del llavero de macOS. Para importarlas, abre el gestor de contraseñas, elige llavero de macOS en su menú de engranaje y vuelve a abrir este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe ne peuvent être importés que dans le gestionnaire de mots de passe Trousseau macOS. Pour les importer, ouvrez le gestionnaire de mots de passe, choisissez Trousseau macOS dans son menu en forme d’engrenage, puis rouvrez ce fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le password possono essere importate solo nel gestore password Portachiavi di macOS. Per importarle, apri il gestore password, scegli Portachiavi di macOS dal menu a forma di ingranaggio e poi riapri questo file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードは macOS キーチェーンのパスワードマネージャーにのみインポートできます。インポートするには、パスワードマネージャーを開き、歯車メニューから「macOS キーチェーン」を選択してから、このファイルをもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 macOS 키체인 암호 관리자로만 가져올 수 있습니다. 가져오려면 암호 관리자를 열고 톱니바퀴 메뉴에서 macOS 키체인을 선택한 다음 이 파일을 다시 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As senhas só podem ser importadas para o cofre de senhas da Keychain do macOS. Para importá-las, abra o cofre de senhas, escolha Keychain do macOS no menu de engrenagem e abra este arquivo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли можно импортировать только в менеджер паролей «Связка ключей macOS». Чтобы импортировать их, откройте менеджер паролей, выберите «Связка ключей macOS» в меню с шестерёнкой, а затем снова откройте этот файл."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalar yalnızca macOS anahtar zinciri parola yöneticisine içe aktarılabilir. İçe aktarmak için parola yöneticisini açın, dişli menüsünden macOS anahtar zincirini seçin ve bu dosyayı yeniden açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码只能导入到 macOS 钥匙串密码管理器中。要导入它们，请打开密码管理器，从其齿轮菜单中选择“macOS 钥匙串”，然后再次打开此文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼只能匯入 macOS 鑰匙圈密碼管理器。若要匯入，請打開密碼管理器，從其齒輪選單中選取「macOS 鑰匙圈」，然後再次打開此檔案。"
          }
        }
      }
    },
