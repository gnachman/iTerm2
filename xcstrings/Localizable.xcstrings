        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo comprobar si “%1$@” ya existe en el host remoto, por lo que no se subió: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de vérifier si « %1$@ » existe déjà sur l’hôte distant. Le fichier n’a donc pas été téléversé : %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare se “%1$@” esista già sull’host remoto, quindi non è stato caricato: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートホストに“%1$@”が既に存在するかどうかを確認できなかったため、アップロードしませんでした: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 호스트에 “%1$@”이(가) 이미 있는지 확인할 수 없어 업로드하지 않았습니다: %2$@"
