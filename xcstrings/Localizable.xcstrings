          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ambiente Python de “%@” está ausente (o runtime compartilhado pode ter sido apagado). Inicie-o pelo menu Scripts para reconstruí-lo.\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окружение Python для «%@» отсутствует (возможно, общая среда выполнения была удалена). Запустите его из меню Scripts, чтобы пересобрать.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
