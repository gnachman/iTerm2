    "StatusBarSnippet.DetailedDescription" : {
      "comment" : "Detailed description of the snippets menu status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet beim Anklicken ein Menü mit Schnipseln. Schnipsel sind gespeicherte Textbausteine, die schnell eingefügt werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicked, opens a menu of snippets. Snippets are saved text strings that can be pasted quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer clic, abre un menú de fragmentos. Los fragmentos son cadenas de texto guardadas que se pueden pegar rápidamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au clic, ouvre un menu d’extraits. Les extraits sont des chaînes de texte enregistrées qui peuvent être collées rapidement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si fa clic, apre un menu di frammenti. I frammenti sono stringhe di testo salvate che possono essere incollate rapidamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックするとスニペットのメニューが開きます。スニペットは、すばやく貼り付けられる保存済みのテキスト文字列です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 스니펫 메뉴가 열립니다. 스니펫은 빠르게 붙여넣을 수 있도록 저장해 둔 텍스트 문자열입니다."
          }
