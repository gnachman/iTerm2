    "StatusBarAction.DetailedDescription" : {
      "comment" : "Detailed description of the custom action status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Schaltfläche hinzu, die eine benutzerdefinierte Aktion ausführt, ähnlich einer Tastenkombination."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds a button that performs a user-configurable action, similar to a key binding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un botón que realiza una acción configurable por el usuario, similar a una asignación de teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un bouton qui exécute une action configurable par l’utilisateur, comme une association de touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un pulsante che esegue un’azione configurabile dall’utente, simile a un’associazione tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーバインドのように、ユーザーが設定可能なアクションを実行するボタンを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키 바인딩과 비슷하게 사용자가 구성할 수 있는 동작을 수행하는 버튼을 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um botão que executa uma ação configurável pelo usuário, semelhante a uma associação de teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет кнопку, которая выполняет настраиваемое пользователем действие, аналогично сочетанию клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuş atamasına benzer şekilde, kullanıcı tarafından yapılandırılabilen bir eylemi gerçekleştiren bir düğme ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加一个执行用户可配置操作的按钮，类似于按键绑定。"
