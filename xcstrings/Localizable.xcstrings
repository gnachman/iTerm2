    "AdvancedSetting.smartCursorColorBgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorBgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert der intelligenten Cursorfarbe für die Hintergrundfarbe (0 bis 1).\n0 bedeutet, dass die Hintergrundfarbe des Cursors immer die Textfarbe der Zelle ist, während 1 bedeutet, dass sie immer Schwarz oder Weiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for background color (0 to 1).\n0 means the cursor’s background color will always be the cell’s text color, while 1 means it will always be black or white."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral del color inteligente del cursor para el color de fondo (0 a 1).\n0 significa que el color de fondo del cursor siempre será el color de texto de la celda, mientras que 1 significa que siempre será negro o blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil de la couleur de curseur intelligente pour la couleur d’arrière-plan (0 à 1).\n0 signifie que la couleur d’arrière-plan du curseur sera toujours la couleur du texte de la cellule, et 1 qu’elle sera toujours noire ou blanche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglia del colore intelligente del cursore per il colore di sfondo (da 0 a 1).\n0 significa che il colore di sfondo del cursore sarà sempre il colore del testo della cella, mentre 1 significa che sarà sempre nero o bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Cursor Colorの背景色のしきい値（0から1）。\n0はカーソルの背景色が常にセルのテキスト色になり、1は常に黒または白になることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경 색상에 대한 스마트 커서 색상의 임계값(0~1)입니다.\n0이면 커서의 배경 색상이 항상 셀의 텍스트 색상이 되고, 1이면 항상 검은색 또는 흰색이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor de plano de fundo (0 a 1).\n0 significa que a cor de plano de fundo do cursor será sempre a cor do texto da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог для функции «умный цвет курсора» (Smart Cursor Color) для цвета фона (от 0 до 1).\n0 означает, что цвет фона курсора всегда будет совпадать с цветом текста ячейки, а 1 — что он всегда будет чёрным или белым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan rengi için Akıllı İmleç Rengi eşiği (0 ile 1).\n0, imlecin arka plan renginin her zaman hücrenin metin rengi olacağı, 1 ise her zaman siyah veya beyaz olacağı anlamına gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景颜色智能光标颜色的阈值（0到1）。\n0表示光标背景颜色始终为单元格文本颜色，1则表示始终为黑色或白色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景顏色的智慧型游標顏色閾值（0 到 1）。\n0 表示游標的背景顏色一律為儲存格的文字顏色，1 則表示一律為黑色或白色。"
          }
        }
      }
    },
    "AdvancedSetting.smartCursorColorFgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorFgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert der intelligenten Cursorfarbe für die Textfarbe (0 bis 1).\n0 bedeutet, dass die Textfarbe des Cursors immer die Hintergrundfarbe der Zelle ist, während 1 bedeutet, dass sie immer Schwarz oder Weiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for text color (0 to 1).\n0 means the cursor’s text color will always be the cell’s background color, while 1 means it will always be black or white."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral del color inteligente del cursor para el color de texto (0 a 1).\n0 significa que el color de texto del cursor siempre será el color de fondo de la celda, mientras que 1 significa que siempre será negro o blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil de la couleur de curseur intelligente pour la couleur du texte (0 à 1).\n0 signifie que la couleur du texte du curseur sera toujours la couleur d’arrière-plan de la cellule, et 1 qu’elle sera toujours noire ou blanche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglia del colore intelligente del cursore per il colore del testo (da 0 a 1).\n0 significa che il colore del testo del cursore sarà sempre il colore di sfondo della cella, mentre 1 significa che sarà sempre nero o bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Cursor Colorのテキスト色のしきい値（0から1）。\n0はカーソルのテキスト色が常にセルの背景色になり、1は常に黒または白になることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 색상에 대한 스마트 커서 색상 임계값(0~1)\n0이면 커서의 텍스트 색상이 항상 셀의 배경색이 되고, 1이면 항상 검은색 또는 흰색이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor do texto (0 a 1).\n0 significa que a cor do texto do cursor será sempre a cor de plano de fundo da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог для функции «умный цвет курсора» (Smart Cursor Color) для цвета текста (от 0 до 1).\n0 означает, что цвет текста курсора всегда будет совпадать с цветом фона ячейки, а 1 — что он всегда будет чёрным или белым."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin rengi için Akıllı İmleç Rengi eşiği (0 ile 1).\n0, imlecin metin renginin her zaman hücrenin arka plan rengi olacağı, 1 ise her zaman siyah veya beyaz olacağı anlamına gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本颜色智能光标颜色的阈值（0到1）。\n0表示光标文本颜色始终为单元格背景颜色，1则表示始终为黑色或白色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字顏色的智慧型游標顏色閾值（0 到 1）。\n0 表示游標的文字顏色一律為儲存格的背景顏色，1 則表示一律為黑色或白色。"
          }
        }
      }
    },
    "AdvancedSetting.smartLoggingWithAutoComposer" : {
      "comment" : "Advanced setting: smartLoggingWithAutoComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompakteres Protokollieren bei Verwendung des Auto-Composers aktivieren?\nDadurch wird vermieden, dass Rohdaten Ihres Prompts und Ihrer Interaktionen damit protokolliert werden. Stattdessen wird der Prompt einmal als Klartext protokolliert und der Befehl beim Senden protokolliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable more compact logging when using auto composer?\nThis will avoid logging raw data in your prompt and your interactions with it. Instead, the prompt is logged once in plain text and the command is logged when sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar un registro más compacto al usar el compositor automático?\nEvita registrar datos sin procesar en tu prompt y tus interacciones con él. En su lugar, el prompt se registra una vez en texto sin formato y el comando se registra cuando se envía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer une journalisation plus compacte avec le compositeur automatique ?\nCela évite de consigner les données brutes de votre invite et vos interactions avec elle. À la place, l’invite est consignée une fois en texte brut et la commande l’est à l’envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare una registrazione più compatta quando si usa il compositore automatico?\nEvita di registrare i dati grezzi nel prompt e nelle tue interazioni con esso. Invece, il prompt viene registrato una volta in testo semplice e il comando viene registrato quando viene inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Composer使用時、よりコンパクトなログ記録を有効にするか？\nこれによりプロンプトやそのやり取りの生データをログに残すことを避けられます。代わりに、プロンプトは一度だけプレーンテキストで記録され、コマンドは送信時に記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 컴포저를 사용할 때 더 간결한 로깅을 켜겠습니까?\n프롬프트의 원시 데이터와 프롬프트에서의 상호 작용을 로깅하지 않습니다. 대신 프롬프트는 일반 텍스트로 한 번 로깅되고 명령은 보낼 때 로깅됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar registro mais compacto ao usar o auto composer?\nIsso evitará registrar dados brutos no seu prompt e suas interações com ele. Em vez disso, o prompt é registrado uma vez em texto simples e o comando é registrado quando enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить более компактное журналирование при использовании Автокомпозера?\nЭто позволит избежать журналирования необработанных данных приглашения и взаимодействия с ним. Вместо этого приглашение записывается один раз в виде обычного текста, а команда — при отправке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik oluşturucu kullanılırken daha kompakt günlükleme etkinleştirilsin mi?\nBu, isteminizdeki ve onunla etkileşimlerinizdeki ham verilerin günlüğe yazılmasını önler. Bunun yerine istem düz metin olarak bir kez günlüğe yazılır ve komut gönderildiğinde günlüğe yazılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自动生成器时是否启用更紧凑的日志？\n这将避免在提示词和您的交互中记录原始数据。相反，提示词以纯文本形式记录一次，命令在发送时记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自動編寫器時啟用更精簡的記錄？\n這會避免記錄提示詞及你與它互動的原始資料。取而代之，提示詞會以純文字記錄一次，指令則在傳送時記錄。"
          }
        }
      }
    },
    "AdvancedSetting.smartSelectionRadius" : {
      "comment" : "Advanced setting: smartSelectionRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Zeilen vor und nach der Klickposition, die in die intelligente Auswahl einbezogen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of lines before and after the click location to include in smart selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de líneas antes y después del lugar del clic que se incluyen en la selección inteligente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal de lignes avant et après l’endroit du clic à inclure dans la sélection intelligente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di righe prima e dopo il punto del clic da includere nella selezione intelligente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Selectionに含めるクリック位置の前後の最大行数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 선택에 포함할 클릭 위치 앞뒤의 최대 줄 수."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de linhas antes e depois do local do clique a incluir na seleção inteligente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное число строк до и после места щелчка, включаемых в умное выделение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı seçime dahil edilecek, tıklama konumundan önceki ve sonraki azami satır sayısı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击位置前后应包含的智能选取的最大行数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智慧型選取要納入按一下位置前後的最大行數。"
          }
        }
      }
    },
    "AdvancedSetting.solidUnderlines" : {
      "comment" : "Advanced setting: solidUnderlines",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchgehende Unterstreichungen verwenden?\nWenn deaktiviert, werden Unterstreichungen in der Nähe von Text unterbrochen, den sie sonst schneiden würden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use solid underlines?\nWhen disabled, underlines break near text that would intersect them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar subrayados continuos?\nSi está desactivado, los subrayados se interrumpen cerca del texto que los cruzaría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser des soulignements pleins ?\nSi désactivé, les soulignements s’interrompent près du texte qu’ils croiseraient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare sottolineature continue?\nSe disattivato, le sottolineature si interrompono vicino al testo che le intersecherebbe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実線の下線を使用するか？\n無効にすると、下線と交差するテキストの近くで下線が途切れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실선 밑줄을 사용하겠습니까?\n비활성화하면 밑줄이 겹치는 텍스트 근처에서 밑줄이 끊깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar sublinhados contínuos?\nQuando desativado, os sublinhados são interrompidos perto de texto que os cruzaria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать сплошные подчёркивания?\nЕсли отключено, подчёркивания прерываются рядом с текстом, который они пересекали бы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düz alt çizgiler kullanılsın mı?\nDevre dışıyken alt çizgiler, onları kesecek metnin yakınında kesilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用实线下划线？\n如果禁用，下划线会在与它们相交的文本附近中断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用實線底線？\n停用時，底線會在與其相交的文字附近中斷。"
          }
        }
      }
    },
    "AdvancedSetting.splitPaneColor" : {
      "comment" : "Advanced setting: splitPaneColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Farbe für Trennlinien zwischen geteilten Bereichen. Leer lassen, um die Standardfarbe zu verwenden.\nDies sollte eine Farbe im HTML-Format sein, wie #aabbcc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom color for split pane dividers. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color personalizado para los divisores de paneles divididos. Déjalo vacío para usar el color predeterminado.\nDebe ser un color de estilo HTML, como #aabbcc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur personnalisée des séparateurs de volets scindés. Laissez vide pour utiliser la couleur par défaut.\nIl doit s’agir d’une couleur de style HTML, comme #aabbcc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore personalizzato per i divisori dei riquadri divisi. Lascia vuoto per usare il colore predefinito.\nDeve essere un colore in stile HTML, come #aabbcc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインの区切り線のカスタム色。デフォルトの色を使用するには空欄のままにしてください。\n#aabbccのようなHTML形式の色を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 패널 구분선의 사용자 지정 색상. 기본 색상을 사용하려면 비워 두십시오.\n#aabbcc 같은 HTML 형식의 색상이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor personalizada para os divisores de painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский цвет разделителей панелей. Оставьте пустым, чтобы использовать цвет по умолчанию.\nЦвет должен быть в HTML-формате, например #aabbcc."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölme ayırıcıları için özel renk. Varsayılan rengi kullanmak için boş bırakın.\nBu, #aabbcc gibi HTML tarzı bir renk olmalıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分屏窗格分隔线的自定义颜色。留空则使用默认颜色。\n应为HTML风格的颜色，如#aabbcc。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割窗格分隔線的自訂顏色。留空則使用預設顏色。\n應為 HTML 風格的顏色，例如 #aabbcc。"
          }
        }
      }
    },
    "AdvancedSetting.splitPaneDividerWidth" : {
      "comment" : "Advanced setting: splitPaneDividerWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Breite für Trennlinien zwischen geteilten Bereichen in Punkten (1–5). Auf 0 setzen, um die Standardbreite zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom width for split pane dividers in points (1-5). Set to 0 to use default width."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancho personalizado de los divisores de paneles divididos en puntos (1-5). Establécelo en 0 para usar el ancho predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largeur personnalisée des séparateurs de volets scindés en points (1-5). Définissez 0 pour utiliser la largeur par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larghezza personalizzata dei divisori dei riquadri divisi in punti (1-5). Imposta 0 per usare la larghezza predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインの区切り線のカスタム幅（1〜5ポイント）。デフォルトの幅を使用するには0を設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 패널 구분선의 사용자 지정 너비(포인트, 1~5). 기본 너비를 사용하려면 0으로 설정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura personalizada para os divisores de painéis em pontos (1-5). Defina como 0 para usar a largura padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательская ширина разделителей панелей в пунктах (1–5). Укажите 0, чтобы использовать ширину по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölme ayırıcıları için punto cinsinden özel genişlik (1-5). Varsayılan genişliği kullanmak için 0 yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分屏窗格分隔线的自定义宽度（单位：点，1-5）。设为0则使用默认宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割窗格分隔線的自訂寬度，以點為單位（1-5）。設為 0 則使用預設寬度。"
          }
        }
      }
    },
    "AdvancedSetting.splitPaneSourceBorderColor" : {
      "comment" : "Advanced setting: splitPaneSourceBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe des äußeren Rahmens des Quellbereichs beim Verschieben/Vertauschen eines geteilten Bereichs.\nSollte eine Farbe im Web-Format sein, #rrggbb. Sie können auch p3#rrggbb für den P3-Farbraum verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of source pane outer border when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color del borde exterior del panel de origen al mover/intercambiar un panel dividido.\nDebe ser un color de estilo web, #rrggbb. También puedes usar p3#rrggbb para el espacio de color p3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur de la bordure extérieure du volet source lors du déplacement/de l’échange d’un volet scindé.\nDoit être une couleur de style web, #rrggbb. Vous pouvez aussi utiliser p3#rrggbb pour l’espace colorimétrique P3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore del bordo esterno del riquadro di origine quando si sposta/scambia un riquadro diviso.\nDeve essere un colore in stile web, #rrggbb. Puoi usare anche p3#rrggbb per lo spazio colore p3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインを移動／入れ替えする際の移動元ペインの外側の枠線の色。\nウェブスタイルの色（#rrggbb）を指定してください。P3カラースペースにはp3#rrggbbも使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 패널을 이동/교체할 때 원본 패널의 바깥 테두리 색상.\n#rrggbb 같은 웹 형식 색상이어야 합니다. P3 색 공간에는 p3#rrggbb를 사용할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda externa do painel de origem ao mover/trocar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет внешней границы исходной панели при перемещении/обмене разделённых панелей.\nДолжен быть цветом в веб-формате, #rrggbb. Также можно использовать p3#rrggbb для цветового пространства P3."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölme taşınırken/değiştirilirken kaynak bölmenin dış kenarlık rengi.\nWeb tarzı bir renk olmalıdır, #rrggbb. P3 renk alanı için p3#rrggbb de kullanabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动/交换分屏窗格时源窗格外边界的颜色。\n应为网页风格颜色，#rrggbb。也可使用p3#rrggbb表示p3颜色空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動/交換分割窗格時，來源窗格外框的顏色。\n應為網頁風格的顏色，#rrggbb。也可以使用 p3#rrggbb 表示 P3 色彩空間。"
          }
        }
      }
    },
