    "Tip.0118.Body" : {
      "comment" : "Tip of the day body, id 0118",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil můžete nastavit jako webový prohlížeč! V „Nastavení > Profily > Obecné“ nastavte „Typ profilu“ na „Webový prohlížeč“. Přiřazení kláves, chytrý výběr i správce hesel fungují v relacích prohlížeče."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan konfigurere en profil som en webbrowser! Under “Indstillinger > Profiler > Generelt” skal du sætte “Profiltype” til “Webbrowser”. Tastetildelinger, smart markering og adgangskodeadministratoren fungerer alle i browsersessioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können ein Profil als Webbrowser konfigurieren! Stellen Sie unter „Einstellungen > Profile > Allgemein“ den „Profiltyp“ auf „Webbrowser“. Tastenkombinationen, intelligente Auswahl und der Passwort-Manager funktionieren auch in Browser-Sitzungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can configure a profile to be a web browser! In “Settings > Profiles > General”, set “Profile Type” to “Web Browser”. Key bindings, smart selection, and the password manager all work in browser sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Puedes configurar un perfil para que sea un navegador web! En “Ajustes > Perfiles > General”, establece “Tipo de perfil” en “Navegador web”. Las asignaciones de teclas, la selección inteligente y el gestor de contraseñas funcionan en las sesiones de navegador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit määrittää profiilin verkkoselaimeksi! Aseta kohdassa ”Asetukset > Profiilit > Yleiset” ”Profiilin tyyppi” arvoon ”Verkkoselain”. Näppäinmääritykset, älykäs valinta ja salasanojen hallinta toimivat kaikki selainistunnoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez configurer un profil pour qu’il soit un navigateur web ! Dans « Réglages > Profils > Général », définissez « Type de profil » sur « Navigateur web ». Les associations de touches, la sélection intelligente et le gestionnaire de mots de passe fonctionnent tous dans les sessions de navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi configurare un profilo come browser web! In “Impostazioni > Profili > Generali” imposta “Tipo di profilo” su “Browser web”. Le associazioni tasti, la selezione intelligente e il gestore password funzionano nelle sessioni del browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルをウェブブラウザとして設定できます！「設定 > プロファイル > 一般」で「プロファイルタイプ」を「ウェブブラウザ」に設定してください。キーバインド、スマート選択、パスワードマネージャーはすべてブラウザセッションでも動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일을 웹 브라우저로 설정할 수 있습니다! “설정 > 프로파일 > 일반”에서 “프로파일 유형”을 “웹 브라우저”로 설정하십시오. 키 바인딩, 스마트 선택, 암호 관리자 모두 브라우저 세션에서 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan konfigurere en profil som en nettleser! I «Innstillinger > Profiler > Generelt» setter du «Profiltype» til «Nettleser». Tastetilordninger, smart markering og passordbehandleren fungerer alle i nettleserøkter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een profiel instellen als webbrowser! Stel in ‘Instellingen > Profielen > Algemeen’ het ‘Profieltype’ in op ‘Webbrowser’. Toetstoewijzingen, slimme selectie en de wachtwoordbeheerder werken allemaal in browsersessies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz skonfigurować profil jako przeglądarkę internetową! W „Ustawienia > Profile > Ogólne” ustaw „Typ profilu” na „Przeglądarka internetowa”. Przypisania klawiszy, inteligentne zaznaczanie i menedżer haseł działają w sesjach przeglądarki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar um perfil para ser um navegador da web! Em “Settings > Profiles > General”, defina “Profile Type” como “Web Browser”. Atalhos de teclado, seleção inteligente e o cofre de senhas funcionam todos em sessões de navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить профиль так, чтобы он работал как веб-браузер! В разделе «Настройки > Профили > Общие» установите для параметра «Тип профиля» значение «Веб-браузер». Привязки клавиш, умный выбор и менеджер паролей работают и в сеансах браузера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil môžete nastaviť ako webový prehliadač! V časti „Nastavenia > Profily > Všeobecné“ nastavte „Typ profilu“ na „Webový prehliadač“. Priradenia klávesov, inteligentný výber aj správca hesiel fungujú v reláciách prehliadača."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil lahko nastavite, da je spletni brskalnik! V »Nastavitve > Profili > Splošno« nastavite »Vrsta profila« na »Spletni brskalnik«. Dodelitve tipk, pametni izbor in upravitelj gesel delujejo v sejah brskalnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan konfigurera en profil som en webbläsare! Ställ in ”Profiltyp” på ”Webbläsare” i ”Inställningar > Profiler > Allmänt”. Tangentkopplingar, smart markering och lösenordshanteraren fungerar alla i webbläsarsessioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir profili web tarayıcısı olacak şekilde yapılandırabilirsiniz! “Ayarlar > Profiller > Genel” bölümünde “Profil Türü”nü “Web Tarayıcısı” olarak ayarlayın. Tuş atamaları, akıllı seçim ve parola yöneticisi tarayıcı oturumlarında çalışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể cấu hình một hồ sơ thành trình duyệt web! Trong “Cài đặt > Hồ sơ > Chung”, đặt “Loại hồ sơ” thành “Trình duyệt web”. Gán phím, chọn thông minh và trình quản lý mật khẩu đều hoạt động trong các phiên trình duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以配置配置文件为网页浏览器！在“设置 > 配置文件 > 通用”中，将“配置文件类型”设置为“网页浏览器”。按键绑定、智能选取以及密码管理器均可在浏览器会话中正常使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以將描述檔設定為網頁瀏覽器！在「設定 > 描述檔 > 一般」中，將「描述檔類型」設為「瀏覽器」。按鍵對應、智慧型選取和密碼管理器都能在瀏覽器工作階段中使用。"
          }
        }
      }
    },
