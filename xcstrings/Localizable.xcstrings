    "WorkgroupUsage.ScriptMissing" : {
      "comment" : "AI usage toolbar item message when the bundled helper script is absent from the app bundle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocný skript pro využití AI v iTerm2 chybí. Jde o chybu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælperen til AI-forbrug mangler i iTerm2. Det er en fejl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hilfsprogramm für die KI-Nutzung fehlt in iTerm2. Das ist ein Fehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI usage helper is missing from iTerm2. This is a bug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el asistente de uso de IA en iTerm2. Esto es un error."
          }
        },
        "fi" : {
          "stringUnit" : {
