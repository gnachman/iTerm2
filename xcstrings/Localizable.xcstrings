          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 vas ne opozori več pred večvrstičnim lepljenjem, razen če ste pri ukaznem pozivu lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
