    "TmuxWorkgroup.LockWait.Title" : {
      "comment" : "Announcement shown while creating a workgroup's sessions in tmux waits for another iTerm2 attached to the same tmux session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiná aplikace iTerm2 připojená k této relaci tmux nastavuje pracovní skupinu. Tato instance čeká, až skončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden iTerm2, der er tilknyttet denne tmux-session, er ved at konfigurere en arbejdsgruppe. Denne venter på, at den bliver færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes iTerm2, das mit dieser tmux-Sitzung verbunden ist, richtet gerade eine Arbeitsgruppe ein. Dieses wartet, bis es fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another iTerm2 attached to this tmux session is setting up a workgroup. This one is waiting for it to finish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro iTerm2 conectado a esta sesión de tmux está configurando un grupo de trabajo. Este está esperando a que termine."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen tähän tmux-istuntoon liitetty iTerm2 määrittää työryhmää. Tämä odottaa sen valmistumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre iTerm2 attaché à cette session tmux configure un groupe de travail. Celui-ci attend qu’il ait terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro iTerm2 collegato a questa sessione tmux sta configurando un gruppo di lavoro. Questo è in attesa che termini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このtmuxセッションに接続している別のiTerm2がワークグループを設定しています。このiTerm2はその完了を待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 tmux 세션에 연결된 다른 iTerm2가 워크그룹을 설정하는 중입니다. 이 iTerm2는 그 작업이 끝나기를 기다리고 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen iTerm2 som er koblet til denne tmux-økten, setter opp en arbeidsgruppe. Denne venter til den er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een andere iTerm2 die aan deze tmux-sessie is gekoppeld, stelt een werkgroep in. Deze wacht tot die klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inny iTerm2 podłączony do tej sesji tmux konfiguruje grupę roboczą. Ten czeka na zakończenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro iTerm2 conectado a esta sessão do tmux está configurando um grupo de trabalho. Este está aguardando que ele termine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другой экземпляр iTerm2, подключённый к этой сессии tmux, настраивает рабочую группу. Этот экземпляр ждёт завершения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iná aplikácia iTerm2 pripojená k tejto relácii tmux nastavuje pracovnú skupinu. Táto čaká, kým skončí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drug iTerm2, priklopljen na to sejo tmux, nastavlja delovno skupino. Ta počaka, da konča."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan iTerm2 som är ansluten till den här tmux-sessionen ställer in en arbetsgrupp. Den här väntar tills den är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tmux oturumuna bağlı başka bir iTerm2 bir çalışma grubunu kuruyor. Bu iTerm2, işlemin bitmesini bekliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một iTerm2 khác đang gắn vào phiên tmux này đang thiết lập một nhóm làm việc. iTerm2 này đang chờ nó hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接到此 tmux 会话的另一个 iTerm2 正在设置工作组。此 iTerm2 正在等待其完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附加到此 tmux 工作階段的另一個 iTerm2 正在設定工作群組。此 iTerm2 正在等待它完成。"
          }
        }
      }
    },
    "TmuxWorkgroupAttacher.ChooseBody" : {
      "comment" : "Asks which local workgroup to use for a workgroup found in a tmux session; %@ is the tmux session's name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace tmux „%@“ obsahuje pracovní skupinu, které odpovídá více z vašich pracovních skupin. Kterou má použít?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-sessionen “%@” har en arbejdsgruppe, som flere af dine arbejdsgrupper passer til. Hvilken skal den bruge?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die tmux-Sitzung „%@“ hat eine Arbeitsgruppe, auf die mehr als eine Ihrer Arbeitsgruppen passt. Welche soll verwendet werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "tmux session “%@” has a workgroup that more than one of your workgroups match. Which one should it use?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de tmux “%@” tiene un grupo de trabajo que coincide con más de uno de tus grupos de trabajo. ¿Cuál debería usar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-istunnossa ”%@” on työryhmä, joka vastaa useampaa työryhmääsi. Mitä niistä pitäisi käyttää?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session tmux « %@ » contient un groupe de travail qui correspond à plusieurs de vos groupes de travail. Lequel faut-il utiliser ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione tmux “%@” ha un gruppo di lavoro che corrisponde a più di uno dei tuoi gruppi di lavoro. Quale vuoi usare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxセッション「%@」には、あなたのワークグループのうち複数に一致するワークグループがあります。どれを使用しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 세션 “%@”에 사용자의 워크그룹 중 둘 이상과 일치하는 워크그룹이 있습니다. 어느 워크그룹을 사용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-økten «%@» har en arbeidsgruppe som passer med mer enn én av arbeidsgruppene dine. Hvilken skal brukes?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tmux-sessie ‘%@’ heeft een werkgroep die overeenkomt met meer dan één van je werkgroepen. Welke moet worden gebruikt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja tmux „%@” ma grupę roboczą pasującą do więcej niż jednej z twoich grup roboczych. Której należy użyć?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do tmux “%@” tem um grupo de trabalho que corresponde a mais de um dos seus grupos de trabalho. Qual deles deve ser usado?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В сессии tmux «%@» есть рабочая группа, которой соответствуют несколько ваших рабочих групп. Какую из них использовать?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácia tmux „%@“ obsahuje pracovnú skupinu, ktorej zodpovedá viac vašich pracovných skupín. Ktorú má použiť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja tmux »%@« vsebuje delovno skupino, ki ustreza več vašim delovnim skupinam. Katero naj uporabi?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-sessionen ”%@” har en arbetsgrupp som matchar fler än en av dina arbetsgrupper. Vilken ska användas?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tmux oturumunda, birden fazla çalışma grubunuzla eşleşen bir çalışma grubu var. Hangisi kullanılsın?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên tmux “%@” có một nhóm làm việc khớp với nhiều hơn một nhóm làm việc của bạn. Nên dùng nhóm nào?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 会话“%@”中有一个工作组与你的多个工作组匹配。它应该使用哪一个？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 工作階段「%@」中有一個工作群組，符合你的多個工作群組。應使用哪一個？"
          }
        }
      }
    },
