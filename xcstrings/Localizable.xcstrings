    "AdvancedSetting.fastTrackpad" : {
      "comment" : "Advanced setting: fastTrackpad",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
