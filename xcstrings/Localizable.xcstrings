    "HotKeyMigration.MigrateTitle" : {
      "comment" : "Message explaining that a hotkey window's dynamic profile must be migrated; %@ is the profile name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil vašeho okna horké klávesy je dynamický profil s názvem „%@.“ Je nutné jej pro tuto verzi iTerm2 aktualizovat, protože nastavení horké klávesy se nyní ukládají v profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen for dit genvejstastvindue er en dynamisk profil med navnet “%@”. Den skal opdateres til denne version af iTerm2, fordi indstillinger for genvejstaster nu gemmes i profilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil Ihres Hotkey-Fensters ist ein dynamisches Profil namens „%@“. Es muss für diese Version von iTerm2 aktualisiert werden, da Hotkey-Einstellungen jetzt im Profil gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your hotkey window‘s profile is a dynamic profile named “%@.” It needs to be updated for this version of iTerm2 because hotkey settings are now stored in the profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil de tu ventana de tecla rápida es un perfil dinámico llamado “%@.” Hay que actualizarlo para esta versión de iTerm2 porque los ajustes de la tecla rápida ahora se guardan en el perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikanäppäinikkunasi profiili on dynaaminen profiili nimeltä ”%@”. Se on päivitettävä tätä iTerm2-versiota varten, koska pikanäppäinasetukset tallennetaan nyt profiiliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil de votre fenêtre à raccourci global est un profil dynamique nommé « %@ ». Il doit être mis à jour pour cette version d’iTerm2, car les réglages de raccourci global sont désormais stockés dans le profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo della tua finestra ad abbreviazione globale è un profilo dinamico chiamato “%@.” Deve essere aggiornato per questa versione di iTerm2 perché le impostazioni dell’abbreviazione globale ora sono salvate nel profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキーウインドウのプロファイルはダイナミックプロファイル「%@」です。ホットキー設定がプロファイルに保存されるようになったため、このバージョンの iTerm2 用に更新する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 윈도우의 프로파일은 “%@”(이)라는 동적 프로파일입니다. 이제 단축키 설정이 프로파일에 저장되므로 이 버전의 iTerm2에 맞게 업데이트해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen for hurtigtastvinduet ditt er en dynamisk profil som heter «%@». Den må oppdateres for denne versjonen av iTerm2 fordi hurtigtastinnstillinger nå lagres i profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het profiel van je sneltoetsvenster is een dynamisch profiel met de naam ‘%@’. Het moet worden bijgewerkt voor deze versie van iTerm2 omdat sneltoetsinstellingen nu in het profiel worden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil twojego okna klawisza skrótu to profil dynamiczny o nazwie „%@”. Trzeba go zaktualizować dla tej wersji iTerm2, ponieważ ustawienia klawisza skrótu są teraz przechowywane w profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil da sua janela de hotkey é um perfil dinâmico chamado “%@.” Ele precisa ser atualizado para esta versão do iTerm2 porque os ajustes de hotkey agora são armazenados no perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилем вашего окна по горячей клавише является динамический профиль с именем «%@». Его необходимо обновить для этой версии iTerm2, так как настройки горячих клавиш теперь хранятся в профиле."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil vášho okna aktivačnej skratky je dynamický profil s názvom „%@.“ Pre túto verziu iTerm2 je potrebné ho aktualizovať, pretože nastavenia aktivačnej skratky sa teraz ukladajú v profile."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil vašega okna hitre tipke je dinamični profil z imenom »%@«. Treba ga je posodobiti za to različico aplikacije iTerm2, ker so nastavitve hitre tipke zdaj shranjene v profilu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen för ditt snabbtangentsfönster är en dynamisk profil med namnet ”%@.” Den måste uppdateras för den här versionen av iTerm2 eftersom snabbtangentsinställningar nu lagras i profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşu penceresi profiliniz “%@” adlı bir dinamik profil. Kısayol tuşu ayarları artık profilde saklandığından, iTerm2’nin bu sürümü için güncellenmesi gerekiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ của cửa sổ phím nóng của bạn là một hồ sơ động có tên “%@.” Cần cập nhật hồ sơ này cho phiên bản iTerm2 này vì các cài đặt phím nóng hiện được lưu trong hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的热键窗口的配置文件是一个名为“%@.”的动态配置文件。由于热键设置现在存储在该配置文件中，因此需要针对此版本的iTerm2进行更新。"
