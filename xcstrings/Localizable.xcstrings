    "StatusBarGit.DebugInfoFormat" : {
      "comment" : "Body of the git status bar debug info alert; placeholders are directory, cadence, enabled flag, seconds since last poll, repo state, and extra debug info",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresář: %1$@\nInterval dotazování: %2$@ s\nDotazování zapnuto: %3$@\nPoslední dotaz před %4$@ s\nStav repozitáře: %5$@\n%6$@"
