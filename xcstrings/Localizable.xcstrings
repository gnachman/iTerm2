        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliação rápida de expressões regulares para gatilhos.\nIsto é experimental porque poderia potencialmente alterar como as expressões regulares são interpretadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрое вычисление регулярных выражений для триггеров.\nЭто экспериментальная функция, поскольку она потенциально может изменить интерпретацию регулярных выражений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyiciler için hızlı düzenli ifade değerlendirmesi.\nDüzenli ifadelerin yorumlanma biçimini değiştirebileceğinden bu deneyseldir."
          }
