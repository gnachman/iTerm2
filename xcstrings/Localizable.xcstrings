    },
    "AdvancedSetting.fastTriggerRegexes" : {
      "comment" : "Advanced setting: fastTriggerRegexes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlé vyhodnocování regulárních výrazů pro spouštěče.\nJe to experimentální, protože by mohlo změnit způsob výkladu regulárních výrazů."
