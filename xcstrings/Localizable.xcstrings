    "BrowserPasswordWriter.NotPasswordFieldPrompt" : {
      "comment" : "Confirmation shown when filling a non-password field",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaměřené pole není pole pro heslo. Vyplnit ho přesto?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fokuserede felt er ikke et adgangskodefelt. Vil du udfylde det alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das fokussierte Feld ist kein Passwortfeld. Trotzdem ausfüllen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The focused field is not a password field. Fill it anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El campo con foco no es un campo de contraseña. ¿Rellenarlo de todos modos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdistettu kenttä ei ole salasanakenttä. Täytetäänkö se silti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le champ actif n’est pas un champ de mot de passe. Le remplir quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il campo con focus non è un campo password. Compilarlo comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスされているフィールドはパスワードフィールドではありません。それでも入力しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포커스된 필드가 암호 필드가 아닙니다. 그래도 채우겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fokuserte feltet er ikke et passordfelt. Vil du fylle det ut likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het veld met focus is geen wachtwoordveld. Toch invullen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole z fokusem nie jest polem hasła. Wypełnić je mimo to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O campo em foco não é um campo de senha. Preencher mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранное поле не является полем пароля. Всё равно заполнить его?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybrané pole nie je pole hesla. Napriek tomu ho vyplniť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrano polje ni polje za geslo. Ga vseeno izpolnim?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fokuserade fältet är inte ett lösenordsfält. Vill du fylla i det ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaktaki alan bir parola alanı değil. Yine de doldurulsun mu?"
          }
        },
