    "GeneralPrefs.LegacyHeadersText" : {
      "comment" : "Body of alert explaining custom headers moved to per-model settings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní hlavičky HTTP pro AI dříve tvořily jedno globální nastavení. Váš aktuální model je zachovává, ale modely, které zde přidáte, začínají bez nich. Potřebné hlavičky přidejte v sekci „Vlastní hlavičky“ každého nového modelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine brugerdefinerede HTTP-headere til AI var tidligere en enkelt global indstilling. Din nuværende model beholder dem, men modeller, du tilføjer her, starter uden dem. Tilføj de headere, du har brug for, i afsnittet “Brugerdefinerede headere” for hver ny model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre benutzerdefinierten HTTP-Header für KI waren früher eine einzige globale Einstellung. Ihr aktuelles Modell behält sie, aber Modelle, die Sie hier hinzufügen, haben sie zunächst nicht. Fügen Sie die benötigten Header im Abschnitt „Benutzerdefinierte Header“ jedes neuen Modells hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your AI custom HTTP headers used to be a single global setting. Your current model keeps them, but models you add here start without them. Add the headers you need in each new model’s “Custom headers” section."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus encabezados HTTP personalizados de IA eran antes un único ajuste global. Tu modelo actual los conserva, pero los modelos que añadas aquí empiezan sin ellos. Añade los encabezados que necesites en la sección “Encabezados personalizados” de cada modelo nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI:n mukautetut HTTP-otsakkeet olivat aiemmin yksi yleinen asetus. Nykyinen mallisi säilyttää ne, mutta tänne lisäämäsi mallit alkavat ilman niitä. Lisää tarvitsemasi otsakkeet kunkin uuden mallin ”Mukautetut otsakkeet” -osioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos en-têtes HTTP personnalisés pour l’IA formaient auparavant un réglage global unique. Votre modèle actuel les conserve, mais les modèles que vous ajoutez ici démarrent sans eux. Ajoutez les en-têtes nécessaires dans la section « Custom headers » de chaque nouveau modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le intestazioni HTTP personalizzate dell’IA erano un’unica impostazione globale. Il modello attuale li conserva, ma i modelli che aggiungi qui iniziano senza. Aggiungi le intestazioni necessarie nella sezione “Intestazioni personalizzate” di ogni nuovo modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前は、AI 用のカスタム HTTP ヘッダーは1つのグローバル設定でした。現在のモデルでは引き続き保持されますが、ここで追加したモデルにはヘッダーが設定されていません。必要なヘッダーは、新しい各モデルの「カスタムヘッダー」セクションで追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에는 AI 사용자 지정 HTTP 헤더가 하나의 전역 설정이었습니다. 현재 모델은 이 헤더를 그대로 유지하지만, 여기에서 추가하는 모델에는 헤더가 없습니다. 새 모델마다 “사용자 지정 헤더” 섹션에서 필요한 헤더를 추가하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De egendefinerte HTTP-hodene for KI var tidligere én global innstilling. Den gjeldende modellen beholder dem, men modeller du legger til her, starter uten dem. Legg til hodene du trenger i delen «Egendefinerte hoder» for hver nye modell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je aangepaste HTTP-headers voor AI waren vroeger één globale instelling. Je huidige model behoudt ze, maar modellen die je hier toevoegt beginnen zonder. Voeg de headers die je nodig hebt toe in het gedeelte ‘Aangepaste headers’ van elk nieuw model."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niestandardowe nagłówki HTTP dla AI były wcześniej jednym ustawieniem globalnym. Twój bieżący model je zachowuje, ale modele dodawane tutaj zaczynają bez nich. Dodaj potrzebne nagłówki w sekcji „Nagłówki niestandardowe” każdego nowego modelu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus cabeçalhos HTTP personalizados de IA costumavam ser um único ajuste global. Seu modelo atual os mantém, mas os modelos que você adicionar aqui começam sem eles. Adicione os cabeçalhos de que precisa na seção “Custom headers” de cada novo modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши пользовательские HTTP-заголовки ИИ раньше были единой глобальной настройкой. Текущая модель сохраняет их, но модели, добавленные здесь, создаются без них. Добавьте нужные заголовки в разделе «Пользовательские заголовки» каждой новой модели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastné hlavičky HTTP pre AI boli kedysi jedným globálnym nastavením. Váš aktuálny model si ich ponecháva, ale modely, ktoré tu pridáte, začínajú bez nich. Potrebné hlavičky pridajte v sekcii „Vlastné hlavičky“ každého nového modelu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši HTTP-glavi AI po meri so bili včasih ena sama globalna nastavitev. Vaš trenutni model jih ohrani, modeli, ki jih dodate tukaj, pa se začnejo brez njih. Potrebne glave dodajte v razdelku »Glave po meri« pri vsakem novem modelu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina anpassade HTTP-rubriker för AI var tidigare en enda global inställning. Din nuvarande modell behåller dem, men modeller du lägger till här startar utan dem. Lägg till de rubriker du behöver i avsnittet ”Anpassade rubriker” för varje ny modell."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ özel HTTP üst bilgileri eskiden tek bir genel ayardı. Geçerli modeliniz bunları korur, ancak buraya eklediğiniz modeller bunlarsız başlar. Gereken üst bilgileri her yeni modelin “Özel üst bilgiler” bölümüne ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tiêu đề HTTP tùy chỉnh cho AI của bạn trước đây là một cài đặt chung duy nhất. Mô hình hiện tại của bạn vẫn giữ chúng, nhưng các mô hình bạn thêm ở đây sẽ bắt đầu mà không có chúng. Hãy thêm các tiêu đề bạn cần trong phần “Tiêu đề tùy chỉnh” của từng mô hình mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您使用的 AI 自定义 HTTP 头曾是单一的全局设置。当前模型会保留它们，但在此处添加的模型不会包含这些头。请在每个新模型的“自定义头”部分添加所需的头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 AI 自訂 HTTP 標頭過去是單一的全域設定。目前的模型會保留這些標頭，但在此處新增的模型一開始不會包含。請在每個新模型的「自訂標頭」區段中加入所需的標頭。"
          }
        }
      }
    },
