    "Companion.ShowCode.Body" : {
      "comment" : "Explanatory paragraph on the show-pairing-code screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie auf Ihrem iPhone iTerm2 Buddy und tippen Sie auf Scannen. Zeigen Sie dann den Kopplungscode unten an und richten Sie die Kamera darauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On your iPhone, open iTerm2 Buddy and tap Scan. Then reveal the pairing code below and point the camera at it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu iPhone, abre iTerm2 Buddy y toca Escanear. Luego muestra el código de emparejamiento de abajo y apunta la cámara hacia él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre iPhone, ouvrez iTerm2 Buddy et touchez Scanner. Puis affichez le code d’association ci-dessous et pointez l’appareil photo vers lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul tuo iPhone, apri iTerm2 Buddy e tocca Scansiona. Poi mostra qui sotto il codice di associazione e inquadralo con la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでiTerm2 Buddyを開き、「スキャン」をタップしてください。次に、下のペアリングコードを表示してカメラを向けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 iTerm2 Buddy를 열고 Scan을 탭하십시오. 그런 다음 아래의 페어링 코드를 표시하고 카메라를 코드에 맞추십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu iPhone, abra o iTerm2 Buddy e toque em Escanear. Depois revele o código de pareamento abaixo e aponte a câmera para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем iPhone откройте iTerm2 Buddy и нажмите «Сканировать». Затем откройте код сопряжения ниже и наведите на него камеру."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzda iTerm2 Buddy’yi açıp Tara’ya dokunun. Ardından aşağıdaki eşleştirme kodunu gösterip kamerayı ona doğrultun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
