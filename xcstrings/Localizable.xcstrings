    "AdvancedSetting.naturalScrollingAffectsHorizontalMouseReporting" : {
      "comment" : "Advanced setting: naturalScrollingAffectsHorizontalMouseReporting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
