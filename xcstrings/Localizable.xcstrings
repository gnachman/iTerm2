    "Tip.0034.Body" : {
      "comment" : "Tip of the day body, id 0034",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihren Profilen Tags zuweisen. Überall dort, wo eine Liste von Profilen angezeigt wird, können Sie durch Klicken auf „Tags>“ diese Tags durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can assign tags to your profiles, and by clicking “Tags>” anywhere you see a list of profiles you can browse those tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes asignar etiquetas a tus perfiles y, al hacer clic en “Tags>” en cualquier lugar donde veas una lista de perfiles, puedes explorar esas etiquetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez attribuer des tags à vos profils et, en cliquant sur « Tags> » partout où une liste de profils apparaît, parcourir ces tags."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi assegnare dei tag ai tuoi profili e, facendo clic su “Tag>” ovunque compaia un elenco di profili, puoi esplorare quei tag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルにタグを割り当てることができ、プロファイルの一覧が表示されている場所ならどこでも「タグ>」をクリックしてそれらのタグを閲覧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일에 태그를 지정할 수 있으며, 프로파일 목록이 보이는 곳 어디에서나 “태그>”를 클릭하여 태그를 탐색할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode atribuir tags aos seus perfis e, ao clicar em “Tags>” em qualquer lugar onde veja uma lista de perfis, pode navegar por essas tags."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете назначать теги своим профилям, а щёлкнув «Теги>» в любом списке профилей, сможете просматривать эти теги."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profillerinize etiket atayabilir ve bir profil listesi gördüğünüz her yerde “Etiketler>”e tıklayarak bu etiketlere göz atabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以为配置文件添加标签，点击“Tags>”后，会显示所有配置文件的列表，即可浏览这些标签。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以為描述檔指定標籤，並在任何顯示描述檔列表的地方按一下「標籤 >」來瀏覽這些標籤。"
          }
        }
      }
    },
