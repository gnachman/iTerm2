    "ArrangementTrustGate.TrustAdvice" : {
      "comment" : "Advice line at the end of the untrusted-arrangement warning",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie sie nur, wenn Sie der Quelle vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open it only if you trust where it came from."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrela solo si confías en su origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne l’ouvrez que si vous faites confiance à sa provenance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprila solo se ti fidi della sua provenienza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入手元を信頼できる場合にのみ開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출처를 신뢰하는 경우에만 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
