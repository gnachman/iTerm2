          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder plików konfiguracji. W ścieżce nie może być spacji.\nJeśli puste, domyślną lokalizacją będzie ~/.config/iterm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
