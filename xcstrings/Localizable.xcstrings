    "ScriptLauncher.UpgradeRuntimeMessage" : {
      "comment" : "Prompt to upgrade a script's runtime; %@ is the script name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript pro Python API „%@“ vyžaduje z bezpečnostních důvodů novější verzi běhového prostředí. Než bude moci tato verze iTerm2 skript spustit, musíte je aktualizovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-API-instruksen “%@” kræver en nyere version af kørselsmiljøet af sikkerhedshensyn. Du skal opgradere det, før denne version af iTerm2 kan starte instruksen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Python-API-Skript „%@“ benötigt aus Sicherheitsgründen eine neuere Version der Laufzeitumgebung. Sie müssen es aktualisieren, bevor diese Version von iTerm2 das Skript starten kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python API script “%@” needs a newer version of the runtime environment for security reasons. You must upgrade it before this version of iTerm2 can launch the script."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El script de la API de Python “%@” necesita una versión más reciente del entorno de ejecución por motivos de seguridad. Debes actualizarlo antes de que esta versión de iTerm2 pueda iniciar el script."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API -skripti ”%@” tarvitsee suoritusympäristön uudemman version tietoturvasyistä. Se on päivitettävä, ennen kuin tämä iTerm2:n versio voi käynnistää skriptin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le script d’API Python « %@ » nécessite une version plus récente de l’environnement d’exécution pour des raisons de sécurité. Vous devez le mettre à jour avant que cette version d’iTerm2 puisse lancer le script."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo script API Python “%@” richiede una versione più recente dell’ambiente di esecuzione per motivi di sicurezza. Devi aggiornarlo prima che questa versione di iTerm2 possa avviare lo script."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python APIスクリプト「%@」は、セキュリティ上の理由からランタイム環境の新しいバージョンを必要としています。このバージョンのiTerm2でスクリプトを起動する前に、アップグレードする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API 스크립트 “%@”은(는) 보안상의 이유로 더 새로운 버전의 런타임 환경이 필요합니다. 이 버전의 iTerm2에서 스크립트를 실행하려면 먼저 업그레이드해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-API-skriptet «%@» trenger en nyere versjon av kjøremiljøet av sikkerhetsgrunner. Du må oppgradere det før denne versjonen av iTerm2 kan starte skriptet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Python-API-script ‘%@’ heeft om veiligheidsredenen een nieuwere versie van de runtime-omgeving nodig. Je moet deze bijwerken voordat deze versie van iTerm2 het script kan starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrypt API Pythona „%@” wymaga nowszej wersji środowiska uruchomieniowego ze względów bezpieczeństwa. Musisz je uaktualnić, zanim ta wersja iTerm2 będzie mogła uruchomić skrypt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O script da API do Python “%@” precisa de uma versão mais recente do ambiente de runtime por motivos de segurança. Você precisa atualizá-lo antes que esta versão do iTerm2 possa iniciar o script."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрипту Python API «%@» по соображениям безопасности требуется более новая версия среды выполнения. Его необходимо обновить, прежде чем эта версия iTerm2 сможет запустить скрипт."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript Python API „%@“ z bezpečnostných dôvodov vyžaduje novšiu verziu behového prostredia. Musíte ho aktualizovať, aby ho táto verzia iTerm2 mohla spustiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript API Python »%@« iz varnostnih razlogov potrebuje novejšo različico izvajalnega okolja. Nadgraditi ga morate, preden lahko ta različica aplikacije iTerm2 zažene skript."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-API-skriptet ”%@” behöver en nyare version av körmiljön av säkerhetsskäl. Du måste uppgradera den innan den här versionen av iTerm2 kan starta skriptet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” Python API betiği, güvenlik nedenleriyle çalışma zamanı ortamının daha yeni bir sürümüne ihtiyaç duyuyor. iTerm2’nin bu sürümü betiği başlatmadan önce yükseltmeniz gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập lệnh API Python “%@” cần phiên bản môi trường chạy mới hơn vì lý do bảo mật. Bạn phải nâng cấp trước khi phiên bản iTerm2 này có thể khởi chạy tập lệnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于安全原因，Python API 脚本“%@”需要更新版本的运行时环境。必须先升级它，此版本的 iTerm2 才能启动该脚本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基於安全性考量，Python API 腳本「%@」需要較新版本的執行環境。必須先升級，此版本的 iTerm2 才能啟動該腳本。"
          }
        }
      }
    },
