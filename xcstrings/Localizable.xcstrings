    "PasteboardReporter.RemoveAuthFileErrorBody" : {
      "comment" : "Error body shown when the clipboard-reporting authorization file cannot be removed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen der Datei, die die Zwischenablage-Meldung autorisiert, ist ein Fehler aufgetreten: %@.\nSolange diese Datei existiert, kann die Zwischenablage-Meldung von Programmen auf diesem Computer aktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An error occurred while removing the file that authorizes clipboard reporting: %@.\nAs long as this file exists, clipboard reporting could be enabled by programs running on this computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se produjo un error al eliminar el archivo que autoriza el informe del portapapeles: %@.\nMientras este archivo exista, los programas que se ejecutan en este Mac podrían activar el informe del portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite lors de la suppression du fichier qui autorise le signalement du presse-papiers : %@.\nTant que ce fichier existe, le signalement du presse-papiers peut être activé par des programmes exécutés sur cet ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore durante la rimozione del file che autorizza la segnalazione degli Appunti: %@.\nFinché questo file esiste, la segnalazione degli Appunti potrebbe essere abilitata dai programmi in esecuzione su questo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの報告を許可するファイルを削除中にエラーが発生しました: %@。\nこのファイルが存在する限り、このコンピューター上で実行されるプログラムがクリップボードの報告を有効にする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드 리포팅을 허가하는 파일을 제거하는 중 오류가 발생했습니다: %@.\n이 파일이 존재하는 한 이 컴퓨터에서 실행되는 프로그램이 클립보드 리포팅을 켤 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro ao remover o arquivo que autoriza o relatório da área de transferência: %@.\nEnquanto este arquivo existir, o relatório da área de transferência poderá ser ativado por programas em execução neste computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произошла ошибка при удалении файла, разрешающего передачу содержимого буфера обмена: %@.\nПока этот файл существует, программы, запущенные на этом компьютере, могут включить передачу содержимого буфера обмена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pano raporlamayı yetkilendiren dosya kaldırılırken bir hata oluştu: %@.\nBu dosya var olduğu sürece, bu bilgisayarda çalışan programlar pano raporlamayı etkinleştirebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除授权剪贴板报告的文件时出错：%@。\n只要此文件存在，此计算机上运行的程序就可能启用剪贴板报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除授權剪貼簿回報的檔案時發生錯誤：%@。\n只要此檔案存在，這台電腦上執行的程式就可能啟用剪貼簿回報。"
          }
        }
      }
    },
