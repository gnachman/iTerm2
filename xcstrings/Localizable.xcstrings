    "TransferrableFile.FileExistsPrompt" : {
      "comment" : "Prompt shown when a downloaded file name already exists; %@ is the file name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei namens %@ existiert bereits. Beide Dateien behalten oder die vorhandene Datei ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A file named %@ already exists. Keep both files or replace the existing file?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo llamado %@. ¿Quieres conservar ambos archivos o reemplazar el existente?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier nommé %@ existe déjà. Conserver les deux fichiers ou remplacer le fichier existant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file chiamato %@. Vuoi mantenere entrambi i file o sostituire quello esistente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@という名前のファイルはすでに存在します。両方のファイルを残しますか、それとも既存のファイルを置き換えますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)라는 파일이 이미 있습니다. 두 파일을 모두 유지하겠습니까, 아니면 기존 파일을 대치하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um arquivo chamado %@. Manter ambos os arquivos ou substituir o arquivo existente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл с именем %@ уже существует. Оставить оба файла или заменить существующий?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adlı bir dosya zaten var. Her iki dosya da korunsun mu, yoksa mevcut dosya değiştirilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存在名为 %@ 的文件。保留两个文件，还是替换现有文件？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有名為 %@ 的檔案。要保留兩個檔案，還是取代現有的檔案？"
          }
        }
      }
    },
