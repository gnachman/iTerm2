          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué tan destacado debe ser el texto de una pestaña no seleccionada cuando hay pestañas de color en una ventana?\nAdmite un valor de 0 a 1, el valor alfa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle doit être la visibilité du texte d’un onglet non sélectionné quand une fenêtre contient des onglets colorés ?\nPrend une valeur de 0 à 1, la valeur alpha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto deve essere evidente il testo di un pannello non selezionato quando in una finestra ci sono pannelli colorati?\nAccetta un valore da 0 a 1, il valore alfa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウ内に色付きタブがある場合、選択されていないタブのテキストをどの程度目立たせるか。\n0 から 1 の値 (アルファ値) を取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우에 색상이 지정된 탭이 있을 때 선택되지 않은 탭의 텍스트를 얼마나 두드러지게 표시하겠습니까?\n0에서 1 사이의 알파 값을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quão proeminente deve ser o texto em uma aba não selecionada quando há abas coloridas em uma janela?\nRecebe um valor de 0 a 1, o valor alfa."
          }
        },
        "ru" : {
          "stringUnit" : {
