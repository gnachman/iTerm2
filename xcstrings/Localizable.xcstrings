    "AppSignature.CorruptUnverified" : {
      "comment" : "Shown when the app's code signature could not be verified",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, und die Code-Signatur von iTerm2 konnte nicht überprüft werden.\n\nSie sollten eine neue Kopie der App herunterladen und sie neu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted and iTerm2’s code signature could not be verified.\n\nYou should download a fresh copy of the app and reinstall it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o está dañado, y no se pudo verificar la firma de código de iTerm2.\n\nDebes descargar una copia nueva de la app y reinstalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu et la signature de code d’iTerm2 n’a pas pu être vérifiée.\n\nVous devriez télécharger une nouvelle copie de l’app et la réinstaller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato e non è stato possibile verificare la firma del codice di iTerm2.\n\nDovresti scaricare una nuova copia dell’app e reinstallarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しており、iTerm2のコード署名を検証できませんでした。\n\nアプリの新しいコピーをダウンロードして再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이며 iTerm2의 코드 서명을 확인할 수 없습니다.\n\n앱을 새로 다운로드하여 다시 설치하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido e a assinatura de código do iTerm2 não pôde ser verificada.\n\nVocê deve baixar uma cópia nova do app e reinstalá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, отсутствует или повреждён необходимый файл, и подпись кода iTerm2 не удалось проверить.\n\nЗагрузите новую копию приложения и переустановите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor ve iTerm2’nin kod imzası doğrulanamadı.\n\nUygulamanın yeni bir kopyasını indirip yeniden yüklemelisiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，无法验证 iTerm2 的代码签名。\n\n您应该下载应用的新版本并重新安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有必要的檔案似乎遺失或已損毀，且無法驗證 iTerm2 的程式碼簽章。\n\n你應該下載 App 的新副本並重新安裝。"
          }
        }
      }
    },
    "AppSignature.CorruptWrongTeam" : {
      "comment" : "Shown when the app's code signature does not match the official distribution",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, und die Code-Signatur von iTerm2 stimmte nicht mit der der offiziellen Distribution überein.\n\nSie sollten eine neue Kopie der App herunterladen und sie neu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted and iTerm2’s code signature did not match that of the official distribution.\n\nYou should download a fresh copy of the app and reinstall it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o está dañado, y la firma de código de iTerm2 no coincide con la de la distribución oficial.\n\nDebes descargar una copia nueva de la app y reinstalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu et la signature de code d’iTerm2 ne correspond pas à celle de la distribution officielle.\n\nVous devriez télécharger une nouvelle copie de l’app et la réinstaller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato e la firma del codice di iTerm2 non corrisponde a quella della distribuzione ufficiale.\n\nDovresti scaricare una nuova copia dell’app e reinstallarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しており、iTerm2のコード署名が公式配布版のものと一致しませんでした。\n\nアプリの新しいコピーをダウンロードして再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이며, iTerm2의 코드 서명이 공식 배포판의 코드 서명과 일치하지 않습니다.\n\n앱을 새로 다운로드하여 다시 설치하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido e a assinatura de código do iTerm2 não correspondeu à da distribuição oficial.\n\nVocê deve baixar uma cópia nova do app e reinstalá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, отсутствует или повреждён необходимый файл, и подпись кода iTerm2 не совпадает с подписью официального дистрибутива.\n\nЗагрузите новую копию приложения и переустановите его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor ve iTerm2’nin kod imzası resmî dağıtımınkiyle eşleşmedi.\n\nUygulamanın yeni bir kopyasını indirip yeniden yüklemelisiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，iTerm2 的代码签名与官方版本不符。\n\n您应该下载应用的新版本并重新安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有必要的檔案似乎遺失或已損毀，且 iTerm2 的程式碼簽章與官方發行版本不符。\n\n你應該下載 App 的新副本並重新安裝。"
          }
        }
      }
    },
