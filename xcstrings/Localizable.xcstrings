    "Tip.0006.Body" : {
      "comment" : "Tip of the day body, id 0006",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie eine Auswahl mit ⌥⌘C, um Stile wie Farben und Schriftarten einzuschließen. Sie können dies unter „Einstellungen > Erweitert“ zur Standardaktion für „Kopieren“ machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy a selection with ⌥⌘C to include styles such as colors and fonts. You can make this the default action for Copy in “Settings > Advanced.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia una selección con ⌥⌘C para incluir estilos como colores y tipos de letra. Puedes hacer que esta sea la acción predeterminada de Copiar en “Ajustes > Avanzado”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez une sélection avec ⌥⌘C pour inclure les styles, comme les couleurs et les polices. Vous pouvez en faire l’action par défaut de Copier dans « Réglages > Avancé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia una selezione con ⌥⌘C per includere stili come colori e font. Puoi rendere questa l’azione predefinita di Copia in “Impostazioni > Avanzate”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘C で選択範囲をコピーすると、色やフォントなどのスタイルも含められます。「設定 > 詳細」でこれをコピーのデフォルト動作にすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘C로 선택 영역을 복사하면 색상 및 서체와 같은 스타일이 포함됩니다. “설정 > 고급”에서 이 동작을 복사의 기본 동작으로 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie uma seleção com ⌥⌘C para incluir estilos como cores e fontes. Você pode tornar esta a ação padrão para Copiar em “Ajustes > Avançado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте выделение с помощью ⌥⌘C, чтобы сохранить стили, такие как цвета и шрифты. Вы можете сделать это действием по умолчанию для команды «Копировать» в «Настройки > Дополнительно»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renkler ve fontlar gibi stilleri dahil etmek için bir seçimi ⌥⌘C ile kopyalayın. Bunu “Ayarlar > Gelişmiş” bölümünde Kopyala için varsayılan eylem yapabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘C 复制选中的内容，可包含颜色、字体等样式。你可以在“设置 > 高级”中将此设为复制的默认操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘C 拷貝選取範圍，可以包含顏色和字體等樣式。你可以在「設定 > 進階」中將此設為「拷貝」的預設動作。"
          }
        }
      }
    },
