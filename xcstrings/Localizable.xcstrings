          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zaktualizuj prompt” zastępuje go bieżącym domyślnym, który następnie pozostaje aktualny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
