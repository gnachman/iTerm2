    },
    "AdvancedSetting.allowSendingFunctionKeysToCocoa" : {
      "comment" : "Advanced setting: allowSendingFunctionKeysToCocoa",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit zpracování funkčních kláves systémem pro zadávání textu v macOS.\nTo umožňuje používat funkční klávesy s modifikačními klávesami jako skládací/mrtvé klávesy ve vlastních rozloženích klávesnice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad tekstinputsystemet i macOS håndtere funktionstaster.\nDette understøtter brug af funktionstaster med kombitaster som sammensætnings- eller døde taster i brugerdefinerede tastaturlayouts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass Funktionstasten vom macOS-Texteingabesystem verarbeitet werden.\nDies unterstützt die Verwendung von Funktionstasten mit Modifikatoren als Compose-/Tottasten in benutzerdefinierten Tastaturbelegungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow function keys to be handled by macOS text input system.\nThis supports using function keys with modifiers as compose/dead keys in custom keyboard layouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que el sistema de entrada de texto de macOS gestione las teclas de función.\nEsto permite usar teclas de función con modificadores como teclas de composición o muertas en distribuciones de teclado personalizadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli macOS:n tekstinsyöttöjärjestelmän käsitellä funktionäppäimet.\nTämä mahdollistaa funktionäppäinten ja muuntonäppäinten käytön yhdistelmä- tai kuolleina näppäiminä mukautetuissa näppäimistöasetteluissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser le traitement des touches de fonction par le système de saisie de texte de macOS.\nCela permet d’utiliser les touches de fonction avec des modificateurs comme touches de composition ou mortes dans des dispositions de clavier personnalisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti la gestione dei tasti funzione al sistema di input del testo di macOS.\nQuesto permette di usare i tasti funzione con i modificatori come tasti di composizione o tasti morti in layout di tastiera personalizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンクションキーをmacOSのテキスト入力システムで処理できるようにする。\nこれにより、カスタムキーボードレイアウトで修飾キー付きのファンクションキーをコンポーズ/デッドキーとして使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기능 키를 macOS 텍스트 입력 시스템이 처리하도록 허용합니다.\n사용자 지정 키보드 레이아웃에서 보조 키와 함께 누른 기능 키를 조합/데드 키로 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tekstinndatasystemet i macOS håndtere funksjonstaster.\nDette gjør det mulig å bruke funksjonstaster med spesialtaster som sammensettings- eller dødtaster i egendefinerte tastaturoppsett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat functietoetsen verwerken door het tekstinvoersysteem van macOS.\nHiermee kun je functietoetsen met speciale toetsen gebruiken als samenstel- of dode toetsen in aangepaste toetsenbordindelingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól, aby klawisze funkcyjne były obsługiwane przez system wprowadzania tekstu macOS.\nUmożliwia to używanie klawiszy funkcyjnych z modyfikatorami jako klawiszy składania/martwych w niestandardowych układach klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que teclas de função sejam tratadas pelo sistema de entrada de texto do macOS.\nIsso possibilita usar teclas de função com modificadores como teclas de composição/mortas em layouts de teclado personalizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить обработку функциональных клавиш системой ввода текста macOS.\nЭто поддерживает использование функциональных клавиш с модификаторами в качестве составных/мёртвых клавиш в пользовательских раскладках клавиатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť spracovanie funkčných klávesov systémom zadávania textu macOS.\nTo umožňuje používať funkčné klávesy s modifikačnými klávesmi ako kompozičné/mŕtve klávesy vo vlastných rozloženiach klávesnice."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovoli, da funkcijske tipke obravnava sistem za vnos besedila macOS.\nTo omogoča uporabo funkcijskih tipk z modifikatorji kot tipk za sestavljanje ali mrtvih tipk v tipkovnicah po meri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt macOS textinmatningssystem hantera funktionstangenter.\nDetta gör det möjligt att använda funktionstangenter med modifierartangenter som sammansättnings-/döda tangenter i anpassade tangentbordslayouter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlev tuşlarının macOS metin girişi sistemi tarafından işlenmesine izin ver.\nBu, özel klavye düzenlerinde değiştirici tuşlu işlev tuşlarının birleştirme/ölü tuş olarak kullanılmasını destekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép hệ thống nhập văn bản của macOS xử lý các phím chức năng.\nĐiều này hỗ trợ dùng phím chức năng cùng phím bổ trợ làm phím tổ hợp/phím chết trong bố cục bàn phím tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否允许功能键由macOS文本输入系统处理？\n这支持在自定义键盘布局中将功能键与修饰符组合使用为撰写/死亡键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許功能鍵由 macOS 文字輸入系統處理。\n這支援在自訂鍵盤配置中，將搭配變更鍵的功能鍵用作組合鍵／無作用鍵。"
          }
        }
      }
    },
