    "ScriptLauncher.RefetchRuntimeMessage" : {
      "comment" : "Prompt to download the Apple Silicon runtime",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gemeinsam genutzte Python-Laufzeitumgebung ist reines Intel und kann auf dieser Version von macOS nicht ausgeführt werden. Jetzt die Apple-Silicon-Version herunterladen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The shared Python runtime is Intel-only and cannot run on this version of macOS. Download the Apple Silicon version now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entorno de ejecución de Python compartido es solo para Intel y no se puede ejecutar en esta versión de macOS. ¿Descargar ahora la versión para Apple Silicon?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement d’exécution Python partagé est réservé à Intel et ne peut pas s’exécuter sur cette version de macOS. Télécharger la version pour Apple Silicon maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente di esecuzione Python condiviso è solo per Intel e non può essere eseguito su questa versione di macOS. Scaricare ora la versione per Apple Silicon?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有のPythonランタイムはIntel専用であり、このバージョンのmacOSでは実行できません。今すぐApple Silicon版をダウンロードしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 Python 런타임은 Intel 전용이므로 이 버전의 macOS에서 실행할 수 없습니다. 지금 Apple Silicon 버전을 다운로드하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O runtime compartilhado do Python é somente para Intel e não pode ser executado nesta versão do macOS. Baixar a versão para Apple Silicon agora?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общая среда выполнения Python предназначена только для Intel и не может работать в этой версии macOS. Загрузить версию для Apple Silicon сейчас?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılan Python çalışma zamanı yalnızca Intel içindir ve macOS’un bu sürümünde çalışamaz. Apple Silicon sürümü şimdi indirilsin mi?"
