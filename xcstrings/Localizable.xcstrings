    "Companion.InstallAIConfigured" : {
      "comment" : "Shown on the full setup screen instead of the API key field when the user’s AI model already works",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkce AI budou používat model, který jste již nastavili v části „Nastavení > Obecné > AI“, takže zde není potřeba API klíč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-funktioner bruger den model, du allerede har konfigureret i Indstillinger > Generelt > AI, så du behøver ingen API-nøgle her."
