    "AdvancedSetting.browserProfiles" : {
      "comment" : "Advanced setting: browserProfiles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile im Browser-Stil aktivieren?\nSie müssen iTerm2 neu starten, damit dies wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable browser-style profiles?\nYou must restart iTerm2 for this to take effect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザ形式のプロファイルを有効にしますか?\nこれを反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 스타일 프로파일을 활성화하겠습니까?\n이 설정을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar perfis no estilo de navegador?\nVocê deve reiniciar o iTerm2 para que isto tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить профили в стиле браузера?\nДля вступления в силу необходимо перезапустить iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用浏览器式配置文件？  \n需重启iTerm2才能生效。"
          }
        }
      }
    },
    "AdvancedSetting.browserProxyEnabled" : {
      "comment" : "Advanced setting: browserProxyEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP-Proxy für den Webbrowser aktivieren?\nWenn aktiviert, wird der gesamte Browser-Datenverkehr über den konfigurierten Proxyserver geleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable HTTP proxy for web browser?\nWhen enabled, routes all browser traffic through the configured proxy server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web ブラウザ用の HTTP プロキシを有効にしますか?\n有効にすると、すべてのブラウザトラフィックが設定されたプロキシサーバー経由でルーティングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 브라우저에 HTTP 프록시를 활성화하겠습니까?\n활성화하면 모든 브라우저 트래픽이 구성된 프록시 서버를 거칩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar proxy HTTP para o navegador web?\nQuando ativado, roteia todo o tráfego do navegador pelo servidor proxy configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить HTTP-прокси для веб-браузера?\nПри включении весь трафик браузера направляется через настроенный прокси-сервер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用网页浏览器HTTP代理？  \n启用后，所有浏览器流量将通过配置的代理服务器路由。"
          }
        }
      }
    },
    "AdvancedSetting.browserProxyHost" : {
      "comment" : "Advanced setting: browserProxyHost",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostname oder IP-Adresse des HTTP-Proxys\nDie Adresse des Proxyservers, der für Browserverbindungen verwendet werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP proxy hostname or IP address\nThe address of the proxy server to use for browser connections."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP プロキシのホスト名または IP アドレス\nブラウザ接続に使用するプロキシサーバーのアドレスです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP 프록시 호스트 이름 또는 IP 주소\n브라우저 연결에 사용할 프록시 서버의 주소입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome do host ou endereço IP do proxy HTTP\nO endereço do servidor proxy a usar para conexões do navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя хоста или IP-адрес HTTP-прокси\nАдрес прокси-сервера для использования при соединениях браузера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP代理主机名或IP地址  \n用于浏览器连接的代理服务器地址。"
          }
        }
      }
    },
    "AdvancedSetting.browserProxyPort" : {
      "comment" : "Advanced setting: browserProxyPort",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP-Proxy-Port\nDie Portnummer des Proxyservers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HTTP proxy port\nThe port number of the proxy server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP プロキシのポート\nプロキシサーバーのポート番号です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
