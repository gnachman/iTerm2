    "TmuxWorkgroup.HiddenPanes.InUse" : {
      "comment" : "Announcement shown when a tmux session has programs in hidden windows that belong to a workgroup none of this Mac’s workgroups match. Another Mac may be using them. The count is the number of programs.",
      "localizations" : {
        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ve skrytých oknech tmux jsou %lld programy z pracovní skupiny, kterou tento Mac nepoužívá. Pokud je zde otevřete nebo zastavíte, počítače Mac používající tuto pracovní skupinu o ně přijdou."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ve skrytých oknech tmux je %lld programu z pracovní skupiny, kterou tento Mac nepoužívá. Pokud je zde otevřete nebo zastavíte, počítače Mac používající tuto pracovní skupinu o ně přijdou."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ve skrytém okně tmux je %lld program z pracovní skupiny, kterou tento Mac nepoužívá. Pokud ho zde otevřete nebo zastavíte, počítače Mac používající tuto pracovní skupinu o něj přijdou."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ve skrytých oknech tmux je %lld programů z pracovní skupiny, kterou tento Mac nepoužívá. Pokud je zde otevřete nebo zastavíte, počítače Mac používající tuto pracovní skupinu o ně přijdou."
                }
              }
            }
          }
        },
        "da" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Et program fra en arbejdsgruppe, som denne Mac ikke bruger, er i et skjult tmux-vindue. Mac-computere, der bruger den arbejdsgruppe, mister det, hvis du åbner eller stopper det her."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld programmer fra en arbejdsgruppe, som denne Mac ikke bruger, er i skjulte tmux-vinduer. Mac-computere, der bruger den arbejdsgruppe, mister dem, hvis du åbner eller stopper dem her."
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ein Programm aus einer Arbeitsgruppe, die dieser Mac nicht verwendet, befindet sich in einem verborgenen tmux-Fenster. Macs, die diese Arbeitsgruppe verwenden, verlieren es, wenn Sie es hier öffnen oder beenden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
