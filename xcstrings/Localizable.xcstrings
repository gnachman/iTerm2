    "PTYSession.SSHArgumentsUnreadable" : {
      "comment" : "Banner shown when it2ssh's arguments cannot be decoded and the SSH connection is ended",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integraci SSH se nepodařilo spustit, protože iTerm2 nemohl přečíst argumenty předané příkazu it2ssh. K připojení bez integrace SSH použijte ssh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-integration kunne ikke startes, fordi iTerm2 ikke kunne læse de argumenter, der blev givet til it2ssh. Brug ssh til at oprette forbindelse uden SSH-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die SSH-Integration konnte nicht gestartet werden, weil iTerm2 die an it2ssh übergebenen Argumente nicht lesen konnte. Verwenden Sie ssh, um ohne SSH-Integration eine Verbindung herzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SSH integration couldn’t start because iTerm2 couldn’t read the arguments given to it2ssh. Use ssh to connect without SSH integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar la integración con SSH porque iTerm2 no pudo leer los argumentos proporcionados a it2ssh. Usa ssh para conectarte sin la integración con SSH."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-integraatiota ei voitu käynnistää, koska iTerm2 ei voinut lukea it2ssh:lle annettuja argumentteja. Käytä ssh:ta yhdistääksesi ilman SSH-integraatiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration SSH n’a pas pu démarrer, car iTerm2 n’a pas pu lire les arguments transmis à it2ssh. Utilisez ssh pour vous connecter sans l’intégration SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare l’integrazione SSH perché iTerm2 non è riuscito a leggere gli argomenti passati a it2ssh. Usa ssh per connetterti senza l’integrazione SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2がit2sshに渡された引数を読み取れなかったため、SSH統合を開始できませんでした。SSH統合を使わずに接続するにはsshを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 it2ssh에 전달된 인수를 읽을 수 없어 SSH 통합을 시작할 수 없습니다. SSH 통합 없이 연결하려면 ssh를 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-integrering kunne ikke startes fordi iTerm2 ikke kunne lese argumentene som ble gitt til it2ssh. Bruk ssh for å koble til uten SSH-integrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-integratie kon niet starten omdat iTerm2 de argumenten voor it2ssh niet kon lezen. Gebruik ssh om verbinding te maken zonder SSH-integratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się uruchomić integracji z SSH, ponieważ iTerm2 nie mógł odczytać argumentów przekazanych do it2ssh. Użyj ssh, aby połączyć się bez integracji z SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar a integração SSH porque o iTerm2 não conseguiu ler os argumentos passados ao it2ssh. Use o ssh para se conectar sem a integração SSH."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить интеграцию SSH, так как iTerm2 не смог прочитать аргументы, переданные it2ssh. Используйте ssh, чтобы подключиться без интеграции SSH."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrácia SSH sa nemohla spustiť, pretože iTerm2 nedokázal prečítať argumenty odovzdané it2ssh. Na pripojenie bez integrácie SSH použite ssh."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracije SSH ni bilo mogoče zagnati, ker iTerm2 ni mogel prebrati argumentov, podanih ukazu it2ssh. Za povezavo brez integracije SSH uporabite ssh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH-integreringen kunde inte starta eftersom iTerm2 inte kunde läsa argumenten som gavs till it2ssh. Använd ssh för att ansluta utan SSH-integrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, it2ssh’e verilen bağımsız değişkenleri okuyamadığı için SSH Entegrasyonu başlatılamadı. SSH Entegrasyonu olmadan bağlanmak için ssh kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tích hợp SSH không thể bắt đầu vì iTerm2 không đọc được các đối số truyền cho it2ssh. Hãy dùng ssh để kết nối mà không có Tích hợp SSH."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动 SSH 集成，因为 iTerm2 无法读取传给 it2ssh 的参数。请使用 ssh 在不使用 SSH 集成的情况下连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 整合無法啟動，因為 iTerm2 無法讀取傳給 it2ssh 的引數。請使用 ssh 在不使用 SSH 整合的情況下連線。"
          }
        }
      }
    },
