    "ProfilesAdvanced.TriggersHelpBrowser" : {
      "comment" : "Help text describing triggers in a browser session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger sind Aktionen, die Sie so konfigurieren, dass sie ausgeführt werden, wenn bestimmte URLs besucht werden oder Text auf einer Webseite gefunden wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers are actions you configure to run when certain URLs are visited or text on a web page is found."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los disparadores son acciones que configuras para que se ejecuten cuando se visitan ciertas URLs o se encuentra texto en una página web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclencheurs sont des actions que vous configurez pour s’exécuter lorsque certaines URLs sont visitées ou qu’un texte est trouvé sur une page web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli attivatori sono azioni che configuri per essere eseguite quando vengono visitati determinati URL o viene trovato del testo in una pagina web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーとは、特定のURLにアクセスしたときやWebページ上でテキストが見つかったときに実行するよう設定できるアクションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 특정 URL을 방문하거나 웹 페이지에서 특정 텍스트를 발견했을 때 실행되도록 구성하는 동작입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gatilhos são ações que você configura para executar quando certos URLs são visitados ou um texto é encontrado em uma página web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггеры представляют собой действия, которые запускаются при посещении определённых URL-адресов или при обнаружении текста на веб-странице."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyiciler, belirli URL’ler ziyaret edildiğinde veya bir web sayfasında metin bulunduğunda çalışacak şekilde yapılandırdığınız eylemlerdir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器是你配置的操作，当访问特定 URL 或在网页上找到文本时运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
