    "GeneralPrefs.AlwaysOpenAutoLaunch" : {
      "comment" : "Explains why opening a window at startup is disabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Vorhandensein von Autostart-Skripten deaktiviert das Öffnen eines Fensters beim Start."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The presence of auto-launch scripts disables opening a window at startup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動起動スクリプトが存在するため、起動時にウインドウを開く設定は無効になっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 실행 스크립트가 있으면 시동 시 윈도우 열기가 꺼집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A presença de scripts de execução automática desativa a abertura de uma janela na inicialização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наличие скриптов автозапуска отключает открытие окна при запуске."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动启动脚本的存在会阻止启动时打开窗口。"
          }
        }
      }
    },
