    "AdvancedSetting.alwaysUseStatusBarComposer" : {
      "comment" : "Advanced setting: alwaysUseStatusBarComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dočasně přidat editor příkazů do stavového řádku místo otevření velkého zobrazení editoru příkazů, pokud je stavový řádek přítomen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj midlertidigt en kommandoeditor til statuslinjen i stedet for at åbne den store kommandoeditorvisning, når der er en statuslinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorübergehend einen Composer zur Statusleiste hinzufügen, anstatt die große Composer-Ansicht zu öffnen, wenn eine Statusleiste vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily add a composer to the status bar instead of opening the large composer view when a status bar is present."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir temporalmente un compositor a la barra de estado en lugar de abrir la vista grande del compositor cuando hay una barra de estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää tilapalkkiin väliaikaisesti komentoeditori suuren komentoeditorinäkymän avaamisen sijaan, kun tilapalkki on näkyvissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter temporairement un compositeur à la barre d’état au lieu d’ouvrir la grande vue du compositeur lorsqu’une barre d’état est présente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi temporaneamente un compositore alla barra di stato invece di aprire la grande vista del compositore quando è presente una barra di stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーが存在する場合、大きなコンポーザビューを開く代わりに、ステータスバーに一時的にコンポーザーを追加する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대가 있을 때 큰 컴포저 보기를 여는 대신 상태 막대에 컴포저를 임시로 추가합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg midlertidig til en kommandoskriver i statuslinjen i stedet for å åpne den store kommandoskriver-visningen når en statuslinje er til stede."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg tijdelijk een opsteller toe aan de statusbalk in plaats van de grote opstellerweergave te openen wanneer er een statusbalk is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tymczasowo dodaj edytor poleceń do paska stanu zamiast otwierać duży widok edytora poleceń, gdy pasek stanu jest widoczny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar temporariamente um compositor à barra de status em vez de abrir a visualização grande do compositor quando houver uma barra de status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временно добавлять композитор в строку состояния вместо открытия большого окна композитора, если строка состояния присутствует."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dočasne pridať editor príkazov do stavovej lišty namiesto otvorenia veľkého zobrazenia editora príkazov, ak je stavová lišta prítomná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začasno dodaj urejevalnik ukazov v vrstico stanja namesto odpiranja velikega pogleda urejevalnika, kadar je vrstica stanja prisotna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg tillfälligt till en kommandoredigerare i statusfältet i stället för att öppna den stora kommandoredigerarvyn när ett statusfält finns."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum çubuğu varsa büyük oluşturucu görünümünü açmak yerine durum çubuğuna geçici olarak bir oluşturucu ekle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạm thời thêm trình soạn lệnh vào thanh trạng thái thay vì mở chế độ xem trình soạn lệnh lớn khi có thanh trạng thái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在状态栏存在时，临时添加一个 composer，而不是打开大的 composer视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在狀態列時，暫時在狀態列中加入編寫器，而不是打開大型編寫器檢視。"
          }
        }
      }
    },
    "AdvancedSetting.alwaysWarnBeforePastingOverSize" : {
      "comment" : "Advanced setting: alwaysWarnBeforePastingOverSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při vkládání více než tohoto počtu znaků vyžadovat potvrzení.\nHodnotou -1 se varování vypne.\nZnaky se počítají v UTF-16."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræv bekræftelse, når der indsættes flere end dette antal tegn.\nAngiv -1 for at slå advarslen fra.\nTegn tælles i UTF-16."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einfügen von mehr als dieser Anzahl an Zeichen eine Bestätigung verlangen.\nAuf -1 setzen, um die Warnung zu deaktivieren.\nZeichen werden in UTF-16 gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When pasting more than this many characters, require confirmation.\nSet to -1 to disable warning.\nCharacters are counted in UTF-16."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pegar más de esta cantidad de caracteres, exigir confirmación.\nUsa -1 para desactivar el aviso.\nLos caracteres se cuentan en UTF-16."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaadi vahvistus, kun sijoitetaan tätä useampia merkkejä.\nAseta arvoon -1 poistaaksesi varoituksen käytöstä.\nMerkit lasketaan UTF-16:ssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiger une confirmation lors du collage de plus de ce nombre de caractères.\nDéfinissez -1 pour désactiver l’avertissement.\nLes caractères sont comptés en UTF-16."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si incollano più di questo numero di caratteri, richiedi conferma.\nImposta -1 per disabilitare l’avviso.\nI caratteri sono contati in UTF-16."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この文字数を超える貼り付けを行う際に確認を必須にする。\n警告を無効にするには-1に設定してください。\n文字数はUTF-16でカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣는 문자 수가 이 값을 넘으면 확인 요구\n경고를 끄려면 -1로 설정하십시오.\n문자 수는 UTF-16 기준으로 셉니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krev bekreftelse når mer enn dette antallet tegn limes inn.\nAngi -1 for å deaktivere advarselen.\nTegn telles i UTF-16."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag om bevestiging bij het plakken van meer dan dit aantal tekens.\nStel in op -1 om de waarschuwing uit te schakelen.\nTekens worden geteld in UTF-16."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wklejaniu więcej niż tylu znaków wymagaj potwierdzenia.\nUstaw -1, aby wyłączyć ostrzeżenie.\nZnaki są liczone w UTF-16."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar mais que esta quantidade de caracteres, exigir confirmação.\nDefina como -1 para desativar o aviso.\nOs caracteres são contados em UTF-16."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требовать подтверждение при вставке более указанного числа символов.\nУстановите -1, чтобы отключить предупреждение.\nСимволы подсчитываются в кодировке UTF-16."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vkladaní viac ako tohto počtu znakov vyžadovať potvrdenie.\nHodnotou -1 sa upozornenie vypne.\nZnaky sa počítajú v UTF-16."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri lepljenju več kot toliko znakov zahtevaj potrditev.\nNastavite na -1 za onemogočitev opozorila.\nZnaki se štejejo v UTF-16."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräv bekräftelse när fler än så här många tecken klistras in.\nAnge -1 för att avaktivera varningen.\nTecken räknas i UTF-16."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sayıdan fazla karakter yapıştırılırken onay iste.\nUyarıyı devre dışı bırakmak için -1 yapın.\nKarakterler UTF-16 olarak sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi dán nhiều ký tự hơn số này, yêu cầu xác nhận.\nĐặt là -1 để tắt cảnh báo.\nKý tự được đếm theo UTF-16."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当粘贴的字符数超过此数量时，需要确认。\n将值设为 -1 可禁用警告提示。\n字符按 UTF-16 计数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上超過此字元數時，需要確認。\n設為 -1 可停用警告。\n字元以 UTF-16 計算。"
          }
        }
      }
    },
    "AdvancedSetting.animateGraphStatusBarComponents" : {
      "comment" : "Advanced setting: animateGraphStatusBarComponents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animovat součásti stavového řádku založené na grafech?\nVypnutím snížíte využití CPU/GPU v WindowServeru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animer grafbaserede statuslinjekomponenter?\nSlå dette fra for at mindske CPU-/GPU-forbruget i WindowServer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graphbasierte Statusleisten-Komponenten animieren?\nSchalten Sie dies aus, um die CPU-/GPU-Auslastung in WindowServer zu reduzieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animate graph-based status bar components?\nTurn this off to reduce CPU/GPU usage in WindowServer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Animar los componentes de la barra de estado basados en gráficos?\nDesactívalo para reducir el uso de CPU/GPU en WindowServer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animoidaanko kaaviopohjaiset tilapalkin osat?\nPoista tämä käytöstä vähentääksesi WindowServerin CPU- ja GPU-käyttöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animer les composants graphiques de la barre d’état ?\nDésactivez cette option pour réduire l’utilisation du CPU/GPU dans WindowServer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animare i componenti grafici della barra di stato?\nDisattivalo per ridurre l’uso di CPU/GPU in WindowServer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフベースのステータスバーコンポーネントをアニメーション表示しますか？\nWindowServerのCPU/GPU使用率を減らすには、これをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래프 기반 상태 막대 구성 요소에 애니메이션을 적용하겠습니까?\nWindowServer의 CPU/GPU 사용량을 줄이려면 이 옵션을 끄십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animere graf-baserte statuslinjekomponenter?\nSlå dette av for å redusere CPU-/GPU-bruken i WindowServer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusbalkonderdelen met grafieken animeren?\nSchakel dit uit om het CPU-/GPU-gebruik van WindowServer te verlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animować składniki paska stanu oparte na wykresach?\nWyłącz, aby zmniejszyć użycie CPU/GPU w WindowServer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animar componentes da barra de status baseados em gráfico?\nDesative isso para reduzir o uso de CPU/GPU no WindowServer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимировать компоненты строки состояния на основе графиков?\nОтключите этот параметр, чтобы снизить нагрузку на ЦП/ГП в WindowServer."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animovať komponenty stavovej lišty založené na grafoch?\nVypnutím znížite využitie CPU/GPU v procese WindowServer."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animiraj komponente vrstice stanja z grafi?\nIzklopite za manjšo porabo CPU/GPU v WindowServer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animera grafbaserade statusfältskomponenter?\nStäng av detta för att minska CPU-/GPU-användningen i WindowServer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafik tabanlı durum çubuğu bileşenleri canlandırılsın mı?\nWindowServer’daki CPU/GPU kullanımını azaltmak için bunu kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo hiệu ứng động cho các thành phần thanh trạng thái dạng biểu đồ?\nTắt tùy chọn này để giảm mức dùng CPU/GPU của WindowServer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否对基于图表的状态栏组件进行动画处理？\n关闭此选项以降低 WindowServer 中的 CPU/GPU 使用率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為圖表式狀態列元件加上動畫？\n關閉此項可降低 WindowServer 的 CPU／GPU 使用量。"
          }
        }
      }
    },
