    "Tip.0070.Body" : {
      "comment" : "Tip of the day body, id 0070",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in 3.1: Sie können unter „Einstellungen > Profile > Tasten > Hotkey-Fenster anpassen“ festlegen, dass sich ein Hotkey-Fenster beim doppelten Tippen einer Modifikatortaste öffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can configure a hotkey window to open on double-tap of a modifier in “Settings > Profiles > Keys > Customize Hotkey Window.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novedad en la 3.1: puedes configurar una ventana de tecla rápida para que se abra al pulsar dos veces un modificador en “Ajustes > Perfiles > Teclas > Personalizar ventana de tecla rápida”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau dans la version 3.1 : vous pouvez configurer une fenêtre à raccourci global pour qu’elle s’ouvre en appuyant deux fois sur un modificateur dans « Réglages > Profils > Touches > Configurer la fenêtre à raccourci global »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novità della 3.1: puoi configurare una finestra ad abbreviazione globale in modo che si apra con il doppio tocco di un tasto modificatore in “Impostazioni > Profili > Tasti > Configura finestra ad abbreviazione globale”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1の新機能: 「設定 > プロファイル > キー > ホットキーウィンドウをカスタマイズ」で、修飾キーのダブルタップでホットキーウィンドウを開くよう設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1의 새로운 기능: “설정 > 프로파일 > 키 > 단축키 윈도우 사용자화”에서 보조 키를 두 번 탭하면 단축키 윈도우가 열리도록 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode configurar uma janela de atalho para abrir ao tocar duas vezes em um modificador em “Ajustes > Perfis > Teclas > Personalizar janela de atalho”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое в 3.1: вы можете настроить открытие окна горячих клавиш двойным нажатием модификатора в «Настройки > Профили > Клавиши > Настроить окно горячих клавиш»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1’de yeni: Bir kısayol tuşu penceresini, “Ayarlar > Profiller > Tuşlar > Kısayol Tuşu Penceresini Özelleştir” bölümünde bir değiştirici tuşa çift dokunulduğunda açılacak şekilde yapılandırabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1新功能：你可以在“设置 > 配置文件 > 按键 > 自定义热键窗口”中配置热键窗口，通过按修饰键两次点击即可打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1 新功能：你可以在「設定 > 描述檔 > 按鍵 > 自訂全域快速鍵視窗」中，設定讓全域快速鍵視窗在連按兩下變更鍵時打開。"
          }
        }
      }
    },
