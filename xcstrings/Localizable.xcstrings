    "Tip.0022.Body" : {
      "comment" : "Tip of the day body, id 0022",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkce integrace shellu umožňuje nechat se upozornit (⌥⌘A), až se dlouho běžící příkaz dokončí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med shell-integration kan du bede om at få besked (⌥⌘A), når en langvarig kommando er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Shell-Integration können Sie sich benachrichtigen lassen (⌥⌘A), wenn ein lange laufender Befehl abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Shell Integration feature lets you ask to be alerted (⌥⌘A) when a long-running command completes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con el shell te permite pedir que se te avise (⌥⌘A) cuando termine un comando de larga duración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentotulkki-integraation avulla voit pyytää ilmoituksen (⌥⌘A), kun pitkään kestävä komento päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration du shell vous permet de demander une alerte (⌥⌘A) lorsqu’une commande de longue durée se termine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione shell ti permette di chiedere di ricevere un avviso (⌥⌘A) quando termina un comando di lunga durata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合機能を使うと、長時間実行しているコマンドが完了したときにアラートを受け取るよう設定できます(⌥⌘A)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합 기능을 사용하면 오래 실행되는 명령이 완료될 때 알림을 받도록 요청할 수 있습니다(⌥⌘A)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skallintegrering kan du be om å bli varslet (⌥⌘A) når en kommando som tar lang tid, er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met shell-integratie kun je een melding aanvragen (⌥⌘A) wanneer een langlopend commando klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracja z powłoką pozwala poprosić o alert (⌥⌘A), gdy zakończy się długo trwające polecenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso Shell Integration permite pedir para ser alertado (⌥⌘A) quando um comando demorado termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция «Интеграция с оболочкой» позволяет получать оповещение (⌥⌘A) о завершении долго выполняющейся команды."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcia integrácie shellu umožňuje nechať sa upozorniť (⌥⌘A) po dokončení dlho bežiaceho príkazu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcija integracije lupine omogoča, da vas obvestimo (⌥⌘A), ko se dolgotrajen ukaz konča."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skalintegrering kan du be om att bli varnad (⌥⌘A) när ett långvarigt kommando är klart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu özelliği, uzun süren bir komut tamamlandığında uyarılmayı (⌥⌘A) istemenizi sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng Tích hợp shell cho phép bạn yêu cầu được cảnh báo (⌥⌘A) khi một lệnh chạy lâu hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 集成功能允许你在长时间运行的命令完成时收到提醒（⌥⌘A）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 整合功能可讓你在長時間執行的指令完成時收到提醒（⌥⌘A）。"
          }
        }
      }
    },
