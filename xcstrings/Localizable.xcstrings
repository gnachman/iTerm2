    "NSFileManager.CreateDirectoryPrompt" : {
      "comment" : "Prompt asking whether to create a missing directory; placeholder is the path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
