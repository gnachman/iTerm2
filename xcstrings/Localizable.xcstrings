          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPulsa cualquier tecla para descartar este mensaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nHylkää tämä viesti painamalla mitä tahansa näppäintä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nAppuyez sur une touche pour fermer ce message."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPremi un tasto qualsiasi per chiudere questo messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n任意のキーを押すとこのメッセージを閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n이 메시지를 닫으려면 아무 키나 누르십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTrykk på en tast for å lukke denne meldingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDruk op een willekeurige toets om dit bericht te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNaciśnij dowolny klawisz, aby zamknąć ten komunikat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPressione qualquer tecla para dispensar esta mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНажмите любую клавишу, чтобы закрыть это сообщение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nStlačením ľubovoľného klávesu túto správu zavriete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPritisnite poljubno tipko, da zaprete to sporočilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTryck på valfri tangent för att stänga det här meddelandet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBu iletiyi kapatmak için herhangi bir tuşa basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNhấn phím bất kỳ để đóng thông báo này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n按任意键关闭此消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n按任意鍵即可關閉此訊息。"
          }
        }
      }
    },
