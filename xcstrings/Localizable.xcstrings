    "ClaudeCode.UninstallDisconnectedHosts" : {
      "comment" : "Line of the uninstall confirmation explaining that hosts not currently connected through SSH Integration are not changed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostitelé, kteří nejsou připojeni, si ponechají svůj hook. Připojte se k nim pomocí integrace SSH a odinstalujte znovu, aby se hook odstranil i tam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værter, der ikke er forbundet, beholder deres hook. Opret forbindelse til en med SSH-integration, og afinstaller igen for at fjerne det der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts, die nicht verbunden sind, behalten ihren Hook. Verbinden Sie sich mit der SSH-Integration mit einem solchen Host und deinstallieren Sie erneut, um ihn dort zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hosts that aren’t connected keep their hook. Connect to one with SSH Integration and uninstall again to remove it there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hosts que no están conectados conservan su hook. Conéctate a uno con la integración con SSH y vuelve a desinstalar para eliminarlo allí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimet, joihin ei ole yhteyttä, säilyttävät koukkunsa. Muodosta yhteys palvelimeen SSH-integraatiolla ja poista asennus uudelleen poistaaksesi koukun sieltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hôtes non connectés conservent leur hook. Connectez-vous-y avec l’intégration SSH et désinstallez de nouveau pour l’y supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli host non connessi mantengono il proprio hook. Connettiti a uno con l’integrazione SSH e disinstalla di nuovo per rimuoverlo lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されていないホストのフックはそのまま残ります。SSH統合でそのホストに接続し、もう一度アンインストールすると、そこからも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되어 있지 않은 호스트의 훅은 그대로 남습니다. 해당 호스트에서 제거하려면 SSH 통합으로 연결한 후 다시 제거하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verter som ikke er tilkoblet, beholder hooken sin. Koble til en med SSH-integrering og avinstaller på nytt for å fjerne den der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts zonder verbinding behouden hun hook. Maak verbinding met een host via SSH-integratie en verwijder de installatie opnieuw om de hook daar te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosty, które nie są połączone, zachowują swój hak. Połącz się z hostem przez integrację z SSH i odinstaluj ponownie, aby usunąć go także tam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts que não estão conectados mantêm o hook. Conecte-se a um deles com a Integração SSH e desinstale novamente para removê-lo lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На неподключённых хостах хук останется. Чтобы удалить его там, подключитесь к хосту через интеграцию с SSH и снова выполните удаление."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostitelia, ktorí nie sú pripojení, si hook ponechajú. Pripojte sa k nim cez integráciu SSH a odinštalujte znovu, aby sa tam odstránil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostitelji, ki niso povezani, obdržijo svoj kavelj. Povežite se z enim od njih prek integracije SSH in znova odstranite, da ga odstranite tudi tam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värdar som inte är anslutna behåller sin hook. Anslut till en med SSH-integrering och avinstallera igen för att ta bort den där."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı olmayan ana makineler kancalarını korur. Kaldırmak için SSH Entegrasyonu ile bir ana makineye bağlanıp yeniden kaldırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các máy chủ không được kết nối sẽ giữ lại hook. Hãy kết nối với máy chủ bằng Tích hợp SSH rồi gỡ cài đặt lại để xóa hook ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接的主机会保留其钩子。要从某台主机上移除，请通过 SSH 集成连接到该主机，然后再次卸载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未連線的主機會保留其 hook。請使用 SSH 整合連線到該主機，然後再次解除安裝，即可從該處移除。"
          }
        }
      }
    },
