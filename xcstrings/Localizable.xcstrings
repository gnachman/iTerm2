          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvien tai valitun tekstin vetämiseen on pidettävä ⌘ painettuna. Tämä estää vahingossa tapahtuvat vedot."
