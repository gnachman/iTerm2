          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera interfejs, w którym możesz dodawać, uaktualniać lub usuwać zależności pip skryptu API Pythona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre uma interface onde você pode adicionar, atualizar ou remover dependências pip de um script da API Python."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает интерфейс, в котором можно добавлять, обновлять или удалять зависимости pip скрипта Python API."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorí rozhranie, v ktorom môžete pridávať, aktualizovať alebo odstraňovať závislosti pip skriptu Python API."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpre vmesnik, v katerem lahko dodajate, posodabljate ali odstranjujete odvisnosti pip skripta API Python."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar ett gränssnitt där du kan lägga till, uppdatera eller ta bort pip-beroenden för ett Python-API-skript."
          }
