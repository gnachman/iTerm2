    "ProfilesSession.SendCodeWhenIdleWarning" : {
      "comment" : "Warning shown when enabling the send-ASCII-code-when-idle option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sollten Sie wahrscheinlich nicht aktivieren. Es eignet sich nicht dazu, ssh-Sitzungen aufrechtzuerhalten, selbst mit einem Code von „0“. Sind Sie sicher, dass Sie dies möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You probably don’t want to turn this on. It's not suitable for keeping ssh sessions alive, even with a code of “0”. Are you sure you want this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probablemente no quieras activar esto. No es adecuado para mantener activas las sesiones de ssh, ni siquiera con un código “0”. ¿Seguro que quieres hacerlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne voulez probablement pas activer ceci. Ce n’est pas adapté pour maintenir des sessions ssh actives, même avec un code « 0 ». Voulez-vous vraiment l’activer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente non vuoi attivarlo. Non è adatto a mantenere attive le sessioni ssh, nemmeno con il codice “0”. Vuoi davvero attivarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすることはお勧めしません。コード「0」を使用してもsshセッションを維持する用途には適していません。本当によろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션은 켜지 않는 것이 좋습니다. 코드를 “0”으로 지정해도 SSH 세션을 유지하는 데 적합하지 않습니다. 정말 켜겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você provavelmente não quer ativar isto. Não é adequado para manter sessões ssh ativas, mesmo com um código “0”. Tem certeza de que quer isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорее всего, вам не стоит включать эту функцию. Она не подходит для поддержания ssh-сессий активными, даже с кодом «0». Вы уверены, что хотите это сделать?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muhtemelen bunu açmak istemezsiniz. “0” koduyla bile ssh oturumlarını canlı tutmak için uygun değildir. Bunu gerçekten istiyor musunuz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不想开启这个。它不适合保持 ssh 会话存活，即使使用代码“0”也是如此。确定要这样吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不想開啟這個。它不適合用來保持 ssh 工作階段連線，即使代碼為「0」也一樣。確定要這樣做嗎？"
          }
        }
      }
    },
