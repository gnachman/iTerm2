            "value" : "Et program har forsøkt å endre størrelsen på vinduet. Vil du tillate det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een programma heeft geprobeerd het formaat van het venster te wijzigen. Wil je dit toestaan?"
