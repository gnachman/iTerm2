    "StatusPriority.InstructionsLabel" : {
      "comment" : "Instructional label at the top of the status priority settings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavy jsou seřazeny podle priority. Položky nahoře mají vyšší prioritu. Přetažením změníte pořadí. Kliknutím upravíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusser sorteres efter prioritet. Emner nær toppen har højere prioritet. Træk for at ændre rækkefølgen. Klik for at redigere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status werden nach Priorität sortiert. Einträge weiter oben haben eine höhere Priorität. Ziehen zum Umordnen, Klicken zum Bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Statuses are sorted by priority. Items near the top have higher priority. Drag to reorder. Click to edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estados se ordenan por prioridad. Los ítems más cercanos a la parte superior tienen mayor prioridad. Arrastra para reordenar. Haz clic para editar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilat on lajiteltu tärkeysjärjestykseen. Ylimpänä olevilla kohteilla on suurempi tärkeys. Muuta järjestystä vetämällä. Muokkaa klikkaamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les états sont triés par priorité. Les éléments en haut ont la priorité la plus élevée. Faites glisser pour réorganiser. Cliquez pour modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli stati sono ordinati per priorità. Gli elementi in alto hanno priorità maggiore. Trascina per riordinare. Fai clic per modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスは優先度順に並んでいます。上にある項目ほど優先度が高くなります。ドラッグして並べ替え、クリックして編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태는 우선순위에 따라 정렬됩니다. 위쪽에 있는 항목일수록 우선순위가 높습니다. 드래그하여 순서를 변경하고, 클릭하여 편집하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statuser sorteres etter prioritet. Objekter nær toppen har høyere prioritet. Dra for å endre rekkefølgen. Klikk for å redigere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statussen worden op prioriteit gesorteerd. Onderdelen bovenaan hebben een hogere prioriteit. Sleep om de volgorde te wijzigen. Klik om te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stany są sortowane według priorytetu. Elementy bliżej góry mają wyższy priorytet. Przeciągnij, aby zmienić kolejność. Kliknij, aby edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os status são ordenados por prioridade. Os itens próximos ao topo têm prioridade mais alta. Arraste para reordenar. Clique para editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статусы отсортированы по приоритету. Элементы вверху списка имеют более высокий приоритет. Перетаскивайте, чтобы изменить порядок. Нажмите, чтобы изменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavy sú zoradené podľa priority. Položky bližšie k vrchu majú vyššiu prioritu. Poradie zmeníte potiahnutím. Upravíte kliknutím."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanja so razvrščena po prioriteti. Elementi bližje vrhu imajo višjo prioriteto. Povlecite za spremembo vrstnega reda. Kliknite za urejanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusar sorteras efter prioritet. Objekt närmare toppen har högre prioritet. Dra för att ändra ordning. Klicka för att redigera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durumlar önceliğe göre sıralanır. Üste yakın öğelerin önceliği daha yüksektir. Sırayı değiştirmek için sürükleyin. Düzenlemek için tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các trạng thái được sắp xếp theo mức ưu tiên. Mục ở gần đầu có mức ưu tiên cao hơn. Kéo để sắp xếp lại. Bấm để sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态按优先级排序。靠近顶部的项目优先级更高。拖移以重新排序。点按以编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態依優先順序排序。靠近頂端的項目優先順序較高。拖移以重新排序，按一下以編輯。"
          }
        }
      }
    },
