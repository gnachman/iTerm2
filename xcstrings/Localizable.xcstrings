    "AdvancedSetting.showWindowTitleWhenTabBarInvisible" : {
      "comment" : "Advanced setting: showWindowTitleWhenTabBarInvisible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstertitel anzeigen, wenn die Tab-Leiste nicht sichtbar ist?\nWenn deaktiviert, wird der Titel des Tabs dort angezeigt, wo normalerweise der Fenstertitel stehen würde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show window title when the tab bar is not visible?\nWhen disabled, the tab's title will be shown where the window title would normally go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mostrar el título de la ventana cuando la barra de pestañas no es visible?\nSi está desactivado, el título de la pestaña se mostrará donde normalmente va el título de la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le titre de la fenêtre lorsque la barre d’onglets n’est pas visible ?\nSi désactivé, le titre de l’onglet sera affiché à l’emplacement habituel du titre de la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrare il titolo della finestra quando la barra dei pannelli non è visibile?\nSe disattivato, il titolo del pannello verrà mostrato dove di solito va il titolo della finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーが表示されていないときにウィンドウタイトルを表示するか？\n無効にすると、通常ウィンドウタイトルが表示される場所にタブのタイトルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대가 보이지 않을 때 윈도우 제목을 표시하겠습니까?\n끄면 보통 윈도우 제목이 표시되는 위치에 탭 제목이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o título da janela quando a barra de abas não estiver visível?\nQuando desativado, o título da aba será mostrado onde o título da janela normalmente ficaria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать заголовок окна, когда панель вкладок не видна?\nЕсли отключено, на месте заголовка окна будет показан заголовок вкладки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğu görünür değilken pencere başlığı gösterilsin mi?\nDevre dışıyken, pencere başlığının normalde yer alacağı yerde sekmenin başlığı gösterilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签页栏不可见时显示窗口标题？\n当禁用时，标签页的标题将显示在通常放置窗口标题的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁列不可見時顯示視窗標題？\n停用時，視窗標題通常所在的位置會顯示標籤頁的標題。"
          }
        }
      }
    },
    "AdvancedSetting.showYellowMarkForJobStoppedBySignal" : {
