    "ChatViewController.LinkedSessionHelp" : {
      "comment" : "Help text explaining what linking a terminal session to the chat allows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Terminalsitzung mit diesem Chat verknüpft ist, kann die KI den Terminalinhalt einsehen und Befehle in dieser Sitzung ausführen. Sie werden aufgefordert, die Berechtigung zu erteilen, bevor sie eine Terminalsitzung einsehen, in sie tippen oder sie ändern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When a terminal session is linked to this chat, the AI may view terminal contents and run commands in that session. You will be prompted to grant permission before it is able to view, type to, or modify a terminal session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションがこのチャットにリンクされている場合、AIはそのセッションのターミナル内容を閲覧したり、コマンドを実行したりできます。ターミナルセッションを閲覧、入力、または変更する前には、許可を求めるダイアログが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션이 이 채팅에 연결되어 있으면 AI가 해당 세션의 터미널 내용을 보고 명령을 실행할 수 있습니다. AI가 터미널 세션을 보거나, 입력하거나, 수정하기 전에 권한을 부여하라는 요청이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma sessão de terminal está vinculada a este chat, a IA pode ver o conteúdo do terminal e executar comandos nessa sessão. Você será solicitado a conceder permissão antes que ela possa ver, digitar ou modificar uma sessão de terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда сессия терминала привязана к этому чату, ИИ может просматривать содержимое терминала и выполнять команды в этой сессии. Вам будет предложено предоставить разрешение, прежде чем он сможет просматривать, вводить текст или изменять сессию терминала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当终端会话链接到此聊天时，AI 可以查看终端内容并在该会话中运行命令。在它能够查看、输入或修改终端会话之前，系统会先提示你授予权限。"
          }
        }
      }
    },
