          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять масштаб шрифта при смене профиля функцией автоматического переключения профилей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik Profil Değiştirme profilleri değiştirdiğinde font yakınlaştırma düzeyini koru."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
