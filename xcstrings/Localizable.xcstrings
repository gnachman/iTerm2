    "AdvancedSetting.preventEscapeSequenceFromClearingHistory" : {
      "comment" : "Advanced setting: preventEscapeSequenceFromClearingHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabránit sekvenci CSI 3 J ve smazání historie posouvání?\nJe známa také jako schopnost terminfo E3."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhindr CSI 3 J i at rydde rullebufferen?\nDette kendes også som terminfo-egenskaben E3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindern, dass CSI 3 J den Scrollback-Verlauf leert?\nDies ist auch als terminfo-Fähigkeit E3 bekannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent CSI 3 J from clearing scrollback history?\nThis is also known as the terminfo E3 capability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Impedir que CSI 3 J borre el historial de desplazamiento?\nTambién se conoce como la capacidad E3 de terminfo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetäänkö CSI 3 J tyhjentämästä vierityshistoriaa?\nTämä tunnetaan myös terminfon E3-ominaisuutena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêcher CSI 3 J d’effacer l’historique de défilement ?\nCette capacité est aussi connue sous le nom de capacité terminfo E3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedire a CSI 3 J di cancellare la cronologia di scorrimento?\nÈ nota anche come capacità E3 di terminfo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSI 3 Jによるスクロールバック履歴のクリアを防止するか？\nこれはterminfoのE3機能としても知られています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSI 3 J가 스크롤백 기록을 지우지 못하도록 하겠습니까?\nterminfo의 E3 기능이라고도 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindre CSI 3 J i å tømme tilbakerullingshistorikken?\nDette er også kjent som terminfo-egenskapen E3."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorkomen dat CSI 3 J de scrollbackgeschiedenis wist?\nDit staat ook bekend als de terminfo-capability E3."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zapobiegać czyszczeniu historii bufora przewijania przez CSI 3 J?\nZnane też jako możliwość E3 w terminfo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir que CSI 3 J limpe o histórico de rolagem?\nIsto também é conhecido como a capacidade E3 do terminfo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запретить последовательности CSI 3 J очищать историю прокрутки?\nЭто также известно как возможность E3 в terminfo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabrániť sekvencii CSI 3 J vymazať históriu rolovania?\nVolá sa to aj schopnosť terminfo E3."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se CSI 3 J prepreči brisanje zgodovine pomikanja?\nTo je znano tudi kot zmožnost terminfo E3."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindra CSI 3 J från att rensa rullningshistoriken?\nDet kallas också terminfo-förmågan E3."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSI 3 J’nin geri kaydırma geçmişini temizlemesi engellensin mi?\nBu, terminfo E3 yeteneği olarak da bilinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn CSI 3 J xóa lịch sử cuộn ngược?\nĐiều này còn gọi là khả năng terminfo E3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止 CSI 3 J清除滚动历史记录？\n这也被称为 terminfo E3 功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止 CSI 3 J 清除捲動記錄？\n這也稱為 terminfo E3 功能。"
          }
        }
      }
    },
    "AdvancedSetting.preventSleepOnBatteryToo" : {
      "comment" : "Advanced setting: preventSleepOnBatteryToo",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bránit uspání systému při nečinnosti i na baterii u profilů se zapnutým „Zabránit uspání“?\nVe výchozím nastavení volba profilu „Zabránit uspání“ brání uspání při nečinnosti jen při připojení k napájení. Zapnutím zabráníte uspání i na baterii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhindr også systemets passive dvale på batteri for profiler med “Forhindr dvale” slået til?\nSom standard forhindrer profilindstillingen “Forhindr dvale” kun passiv dvale, mens der er tilsluttet strøm. Slå dette til for også at forhindre passiv dvale på batteri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch im Akkubetrieb den Ruhezustand des Systems verhindern, für Profile mit aktivierter Einstellung „Ruhezustand verhindern“?\nStandardmäßig verhindert die Profileinstellung „Ruhezustand verhindern“ den Ruhezustand nur bei Netzbetrieb. Aktivieren Sie dies, um den Ruhezustand auch im Akkubetrieb zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent system idle sleep on battery too, for profiles with “Prevent sleep” enabled?\nBy default the “Prevent sleep” profile setting only prevents idle sleep while connected to power. Enable this to also prevent idle sleep on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Impedir también la suspensión por inactividad del sistema con batería, en perfiles con “Impedir suspensión” activado?\nDe forma predeterminada, el ajuste de perfil “Impedir suspensión” solo impide la suspensión por inactividad mientras hay conexión a la corriente. Actívalo para impedirla también con batería."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetäänkö järjestelmän toimettomuusunitila myös akulla niissä profiileissa, joissa ”Estä uni” on käytössä?\nOletuksena profiilin ”Estä uni” -asetus estää toimettomuusunen vain virtalähteeseen kytkettynä. Ota tämä käyttöön estääksesi toimettomuusunen myös akulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêcher aussi la mise en veille d’inactivité sur batterie, pour les profils avec « Empêcher la mise en veille » activé ?\nPar défaut, le réglage de profil « Empêcher la mise en veille » n’empêche la mise en veille d’inactivité que sur secteur. Activez-le pour l’empêcher aussi sur batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedire la sospensione per inattività del sistema anche a batteria, per i profili con “Impedisci la sospensione” attivo?\nPer impostazione predefinita, l’impostazione di profilo “Impedisci la sospensione” impedisce la sospensione per inattività solo con l’alimentazione collegata. Attivala per impedirla anche a batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スリープを防止する」が有効なプロファイルについて、バッテリー駆動時もシステムのアイドルスリープを防止するか？\nデフォルトでは、プロファイルの「スリープを防止する」設定は電源に接続されている間のみアイドルスリープを防止します。バッテリー駆動時にもアイドルスリープを防止するにはこれを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“잠자기 방지”가 켜진 프로파일에서 배터리 사용 중에도 시스템 유휴 잠자기를 방지하겠습니까?\n기본적으로 “잠자기 방지” 프로파일 설정은 전원에 연결되어 있을 때만 유휴 잠자기를 방지합니다. 이 설정을 켜면 배터리 사용 중에도 유휴 잠자기를 방지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindre systemhvile også på batteri, for profiler med «Hindre dvale» aktivert?\nSom standard hindrer profilinnstillingen «Hindre dvale» bare hvile når Maccen er koblet til strøm. Aktiver dette for å hindre hvile også på batteri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook op batterijstroom voorkomen dat het systeem in slaap valt, voor profielen waarvoor ‘Voorkom slaapstand’ is ingeschakeld?\nStandaard voorkomt de profielinstelling ‘Voorkom slaapstand’ alleen slaapstand door inactiviteit terwijl het apparaat op netstroom is aangesloten. Schakel dit in om dit ook op batterijstroom te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zapobiegać usypianiu systemu z powodu bezczynności także na baterii, dla profili z włączonym „Zapobiegaj uśpieniu”?\nDomyślnie ustawienie profilu „Zapobiegaj uśpieniu” zapobiega uśpieniu z powodu bezczynności tylko przy zasilaniu z sieci. Włącz, aby zapobiegać mu także na baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir o modo de repouso ocioso do sistema também na bateria, para perfis com “Impedir repouso” ativado?\nPor padrão, o ajuste de perfil “Impedir repouso” só impede o repouso ocioso enquanto conectado à energia. Ative isto para impedir o repouso ocioso também na bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предотвращать переход системы в спящий режим по бездействию также при работе от батареи, для профилей с включённым параметром «Предотвращать переход в спящий режим»?\nПо умолчанию параметр профиля «Предотвращать переход в спящий режим» предотвращает переход в спящий режим по бездействию только при питании от сети. Включите этот параметр, чтобы это действовало и при работе от батареи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabrániť nečinnému spánku systému aj na batériu pre profily so zapnutým nastavením „Zabrániť spánku“?\nPredvolene nastavenie profilu „Zabrániť spánku“ bráni nečinnému spánku iba pri pripojení k napájaniu. Zapnutím zabránite nečinnému spánku aj na batériu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se pri profilih z omogočeno možnostjo »Prepreči spanje« spanje zaradi nedejavnosti prepreči tudi na bateriji?\nPrivzeto nastavitev profila »Prepreči spanje« prepreči spanje zaradi nedejavnosti le ob priklopu na napajanje. Omogočite za preprečitev tudi na bateriji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhindra systemets viloläge vid inaktivitet även på batteri, för profiler med ”Förhindra vila” aktiverat?\nSom förval förhindrar profilinställningen ”Förhindra vila” bara viloläge vid inaktivitet när datorn är ansluten till elnätet. Aktivera det här för att även förhindra viloläge på batteri."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uykuyu engelle” etkin profiller için pilde de sistem boşta uykusu engellensin mi?\nVarsayılan olarak “Uykuyu engelle” profil ayarı yalnızca güce bağlıyken boşta uykuyu engeller. Pilde de engellemek için bunu etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn hệ thống ngủ khi không hoạt động cả khi dùng pin, với các hồ sơ bật “Ngăn ngủ”?\nTheo mặc định, cài đặt hồ sơ “Ngăn ngủ” chỉ ngăn ngủ khi không hoạt động lúc cắm điện. Bật tùy chọn này để cũng ngăn ngủ khi dùng pin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于启用了“防止睡眠”的配置文件，是否也禁止电池供电时的系统空闲休眠？\n默认情况下，“防止睡眠”配置仅能在连接电源时禁止空闲休眠。启用此功能可同时禁止电池供电时的空闲休眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於啟用「防止睡眠」的描述檔，使用電池時也防止系統閒置睡眠？\n依預設，「防止睡眠」描述檔設定只會在連接電源時防止閒置睡眠。啟用此設定可在使用電池時同樣防止閒置睡眠。"
          }
        }
      }
    },
    "AdvancedSetting.prioritizeSmartSelectionActions" : {
      "comment" : "Advanced setting: prioritizeSmartSelectionActions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolovat akce chytrého výběru před existujícími soubory při kliknutí s Cmd?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroller handlinger for smart markering før eksisterende arkiver ved Kommando-klik?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei ⌘-Klick Smart-Selection-Aktionen vor vorhandenen Dateien prüfen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check smart selection actions before existing files on cmd-click?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Comprobar las acciones de selección inteligente antes que los archivos existentes al hacer cmd-clic?"
          }
        },
        "fi" : {
