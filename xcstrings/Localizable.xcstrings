    "BrowserErrorHandler.CannotConnectMessage" : {
      "comment" : "Error message: cannot connect to host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemůže navázat zabezpečené připojení k serveru. Server může být vypnutý nebo nedostupný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke oprette en sikker forbindelse til serveren. Serveren kan være nede eller utilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann keine sichere Verbindung zum Server herstellen. Der Server ist möglicherweise nicht erreichbar oder offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can’t establish a secure connection to the server. The server may be down or unreachable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no puede establecer una conexión segura con el servidor. Puede que el servidor esté caído o inaccesible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei voi muodostaa suojattua yhteyttä palvelimeen. Palvelin voi olla pois käytöstä tai tavoittamattomissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne peut pas établir de connexion sécurisée avec le serveur. Le serveur est peut-être en panne ou inaccessible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non riesce a stabilire una connessione sicura con il server. Il server potrebbe essere inattivo o irraggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はサーバーとの安全な接続を確立できません。サーバーがダウンしているか、到達できない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 서버에 보안 연결을 설정할 수 없습니다. 서버가 다운되었거나 연결할 수 없는 상태일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke opprette en sikker tilkobling til tjeneren. Tjeneren kan være nede eller utilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan geen beveiligde verbinding met de server maken. De server is mogelijk uitgevallen of onbereikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie może nawiązać bezpiecznego połączenia z serwerem. Serwer może być wyłączony lub nieosiągalny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não consegue estabelecer uma conexão segura com o servidor. O servidor pode estar fora do ar ou inacessível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может установить безопасное соединение с сервером. Возможно, сервер недоступен или не работает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemôže nadviazať zabezpečené pripojenie k serveru. Server môže byť vypnutý alebo nedostupný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne more vzpostaviti varne povezave s strežnikom. Strežnik morda ne deluje ali ni dosegljiv."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan inte upprätta en säker anslutning till servern. Servern kan vara nere eller onåbar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 sunucuyla güvenli bir bağlantı kuramıyor. Sunucu çalışmıyor veya erişilemiyor olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 không thể thiết lập kết nối an toàn đến máy chủ. Máy chủ có thể đang ngừng hoạt động hoặc không thể truy cập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法建立与服务器的安全连接。服务器可能已关闭或不可访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法與伺服器建立安全連線。伺服器可能已關閉或無法連線。"
          }
        }
      }
    },
