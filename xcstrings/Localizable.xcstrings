    "CodeReviewPromptUpdate.ResetAction" : {
      "comment" : "What updating a code review system prompt that is a copy of an older default does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Prompt aktualisieren“ ersetzt ihn durch den aktuellen Standard, der dann auf dem neuesten Stand bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Update Prompt replaces it with the current default, which then stays up to date."
