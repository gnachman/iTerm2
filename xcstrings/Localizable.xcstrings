    "ClaudeCodeOnboarding.InstallWorkgroupDescription" : {
      "comment" : "Description of the install-workgroup onboarding step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainstalujte pracovní skupinu Claude Code, která seskupuje vaši hlavní relaci Claude se dvěma dalšími relacemi: prohlížečem rozdílů a relací revize kódu. Mezi nimi můžete přepínat jedním kliknutím.\n\nToto uspořádání můžete později upravit v části „Nastavení > Uspořádání > Pracovní skupiny“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Claude Code-arbejdsgruppen, som samler din hovedsession med Claude i to sessioner med ligestillede medlemmer: en diff-fremviser og en kodegennemgangssession. Du kan skifte mellem dem med ét klik.\n\nDu kan tilpasse dette layout senere i Indstillinger > Opstillinger > Arbejdsgrupper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert die Claude-Code-Arbeitsgruppe, die Ihre Haupt-Claude-Sitzung mit zwei weiteren Sitzungen gruppiert: einem Diff-Betrachter und einer Code-Review-Sitzung. Sie können mit einem Klick zwischen ihnen wechseln.\n\nSie können dieses Layout später unter Einstellungen > Anordnungen > Arbeitsgruppen anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install the Claude Code workgroup, which groups your main Claude session with two peer sessions: a diff viewer and a code-review session. You can switch between them with one click.\n\nYou can customize this layout later in Settings > Arrangements > Workgroups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala el grupo de trabajo de Claude Code, que agrupa tu sesión principal de Claude con dos sesiones pares: un visor de diferencias y una sesión de revisión de código. Puedes cambiar entre ellas con un clic.\n\nPuedes personalizar esta disposición más tarde en Ajustes > Disposiciones > Grupos de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asenna Claude Code -työryhmä, joka ryhmittelee pääasiallisen Claude-istuntosi kahden jäsenistunnon kanssa: erolukija ja koodikatselmointi-istunto. Voit vaihtaa niiden välillä yhdellä klikkauksella.\n\nVoit muokata tätä asettelua myöhemmin kohdassa Asetukset > Järjestelyt > Työryhmät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez le groupe de travail Claude Code, qui regroupe votre session Claude principale avec deux sessions paires : un afficheur de diff et une session de revue de code. Vous pouvez passer de l’une à l’autre en un clic.\n\nVous pourrez personnaliser cette disposition plus tard dans Réglages > Dispositions > Groupes de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa il gruppo di lavoro di Claude Code, che raggruppa la tua sessione principale di Claude con due sessioni pari: un visualizzatore di differenze e una sessione di revisione del codice. Puoi passare dall’una all’altra con un clic.\n\nPuoi personalizzare questa disposizione in seguito in Impostazioni > Disposizioni > Gruppi di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Codeワークグループをインストールします。これは、メインのClaudeセッションと2つのピアセッション（diffビューアとコードレビューセッション）をグループ化します。ワンクリックで切り替えることができます。\n\nこのレイアウトは、後で設定 > アレンジメント > ワークグループでカスタマイズできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 워크그룹을 설치합니다. 이 워크그룹은 기본 Claude 세션과 두 개의 동료 세션(diff 뷰어 및 코드 리뷰 세션)을 함께 묶습니다. 클릭 한 번으로 세션 간에 전환할 수 있습니다.\n\n나중에 설정 > 배치 > 워크그룹에서 이 레이아웃을 사용자화할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer Claude Code-arbeidsgruppen, som grupperer hovedøkten din for Claude med to medlemsøkter: en diff-visning og en kodegjennomgangsøkt. Du kan bytte mellom dem med ett klikk.\n\nDu kan tilpasse denne utformingen senere i «Innstillinger > Oppsett > Arbeidsgrupper»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer de werkgroep Claude Code, die je hoofdsessie van Claude groepeert met twee gelijkwaardige sessies: een diff-viewer en een codereviewsessie. Je kunt er met één klik tussen wisselen.\n\nJe kunt deze indeling later aanpassen in Instellingen > Indelingen > Werkgroepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj grupę roboczą Claude Code, która łączy twoją główną sesję Claude z dwoma innymi członkami grupy: przeglądarką różnic i sesją przeglądu kodu. Możesz przełączać się między nimi jednym kliknięciem.\n\nTen układ możesz później dostosować w: Ustawienia > Układy > Grupy robocze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o workgroup do Claude Code, que agrupa sua sessão principal do Claude com duas sessões pares: um visualizador de diferenças e uma sessão de revisão de código. Você pode alternar entre elas com um clique.\n\nVocê pode personalizar este layout mais tarde em Ajustes > Organizações > Workgroups."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите рабочую группу Claude Code, которая объединяет вашу основную сессию Claude с двумя равноправными сессиями: просмотром diff и сессией код-ревью. Между ними можно переключаться одним щелчком.\n\nЭту компоновку можно настроить позже в Settings > Arrangements > Workgroups."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainštalovať pracovnú skupinu Claude Code, ktorá zoskupuje vašu hlavnú reláciu Claude s dvoma ďalšími členmi: prehliadačom rozdielov a reláciou revízie kódu. Medzi nimi môžete prepínať jedným kliknutím.\n\nToto rozloženie môžete neskôr prispôsobiť v časti „Nastavenia > Usporiadania > Pracovné skupiny“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namestite delovno skupino Claude Code, ki združuje vašo glavno sejo Claude z dvema enakovrednima sejama: pregledovalnikom razlik in sejo za pregled kode. Med njimi preklapljate z enim klikom.\n\nTo razporeditev lahko pozneje prilagodite v »Nastavitve > Razporeditve > Delovne skupine«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera arbetsgruppen Claude Code, som grupperar din huvudsakliga Claude-session med två medlemssessioner: en diff-visare och en kodgranskningssession. Du kan växla mellan dem med ett klick.\n\nDu kan anpassa den här layouten senare under Inställningar > Arrangemang > Arbetsgrupper."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Claude oturumunuzu iki eş oturumla gruplayan Claude Code çalışma grubunu yükleyin: bir fark görüntüleyici ve bir kod incelemesi oturumu. Aralarında tek tıkla geçiş yapabilirsiniz.\n\nBu yerleşimi daha sonra Ayarlar > Düzenler > Çalışma Grupları bölümünden özelleştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt nhóm làm việc Claude Code, gộp phiên Claude chính của bạn với hai phiên ngang hàng: trình xem khác biệt và phiên xem xét mã. Bạn có thể chuyển đổi giữa chúng chỉ bằng một cú bấm.\n\nBạn có thể tùy chỉnh bố cục này sau trong Cài đặt > Bố cục > Nhóm làm việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Claude Code 工作组，它会将你的主 Claude 会话与两个对等会话分组：差异查看器和代码审查会话。你可以一键在它们之间切换。\n\n你之后可以在 设置 > Arrangements > 工作组 中自定义此布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝 Claude Code 工作群組，它會將你的主要 Claude 工作階段與兩個同儕工作階段組成群組：差異檢視器和程式碼審查工作階段。你可以一鍵在它們之間切換。\n\n你之後可以在「設定 > 排列 > 工作群組」中自訂此版面配置。"
          }
        }
      }
    },
