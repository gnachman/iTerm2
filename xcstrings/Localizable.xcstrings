    "ChatProviderBinding.ProviderMismatch" : {
      "comment" : "Error shown when the user tries to switch a chat to a model from a different AI provider",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat verwendet „%1$@“, und „%2$@“ gehört zu einem anderen KI-Anbieter. Ein Chat kann den Anbieter nach Beginn der Unterhaltung nicht mehr wechseln. Starten Sie einen neuen Chat, um „%3$@“ zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This chat uses “%1$@”, and “%2$@” belongs to a different AI provider. A chat cannot change providers once the conversation has started; start a new chat to use “%3$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat usa “%1$@”, y “%2$@” pertenece a otro proveedor de IA. Un chat no puede cambiar de proveedor una vez iniciada la conversación; inicia un chat nuevo para usar “%3$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce chat utilise « %1$@ », et « %2$@ » appartient à un autre fournisseur d’IA. Un chat ne peut pas changer de fournisseur une fois la conversation commencée ; démarrez un nouveau chat pour utiliser « %3$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chat usa “%1$@”, e “%2$@” appartiene a un altro provider IA. Una chat non può cambiare provider dopo l’inizio della conversazione; avvia una nuova chat per usare “%3$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは「%1$@」を使用しています。「%2$@」は別の AI プロバイダーに属しています。会話が開始された後はチャットのプロバイダーを変更できません。「%3$@」を使用するには新しいチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅은 “%1$@”을(를) 사용하며, “%2$@”은(는) 다른 AI 제공업체에 속합니다. 대화가 시작된 후에는 채팅의 제공업체를 변경할 수 없습니다. “%3$@”을(를) 사용하려면 새로운 채팅을 시작하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat usa “%1$@”, e “%2$@” pertence a um provedor de IA diferente. Um chat não pode trocar de provedor depois que a conversa começa; inicie um novo chat para usar “%3$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат использует «%1$@», а «%2$@» относится к другому поставщику ИИ. Чат не может сменить поставщика после начала беседы; чтобы использовать «%3$@», начните новый чат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet “%1$@” kullanıyor ve “%2$@” farklı bir YZ sağlayıcısına ait. Konuşma başladıktan sonra sohbetin sağlayıcısı değiştirilemez; “%3$@” kullanmak için yeni bir sohbet başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此聊天使用“%1$@”，而“%2$@”属于其他AI提供商。一旦对话开始，聊天无法更换提供商；请开始新对话以使用“%3$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此聊天使用「%1$@」，而「%2$@」屬於不同的 AI 供應商。對話開始後，聊天無法更換供應商；請開始新的聊天以使用「%3$@」。"
          }
        }
      }
    },
