    "EventTrigger.Help.Idle" : {
      "comment" : "Help text for the Idle (Silence) event trigger",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí se, když po zadanou dobu nepřijde žádný výstup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløses, når der ikke modtages output i det angivne tidsrum."
          }
        },
        "de" : {
          "stringUnit" : {
