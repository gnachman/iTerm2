    "AISafetyCheck.EnablePromptBody" : {
      "comment" : "Body of the prompt asking whether to enable command safety checking",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 může pomocí AI kontrolovat bezpečnost příkazů navržených vaším agentem AI. Chcete zapnout kontrolu bezpečnosti?\n\nPo zapnutí bude každý navržený příkaz odeslán vašemu nakonfigurovanému poskytovateli AI ke kontrole bezpečnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan bruge AI til at kontrollere sikkerheden af kommandoer, som din AI-agent foreslår. Vil du slå sikkerhedskontrol til?\n\nNår den er slået til, sendes hver foreslået kommando til din konfigurerede AI-udbyder med henblik på en sikkerhedskontrol."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann KI verwenden, um die Sicherheit von Befehlen zu überprüfen, die von Ihrem KI-Agenten vorgeschlagen werden. Möchten Sie die Sicherheitsüberprüfung aktivieren?\n\nWenn aktiviert, wird jeder vorgeschlagene Befehl zur Sicherheitsüberprüfung an Ihren konfigurierten KI-Anbieter gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can use AI to check the safety of commands suggested by your AI agent. Would you like to enable safety checking?\n\nWhen enabled, each proposed command will be sent to your configured AI provider for a safety check."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 puede usar IA para comprobar la seguridad de los comandos que sugiera tu agente de IA. ¿Quieres activar la comprobación de seguridad?\n\nSi la activas, cada comando propuesto se enviará a tu proveedor de IA configurado para una comprobación de seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 voi käyttää tekoälyä AI-agenttisi ehdottamien komentojen turvallisuuden tarkistamiseen. Haluatko ottaa turvallisuustarkistuksen käyttöön?\n\nKun se on käytössä, jokainen ehdotettu komento lähetetään määrittämällesi AI-palveluntarjoajalle turvallisuustarkistusta varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut utiliser l’IA pour vérifier la sécurité des commandes suggérées par votre agent IA. Voulez-vous activer la vérification de sécurité ?\n\nUne fois activée, chaque commande proposée sera envoyée à votre fournisseur d’IA configuré pour une vérification de sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può usare l’IA per verificare la sicurezza dei comandi suggeriti dal tuo agente IA. Vuoi abilitare il controllo di sicurezza?\n\nSe abilitato, ogni comando proposto verrà inviato al tuo provider IA configurato per un controllo di sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、AIエージェントが提案するコマンドの安全性をAIでチェックできます。安全性チェックを有効にしますか？\n\n有効にすると、提案された各コマンドが安全性チェックのために設定済みのAIプロバイダーに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 AI를 사용하여 AI 에이전트가 제안한 명령의 안전성을 검사할 수 있습니다. 안전성 검사를 켜겠습니까?\n\n켜면 제안된 각 명령이 안전성 검사를 위해 구성된 AI 제공업체에게 전송됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan bruke KI til å kontrollere sikkerheten til kommandoer som KI-agenten din foreslår. Vil du aktivere sikkerhetskontroll?\n\nNår dette er aktivert, sendes hver foreslåtte kommando til den konfigurerte KI-leverandøren din for en sikkerhetskontroll."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan AI gebruiken om de veiligheid te controleren van commando’s die je AI-agent voorstelt. Wil je veiligheidscontrole inschakelen?\n\nAls dit is ingeschakeld, wordt elk voorgesteld commando voor een veiligheidscontrole naar je geconfigureerde AI-aanbieder verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 może używać AI do sprawdzania bezpieczeństwa poleceń sugerowanych przez agenta AI. Czy chcesz włączyć sprawdzanie bezpieczeństwa?\n\nPo włączeniu każde proponowane polecenie będzie wysyłane do skonfigurowanego dostawcy AI w celu sprawdzenia bezpieczeństwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode usar IA para verificar a segurança dos comandos sugeridos pelo seu agente de IA. Deseja ativar a verificação de segurança?\n\nQuando ativada, cada comando proposto será enviado ao provedor de IA configurado para uma verificação de segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может использовать ИИ для проверки безопасности команд, предложенных вашим ИИ-агентом. Включить проверку безопасности?\n\nПри включении каждая предложенная команда будет отправляться настроенному поставщику ИИ для проверки безопасности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 môže pomocou AI kontrolovať bezpečnosť príkazov navrhnutých vaším agentom AI. Chcete zapnúť kontrolu bezpečnosti?\n\nPo zapnutí sa každý navrhnutý príkaz odošle na kontrolu bezpečnosti vášmu nastavenému poskytovateľovi AI."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 lahko z AI preveri varnost ukazov, ki jih predlaga vaš agent AI. Ali želite omogočiti preverjanje varnosti?\n\nČe je omogočeno, bo vsak predlagani ukaz poslan vašemu nastavljenemu ponudniku AI v preverjanje varnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan använda AI för att kontrollera säkerheten hos kommandon som din AI-agent föreslår. Vill du aktivera säkerhetskontroll?\n\nNär den är aktiverad skickas varje föreslaget kommando till din konfigurerade AI-leverantör för en säkerhetskontroll."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, YZ ajanınızın önerdiği komutların güvenliğini denetlemek için YZ kullanabilir. Güvenlik denetimini etkinleştirmek ister misiniz?\n\nEtkinleştirildiğinde, önerilen her komut güvenlik denetimi için yapılandırılmış YZ sağlayıcınıza gönderilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 có thể dùng AI để kiểm tra độ an toàn của các lệnh do tác tử AI của bạn đề xuất. Bạn có muốn bật kiểm tra an toàn không?\n\nKhi bật, mỗi lệnh được đề xuất sẽ được gửi đến nhà cung cấp AI bạn đã cấu hình để kiểm tra an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以使用 AI 检查你的 AI 智能体建议的命令是否安全。要启用安全检查吗？\n\n启用后，每条建议的命令都将发送给你配置的 AI 提供者进行安全检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以使用 AI 檢查你的 AI 代理程式所建議指令的安全性。要啟用安全檢查嗎？\n\n啟用後，每個建議的指令都會傳送給你設定的 AI 供應商進行安全檢查。"
          }
        }
      }
    },
