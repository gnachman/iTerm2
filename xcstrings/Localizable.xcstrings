    "TmuxController.UnsupportedOptionMessage" : {
      "comment" : "Error explaining that a tmux option is incompatible with iTerm2; %@ is the option name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Option „%@“ ist in tmux aktiviert. Sie ist nicht mit der iTerm2-tmux-Integration kompatibel. Bitte deaktivieren Sie sie und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “%@” option is turned on in tmux. It is not compatible with the iTerm2-tmux integration. Please disable it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción “%@” está activada en tmux. No es compatible con la integración de iTerm2 con tmux. Desactívala e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option « %@ » est activée dans tmux. Elle n’est pas compatible avec l’intégration iTerm2-tmux. Désactivez-la et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opzione “%@” è attiva in tmux. Non è compatibile con l’integrazione di iTerm2 con tmux. Disattivala e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxで「%@」オプションがオンになっています。これはiTerm2とtmuxの統合機能に対応していません。無効にしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux에서 “%@” 옵션이 켜져 있습니다. 이 옵션은 iTerm2-tmux 통합과 호환되지 않습니다. 옵션을 끄고 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção “%@” está ativada no tmux. Ela não é compatível com a integração iTerm2-tmux. Desative-a e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опция «%@» включена в tmux. Она несовместима с интеграцией iTerm2-tmux. Отключите её и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux’ta “%@” seçeneği açık. Bu seçenek iTerm2-tmux entegrasyonuyla uyumlu değil. Lütfen devre dışı bırakıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 中启用了“%@”选项。它与 iTerm2-tmux 集成不兼容。请将其停用后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 中已開啟「%@」選項，它與 iTerm2 的 tmux 整合不相容。請停用該選項後再試一次。"
          }
        }
      }
    },
