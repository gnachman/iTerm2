    "Companion.InstallExplanation.CompanionOnly" : {
      "comment" : "Explanatory paragraph on the companion-only setup screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies installiert das Begleit-Plugin und aktiviert die Kopplung mit dem Begleitgerät. Danach kann iTerm2 Daten von diesem Mac senden, jedoch nur mit Ihrer ausdrücklichen Zustimmung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This installs the Companion plugin and turns on companion device pairing. Afterward, iTerm2 can send data off this Mac, but only with your explicit consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto instala el plugin complementario y activa el emparejamiento de dispositivos complementarios. Después, iTerm2 podrá enviar datos fuera de este Mac, pero solo con tu consentimiento explícito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela installe le module Compagnon et active l’association d’appareils compagnons. Ensuite, iTerm2 pourra envoyer des données hors de ce Mac, mais seulement avec votre consentement explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo installa il plug-in associato e attiva l’associazione dei dispositivi. In seguito, iTerm2 potrà inviare dati fuori da questo Mac, ma solo con il tuo consenso esplicito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりCompanionプラグインがインストールされ、コンパニオンデバイスのペアリングが有効になります。以降、iTerm2はこのMacからデータを送信できるようになりますが、それはあなたの明示的な同意がある場合に限られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언 플러그인을 설치하고 컴패니언 기기 페어링을 켭니다. 그 후 iTerm2는 이 Mac 밖으로 데이터를 보낼 수 있지만, 사용자가 명시적으로 동의한 경우에만 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto instala o plugin do Companion e ativa o pareamento com dispositivos companheiros. Depois disso, o iTerm2 pode enviar dados para fora deste Mac, mas somente com seu consentimento explícito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устанавливает плагин Компаньон и включает сопряжение с устройством-компаньоном. После этого iTerm2 сможет отправлять данные с этого Mac, но только с вашего явного согласия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem eşlik eden eklentiyi yükler ve eşlik eden aygıt eşleştirmesini açar. Ardından iTerm2 bu Mac’ten veri gönderebilir, ancak yalnızca açık izninizle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将安装 Companion 插件并开启伴侣设备配对功能。之后，iTerm2 可以将数据发送到此 Mac 之外，但仅限在获得您明确同意的情况下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會安裝搭配外掛程式並開啟搭配裝置配對功能。之後，iTerm2 可以將資料傳送到這部 Mac 之外，但僅限於你明確同意的情況。"
          }
        }
      }
    },
    "Companion.InstallExplanation.Full" : {
      "comment" : "Explanatory paragraph on the full setup screen",
