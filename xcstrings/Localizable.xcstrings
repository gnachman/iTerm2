        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar un tamaño de letra personalizado para las etiquetas de pestaña?\nConsulta también el ajuste avanzado “Tamaño de letra personalizado de las etiquetas de pestañas”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser une taille de police personnalisée pour les libellés d’onglets ?\nVoir aussi le réglage avancé « Taille de police personnalisée des libellés d’onglets »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare una dimensione del font personalizzata per le etichette dei pannelli?\nVedi anche l’impostazione avanzata “Dimensione personalizzata del font delle etichette dei pannelli”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブラベルにカスタムフォントサイズを使用しますか？\n詳細設定の「カスタムタブラベルフォントサイズ」も参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 레이블에 사용자 지정 서체 크기를 사용하겠습니까?\n고급 설정의 “사용자 지정 탭 레이블 서체 크기”도 참고하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar tamanho de fonte personalizado para os rótulos das abas?\nVeja também o ajuste avançado “Tamanho de fonte personalizado do rótulo da aba”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать особый размер шрифта для подписей вкладок?\nСм. также дополнительный параметр «Особый размер шрифта подписи вкладки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme etiketleri için özel font boyutu kullanılsın mı?\nAyrıca bkz. “Özel sekme etiketi font boyutu” gelişmiş ayarı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自定义字体大小作为标签页标签？  \n参见高级设置“自定义标签页标签字体大小”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁標籤使用自訂字體大小？\n另請參閱進階設定「自訂標籤頁標籤字體大小」。"
          }
        }
      }
    },
    "AdvancedSetting.useDivorcedProfileToSplit" : {
      "comment" : "Advanced setting: useDivorcedProfileToSplit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Teilen eines Bereichs das Profil mit lokalen Änderungen verwenden, nicht das zugrunde liegende Profil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When splitting a pane, use the profile with local modifications, not the backing profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al dividir un panel, usa el perfil con modificaciones locales, no el perfil de respaldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la scission d’un volet, utiliser le profil avec les modifications locales et non le profil d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si divide un riquadro, usa il profilo con le modifiche locali, non il profilo di base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペインを分割する際、バッキングプロファイルではなく、ローカルで変更されたプロファイルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널을 분할할 때 원본 프로파일이 아닌 로컬에서 수정된 프로파일을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao dividir um painel, usar o perfil com modificações locais, não o perfil de origem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При разделении панели использовать профиль с локальными изменениями, а не исходный (базовый) профиль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölme bölünürken, destekleyen profil yerine yerel değişikliklere sahip profili kullan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割窗格时，使用带有本地修改的配置文件，而非背景配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割窗格時，使用含有本機修改的描述檔，而不是底層描述檔。"
          }
        }
      }
    },
    "AdvancedSetting.useDoubleClickDelayForCommandSelection" : {
      "comment" : "Advanced setting: useDoubleClickDelayForCommandSelection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten, um sicherzustellen, dass es kein Doppelklick ist, bevor ein Befehl ausgewählt wird"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wait to be sure it's not a double click before selecting a command"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperar para asegurarse de que no es un doble clic antes de seleccionar un comando"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendre pour s’assurer qu’il ne s’agit pas d’un double-clic avant de sélectionner une commande"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi per essere certo che non sia un doppio clic prima di selezionare un comando"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドを選択する前に、ダブルクリックでないことを確認するために待機します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 선택하기 전에 이중 클릭이 아닌지 확인될 때까지 대기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperar para ter certeza de que não é um clique duplo antes de selecionar um comando"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ждать, чтобы убедиться, что это не двойной клик, перед выбором команды"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir komutu seçmeden önce çift tıklama olmadığından emin olmak için bekle"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在选择命令前请等待确认不是双击操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取指令之前，先等待以確定不是按兩下"
          }
        }
      }
    },
    "AdvancedSetting.useExperimentalFontMetrics" : {
      "comment" : "Advanced setting: useExperimentalFontMetrics",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine theoretisch korrektere Methode zur Messung der Zeilenhöhe verwenden.\nSie müssen iTerm2 neu starten oder die Schriftgröße einer Sitzung anpassen, damit diese Änderung wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use a more theoretically correct technique to measure line height.\nYou must restart iTerm2 or adjust a session's font size for this change to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una técnica teóricamente más correcta para medir la altura de línea.\nDebes reiniciar iTerm2 o ajustar el tamaño de letra de una sesión para que este cambio surta efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser une technique plus correcte en théorie pour mesurer la hauteur de ligne.\nVous devez redémarrer iTerm2 ou ajuster la taille de police d’une session pour que cette modification prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una tecnica teoricamente più corretta per misurare l’altezza della riga.\nDevi riavviare iTerm2 o regolare la dimensione del font di una sessione affinché questa modifica abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行の高さを測定する際に、より理論的に正確な手法を使用します。\nこの変更を反映するには、iTerm2を再起動するか、セッションのフォントサイズを調整する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이론적으로 더 정확한 기법으로 행 높이를 측정합니다.\n이 변경 사항을 적용하려면 iTerm2를 재시작하거나 세션의 서체 크기를 조정해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar uma técnica teoricamente mais correta para medir a altura da linha.\nVocê deve reiniciar o iTerm2 ou ajustar o tamanho da fonte de uma sessão para que esta alteração tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать более теоретически корректный способ измерения высоты строки.\nЧтобы изменение вступило в силу, перезапустите iTerm2 или измените размер шрифта сеанса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satır yüksekliğini ölçmek için kuramsal olarak daha doğru bir teknik kullan.\nBu değişikliğin etkili olması için iTerm2’yi yeniden başlatmanız veya bir oturumun font boyutunu ayarlamanız gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用更理论正确的测量行高方法。  \n必须重启iTerm2或调整会话字体大小才能使此更改生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用理論上更正確的技術來測量行高。\n必須重新啟動 iTerm2 或調整工作階段的字體大小，此變更才會生效。"
          }
        }
      }
    },
    "AdvancedSetting.useGCDUpdateTimer" : {
      "comment" : "Advanced setting: useGCDUpdateTimer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GCD-basierten Aktualisierungstimer statt NSTimer verwenden.\nDies sollte zu regelmäßigeren Bildschirmaktualisierungen führen. Starten Sie iTerm2 nach Ändern dieser Einstellung neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use GCD-based update timer instead of NSTimer.\nThis should cause more regular screen updates. Restart iTerm2 after changing this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un temporizador de actualización basado en GCD en lugar de NSTimer.\nDebería producir actualizaciones de pantalla más regulares. Reinicia iTerm2 tras cambiar este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le minuteur de mise à jour basé sur GCD au lieu de NSTimer.\nCela devrait produire des mises à jour d’écran plus régulières. Redémarrez iTerm2 après avoir modifié ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un timer di aggiornamento basato su GCD invece di NSTimer.\nDovrebbe produrre aggiornamenti dello schermo più regolari. Riavvia iTerm2 dopo aver modificato questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NSTimerの代わりにGCDベースの更新タイマーを使用します。\nこれにより、画面の更新がより規則的になるはずです。この設定を変更した後はiTerm2を再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NSTimer 대신 GCD 기반 업데이트 타이머 사용.\n화면이 더 규칙적으로 업데이트됩니다. 이 설정을 변경한 후 iTerm2를 재시작하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um timer de atualização baseado em GCD em vez de NSTimer.\nIsso deve resultar em atualizações de tela mais regulares. Reinicie o iTerm2 após alterar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать таймер обновления на основе GCD вместо NSTimer.\nЭто должно сделать обновления экрана более регулярными. После изменения этого параметра перезапустите iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NSTimer yerine GCD tabanlı güncelleme zamanlayıcısı kullan.\nBu, daha düzenli ekran güncellemeleri sağlamalıdır. Bu ayarı değiştirdikten sonra iTerm2’yi yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用基于GCD的更新计时器代替NSTimer。  \n应实现更规律的屏幕更新。更改此设置后需重启iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用基於 GCD 的更新計時器，而不是 NSTimer。\n這應該會讓螢幕更新更規律。變更此設定後請重新啟動 iTerm2。"
          }
        }
      }
    },
    "AdvancedSetting.useLowPowerGPUWhenUnplugged" : {
      "comment" : "Advanced setting: useLowPowerGPUWhenUnplugged",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet der Metal-Renderer die integrierte GPU, wenn nicht am Stromnetz angeschlossen?\nDamit dies wirksam wird, müssen Sie „Metal-Renderer deaktivieren, wenn nicht am Stromnetz angeschlossen“ deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Metal renderer uses integrated GPU when not connected to power?\nFor this to be effective you must disable “Disable Metal renderer when not connected to power”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe el renderizador Metal usar la GPU integrada cuando no hay conexión a la corriente?\nPara que sea efectivo, debes desactivar “Desactivar el renderizador Metal cuando no hay conexión a la corriente”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur de rendu Metal utilise le GPU intégré lorsque l’appareil n’est pas branché sur secteur ?\nPour que ce soit efficace, vous devez désactiver « Désactiver le moteur de rendu Metal hors secteur »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore di rendering Metal usa la GPU integrata quando non collegato all’alimentazione?\nPer renderlo efficace devi disattivare “Disabilita il motore di rendering Metal quando non collegato all’alimentazione”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電源に接続されていないとき、Metalレンダラーは統合GPUを使用しますか？\nこれを有効にするには、「電源に接続されていないときにMetalレンダラーを無効にする」をオフにする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원에 연결되어 있지 않을 때 Metal 렌더러가 내장 GPU를 사용하도록 하겠습니까?\n이 설정이 적용되려면 “전원에 연결되어 있지 않을 때 Metal 렌더러 끄기”를 비활성화해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O renderizador Metal usa a GPU integrada quando não conectado à energia?\nPara que isso seja efetivo, você deve desativar “Desativar o renderizador Metal quando não conectado à energia”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать ли встроенный GPU для рендеринга Metal, когда питание не подключено?\nЧтобы это работало, нужно отключить параметр «Отключать рендерер Metal, когда питание не подключено»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güce bağlı değilken Metal işleyici tümleşik GPU kullansın mı?\nBunun etkili olması için “Güç bağlantısı kesildiğinde GPU işleyiciyi devre dışı bırak” seçeneğini devre dışı bırakmalısınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接电源时，Metal渲染器是否使用集成GPU？  \n要生效需禁用“未连接电源时禁用Metal渲染器”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未連接電源時，Metal 繪製器使用內建 GPU？\n若要生效，必須停用「未連接電源時停用 Metal 繪製器」。"
          }
        }
      }
    },
    "AdvancedSetting.useModernScrollWheelAccumulator" : {
      "comment" : "Advanced setting: useModernScrollWheelAccumulator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modernen Scrollrad-Akkumulator verwenden.\nDies sollte Mäuse mit Scrollrad besser unterstützen und sich natürlicher anfühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use modern scroll wheel accumulator.\nThis should support wheel mice better and feel more natural."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el acumulador moderno de la rueda de desplazamiento.\nDebería admitir mejor los ratones con rueda y sentirse más natural."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser l’accumulateur moderne de la molette de défilement.\nIl devrait mieux prendre en charge les souris à molette et donner une sensation plus naturelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l’accumulatore moderno della rotellina di scorrimento.\nDovrebbe supportare meglio i mouse a rotellina e risultare più naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モダンなスクロールホイールアキュムレーターを使用します。\nこれにより、ホイールマウスのサポートが向上し、より自然な操作感になるはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 스크롤 휠 누적 방식 사용.\n휠 마우스를 더 잘 지원하고 더 자연스럽게 느껴집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o acumulador moderno da roda de rolagem.\nIsso deve dar melhor suporte a mouses com roda e parecer mais natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать современный накопитель прокрутки колёсиком мыши.\nЭто должно лучше поддерживать мыши с колёсиком и ощущаться более естественно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern kaydırma tekerleği biriktiricisini kullan.\nBu, tekerlekli fareleri daha iyi desteklemeli ve daha doğal hissettirmelidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用现代滚动滚轮累积值。  \n应更好地支持滚轮鼠标，并提供更自然的体验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用現代捲動滾輪累加器。\n這應能更好地支援滾輪滑鼠，並讓手感更自然。"
          }
        }
      }
    },
    "AdvancedSetting.useMultiPassUnderlineRenderer" : {
      "comment" : "Advanced setting: useMultiPassUnderlineRenderer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrstufigen Unterstreichungs-Renderer verwenden?\nBehebt Lücken in Unterstreichungen bei Schriften mit Ligaturen. Erfordert einen Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use multi-pass underline renderer?\nFixes underline gaps with ligature fonts. Requires restart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar el renderizador de subrayado multipasada?\nCorrige los huecos en los subrayados con tipos de letra con ligaduras. Requiere reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le moteur de rendu de soulignement multipasse ?\nCorrige les interruptions de soulignement avec les polices à ligatures. Nécessite un redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare il motore di rendering delle sottolineature a più passate?\nRisolve gli spazi vuoti nelle sottolineature con i font a legature. Richiede il riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マルチパス方式の下線レンダラーを使用しますか？\n合字フォントでの下線の途切れを修正します。再起動が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다중 패스 밑줄 렌더러를 사용하겠습니까?\n합자 서체에서 밑줄이 끊기는 문제를 수정합니다. 재시작해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o renderizador de sublinhado de múltiplas passagens?\nCorrige lacunas de sublinhado com fontes com ligaduras. Requer reinicialização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать многопроходный рендерер подчёркивания?\nИсправляет разрывы в подчёркивании при использовании шрифтов с лигатурами. Требует перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok geçişli alt çizgi işleyici kullanılsın mı?\nBitişik harfli fontlarda alt çizgi boşluklarını düzeltir. Yeniden başlatma gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用多通道下划线渲染器？  \n可修复带连字字体时的下划线间隙问题。需要重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用多重遍歷底線繪製器？\n修正使用連字字體時底線出現間隙的問題。需要重新啟動。"
          }
        }
      }
    },
    "AdvancedSetting.useNewContentFormat" : {
      "comment" : "Advanced setting: useNewContentFormat",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbegrenzte Menge an Fensterinhalten speichern.\nDies wird langsam sein, es sei denn, Sie aktivieren auch die SQLite-basierte Fensterwiederherstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save unlimited amount of window contents.\nThis is going to be slow unless you enable SQLite-based window restoration too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una cantidad ilimitada de contenido de ventanas.\nSerá lento a menos que actives también la restauración de ventanas basada en SQLite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer une quantité illimitée de contenu de fenêtre.\nCela sera lent, sauf si vous activez aussi la restauration des fenêtres basée sur SQLite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva una quantità illimitata di contenuto delle finestre.\nSarà lento a meno che tu non abiliti anche il ripristino delle finestre basato su SQLite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウの内容を無制限に保存します。\nSQLiteベースのウィンドウ復元も有効にしない限り、動作が遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 내용을 무제한으로 저장\nSQLite 기반 윈도우 복원도 함께 켜지 않으면 느려집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar uma quantidade ilimitada de conteúdo de janela.\nIsso será lento a menos que você também ative a restauração de janelas baseada em SQLite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять неограниченный объём содержимого окна.\nЭто будет медленно работать, если также не включить восстановление окон на основе SQLite."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınırsız miktarda pencere içeriğini kaydet.\nSQLite tabanlı pencere geri yüklemeyi de etkinleştirmedikçe bu yavaş olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存无限量的窗口内容。\n除非同时启用基于 SQLite 的窗口恢复功能，否则这会很慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存不限量的視窗內容。\n除非同時啟用基於 SQLite 的視窗回復，否則這會很慢。"
          }
        }
      }
    },
    "AdvancedSetting.useOldStyleDropDownViews" : {
