    "Companion.SetupFailed.AIModelCannotAuthenticate" : {
      "comment" : "Error shown when the companion setup wizard installed its plugins but the AI model still cannot authenticate with the entered API key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI- und Begleit-Plugins wurden installiert, aber das KI-Modell ist nicht für die Verwendung des eingegebenen API-Schlüssels konfiguriert. Überprüfen Sie den Anbieter und das KI-Modell unter Einstellungen > Allgemein > KI und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI and companion plugins were installed, but the AI model is not configured to use the API key you entered. Check the provider and the AI model in Settings > General > AI, then try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプラグインとコンパニオンプラグインはインストールされましたが、AIモデルが入力したAPIキーを使用するように設定されていません。設定 > 一般 > AIでプロバイダーとAIモデルを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 및 컴패니언 플러그인은 설치되었지만 AI 모델이 입력한 API 키를 사용하도록 구성되지 않았습니다. 설정 > 일반 > AI에서 제공업체와 AI 모델을 확인한 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os plugins de IA e do Companion foram instalados, mas o modelo de IA não está configurado para usar a chave de API que você digitou. Verifique o provedor e o modelo de IA em Ajustes > Geral > IA e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины ИИ и Компаньон установлены, но модель ИИ не настроена на использование введённого вами ключа API. Проверьте поставщика и модель ИИ в Настройки > Общие > ИИ, затем повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 插件和 Companion 插件已安装，但 AI 模型未配置为使用您输入的 API 密钥。请在“设置 > 通用 > AI”中检查提供商和 AI 模型，然后重试。"
          }
        }
      }
    },
