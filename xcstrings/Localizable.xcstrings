    "OnePassword.NotFoundMessage" : {
      "comment" : "Explanation shown when the 1Password CLI is missing or too old; placeholder is the minimum required version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password CLI nebylo nalezeno nebo je starší než požadovaná verze %@. Zkontrolujte, zda je nainstalována aktuální verze op."
          }
        },
        "da" : {
          "stringUnit" : {
