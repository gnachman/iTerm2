    "Tip.0030.Body" : {
      "comment" : "Tip of the day body, id 0030",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können die regulären Ausdrücke der Intelligenten Auswahl unter „Einstellungen > Profile > Erweitert > Intelligente Auswahl“ bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can edit Smart Selection regular expressions in “Settings > Profiles > Advanced > Smart Selection.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes editar las expresiones regulares de la selección inteligente en “Ajustes > Perfiles > Avanzado > Selección inteligente”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier les expressions régulières de la sélection intelligente dans « Réglages > Profils > Avancé > Sélection intelligente »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi modificare le espressioni regolari della selezione intelligente in “Impostazioni > Profili > Avanzate > Selezione intelligente”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > 詳細 > スマート選択」で、スマート選択の正規表現を編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 선택 정규 표현식은 “설정 > 프로파일 > 고급 > 스마트 선택”에서 편집할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode editar as expressões regulares da Seleção inteligente em “Ajustes > Perfis > Avançado > Seleção inteligente”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярные выражения умного выделения можно редактировать в «Настройки > Профили > Дополнительные > Умное выделение»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı Seçim düzenli ifadelerini “Ayarlar > Profiller > Gelişmiş > Akıllı Seçim” bölümünde düzenleyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在“Settings > Profiles > Advanced > Smart Selection”中编辑智能选取的正则表达式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在「設定 > 描述檔 > 進階 > 智慧型選取」中編輯智慧型選取的正規表示式。"
          }
        }
      }
    },
