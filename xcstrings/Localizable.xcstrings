    "Tip.0043.Body" : {
      "comment" : "Tip of the day body, id 0043",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Größe geteilter Bereiche über die Tastatur mit ^⌘-Pfeiltaste an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Resize split panes with the keyboard using ^⌘-Arrow Key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el tamaño de los paneles divididos con el teclado usando ^⌘ y una tecla de flecha."
          }
        },
        "fr" : {
