          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye las sesiones en ejecución que se crearon a partir de un perfil que se ha eliminado desde entonces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisältää käynnissä olevat istunnot, jotka on luotu profiilista, joka on sittemmin poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
