    "AIModelEditor.InvalidHeaderName" : {
      "comment" : "Validation error for an invalid custom HTTP header name; %@ is the name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der benutzerdefinierte Header-Name „%@“ ist ungültig. Verwenden Sie nur RFC-7230-Token-Zeichen (Buchstaben, Ziffern und die Zeichen !#$%%&'*+-.^_`|~)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom header name “%@” is not valid. Use only RFC 7230 token characters (letters, digits, and any of !#$%%&'*+-.^_`|~)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de encabezado personalizado “%@” no es válido. Usa solo caracteres de token de RFC 7230 (letras, dígitos y cualquiera de !#$%%&'*+-.^_`|~)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d’en-tête personnalisé « %@ » n’est pas valide. Utilisez uniquement des caractères de jeton RFC 7230 (lettres, chiffres et l’un de !#$%%&'*+-.^_`|~)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome di intestazione personalizzata “%@” non è valido. Usa solo caratteri token RFC 7230 (lettere, cifre e uno qualsiasi tra !#$%%&'*+-.^_`|~)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムヘッダー名「%@」は無効です。RFC 7230のトークン文字（英数字、および !#$%%&'*+-.^_`|~ のいずれか）のみを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 헤더 이름 “%@”이(가) 유효하지 않습니다. RFC 7230 토큰 문자(문자, 숫자 및 !#$%%&'*+-.^_`|~ 중 하나)만 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de cabeçalho personalizado “%@” não é válido. Use apenas caracteres de token do RFC 7230 (letras, dígitos e qualquer um de !#$%%&'*+-.^_`|~)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользовательского заголовка «%@» недопустимо. Используйте только символы токена RFC 7230 (буквы, цифры и любые из !#$%%&'*+-.^_`|~)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” özel üst bilgi adı geçerli değil. Yalnızca RFC 7230 token karakterlerini kullanın (harfler, rakamlar ve !#$%%&'*+-.^_`|~ karakterlerinden herhangi biri)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义标题“%@”无效。仅可使用RFC 7230令牌字符（字母、数字以及!#$%%&'*+-.^_`|~）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂標頭名稱「%@」無效。僅可使用 RFC 7230 token 字元（字母、數字，以及 !#$%%&'*+-.^_`|~ 其中任一個）。"
          }
        }
      }
    },
    "AIModelEditor.InvalidHeaderValue" : {
      "comment" : "Validation error for an invalid custom HTTP header value; %@ is the header name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wert für den benutzerdefinierten Header „%@“ darf keine Zeilenumbruch- oder Null-Zeichen enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The value for custom header “%@” must not contain newline or null characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor del encabezado personalizado “%@” no debe contener saltos de línea ni caracteres nulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur de l’en-tête personnalisé « %@ » ne doit pas contenir de saut de ligne ni de caractère nul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore dell’intestazione personalizzata “%@” non deve contenere caratteri di nuova riga o nulli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムヘッダー「%@」の値には、改行文字やヌル文字を含めることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 헤더 “%@”의 값에는 줄바꿈 문자나 null 문자가 포함될 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor do cabeçalho personalizado “%@” não pode conter caracteres de nova linha ou nulos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение пользовательского заголовка «%@» не должно содержать символы новой строки или null."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” özel üst bilgisinin değeri satır sonu veya null karakterleri içermemelidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义标题“%@”的值不得包含换行或空字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂標頭「%@」的值不得包含換行或空字元。"
          }
        }
      }
    },
