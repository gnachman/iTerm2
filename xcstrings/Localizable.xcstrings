          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインの区切り線のカスタム幅（1〜5ポイント）。デフォルトの幅を使用するには0を設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 패널 구분선의 사용자 지정 너비(포인트, 1~5). 기본 너비를 사용하려면 0으로 설정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura personalizada para os divisores de painéis em pontos (1-5). Defina como 0 para usar a largura padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательская ширина разделителей панелей в пунктах (1–5). Укажите 0, чтобы использовать ширину по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
