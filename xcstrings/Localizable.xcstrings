    "MenuTip.Edit.Snippets" : {
      "comment" : "Menu item help for the ‘Edit.Snippets’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úryvky jsou kusy textu, které si uložíte pro pozdější opakované použití. Hodí se pro často používané příkazy, adresáře, které se těžko pamatují, a mnoho dalšího."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekststykker er stykker tekst, du gemmer til senere brug. De er perfekte til hyppigt brugte kommandoer, mapper der er svære at huske, og meget mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippets sind Textstücke, die Sie speichern, um sie später wiederzuverwenden. Sie eignen sich hervorragend für häufig verwendete Befehle, schwer zu merkende Verzeichnisse und vieles mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Snippets are pieces of text that you save to reuse later. They’re great for frequently used commands, hard-to-remember directories, and much more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fragmentos son trozos de texto que guardas para reutilizarlos más tarde. Son ideales para comandos de uso frecuente, directorios difíciles de recordar y mucho más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katkelmat ovat tekstinpätkiä, jotka tallennat käytettäväksi myöhemmin uudelleen. Ne sopivat erinomaisesti usein käytetyille komennoille, vaikeasti muistettaville hakemistoille ja moneen muuhun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extraits sont des morceaux de texte que vous enregistrez pour les réutiliser plus tard. Ils sont idéaux pour les commandes fréquentes, les répertoires difficiles à retenir, et bien plus encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I frammenti sono pezzi di testo che salvi per riutilizzarli in seguito. Sono ideali per i comandi usati di frequente, le directory difficili da ricordare e molto altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペットは、後で再利用するために保存するテキストの断片です。よく使うコマンドや覚えにくいディレクトリなど、さまざまな用途に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스니펫은 나중에 다시 사용하기 위해 저장해 두는 텍스트 조각입니다. 자주 사용하는 명령, 기억하기 어려운 디렉토리 등에 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstbiter er tekststykker du lagrer for å bruke dem senere. De passer godt for ofte brukte kommandoer, mapper som er vanskelige å huske, og mye mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmenten zijn stukjes tekst die je bewaart om later opnieuw te gebruiken. Ze zijn ideaal voor vaak gebruikte commando’s, moeilijk te onthouden mappen en nog veel meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmenty kodu to kawałki tekstu zapisywane do późniejszego użycia. Świetnie nadają się do często używanych poleceń, trudnych do zapamiętania katalogów i wielu innych rzeczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmentos são pedaços de texto que você salva para reutilizar mais tarde. São ótimos para comandos usados com frequência, diretórios difíceis de lembrar e muito mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сниппеты представляют собой фрагменты текста, которые вы сохраняете для повторного использования. Они отлично подходят для часто используемых команд, труднозапоминаемых каталогов и многого другого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úryvky sú kúsky textu, ktoré si uložíte na neskoršie použitie. Hodia sa na často používané príkazy, ťažko zapamätateľné adresáre a mnoho ďalšieho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izrezki so deli besedila, ki jih shranite za poznejšo uporabo. Odlično so primerni za pogosto uporabljene ukaze, težko zapomljive imenike in še veliko več."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textsnuttar är textstycken som du sparar för att använda igen senare. De passar utmärkt för ofta använda kommandon, svårkomna kataloger och mycket mer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçacıklar, daha sonra yeniden kullanmak üzere kaydettiğiniz metin parçalarıdır. Sık kullanılan komutlar, hatırlaması zor dizinler ve daha fazlası için idealdir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đoạn mã là những đoạn văn bản bạn lưu để dùng lại sau. Chúng rất hữu ích cho các lệnh dùng thường xuyên, thư mục khó nhớ và nhiều thứ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snippets是保存的文本片段，可供后续重复使用。非常适合用于常用命令、难以记忆的目录等场景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段是你儲存起來以供日後重複使用的文字。非常適合經常使用的指令、難以記住的目錄等等。"
          }
        }
      }
    },
    "MenuTip.EngageArtificialIntelligence" : {
      "comment" : "Menu item help for the ‘Engage Artificial Intelligence’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při výběru na výzvě příkazového řádku (pokud je nainstalována integrace shellu) nebo v editoru příkazů se aktuální příkaz odešle nastavenému systému AI spolu s promptem pro vygenerování příkazu. Pokud nezadáte žádný vstup, budete požádáni o pokyny. Vygenerovaný příkaz se vloží do editoru příkazů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den vælges ved en shell-prompt (hvis Shell-integration er installeret) eller i kommandoeditoren, sender den den aktuelle kommando til det konfigurerede AI-system sammen med en prompt om at generere en kommando. Hvis der ikke er noget input, bliver du bedt om at give instruktioner. Den genererede kommando placeres i kommandoeditoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies an einer Shell-Eingabeaufforderung (sofern Shell Integration installiert ist) oder im Composer ausgewählt wird, sendet es den aktuellen Befehl zusammen mit einer Aufforderung an das konfigurierte KI-System, damit dieses einen Befehl generiert. Wird keine Eingabe bereitgestellt, werden Sie gebeten, Anweisungen zu geben. Der generierte Befehl wird in den Composer eingefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When selected at a shell prompt (provided Shell Integration is installed) or in the Composer, it sends the current command to the configured AI system along with a prompt for it to generate a command. If no input is provided, you’ll be asked to give instructions. The generated command goes into the Composer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se selecciona en un prompt del shell (si la integración con el shell está instalada) o en el compositor, envía el comando actual al sistema de IA configurado junto con un prompt para que genere un comando. Si no hay ninguna entrada, se te pedirá que des instrucciones. El comando generado va al compositor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä valitaan komentotulkin kehotteessa (jos komentotulkki-integraatio on asennettu) tai komentoeditorissa, nykyinen komento lähetetään määritetylle AI-järjestelmälle yhdessä kehotteen kanssa, jonka avulla se luo komennon. Jos syötettä ei ole, sinua pyydetään antamaan ohjeet. Luotu komento siirtyy komentoeditoriin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est choisie à l’invite du shell (si l’intégration du shell est installée) ou dans le compositeur, elle envoie la commande actuelle au système d’IA configuré, accompagnée d’un prompt lui demandant de générer une commande. Si aucune saisie n’est fournie, des instructions vous seront demandées. La commande générée est placée dans le compositeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se selezionato al prompt della shell (con l’integrazione shell installata) o nel compositore, invia il comando corrente al sistema IA configurato insieme a un prompt per generare un comando. Se non viene fornito alcun input, ti verranno chieste le istruzioni. Il comando generato viene inserito nel compositore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルプロンプトで（Shell Integrationがインストールされている場合）、またはコンポーザーで選択すると、現在のコマンドが、コマンドを生成するためのプロンプトとともに設定済みのAIシステムに送信されます。入力がない場合は、指示の入力を求められます。生成されたコマンドはコンポーザーに入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 프롬프트(셸 통합이 설치된 경우) 또는 컴포저에서 선택하면 현재 명령을 명령 생성 요청 프롬프트와 함께 구성된 AI 시스템으로 보냅니다. 입력이 없으면 지시 사항을 입력하라는 요청이 표시됩니다. 생성된 명령은 컴포저에 들어갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette velges på en ledetekst i skallet (forutsatt at skallintegrering er installert) eller i kommandoskriveren, sendes den gjeldende kommandoen til det konfigurerte KI-systemet sammen med en prompt om å lage en kommando. Hvis ingen inndata er oppgitt, blir du bedt om å gi instruksjoner. Den genererte kommandoen havner i kommandoskriveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit kiest bij een shell-prompt (mits shell-integratie is geïnstalleerd) of in de opsteller, wordt het huidige commando samen met een prompt om een commando te genereren naar het ingestelde AI-systeem gestuurd. Als er geen invoer is, word je om instructies gevraagd. Het gegenereerde commando komt in de opsteller."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane przy znaku zachęty powłoki (jeśli zainstalowano integrację z powłoką) lub w edytorze poleceń, wysyła bieżące polecenie do skonfigurowanego systemu AI wraz z promptem do wygenerowania polecenia. Jeśli nie podano danych wejściowych, zostaniesz poproszony o instrukcje. Wygenerowane polecenie trafia do edytora poleceń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selecionado em um prompt do shell (desde que a Shell Integration esteja instalada) ou no Compositor, envia o comando atual ao sistema de IA configurado junto com uma instrução para que ele gere um comando. Se nenhuma entrada for fornecida, será solicitado que você forneça instruções. O comando gerado vai para o Compositor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При выборе в строке приглашения оболочки (если установлена Shell Integration) или в Композере текущая команда отправляется в настроенную систему ИИ вместе с запросом на генерацию команды. Если ввод не указан, вам будет предложено дать инструкции. Сгенерированная команда попадает в Композер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď túto možnosť vyberiete vo výzve shellu (ak je nainštalovaná Integrácia shellu) alebo v Editore príkazov, aktuálny príkaz sa odošle nastavenému systému AI spolu s promptom na vygenerovanie príkazu. Ak nezadáte žiadny vstup, budete požiadaní o pokyny. Vygenerovaný príkaz sa vloží do Editora príkazov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je izbrano pri ukaznem pozivu lupine (če je nameščena integracija lupine) ali v urejevalniku ukazov, trenutni ukaz skupaj s pozivom za ustvarjanje ukaza pošlje konfiguriranemu sistemu AI. Če vnosa ni, boste pozvani, naj podate navodila. Ustvarjeni ukaz se prikaže v urejevalniku ukazov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det väljs vid en skalprompt (om skalintegrering är installerad) eller i kommandoredigeraren skickas det aktuella kommandot till det konfigurerade AI-systemet tillsammans med en prompt för att generera ett kommando. Om ingen indata finns uppmanas du att ge instruktioner. Det genererade kommandot hamnar i kommandoredigeraren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kabuk isteminde (Kabuk Entegrasyonu yüklüyse) veya Oluşturucu’da seçildiğinde, geçerli komutu bir komut üretmesi için istemle birlikte yapılandırılmış YZ sistemine gönderir. Girdi yoksa sizden yönerge istenir. Üretilen komut Oluşturucu’ya gider."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được chọn tại dấu nhắc shell (nếu đã cài Tích hợp shell) hoặc trong Trình soạn lệnh, nó gửi lệnh hiện tại đến hệ thống AI đã cấu hình cùng một lời nhắc để tạo lệnh. Nếu không có đầu vào, bạn sẽ được yêu cầu đưa ra hướng dẫn. Lệnh được tạo sẽ được đưa vào Trình soạn lệnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当在 shell 提示符下选中时（需安装 Shell Integration），或在 Composer 中，它会将当前命令及提示词发送给配置的 AI 系统以生成新命令。若未提供输入，则会要求您给出说明。生成的命令会保存到 Composer 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 shell 提示符號處（需已安裝 Shell 整合）或在編寫器中選取時，它會將目前的指令連同提示詞傳送給已設定的 AI 系統，以產生指令。若未提供輸入，系統會要求你提供指示。產生的指令會放入編寫器。"
          }
        }
      }
    },
    "MenuTip.ExplainOutputwithAI" : {
      "comment" : "Menu item help for the ‘Explain Output with AI’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je určeno k použití na výzvě příkazového řádku po provedení příkazu. Vyžaduje integraci shellu. Výstup předchozího (nebo vybraného) příkazu se odešle AI, která výstup okomentuje a otevře okno chatu pro další diskusi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er beregnet til brug ved shell-prompten efter en kommando er kørt. Den kræver Shell-integration. Outputtet fra den foregående (eller markerede) kommando sendes til AI, som annoterer outputtet og åbner et chatvindue til videre drøftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist für die Verwendung an der Shell-Eingabeaufforderung nach dem Ausführen eines Befehls gedacht. Es erfordert Shell Integration. Die Ausgabe des vorherigen (oder ausgewählten) Befehls wird an die KI gesendet, die die Ausgabe kommentiert und ein Chat-Fenster für weitere Diskussionen öffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is meant to be used at the shell prompt after executing a command. It requires Shell Integration. The output of the preceding (or selected) command is sent to AI, which annotates the output and opens a chat window for further discussion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está pensado para usarse en el prompt del shell después de ejecutar un comando. Requiere la integración con el shell. La salida del comando anterior (o seleccionado) se envía a la IA, que anota la salida y abre una ventana de chat para seguir conversando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on tarkoitettu käytettäväksi komentotulkin kehotteessa komennon suorittamisen jälkeen. Se vaatii komentotulkki-integraation. Edellisen (tai valitun) komennon tuloste lähetetään AI:lle, joka merkitsee tulosteeseen huomautuksia ja avaa keskusteluikkunan jatkokeskustelua varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette option est destinée à être utilisée à l’invite du shell après l’exécution d’une commande. Elle nécessite l’intégration du shell. La sortie de la commande précédente (ou sélectionnée) est envoyée à l’IA, qui l’annote et ouvre une fenêtre de chat pour poursuivre la discussion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È pensato per essere usato al prompt della shell dopo l’esecuzione di un comando. Richiede l’integrazione shell. L’output del comando precedente (o selezionato) viene inviato all’IA, che lo annota e apre una finestra di chat per ulteriori approfondimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは、コマンドを実行した後にシェルプロンプトで使用することを想定しています。Shell Integrationが必要です。直前の（または選択した）コマンドの出力がAIに送信され、AIが出力に注釈を付け、さらに議論するためのチャットウインドウを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 실행한 후 셸 프롬프트에서 사용하기 위한 기능입니다. 셸 통합이 필요합니다. 이전(또는 선택한) 명령의 출력이 AI로 전송되며, AI가 출력에 주석을 달고 추가 논의를 위한 채팅 윈도우를 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er ment for bruk på ledeteksten etter at du har kjørt en kommando. Det krever skallintegrering. Utdataene fra den forrige (eller markerte) kommandoen sendes til KI, som kommenterer utdataene og åpner et chatvindu for videre samtale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze functie is bedoeld voor gebruik bij de shell-prompt na het uitvoeren van een commando. Shell-integratie is vereist. De uitvoer van het voorgaande (of geselecteerde) commando wordt naar AI gestuurd, die de uitvoer annoteert en een chatvenster opent voor verdere bespreking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta funkcja jest przeznaczona do użycia przy znaku zachęty powłoki po wykonaniu polecenia. Wymaga integracji z powłoką. Dane wyjściowe poprzedniego (lub zaznaczonego) polecenia są wysyłane do AI, które je opisuje i otwiera okno czatu do dalszej rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto deve ser usado no prompt do shell após executar um comando. Requer a Shell Integration. A saída do comando anterior (ou selecionado) é enviada à IA, que anota a saída e abre uma janela de bate-papo para discussão adicional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это предназначено для использования в строке приглашения оболочки после выполнения команды. Требуется Shell Integration. Вывод предыдущей (или выделенной) команды отправляется в ИИ, который аннотирует вывод и открывает окно чата для дальнейшего обсуждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je určené na použitie vo výzve shellu po vykonaní príkazu. Vyžaduje Integráciu shellu. Výstup predchádzajúceho (alebo vybraného) príkazu sa odošle AI, ktorá ho okomentuje a otvorí okno chatu na ďalšiu diskusiu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namenjeno je uporabi pri ukaznem pozivu lupine po izvedbi ukaza. Zahteva integracijo lupine. Izhod prejšnjega (ali izbranega) ukaza se pošlje AI, ki izhod opremi z opombami in odpre okno klepeta za nadaljnji pogovor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsett att användas vid skalprompten efter att ett kommando har körts. Kräver skalintegrering. Utdata från det föregående (eller markerade) kommandot skickas till AI, som kommenterar utdata och öppnar ett chattfönster för fortsatt diskussion."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bir komut çalıştırıldıktan sonra kabuk isteminde kullanılmak içindir. Kabuk Entegrasyonu gerektirir. Önceki (veya seçili) komutun çıktısı YZ’ye gönderilir; YZ çıktıya not ekler ve daha fazla tartışma için bir sohbet penceresi açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng này dùng tại dấu nhắc shell sau khi thực thi một lệnh. Yêu cầu Tích hợp shell. Đầu ra của lệnh trước đó (hoặc lệnh được chọn) được gửi đến AI, AI sẽ chú thích đầu ra và mở cửa sổ trò chuyện để thảo luận thêm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能可在执行命令后的 shell 提示符下使用，需安装 Shell Integration。之前执行的（或选中的）命令输出会被发送给 AI，AI会注释该输出并打开聊天窗口用于进一步讨论。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此功能適合在執行指令後於 shell 提示符號處使用，且需要 Shell 整合。前一個（或所選）指令的輸出會傳送給 AI，AI 會為輸出加上註解，並打開聊天視窗供進一步討論。"
          }
        }
      }
    },
    "MenuTip.ExportScript" : {
      "comment" : "Menu item help for the ‘Export Script’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete sdílet skripty rozhraní Python API, můžete je exportovat do souboru `.its`. Pokud máte ve svazku klíčů certifikát pro podepisování kódu a soukromý klíč, můžete soubor `.its` také podepsat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil dele Python API-instrukser, kan du eksportere dem til et `.its`-arkiv. Hvis du har et kodesigneringscertifikat og en privat nøgle i din nøglering, kan du også signere `.its`-arkivet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Python-API-Skripte teilen möchten, können Sie sie in eine `.its`-Datei exportieren. Wenn Sie über ein Codesignatur-Zertifikat und einen privaten Schlüssel in Ihrem Schlüsselbund verfügen, können Sie die `.its`-Datei auch signieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you want to share Python API scripts, you can export them to an `.its` file. If you have a code signing certificate and private key in your Keychain, you can also sign the `.its` file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres compartir scripts de la API de Python, puedes exportarlos a un archivo `.its`. Si tienes un certificado de firma de código y una clave privada en tu llavero, también puedes firmar el archivo `.its`."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat jakaa Python API -skriptejä, voit viedä ne `.its`-tiedostoon. Jos avainnipussasi on koodin allekirjoitusvarmenne ja yksityinen avain, voit myös allekirjoittaa `.its`-tiedoston."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous voulez partager des scripts de l’API Python, vous pouvez les exporter dans un fichier `.its`. Si votre trousseau contient un certificat de signature de code et une clé privée, vous pouvez aussi signer le fichier `.its`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuoi condividere gli script dell’API Python, puoi esportarli in un file `.its`. Se hai un certificato di firma del codice e la relativa chiave privata nel portachiavi, puoi anche firmare il file `.its`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python APIスクリプトを共有したい場合は、`.its`ファイルに書き出すことができます。コード署名証明書と秘密鍵をキーチェーンに保存している場合は、`.its`ファイルに署名することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API 스크립트를 공유하려면 `.its` 파일로 내보낼 수 있습니다. 키체인에 코드 서명 인증서와 개인 키가 있으면 `.its` 파일에 서명할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil dele Python API-skript, kan du eksportere dem til en `.its`-fil. Hvis du har et kodesigneringssertifikat og en privatnøkkel i nøkkelringen, kan du også signere `.its`-filen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je Python-API-scripts wilt delen, kun je ze exporteren naar een `.its`-bestand. Als je een certificaat voor codeondertekening en een privésleutel in je sleutelhanger hebt, kun je het `.its`-bestand ook ondertekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz udostępniać skrypty API Pythona, możesz wyeksportować je do pliku `.its`. Jeśli masz w pęku kluczy certyfikat podpisywania kodu i klucz prywatny, możesz też podpisać plik `.its`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você quiser compartilhar scripts da API Python, pode exportá-los para um arquivo `.its`. Se você tiver um certificado de assinatura de código e uma chave privada no seu Keychain, também pode assinar o arquivo `.its`."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы хотите поделиться скриптами Python API, вы можете экспортировать их в файл `.its`. Если в вашей связке ключей есть сертификат для подписи кода и закрытый ключ, вы также можете подписать файл `.its`."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete zdieľať skripty Python API, môžete ich exportovať do súboru `.its`. Ak máte v Kľúčenke certifikát na podpisovanie kódu a súkromný kľúč, môžete súbor `.its` aj podpísať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite deliti skripte API Python, jih lahko izvozite v datoteko `.its`. Če imate v verigi ključev potrdilo za podpisovanje kode in zasebni ključ, lahko datoteko `.its` tudi podpišete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill dela Python-API-skript kan du exportera dem till en `.its`-fil. Om du har ett kodsigneringscertifikat och en privat nyckel i nyckelringen kan du också signera `.its`-filen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API betiklerini paylaşmak isterseniz bunları bir `.its` dosyasına aktarabilirsiniz. Anahtar zincirinizde bir kod imzalama sertifikası ve özel anahtar varsa `.its` dosyasını imzalayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu muốn chia sẻ tập lệnh API Python, bạn có thể xuất chúng ra tệp `.its`. Nếu có chứng chỉ ký mã và khóa riêng trong chuỗi khóa, bạn cũng có thể ký tệp `.its`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若您希望分享 Python API 脚本，可将其导出为 `.its` 文件。若您的 Keychain 中包含代码签名证书和私钥，也可对 `.its` 文件进行签名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要分享 Python API 腳本，可以將它們匯出為 `.its` 檔案。如果你的鑰匙圈中有程式碼簽署憑證與私密金鑰，也可以為 `.its` 檔案簽署。"
          }
        }
      }
    },
    "MenuTip.Find.Filter" : {
      "comment" : "Menu item help for the ‘Find.Filter’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filtr** umožňuje skrýt všechny řádky, které neodpovídají hledanému dotazu, což může být podřetězec nebo regulární výraz. Průběžně se aktualizuje, jak přichází nový text."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** lader dig skjule linjer, der ikke matcher en søgning, som kan være en delstreng eller et regulært udtryk. Det opdateres løbende, når ny tekst ankommer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** ermöglicht es Ihnen, Zeilen auszublenden, die nicht mit einer Suchanfrage übereinstimmen, bei der es sich um eine Teilzeichenfolge oder einen regulären Ausdruck handeln kann. Er aktualisiert sich live, sobald neuer Text eintrifft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Filter** allows you to hide any lines that do not match a search query, which can be a substring or regular expression. It updates live as new text arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El **filtro** te permite ocultar las líneas que no coincidan con una consulta de búsqueda, que puede ser una subcadena o una expresión regular. Se actualiza en vivo a medida que llega texto nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Suodatin** piilottaa rivit, jotka eivät vastaa hakulauseketta. Se voi olla osamerkkijono tai säännöllinen lauseke. Se päivittyy reaaliaikaisesti uuden tekstin saapuessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le **filtre** permet de masquer les lignes qui ne correspondent pas à une requête de recherche, qui peut être une sous-chaîne ou une expression régulière. Il se met à jour en direct à mesure que du nouveau texte arrive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filtra** consente di nascondere le righe che non corrispondono a una query di ricerca, che può essere una sottostringa o un’espressione regolare. Si aggiorna in tempo reale all’arrivo di nuovo testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**フィルター**を使うと、検索クエリ（部分文字列または正規表現）に一致しない行を非表示にできます。新しいテキストが到着すると、リアルタイムに更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**필터**를 사용하면 검색어(부분 문자열 또는 정규 표현식)와 일치하지 않는 줄을 가릴 수 있습니다. 새로운 텍스트가 들어오면 실시간으로 업데이트됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** lar deg skjule linjer som ikke samsvarer med et søk, som kan være en delstreng eller et regulært uttrykk. Det oppdateres fortløpende etter hvert som ny tekst kommer inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met **Filter** verberg je alle regels die niet overeenkomen met een zoekopdracht, een subreeks of reguliere expressie. De weergave wordt live bijgewerkt zodra er nieuwe tekst binnenkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filtr** pozwala ukryć wszystkie wiersze niepasujące do zapytania, które może być podciągiem lub wyrażeniem regularnym. Aktualizuje się na bieżąco w miarę napływania nowego tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O **Filtro** permite ocultar quaisquer linhas que não correspondam a uma consulta de busca, que pode ser uma substring ou uma expressão regular. Ele é atualizado ao vivo à medida que novo texto chega."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Фильтр** позволяет скрывать любые строки, которые не соответствуют поисковому запросу (это может быть подстрока или регулярное выражение). Он обновляется в реальном времени по мере поступления нового текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** umožňuje skryť všetky riadky, ktoré nezodpovedajú hľadanému výrazu, ktorým môže byť podreťazec alebo regulárny výraz. Aktualizuje sa naživo, keď prichádza nový text."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** omogoča skrivanje vseh vrstic, ki se ne ujemajo z iskalno poizvedbo, ki je lahko podniz ali regularni izraz. Sproti se posodablja, ko prihaja novo besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** låter dig gömma alla rader som inte matchar en sökfråga, som kan vara en delsträng eller ett reguljärt uttryck. Det uppdateras direkt när ny text kommer in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filtre**, bir alt dize veya düzenli ifade olabilen bir arama sorgusuyla eşleşmeyen satırları gizlemenizi sağlar. Yeni metin geldikçe canlı olarak güncellenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bộ lọc** cho phép bạn ẩn mọi dòng không khớp với truy vấn tìm kiếm, có thể là chuỗi con hoặc biểu thức chính quy. Kết quả cập nhật trực tiếp khi có văn bản mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Filter** 可隐藏不符合搜索条件的行，这些条件可以是子字符串或正则表达式。当新文本到达时，该功能会实时更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**篩選**可讓你隱藏不符合搜尋查詢的所有行，查詢可以是子字串或正規表示式。新文字抵達時會即時更新。"
          }
        }
      }
    },
    "MenuTip.FindCursor" : {
      "comment" : "Menu item help for the ‘Find Cursor’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýrazní polohu kurzoru a zobrazí ho, pokud je právě skrytý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremhæver markørens placering og viser den, hvis den er skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebt die Position des Cursors hervor und macht ihn sichtbar, falls er derzeit ausgeblendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Highlights the location of the cursor and unhides it if it is currently hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resalta la ubicación del cursor y lo muestra si está oculto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korostaa kohdistimen sijainnin ja tuo sen näkyviin, jos se on kätketty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en évidence l’emplacement du curseur et l’affiche s’il est actuellement masqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evidenzia la posizione del cursore e lo mostra se è attualmente nascosto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルの位置をハイライトし、現在非表示になっている場合は表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 위치를 강조 표시하고, 커서가 현재 숨겨져 있으면 다시 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framhever hvor markøren er, og viser den hvis den er skjult."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeert de locatie van de cursor en maakt de cursor zichtbaar als deze verborgen is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podświetla położenie kursora i odkrywa go, jeśli jest obecnie ukryty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaca a localização do cursor e o mostra caso esteja oculto no momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсвечивает положение курсора и показывает его, если он в данный момент скрыт."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýrazní polohu kurzora a zobrazí ho, ak je momentálne skrytý."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označi mesto kazalca in ga prikaže, če je trenutno skrit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerar markörens plats och visar den om den är dold."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmlecin konumunu vurgular ve gizliyse gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm nổi bật vị trí của con trỏ và hiện nó nếu đang bị ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高亮显示光标位置，若当前隐藏则将其显示出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醒目標示游標的位置，若游標目前處於隱藏狀態，則會將其顯示出來。"
          }
        }
      }
    },
    "MenuTip.FoldSelectedLines" : {
      "comment" : "Menu item help for the ‘Fold Selected Lines’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sbalit** umožňuje sbalit více řádků do jednoho, aby se skryl rušivý text. Kdykoli ho můžete rozbalit kliknutím na šipku na okraji, výběrem textu a volbou **Úpravy > Rozbalit ve výběru** nebo kliknutím pravým tlačítkem a volbou **Rozbalit**."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fold sammen** lader dig skjule flere linjer som én linje for at fjerne distraherende tekst. Du kan altid folde dem ud igen ved at klikke på pilen i margenen, markere teksten og vælge **Rediger > Fold ud i markering**, eller ved at højreklikke og vælge **Fold ud**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fold** lässt Sie mehrere Zeilen zu einer einzigen Zeile zusammenfassen, um ablenkenden Text auszublenden. Sie können sie jederzeit wieder aufklappen, indem Sie auf den Pfeil am Rand klicken, den Text auswählen und **Bearbeiten > In Auswahl aufklappen** verwenden, oder mit der rechten Maustaste klicken und **Aufklappen** wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Fold** lets you collapse multiple lines into a single line to hide distracting text. You can always unfold it by clicking the arrow in the margin, selecting the text and using **Edit > Unfold in Selection**, or right-clicking and choosing **Unfold**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Plegar** te permite contraer varias líneas en una sola para ocultar texto que distrae. Siempre puedes desplegarlas haciendo clic en la flecha del margen, seleccionando el texto y usando **Edición > Desplegar en la selección**, o haciendo clic derecho y eligiendo **Desplegar**."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kutista** tiivistää useita rivejä yhdeksi riviksi, jotta häiritsevä teksti piiloutuu. Voit aina laajentaa sen klikkaamalla marginaalin nuolta, valitsemalla tekstin ja käyttämällä komentoa **Muokkaa > Laajenna valinnassa** tai klikkaamalla hiiren oikealla painikkeella ja valitsemalla **Laajenna**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Replier** permet de réduire plusieurs lignes en une seule pour masquer du texte gênant. Vous pouvez toujours le déplier en cliquant sur la flèche dans la marge, en sélectionnant le texte et en choisissant **Édition > Déplier dans la sélection**, ou en cliquant avec le bouton droit et en choisissant **Déplier**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Comprimi** consente di ridurre più righe a una sola per nascondere il testo che distrae. Puoi sempre espanderle facendo clic sulla freccia nel margine, selezionando il testo e usando **Modifica > Espandi nella selezione**, oppure facendo clic con il tasto destro e scegliendo **Espandi**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**折りたたみ**を使うと、複数の行を1行に折りたたんで邪魔なテキストを隠せます。余白の矢印をクリックする、テキストを選択して**編集 > 選択範囲を展開**を使う、または右クリックして**展開**を選ぶことで、いつでも展開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**접기**를 사용하면 여러 줄을 한 줄로 접어 방해가 되는 텍스트를 가릴 수 있습니다. 여백의 화살표를 클릭하거나, 텍스트를 선택하고 **편집 > 선택 영역에서 펼치기**를 사용하거나, 오른쪽 클릭하고 **펼치기**를 선택하여 언제든지 다시 펼칠 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med **Fold sammen** kan du skjule flere linjer som én linje for å fjerne distraherende tekst. Du kan alltid utvide dem igjen ved å klikke på pilen i margen, markere teksten og bruke «Rediger > Utvid i markering», eller høyreklikke og velge **Utvid**."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met **Vouw samen** kun je meerdere regels samenvouwen tot één regel om afleidende tekst te verbergen. Je kunt de regels altijd weer uitvouwen door op de pijl in de marge te klikken, de tekst te selecteren en **Wijzig > Vouw uit in selectie** te kiezen, of met de rechtermuisknop te klikken en **Vouw uit** te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zwiń** pozwala zwinąć wiele wierszy w jeden, aby ukryć rozpraszający tekst. Zawsze możesz je rozwinąć, klikając strzałkę na marginesie, zaznaczając tekst i wybierając **Edycja > Rozwiń w zaznaczeniu** albo klikając prawym przyciskiem i wybierając **Rozwiń**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dobrar** permite recolher várias linhas em uma única linha para ocultar texto que distrai. Você sempre pode desdobrá-lo clicando na seta na margem, selecionando o texto e usando **Editar > Desdobrar na seleção**, ou clicando com o botão direito e escolhendo **Desdobrar**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Свёртывание** позволяет свернуть несколько строк в одну, чтобы скрыть отвлекающий текст. Вы всегда можете развернуть их, щёлкнув стрелку на полях, выделив текст и выбрав **Правка > Развернуть выделение**, либо щёлкнув правой кнопкой мыши и выбрав **Развернуть**."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zbalenie** umožňuje zbaliť viacero riadkov do jedného, aby sa skryl rušivý text. Môžete ho kedykoľvek rozbaliť kliknutím na šípku na okraji, označením textu a použitím **Upraviť > Rozbaliť vo výbere** alebo kliknutím pravým tlačidlom a výberom **Rozbaliť**."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Strni** omogoča strnitev več vrstic v eno vrstico, da skrijete moteče besedilo. Vedno ga lahko razširite s klikom na puščico na robu, z izbiro besedila in ukazom **Uredi > Razširi v izboru** ali z desnim klikom in izbiro **Razširi**."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med **Fäll ihop** kan du slå ihop flera rader till en enda rad för att gömma störande text. Du kan alltid fälla ut den igen genom att klicka på pilen i marginalen, markera texten och välja **Redigera > Fäll ut i markeringen**, eller högerklicka och välja **Fäll ut**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Daralt**, dikkat dağıtan metni gizlemek için birden çok satırı tek satıra daraltmanızı sağlar. Kenar boşluğundaki oka tıklayarak, metni seçip **Düzen > Seçimde Genişlet** komutunu kullanarak veya sağ tıklayıp **Genişlet** seçerek her zaman genişletebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Thu gọn** cho phép bạn thu nhiều dòng thành một dòng để ẩn văn bản gây xao nhãng. Bạn luôn có thể mở rộng bằng cách bấm mũi tên ở lề, chọn văn bản rồi dùng **Sửa > Mở rộng trong vùng chọn**, hoặc bấm chuột phải và chọn **Mở rộng**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fold** 功能可将多行内容合并为单行，隐藏干扰性文本。您也可以点击边缘箭头、选中文本后选择 **编辑 > 以选中的方式展开**，或右键点击后选择 **展开** 来重新显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**摺疊**可讓你將多行收合為單一行，以隱藏分散注意力的文字。你隨時可以按一下邊界中的箭頭、選取文字並使用**編輯 > 展開選取範圍中的摺疊**，或按一下右鍵並選取**展開**來將其展開。"
          }
        }
      }
    },
    "MenuTip.GPURendererAvailability" : {
      "comment" : "Menu item help for the ‘GPU Renderer Availability’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontroluje, zda se v aktivní relaci právě používá vykreslovací modul GPU. To je někdy užitečné při ladění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerer, om GPU-gengivelsesmotoren aktuelt bruges i den aktive session. Det er nogle gange nyttigt til fejlfinding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft, ob der GPU-Renderer derzeit in der aktiven Sitzung verwendet wird. Dies ist manchmal beim Debuggen hilfreich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Checks whether the GPU Renderer is currently being used in the active session. This is sometimes useful for debugging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba si el renderizador de GPU se está usando actualmente en la sesión activa. A veces es útil para depurar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistaa, käytetäänkö GPU-renderöijää parhaillaan aktiivisessa istunnossa. Tämä on joskus hyödyllistä vianmäärityksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie si le moteur de rendu GPU est actuellement utilisé dans la session active. Cela peut parfois être utile pour le débogage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla se il motore di rendering GPU è attualmente in uso nella sessione attiva. A volte è utile per il debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなセッションで現在GPUレンダラーが使用されているかどうかを確認します。デバッグに役立つことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 활성 세션에서 GPU 렌더러가 사용되고 있는지 확인합니다. 디버깅할 때 유용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekker om GPU-gjengiveren brukes i den aktive økten akkurat nå. Dette er av og til nyttig for feilsøking."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert of de GPU-weergavemodule momenteel wordt gebruikt in de actieve sessie. Dit is soms handig bij het debuggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza, czy mechanizm renderowania GPU jest obecnie używany w aktywnej sesji. Bywa to przydatne przy debugowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica se o renderizador de GPU está sendo usado no momento na sessão ativa. Isto às vezes é útil para depuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет, используется ли в данный момент GPU-рендерер в активном сеансе. Иногда это полезно для отладки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skontroluje, či sa v aktívnej relácii momentálne používa vykresľovací modul GPU. Občas je to užitočné pri ladení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveri, ali se upodabljalnik GPU trenutno uporablja v aktivni seji. To je včasih uporabno za odpravljanje napak."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar om GPU-renderaren används i den aktiva sessionen. Det är ibland användbart vid felsökning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU işleyicinin etkin oturumda şu anda kullanılıp kullanılmadığını denetler. Bu, bazen hata ayıklama için yararlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra xem trình kết xuất GPU hiện có đang được dùng trong phiên đang hoạt động hay không. Đôi khi hữu ích cho việc gỡ lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
