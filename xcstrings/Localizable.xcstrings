    "DependencyEditor.ConfirmDowngradeMessage" : {
      "comment" : "Confirmation prompt before downgrading the Python version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádali jste o přechod na starší verzi Pythonu. Závislosti bude nutné znovu nainstalovat. Mohlo by to dopadnout špatně. Opravdu to chcete udělat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har bedt om at gå tilbage til en ældre Python-version. Afhængigheder skal installeres igen. Det kan gå galt. Er du sikker på, at du vil gøre det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben ein Downgrade auf eine ältere Python-Version angefordert. Abhängigkeiten müssen neu installiert werden. Das könnte schiefgehen. Möchten Sie wirklich fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have asked to downgrade to an older Python version. Dependencies will need to be reinstalled. This may go badly. Are you sure you want to do this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has solicitado volver a una versión anterior de Python. Habrá que reinstalar las dependencias. Podría salir mal. ¿Seguro que quieres hacerlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet pyytänyt vaihtamaan vanhempaan Python-versioon. Riippuvuudet on asennettava uudelleen. Tämä voi mennä pieleen. Haluatko varmasti jatkaa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez demandé le passage à une version antérieure de Python. Les dépendances devront être réinstallées. Cela peut mal se passer. Voulez-vous vraiment continuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai chiesto di passare a una versione precedente di Python. Le dipendenze dovranno essere reinstallate. Potrebbe andare male. Vuoi davvero procedere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いPythonのバージョンにダウングレードしようとしています。依存関係を再インストールする必要があります。うまくいかない可能性があります。本当に実行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 Python 버전으로 다운그레이드하도록 요청했습니다. 의존성을 다시 설치해야 하며, 문제가 생길 수 있습니다. 정말로 진행하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har bedt om å nedgradere til en eldre Python-versjon. Avhengighetene må installeres på nytt. Dette kan gå galt. Er du sikker på at du vil gjøre dette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt gevraagd om naar een oudere versie van Python te gaan. De afhankelijkheden moeten opnieuw worden geïnstalleerd. Dit kan misgaan. Weet je zeker dat je dit wilt doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosisz o powrót do starszej wersji Pythona. Zależności trzeba będzie zainstalować ponownie. Może się to nie udać. Czy na pewno chcesz to zrobić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você solicitou o downgrade para uma versão mais antiga do Python. As dependências precisarão ser reinstaladas. Isso pode dar errado. Tem certeza de que deseja fazer isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы запросили понижение версии Python до более старой. Зависимости придётся переустановить. Это может пройти неудачно. Вы уверены, что хотите продолжить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadali ste o prechod na staršiu verziu Python. Závislosti bude potrebné znovu nainštalovať. Môže to dopadnúť zle. Naozaj to chcete urobiť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtevali ste vrnitev na starejšo različico Pythona. Odvisnosti bo treba znova namestiti. To se lahko slabo konča. Ste prepričani, da želite to storiti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har bett om att gå ner till en äldre Python-version. Beroenden måste installeras om. Det kan gå dåligt. Är du säker på att du vill göra det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python’ın daha eski bir sürümüne geçmeyi istediniz. Bağımlılıkların yeniden yüklenmesi gerekecek. Bu iyi sonuçlanmayabilir. Yine de yapmak istediğinizden emin misiniz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã yêu cầu hạ xuống phiên bản Python cũ hơn. Các phần phụ thuộc sẽ cần được cài đặt lại. Việc này có thể gặp sự cố. Bạn có chắc chắn muốn tiếp tục không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已请求降级到较旧的 Python 版本。依赖项需要重新安装。这可能不太顺利。确定要这样做吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已要求降級到較舊的 Python 版本。相依項目需要重新安裝，過程可能不太順利。確定要這麼做嗎？"
          }
        }
      }
    },
    "DependencyEditor.ConfirmUpgradeMessage" : {
      "comment" : "Confirmation prompt before upgrading the Python version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádali jste o aktualizaci na novější verzi Pythonu. Závislosti bude nutné znovu nainstalovat. Chcete pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har bedt om at opgradere til en nyere Python-version. Afhængigheder skal installeres igen. Vil du fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
