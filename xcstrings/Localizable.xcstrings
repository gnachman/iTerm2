    "AdvancedSetting.minimalDeslectedColoredTabAlpha" : {
      "comment" : "Advanced setting: minimalDeslectedColoredTabAlpha",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota alfa barvy panelu u nevybraných barevných panelů v motivu Minimalistický.\nMusí být mezi 0 a 1."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfaværdi for farven på ikke-valgte farvede faner i temaet Minimal.\nSkal ligge mellem 0 og 1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alphawert für die Tab-Farbe bei nicht ausgewählten farbigen Tabs im Design „Minimal“.\nMuss zwischen 0 und 1 liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alpha value for tab color for non-selected colored tabs in the Minimal theme.\nMust be between 0 and 1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa del color de las pestañas coloreadas no seleccionadas en el tema Minimalista.\nDebe estar entre 0 y 1."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsemattomien värillisten välilehtien värin alfa-arvo Minimaalinen-teemassa.\nArvon on oltava välillä 0 ja 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur alpha de la couleur des onglets colorés non sélectionnés dans le thème Minimal.\nDoit être comprise entre 0 et 1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valore alfa del colore dei pannelli colorati non selezionati nel tema Minimale.\nDeve essere compreso tra 0 e 1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミニマルテーマにおいて、選択されていない色付きタブのタブ色のアルファ値。\n0 から 1 の間である必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 테마에서 선택되지 않은 색상 탭의 탭 색상 알파 값.\n0에서 1 사이여야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfaverdi for fanefargen til ikke-valgte fargede faner i temaet Minimal.\nMå være mellom 0 og 1."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfawaarde voor de tabbladkleur van niet-geselecteerde gekleurde tabbladen in het thema Minimaal.\nMoet tussen 0 en 1 liggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość alfa koloru niezaznaczonych kolorowych kart w motywie Minimalny.\nMusi mieścić się między 0 a 1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa da cor da aba para abas coloridas não selecionadas no tema Minimal.\nDeve estar entre 0 e 1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение альфа-канала для цвета вкладки для невыбранных цветных вкладок в теме Minimal.\nДолжно быть между 0 и 1."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota alfa farby tabu pre nevybrané farebné taby v téme Minimalistická.\nMusí byť medzi 0 a 1."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednost alfa za barvo neizbranih obarvanih zavihkov v temi Minimalna.\nBiti mora med 0 in 1."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfavärde för flikfärgen på omarkerade färgade flikar i temat Minimal.\nMåste vara mellan 0 och 1."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal temada seçili olmayan renkli sekmelerin sekme rengi için alfa değeri.\n0 ile 1 arasında olmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị alpha của màu tab cho các tab có màu không được chọn trong chủ đề Tối giản.\nPhải nằm trong khoảng từ 0 đến 1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小主题中未选中彩色标签页的标签颜色Alpha值。\n必须在0到1之间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "極簡主題中未選取的彩色標籤頁的標籤頁顏色 alpha 值。\n必須介於 0 到 1 之間。"
          }
        }
      }
    },
    "AdvancedSetting.minimalEdgeDragSize" : {
      "comment" : "Advanced setting: minimalEdgeDragSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V motivu Minimalistický můžete okno přesunout tažením z oblasti na okraji poblíž hranice okna. Tato hodnota udává velikost této oblasti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temaet Minimal kan du flytte vinduet ved at trække fra et område på kanten nær vinduets ramme. Dette angiver størrelsen på området."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Design „Minimal“ können Sie das Fenster verschieben, indem Sie in einem Bereich am Rand nahe der Fensterbegrenzung mit dem Ziehen beginnen. Dies gibt die Größe dieses Bereichs an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, you can move the window by dragging starting in a region on the edge near the window border. This gives the size of that region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el tema Minimalista, puedes mover la ventana arrastrando desde una región del borde cercana al límite de la ventana. Esto indica el tamaño de esa región."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimaalinen-teemassa ikkunaa voi siirtää vetämällä reunan alueelta ikkunan rajan läheltä. Tämä määrittää tuon alueen koon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le thème Minimal, vous pouvez déplacer la fenêtre en faisant glisser depuis une zone du bord proche de la bordure de la fenêtre. Ceci donne la taille de cette zone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel tema Minimale puoi spostare la finestra trascinando a partire da una regione sul bordo vicino al limite della finestra. Questo indica la dimensione di tale regione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimalテーマでは、ウィンドウの境界に近い端の領域からドラッグを開始してウィンドウを移動できます。この設定はその領域のサイズを指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 테마에서는 윈도우 테두리 근처 가장자리 영역에서 드래그를 시작하여 윈도우를 이동할 수 있습니다. 이 값은 해당 영역의 크기입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temaet Minimal kan du flytte vinduet ved å dra fra et område ved vindukanten. Dette angir størrelsen på det området."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het thema Minimaal kun je het venster verplaatsen door te slepen vanuit een gebied aan de rand bij de vensterrand. Dit geeft de grootte van dat gebied."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W motywie Minimalny można przesuwać okno, przeciągając od obszaru przy krawędzi w pobliżu obramowania okna. To ustawienie określa rozmiar tego obszaru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, você pode mover a janela arrastando a partir de uma região na borda próxima ao limite da janela. Isto define o tamanho dessa região."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В теме Minimal можно перемещать окно, начав перетаскивание в области у края окна, рядом с его границей. Этот параметр задаёт размер этой области."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V téme Minimalistická môžete okno presúvať potiahnutím z oblasti na okraji pri hranici okna. Toto nastavenie určuje veľkosť tejto oblasti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V temi Minimalna lahko okno premaknete z vlečenjem, ki se začne v območju ob robu okna. To določa velikost tega območja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temat Minimal kan du flytta fönstret genom att dra från ett område vid kanten nära fönsterramen. Det här anger storleken på området."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal temada, pencere kenarlığına yakın bir kenar bölgesinden başlayarak sürükleyip pencereyi taşıyabilirsiniz. Bu, o bölgenin boyutunu belirler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong chủ đề Tối giản, bạn có thể di chuyển cửa sổ bằng cách kéo từ một vùng ở mép gần viền cửa sổ. Giá trị này là kích thước của vùng đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Minimal主题中，可以通过拖动窗口边缘的区域来移动窗口，该区域决定了窗口的大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在極簡主題中，你可以從靠近視窗邊框的邊緣區域開始拖移來移動視窗。此值為該區域的大小。"
          }
        }
      }
    },
