    "PTYSession.ShortLivedSession" : {
      "comment" : "Warning that a session ended right after starting; placeholder is the profile name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace skončila velmi brzy po spuštění. Zkontrolujte, zda je příkaz v profilu „%@“ správný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session sluttede meget kort tid efter start. Kontroller, at kommandoen i profilen “%@” er korrekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sitzung wurde sehr kurz nach dem Start beendet. Überprüfen Sie, ob der Befehl im Profil „%@“ korrekt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A session ended very soon after starting. Check that the command in profile “%@” is correct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión terminó muy poco después de iniciarse. Comprueba que el comando del perfil “%@” sea correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunto päättyi hyvin pian käynnistyksen jälkeen. Tarkista, että profiilin ”%@” komento on oikein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session s’est terminée très peu après son démarrage. Vérifiez que la commande du profil « %@ » est correcte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessione è terminata subito dopo l’avvio. Verifica che il comando nel profilo “%@” sia corretto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが開始直後に終了しました。プロファイル「%@」内のコマンドが正しいか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 시작 직후 종료되었습니다. 프로파일 “%@”의 명령이 올바른지 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
