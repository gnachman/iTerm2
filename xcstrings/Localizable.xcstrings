    "Tip.0012.Body" : {
      "comment" : "Tip of the day body, id 0012",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Bearbeiten > Spezielles Einfügen > Erweitertes Einfügen“ können Sie Text vor dem Einfügen in der Vorschau ansehen und bearbeiten. Sie können Optionen anpassen, etwa wie mit Steuercodes umgegangen wird, oder den Text vor dem Einfügen sogar Base64-codieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Edit > Paste Special > Advanced Paste” lets you preview and edit text before you paste. You get to tweak options, like how to handle control codes, or even to base-64 encode before pasting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Edición > Pegado especial > Pegado avanzado” te permite previsualizar y editar el texto antes de pegarlo. Puedes ajustar opciones, como el tratamiento de los códigos de control, o incluso codificar en base64 antes de pegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Édition > Collage spécial > Collage avancé » vous permet de prévisualiser et de modifier le texte avant de le coller. Vous pouvez ajuster des options, comme le traitement des codes de contrôle, ou même encoder en base64 avant de coller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Modifica > Incolla speciale > Incolla avanzato” ti permette di vedere l’anteprima e modificare il testo prima di incollarlo. Puoi regolare opzioni, come la gestione dei codici di controllo, o persino codificare in base64 prima di incollare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 特殊なペースト > 高度なペースト」を使うと、ペーストする前にテキストをプレビューして編集できます。制御コードの扱い方や、ペースト前にBase64エンコードするかどうかなど、オプションを細かく調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“편집 > 특수 붙여넣기 > 고급 붙여넣기”를 사용하면 붙여넣기 전에 텍스트를 미리 보고 편집할 수 있습니다. 제어 코드 처리 방법 같은 옵션을 조정하거나, 붙여넣기 전에 base-64로 인코딩할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Editar > Colar especial > Colagem avançada” permite visualizar e editar o texto antes de colar. Você pode ajustar opções, como lidar com códigos de controle ou até codificar em base-64 antes de colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Правка > Специальная вставка > Расширенная вставка» позволяет просмотреть и отредактировать текст перед вставкой. Вы можете настроить параметры, например способ обработки управляющих кодов, или даже закодировать текст в base-64 перед вставкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Düzen > Özel Yapıştır > Gelişmiş Yapıştırma”, yapıştırmadan önce metni önizlemenizi ve düzenlemenizi sağlar. Denetim kodlarının nasıl işleneceği gibi seçenekleri ayarlayabilir, hatta yapıştırmadan önce base64 olarak kodlayabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“编辑 > 特殊粘贴 > 高级粘贴”功能可让你在粘贴前预览和编辑文本。你可以调整选项，例如如何处理控制码，甚至可以在粘贴前进行Base64编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編輯 > 特殊貼上 > 進階貼上」可讓你在貼上前預覽並編輯文字。你可以調整選項，例如如何處理控制碼，甚至可在貼上前先進行 base-64 編碼。"
          }
        }
      }
    },
