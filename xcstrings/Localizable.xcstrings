    "MigrationHelper.ManualUpdateBody" : {
      "comment" : "Explanation that the application support directory changed and the user must move files manually",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresář Application Support aplikace iTerm2 se změnil.\n\nDříve byly podporovány oba tyto adresáře:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNyní je podporován pouze adresář iTerm2. Soubory však máte v obou, proto prosím přesuňte vše z iTerm do iTerm2."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen Application Support til iTerm2 er ændret.\n\nTidligere blev begge disse mapper understøttet:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNu understøttes kun iTerm2-versionen. Men du har arkiver i begge, så flyt alt fra iTerm til iTerm2."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Application-Support-Verzeichnis von iTerm2 hat sich geändert.\n\nBisher wurden beide dieser Verzeichnisse unterstützt:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nJetzt wird nur noch die iTerm2-Version unterstützt. Da Sie jedoch Dateien in beiden haben, verschieben Sie bitte alles von iTerm nach iTerm2."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2's Application Support directory has changed.\n\nPreviously, both these directories were supported:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNow, only the iTerm2 version is supported. But you have files in both so please move everything from iTerm to iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El directorio Application Support de iTerm2 ha cambiado.\n\nAntes se admitían estos dos directorios:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nAhora solo se admite la versión iTerm2. Pero tienes archivos en ambos, así que mueve todo de iTerm a iTerm2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:n Application Support -hakemisto on muuttunut.\n\nAiemmin molemmat näistä hakemistoista olivat tuettuja:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNyt vain iTerm2-versio on tuettu. Sinulla on kuitenkin tiedostoja molemmissa, joten siirrä kaikki iTermistä iTerm2:een."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le répertoire Application Support d’iTerm2 a changé.\n\nAuparavant, ces deux répertoires étaient pris en charge :\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nDésormais, seule la version iTerm2 est prise en charge. Mais vous avez des fichiers dans les deux, veuillez donc tout déplacer d’iTerm vers iTerm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La directory Application Support di iTerm2 è cambiata.\n\nPrima erano supportate entrambe queste directory:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nOra è supportata solo la versione iTerm2. Ma hai file in entrambe, quindi sposta tutto da iTerm a iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2のApplication Supportディレクトリが変更されました。\n\n以前は次の両方のディレクトリがサポートされていました。\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\n現在はiTerm2の方のみがサポートされています。ただし両方にファイルがあるため、iTermからiTerm2へすべて移動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2의 Application Support 디렉토리가 변경되었습니다.\n\n이전에는 다음 두 디렉토리가 모두 지원되었습니다.\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\n이제는 iTerm2 디렉토리만 지원됩니다. 그런데 두 곳 모두에 파일이 있으므로 iTerm에 있는 모든 항목을 iTerm2로 옮기십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen Application Support for iTerm2 er endret.\n\nTidligere ble begge disse mappene støttet:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNå støttes bare iTerm2-versjonen. Men du har filer i begge, så flytt alt fra iTerm til iTerm2."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map Application Support van iTerm2 is gewijzigd.\n\nVroeger werden beide mappen ondersteund:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNu wordt alleen de iTerm2-versie nog ondersteund. Je hebt echter bestanden in beide mappen, dus verplaats alles van iTerm naar iTerm2."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katalog Application Support iTerm2 uległ zmianie.\n\nWcześniej obsługiwane były oba te katalogi:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nTeraz obsługiwany jest tylko iTerm2. Masz jednak pliki w obu, więc przenieś wszystko z iTerm do iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório Application Support do iTerm2 foi alterado.\n\nAnteriormente, estes dois diretórios eram compatíveis:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nAgora, apenas a versão iTerm2 é compatível. Mas você tem arquivos em ambos, então mova tudo de iTerm para iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог Application Support для iTerm2 изменился.\n\nРанее поддерживались оба этих каталога:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nТеперь поддерживается только версия для iTerm2. Но у вас есть файлы в обоих каталогах, поэтому, пожалуйста, перенесите всё из iTerm в iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresár Application Support aplikácie iTerm2 sa zmenil.\n\nPredtým sa podporovali oba tieto adresáre:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nTeraz sa podporuje iba verzia iTerm2. Súbory však máte v oboch, preto presuňte všetko z iTerm do iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imenik Application Support aplikacije iTerm2 se je spremenil.\n\nPrej sta bila podprta oba imenika:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nZdaj je podprt samo imenik iTerm2. Vendar imate datoteke v obeh, zato premaknite vse iz imenika iTerm v iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:s katalog Application Support har ändrats.\n\nTidigare stöddes båda dessa kataloger:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNu stöds bara iTerm2-versionen. Men du har filer i båda, så flytta allt från iTerm till iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin Application Support dizini değişti.\n\nÖnceden şu iki dizin de destekleniyordu:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nArtık yalnızca iTerm2 sürümü destekleniyor. Ancak ikisinde de dosyalarınız var; lütfen her şeyi iTerm’den iTerm2’ye taşıyın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục Application Support của iTerm2 đã thay đổi.\n\nTrước đây, cả hai thư mục này đều được hỗ trợ:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nBây giờ chỉ hỗ trợ phiên bản iTerm2. Nhưng bạn có tệp ở cả hai nơi, vì vậy hãy di chuyển mọi thứ từ iTerm sang iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Application Support 目录已更改。\n\n以前，以下两个目录均受支持：\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2。\n\n现在仅支持 iTerm2 版本。但两个目录中都有你的文件，因此请将所有文件从 iTerm 移到 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Application Support 目錄已變更。\n\n先前支援以下兩個目錄：\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2。\n\n現在僅支援 iTerm2 版本。但你兩個目錄中都有檔案，請將 iTerm 中的所有內容移至 iTerm2。"
          }
        }
      }
    },
