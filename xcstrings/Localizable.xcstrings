    "AdvancedSetting.translateScreenToXterm" : {
      "comment" : "Advanced setting: translateScreenToXterm",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen unterstützen\nInsbesondere behebt dies, dass Kursivschrift invertierten Text ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support TERM=screen\nMost notably, this fixes italics replacing inverse text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admite TERM=screen\nSobre todo, corrige que las cursivas sustituyan al texto invertido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre en charge TERM=screen\nCela corrige notamment l’italique qui remplaçait le texte inversé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporta TERM=screen\nIn particolare, risolve il problema del corsivo che sostituisce il testo invertito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screenをサポート\n特に、イタリック体が反転表示の代わりに使われる問題を修正します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen 지원\n특히 반전 텍스트 대신 이탤릭체가 표시되는 문제를 해결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar TERM=screen\nMais notavelmente, isso corrige o itálico substituindo o texto invertido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержка TERM=screen\nВ первую очередь это исправляет замену инверсного текста курсивом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen desteği\nÖzellikle, ters metnin yerine italiklerin geçmesini düzeltir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持TERM=screen  \n最显著的是，这解决了反斜线文本的斜体问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援 TERM=screen\n最顯著的是，這可修正斜體取代反相文字的問題。"
          }
        }
      }
    },
    "AdvancedSetting.triggerRadius" : {
      "comment" : "Advanced setting: triggerRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der Bildschirmzeilen, die gegen die regulären Ausdrücke der Trigger abgeglichen werden.\nReguläre Ausdrücke von Triggern werden gegen die letzte logische Textzeile abgeglichen, wenn ein Zeilenumbruch empfangen wird. Es wird eine Suche durchgeführt, um den Anfang der Zeile zu finden. Da sehr lange Zeilen Leistungsprobleme verursachen würden, ist die Suche (und damit der Abgleich des regulären Ausdrucks, das Hervorheben usw.) auf diese Anzahl von Bildschirmzeilen begrenzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of screen lines to match against trigger regular expressions.\nTrigger regular expressions are matched against the last logical line of text when a newline is received. A search is performed to find the start of the line. Since very long lines would cause performance problems, the search (and consequently the regular expression match, highlighting, and so on) is limited to this many screen lines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de líneas de pantalla que se comparan con las expresiones regulares de los disparadores.\nLas expresiones regulares de los disparadores se comparan con la última línea lógica de texto cuando se recibe un salto de línea. Se realiza una búsqueda para encontrar el inicio de la línea. Como las líneas muy largas causarían problemas de rendimiento, la búsqueda (y por tanto la coincidencia de la expresión regular, el resaltado, etc.) se limita a esta cantidad de líneas de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de lignes d’écran à comparer aux expressions régulières des déclencheurs.\nLes expressions régulières des déclencheurs sont comparées à la dernière ligne logique de texte lorsqu’un saut de ligne est reçu. Une recherche est effectuée pour trouver le début de la ligne. Comme les très longues lignes poseraient des problèmes de performances, la recherche (et par conséquent la correspondance de l’expression régulière, la mise en évidence, etc.) est limitée à ce nombre de lignes d’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di righe dello schermo da confrontare con le espressioni regolari degli attivatori.\nLe espressioni regolari degli attivatori vengono confrontate con l’ultima riga logica di testo quando viene ricevuto un a capo. Viene eseguita una ricerca per trovare l’inizio della riga. Poiché righe molto lunghe causerebbero problemi di prestazioni, la ricerca (e di conseguenza la corrispondenza dell’espressione regolare, l’evidenziazione e così via) è limitata a questo numero di righe dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーの正規表現と照合する画面行数。\n改行を受け取ると、トリガーの正規表現は最後の論理行のテキストと照合されます。行の先頭を見つけるために検索が行われます。非常に長い行はパフォーマンスの問題を引き起こすため、この検索（したがって正規表現の照合、ハイライト表示なども含む）は指定した画面行数までに制限されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거 정규 표현식과 대조할 화면 행 수.\n줄바꿈을 받으면 트리거 정규 표현식이 텍스트의 마지막 논리적 행과 대조됩니다. 행의 시작을 찾기 위해 검색이 수행되는데, 매우 긴 행은 성능 문제를 일으킬 수 있으므로 검색(및 그에 따른 정규 표현식 일치, 하이라이트 등)은 이 화면 행 수로 제한됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de linhas de tela a comparar com as expressões regulares de gatilho.\nAs expressões regulares de gatilho são comparadas com a última linha lógica de texto quando uma quebra de linha é recebida. Uma busca é realizada para encontrar o início da linha. Como linhas muito longas causariam problemas de desempenho, a busca (e consequentemente a correspondência da expressão regular, o realce e assim por diante) é limitada a esta quantidade de linhas de tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество экранных строк, которые нужно сопоставлять с регулярными выражениями триггеров.\nРегулярные выражения триггеров сопоставляются с последней логической строкой текста при получении символа новой строки. Выполняется поиск начала строки. Поскольку очень длинные строки могут привести к проблемам с производительностью, поиск (а вместе с ним и сопоставление регулярного выражения, подсветка и так далее) ограничен этим числом экранных строк."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyici düzenli ifadeleriyle eşleştirilecek ekran satırı sayısı.\nTetikleyici düzenli ifadeleri, yeni satır alındığında metnin son mantıksal satırıyla eşleştirilir. Satırın başlangıcını bulmak için bir arama yapılır. Çok uzun satırlar performans sorunlarına yol açacağından arama (ve dolayısıyla düzenli ifade eşleşmesi, vurgulama vb.) bu kadar ekran satırıyla sınırlıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与触发正则表达式匹配的屏幕行数。  \n当收到换行符时，触发正则表达式会匹配最后逻辑文本行。进行搜索以定位行的开始位置。由于非常长的行会导致性能问题，搜索（以及相应的正则表达式匹配、高亮显示等）限制在这几行屏幕内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與觸發器正規表示式比對的螢幕行數。\n收到換行時，觸發器正規表示式會與最後一個邏輯文字行比對。系統會進行搜尋以找出該行的開頭。由於非常長的行會造成效能問題，搜尋（以及隨之而來的正規表示式比對、醒目標示等）僅限於這麼多螢幕行。"
          }
        }
      }
    },
