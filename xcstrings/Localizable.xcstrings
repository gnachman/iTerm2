    "Tip.0046.Body" : {
      "comment" : "Tip of the day body, id 0046",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Tabs Farben zuweisen, entweder unter „Einstellungen > Profile > Farben“ oder im Menü „Ansicht“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can assign colors to tabs in “Settings > Profiles > Colors,” or in the View menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」、または表示メニューでタブに色を割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상” 또는 보기 메뉴에서 탭에 색상을 지정할 수 있습니다."
