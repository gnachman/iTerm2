    "Tip.0026.Body" : {
      "comment" : "Tip of the day body, id 0026",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S nainstalovanou integrací shellu můžete vybrat výstup posledního příkazu pomocí ⇧⌘A."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med shell-integration installeret kan du markere output fra den sidste kommando med ⇧⌘A."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit installierter Shell-Integration können Sie die Ausgabe des letzten Befehls mit ⇧⌘A auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With Shell Integration installed, you can select the output of the last command with ⇧⌘A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la integración con el shell instalada, puedes seleccionar la salida del último comando con ⇧⌘A."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun komentotulkki-integraatio on asennettu, voit valita viimeisen komennon tulosteen painamalla ⇧⌘A."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l’intégration du shell installée, vous pouvez sélectionner la sortie de la dernière commande avec ⇧⌘A."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l’integrazione shell installata, puoi selezionare l’output dell’ultimo comando con ⇧⌘A."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合をインストールしていれば、⇧⌘Aで直前のコマンドの出力を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 설치되어 있으면 ⇧⌘A로 마지막 명령의 출력을 선택할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skallintegrering installert kan du markere utdataene fra den siste kommandoen med ⇧⌘A."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met shell-integratie geïnstalleerd kun je de uitvoer van het laatste commando selecteren met ⇧⌘A."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zainstalowana jest integracja z powłoką, możesz zaznaczyć dane wyjściowe ostatniego polecenia skrótem ⇧⌘A."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a Shell Integration instalada, você pode selecionar a saída do último comando com ⇧⌘A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если установлена «Интеграция с оболочкой», вы можете выделить вывод последней команды с помощью ⇧⌘A."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S nainštalovanou integráciou shellu môžete výstup posledného príkazu vybrať pomocou ⇧⌘A."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z nameščeno integracijo lupine lahko izhod zadnjega ukaza izberete z ⇧⌘A."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skalintegrering installerad kan du markera utdata från det senaste kommandot med ⇧⌘A."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu yüklüyken son komutun çıktısını ⇧⌘A ile seçebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đã cài đặt Tích hợp shell, bạn có thể chọn đầu ra của lệnh cuối cùng bằng ⇧⌘A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Shell Integration 后，可以使用 ⇧⌘A 选择上一个命令的输出内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝 Shell 整合後，你可以使用 ⇧⌘A 選取上一個指令的輸出。"
          }
        }
      }
    },
