      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihren Terminalfenstern eine konfigurierbare Statusleiste hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add a configurable status bar to your terminal windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir una barra de estado configurable a tus ventanas de terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter une barre d’état configurable à vos fenêtres de terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere una barra di stato configurabile alle finestre del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルウィンドウに設定可能なステータスバーを追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 윈도우에 구성 가능한 상태 막대를 추가할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
