    "Tip.0072.Body" : {
      "comment" : "Tip of the day body, id 0072",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocí rozhraní Python API můžete do iTerm2 přidat vlastní chování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan tilføje tilpasset adfærd til iTerm2 med Python-API’en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können iTerm2 mithilfe der Python-API um eigenes Verhalten erweitern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add custom behavior to iTerm2 using the Python API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir comportamientos personalizados a iTerm2 con la API de Python."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit lisätä iTerm2:een mukautettua toimintaa Python API:n avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter des comportements personnalisés à iTerm2 grâce à l’API Python."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere comportamenti personalizzati a iTerm2 usando l’API Python."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python APIを使うと、iTerm2にカスタムの動作を追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API를 사용하여 iTerm2에 사용자 지정 동작을 추가할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan legge til egendefinert oppførsel i iTerm2 ved hjelp av Python-API-et."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt met de Python-API aangepast gedrag aan iTerm2 toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz dodawać własne zachowania do iTerm2 za pomocą API Pythona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode adicionar comportamentos personalizados ao iTerm2 usando a API Python."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете добавить пользовательское поведение в iTerm2 с помощью Python API."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastné správanie môžete do iTerm2 pridať pomocou Python API."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z API-jem Python lahko aplikaciji iTerm2 dodate vedenje po meri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan lägga till eget beteende i iTerm2 med Python-API:et."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API’sini kullanarak iTerm2’ye özel davranışlar ekleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể thêm hành vi tùy chỉnh cho iTerm2 bằng API Python."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用 Python API为 iTerm2添加自定义行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以使用 Python API 為 iTerm2 加入自訂行為。"
          }
        }
      }
    },
