    "Tip.0047.Body" : {
      "comment" : "Tip of the day body, id 0047",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie beim Ziehen ⌥⌘ gedrückt, um eine rechteckige Auswahl zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥⌘ while dragging to make a rectangular selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ⌥⌘ mientras arrastras para hacer una selección rectangular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌥⌘ tout en faisant glisser pour effectuer une sélection rectangulaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⌥⌘ mentre trascini per fare una selezione rettangolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘を押しながらドラッグすると、矩形選択ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘를 누른 채 드래그하면 직사각형으로 선택할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥⌘ pressionado ao arrastar para fazer uma seleção retangular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌥⌘ при перетаскивании, чтобы сделать прямоугольное выделение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikdörtgen seçim yapmak için sürüklerken ⌥⌘ tuşlarını basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动时按住⌥⌘可创建矩形选择区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移時按住 ⌥⌘，即可建立矩形選取範圍。"
          }
        }
      }
    },
