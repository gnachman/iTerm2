          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Dock 圖像的標記牌標籤中，顯示 App 未使用期間響鈴的次數"
          }
        }
      }
    },
    "AdvancedSetting.indicatorFlashInitialAlpha" : {
      "comment" : "Advanced setting: indicatorFlashInitialAlpha",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počáteční hodnota alfa při blikání vizuálního zvonku nebo indikátoru zalomení vyhledávání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startværdi for alfa ved blink af den visuelle klokke eller indikatoren for søgning, der løber rundt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfänglicher Alphawert beim Aufblitzen des visuellen Signaltons oder der Suchumbruch-Anzeige"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Initial alpha value when flashing the visual bell or search wraparound indicator"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa inicial al destellar la campana visual o el indicador de búsqueda que vuelve al principio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfa-arvon alkuarvo välähdytettäessä visuaalista äänimerkkiä tai haun kiertymisilmaisinta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur alpha initiale lors du clignotement de la sonnerie visuelle ou de l’indicateur de bouclage de la recherche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valore alfa iniziale per il lampeggiamento del campanello visivo o dell’indicatore di ritorno a capo della ricerca"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覚的ベルまたは検索の折り返しインジケーターを点滅させる際の初期アルファ値"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시각적 벨 또는 검색 순환 표시기가 깜빡일 때의 초기 알파 값"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startverdi for alfa når den visuelle bjellen eller søkeindikatoren for omløp blinker"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Initiële alfawaarde bij het laten knipperen van de visuele bel of de indicator voor doorlopen van de zoekopdracht"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Początkowa wartość alfa przy błysku dzwonka wizualnego lub wskaźnika zawinięcia wyszukiwania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa inicial ao piscar a campainha visual ou o indicador de retorno da busca"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начальное значение альфа-канала при мигании визуального сигнала колокольчика или индикатора зацикливания поиска"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počiatočná hodnota alfa pri zablikaní vizuálneho zvončeka alebo indikátora zalomenia vyhľadávania"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začetna vrednost alfa pri utripanju vizualnega zvonca ali kazalnika zavijanja iskanja"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inledande alfavärde när den visuella klockan eller sökningens omslutningsindikator blinkar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel zil veya arama başa dönme göstergesi yanıp sönerken başlangıç alfa değeri"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị alpha ban đầu khi nháy chuông trực quan hoặc chỉ báo tìm kiếm quay vòng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闪烁视觉响铃或搜索环绕指示器时的初始 alpha 值。"
          }
