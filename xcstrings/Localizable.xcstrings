    "PTYTask.TempFileError" : {
      "comment" : "Error shown when a temporary file could not be created. %@ is the temporary directory path.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Erstellen einer temporären Datei mit mkstemps ist ein Fehler aufgetreten. Stellen Sie sicher, dass %@ existiert und beschreibbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An error was encountered while creating a temporary file with mkstemps. Verify that %@ exists and is writable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se produjo un error al crear un archivo temporal con mkstemps. Comprueba que %@ exista y tenga permiso de escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite lors de la création d’un fichier temporaire avec mkstemps. Vérifiez que %@ existe et est accessible en écriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore durante la creazione di un file temporaneo con mkstemps. Verifica che %@ esista e sia scrivibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mkstempsで一時ファイルを作成中にエラーが発生しました。%@が存在し、書き込み可能であることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mkstemps로 임시 파일을 생성하는 중 오류가 발생했습니다. %@이(가) 존재하고 쓰기 가능한지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro ao criar um arquivo temporário com mkstemps. Verifique se %@ existe e tem permissão de escrita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произошла ошибка при создании временного файла с помощью mkstemps. Убедитесь, что %@ существует и доступен для записи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mkstemps ile geçici dosya oluşturulurken bir hata oluştu. %@ dizininin var olduğunu ve yazılabilir olduğunu doğrulayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 mkstemps 创建临时文件时出错。请确认 %@ 存在且可写入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 mkstemps 建立暫存檔時發生錯誤。請確認 %@ 存在且可寫入。"
          }
        }
      }
    },
    "PTYTask.UnableToForkMessage" : {
      "comment" : "Message shown when the app cannot fork a child process.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kindprozess konnte nicht erzeugt werden: Möglicherweise laufen bereits zu viele Prozesse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unable to fork child process: you may have too many processes already running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo hacer fork del proceso hijo: puede que ya haya demasiados procesos en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de créer le processus enfant par fork : trop de processus sont peut-être déjà en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile eseguire il fork del processo figlio: potrebbero essere già in esecuzione troppi processi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子プロセスをフォークできません。既に実行中のプロセスが多すぎる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자식 프로세스를 포크할 수 없습니다. 이미 너무 많은 프로세스가 실행 중일 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível fazer fork do processo filho: talvez você já tenha processos demais em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
