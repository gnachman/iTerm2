          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Requerir pulsar Opción para arrastrar un panel dividido por su barra de título?\nAyuda a evitar arrastres accidentales."
          }
        },
        "fr" : {
