    "AdvancedSetting.unameCommand" : {
      "comment" : "Advanced setting: unameCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkaz použitý k nastavení proměnné `uname`.\nHlavní využití je v promptu AI, aby jazykový model znal operační systém."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommando, der bruges til at sætte variablen `uname`.\nDen primære anvendelse er i AI-prompten, så sprogmodellen kender operativsystemet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl zum Setzen der Variable `uname`.\nDer Hauptzweck besteht darin, sie im KI-Prompt zu verwenden, damit das Sprachmodell das Betriebssystem kennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command used to set the `uname` variable.\nThe main use of this is to use in the AI prompt so the language model knows the operating system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando que se usa para establecer la variable `uname`.\nSu uso principal es en el prompt de IA, para que el modelo de lenguaje conozca el sistema operativo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komento, jolla asetetaan `uname`-muuttuja.\nTärkein käyttötarkoitus on AI-kehote, jotta kielimalli tietää käyttöjärjestelmän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande utilisée pour définir la variable `uname`.\nElle sert principalement dans le prompt IA afin que le modèle de langage connaisse le système d’exploitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando usato per impostare la variabile `uname`.\nL’uso principale è nel prompt IA, così il modello linguistico conosce il sistema operativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`uname`変数を設定するために使用するコマンド。\n主に、言語モデルがオペレーティングシステムを認識できるようAIプロンプトで使用するためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`uname` 변수를 설정하는 데 사용하는 명령.\n주로 AI 프롬프트에서 사용하여 언어 모델이 운영 체제를 알 수 있게 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommando som brukes til å sette variabelen `uname`.\nDen viktigste bruken er i KI-prompten, slik at språkmodellen kjenner operativsystemet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando waarmee de variabele `uname` wordt ingesteld.\nDit wordt vooral gebruikt in de AI-prompt zodat het taalmodel het besturingssysteem kent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecenie używane do ustawienia zmiennej `uname`.\nGłównie służy do użycia w prompcie AI, aby model językowy znał system operacyjny."
          }
