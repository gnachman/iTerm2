          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 선택 사용자화"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizar a seleção inteligente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройка умного выделения"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义智能选取功能"
          }
        }
      }
    },
    "Tip.0031.Body" : {
      "comment" : "Tip of the day body, id 0031",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weisen Sie einer Regel der Intelligenten Auswahl unter „Einstellungen > Profile > Erweitert > Intelligente Auswahl > Aktionen bearbeiten“ eine Aktion zu. Diese erscheinen im Kontextmenü und überschreiben den Semantischen Verlauf beim ⌘-Klick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Assign an action to a Smart Selection rule in “Settings > Profiles > Advanced > Smart Selection > Edit Actions.” They go in the context menu and override semantic history on ⌘-click."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > 詳細 > スマート選択 > アクションを編集」で、スマート選択のルールにアクションを割り当てられます。アクションはコンテキストメニューに表示され、⌘クリック時にはセマンティックヒストリーより優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 고급 > 스마트 선택 > 동작 편집”에서 스마트 선택 규칙에 동작을 지정할 수 있습니다. 지정한 동작은 문맥 메뉴에 나타나며 ⌘-클릭 시 시맨틱 히스토리보다 우선합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atribua uma ação a uma regra de Seleção inteligente em “Ajustes > Perfis > Avançado > Seleção inteligente > Editar ações”. Elas vão para o menu de contexto e substituem o Semantic History ao clicar com ⌘."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначьте действие правилу умного выделения в «Настройки > Профили > Дополнительные > Умное выделение > Изменить действия». Они появляются в контекстном меню и переопределяют семантическую историю при щелчке с ⌘."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 高级 > 智能选取 > 编辑操作”中为智能选取规则分配操作。这些操作会出现在上下文菜单中，通过⌘键点击可以覆盖语义历史记录。"
          }
        }
      }
    },
