        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoznam písiem, ktoré používajú alternatívny algoritmus zaokrúhľovania pri výpočte výšky riadka.\nOpravuje consolas a napodobňuje správanie Terminal.app v macOS 10.15. Je to zoznam podreťazcov názvov rodín písma oddelených čiarkami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam pisav, pri katerih se za izračun višine vrstice uporabi nadomestni algoritem zaokroževanja.\nTo popravi consolas in posnema vedenje aplikacije Terminal v macOS 10.15. To je z vejicami ločen seznam podnizov družin pisav."
          }
