    "NaggingController.OrphanRestored" : {
      "comment" : "Announcement that an already-running session was restored without saved contents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato již běžící relace byla obnovena, ale její obsah nebyl uložen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne session kørte allerede og blev gendannet, men dens indhold blev ikke gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
