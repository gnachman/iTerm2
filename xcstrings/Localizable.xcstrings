    "ChatViewController.OutputTruncatedNote" : {
      "comment" : "Note appended when command output was truncated",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Hinweis: Die Befehlsausgabe wurde gekürzt, da sie die maximale von KI-Chat unterstützte Zeilenanzahl überschritten hat*"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n*Note: The command output was truncated because it exceeded the maximum number of lines supported by AI Chat*"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Nota: la salida del comando se truncó porque superaba el número máximo de líneas admitido por el chat de IA*"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Remarque : la sortie de la commande a été tronquée, car elle dépassait le nombre maximal de lignes pris en charge par le chat IA*"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Nota: l’output del comando è stato troncato perché superava il numero massimo di righe supportato dalla chat IA*"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*注: コマンドの出力はAIチャットがサポートする最大行数を超えたため、切り詰められました*"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*참고: 명령 출력이 AI 채팅에서 지원하는 최대 행 수를 초과하여 잘렸습니다*"
