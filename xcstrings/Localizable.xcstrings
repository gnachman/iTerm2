          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n「コンパニオンデバイスの設定」からセットアップを完了できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n컴패니언 기기 설정에서 설정을 마칠 수 있습니다."
