    "AdvancedSetting.requireOptionToDragSplitPaneTitleBar" : {
      "comment" : "Advanced setting: requireOptionToDragSplitPaneTitleBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžadovat podržení Option pro přetažení rozděleného podokna za jeho záhlaví?\nPomáhá to předejít nechtěnému přetažení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræv, at Alternativ trykkes ned for at trække en opdelt rude i dens titellinje?\nDet hjælper med at forhindre utilsigtede træk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordern, dass die Wahltaste (Option) gedrückt wird, um einen Split-Bereich an seiner Titelleiste zu ziehen?\nDies hilft, versehentliches Ziehen zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Require Option to be pressed to drag a split pane by its title bar?\nThis helps prevent accidental drags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Requerir pulsar Opción para arrastrar un panel dividido por su barra de título?\nAyuda a evitar arrastres accidentales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaaditaanko optio-näppäimen painaminen, kun jaettua paneelia vedetään sen otsikkopalkista?\nTämä auttaa estämään vahingossa tapahtuvat vedot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiger d’appuyer sur Option pour faire glisser un volet scindé par sa barre de titre ?\nCela aide à éviter les glissements accidentels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedere di premere Opzione per trascinare un riquadro diviso dalla sua barra del titolo?\nAiuta a evitare trascinamenti accidentali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインをタイトルバーからドラッグするにはOptionキーを押す必要がありますか？\nこれにより誤ったドラッグを防止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할된 패널을 제목 막대로 드래그하려면 Option 키를 눌러야 합니까?\n실수로 드래그하는 것을 방지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krev at Tilvalg-tasten holdes inne for å dra en delt rute etter tittellinjen?\nDette bidrar til å hindre utilsiktet dragning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option ingedrukt vereisen om een gesplitst paneel aan de titelbalk te slepen?\nDit helpt voorkomen dat er per ongeluk wordt gesleept."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy wymagać naciśnięcia Option, aby przeciągnąć panel podzielony za pasek tytułu?\nPomaga to zapobiegać przypadkowemu przeciąganiu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir que Option esteja pressionado para arrastar um painel dividido pela sua barra de título?\nIsto ajuda a evitar arrastos acidentais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требовать нажатия Option для перетаскивания разделённой панели за заголовок?\nЭто помогает предотвратить случайные перетаскивания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžadovať stlačenie Option na ťahanie rozdeleného panela za jeho lištu s názvom?\nPomáha to zabrániť náhodnému ťahaniu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj bo za vlečenje razdeljenega podokna za naslovno vrstico potrebna tipka Option?\nTako se prepreči nenamerno vlečenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräv att alternativtangenten hålls nedtryckt för att dra en delad panel i dess titelfält?\nDet hjälper till att förhindra oavsiktliga dragningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölmeyi başlık çubuğundan sürüklemek için Option tuşuna basmak gereksin mi?\nBu, kazara sürüklemeleri önlemeye yardımcı olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu nhấn Option để kéo khung chia bằng thanh tiêu đề?\nĐiều này giúp ngăn kéo nhầm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否要求按下Option键才能通过标题栏拖动分屏窗格？\n这有助于防止意外拖动。"
          }
