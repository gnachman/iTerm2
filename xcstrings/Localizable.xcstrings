    "AdvancedSetting.noSyncSuppressSendSignal" : {
      "comment" : "Advanced setting: noSyncSuppressSendSignal",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat upozornění na odeslání signálu k ukončení procesu.\nPoužívá se ve stromu procesů, který najdete v pásu nástrojů nebo kliknutím na součást stavového řádku Procesy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul advarsel om at sende et signal for at afslutte en proces.\nDette bruges i procestræet, som du finder i værktøjsbæltet eller ved at klikke på statuslinjekomponenten Processer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über das Senden eines Signals zum Beenden eines Jobs unterdrücken.\nDies wird im Prozessbaum verwendet, den Sie im Toolbelt oder durch Klicken auf die Statusleisten-Komponente „Jobs“ finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about sending a signal to terminate a job.\nThis is used in the process tree, which you can find the toolbelt or by clicking the Jobs status bar component."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la advertencia sobre enviar una señal para terminar un proceso.\nSe usa en el árbol de procesos, que puedes encontrar en la caja de herramientas o haciendo clic en el componente Procesos de la barra de estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaimenna varoitus signaalin lähettämisestä prosessin päättämiseksi.\nTätä käytetään prosessipuussa, jonka löydät työkaluvyöstä tai klikkaamalla Prosessit-tilapalkin osaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’avertissement sur l’envoi d’un signal pour terminer un processus.\nCela concerne l’arborescence des processus, que l’on trouve dans la boîte à outils ou en cliquant sur le composant Processus de la barre d’état."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso sull’invio di un segnale per terminare un processo.\nViene usato nell’albero dei processi, che trovi nella cassetta attrezzi o facendo clic sul componente Processi della barra di stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブを終了するためにシグナルを送信することに関する警告を表示しない。\nこれはプロセスツリーで使用され、ツールベルトまたはJobsステータスバーコンポーネントをクリックすることで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업을 종료하기 위해 시그널을 보낼 때의 경고 표시 안 함.\n프로세스 트리에서 사용되며, 프로세스 트리는 도구 벨트에서 찾거나 작업 상태 막대 구성요소를 클릭하여 열 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis advarsel om å sende et signal for å avslutte en prosess.\nDette brukes i prosesstreet, som du finner i verktøybeltet eller ved å klikke på statuslinjekomponenten Prosesser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk de waarschuwing over het sturen van een signaal om een proces te beëindigen.\nDit wordt gebruikt in de processtructuur, die je kunt vinden in de gereedschapsriem of door op het statusbalkonderdeel Processen te klikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pokazuj ostrzeżenia o wysyłaniu sygnału kończącego proces.\nJest to używane w drzewie procesów, które znajdziesz w pasie narzędzi lub po kliknięciu składnika paska stanu Procesy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre enviar um sinal para encerrar um processo.\nIsto é usado na árvore de processos, que você pode encontrar na toolbelt ou clicando no componente Processos da barra de status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение об отправке сигнала для завершения задачи.\nЭто используется в дереве процессов, которое можно найти в разделе «Инструменты» или щёлкнув по компоненту строки состояния «Задачи»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať upozornenie na odoslanie signálu na ukončenie procesu.\nPoužíva sa v strome procesov, ktorý nájdete v páse s nástrojmi alebo kliknutím na komponent stavovej lišty Procesy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži opozorila o pošiljanju signala za prekinitev procesa.\nTo se uporablja v drevesu procesov, ki ga najdete v pasu z orodji ali s klikom na komponento vrstice stanja Procesi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj varningen om att skicka en signal för att avsluta en process.\nDen används i processträdet, som du hittar i verktygsbältet eller genom att klicka på statusfältskomponenten Processer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir işlemi sonlandırmak için sinyal göndermeyle ilgili uyarıyı bir daha gösterme.\nBu, araç kemerinde veya İşlemler durum çubuğu bileşenine tıklayarak bulabileceğiniz işlem ağacında kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị cảnh báo về việc gửi tín hiệu để dừng một tiến trình.\nĐiều này được dùng trong cây tiến trình, có thể tìm thấy trong đai công cụ hoặc bằng cách bấm thành phần thanh trạng thái Tiến trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制关于发送信号终止作业的警告。\n此选项用于进程树中，您可以通过工具包或点击“Jobs”状态栏组件来查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示傳送訊號以終止程序的警告。\n此警告用於程序樹，你可以在工具帶中找到，或按一下「程序」狀態列元件。"
          }
        }
      }
