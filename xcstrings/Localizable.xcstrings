    "ProfilesText.AmbiguousWidthWarningBody" : {
      "comment" : "Warning shown before enabling treating ambiguous-width characters as double-width",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravděpodobně to zapnout nechcete. Zmate to interaktivní programy. Může se vám to hodit, pokud pracujete převážně s východoasijským textem v kombinaci se zastaralými nebo matematickými sadami znaků. Opravdu to chcete zapnout?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil sandsynligvis ikke slå dette til. Det vil forvirre interaktive programmer. Du vil måske have det, hvis du hovedsageligt arbejder med østasiatisk tekst kombineret med ældre eller matematiske tegnsæt. Er du sikker på, at du vil have det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sollten Sie wahrscheinlich nicht aktivieren. Es verwirrt interaktive Programme. Es könnte nützlich sein, wenn Sie hauptsächlich mit ostasiatischem Text in Kombination mit veralteten oder mathematischen Zeichensätzen arbeiten. Sind Sie sicher, dass Sie dies möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You probably don’t want to turn this on. It will confuse interactive programs. You might want it if you work mostly with East Asian text combined with legacy or mathematical character sets. Are you sure you want this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probablemente no quieras activar esto. Confundirá a los programas interactivos. Puede que lo quieras si trabajas sobre todo con texto de Asia oriental combinado con conjuntos de caracteres heredados o matemáticos. ¿Seguro que quieres hacerlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et luultavasti halua ottaa tätä käyttöön. Se sekoittaa interaktiiviset ohjelmat. Saatat haluta sen, jos työskentelet pääasiassa itäaasialaisen tekstin parissa yhdistettynä vanhoihin tai matemaattisiin merkistöihin. Haluatko varmasti tämän?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne voulez probablement pas activer cette option. Elle perturbera les programmes interactifs. Elle peut être utile si vous travaillez surtout avec du texte d’Asie de l’Est combiné à des jeux de caractères hérités ou mathématiques. Voulez-vous vraiment l’activer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente non vuoi attivarlo. Confonderà i programmi interattivi. Potrebbe servirti se lavori soprattutto con testo dell’Asia orientale combinato con set di caratteri legacy o matematici. Vuoi davvero attivarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすることはお勧めしません。対話型プログラムが混乱する可能性があります。主に東アジアのテキストをレガシーまたは数学記号セットと組み合わせて使用する場合には有用かもしれません。本当によろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션은 켜지 않는 것이 좋습니다. 대화형 프로그램이 오작동할 수 있습니다. 주로 동아시아 텍스트를 레거시 또는 수학 문자 세트와 함께 사용하는 경우에만 필요할 수 있습니다. 정말로 켜겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil sannsynligvis ikke slå på dette. Det vil forvirre interaktive programmer. Du kan ha nytte av det hvis du hovedsakelig jobber med østasiatisk tekst kombinert med eldre eller matematiske tegnsett. Er du sikker på at du vil ha dette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wilt dit waarschijnlijk niet inschakelen. Het brengt interactieve programma’s in de war. Je wilt het misschien wel als je vooral met Oost-Aziatische tekst werkt in combinatie met verouderde of wiskundige tekensets. Weet je zeker dat je dit wilt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raczej nie chcesz tego włączać. Będzie to mylić programy interaktywne. Możesz tego potrzebować, jeśli pracujesz głównie z tekstem wschodnioazjatyckim w połączeniu ze starszymi lub matematycznymi zestawami znaków. Czy na pewno chcesz to włączyć?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você provavelmente não quer ativar isto. Vai confundir programas interativos. Você pode querer isto se trabalha principalmente com texto do leste asiático combinado com conjuntos de caracteres legados ou matemáticos. Tem certeza de que deseja isto?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорее всего, вам не стоит включать эту функцию. Она может запутать интерактивные программы. Она может пригодиться, если вы в основном работаете с текстом на восточноазиатских языках в сочетании с устаревшими или математическими наборами символов. Вы уверены, что хотите это сделать?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravdepodobne to nechcete zapnúť. Zmätie to interaktívne programy. Môže sa vám to hodiť, ak pracujete hlavne s východoázijským textom v kombinácii so staršími alebo matematickými sadami znakov. Naozaj to chcete?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tega verjetno ne želite vklopiti. Zmedlo bo interaktivne programe. Morda ga potrebujete, če večinoma delate z vzhodnoazijskim besedilom v kombinaciji z zastarelimi ali matematičnimi nabori znakov. Ste prepričani, da to želite?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill förmodligen inte slå på detta. Det förvirrar interaktiva program. Du kanske vill ha det om du huvudsakligen arbetar med östasiatisk text i kombination med äldre eller matematiska teckenuppsättningar. Är du säker på att du vill göra det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muhtemelen bunu açmak istemezsiniz. Etkileşimli programların kafasını karıştırır. Eski veya matematiksel karakter kümeleriyle birlikte ağırlıklı olarak Doğu Asya metinleriyle çalışıyorsanız isteyebilirsiniz. Bunu gerçekten istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có lẽ không muốn bật tùy chọn này. Nó sẽ làm các chương trình tương tác bị nhầm lẫn. Bạn có thể cần đến nó nếu chủ yếu làm việc với văn bản Đông Á kết hợp với các bộ ký tự cũ hoặc toán học. Bạn có chắc chắn muốn bật không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不想开启此功能。它会干扰交互式程序。如果你主要处理东亚文本以及传统或数学字符集，可能会需要它。你确定要这样做吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不想開啟此功能。它會讓互動式程式發生混亂。如果你主要處理東亞文字，並搭配舊式或數學字元集，可能會需要它。確定要這樣做嗎？"
          }
        }
      }
    },
    "ProfilesText.EnableAmbiguousWidth" : {
