    "Companion.InstallExplanation.CompanionOnly" : {
      "comment" : "Explanatory paragraph on the companion-only setup screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se nainstaluje doprovodný plug-in a zapne se párování doprovodných zařízení. Poté může iTerm2 odesílat data mimo tento Mac, ale pouze s vaším výslovným souhlasem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette installerer ledsagerpluginet og slår sammenkobling af ledsagerenheder til. Derefter kan iTerm2 sende data væk fra denne Mac, men kun med dit udtrykkelige samtykke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies installiert das Begleit-Plugin und aktiviert die Kopplung mit dem Begleitgerät. Danach kann iTerm2 Daten von diesem Mac senden, jedoch nur mit Ihrer ausdrücklichen Zustimmung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This installs the Companion plugin and turns on companion device pairing. Afterward, iTerm2 can send data off this Mac, but only with your explicit consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto instala el plugin complementario y activa el emparejamiento de dispositivos complementarios. Después, iTerm2 podrá enviar datos fuera de este Mac, pero solo con tu consentimiento explícito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä asentaa kumppaniliitännäisen ja ottaa käyttöön kumppanilaitteen parin muodostuksen. Tämän jälkeen iTerm2 voi lähettää tietoja pois tältä Macilta, mutta vain nimenomaisella suostumuksellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela installe le module Compagnon et active l’association d’appareils compagnons. Ensuite, iTerm2 pourra envoyer des données hors de ce Mac, mais seulement avec votre consentement explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo installa il plug-in associato e attiva l’associazione dei dispositivi. In seguito, iTerm2 potrà inviare dati fuori da questo Mac, ma solo con il tuo consenso esplicito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりCompanionプラグインがインストールされ、コンパニオンデバイスのペアリングが有効になります。以降、iTerm2はこのMacからデータを送信できるようになりますが、それはあなたの明示的な同意がある場合に限られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언 플러그인을 설치하고 컴패니언 기기 페어링을 켭니다. 그 후 iTerm2는 이 Mac 밖으로 데이터를 보낼 수 있지만, 사용자가 명시적으로 동의한 경우에만 보냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette installerer tillegget for følgeenheter og slår på paring av følgeenheter. Etterpå kan iTerm2 sende data fra denne Macen, men bare med ditt uttrykkelige samtykke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee installeer je de begeleidende plug-in en schakel je het koppelen van begeleidende apparaten in. Daarna kan iTerm2 gegevens van deze Mac versturen, maar alleen met je uitdrukkelijke toestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To instaluje wtyczkę urządzenia towarzyszącego i włącza parowanie z takim urządzeniem. Potem iTerm2 może wysyłać dane poza ten Mac, ale tylko za twoją wyraźną zgodą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto instala o plugin do Companion e ativa o pareamento com dispositivos companheiros. Depois disso, o iTerm2 pode enviar dados para fora deste Mac, mas somente com seu consentimento explícito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устанавливает плагин Компаньон и включает сопряжение с устройством-компаньоном. После этого iTerm2 сможет отправлять данные с этого Mac, но только с вашего явного согласия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa nainštaluje plugin sprievodného zariadenia a zapne sa párovanie sprievodných zariadení. Potom bude iTerm2 môcť odosielať údaje mimo tohto Macu, ale iba s vaším výslovným súhlasom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem namestite vtičnik Companion in vklopite seznanjanje spremljevalnih naprav. Nato lahko iTerm2 pošilja podatke iz tega Maca, vendar le z vašim izrecnim soglasjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta installerar följeslagarpluginet och slår på ihopparning av följeslagarenheter. Därefter kan iTerm2 skicka data från den här Macen, men bara med ditt uttryckliga samtycke."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem eşlik eden eklentiyi yükler ve eşlik eden aygıt eşleştirmesini açar. Ardından iTerm2 bu Mac’ten veri gönderebilir, ancak yalnızca açık izninizle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này cài đặt trình cắm Đồng hành và bật ghép nối thiết bị đồng hành. Sau đó, iTerm2 có thể gửi dữ liệu ra khỏi Mac này, nhưng chỉ khi bạn đồng ý rõ ràng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将安装 Companion 插件并开启伴侣设备配对功能。之后，iTerm2 可以将数据发送到此 Mac 之外，但仅限在获得您明确同意的情况下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會安裝搭配外掛程式並開啟搭配裝置配對功能。之後，iTerm2 可以將資料傳送到這部 Mac 之外，但僅限於你明確同意的情況。"
          }
        }
      }
    },
    "Companion.InstallExplanation.Full" : {
      "comment" : "Explanatory paragraph on the full setup screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se nainstalují plug-iny AI a doprovodný plug-in a zapnou se obě funkce. Poté může iTerm2 odesílat data mimo tento Mac, ale pouze s vaším výslovným souhlasem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette installerer AI-pluginet og ledsagerpluginet og slår begge funktioner til. Derefter kan iTerm2 sende data væk fra denne Mac, men kun med dit udtrykkelige samtykke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies installiert die KI- und Begleit-Plugins und aktiviert beide Funktionen. Danach kann iTerm2 Daten von diesem Mac senden, jedoch nur mit Ihrer ausdrücklichen Zustimmung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This installs the AI and Companion plugins and turns on both features. Afterward, iTerm2 can send data off this Mac, but only with your explicit consent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto instala los plugins de IA y complementario y activa ambas funciones. Después, iTerm2 podrá enviar datos fuera de este Mac, pero solo con tu consentimiento explícito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä asentaa AI- ja kumppaniliitännäiset ja ottaa käyttöön molemmat ominaisuudet. Tämän jälkeen iTerm2 voi lähettää tietoja pois tältä Macilta, mutta vain nimenomaisella suostumuksellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela installe les modules IA et Compagnon et active les deux fonctions. Ensuite, iTerm2 pourra envoyer des données hors de ce Mac, mais seulement avec votre consentement explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo installa i plug-in IA e associato e attiva entrambe le funzioni. In seguito, iTerm2 potrà inviare dati fuori da questo Mac, ma solo con il tuo consenso esplicito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりAIとCompanionの両プラグインがインストールされ、両方の機能が有効になります。以降、iTerm2はこのMacからデータを送信できるようになりますが、それはあなたの明示的な同意がある場合に限られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 및 컴패니언 플러그인을 설치하고 두 기능을 모두 켭니다. 이후 iTerm2는 이 Mac 외부로 데이터를 보낼 수 있지만, 사용자가 명시적으로 동의한 경우에만 보냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette installerer KI-tillegget og tillegget for følgeenheter og slår på begge funksjonene. Etterpå kan iTerm2 sende data fra denne Macen, men bare med ditt uttrykkelige samtykke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee installeer je de AI-plug-in en de begeleidende plug-in en schakel je beide functies in. Daarna kan iTerm2 gegevens van deze Mac versturen, maar alleen met je uitdrukkelijke toestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To instaluje wtyczki AI i urządzenia towarzyszącego oraz włącza obie funkcje. Potem iTerm2 może wysyłać dane poza ten Mac, ale tylko za twoją wyraźną zgodą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto instala os plugins de IA e do Companion e ativa ambos os recursos. Depois disso, o iTerm2 pode enviar dados para fora deste Mac, mas somente com seu consentimento explícito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устанавливает плагины ИИ и Компаньон и включает обе функции. После этого iTerm2 сможет отправлять данные с этого Mac, но только с вашего явного согласия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto sa nainštalujú pluginy AI a sprievodného zariadenia a zapnú sa obe funkcie. Potom bude iTerm2 môcť odosielať údaje mimo tohto Macu, ale iba s vaším výslovným súhlasom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem namestite vtičnika AI in Companion ter vklopite obe funkciji. Nato lahko iTerm2 pošilja podatke iz tega Maca, vendar le z vašim izrecnim soglasjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta installerar AI- och följeslagarpluginerna och slår på båda funktionerna. Därefter kan iTerm2 skicka data från den här Macen, men bara med ditt uttryckliga samtycke."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem YZ ve eşlik eden eklentileri yükler ve her iki özelliği de açar. Ardından iTerm2 bu Mac’ten veri gönderebilir, ancak yalnızca açık izninizle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này cài đặt các trình cắm AI và Đồng hành và bật cả hai tính năng. Sau đó, iTerm2 có thể gửi dữ liệu ra khỏi Mac này, nhưng chỉ khi bạn đồng ý rõ ràng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将安装 AI 插件和 Companion 插件并开启这两项功能。之后，iTerm2 可以将数据发送到此 Mac 之外，但仅限在获得您明确同意的情况下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會安裝 AI 外掛程式與搭配外掛程式，並開啟這兩項功能。之後，iTerm2 可以將資料傳送到這部 Mac 之外，但僅限於你明確同意的情況。"
