        }
      }
    },
    "AdvancedSetting.conservativeURLGuessing" : {
      "comment" : "Advanced setting: conservativeURLGuessing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müssen URLs ein Schema enthalten?\nAktivieren Sie dies, um die Anzahl der Fehlalarme zu verringern, bei denen Semantic History fälschlich eine URL erkennt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URLs must contain a scheme?\nEnable this to reduce the number of false positives that semantic history thinks are a URL"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Las URL deben contener un esquema?\nActívalo para reducir el número de falsos positivos que el historial semántico considera una URL"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les URL doivent-elles contenir un schéma ?\nActivez cette option pour réduire le nombre de faux positifs que l’historique sémantique prend pour des URL"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli URL devono contenere uno schema?\nAbilitalo per ridurre il numero di falsi positivi che la cronologia semantica considera URL"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL にスキームが含まれている必要がありますか?\nこれを有効にすると、セマンティック履歴が URL だと誤検出する数を減らせます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL에 스킴이 반드시 있어야 합니까?\n시맨틱 히스토리가 URL로 잘못 판단하는 경우를 줄이려면 이 옵션을 켜십시오"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLs devem conter um esquema?\nAtive isto para reduzir o número de falsos positivos que o Semantic History considera ser uma URL"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL должны содержать схему?\nВключите, чтобы уменьшить количество ложных срабатываний, которые Semantic History принимает за URL"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL’ler bir şema içermeli mi?\nAnlamsal geçmişin URL sandığı yanlış pozitiflerin sayısını azaltmak için bunu etkinleştirin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 必须包含 scheme？  \n启用此选项可减少语义历史中误判为 URL 的假阳性情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 必須包含協定？\n啟用此項可減少語意歷史記錄誤判為 URL 的情況。"
          }
        }
      }
    },
    "AdvancedSetting.convertItalicsToReverseVideoForTmux" : {
      "comment" : "Advanced setting: convertItalicsToReverseVideoForTmux",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursivschrift in der tmux-Integration in inverse Darstellung umwandeln?\nDies ist wirksam, wenn das von tmux gemeldete Standard-TERM *screen* entspricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Convert italics to reverse video in tmux integration?\nThis is effective when the default TERM reported by tmux matches *screen*."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Convertir la cursiva en vídeo inverso en la integración con tmux?\nEs efectivo cuando el TERM predeterminado que informa tmux coincide con *screen*."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir l’italique en vidéo inverse dans l’intégration tmux ?\nCela s’applique lorsque le TERM par défaut signalé par tmux correspond à *screen*."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertire il corsivo in video inverso nell’integrazione tmux?\nÈ efficace quando il TERM predefinito riportato da tmux corrisponde a *screen*."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 統合でイタリック体を反転表示に変換しますか?\nこれは、tmux が報告するデフォルトの TERM が *screen* に一致する場合に有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합에서 이탤릭체를 반전 비디오로 변환하겠습니까?\ntmux가 보고하는 기본 TERM이 *screen*과 일치할 때 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converter itálicos em vídeo reverso na integração do tmux?\nIsto tem efeito quando o TERM padrão relatado pelo tmux corresponde a *screen*."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразовывать курсив в инверсное видео при интеграции с tmux?\nЭто действует, когда TERM по умолчанию, сообщаемое tmux, соответствует *screen*."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux entegrasyonunda italik, ters videoya dönüştürülsün mü?\nBu, tmux’un bildirdiği varsayılan TERM *screen* ile eşleştiğinde etkilidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 集成中将斜体转换为反向视频？  \n当 tmux 报告的默认 TERM 与 *screen* 匹配时，此功能有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 整合中將斜體轉換為反相顯示？\n當 tmux 回報的預設 TERM 符合 *screen* 時有效。"
          }
        }
      }
    },
    "AdvancedSetting.convertItalicsToReverseVideoForTmuxBugwardsCompatible" : {
      "comment" : "Advanced setting: convertItalicsToReverseVideoForTmuxBugwardsCompatible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursivschrift in der tmux-Integration in inverse Darstellung umwandeln, auch wenn TERM *tmux* entspricht?\nDies war lange Zeit das Standardverhalten, war jedoch fehlerhaft. Die Umwandlung sollte nur erfolgen, wenn TERM *screen* entspricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Convert italics to reverse video in tmux integration, even when TERM matches *tmux*?\nThis was the default behavior for a long time, but it was incorrect. The conversion should only be done when TERM matches *screen*."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Convertir la cursiva en vídeo inverso en la integración con tmux, incluso cuando TERM coincide con *tmux*?\nEste fue el comportamiento predeterminado durante mucho tiempo, pero era incorrecto. La conversión solo debería hacerse cuando TERM coincide con *screen*."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertir l’italique en vidéo inverse dans l’intégration tmux, même lorsque TERM correspond à *tmux* ?\nC’était le comportement par défaut pendant longtemps, mais il était incorrect. La conversion ne devrait avoir lieu que lorsque TERM correspond à *screen*."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertire il corsivo in video inverso nell’integrazione tmux, anche quando TERM corrisponde a *tmux*?\nPer molto tempo è stato il comportamento predefinito, ma era errato. La conversione dovrebbe avvenire solo quando TERM corrisponde a *screen*."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM が *tmux* に一致する場合でも、tmux 統合でイタリック体を反転表示に変換しますか?\nこれは長い間デフォルトの動作でしたが、正しくありませんでした。変換は TERM が *screen* に一致する場合にのみ行うべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM이 *tmux*와 일치할 때도 tmux 통합에서 이탤릭체를 반전 표시로 변환합니까?\n오랫동안 이것이 기본 동작이었지만 올바르지 않았습니다. 이 변환은 TERM이 *screen*과 일치할 때만 수행해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converter itálicos em vídeo reverso na integração do tmux, mesmo quando o TERM corresponde a *tmux*?\nEste foi o comportamento padrão por muito tempo, mas estava incorreto. A conversão só deve ser feita quando o TERM corresponde a *screen*."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразовывать курсив в инверсное видео при интеграции с tmux даже когда TERM соответствует *tmux*?\nТак было устроено по умолчанию долгое время, но это было неправильно. Преобразование должно выполняться только когда TERM соответствует *screen*."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM *tmux* ile eşleşse bile tmux entegrasyonunda italik, ters videoya dönüştürülsün mü?\nBu uzun süre varsayılan davranıştı ama yanlıştı. Dönüştürme yalnızca TERM *screen* ile eşleştiğinde yapılmalıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 集成中，即使 TERM 匹配 *tmux*，是否应该将斜体转换为反向视频？\n这一直是默认行为，但其实不正确。转换应仅在 TERM 匹配 *screen* 时执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使 TERM 符合 *tmux*，也在 tmux 整合中將斜體轉換為反相顯示？\n這曾長期作為預設行為，但並不正確。只有在 TERM 符合 *screen* 時才應進行轉換。"
          }
        }
      }
    },
    "AdvancedSetting.convertTabDragToWindowDragForSolitaryTabInCompactOrMinimalTheme" : {
      "comment" : "Advanced setting: convertTabDragToWindowDragForSolitaryTabInCompactOrMinimalTheme",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll in den Designs „Minimal“ und „Kompakt“ bei nur einem Tab und sichtbarer Tableiste das Ziehen der Tableiste das Fenster verschieben?\nDies betrifft auch Fenster ohne Titelleiste in jedem Design."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal and Compact themes when there is a single tab and the tab bar is visible, should dragging the tab bar move the window?\nThis also affects windows without titlebars in any theme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los temas minimalista y compacto, cuando hay una sola pestaña y la barra de pestañas es visible, ¿debe arrastrar la barra de pestañas mover la ventana?\nTambién afecta a las ventanas sin barra de título en cualquier tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les thèmes Minimal et Compact, lorsqu’il y a un seul onglet et que la barre d’onglets est visible, faire glisser la barre d’onglets doit-il déplacer la fenêtre ?\nCela concerne aussi les fenêtres sans barre de titre, quel que soit le thème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei temi Minimale e Compatto, quando c’è un solo pannello e la barra dei pannelli è visibile, trascinare la barra dei pannelli deve spostare la finestra?\nInfluisce anche sulle finestre senza barra del titolo in qualsiasi tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミニマルテーマとコンパクトテーマで、タブが 1 つだけでタブバーが表示されている場合、タブバーをドラッグするとウィンドウが移動するようにしますか?\nこれは、どのテーマでもタイトルバーのないウィンドウにも影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 및 컴팩트 테마에서 탭이 하나뿐이고 탭 막대가 보일 때 탭 막대를 드래그하면 윈도우를 이동합니까?\n이 설정은 모든 테마에서 제목 막대가 없는 윈도우에도 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos temas Minimal e Compact, quando há uma única aba e a barra de abas está visível, arrastar a barra de abas deve mover a janela?\nIsto também afeta janelas sem barras de título em qualquer tema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В темах Minimal и Compact, когда есть только одна вкладка и панель вкладок видна, должно ли перетаскивание панели вкладок перемещать окно?\nЭто также влияет на окна без строки заголовка в любой теме."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal ve Kompakt temalarda tek bir sekme varken ve sekme çubuğu görünürken, sekme çubuğunu sürüklemek pencereyi taşısın mı?\nBu, herhangi bir temada başlık çubuğu olmayan pencereleri de etkiler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Minimal 和 Compact 主题中，当只有一个标签页且标签页栏可见时，拖动标签页栏是否应该移动窗口？\n这同样影响任何主题中没有标题栏的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在極簡和精簡主題中，只有單一標籤頁且標籤頁列可見時，拖移標籤頁列是否應移動視窗？\n這也會影響任何主題中沒有標題列的視窗。"
          }
        }
      }
    },
    "AdvancedSetting.copyBackgroundColor" : {
      "comment" : "Advanced setting: copyBackgroundColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standardhintergrundfarbe ausschließen, wenn Text mit Farbe und Schriftstil kopiert wird?\nWenn deaktiviert, bleibt die Standardhintergrundfarbe ungesetzt. Abweichende Hintergrundfarben bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude the default background color when text is copied with color and font style?\nWhen off, the default background color will be left unset. Non-default background colors will remain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Excluir el color de fondo predeterminado al copiar texto con color y estilo de letra?\nSi está desactivado, el color de fondo predeterminado se dejará sin definir. Los colores de fondo no predeterminados se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclure la couleur d’arrière-plan par défaut lors de la copie de texte avec couleur et style de police ?\nSi cette option est désactivée, la couleur d’arrière-plan par défaut reste non définie. Les couleurs d’arrière-plan non par défaut sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludere il colore di sfondo predefinito quando il testo viene copiato con colore e stile del font?\nSe disattivato, il colore di sfondo predefinito resterà non impostato. I colori di sfondo non predefiniti resteranno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色とフォントスタイル付きでテキストをコピーする際、デフォルトの背景色を除外しますか?\nオフの場合、デフォルトの背景色は未設定のままになります。デフォルト以外の背景色はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트를 색상 및 서체 스타일과 함께 복사할 때 기본 배경색을 제외하겠습니까?\n끄면 기본 배경색은 설정되지 않은 상태로 남습니다. 기본값이 아닌 배경색은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir a cor de plano de fundo padrão quando o texto é copiado com cor e estilo de fonte?\nQuando desativado, a cor de plano de fundo padrão ficará sem definição. Cores de plano de fundo não padrão permanecerão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключать цвет фона по умолчанию при копировании текста с цветом и стилем шрифта?\nЕсли выключено, цвет фона по умолчанию останется незаданным. Нестандартные цвета фона сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin renk ve font stiliyle kopyalanırken varsayılan arka plan rengi hariç tutulsun mu?\nKapalıyken varsayılan arka plan rengi ayarlanmamış bırakılır. Varsayılan olmayan arka plan renkleri kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在复制文本时，是否应排除默认背景颜色以及字体样式？\n关闭此选项后，默认背景颜色将不设置。非默认背景颜色会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以顏色和字體樣式拷貝文字時，排除預設背景顏色？\n關閉時，預設背景顏色會保持未設定。非預設的背景顏色則會保留。"
          }
        }
      }
    },
    "AdvancedSetting.copyWithStylesByDefault" : {
      "comment" : "Advanced setting: copyWithStylesByDefault",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kopieren in die Zwischenablage bei Auswahl schließt Farbe und Schriftstil ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy to pasteboard on selection includes color and font style."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al copiar en el portapapeles al seleccionar, se incluyen el color y el estilo de letra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie dans le presse-papiers à la sélection inclut la couleur et le style de police."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia negli Appunti alla selezione include colore e stile del font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択時にペーストボードへコピーする際、色とフォントスタイルを含めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 시 클립보드에 복사할 때 색상 및 서체 스타일 포함"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia para a área de transferência na seleção inclui cor e estilo de fonte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копирование в буфер обмена при выделении включает цвет и стиль шрифта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimde panoya kopyalama renk ve font stilini içerir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制到 Pasteboard 时，是否应包含字体样式和颜色？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取時拷貝到剪貼簿的內容包含顏色和字體樣式。"
          }
        }
      }
    },
    "AdvancedSetting.cursorAnimationInputWindow" : {
      "comment" : "Advanced setting: cursorAnimationInputWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn animierte Cursorbewegung aktiviert ist, nur Bewegungen animieren, die innerhalb dieser Anzahl von Sekunden nach Ihrem letzten Tastendruck oder Ihrer letzten Mausaktion erfolgen.\nDadurch hinterlassen Programme, die den Bildschirm selbstständig neu zeichnen, wie etwa top, keine Streifen auf dem Bildschirm. Erhöhen Sie den Wert, wenn Sie eine langsame Verbindung verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When animated cursor movement is enabled, only animate a movement that happens within this many seconds of your last keystroke or mouse action.\nThis keeps programs that redraw the screen on their own, like top, from drawing streaks across the screen. Raise it if you use a slow connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el movimiento animado del cursor está activado, anima solo un movimiento que ocurra dentro de esta cantidad de segundos desde tu última pulsación de tecla o acción del ratón.\nEsto evita que los programas que redibujan la pantalla por su cuenta, como top, dibujen rastros por la pantalla. Auméntalo si usas una conexión lenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le déplacement animé du curseur est activé, n’animer que les déplacements survenant dans ce nombre de secondes après votre dernière frappe ou action de souris.\nCela évite que des programmes qui redessinent l’écran d’eux-mêmes, comme top, ne tracent des traînées sur l’écran. Augmentez-le si vous utilisez une connexion lente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il movimento animato del cursore è abilitato, anima solo un movimento che avviene entro questo numero di secondi dall’ultima pressione di un tasto o azione del mouse.\nQuesto evita che programmi che ridisegnano lo schermo da soli, come top, traccino strisce sullo schermo. Aumentalo se usi una connessione lenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソル移動のアニメーションが有効な場合、最後のキー入力またはマウス操作からこの秒数以内に起きた移動のみアニメーションを実行します。\nこれにより、top のように自動で画面を再描画するプログラムが画面上に筋を描くのを防ぎます。接続が遅い場合は値を大きくしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 이동 애니메이션이 켜져 있을 때 마지막 키 입력이나 마우스 동작 후 이 시간(초) 안에 일어난 이동만 애니메이션으로 표시합니다.\n이렇게 하면 top처럼 스스로 화면을 다시 그리는 프로그램이 화면에 줄무늬를 남기지 않습니다. 느린 연결을 사용한다면 값을 높이십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o movimento animado do cursor está ativado, só animar um movimento que ocorra dentro deste número de segundos após sua última tecla pressionada ou ação do mouse.\nIsso evita que programas que redesenham a tela por conta própria, como o top, deixem rastros pela tela. Aumente o valor se você usa uma conexão lenta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включена анимация перемещения курсора, анимировать только перемещения, произошедшие в течение указанного числа секунд после последнего нажатия клавиши или действия мышью.\nЭто не даёт программам, которые сами перерисовывают экран, например top, оставлять полосы на экране. Увеличьте значение, если у вас медленное соединение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasyonlu imleç hareketi etkinken, yalnızca son tuş vuruşunuzdan veya fare eyleminizden bu kadar saniye içinde gerçekleşen hareketi canlandır.\nBu, top gibi ekranı kendiliğinden yeniden çizen programların ekranda izler bırakmasını önler. Yavaş bir bağlantı kullanıyorsanız artırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用动画光标移动时，只对在您最后一次按键或鼠标操作后这么多秒内发生的移动执行动画。\n这可以防止 top 之类自行重绘屏幕的程序在屏幕上划出拖影。如果您使用的连接较慢，请调大此值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用游標移動動畫時，只對發生在你最後一次按鍵或滑鼠動作後這麼多秒內的移動加上動畫。\n這可避免像 top 這類自行重繪螢幕的程式在螢幕上畫出殘影。如果你使用較慢的連線，請調高此值。"
          }
        }
      }
    },
    "AdvancedSetting.cursorAnimationMinDistance" : {
      "comment" : "Advanced setting: cursorAnimationMinDistance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn animierte Cursorbewegung aktiviert ist, die Animation nur ausführen, wenn sich der Cursor um mindestens diese Distanz in Punkten bewegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When animated cursor movement is enabled, only perform animation if the cursor moves at least this distance in points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el movimiento animado del cursor está activado, realiza la animación solo si el cursor se mueve al menos esta distancia en puntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le déplacement animé du curseur est activé, n’animer que si le curseur se déplace d’au moins cette distance en points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il movimento animato del cursore è abilitato, esegui l’animazione solo se il cursore si sposta di almeno questa distanza in punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソル移動のアニメーションが有効な場合、カーソルがこのポイント数以上移動したときにのみアニメーションを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 이동 애니메이션이 활성화된 경우, 커서가 이 거리(포인트) 이상 이동할 때만 애니메이션을 수행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o movimento animado do cursor está ativado, só realizar a animação se o cursor mover pelo menos esta distância em pontos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включена анимация перемещения курсора, выполнять анимацию только если курсор перемещается как минимум на это расстояние в пунктах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animasyonlu imleç hareketi etkinken, yalnızca imleç en az bu mesafe (punto) kadar hareket ederse animasyon yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用动画光标移动时，只有当光标移动距离至少达到此点数时，才执行动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用游標移動動畫時，只有游標移動至少達此距離（點）才會執行動畫。"
          }
        }
      }
    },
    "AdvancedSetting.cursorSlideAnimationDuration" : {
      "comment" : "Advanced setting: cursorSlideAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer in Sekunden für die sanfte Cursor-Gleitanimation.\nDies betrifft die Cursorbewegungsoption „Sanftes Gleiten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds for smooth cursor slide animation.\nThis affects the \"Smooth slide\" cursor movement option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración en segundos de la animación suave de deslizamiento del cursor.\nAfecta a la opción de movimiento del cursor “Deslizamiento suave”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée en secondes de l’animation fluide de glissement du curseur.\nCela concerne l’option de déplacement du curseur « Glissement fluide »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata in secondi dell’animazione fluida di scorrimento del cursore.\nInfluisce sull’opzione di movimento del cursore “Scorrimento fluido”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スムーズなカーソルスライドアニメーションの継続時間 (秒単位)。\nこれは「スムーズなスライド」カーソル移動オプションに影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 커서 슬라이드 애니메이션의 지속 시간(초)\n“부드러운 슬라이드” 커서 이동 옵션에 영향을 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos para a animação suave de deslize do cursor.\nIsto afeta a opção de movimento de cursor “Deslize suave”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность в секундах для плавной анимации скольжения курсора.\nЭто влияет на параметр перемещения курсора «Плавное скольжение»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzgün imleç kayma animasyonunun saniye cinsinden süresi.\nBu, “Düzgün kayma” imleç hareketi seçeneğini etkiler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平滑光标滑动动画的持续时间（以秒为单位）。\n这影响“平滑滑动”光标移动选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平滑游標滑動動畫的持續時間，以秒為單位。\n這會影響「平滑滑動」游標移動選項。"
          }
        }
      }
    },
    "AdvancedSetting.cursorSlideAnimationMaxCells" : {
      "comment" : "Advanced setting: cursorSlideAnimationMaxCells",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale horizontale Distanz in Zellen für die sanfte Cursor-Gleitanimation.\nCursorbewegungen, die größer als dieser Wert sind, werden nicht animiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum horizontal distance in cells for smooth cursor slide animation.\nCursor movements larger than this will not animate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distancia horizontal máxima en celdas para la animación suave de deslizamiento del cursor.\nLos movimientos del cursor mayores que esto no se animarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance horizontale maximale en cellules pour l’animation fluide de glissement du curseur.\nLes déplacements du curseur plus grands ne sont pas animés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanza orizzontale massima in celle per l’animazione fluida di scorrimento del cursore.\nI movimenti del cursore più ampi di questo valore non vengono animati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スムーズなカーソルスライドアニメーションにおける、セル単位での最大水平移動距離。\nこれより大きなカーソル移動はアニメーションしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 커서 이동 애니메이션을 적용할 최대 가로 거리(셀 단위).\n이보다 큰 커서 이동에는 애니메이션이 적용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância horizontal máxima em células para a animação suave de deslize do cursor.\nMovimentos do cursor maiores que isto não serão animados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное горизонтальное расстояние в ячейках для плавной анимации скольжения курсора.\nПеремещения курсора, превышающие это значение, не будут анимироваться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzgün imleç kayma animasyonu için hücre cinsinden en büyük yatay mesafe.\nBundan büyük imleç hareketleri canlandırılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平滑光标滑动动画的最大水平单元格距离。\n超过此距离的光标移动不会产生动画效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平滑游標滑動動畫的最大水平距離，以字元格為單位。\n超過此距離的游標移動不會有動畫。"
          }
        }
      }
    },
    "AdvancedSetting.cursorSmearAnimationDuration" : {
      "comment" : "Advanced setting: cursorSmearAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer in Sekunden für die Cursoranimation „Große Bewegungen animieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds for the “Animate large movements” cursor animation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración en segundos de la animación del cursor “Animar movimientos grandes”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée en secondes de l’animation du curseur « Animer les grands déplacements »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata in secondi dell’animazione del cursore “Anima i movimenti ampi”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「大きな移動をアニメーション化」カーソルアニメーションの継続時間 (秒単位)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“큰 이동 애니메이션” 커서 애니메이션의 지속 시간(초)입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos para a animação de cursor “Animar movimentos grandes”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность в секундах для анимации курсора «Анимировать большие перемещения»."
          }
        },
        "tr" : {
