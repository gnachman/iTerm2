    "StatusBarSwiftyString.DetailedDescription" : {
      "comment" : "Detailed description of the interpolated string status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí vyhodnocení řetězce s vloženými výrazy, které mohou obsahovat proměnné relace nebo výstup registrovaných skriptovacích funkcí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser evalueringen af en streng med indlejrede udtryk, som kan indeholde sessionsvariabler eller output fra registrerede instruksfunktioner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das Ergebnis der Auswertung einer Zeichenfolge mit eingebetteten Ausdrücken an, die Sitzungsvariablen oder die Ausgabe registrierter Skriptfunktionen enthalten können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the evaluation of a string with inline expressions which may include session variables or the output of registered scripting functions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la evaluación de una cadena con expresiones en línea que pueden incluir variables de sesión o la salida de funciones de script registradas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää merkkijonon arvioinnin. Merkkijono voi sisältää upotettuja lausekkeita, jotka voivat käyttää istuntomuuttujia tai rekisteröityjen skriptifunktioiden tulostetta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l’évaluation d’une chaîne contenant des expressions en ligne, pouvant inclure des variables de session ou la sortie de fonctions de script enregistrées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la valutazione di una stringa con espressioni inline che possono includere variabili di sessione o l’output di funzioni di scripting registrate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション変数や登録済みのスクリプト関数の出力を含めることができるインライン式を持つ文字列の評価結果を表示します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 변수나 등록된 스크립팅 함수의 출력을 포함할 수 있는 인라인 표현식이 들어 있는 문자열의 평가 결과를 표시합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser resultatet av en streng med innebygde uttrykk som kan inneholde øktvariabler eller utdata fra registrerte skriptfunksjoner"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont het resultaat van een tekenreeks met inline expressies, die sessievariabelen of de uitvoer van geregistreerde scriptfuncties kunnen bevatten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje wynik obliczenia ciągu z wyrażeniami wbudowanymi, które mogą zawierać zmienne sesji lub dane wyjściowe zarejestrowanych funkcji skryptowych"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o resultado da avaliação de uma string com expressões inline que podem incluir variáveis de sessão ou a saída de funções de script registradas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает результат вычисления строки со встроенными выражениями, которые могут включать переменные сессии или результат работы зарегистрированных функций сценариев"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje vyhodnotenie reťazca s vloženými výrazmi, ktoré môžu obsahovať premenné relácie alebo výstup registrovaných skriptových funkcií"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže vrednotenje niza z vgrajenimi izrazi, ki lahko vključujejo spremenljivke seje ali izhod registriranih skriptnih funkcij"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar utvärderingen av en sträng med inbäddade uttryck som kan innehålla sessionsvariabler eller utdata från registrerade skriptfunktioner"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum değişkenlerini veya kayıtlı betik işlevlerinin çıktısını içerebilen satır içi ifadeler barındıran bir dizenin değerlendirmesini gösterir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị kết quả đánh giá của một chuỗi có biểu thức nội tuyến, có thể bao gồm biến phiên hoặc đầu ra của các hàm tập lệnh đã đăng ký"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示对包含内联表达式的字符串求值的结果，这些表达式可能包含会话变量或已注册脚本函数的输出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示含有內嵌運算式的字串的求值結果，運算式可包含工作階段變數或已註冊腳本函式的輸出"
          }
        }
      }
    },
