    "MenuTip.Toolbelt.RecentDirectories" : {
      "comment" : "Menu item help for the ‘Toolbelt.Recent Directories’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí nejčastěji používané adresáře seřazené podle kombinace četnosti a aktuálnosti použití. Vyžaduje integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser dine mest brugte mapper, sorteret efter en kombination af hyppighed og hvor nylig brugen er. Kræver Shell-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Ihre am häufigsten verwendeten Verzeichnisse, sortiert nach einer Kombination aus Häufigkeit und Aktualität der Nutzung. Erfordert Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows your most used directories, sorted by a combination of frequency and recency of use. Requires Shell Integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra tus directorios más usados, ordenados por una combinación de frecuencia y actualidad de uso. Requiere la integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää eniten käyttämäsi hakemistot, järjestettynä käyttötiheyden ja viimeaikaisuuden yhdistelmän mukaan. Vaatii komentotulkki-integraation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche vos répertoires les plus utilisés, triés selon une combinaison de la fréquence et de la récence d’utilisation. L’intégration du shell est requise."
          }
        },
        "it" : {
          "stringUnit" : {
