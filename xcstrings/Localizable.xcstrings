    "AdvancedSetting.darkThemeHasBlackTitlebar" : {
      "comment" : "Advanced setting: darkThemeHasBlackTitlebar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tmavé motivy mají okna terminálu ve výchozím stavu s černým záhlavím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørke temaer giver som standard terminalvinduer sorte titellinjer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkle Designs geben Terminalfenstern standardmäßig schwarze Titelleisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dark themes give terminal windows black title bars by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
