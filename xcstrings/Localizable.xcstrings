    "EventTrigger.Help.JobEnded" : {
      "comment" : "Help text for the Job Ended event trigger",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ausgelöst, wenn ein Prozess, der dem Job-Filter entspricht, die Abstammungskette des Vordergrundprozesses verlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fires when a process matching the job filter leaves the foreground-job ancestry chain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dispara cuando un proceso que coincide con el filtro de procesos sale de la cadena de ascendencia del proceso en primer plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déclenche quand un processus correspondant au filtre de processus quitte la chaîne d’ascendance du processus au premier plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si attiva quando un processo che corrisponde al filtro dei processi esce dalla catena di ascendenza del processo in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブフィルタに一致するプロセスがフォアグラウンドジョブの祖先チェーンから外れると発火します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 필터와 일치하는 프로세스가 포그라운드 작업 조상 체인에서 벗어날 때 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara quando um processo que corresponde ao filtro de processo deixa a cadeia de ancestralidade do processo em primeiro plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает, когда процесс, соответствующий фильтру процессов, покидает цепочку предков активного процесса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem filtresiyle eşleşen bir işlem, ön plan işlemi soy zincirinden çıktığında tetiklenir."
