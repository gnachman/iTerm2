    "AdvancedSetting.noSyncNeverAskAboutDEC2048Frustration" : {
      "comment" : "Advanced setting: noSyncNeverAskAboutDEC2048Frustration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
