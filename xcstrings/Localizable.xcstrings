    "Tmux.OpenTitleTab" : {
      "comment" : "Prompt to open a new tmux tab or use the default profile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální relace je relace tmux. Chcete vytvořit nový panel tmux, nebo použít výchozí profil?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aktuelle session er en tmux-session. Vil du oprette en ny tmux-fane eller bruge standardprofilen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Sitzung ist eine tmux-Sitzung. Möchten Sie einen neuen tmux-Tab erstellen oder das Standardprofil verwenden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The current session is a tmux session. Would you like to create a new tmux tab or use the default profile?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión actual es una sesión de tmux. ¿Quieres crear una nueva pestaña de tmux o usar el perfil predeterminado?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyinen istunto on tmux-istunto. Haluatko luoda uuden tmux-välilehden vai käyttää oletusprofiilia?"
