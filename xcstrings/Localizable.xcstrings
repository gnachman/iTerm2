    "SavePanel.WrongExtensionHeading" : {
      "comment" : "Heading warning that a filename extension is not allowed; first placeholder is the typed extension, second is the required extension",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können dieses Dokument nicht mit der Erweiterung „.%1$@“ am Ende des Namens speichern. Die erforderliche Erweiterung ist „.%2$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You cannot save this document with extension “.%1$@” at the end of the name. The required extension is “.%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes guardar este documento con la extensión “.%1$@” al final del nombre. La extensión obligatoria es “.%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas enregistrer ce document avec l’extension « .%1$@ » à la fin du nom. L’extension requise est « .%2$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi salvare questo documento con l’estensione “.%1$@” alla fine del nome. L’estensione richiesta è “.%2$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このドキュメントを名前の末尾が「.%1$@」となる拡張子で保存することはできません。必要な拡張子は「.%2$@」です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름 끝에 “.%1$@” 확장자를 붙여 이 문서를 저장할 수 없습니다. 필요한 확장자는 “.%2$@”입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível salvar este documento com a extensão “.%1$@” no final do nome. A extensão obrigatória é “.%2$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно сохранить этот документ с расширением «.%1$@» в конце имени. Требуемое расширение: «.%2$@»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu belgeyi adın sonunda “.%1$@” uzantısıyla kaydedemezsiniz. Gerekli uzantı “.%2$@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法以“.%1$@”作为名称后缀保存此文档。所需的扩展名为“.%2$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法以名稱結尾為「.%1$@」的副檔名儲存此文件。必要的副檔名為「.%2$@」。"
          }
        }
      }
    },
