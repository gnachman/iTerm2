    "Tip.0078.Body" : {
      "comment" : "Tip of the day body, id 0078",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⌥ při přetahování panelu a přesunete okno. To se hodí v motivech Kompaktní a Minimalistický, které mají jen velmi malou plochu pro přetahování okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold ⌥ nede, mens du trækker en fane, for at flytte vinduet. Det er nyttigt i temaerne Kompakt og Minimal, som har et meget lille område til at trække i vinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⌥ gedrückt, während Sie einen Tab ziehen, um das Fenster zu verschieben. Das ist besonders bei den Designs „Kompakt“ und „Minimal“ nützlich, die nur einen sehr kleinen Bereich zum Verschieben des Fensters bieten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥ while dragging a tab to move the window. This is useful in the Compact and Minimal themes, which have a very small area for dragging the window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ⌥ mientras arrastras una pestaña para mover la ventana. Es útil en los temas Compacto y Minimalista, que tienen un área muy pequeña para arrastrar la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ⌥ painettuna vetäessäsi välilehteä siirtääksesi ikkunaa. Tämä on hyödyllistä Kompakti- ja Minimaalinen-teemoissa, joissa ikkunan vetämiseen on hyvin pieni alue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌥ tout en faisant glisser un onglet pour déplacer la fenêtre. C’est utile avec les thèmes Compact et Minimal, qui offrent une très petite zone pour déplacer la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⌥ mentre trascini un pannello per spostare la finestra. È utile nei temi Compatto e Minimale, che hanno un’area molto piccola per trascinare la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥を押しながらタブをドラッグすると、ウィンドウを移動できます。ウィンドウをドラッグできる領域がとても小さいコンパクトテーマやミニマルテーマで便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥를 누른 채 탭을 드래그하면 윈도우를 이동할 수 있습니다. 윈도우를 드래그할 수 있는 영역이 매우 작은 컴팩트 및 미니멀 테마에서 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede ⌥ mens du drar en fane for å flytte vinduet. Dette er nyttig i temaene Kompakt og Minimal, som har et veldig lite område for å dra vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ⌥ ingedrukt terwijl je een tabblad sleept om het venster te verplaatsen. Dit is handig bij de thema’s Compact en Minimaal, die een zeer klein gebied hebben om het venster te slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ⌥ podczas przeciągania karty, aby przesunąć okno. Jest to przydatne w motywach Kompaktowy i Minimalny, które mają bardzo mały obszar do przeciągania okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥ pressionado ao arrastar uma aba para mover a janela. Isso é útil nos temas Compacto e Minimalista, que têm uma área muito pequena para arrastar a janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌥ при перетаскивании вкладки, чтобы переместить окно. Это удобно в темах «Компактная» и «Минимальная», где для перетаскивания окна отведена очень маленькая область."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⌥ pri ťahaní tabu a presuniete okno. Hodí sa to v témach Kompaktný a Minimalistický, ktoré majú na ťahanie okna veľmi malú plochu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med vlečenjem zavihka držite ⌥, da premaknete okno. To je uporabno pri temah Kompaktna in Minimalna, ki imata zelo majhno območje za vlečenje okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned ⌥ medan du drar en flik för att flytta fönstret. Det är användbart i temana Kompakt och Minimal, som har en mycket liten yta att dra fönstret i."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereyi taşımak için bir sekmeyi sürüklerken ⌥ tuşunu basılı tutun. Pencereyi sürüklemek için çok küçük bir alanı olan Kompakt ve Minimal temalarda kullanışlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ ⌥ khi kéo một tab để di chuyển cửa sổ. Điều này hữu ích trong các chủ đề Gọn và Tối giản, vốn có vùng kéo cửa sổ rất nhỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动标签页时按住 ⌥ 可移动窗口。在紧凑和极简主题中非常有用，因为该主题的窗口拖动区域非常小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移標籤頁時按住 ⌥ 即可移動視窗。這在「精簡」和「極簡」主題中特別有用，因為這兩種主題可用來拖移視窗的區域非常小。"
          }
        }
      }
    },
