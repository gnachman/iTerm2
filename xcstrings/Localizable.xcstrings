    "ChatAgent.TextTooLong" : {
      "comment" : "Chat message shown when the text to analyze exceeds the AI request size limit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Text k analýze byl příliš dlouhý. Vyberte jeho část a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Teksten, der skulle analyseres, var for lang. Markér en del af den, og prøv igen."
          }
        },
