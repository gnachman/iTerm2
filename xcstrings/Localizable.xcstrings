    "NaggingController.TmuxPasteBufferUpdated" : {
      "comment" : "Prompt asking whether to mirror the tmux paste buffer to the local clipboard",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
