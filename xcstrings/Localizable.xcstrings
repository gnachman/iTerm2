    "BrowserGateway.InvalidCodeSignature" : {
      "comment" : "Error shown when the browser plugin fails code signature verification",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis kódu pluginu v %@ je neplatný. Stáhněte ho znovu a ujistěte se, že ho antivirus nedává do karantény."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodesignaturen for pluginet ved %@ er ugyldig. Hent det igen, og sørg for, at dit antivirusprogram ikke sætter det i karantæne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Code-Signatur des Plugins unter %@ ist ungültig. Laden Sie es erneut herunter und stellen Sie sicher, dass Ihr Antivirenprogramm es nicht unter Quarantäne stellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The code signature of the plugin at %@ is invalid. Download it again, and ensure your anti-virus does not quarantine it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma de código del plugin en %@ no es válida. Descárgalo de nuevo y asegúrate de que tu antivirus no lo ponga en cuarentena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liitännäisen koodiallekirjoitus sijainnissa %@ on virheellinen. Lataa se uudelleen ja varmista, ettei virustorjuntasi siirrä sitä karanteeniin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de code du module situé à %@ n’est pas valide. Téléchargez-le à nouveau et assurez-vous que votre antivirus ne le met pas en quarantaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma del codice del plug-in in %@ non è valida. Scaricalo di nuovo e assicurati che l’antivirus non lo metta in quarantena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にあるプラグインのコード署名が無効です。もう一度ダウンロードし、ウイルス対策ソフトによって隔離されないようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 있는 플러그인의 코드 서명이 유효하지 않습니다. 다시 다운로드하고 바이러스 백신 프로그램이 플러그인을 격리하지 않도록 하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodesignaturen til tillegget i %@ er ugyldig. Last det ned på nytt, og sørg for at antivirusprogrammet ikke setter det i karantene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De codehandtekening van de plug-in op %@ is ongeldig. Download de plug-in opnieuw en zorg dat je antivirusprogramma die niet in quarantaine plaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis kodu wtyczki w %@ jest nieprawidłowy. Pobierz ją ponownie i upewnij się, że program antywirusowy jej nie poddaje kwarantannie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura de código do plugin em %@ é inválida. Transfira-o novamente e certifique-se de que seu antivírus não o coloque em quarentena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись кода плагина по пути %@ недействительна. Загрузите его снова и убедитесь, что антивирус не помещает его в карантин."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis kódu pluginu v %@ je neplatný. Stiahnite ho znovu a uistite sa, že ho antivírus nedáva do karantény."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis kode vtičnika na poti %@ je neveljaven. Znova ga prenesite in poskrbite, da ga protivirusni program ne postavi v karanteno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodsignaturen för pluginet på %@ är ogiltig. Hämta det igen och se till att ditt antivirusprogram inte sätter det i karantän."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentinin (%@) kod imzası geçersiz. Yeniden indirin ve virüsten koruma yazılımınızın onu karantinaya almadığından emin olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chữ ký mã của trình cắm tại %@ không hợp lệ. Hãy tải về lại và đảm bảo phần mềm diệt vi-rút không cách ly nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件在%@的代码签名无效。重新下载，并确保您的反病毒软件不会将其隔离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於 %@ 的外掛程式，其程式碼簽章無效。請重新下載，並確保你的防毒軟體沒有將它隔離。"
          }
        }
      }
    },
