    "AdvancedSetting.splitPaneSourceBorderColor" : {
      "comment" : "Advanced setting: splitPaneSourceBorderColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva vnějšího ohraničení zdrojového podokna při přesouvání/výměně rozděleného podokna.\nMá to být barva ve webovém stylu, #rrggbb. Pro barevný prostor p3 můžete použít také p3#rrggbb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farve på kilderudens ydre kant, når en opdelt rude flyttes/byttes.\nSkal være en farve i webstil, #rrggbb. Du kan også bruge p3#rrggbb til farverummet p3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbe des äußeren Rahmens des Quellbereichs beim Verschieben/Vertauschen eines geteilten Bereichs.\nSollte eine Farbe im Web-Format sein, #rrggbb. Sie können auch p3#rrggbb für den P3-Farbraum verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Color of source pane outer border when moving/swapping a split pane.\nShould be a web-style color, #rrggbb. You can also use p3#rrggbb for p3 color space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color del borde exterior del panel de origen al mover/intercambiar un panel dividido.\nDebe ser un color de estilo web, #rrggbb. También puedes usar p3#rrggbb para el espacio de color p3."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähdepaneelin ulkoreunuksen väri, kun jaettua paneelia siirretään tai vaihdetaan.\nTulee olla web-tyylinen väri, #rrggbb. Voit käyttää myös muotoa p3#rrggbb p3-värimaailmalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur de la bordure extérieure du volet source lors du déplacement/de l’échange d’un volet scindé.\nDoit être une couleur de style web, #rrggbb. Vous pouvez aussi utiliser p3#rrggbb pour l’espace colorimétrique P3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore del bordo esterno del riquadro di origine quando si sposta/scambia un riquadro diviso.\nDeve essere un colore in stile web, #rrggbb. Puoi usare anche p3#rrggbb per lo spazio colore p3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインを移動／入れ替えする際の移動元ペインの外側の枠線の色。\nウェブスタイルの色（#rrggbb）を指定してください。P3カラースペースにはp3#rrggbbも使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 패널을 이동/교체할 때 원본 패널의 바깥 테두리 색상.\n#rrggbb 같은 웹 형식 색상이어야 합니다. P3 색 공간에는 p3#rrggbb를 사용할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farge på den ytre kantlinjen til kilderuten når en delt rute flyttes/byttes.\nBør være en nettfarge, #rrggbb. Du kan også bruke p3#rrggbb for p3-fargerommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleur van de buitenrand van het bronpaneel bij het verplaatsen of wisselen van een gesplitst paneel.\nMoet een kleur in webstijl zijn, #rrggbb. Je kunt ook p3#rrggbb gebruiken voor de kleurruimte p3."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolor zewnętrznej obwódki panelu źródłowego podczas przenoszenia/zamiany panelu podzielonego.\nPowinien to być kolor w stylu webowym, #rrggbb. Możesz też użyć p3#rrggbb dla przestrzeni kolorów p3."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor da borda externa do painel de origem ao mover/trocar um painel dividido.\nDeve ser uma cor no estilo web, #rrggbb. Você também pode usar p3#rrggbb para o espaço de cores p3."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет внешней границы исходной панели при перемещении/обмене разделённых панелей.\nДолжен быть цветом в веб-формате, #rrggbb. Также можно использовать p3#rrggbb для цветового пространства P3."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farba vonkajšieho okraja zdrojového panela pri presúvaní/zamieňaní rozdeleného panela.\nMala by to byť farba v štýle webu, #rrggbb. Pre farebný priestor p3 môžete použiť aj p3#rrggbb."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva zunanjega roba izvornega podokna pri premikanju/zamenjavi razdeljenega podokna.\nBiti mora spletna barva, #rrggbb. Za barvni prostor p3 lahko uporabite tudi p3#rrggbb."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färg på källpanelens yttre kant när en delad panel flyttas/byts.\nSka vara en webbfärg, #rrggbb. Du kan också använda p3#rrggbb för färgrymden p3."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bölme taşınırken/değiştirilirken kaynak bölmenin dış kenarlık rengi.\nWeb tarzı bir renk olmalıdır, #rrggbb. P3 renk alanı için p3#rrggbb de kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu viền ngoài của khung nguồn khi di chuyển/hoán đổi khung chia.\nNên là màu kiểu web, #rrggbb. Bạn cũng có thể dùng p3#rrggbb cho không gian màu p3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动/交换分屏窗格时源窗格外边界的颜色。\n应为网页风格颜色，#rrggbb。也可使用p3#rrggbb表示p3颜色空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動/交換分割窗格時，來源窗格外框的顏色。\n應為網頁風格的顏色，#rrggbb。也可以使用 p3#rrggbb 表示 P3 色彩空間。"
          }
        }
      }
    },
