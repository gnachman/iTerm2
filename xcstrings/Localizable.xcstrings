    "StatusBarRPC.ScriptNotRunningFormat" : {
      "comment" : "Appended to the error message when a status bar script is not running; placeholder is the existing error message",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Zdá se, že skript neběží. Jeho spuštěním se problém možná vyřeší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Det ser ud til, at instruksen ikke kører. Det kan måske løse problemet at starte den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Es sieht so aus, als würde das Skript nicht laufen. Es zu starten könnte das Problem beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@It looks like the script is not running. Launching it might fix the problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Parece que el script no se está ejecutando. Iniciarlo podría solucionar el problema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Skripti ei näytä olevan käynnissä. Sen käynnistäminen saattaa korjata ongelman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Il semble que le script ne soit pas en cours d’exécution. Le lancer pourrait résoudre le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Sembra che lo script non sia in esecuzione. Avviarlo potrebbe risolvere il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@スクリプトが実行されていないようです。起動すると問題が解決する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@스크립트가 실행 중이 아닌 것 같습니다. 스크립트를 실행하면 문제가 해결될 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Skriptet ser ikke ut til å kjøre. Å starte det kan løse problemet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Het lijkt erop dat het script niet draait. Het starten ervan kan het probleem verhelpen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Wygląda na to, że skrypt nie jest uruchomiony. Jego uruchomienie może rozwiązać problem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Parece que o script não está em execução. Iniciá-lo pode resolver o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Похоже, скрипт не запущен. Его запуск может решить проблему."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Zdá sa, že skript nebeží. Jeho spustenie môže problém vyriešiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Videti je, da skript ni zagnan. Težavo bi morda odpravil njegov zagon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Skriptet verkar inte köras. Det kan hjälpa att starta det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Betik çalışmıyor gibi görünüyor. Başlatmak sorunu çözebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Có vẻ tập lệnh không đang chạy. Chạy nó có thể khắc phục sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@脚本似乎没有在运行。启动它或许可以解决问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@看起來腳本並未執行。啟動它或許能解決問題。"
          }
        }
      }
    },
