    "GPURenderer.Off.Idle" : {
      "comment" : "Shown in Help > GPU Renderer Availability: why GPU rendering is off in the current session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslování pomocí GPU je v aktuální relaci vypnuto, protože je relace nečinná. Metal v nečinnosti můžete zapnout v nabídce „Nastavení > Pokročilé“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-gengivelse er slået fra i den aktuelle session, fordi sessionen er passiv. Du kan slå Metal til under passivitet i Indstillinger > Avanceret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPU-Rendering ist in der aktuellen Sitzung deaktiviert, weil die Sitzung inaktiv ist. Sie können Metal im inaktiven Zustand in Einstellungen > Erweitert aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GPU rendering is off in the current session because the session is idle. You can enable Metal while idle in Settings > Advanced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El renderizado por GPU está desactivado en la sesión actual porque la sesión está inactiva. Puedes activar Metal durante la inactividad en Ajustes > Avanzado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-renderöinti on pois päältä nykyisessä istunnossa, koska istunto on toimeton. Voit ottaa Metalin käyttöön toimettomana kohdassa Asetukset > Lisävalinnat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu GPU est désactivé dans la session actuelle, car la session est inactive. Vous pouvez activer Metal pendant l’inactivité dans Réglages > Avancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendering GPU è disattivato nella sessione corrente perché la sessione è inattiva. Puoi abilitare Metal durante l’inattività in Impostazioni > Avanzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションがアイドル状態のため、現在のセッションではGPUレンダリングがオフになっています。アイドル時のMetalは「設定 > 詳細」で有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 유휴 상태이므로 현재 세션에서 GPU 렌더링이 꺼져 있습니다. 설정 > 고급에서 유휴 상태일 때도 Metal을 사용하도록 켤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-gjengivelse er av i gjeldende økt fordi økten er inaktiv. Du kan aktivere Metal under inaktivitet i «Innstillinger > Avansert»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-weergave is uitgeschakeld in de huidige sessie omdat de sessie inactief is. Je kunt Metal tijdens inactiviteit inschakelen via Instellingen > Geavanceerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderowanie GPU jest wyłączone w bieżącej sesji, ponieważ sesja jest bezczynna. Możesz włączyć Metal podczas bezczynności w Ustawienia > Zaawansowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renderização por GPU está desativada na sessão atual porque a sessão está ociosa. Você pode ativar o Metal durante a ociosidade em Ajustes > Avançado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг на GPU отключён в текущем сеансе, потому что сеанс неактивен. Вы можете включить Metal в неактивном состоянии в Настройках > Дополнительно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykresľovanie pomocou GPU je v aktuálnej relácii vypnuté, pretože relácia je nečinná. Metal pri nečinnosti môžete zapnúť v časti „Nastavenia > Rozšírené“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upodabljanje z GPU je v trenutni seji izklopljeno, ker je seja nedejavna. Metal med nedejavnostjo lahko omogočite v »Nastavitve > Napredno«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-rendering är av i den aktuella sessionen eftersom sessionen är inaktiv. Du kan aktivera Metal vid inaktivitet i ”Inställningar > Avancerat”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli oturumda GPU ile işleme kapalı, çünkü oturum boşta. Metal’i boştayken “Ayarlar > Gelişmiş” bölümünden etkinleştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết xuất GPU đang tắt trong phiên hiện tại vì phiên không hoạt động. Bạn có thể bật Metal khi không hoạt động trong Cài đặt > Nâng cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前会话中的 GPU 渲染已关闭，因为会话处于空闲状态。你可以在“设置 > 高级”中启用空闲时使用 Metal。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的工作階段已關閉 GPU 繪製，因為工作階段處於閒置狀態。你可以在「設定 > 進階」中啟用閒置時使用 Metal。"
          }
        }
      }
    },
    "GPURenderer.Off.Initializing" : {
      "comment" : "Shown in Help > GPU Renderer Availability: why GPU rendering is off in the current session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslování pomocí GPU je v aktuální relaci vypnuto, protože se inicializuje vykreslovací modul GPU. Brzy by měl být připraven."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-gengivelse er slået fra i den aktuelle session, fordi GPU-gengivelsesmotoren initialiseres. Den bør være klar snart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPU-Rendering ist in der aktuellen Sitzung deaktiviert, weil der GPU-Renderer initialisiert wird. Er sollte bald bereit sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GPU rendering is off in the current session because the GPU renderer is initializing. It should be ready soon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El renderizado por GPU está desactivado en la sesión actual porque el renderizador de GPU se está inicializando. Debería estar listo en breve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-renderöinti on pois päältä nykyisessä istunnossa, koska GPU-renderöijää alustetaan. Sen pitäisi olla pian valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu GPU est désactivé dans la session actuelle, car le moteur de rendu GPU s’initialise. Il devrait être prêt bientôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendering GPU è disattivato nella sessione corrente perché il motore di rendering GPU si sta inizializzando. Dovrebbe essere pronto a breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPUレンダラーが初期化中のため、現在のセッションではGPUレンダリングがオフになっています。まもなく準備が完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU 렌더러를 초기화하는 중이므로 현재 세션에서 GPU 렌더링이 꺼져 있습니다. 곧 준비됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-gjengivelse er av i gjeldende økt fordi GPU-gjengiveren initialiseres. Den bør være klar snart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-weergave is uitgeschakeld in de huidige sessie omdat de GPU-weergavemodule wordt gestart. Die zou snel gereed moeten zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderowanie GPU jest wyłączone w bieżącej sesji, ponieważ mechanizm renderowania GPU się inicjalizuje. Wkrótce powinien być gotowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renderização por GPU está desativada na sessão atual porque o renderizador de GPU está inicializando. Deve estar pronto em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг на GPU отключён в текущем сеансе, потому что GPU-рендерер инициализируется. Скоро он будет готов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykresľovanie pomocou GPU je v aktuálnej relácii vypnuté, pretože sa inicializuje vykresľovací modul GPU. Mal by byť čoskoro pripravený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upodabljanje z GPU je v trenutni seji izklopljeno, ker se upodabljalnik GPU inicializira. Kmalu bi moral biti pripravljen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-rendering är av i den aktuella sessionen eftersom GPU-renderaren initieras. Den bör vara klar snart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli oturumda GPU ile işleme kapalı, çünkü GPU işleyici başlatılıyor. Yakında hazır olmalı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết xuất GPU đang tắt trong phiên hiện tại vì trình kết xuất GPU đang khởi tạo. Nó sẽ sớm sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前会话中的 GPU 渲染已关闭，因为 GPU 渲染器正在初始化，应该很快就可以就绪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的工作階段已關閉 GPU 繪製，因為 GPU 繪製器正在初始化，應該很快就會就緒。"
          }
        }
      }
    },
    "GPURenderer.Off.InternalError" : {
