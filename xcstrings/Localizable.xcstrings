    "NaggingController.OpenCommandSecureInput" : {
      "comment" : "Announcement explaining that the open command does not activate apps while Secure Keyboard Input is on",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkaz open neaktivuje jiné aplikace, když je zapnuto zabezpečené zadávání z klávesnice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandoen open aktiverer ikke andre programmer, når Sikker tastaturindtastning er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl open aktiviert keine anderen Apps, wenn Sichere Tastatureingabe aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The open command doesn't activate other apps when Secure Keyboard Input is enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El comando open no activa otras apps cuando la entrada segura de teclado está activada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-komento ei aktivoi muita sovelluksia, kun suojattu näppäimistösyöttö on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La commande open n’active pas les autres apps lorsque l’entrée clavier sécurisée est activée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il comando open non attiva altre app quando l’inserimento sicuro da tastiera è abilitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュアキーボード入力が有効な場合、openコマンドは他のアプリをアクティブにしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
