    "SavePanel.ExistsBodyDesktop" : {
      "comment" : "Body of the overwrite confirmation when the file is on the Desktop",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor nebo složka se stejným názvem už na ploše existuje. Nahrazením přepíšete jeho aktuální obsah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes allerede et arkiv eller en mappe med samme navn på skrivebordet. Hvis du erstatter det, overskrives dets nuværende indhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Schreibtisch ist bereits eine Datei oder ein Ordner mit demselben Namen vorhanden. Wenn Sie sie ersetzen, wird der aktuelle Inhalt überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A file or folder with the same name already exists on the Desktop. Replacing it will overwrite its current contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo o carpeta con el mismo nombre en el Escritorio. Al reemplazarlo, se sobrescribirá su contenido actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työpöydällä on jo samanniminen tiedosto tai kansio. Korvaaminen ylikirjoittaa sen nykyisen sisällön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier ou dossier du même nom existe déjà sur le bureau. Le remplacer écrasera son contenu actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file o una cartella con lo stesso nome sulla scrivania. La sostituzione sovrascriverà il contenuto attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前のファイルまたはフォルダがデスクトップに既に存在します。置き換えると、現在の内容が上書きされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑에 같은 이름의 파일 또는 폴더가 이미 있습니다. 대치하면 현재 내용을 덮어씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes allerede en fil eller mappe med samme navn på skrivebordet. Hvis du erstatter den, overskrives gjeldende innhold."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een bestand of map met dezelfde naam op het bureaublad. Als je het vervangt, wordt de huidige inhoud overschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik lub folder o tej samej nazwie już istnieje na biurku. Zastąpienie go spowoduje nadpisanie jego bieżącej zawartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo ou pasta com o mesmo nome já existe na Mesa. Substituí-lo irá sobrescrever o conteúdo atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл или папка с таким именем уже существуют на рабочем столе. Замена приведёт к перезаписи текущего содержимого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ploche už existuje súbor alebo priečinok s rovnakým názvom. Nahradením sa prepíše jeho aktuálny obsah."
