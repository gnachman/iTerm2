    "AdvancedSetting.drawOutlineAroundCursor" : {
      "comment" : "Advanced setting: drawOutlineAroundCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umrandung um Unterstrich- und vertikale Balken-Cursor mit der Hintergrundfarbe zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draw outline around underline and vertical bar cursors using background color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibujar un contorno alrededor de los cursores de subrayado y de barra vertical usando el color de fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiner un contour autour des curseurs de soulignement et de barre verticale avec la couleur d’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna un contorno attorno ai cursori a sottolineatura e a barra verticale usando il colore di sfondo."
          }
