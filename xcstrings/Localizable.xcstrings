    "CorruptApplication.SignatureValidUnexpected" : {
      "comment" : "Alert shown when a required resource is missing but the code signature is unexpectedly valid",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požadovaný soubor chybí nebo je poškozen, a přesto je podpis kódu aplikace iTerm2 navzdory všem očekáváním platný. Nahlaste prosím chybu na https://iterm2.com/bugs"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et nødvendigt arkiv mangler eller er beskadiget, men mod al forventning er kodesignaturen for iTerm2 gyldig. Rapporter en fejl på https://iterm2.com/bugs"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, doch wider Erwarten ist die Codesignatur von iTerm2 gültig. Bitte melden Sie einen Fehler unter https://iterm2.com/bugs"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted, yet against all odds the code signature for iTerm2 is valid. Please file a bug at https://iterm2.com/bugs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o que está dañado, pero, contra todo pronóstico, la firma de código de iTerm2 es válida. Informa del error en https://iterm2.com/bugs"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvittava tiedosto näyttää puuttuvan tai olevan vioittunut, mutta kaikista todennäköisyyksistä huolimatta iTerm2:n koodiallekirjoitus on kelvollinen. Ilmoita virheestä osoitteessa https://iterm2.com/bugs"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu, pourtant, contre toute attente, la signature de code d’iTerm2 est valide. Signalez un bogue sur https://iterm2.com/bugs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato, eppure, contro ogni previsione, la firma del codice di iTerm2 è valida. Segnala il problema su https://iterm2.com/bugs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようですが、意外なことにiTerm2のコード署名は有効です。https://iterm2.com/bugs でバグを報告してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이지만, 의외로 iTerm2의 코드 서명은 유효합니다. https://iterm2.com/bugs 에서 버그를 보고하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nødvendig fil ser ut til å mangle eller være skadet, men mot alle odds er kodesignaturen for iTerm2 gyldig. Meld fra om feilen på https://iterm2.com/bugs"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vereist bestand lijkt te ontbreken of beschadigd te zijn, maar tegen alle verwachtingen in is de codehandtekening van iTerm2 geldig. Meld een bug via https://iterm2.com/bugs"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje wymaganego pliku lub jest on uszkodzony, a mimo to podpis kodu iTerm2 jest prawidłowy. Zgłoś błąd na https://iterm2.com/bugs"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido, mas contra todas as probabilidades a assinatura de código do iTerm2 é válida. Registre um bug em https://iterm2.com/bugs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, однако вопреки всему цифровая подпись кода iTerm2 действительна. Пожалуйста, сообщите об ошибке на странице https://iterm2.com/bugs"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že chýba potrebný súbor alebo je poškodený, ale napriek všetkému je podpis kódu iTerm2 platný. Nahláste chybu na https://iterm2.com/bugs"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdi se, da manjka zahtevana datoteka ali je poškodovana, a podpis kode aplikacije iTerm2 je kljub vsem pričakovanjem veljaven. Napako prijavite na https://iterm2.com/bugs"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nödvändig fil verkar saknas eller vara skadad, men mot alla odds är kodsignaturen för iTerm2 giltig. Rapportera felet på https://iterm2.com/bugs"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor, ancak tüm olasılıklara rağmen iTerm2’nin kod imzası geçerli. Lütfen https://iterm2.com/bugs adresinden bir hata bildirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ một tệp bắt buộc bị thiếu hoặc bị hỏng, nhưng bất ngờ là chữ ký mã của iTerm2 vẫn hợp lệ. Vui lòng báo lỗi tại https://iterm2.com/bugs"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，但出乎意料的是 iTerm2 的代码签名是有效的。请向 https://iterm2.com/bugs 提交错误报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少必要的檔案或檔案已損毀，但出乎意料的是 iTerm2 的程式碼簽章是有效的。請前往 https://iterm2.com/bugs 回報錯誤。"
          }
        }
      }
    },
