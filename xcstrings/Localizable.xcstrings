    "StatusBarGit.SendCommandOverSshFormat" : {
      "comment" : "Warning shown before sending a git command over ssh; placeholder is the command",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als wären Sie per SSH verbunden. Befehl „%@“ senden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like you're sshed somewhere. OK to send the command “%@”?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que estás conectado por ssh a otro equipo. ¿Quieres enviar el comando “%@”?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous soyez connecté en ssh quelque part. Envoyer la commande « %@ » ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu sia connesso in ssh a un altro computer. Inviare il comando “%@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 接続中のようです。コマンド「%@」を送信してもよろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 곳에 ssh로 접속한 것 같습니다. “%@” 명령을 보내도 되겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está conectado via ssh a algum lugar. Tudo bem enviar o comando “%@”?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы подключены по SSH. Отправить команду «%@»?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yere ssh ile bağlanmış gibisiniz. “%@” komutu gönderilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来你已 ssh 到某处。发送命令“%@”？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起來你正透過 ssh 連到其他地方。要傳送指令「%@」嗎？"
          }
        }
      }
    },
