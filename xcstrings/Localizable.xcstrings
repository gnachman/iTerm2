          }
        }
      }
    },
    "GPURenderer.Off.VerticalSpacing" : {
      "comment" : "Shown in Help > GPU Renderer Availability: why GPU rendering is off in the current session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPU-Rendering ist in der aktuellen Sitzung deaktiviert, weil der vertikale Zeilenabstand der Schrift auf weniger als 100 % eingestellt ist. Sie können dies in Einstellungen > Profile > Text > „Schrift ändern“ anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GPU rendering is off in the current session because the font’s vertical spacing is set to less than 100%. You can change it in Settings > Profiles > Text > Change Font."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El renderizado por GPU está desactivado en la sesión actual porque el espaciado vertical del tipo de letra es inferior al 100%. Puedes cambiarlo en Ajustes > Perfiles > Texto > Cambiar tipo de letra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu GPU est désactivé dans la session actuelle, car l’interligne vertical de la police est inférieur à 100 %. Vous pouvez le modifier dans Réglages > Profils > Texte > Changer la police."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendering GPU è disattivato nella sessione corrente perché la spaziatura verticale del font è inferiore al 100%. Puoi modificarla in Impostazioni > Profili > Testo > Modifica font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォントの垂直方向の間隔が100%未満に設定されているため、現在のセッションではGPUレンダリングがオフになっています。「設定 > プロファイル > テキスト > フォントを変更」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서체의 세로 간격이 100% 미만으로 설정되어 있으므로 현재 세션에서 GPU 렌더링이 꺼져 있습니다. 설정 > 프로파일 > 텍스트 > 서체 변경에서 바꿀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renderização por GPU está desativada na sessão atual porque o espaçamento vertical da fonte está definido como menos de 100%. Você pode alterá-lo em Ajustes > Perfis > Texto > Alterar fonte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг на GPU отключён в текущем сеансе, потому что вертикальный интервал шрифта установлен менее 100%. Это можно изменить в Настройках > Профили > Текст > Изменить шрифт."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli oturumda GPU ile işleme kapalı, çünkü fontun dikey aralığı %100’ün altında ayarlı. Bunu “Ayarlar > Profiller > Metin > Fontu Değiştir” bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前会话中的 GPU 渲染已关闭，因为字体垂直间距设置为小于 100%。你可以在“设置 > 配置文件 > 文本 > 更改字体”中更改此设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的工作階段已關閉 GPU 繪製，因為字體的垂直間距設為小於 100%。你可以在「設定 > 描述檔 > 文字 > 變更字體」中變更。"
          }
        }
      }
    },
    "GPURenderer.Off.WindowObscured" : {
