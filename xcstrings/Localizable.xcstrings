    "AdapterPassword.FreshSessionRejected" : {
      "comment" : "Shown after a password manager rejects a login session it just issued; the placeholder is the password manager’s name, such as Bitwarden",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die bei Ihrer Anmeldung erstellte Sitzung abgelehnt. Daher versucht iTerm2 nicht mehr, sich erneut anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ rejected the session it created when you logged in, so iTerm2 stopped trying to log in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó la sesión que creó cuando iniciaste sesión, por lo que iTerm2 dejó de intentar iniciar sesión de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a rejeté la session qu’il a créée lors de votre connexion, donc iTerm2 a cessé de tenter de se reconnecter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rifiutato la sessione creata al momento dell’accesso, quindi iTerm2 ha smesso di provare ad accedere di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がログイン時に作成したセッションを拒否したため、iTerm2 は再ログインの試行を停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 로그인할 때 생성한 세션을 거부했으므로 iTerm2가 다시 로그인하려는 시도를 중단했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rejeitou a sessão que criou quando você fez login, então o iTerm2 parou de tentar fazer login novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отклонил сессию, созданную при вашем входе, поэтому iTerm2 прекратил попытки войти повторно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, oturum açtığınızda oluşturduğu oturumu reddetti; bu nedenle iTerm2 yeniden oturum açmayı denemeyi bıraktı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了您登录时它创建的会话，因此 iTerm2 已停止尝试重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒絕了你登入時它所建立的工作階段，因此 iTerm2 已停止嘗試重新登入。"
          }
        }
      }
    },
