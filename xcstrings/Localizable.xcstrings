        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitro odpri (⇧⌘O) je zdaj paleta ukazov! Vnesite ime menijskega elementa, da ga aktivirate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna snabbt (⇧⌘O) är nu en kommandopalett! Skriv bara namnet på ett menyobjekt för att aktivera det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı Aç (⇧⌘O) artık bir komut paleti! Etkinleştirmek için bir menü öğesinin adını yazmanız yeterli."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở nhanh (⇧⌘O) giờ là bảng lệnh! Chỉ cần gõ tên một mục menu để kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“快速打开”（⇧⌘O）现在是一个命令面板！只需输入菜单项名称即可激活它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「快速打開」（⇧⌘O）現在是一個指令面板！只要輸入選單項目的名稱即可啟動它。"
          }
        }
      }
    },
