    "Tip.0092.Body" : {
      "comment" : "Tip of the day body, id 0092",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení iTerm2 snadno zálohujte nebo přeneste pomocí funkce Exportovat/Importovat v „Nastavení > Obecné > Nastavení“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag nemt backup af dine iTerm2-indstillinger, eller overfør dem med funktionen Eksporter/Importer i “Indstillinger > Generelt > Indstillinger”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern oder übertragen Sie Ihre iTerm2-Einstellungen ganz einfach mit der Export-/Import-Funktion unter „Einstellungen > Allgemein > Einstellungen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Easily backup or transfer your iTerm2 settings using the Export/Import feature in “Settings > General > Settings”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una copia de seguridad de tus ajustes de iTerm2 o transfiérelos fácilmente con la función Exportar/Importar en “Ajustes > General > Ajustes”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopioi tai siirrä iTerm2:n asetukset helposti Vie/Tuo-toiminnolla kohdassa ”Asetukset > Yleiset > Asetukset”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegardez ou transférez facilement vos réglages iTerm2 avec la fonction Exporter/Importer dans « Réglages > Général > Réglages »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui facilmente il backup o il trasferimento delle impostazioni di iTerm2 con la funzione Esporta/Importa in “Impostazioni > Generali > Impostazioni”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > 一般 > 設定」のエクスポート/インポート機能を使うと、iTerm2の設定を簡単にバックアップしたり移行したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 일반 > 설정”의 내보내기/가져오기 기능을 사용하여 iTerm2 설정을 손쉽게 백업하거나 옮길 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta enkelt sikkerhetskopi av iTerm2-innstillingene dine eller overfør dem med funksjonen Eksporter/importer i «Innstillinger > Generelt > Innstillinger»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak eenvoudig een back-up van je iTerm2-instellingen of breng ze over met de functie Exporteer/Importeer in ‘Instellingen > Algemeen > Instellingen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z łatwością twórz kopię zapasową ustawień iTerm2 lub przenoś je, używając funkcji Eksportuj/Importuj w „Ustawienia > Ogólne > Ustawienia”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça backup ou transfira facilmente seus ajustes do iTerm2 usando o recurso Exportar/Importar em “Settings > General > Settings”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легко создавайте резервную копию или переносите настройки iTerm2 с помощью функции экспорта/импорта в «Настройки > Общие > Настройки»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia iTerm2 jednoducho zálohujte alebo prenesiete pomocou funkcie Exportovať/Importovať v časti „Nastavenia > Všeobecné > Nastavenia“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavitve iTerm2 enostavno varnostno kopirajte ali prenesite s funkcijo Izvozi/Uvozi v »Nastavitve > Splošno > Nastavitve«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopiera eller överför enkelt dina iTerm2-inställningar med funktionen Exportera/Importera i ”Inställningar > Allmänt > Inställningar”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ayarlarınızı “Ayarlar > Genel > Ayarlar” bölümündeki Dışa Aktar/İçe Aktar özelliğiyle kolayca yedekleyin veya aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dễ dàng sao lưu hoặc chuyển cài đặt iTerm2 của bạn bằng tính năng Xuất/Nhập trong “Cài đặt > Chung > Cài đặt”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可通过“设置 > 通用 > 设置”中的导出/导入功能轻松备份或传输 iTerm2 设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
