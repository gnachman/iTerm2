          }
        }
      }
    },
    "AdvancedSetting.noSyncNewTabFromTmuxOpensTmux" : {
      "comment" : "Advanced setting: noSyncNewTabFromTmuxOpensTmux",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnhinweis unterdrücken, der fragt, welche Art von Tab bei der tmux-Integration geöffnet werden soll.\nHINWEIS: Dies wird nur wirksam, wenn die inzwischen veraltete Einstellung „Warnhinweis unterdrücken, der fragt, welche Art von Tab/Fenster bei der tmux-Integration geöffnet werden soll“ deaktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress alert asking what kind of tab to open in tmux integration.\nNOTE: This only takes effect if the now-deprecated “Suppress alert asking what kind of tab/window to open in tmux integration” setting is off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la alerta que pregunta qué tipo de pestaña abrir en la integración con tmux.\nNOTA: Esto solo surte efecto si el ajuste obsoleto “Suprimir la alerta que pregunta qué tipo de pestaña/ventana abrir en la integración con tmux” está desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’alerte demandant quel type d’onglet ouvrir dans l’intégration tmux.\nREMARQUE : cela ne prend effet que si le réglage désormais obsolète « Désactiver l’alerte demandant quel type d’onglet/fenêtre ouvrir dans l’intégration tmux » est désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso che chiede che tipo di pannello aprire nell’integrazione tmux.\nNOTA: ha effetto solo se l’impostazione ora obsoleta “Disattiva l’avviso che chiede che tipo di pannello/finestra aprire nell’integrazione tmux” è disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合でどの種類のタブを開くかを尋ねるアラートを表示しない。\n注：これは、非推奨となった「tmux統合でどの種類のタブ／ウィンドウを開くかを尋ねるアラートを表示しない」設定がオフの場合にのみ有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합에서 열 탭의 종류를 묻는 경고 표시 안 함.\n참고: 이제 더 이상 사용되지 않는 “tmux 통합에서 열 탭/윈도우의 종류를 묻는 경고 표시 안 함” 설정이 꺼져 있을 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o alerta que pergunta que tipo de aba abrir na integração do tmux.\nNOTA: Isto só tem efeito se o ajuste agora obsoleto “Suprimir o alerta que pergunta que tipo de aba/janela abrir na integração do tmux” estiver desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить запрос о том, какую вкладку открыть при интеграции с tmux.\nПРИМЕЧАНИЕ. Это действует только в том случае, если устаревший параметр «Отключить запрос о том, какую вкладку/окно открыть при интеграции с tmux» выключен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux entegrasyonunda ne tür sekme açılacağını soran uyarıyı bir daha gösterme.\nNOT: Bu yalnızca artık kullanımdan kalkmış olan “tmux entegrasyonunda ne tür sekme/pencere açılacağını soran uyarıyı bir daha gösterme” ayarı kapalıysa etkili olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制tmux集成中打开标签页的提示。\n注意：仅当已废弃的“抑制tmux集成中打开标签页/窗口的提示”设置关闭时，此功能才生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示在 tmux 整合中詢問要打開哪種標籤頁的警示。\n注意：只有在已淘汰的「不再顯示在 tmux 整合中詢問要打開哪種標籤頁/視窗的警示」設定關閉時，此設定才會生效。"
          }
        }
      }
    },
