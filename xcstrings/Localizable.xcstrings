    "PTYSession.MouseReportingLeftOn" : {
      "comment" : "Announcement offering to turn off mouse reporting that was left enabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že hlášení myši zůstalo zapnuté po neočekávaném ukončení relace ssh nebo chybě aplikace. Vypnout ho?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at rapportering af mus blev ladt slået til, da en ssh-session sluttede uventet, eller et program fungerede forkert. Vil du slå den fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anscheinend wurde die Maus-Berichterstattung aktiviert gelassen, als eine SSH-Sitzung unerwartet endete oder sich eine App fehlerhaft verhielt. Ausschalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like mouse reporting was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que el informe del ratón se quedó activado cuando una sesión ssh terminó de forma inesperada o una app se comportó mal. ¿Desactivarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiiren raportointi näyttää jääneen päälle, kun ssh-istunto päättyi odottamatta tai sovellus toimi virheellisesti. Laitetaanko se pois päältä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que le signalement de la souris soit resté activé après la fin inattendue d’une session ssh ou le dysfonctionnement d’une app. Le désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che la segnalazione del mouse sia rimasta attiva dopo la fine inattesa di una sessione ssh o il malfunzionamento di un’app. Vuoi disattivarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが予期せず終了したか、アプリが誤動作したため、マウスレポートがオンのままになっているようです。オフにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 세션이 예기치 않게 종료되었거나 앱이 오작동하여 마우스 리포팅이 켜진 채로 남아 있는 것 같습니다. 끄겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at museapportering ble stående på da en ssh-økt tok uventet slutt eller et program oppførte seg feil. Vil du slå den av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat muisrapportage is blijven aanstaan nadat een ssh-sessie onverwacht eindigde of een app zich misdroeg. Wil je het uitschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że raportowanie myszy pozostało włączone po nieoczekiwanym zakończeniu sesji ssh lub nieprawidłowym działaniu aplikacji. Wyłączyć je?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que o relatório do mouse ficou ativado quando uma sessão ssh terminou inesperadamente ou um app se comportou mal. Desativar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, отслеживание мыши осталось включённым после неожиданного завершения SSH-сессии или сбоя приложения. Отключить его?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že hlásenie myši zostalo zapnuté po neočakávanom skončení relácie ssh alebo nesprávnom správaní aplikácie. Vypnúť ho?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da je poročanje miške ostalo vklopljeno, ker se je seja SSH nepričakovano končala ali pa se je aplikacija nepravilno obnašala. Ga želite izklopiti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut som att musrapportering lämnades på när en ssh-session avslutades oväntat eller ett program betedde sig fel. Vill du stänga av den?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ssh oturumu beklenmedik şekilde sona erdiğinde veya bir uygulama hatalı davrandığında fare raporlama açık kalmış gibi görünüyor. Kapatılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ báo cáo chuột đã bị để bật khi một phiên ssh kết thúc bất ngờ hoặc một ứng dụng hoạt động sai. Tắt nó đi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来 ssh 会话意外结束或应用异常时，鼠标上报仍处于开启状态。要关闭吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看來在 ssh 工作階段意外結束或 App 行為異常時，滑鼠回報被保持開啟。要將它關閉嗎？"
          }
        }
      }
    },
