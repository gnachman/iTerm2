          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3 als standaardkleurruimte gebruiken? Bij Nee wordt sRGB gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy używać P3 jako domyślnej przestrzeni kolorów? Jeśli Nie, zostanie użyta sRGB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar P3 como espaço de cor padrão? Se Não, será usado o sRGB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать P3 как цветовое пространство по умолчанию? Если нет, будет использоваться sRGB."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použiť P3 ako predvolený farebný priestor? Ak je vypnuté, použije sa sRGB."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se kot privzet barvni prostor uporabi P3? Če Ne, se uporabi sRGB."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använda P3 som förvalt färgrymd? Om Nej används sRGB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan renk alanı olarak P3 kullanılsın mı? Hayır ise sRGB kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng P3 làm không gian màu mặc định? Nếu chọn Không, sRGB sẽ được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
