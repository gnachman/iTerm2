    "APIHelper.RemoveNoAuthFailedMessage" : {
      "comment" : "Error message; first %@ is the file path, second %@ is the error description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei „%1$@“ konnte nicht entfernt werden: %2$@\n\nBitte entfernen Sie diese Datei manuell, damit für die Python-API eine Automatisierungsberechtigung erforderlich ist.\n\nDie Python-API wurde zu Ihrer Sicherheit deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Failed to remove the file “%1$@”: %2$@\n\nPlease remove this file manually to require Automation permission for the Python API.\n\nThe Python API has been disabled for your security."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル「%1$@」の削除に失敗しました: %2$@\n\nPython APIにオートメーション権限を要求させるには、このファイルを手動で削除してください。\n\nセキュリティのため、Python APIは無効になりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 “%1$@”을(를) 제거하지 못했습니다: %2$@\n\nPython API에 자동화 권한을 요구하려면 이 파일을 직접 제거하십시오.\n\n보안을 위해 Python API가 비활성화되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao remover o arquivo “%1$@”: %2$@\n\nRemova este arquivo manualmente para exigir a permissão de Automação para a API do Python.\n\nA API do Python foi desativada para sua segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить файл «%1$@»: %2$@\n\nУдалите этот файл вручную, чтобы для Python API снова требовалось разрешение Automation.\n\nВ целях безопасности Python API был отключён."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法删除文件“%1$@”： %2$@\n\n请手动删除此文件，以便为Python API授予自动化权限。\n\n出于安全考虑，Python API已被禁用。"
          }
        }
      }
    },
