    "PasswordArchive.AuthUnavailable" : {
      "comment" : "Shown when macOS can't authenticate the user before a password import or export. The placeholder is the system's reason.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can’t export or import passwords because macOS couldn’t confirm your identity. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann keine Passwörter exportieren oder importieren, weil macOS Ihre Identität nicht bestätigen konnte. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが本人確認を行えなかったため、iTerm2はパスワードをエクスポートまたはインポートできません。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 사용자 신원을 확인할 수 없어 iTerm2가 암호를 내보내거나 가져올 수 없습니다. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não pode exportar nem importar senhas porque o macOS não conseguiu confirmar sua identidade. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может экспортировать или импортировать пароли, потому что macOS не удалось подтвердить вашу личность. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法导出或导入密码，因为 macOS 无法确认你的身份。%@"
          }
        }
      }
    },
    "PasswordArchive.Conflict" : {
      "comment" : "Asked when an imported password matches a saved one; the placeholders are the account name and the user name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A saved password for “%1$@” with user name “%2$@” already exists. Replace it with the imported one?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gespeichertes Passwort für „%1$@“ mit dem Benutzernamen „%2$@“ ist bereits vorhanden. Durch das importierte ersetzen?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」のユーザー名「%2$@」の保存済みパスワードがすでに存在します。インポートしたパスワードで置き換えますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름이 “%2$@”인 “%1$@”의 저장된 암호가 이미 있습니다. 가져온 암호로 대치하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma senha salva para “%1$@” com o nome de usuário “%2$@”. Substituí-la pela importada?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый пароль для «%1$@» с именем пользователя «%2$@» уже существует. Заменить его импортированным?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存在“%1$@”的已保存密码，用户名为“%2$@”。要用导入的密码替换它吗？"
          }
        }
      }
    },
