    "APIHelper.ConfirmAlwaysAllowMessage" : {
      "comment" : "Confirmation prompt when enabling automatic Python API access",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Sitzungen enthalten eine Umgebungsvariable, die es Skripten ermöglicht, ohne Bestätigung ausgeführt zu werden. Sind Sie sicher, dass Sie dies aktivieren möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New sessions will contain an environment variable that allows scripts to run without confirmation. Are you sure you want to enable this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas sesiones contendrán una variable de entorno que permite ejecutar scripts sin confirmación. ¿Seguro que quieres activarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles sessions contiendront une variable d’environnement qui permet aux scripts de s’exécuter sans confirmation. Voulez-vous vraiment activer cette option ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove sessioni conterranno una variabile d’ambiente che consente l’esecuzione degli script senza conferma. Vuoi davvero abilitarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいセッションには、確認なしでスクリプトを実行できるようにする環境変数が含まれるようになります。これを有効にしてもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 세션에 스크립트가 확인 없이 실행될 수 있게 하는 환경 변수가 포함됩니다. 정말로 활성화하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As novas sessões conterão uma variável de ambiente que permite que scripts sejam executados sem confirmação. Tem certeza de que deseja ativar isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые сессии будут содержать переменную окружения, позволяющую скриптам запускаться без подтверждения. Вы уверены, что хотите включить это?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni oturumlar, betiklerin onay olmadan çalışmasına izin veren bir ortam değişkeni içerecek. Bunu etkinleştirmek istediğinizden emin misiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新会话将包含一个允许脚本无需确认即可运行的环境变量。确定要启用吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的工作階段將包含一個環境變數，讓腳本無需確認即可執行。確定要啟用嗎？"
          }
        }
      }
    },
