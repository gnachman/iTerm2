    "ImportExport.ImportConfirmBody" : {
      "comment" : "Body warning shown before importing settings and data",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna potřebná běhová prostředí Pythonu budou nainstalována a zabezpečená nastavení aktualizována, což může vyžadovat zadání hesla. Poté se iTerm2 restartuje a dokončí import. Může to trvat několik minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nødvendige Python-kørselsmiljøer installeres, og sikre indstillinger opdateres, hvilket kan kræve, at du skriver din adgangskode. Derefter starter iTerm2 igen og gør importen færdig. Det kan tage flere minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benötigte Python-Laufzeitumgebungen werden installiert und sichere Einstellungen werden aktualisiert, wofür möglicherweise Ihr Passwort erforderlich ist. Anschließend wird iTerm2 neu gestartet und schließt den Import ab. Dies kann einige Minuten dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Any needed Python runtimes will be installed and secure settings will be updated, which may require you to enter your password. Then iTerm2 will restart and finish importing. This can take several minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se instalarán los entornos de ejecución de Python necesarios y se actualizarán los ajustes seguros, lo que puede requerir que introduzcas tu contraseña. Después, iTerm2 se reiniciará y terminará la importación. Esto puede tardar varios minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvittavat Python-suoritusympäristöt asennetaan ja suojatut asetukset päivitetään, mikä voi edellyttää salasanasi antamista. Sen jälkeen iTerm2 käynnistyy uudelleen ja viimeistelee tuonnin. Tämä voi kestää useita minuutteja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les environnements d’exécution Python nécessaires seront installés et les réglages sécurisés seront mis à jour, ce qui peut vous demander de saisir votre mot de passe. iTerm2 redémarrera ensuite et terminera l’importation. Cela peut prendre plusieurs minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno installati gli ambienti di esecuzione Python necessari e aggiornate le impostazioni sicure, il che potrebbe richiedere l’inserimento della password. Poi iTerm2 si riavvierà e completerà l’importazione. Può richiedere diversi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要な Python ランタイムがインストールされ、セキュア設定が更新されます。この際、パスワードの入力を求められる場合があります。その後 iTerm2 が再起動してインポートを完了します。これには数分かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 Python 런타임이 설치되고 보안 설정이 업데이트되며, 이때 암호를 입력해야 할 수 있습니다. 그런 다음 iTerm2가 재시작되어 가져오기를 마칩니다. 몇 분 정도 걸릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nødvendige Python-kjøremiljøer installeres og sikre innstillinger oppdateres, noe som kan kreve at du skriver inn passordet ditt. Deretter starter iTerm2 på nytt og fullfører importen. Dette kan ta flere minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle benodigde Python-runtimes worden geïnstalleerd en beveiligde instellingen worden bijgewerkt, wat kan vereisen dat je je wachtwoord invoert. Daarna wordt iTerm2 herstart en de import voltooid. Dit kan enkele minuten duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie potrzebne środowiska uruchomieniowe Pythona zostaną zainstalowane, a ustawienia zabezpieczone uaktualnione, co może wymagać podania hasła. Następnie iTerm2 uruchomi się ponownie i dokończy importowanie. Może to potrwać kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os runtimes do Python necessários serão instalados e os ajustes seguros serão atualizados, o que pode exigir que você digite sua senha. Em seguida, o iTerm2 será reiniciado e concluirá a importação. Isso pode levar alguns minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все необходимые среды выполнения Python будут установлены, а защищенные настройки обновлены, для чего может потребоваться ввести пароль. Затем iTerm2 перезапустится и завершит импорт. Это может занять несколько минут."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky potrebné behové prostredia Python sa nainštalujú a zabezpečené nastavenia sa aktualizujú, pričom môže byť potrebné zadať heslo. Potom sa iTerm2 reštartuje a dokončí import. Môže to trvať niekoľko minút."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsa potrebna izvajalna okolja Python bodo nameščena in varne nastavitve posodobljene, kar morda zahteva vnos vašega gesla. Nato se bo iTerm2 znova zagnal in dokončal uvoz. To lahko traja nekaj minut."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nödvändiga Python-körmiljöer installeras och säkra inställningar uppdateras, vilket kan kräva att du anger ditt lösenord. Därefter startar iTerm2 om och slutför importen. Det kan ta flera minuter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gereken Python çalışma zamanları yüklenecek ve güvenli ayarlar güncellenecek; bunun için parolanızı girmeniz gerekebilir. Ardından iTerm2 yeniden başlayacak ve içe aktarmayı tamamlayacak. Bu birkaç dakika sürebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi môi trường chạy Python cần thiết sẽ được cài đặt và cài đặt bảo mật sẽ được cập nhật, việc này có thể yêu cầu bạn nhập mật khẩu. Sau đó iTerm2 sẽ khởi động lại và hoàn tất việc nhập. Quá trình này có thể mất vài phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何需要的 Python 运行时都将被安装，安全设置将被更新，这可能要求你输入密码。然后 iTerm2 将重新启动并完成导入。这可能需要几分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將會安裝所有需要的 Python 執行環境並更新安全設定，這可能需要你輸入密碼。接著 iTerm2 會重新啟動並完成匯入。這可能需要幾分鐘。"
          }
        }
      }
    },
