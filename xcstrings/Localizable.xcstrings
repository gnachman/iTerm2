    "SemanticHistory.OpenURLCaveat" : {
      "comment" : "Explanation of the open-URL semantic history action",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Semantic History auf einem Dateinamen aktivieren, öffnet der Browser eine URL.\nVerwenden Sie \\1 für den angeklickten Dateinamen und \\2 für die Zeilennummer. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you activate Semantic History on a filename, the browser opens a URL.\nUse \\1 for the filename you clicked on and \\2 for the line number. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando activas el historial semántico en un nombre de archivo, el navegador abre una URL.\nUsa \\1 para el nombre del archivo en el que hiciste clic y \\2 para el número de línea. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous activez l’historique sémantique sur un nom de fichier, le navigateur ouvre une URL.\nUtilisez \\1 pour le nom du fichier sur lequel vous avez cliqué et \\2 pour le numéro de ligne. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando attivi la cronologia semantica su un nome file, il browser apre un URL.\nUsa \\1 per il nome del file su cui hai fatto clic e \\2 per il numero di riga. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名でSemantic Historyを起動すると、ブラウザがURLを開きます。\nクリックしたファイル名には\\1を、行番号には\\2を使用してください。 "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름에서 시맨틱 히스토리를 활성화하면 브라우저가 URL을 엽니다.\n클릭한 파일 이름에는 \\1을, 줄 번호에는 \\2를 사용하십시오. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você ativa o Semantic History em um nome de arquivo, o navegador abre um URL.\nUse \\1 para o nome do arquivo que você clicou e \\2 para o número da linha. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При активации Semantic History для имени файла браузер открывает URL.\nИспользуйте \\1 для имени файла, по которому был выполнен щелчок, и \\2 для номера строки. "
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosya adında Anlamsal Geçmiş’i etkinleştirdiğinizde tarayıcı bir URL açar.\nTıkladığınız dosya adı için \\1, satır numarası için \\2 kullanın. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在文件名上激活语义历史记录时，浏览器会打开一个 URL。\n使用 \\1 表示你点按的文件名，\\2 表示行号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在檔案名稱上啟用語意歷史記錄時，瀏覽器會打開一個 URL。\n以 \\1 代表你按一下的檔案名稱，\\2 代表行號。 "
          }
        }
      }
    },
