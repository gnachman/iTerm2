    "Cockpit.NotifyWatchingTooltip" : {
      "comment" : "Tooltip for the notify button when it is armed and watching for a status change",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
