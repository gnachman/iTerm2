    "AdvancedSetting.showSSHFlowControlMonitor" : {
      "comment" : "Advanced setting: showSSHFlowControlMonitor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show a window with SSH Integration’s flow control state.\nFor the current session’s connection and every connection nested in it: the credit outstanding, the measured delays and rates, and charts of the last minute. Closing the window turns this off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fenster mit dem Flusssteuerungsstatus der SSH-Integration anzeigen.\nFür die Verbindung der aktuellen Sitzung und jede darin verschachtelte Verbindung: das ausstehende Guthaben, die gemessenen Verzögerungen und Raten sowie Diagramme der letzten Minute. Durch Schließen des Fensters wird dies ausgeschaltet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合のフロー制御の状態を表示するウインドウを表示します。\n現在のセッションの接続と、その中にネストされたすべての接続について、未消化のクレジット、計測された遅延とレート、直近 1 分間のグラフを表示します。ウインドウを閉じるとこの設定はオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합의 흐름 제어 상태를 보여 주는 윈도우를 표시합니다.\n현재 세션의 연결과 그 안에 중첩된 모든 연결에 대해 미사용 크레딧, 측정된 지연 및 속도, 최근 1분간의 차트를 보여 줍니다. 윈도우를 닫으면 이 설정이 꺼집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar uma janela com o estado do controle de fluxo da Integração SSH.\nPara a conexão da sessão atual e cada conexão aninhada nela: o crédito pendente, os atrasos e taxas medidos e gráficos do último minuto. Fechar a janela desativa este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показать окно с состоянием управления потоком интеграции с SSH.\nДля подключения текущего сеанса и каждого вложенного в него подключения: неизрасходованный кредит, измеренные задержки и скорости, а также графики за последнюю минуту. Закрытие окна отключает этот параметр."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示一个窗口，展示 SSH 集成的流量控制状态。\n针对当前会话的连接以及嵌套在其中的每个连接：显示未用完的额度、测得的延迟和速率，以及最近一分钟的图表。关闭该窗口会关闭此项。"
          }
        }
      }
    },
    "AdvancedSetting.showSecureKeyboardEntryIndicator" : {
      "comment" : "Advanced setting: showSecureKeyboardEntryIndicator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
