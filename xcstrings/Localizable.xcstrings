    "PseudoTerminal.TabTitleContextMistake" : {
      "comment" : "Warning shown when a tab title interpolated string references session variables incorrectly",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento interpolovaný řetězec se vyhodnocuje v kontextu panelu, nikoli relace. Pro přístup k proměnným aktuální relace použijte currentSession.sessionVariableNameHere"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne interpolerede streng evalueres i fanens kontekst, ikke sessionens kontekst. Brug currentSession.sessionVariableNameHere for at få adgang til variabler i den aktuelle session"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese interpolierte Zeichenfolge wird im Kontext des Tabs ausgewertet, nicht im Kontext der Sitzung. Um auf Variablen der aktuellen Sitzung zuzugreifen, verwenden Sie currentSession.sessionVariableNameHere"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This interpolated string is evaluated in the tab’s context, not the session’s context. To access variables in the current session, use currentSession.sessionVariableNameHere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cadena interpolada se evalúa en el contexto de la pestaña, no en el de la sesión. Para acceder a las variables de la sesión actual, usa currentSession.sessionVariableNameHere"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä interpoloitu merkkijono arvioidaan välilehden kontekstissa, ei istunnon kontekstissa. Käytä nykyisen istunnon muuttujia kirjoittamalla currentSession.sessionVariableNameHere"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette chaîne interpolée est évaluée dans le contexte de l’onglet, pas dans celui de la session. Pour accéder aux variables de la session actuelle, utilisez currentSession.sessionVariableNameHere"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa stringa interpolata viene valutata nel contesto del pannello, non in quello della sessione. Per accedere alle variabili della sessione corrente, usa currentSession.sessionVariableNameHere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この補間文字列はセッションのコンテキストではなく、タブのコンテキストで評価されます。現在のセッションの変数にアクセスするには、currentSession.sessionVariableNameHere を使用してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보간 문자열은 세션의 컨텍스트가 아니라 탭의 컨텍스트에서 평가됩니다. 현재 세션의 변수에 접근하려면 currentSession.sessionVariableNameHere를 사용하십시오"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne interpolerte strengen evalueres i fanens kontekst, ikke øktens kontekst. Bruk currentSession.sessionVariableNameHere for å få tilgang til variabler i gjeldende økt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze geïnterpoleerde tekenreeks wordt geëvalueerd in de context van het tabblad, niet van de sessie. Gebruik currentSession.sessionVariableNameHere voor toegang tot variabelen in de huidige sessie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten ciąg interpolowany jest obliczany w kontekście karty, a nie sesji. Aby uzyskać dostęp do zmiennych bieżącej sesji, użyj currentSession.sessionVariableNameHere"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta string interpolada é avaliada no contexto da aba, não no contexto da sessão. Para acessar variáveis na sessão atual, use currentSession.sessionVariableNameHere"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта интерполированная строка вычисляется в контексте вкладки, а не в контексте сеанса. Чтобы обратиться к переменным текущего сеанса, используйте currentSession.sessionVariableNameHere"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento interpolovaný reťazec sa vyhodnocuje v kontexte tabu, nie relácie. Ak chcete pristupovať k premenným aktuálnej relácie, použite currentSession.sessionVariableNameHere"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta interpoliran niz se ovrednoti v kontekstu zavihka, ne seje. Za dostop do spremenljivk v trenutni seji uporabite currentSession.sessionVariableNameHere"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här interpolerade strängen utvärderas i flikens kontext, inte sessionens. Använd currentSession.sessionVariableNameHere för att komma åt variabler i den aktuella sessionen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ara değerli dize, oturumun bağlamında değil sekmenin bağlamında değerlendirilir. Geçerli oturumdaki değişkenlere erişmek için currentSession.sessionVariableNameHere kullanın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuỗi nội suy này được đánh giá trong ngữ cảnh của tab, không phải của phiên. Để truy cập biến trong phiên hiện tại, hãy dùng currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字符串在标签页上下文中被计算，而非会话上下文。要访问当前会话中的变量，请使用 currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字串是在標籤頁的環境中求值，而非工作階段的環境。若要存取目前工作階段中的變數，請使用 currentSession.sessionVariableNameHere"
          }
        }
      }
    },
    "PseudoTerminal.TabTitleHelp" : {
      "comment" : "Explanatory text in the set-tab-title dialog",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je prázdné, panel převezme název aktivní relace. Proměnné a volání funkcí uzavřené v \\(…) budou nahrazeny svým vyhodnocením. Tento interpolovaný řetězec se vyhodnocuje v kontextu panelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er tomt, bruger fanen den aktive sessions titel. Variabler og funktionskald omsluttet af \\(…) erstattes med deres evaluering. Denne interpolerede streng evalueres i fanens kontekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dieses Feld leer ist, übernimmt der Tab den Titel der aktiven Sitzung. Variablen und Funktionsaufrufe in \\(…) werden durch ihre Auswertung ersetzt. Diese interpolierte Zeichenfolge wird im Kontext des Tabs ausgewertet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If this is empty, the tab takes the active session’s title. Variables and function calls enclosed in \\(…) will be replaced with their evaluation. This interpolated string is evaluated in the tab’s context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está vacío, la pestaña toma el título de la sesión activa. Las variables y llamadas a funciones entre \\(…) se sustituirán por su evaluación. Esta cadena interpolada se evalúa en el contexto de la pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on tyhjä, välilehti saa aktiivisen istunnon otsikon. Muuttujat ja funktiokutsut, jotka on suljettu merkintään \\(…), korvataan niiden arvolla. Tämä interpoloitu merkkijono arvioidaan välilehden kontekstissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ce champ est vide, l’onglet prend le titre de la session active. Les variables et appels de fonction entre \\(…) seront remplacés par leur évaluation. Cette chaîne interpolée est évaluée dans le contexte de l’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è vuoto, il pannello assume il titolo della sessione attiva. Le variabili e le chiamate di funzione racchiuse in \\(…) verranno sostituite dal loro risultato. Questa stringa interpolata viene valutata nel contesto del pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これが空の場合、タブはアクティブなセッションのタイトルを使用します。\\(…) で囲まれた変数や関数呼び出しは、その評価結果に置き換えられます。この補間文字列はタブのコンテキストで評価されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비어 있으면 탭은 활성 세션의 제목을 사용합니다. \\(…)로 둘러싼 변수와 함수 호출은 평가 결과로 대체됩니다. 이 보간 문자열은 탭의 컨텍스트에서 평가됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er tomt, bruker fanen tittelen til den aktive økten. Variabler og funksjonskall omsluttet av \\(…) erstattes med resultatet av evalueringen. Denne interpolerte strengen evalueres i fanens kontekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit leeg is, krijgt het tabblad de titel van de actieve sessie. Variabelen en functieaanroepen tussen \\(…) worden vervangen door hun resultaat. Deze geïnterpoleerde tekenreeks wordt geëvalueerd in de context van het tabblad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to pole jest puste, karta przyjmuje tytuł aktywnej sesji. Zmienne i wywołania funkcji ujęte w \\(…) zostaną zastąpione ich wynikiem. Ten ciąg interpolowany jest obliczany w kontekście karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver vazio, a aba assume o título da sessão ativa. Variáveis e chamadas de função entre \\(…) serão substituídas por seu resultado. Esta string interpolada é avaliada no contexto da aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это поле пустое, вкладка принимает заголовок активного сеанса. Переменные и вызовы функций, заключённые в \\(…), будут заменены результатом их вычисления. Эта интерполированная строка вычисляется в контексте вкладки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je prázdny, tab preberie názov aktívnej relácie. Premenné a volania funkcií v \\(…) sa nahradia svojím výsledkom. Tento interpolovaný reťazec sa vyhodnocuje v kontexte tabu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je prazno, zavihek prevzame naslov aktivne seje. Spremenljivke in klici funkcij v \\(…) bodo zamenjani z rezultatom. Ta interpoliran niz se ovrednoti v kontekstu zavihka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är tomt får fliken den aktiva sessionens titel. Variabler och funktionsanrop inom \\(…) ersätts med sitt utvärderade värde. Den här interpolerade strängen utvärderas i flikens kontext."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş bırakılırsa sekme, etkin oturumun başlığını alır. \\(…) içine alınan değişkenler ve işlev çağrıları, değerlendirme sonuçlarıyla değiştirilir. Bu ara değerli dize sekmenin bağlamında değerlendirilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu để trống, tab sẽ lấy tiêu đề của phiên đang hoạt động. Biến và lệnh gọi hàm nằm trong \\(…) sẽ được thay bằng kết quả đánh giá của chúng. Chuỗi nội suy này được đánh giá trong ngữ cảnh của tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若留空，标签页将采用活动会话的标题。用 \\(…) 括起来的变量和函数调用将被替换为其计算结果。此插值字符串将在标签页的上下文中求值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若留空，標籤頁會採用作用中工作階段的標題。以 \\(…) 括起來的變數和函式呼叫將被替換為其求值結果。此插值字串是在標籤頁的環境中求值。"
          }
        }
      }
    },
