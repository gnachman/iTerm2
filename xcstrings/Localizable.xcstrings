    "JobTree.ConfirmTerminate" : {
      "comment" : "Confirmation before terminating processes; %ld is the count",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sind Sie sicher? Dies könnte einen Prozess beenden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sind Sie sicher? Dies könnte %ld Prozesse beenden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "Are you sure? This may terminate one process."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "Are you sure? This may terminate %ld processes."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "本当によろしいですか？ %ld 個のプロセスが終了する可能性があります。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "확실합니까? 프로세스 %ld개가 종료될 수 있습니다."
