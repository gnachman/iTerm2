    "Tip.0059.Body" : {
      "comment" : "Tip of the day body, id 0059",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ^ při změně velikosti okna a nebude se přichytávat k mřížce znaků: můžete mu dát libovolnou velikost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold ^ nede, mens du ændrer størrelsen på et vindue, så springer det ikke til tegngitteret: du kan give det den størrelse, du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ^ gedrückt, während Sie die Größe eines Fensters ändern, damit es nicht am Zeichenraster einrastet: So können Sie es auf jede beliebige Größe bringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ^ while resizing a window and it won’t snap to the character grid: you can make it any size you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ^ mientras cambias el tamaño de una ventana y no se ajustará a la cuadrícula de caracteres: puedes darle el tamaño que quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ^ painettuna muuttaessasi ikkunan kokoa, niin se ei kohdistu merkkiruudukkoon: voit antaa sille minkä tahansa koon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ^ pendant que vous redimensionnez une fenêtre et elle ne s’alignera pas sur la grille de caractères : vous pouvez lui donner la taille que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ^ mentre ridimensioni una finestra e non si adatterà alla griglia dei caratteri: potrai darle la dimensione che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^を押しながらウィンドウのサイズを変更すると、文字グリッドにスナップしなくなり、好きなサイズに調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^ 키를 누른 채 윈도우 크기를 조절하면 문자 격자에 맞춰지지 않으므로 원하는 크기로 만들 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede ^ mens du endrer størrelsen på et vindu, så låses det ikke til tegnrutenettet: du kan gjøre det like stort som du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ^ ingedrukt terwijl je het formaat van een venster wijzigt en het klikt niet vast op het tekenraster: je kunt het elk gewenst formaat geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ^ podczas zmiany rozmiaru okna, a nie będzie ono przyciągane do siatki znaków: możesz nadać mu dowolny rozmiar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ^ pressionado ao redimensionar uma janela e ela não se ajustará à grade de caracteres: você pode deixá-la com qualquer tamanho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ^ при изменении размера окна, и оно не будет привязываться к сетке символов: вы сможете сделать его любого размера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ^ pri zmene veľkosti okna a nebude sa prichytávať k mriežke znakov: môžete mu dať ľubovoľnú veľkosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med spreminjanjem velikosti okna držite ^ in se ne bo prilegalo mreži znakov: velikost lahko nastavite poljubno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned ^ medan du ändrar ett fönsters storlek så fäster det inte mot teckenrutnätet: du kan göra det precis så stort du vill."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencereyi yeniden boyutlandırırken ^ tuşunu basılı tutun; karakter ızgarasına oturmaz ve istediğiniz boyutu verebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ ^ khi đổi kích thước cửa sổ và cửa sổ sẽ không bị khớp vào lưới ký tự: bạn có thể đặt kích thước tùy ý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整窗口大小时按住 ^ 键，窗口不会自动对齐字符网格；可任意设置大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整視窗大小時按住 ^，視窗就不會貼齊字元格線，你可以調整成任何想要的大小。"
          }
        }
      }
    },
