        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обходить ошибку macOS, из-за которой система без видимой причины перемещает окна на первый экран."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obísť chybu macOS, pri ktorej systém bezdôvodne presúva okná na prvý displej."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaobidi napako sistema macOS, pri kateri sistem brez pravega razloga premakne okna na prvi zaslon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kringgå en macOS-fel där operativsystemet flyttar fönster till första skärmen utan anledning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşletim sisteminin pencereleri sebepsiz yere ilk ekrana taşıdığı bir macOS hatasına geçici çözüm uygula."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khắc phục lỗi macOS tự ý chuyển cửa sổ sang màn hình đầu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解决 macOS 的一个缺陷：系统无理由将窗口移动到第一个显示器上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解決 macOS 的一個錯誤：作業系統無故將視窗移至第一個顯示器。"
