    "AdvancedSetting.jiggleTTYSizeOnClearBuffer" : {
      "comment" : "Advanced setting: jiggleTTYSizeOnClearBuffer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm nach Auswahl des Menüpunkts „Puffer leeren“ neu zeichnen.\nWenn aktiviert, wird die TTY-Größe nach dem Leeren des Puffers kurz geändert, damit die Shell oder die aktuelle App neu zeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Redraw the screen after the Clear Buffer menu item is selected.\nWhen enabled, the TTY size is briefly changed after clearing the buffer to cause the shell or current app to redraw."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バッファをクリア」メニュー項目を選択した後、画面を再描画します。\n有効にすると、バッファをクリアした後に TTY のサイズを一時的に変更し、シェルまたは現在のアプリに再描画させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버퍼 지우기 메뉴 항목을 선택한 후 화면을 다시 그립니다.\n켜면 버퍼를 지운 후 TTY 크기를 잠시 변경하여 셸이나 현재 앱이 화면을 다시 그리도록 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesenhar a tela após o item de menu Limpar buffer ser selecionado.\nQuando ativado, o tamanho do TTY é alterado brevemente após limpar o buffer para fazer o shell ou o app atual redesenhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перерисовывать экран после выбора пункта меню «Очистить буфер».\nПри включении размер TTY ненадолго изменяется после очистки буфера, чтобы вызвать перерисовку в оболочке или текущем приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“清除缓冲区”菜单项后重新绘制屏幕。\n启用后，在清空缓冲区后 TTY 大小会短暂改变，使 shell 或当前应用重新绘制。"
          }
        }
      }
    },
    "AdvancedSetting.killJobsInServersOnQuit" : {
      "comment" : "Advanced setting: killJobsInServersOnQuit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vom Benutzer ausgelöstes Beenden (⌘Q) von iTerm2 beendet alle laufenden Jobs.\nGilt nur, wenn die Sitzungswiederherstellung aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "User-initiated Quit (⌘Q) of iTerm2 will kill all running jobs.\nApplies only when session restoration is on."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーによる iTerm2 の終了 (⌘Q) は、実行中のすべてのジョブを終了させます。\nセッション復元がオンの場合にのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 iTerm2를 종료(⌘Q)하면 실행 중인 모든 작업이 강제 종료됩니다.\n세션 복원이 켜져 있을 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o iTerm2 iniciado pelo usuário (⌘Q) encerrará todos os processos em execução.\nAplica-se somente quando a restauração de sessão está ativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход из iTerm2 по инициативе пользователя (⌘Q) завершит все выполняющиеся задания.\nПрименяется только при включённом восстановлении сессий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的用户主动退出 (⌘Q) 会终止所有正在运行的作业。\n仅当会话恢复开启时适用。"
          }
        }
      }
    },
