          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé (%1$@ s) lors de l’évaluation de l’invocation « %2$@ ». Le délai a été dépassé en attendant le retour de %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (%1$@ s) durante la valutazione dell’invocazione “%2$@”. Il timeout si è verificato in attesa che %3$@ restituisse un valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼び出し「%2$@」の評価中にタイムアウトしました(%1$@秒)。タイムアウトは %3$@ の戻り値を待機中に発生しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호출 “%2$@”을(를) 평가하는 중 시간이 초과되었습니다(%1$@초). %3$@의 반환을 기다리는 동안 시간 초과가 발생했습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsavbrudd (%1$@ sek) under evaluering av påkallingen «%2$@». Tidsavbruddet oppsto mens det ble ventet på at %3$@ skulle returnere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time-out (%1$@ sec) bij het evalueren van aanroep ‘%2$@’. De time-out trad op tijdens het wachten tot %3$@ een waarde teruggaf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekroczono limit czasu (%1$@ s) podczas obliczania wywołania „%2$@”. Przekroczenie nastąpiło w oczekiwaniu na zwrócenie wartości przez %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo esgotado (%1$@ s) ao avaliar a invocação “%2$@”. O tempo se esgotou ao aguardar o retorno de %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайм-аут (%1$@ с) при вычислении вызова «%2$@». Тайм-аут произошёл при ожидании возврата значения от %3$@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časový limit (%1$@ s) uplynul pri vyhodnocovaní vyvolania „%2$@“. Časový limit uplynul pri čakaní na návratovú hodnotu z %3$@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovna omejitev (%1$@ s) je potekla med vrednotenjem priklica »%2$@«. Časovna omejitev je potekla med čakanjem na vrnitev funkcije %3$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsgränsen (%1$@ s) överskreds vid utvärdering av anropet ”%2$@”. Tidsgränsen överskreds medan %3$@ väntades returnera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%2$@” çağrısı değerlendirilirken zaman aşımına uğradı (%1$@ sn). Zaman aşımı, %3$@ işlevinin dönmesi beklenirken oluştu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hết thời gian chờ (%1$@ giây) khi đánh giá lệnh gọi “%2$@”. Tình trạng hết thời gian chờ xảy ra khi chờ %3$@ trả về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评估调用“%2$@”时超时了(%1$@秒)。该超时发生在等待%3$@返回的过程中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "求值呼叫「%2$@」時逾時（%1$@ 秒）。逾時發生在等待 %3$@ 傳回時。"
          }
        }
      }
    },
