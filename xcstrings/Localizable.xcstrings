    "Tip.0084.Body" : {
      "comment" : "Tip of the day body, id 0084",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessern Sie Ihre Befehlszeile mit dem „Auto-Composer“, der die Befehlszeile durch ein natives Steuerelement zur einfacheren Nutzung ersetzt. Erfordert Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improve your command line with the “auto composer”, which replaces the command line with a native control for ease of use. Requires shell integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora tu línea de comandos con el “compositor automático”, que reemplaza la línea de comandos por un control nativo para mayor comodidad. Requiere la integración con el shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliorez votre ligne de commande avec le « compositeur automatique », qui remplace la ligne de commande par un contrôle natif plus pratique. Nécessite l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliora la tua riga di comando con il “compositore automatico”, che sostituisce la riga di comando con un controllo nativo per maggiore comodità. Richiede l’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オートコンポーザー」でコマンドラインを改善しましょう。コマンドラインをネイティブのコントロールに置き換え、使いやすくします。シェル統合が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령행을 사용하기 쉬운 기본 컨트롤로 대체하는 “자동 컴포저”로 명령행을 개선해 보십시오. 셸 통합이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua linha de comando com o “auto compositor”, que substitui a linha de comando por um controle nativo para facilitar o uso. Requer o Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшите работу с командной строкой с помощью «автокомпозера», который заменяет командную строку нативным элементом управления для удобства использования. Требует интеграции с оболочкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut satırını kolay kullanım için yerel bir denetimle değiştiren “otomatik oluşturucu” ile komut satırınızı geliştirin. Kabuk entegrasyonu gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“自动 composer”改进你的命令行，该工具用原生控件替代命令行，便于使用。需要shell集成功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「自動編寫器」改善你的命令列，它會以原生控制項取代命令列，使用起來更輕鬆。需要 Shell 整合。"
          }
        }
      }
    },
