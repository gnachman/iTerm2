    "AdvancedSetting.validCharactersInSSHUserNames" : {
      "comment" : "Advanced setting: validCharactersInSSHUserNames",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platné znaky v uživatelských jménech SSH\nAlfanumerické znaky jsou vždy platné. Zde se určují další platné znaky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyldige tegn i SSH-brugernavne\nAlfanumeriske tegn er altid gyldige. Her angives andre gyldige tegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gültige Zeichen in SSH-Benutzernamen\nAlphanumerische Zeichen sind immer gültig. Dies legt weitere gültige Zeichen fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Valid characters in SSH user names\nAlphanumerics are always valid. This specifies other valid characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres válidos en nombres de usuario de SSH\nLos alfanuméricos siempre son válidos. Esto especifica otros caracteres válidos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallitut merkit SSH-käyttäjätunnuksissa\nAakkosnumeeriset merkit ovat aina sallittuja. Tämä määrittää muut sallitut merkit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractères valides dans les noms d’utilisateur SSH\nLes caractères alphanumériques sont toujours valides. Ce réglage indique les autres caractères valides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caratteri validi nei nomi utente SSH\nI caratteri alfanumerici sono sempre validi. Qui si specificano gli altri caratteri validi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHユーザー名で有効な文字\n英数字は常に有効です。これは、それ以外に有効な文字を指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 사용자 이름에 유효한 문자\n영숫자는 항상 유효합니다. 이 설정으로 그 밖의 유효한 문자를 지정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyldige tegn i SSH-brukernavn\nBokstaver og tall er alltid gyldige. Dette angir andre gyldige tegn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldige tekens in SSH-gebruikersnamen\nAlfanumerieke tekens zijn altijd geldig. Dit geeft andere geldige tekens op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawidłowe znaki w nazwach użytkowników SSH\nZnaki alfanumeryczne są zawsze prawidłowe. To ustawienie określa inne prawidłowe znaki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres válidos em nomes de usuário SSH\nCaracteres alfanuméricos são sempre válidos. Isto especifica outros caracteres válidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допустимые символы в именах пользователей SSH\nБуквы и цифры всегда допустимы. Здесь указываются остальные допустимые символы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platné znaky v užívateľských menách SSH\nAlfanumerické znaky sú vždy platné. Toto určuje ďalšie platné znaky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veljavni znaki v uporabniških imenih SSH\nAlfanumerični znaki so vedno veljavni. Tu določite druge veljavne znake."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giltiga tecken i SSH-användarnamn\nBokstäver och siffror är alltid giltiga. Här anges andra giltiga tecken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH kullanıcı adlarında geçerli karakterler\nAlfasayısal karakterler her zaman geçerlidir. Bu, diğer geçerli karakterleri belirtir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ký tự hợp lệ trong tên người dùng SSH\nChữ và số luôn hợp lệ. Mục này chỉ định các ký tự hợp lệ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 用户名中有效的字符。\n字母数字始终有效。此处指定了其他有效字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 使用者名稱中的有效字元\n英數字元一律有效。此設定指定其他有效字元。"
          }
        }
      }
    },
