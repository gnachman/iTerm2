    "AdvancedSetting.rightJustifyRTLLines" : {
      "comment" : "Advanced setting: rightJustifyRTLLines",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarovnat vpravo řádky v odstavcích se základním směrem psaní zprava doleva?\nVyžaduje zapnutí OBOU voleb „podpora textu zprava doleva“ i „automatická detekce směru psaní odstavce“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højrejuster linjer i afsnit med grundlæggende skriveretning fra højre mod venstre?\nKræver, at BÅDE “understøttelse af tekst fra højre mod venstre” og “automatisk registrering af afsnits skriveretning” er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen in Absätzen mit rechts-nach-links-Grundschreibrichtung rechtsbündig ausrichten?\nErfordert, dass SOWOHL „Unterstützung für Rechts-nach-links-Text“ ALS AUCH „Automatische Erkennung der Absatzschreibrichtung“ aktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Right-justify lines in paragraphs with base writing direction of right-to-left?\nRequires BOTH “right-to-left text support” and “auto-detect paragraph writing detection” to be enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Justificar a la derecha las líneas de párrafos con dirección de escritura base de derecha a izquierda?\nRequiere que estén activados AMBOS “compatibilidad con texto de derecha a izquierda” y “detección automática de la escritura de párrafos”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasataanko oikealle kappaleiden rivit, joiden perustekstisuunta on oikealta vasemmalle?\nEdellyttää, että SEKÄ ”oikealta vasemmalle -tekstin tuki” ETTÄ ”kappaleen kirjoitussuunnan automaattinen tunnistus” ovat käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aligner à droite les lignes des paragraphes dont le sens d’écriture de base est de droite à gauche ?\nNécessite l’activation de « prise en charge du texte de droite à gauche » ET de « détection automatique du sens d’écriture des paragraphes »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allineare a destra le righe nei paragrafi con direzione di scrittura di base da destra a sinistra?\nRichiede che siano attivi ENTRAMBI “Abilita il supporto per le scritture da destra a sinistra” e “Rilevare automaticamente la direzione di scrittura del paragrafo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本の書字方向が右から左の段落で、行を右揃えにするか？\n「右から左のテキストサポート」と「段落の書字方向を自動検出」の両方が有効である必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 쓰기 방향이 오른쪽에서 왼쪽인 문단의 줄을 오른쪽 정렬합니까?\n“오른쪽에서 왼쪽 텍스트 지원”과 “문단 쓰기 방향 자동 감지”가 모두 켜져 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyrejuster linjer i avsnitt med grunnleggende skriveretning høyre mot venstre?\nKrever at BÅDE «Aktiver støtte for skriftsystemer som skrives fra høyre mot venstre» og «automatisk gjenkjenning av avsnittets skriveretning» er aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels uitlijnen aan de rechterkant in alinea’s met een basisschrijfrichting van rechts naar links?\nVereist dat ZOWEL ‘ondersteuning voor tekst van rechts naar links’ ALS ‘automatische detectie van schrijfrichting van alinea’s’ is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy wyrównywać do prawej wiersze w akapitach o bazowym kierunku pisma od prawej do lewej?\nWymaga włączenia ZARÓWNO „Włącz obsługę pisma od prawej do lewej”, JAK I „automatycznego wykrywania kierunku pisma akapitów”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justificar à direita as linhas em parágrafos com direção de escrita base da direita para a esquerda?\nRequer que TANTO “suporte a texto da direita para a esquerda” QUANTO “detecção automática de direção de escrita de parágrafo” estejam ativados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивать по правому краю строки в абзацах с направлением письма справа налево?\nТребует, чтобы были включены ОБА параметра: «поддержка текста справа налево» и «автоопределение направления письма абзаца»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zarovnať vpravo riadky v odsekoch so základným smerom písania sprava doľava?\nVyžaduje, aby boli zapnuté OBE nastavenia „podpora textu sprava doľava“ aj „automatická detekcia smeru písania odseku“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se vrstice v odstavkih s privzeto smerjo pisanja od desne proti levi poravnajo desno?\nZahteva, da sta omogočena OBA »podpora za besedilo od desne proti levi« in »samodejno zaznavanje smeri pisanja odstavkov«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerjustera rader i stycken med höger-till-vänster som grundläggande skrivriktning?\nKräver att BÅDE ”stöd för höger-till-vänster-text” och ”automatisk identifiering av styckeskrivriktning” är aktiverade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel yazı yönü sağdan sola olan paragraflarda satırlar sağa yaslansın mı?\nHEM “Sağdan sola yazı sistemleri desteğini etkinleştir” HEM de “Paragraf yazı yönü ilk güçlü yönlü karaktere göre otomatik algılansın mı” seçeneklerinin etkin olmasını gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căn phải các dòng trong đoạn văn có hướng viết cơ sở từ phải sang trái?\nYêu cầu bật CẢ “hỗ trợ văn bản từ phải sang trái” và “tự động phát hiện hướng viết của đoạn văn”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当段落的基线书写方向为从右到左时，是否左右对齐行？\n需要同时启用“从右到左文本支持”和“自动检测段落书写检测”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本書寫方向為由右至左的段落，是否靠右對齊各行？\n需要同時啟用「由右至左文字支援」和「自動偵測段落書寫方向」。"
          }
        }
      }
    },
    "AdvancedSetting.runJobsInServers" : {
      "comment" : "Advanced setting: runJobsInServers",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout obnovu relací.\nObnova relací spouští procesy v oddělených procesech. Přežijí pády, vynucená ukončení i aktualizace.\nChcete-li tuto změnu uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå sessionsgendannelse til.\nSessionsgendannelse kører processer i separate processer. De overlever nedbrud, tvungen afslutning og opgraderinger.\nDu skal starte iTerm2 igen, for at denne ændring træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungswiederherstellung aktivieren.\nBei der Sitzungswiederherstellung laufen Jobs in separaten Prozessen. Sie überstehen Abstürze, erzwungenes Beenden und Aktualisierungen.\nSie müssen iTerm2 neu starten, damit diese Änderung wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable session restoration.\nSession restoration runs jobs in separate processes. They will survive crashes, force quits, and upgrades.\nYou must restart iTerm2 for this change to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la restauración de sesiones.\nLa restauración de sesiones ejecuta los procesos en procesos independientes. Sobreviven a fallos, cierres forzados y actualizaciones.\nDebes reiniciar iTerm2 para que este cambio surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota istunnon palautus käyttöön.\nIstunnon palautus suorittaa prosessit erillisissä prosesseissa. Ne säilyvät kaatumisista, pakkolopetuksista ja päivityksistä.\nSinun on käynnistettävä iTerm2 uudelleen, jotta tämä muutos tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer la restauration de session.\nLa restauration de session exécute les processus dans des processus séparés. Ils survivront aux plantages, aux forçages de fermeture et aux mises à niveau.\nVous devez redémarrer iTerm2 pour que cette modification prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il ripristino delle sessioni.\nIl ripristino delle sessioni esegue i processi in processi separati. Sopravvivono a crash, uscite forzate e aggiornamenti.\nDevi riavviare iTerm2 affinché questa modifica abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション復元を有効にする。\nセッション復元は、ジョブを別プロセスで実行します。これによりクラッシュ、強制終了、アップグレードを乗り越えてジョブが存続します。\nこの変更を反映させるにはiTerm2を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 복원 켜기\n세션 복원은 작업을 별도의 프로세스에서 실행합니다. 이 작업은 충돌, 강제 종료 및 업그레이드 후에도 유지됩니다.\n이 변경 사항을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver øktgjenoppretting.\nØktgjenoppretting kjører prosesser i separate prosesser. De overlever krasj, tvungen avslutning og oppgraderinger.\nDu må starte iTerm2 på nytt for at denne endringen skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel sessieherstel in.\nSessieherstel voert processen uit in aparte processen. Ze overleven crashes, geforceerd stoppen en upgrades.\nJe moet iTerm2 herstarten om deze wijziging te laten ingaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz przywracanie sesji.\nPrzywracanie sesji uruchamia procesy w osobnych procesach. Przetrwają awarie, wymuszone zakończenia i uaktualnienia.\nAby ta zmiana zaczęła działać, musisz uruchomić ponownie iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar a restauração de sessão.\nA restauração de sessão executa tarefas em processos separados. Eles sobreviverão a falhas, encerramentos forçados e atualizações.\nVocê precisa reiniciar o iTerm2 para que esta alteração tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить восстановление сеансов.\nПри восстановлении сеансов задачи выполняются в отдельных процессах. Они переживут сбои, принудительное завершение и обновления.\nЧтобы изменение этого параметра вступило в силу, необходимо перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť obnovu relácií.\nObnova relácií spúšťa procesy v samostatných procesoch. Prežijú pády, vynútené ukončenia aj aktualizácie.\nZmena sa prejaví až po reštartovaní iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči obnovo sej.\nObnova sej izvaja procese v ločenih procesih. Preživijo zrušitve, prisilne zaprtja in nadgradnje.\nZa uveljavitev te spremembe morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera sessionsåterställning.\nSessionsåterställning kör processer i separata processer. De överlever krascher, tvångsavslut och uppgraderingar.\nDu måste starta om iTerm2 för att den här ändringen ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum geri yüklemeyi etkinleştir.\nOturum geri yükleme, işlemleri ayrı süreçlerde çalıştırır. Bunlar çökmelerden, zorla çıkışlardan ve yükseltmelerden etkilenmez.\nBu değişikliğin etkili olması için iTerm2’yi yeniden başlatmanız gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật khôi phục phiên.\nKhôi phục phiên chạy các tiến trình trong các tiến trình riêng. Chúng sẽ còn sau khi gặp sự cố, buộc thoát và nâng cấp.\nBạn phải khởi động lại iTerm2 để thay đổi này có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用会话恢复。\n会话恢复会在独立进程中运行任务，这些任务能在崩溃、强制退出和升级中存活。\n必须重启iTerm2才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用工作階段回復。\n工作階段回復會在獨立的程序中執行工作，這些工作在當機、強制結束和升級後仍會保留。\n必須重新啟動 iTerm2 才會使此變更生效。"
          }
        }
      }
    },
    "AdvancedSetting.saveProfilesToRecentDocuments" : {
      "comment" : "Advanced setting: saveProfilesToRecentDocuments",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávat položky do Nedávných (v nabídce ikony v Docku) pro opětovné otevření nedávno použitých profilů jako panelů?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj emner til Seneste (i menuen for symbolet i Dock) for at åbne nyligt brugte profiler igen som faner?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge zu „Zuletzt verwendet“ (im Menü des Dock-Symbols) hinzufügen, um kürzlich verwendete Profile als Tabs erneut zu öffnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add items to Recents (in the dock icon's menu) to reopen recently used profiles as tabs?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Añadir ítems a Recientes (en el menú del icono del Dock) para reabrir como pestañas los perfiles usados recientemente?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisätäänkö kohteita Äskeiset-valikkoon (Dockin kuvakkeen valikossa), jotta äskettäin käytetyt profiilit voi avata uudelleen välilehtinä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter des éléments aux Récents (dans le menu de l’icône du Dock) pour rouvrir les profils récemment utilisés sous forme d’onglets ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere elementi a Recenti (nel menu dell’icona nel Dock) per riaprire come pannelli i profili usati di recente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近使用したプロファイルをタブとして再度開けるように、Dockアイコンのメニューの「最近使った項目」に追加するか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 사용한 프로파일을 탭으로 다시 열 수 있도록 (Dock 아이콘 메뉴의) 최근 사용 항목에 추가하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til objekter i Nylige (i menyen til Dock-symbolet) for å åpne nylig brukte profiler på nytt som faner?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdelen toevoegen aan Recent (in het menu van het Dock-symbool) om recent gebruikte profielen opnieuw als tabbladen te openen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy dodawać elementy do Ostatnich (w menu ikony w Docku), aby ponownie otwierać ostatnio używane profile jako karty?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar itens aos Recentes (no menu do ícone do dock) para reabrir perfis usados recentemente como abas?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлять элементы в «Последние» (в меню значка в Dock) для повторного открытия недавно использованных профилей в виде вкладок?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridávať položky do Nedávnych (v menu ikony v Docku) na opätovné otvorenie nedávno použitých profilov ako tabov?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se elementi dodajo med Nedavne (v meniju ikone v vrstici Dock), da se nedavno uporabljeni profili znova odprejo kot zavihki?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägga till objekt i Senaste (i menyn för symbolen i Dock) för att öppna nyligen använda profiler som flikar igen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son kullanılan profilleri sekme olarak yeniden açmak için Son Kullanılanlar’a (Dock simgesinin menüsünde) öğe eklensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm mục vào Gần đây (trong menu biểu tượng Dock) để mở lại các hồ sơ dùng gần đây dưới dạng tab?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否将项目添加到Recents（在 Dock图标菜单中），以便重新打开最近使用的配置文件作为标签页？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將項目加入「最近使用項目」（在 Dock 圖像的選單中），以便將最近使用的描述檔重新打開為標籤頁？"
          }
        }
      }
    },
    "AdvancedSetting.saveScrollBufferWhenClearing" : {
      "comment" : "Advanced setting: saveScrollBufferWhenClearing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládat vyrovnávací paměť posouvání při mazání obrazovky.\nPokud je zapnuto, uloží aktuální obrazovku do vyrovnávací paměti historie posouvání místo jejího smazání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem rullebufferen, når skærmen ryddes.\nNår det er slået til, gemmes den aktuelle skærm i rullebufferen i stedet for at blive ryddet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll-Puffer beim Leeren des Bildschirms speichern.\nBei Aktivierung wird der aktuelle Bildschirm in den Scrollback-Puffer gespeichert, anstatt ihn zu leeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save scroll buffer when clearing screen.\nWhen enabled, saves the current screen into scroll back buffer instead of clearing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el búfer de desplazamiento al borrar la pantalla.\nCuando está activado, guarda la pantalla actual en el búfer de desplazamiento en lugar de borrarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna vierityspuskuri, kun näyttö tyhjennetään.\nKun käytössä, nykyinen näyttö tallennetaan vierityspuskuriin sen tyhjentämisen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer le tampon de défilement lors de l’effacement de l’écran.\nSi activé, l’écran actuel est enregistré dans le tampon de défilement au lieu d’être effacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il buffer di scorrimento quando si cancella lo schermo.\nSe attivo, salva lo schermo corrente nel buffer di scorrimento invece di cancellarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面をクリアする際にスクロールバッファを保存する。\n有効にすると、画面をクリアする代わりに現在の画面をスクロールバックバッファに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면을 지울 때 스크롤 버퍼를 저장합니다.\n활성화하면 현재 화면을 지우는 대신 스크롤백 버퍼에 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre rullebufferen når skjermen tømmes.\nNår dette er aktivert, lagres gjeldende skjerm i tilbakerullingsbufferen i stedet for å tømmes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar de scrollbuffer bij het wissen van het scherm.\nAls dit is ingeschakeld, wordt het huidige scherm in de scrollbackbuffer bewaard in plaats van gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj bufor przewijania przy czyszczeniu ekranu.\nGdy włączone, zapisuje bieżący ekran w buforze przewijania zamiast go czyścić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar o buffer de rolagem ao limpar a tela.\nQuando ativado, salva a tela atual no buffer de histórico de rolagem em vez de limpá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять буфер прокрутки при очистке экрана.\nЕсли включено, сохраняет текущий экран в буфер прокрутки вместо его очистки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložiť buffer rolovania pri vymazaní obrazovky.\nKeď je zapnuté, aktuálna obrazovka sa namiesto vymazania uloží do buffera histórie rolovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrani medpomnilnik za pomikanje ob brisanju zaslona.\nČe je omogočeno, trenutni zaslon shrani v medpomnilnik za pomikanje namesto da ga počisti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara rullningsbufferten när skärmen rensas.\nNär det är aktiverat sparas den aktuella skärmen i rullningsbufferten i stället för att rensas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran temizlenirken kaydırma arabelleğini kaydet.\nEtkinse geçerli ekranı temizlemek yerine geri kaydırma arabelleğine kaydeder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu bộ đệm cuộn khi xóa màn hình.\nKhi bật, lưu màn hình hiện tại vào bộ đệm cuộn ngược thay vì xóa nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在清除屏幕时是否保存滚动缓冲区。\n启用后，将当前屏幕保存到滚动缓冲区中，而不是清空它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除螢幕時儲存捲動緩衝區。\n啟用後，會將目前的螢幕儲存到捲動記錄緩衝區，而不是清除它。"
          }
        }
      }
    },
    "AdvancedSetting.saveScrollbackWhenCursorMovesAbovePrompt" : {
      "comment" : "Advanced setting: saveScrollbackWhenCursorMovesAbovePrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit obrazovku do historie posouvání, když aplikace přesune kurzor nad výzvu.\nNěkteré programy v celé obrazovce, které nepoužívají vyrovnávací paměť alternativní obrazovky, překreslují tak, že přesunou kurzor na začátek obrazovky a přepíší vše, co tam bylo, čímž zničí obsah, který ještě vidíte. Je-li zapnuto, iTerm2 nejprve odroluje viditelnou obrazovku do historie, aby se obsah neztratil. Vyžaduje integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem skærmen i rullebufferen, når en app flytter markøren op over prompten.\nNogle fuldskærmsprogrammer, der ikke bruger den alternative skærmbuffer, gentegner ved at flytte markøren til toppen af skærmen og overskrive det, der var der, så indhold, du stadig kan se, ødelægges. Når det er slået til, ruller iTerm2 først den synlige skærm ind i historikken, så indholdet ikke går tabt. Kræver shell-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm in den Scrollback-Verlauf speichern, wenn eine App den Cursor über die Eingabeaufforderung bewegt.\nManche Vollbildprogramme, die nicht den alternativen Bildschirmpuffer verwenden, zeichnen neu, indem sie den Cursor an den oberen Bildschirmrand bewegen und dort bereits vorhandene Inhalte überschreiben, wodurch noch sichtbarer Inhalt zerstört wird. Bei Aktivierung verschiebt iTerm2 zunächst den sichtbaren Bildschirm in den Verlauf, damit kein Inhalt verloren geht. Erfordert Shell Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save the screen to scrollback when an app moves the cursor above the prompt.\nSome full-screen programs that don’t use the alternate screen buffer repaint by moving the cursor to the top of the screen and overwriting whatever was already there, destroying content you can still see. When enabled, iTerm2 first scrolls the visible screen into history so that content isn’t lost. Requires shell integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la pantalla en el historial de desplazamiento cuando una app mueve el cursor por encima del prompt.\nAlgunos programas de pantalla completa que no usan el búfer de pantalla alternativo se repintan moviendo el cursor a la parte superior de la pantalla y sobrescribiendo lo que había, destruyendo contenido que aún puedes ver. Cuando está activado, iTerm2 primero desplaza la pantalla visible al historial para que no se pierda el contenido. Requiere integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna näyttö vierityshistoriaan, kun sovellus siirtää kohdistimen komentokehotteen yläpuolelle.\nJotkin koko näytön ohjelmat, jotka eivät käytä vaihtoehtoista näyttöpuskuria, piirtävät uudelleen siirtämällä kohdistimen näytön yläreunaan ja ylikirjoittamalla sen, mitä siinä oli, jolloin yhä näkyvää sisältöä tuhoutuu. Kun käytössä, iTerm2 vierittää ensin näkyvän näytön historiaan, jotta sisältö ei katoa. Edellyttää komentotulkki-integraatiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer l’écran dans l’historique de défilement lorsqu’une app déplace le curseur au-dessus de l’invite.\nCertains programmes plein écran qui n’utilisent pas le tampon d’écran alternatif se redessinent en déplaçant le curseur en haut de l’écran et en écrasant ce qui s’y trouvait, détruisant du contenu encore visible. Si activé, iTerm2 fait d’abord défiler l’écran visible dans l’historique afin que ce contenu ne soit pas perdu. Nécessite l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva lo schermo nella cronologia di scorrimento quando un’app sposta il cursore sopra il prompt.\nAlcuni programmi a tutto schermo che non usano il buffer dello schermo alternativo ridisegnano spostando il cursore in cima allo schermo e sovrascrivendo ciò che c’era, distruggendo contenuti ancora visibili. Se attivo, iTerm2 prima fa scorrere lo schermo visibile nella cronologia, così il contenuto non va perso. Richiede l’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがカーソルをプロンプトより上に移動したとき、画面をスクロールバックに保存する。\n一部のフルスクリーンプログラムは、代替スクリーンバッファを使わずにカーソルを画面の一番上に移動して再描画を行い、まだ表示されていた内容を上書きして消してしまいます。有効にすると、iTerm2はコンテンツが失われないよう、まず表示中の画面を履歴にスクロールします。Shell Integrationが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 커서를 프롬프트 위로 이동할 때 화면을 스크롤백에 저장합니다.\n대체 화면 버퍼를 사용하지 않는 일부 전체 화면 프로그램은 커서를 화면 맨 위로 이동해 기존 내용을 덮어쓰는 방식으로 다시 그리므로, 아직 보이는 내용이 사라집니다. 이 설정을 켜면 iTerm2가 먼저 보이는 화면을 기록으로 스크롤하여 내용이 손실되지 않게 합니다. 셸 통합이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre skjermen i tilbakerullingen når et program flytter markøren over ledeteksten.\nNoen fullskjermprogrammer som ikke bruker den alternative skjermbufferen, tegner på nytt ved å flytte markøren øverst på skjermen og overskrive det som allerede var der, og ødelegger innhold du fortsatt kan se. Når dette er aktivert, ruller iTerm2 først den synlige skjermen inn i historikken slik at innholdet ikke går tapt. Krever skallintegrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar het scherm in de scrollback wanneer een app de cursor boven de prompt verplaatst.\nSommige schermvullende programma’s die de alternatieve schermbuffer niet gebruiken, tekenen opnieuw door de cursor naar boven op het scherm te verplaatsen en te overschrijven wat er al stond, waardoor inhoud die je nog kunt zien verloren gaat. Als dit is ingeschakeld, scrolt iTerm2 eerst het zichtbare scherm naar de geschiedenis zodat die inhoud niet verloren gaat. Vereist shell-integratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj ekran w buforze przewijania, gdy aplikacja przesuwa kursor powyżej znaku zachęty.\nNiektóre programy pełnoekranowe, które nie używają alternatywnego bufora ekranu, odrysowują się, przesuwając kursor na górę ekranu i nadpisując to, co tam było, niszcząc treść, którą nadal widzisz. Gdy włączone, iTerm2 najpierw przewija widoczny ekran do historii, aby treść nie została utracona. Wymaga integracji z powłoką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar a tela no histórico de rolagem quando um app move o cursor acima do prompt.\nAlguns programas de tela cheia que não usam o buffer de tela alternativo redesenham movendo o cursor para o topo da tela e sobrescrevendo o que já estava lá, destruindo conteúdo que você ainda pode ver. Quando ativado, o iTerm2 primeiro rola a tela visível para o histórico para que o conteúdo não seja perdido. Requer o Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять экран в историю прокрутки, когда приложение перемещает курсор выше приглашения.\nНекоторые полноэкранные программы, не использующие альтернативный экранный буфер, перерисовывают экран, перемещая курсор в начало экрана и перезаписывая уже имеющееся там содержимое, уничтожая то, что всё ещё видно. Если включено, iTerm2 сначала прокручивает видимый экран в историю, чтобы содержимое не терялось. Требуется Shell Integration."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložiť obrazovku do histórie rolovania, keď aplikácia presunie kurzor nad výzvu.\nNiektoré programy na celú obrazovku, ktoré nepoužívajú buffer alternatívnej obrazovky, prekresľujú tak, že presunú kurzor na vrch obrazovky a prepíšu všetko, čo tam bolo, čím zničia obsah, ktorý ešte vidíte. Keď je zapnuté, iTerm2 najprv posunie viditeľnú obrazovku do histórie, aby sa obsah nestratil. Vyžaduje integráciu shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrani zaslon v medpomnilnik za pomikanje, ko aplikacija premakne kazalec nad ukazni poziv.\nNekateri celozaslonski programi, ki ne uporabljajo medpomnilnika nadomestnega zaslona, se prerisujejo tako, da premaknejo kazalec na vrh zaslona in prepišejo, kar je bilo tam, kar uniči še vidno vsebino. Če je omogočeno, iTerm2 najprej pomakne vidni zaslon v zgodovino, da se vsebina ne izgubi. Zahteva integracijo lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara skärmen i rullningshistoriken när en app flyttar markören ovanför prompten.\nVissa helskärmsprogram som inte använder den alternativa skärmbufferten ritar om genom att flytta markören överst på skärmen och skriva över det som redan fanns där, vilket förstör innehåll som du fortfarande kan se. När det är aktiverat rullar iTerm2 först den synliga skärmen in i historiken så att innehållet inte går förlorat. Kräver skalintegrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama imleci istemin üzerine taşıdığında ekranı geri kaydırmaya kaydet.\nAlternatif ekran arabelleğini kullanmayan bazı tam ekran programlar, imleci ekranın en üstüne taşıyıp orada olanın üzerine yazarak yeniden boyama yapar ve hâlâ görebildiğiniz içeriği yok eder. Etkinse iTerm2 önce görünen ekranı geçmişe kaydırır, böylece içerik kaybolmaz. Kabuk entegrasyonu gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu màn hình vào cuộn ngược khi ứng dụng di chuyển con trỏ lên trên dấu nhắc.\nMột số chương trình toàn màn hình không dùng bộ đệm màn hình thay thế sẽ vẽ lại bằng cách đưa con trỏ lên đầu màn hình và ghi đè nội dung đang có, làm mất nội dung bạn vẫn còn thấy. Khi bật, iTerm2 trước tiên cuộn màn hình đang hiển thị vào lịch sử để nội dung không bị mất. Yêu cầu tích hợp shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当应用将光标移出提示符上方时，是否将屏幕保存到滚动缓冲区？\n某些全屏程序不使用备用屏幕缓冲，而是通过将光标移动到屏幕顶部并覆盖现有内容来重新绘制，从而破坏仍可看到的内容。启用后，iTerm2会先将可见屏幕滚动到历史记录中，避免内容丢失。需要shell集成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 App 將游標移到提示符號上方時，將螢幕儲存到捲動記錄。\n某些不使用替代螢幕緩衝區的全螢幕程式，會將游標移到螢幕頂端並覆寫原有內容來重新繪製，導致仍可看見的內容被破壞。啟用後，iTerm2 會先將可見的螢幕捲動到歷史記錄中，以免內容遺失。需要 Shell 整合。"
          }
        }
      }
    },
    "AdvancedSetting.saveToPasteHistoryWhenSecureInputEnabled" : {
      "comment" : "Advanced setting: saveToPasteHistoryWhenSecureInputEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
