    "AdvancedSetting.acceptOSC7" : {
      "comment" : "Advanced setting: acceptOSC7",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7 zum Festlegen von Benutzername, Hostname und Pfad akzeptieren. iTerm2 Shell-Integration meldet diese Informationen jetzt über OSC 7, daher deaktiviert das Ausschalten dieser Option auch die Erfassung von Benutzername, Hostname und Verzeichnis durch die Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accept OSC 7 to set username, hostname, and path. iTerm2 shell integration now reports this information using OSC 7, so turning this off also disables shell integration’s username, hostname, and directory tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar OSC 7 para definir el nombre de usuario, el nombre de host y la ruta. La integración con el shell de iTerm2 ahora informa de esta información mediante OSC 7, por lo que desactivarlo también desactiva el seguimiento del nombre de usuario, del nombre de host y del directorio de la integración con el shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepter OSC 7 pour définir le nom d’utilisateur, le nom d’hôte et le chemin. L’intégration du shell d’iTerm2 signale désormais ces informations via OSC 7, donc la désactiver désactive aussi le suivi du nom d’utilisateur, du nom d’hôte et du répertoire par l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetta OSC 7 per impostare nome utente, nome host e percorso. L’integrazione shell di iTerm2 ora comunica queste informazioni tramite OSC 7, quindi disattivarlo disabilita anche il rilevamento di nome utente, nome host e directory dell’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名、ホスト名、パスの設定にOSC 7を受け付ける。iTerm2のシェル統合はこの情報をOSC 7を使って報告するようになったため、これをオフにすると、シェル統合によるユーザー名、ホスト名、ディレクトリの追跡も無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7로 사용자 이름, 호스트 이름, 경로를 설정하도록 허용합니다. 이제 iTerm2 셸 통합은 OSC 7로 이 정보를 보고하므로, 이 옵션을 끄면 셸 통합의 사용자 이름, 호스트 이름, 디렉토리 추적도 꺼집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceitar OSC 7 para definir nome de usuário, nome do host e caminho. A integração de shell do iTerm2 agora relata essas informações usando OSC 7, portanto desativar isto também desativa o rastreamento de nome de usuário, nome do host e diretório pela integração de shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принимать OSC 7 для установки имени пользователя, имени хоста и пути. Интеграция с оболочкой iTerm2 теперь передаёт эту информацию через OSC 7, поэтому отключение этого параметра также отключает отслеживание имени пользователя, имени хоста и каталога интеграцией с оболочкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adını, ana makine adını ve yolu belirlemek için OSC 7’yi kabul et. iTerm2 kabuk entegrasyonu artık bu bilgiyi OSC 7 ile bildirir; bu nedenle bunu kapatmak, kabuk entegrasyonunun kullanıcı adı, ana makine adı ve dizin izlemesini de devre dışı bırakır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受 OSC 7，用于设置用户名、主机名和路径。iTerm2 的 Shell 集成现在使用 OSC 7 报告这些信息，因此关闭此项也会禁用 Shell 集成对用户名、主机名和目录的跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受 OSC 7 以設定使用者名稱、主機名稱和路徑。iTerm2 的 Shell 整合現在使用 OSC 7 回報這些資訊，因此關閉此項也會停用 Shell 整合對使用者名稱、主機名稱和目錄的追蹤。"
          }
        }
      }
    },
    "AdvancedSetting.activeUpdateCadence" : {
      "comment" : "Advanced setting: activeUpdateCadence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Bildwiederholrate (FPS), wenn die adaptive Bildwiederholrate deaktiviert ist.\nHinweis: Dieser Wert wird auf ARM-Macs für Displays mit mindestens 120 Hz verdoppelt. Änderungen an dieser Einstellung wirken sich nicht auf bestehende Sitzungen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum frame rate (FPS) when adaptive framerate is disabled.\nNote: this is doubled on ARM Macs for displays that support at least 120hz. Modifications to this setting will not affect existing sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de fotogramas máxima (FPS) cuando la velocidad de fotogramas adaptativa está desactivada.\nNota: se duplica en los Mac con procesador ARM para pantallas compatibles con al menos 120 Hz. Los cambios en este ajuste no afectan a las sesiones existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence d’images maximale (FPS) lorsque la fréquence d’images adaptative est désactivée.\nRemarque : elle est doublée sur les Mac ARM pour les écrans compatibles avec au moins 120 Hz. Les modifications de ce réglage n’affectent pas les sessions existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza fotogrammi massima (FPS) quando la frequenza fotogrammi adattiva è disabilitata.\nNota: sui Mac con processore ARM raddoppia per i display che supportano almeno 120 Hz. Le modifiche a questa impostazione non influiscono sulle sessioni esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートが無効な場合の最大フレームレート（FPS）。\n注: 120Hz以上に対応したディスプレイを使用しているARM Macでは、この値は2倍になります。この設定を変更しても、既存のセッションには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임률이 꺼져 있을 때의 최대 프레임률(FPS).\n참고: ARM Mac에서 120Hz 이상을 지원하는 디스플레이에서는 이 값이 두 배가 됩니다. 이 설정을 변경해도 기존 세션에는 영향을 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros máxima (FPS) quando a taxa de quadros adaptativa está desativada.\nObservação: isso é dobrado em Macs ARM para telas compatíveis com pelo menos 120 Hz. As alterações a esta configuração não afetam as sessões existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная частота кадров (FPS) при отключённой адаптивной частоте кадров.\nПримечание: на компьютерах Mac с ARM это значение удваивается для дисплеев с поддержкой не менее 120 Гц. Изменения этого параметра не затрагивают уже открытые сессии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlanabilir kare hızı devre dışıyken en yüksek kare hızı (FPS).\nNot: En az 120 Hz destekleyen ekranlarda ARM Mac’lerde bu değer ikiye katlanır. Bu ayarda yapılan değişiklikler mevcut oturumları etkilemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应帧率被禁用时的最大帧率（FPS）。\n注意：对于支持至少 120hz 显示器的 ARM Mac 设备，此值会翻倍。对该设置的修改不会影响现有会话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用自適應影格率時的最大影格率（FPS）。\n注意：對於支援至少 120hz 的顯示器，此值在 ARM Mac 上會加倍。變更此設定不會影響現有的工作階段。"
          }
        }
      }
    },
    "AdvancedSetting.adaptiveFrameRateThroughputThreshold" : {
      "comment" : "Advanced setting: adaptiveFrameRateThroughputThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsatzschwelle für die adaptive Bildwiederholrate.\nWenn mehr als diese Anzahl an Bytes pro Sekunde empfangen wird, wird die niedrigere Bildwiederholrate von 30 fps verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Throughput threshold for adaptive frame rate.\nIf more than this many bytes per second are received, use the lower frame rate of 30 fps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral de rendimiento para la velocidad de fotogramas adaptativa.\nSi se reciben más bytes por segundo que este valor, se usa la velocidad de fotogramas más baja de 30 fps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil de débit pour la fréquence d’images adaptative.\nSi plus de ce nombre d’octets par seconde sont reçus, la fréquence d’images plus basse de 30 FPS est utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglia di throughput per la frequenza fotogrammi adattiva.\nSe vengono ricevuti più di questo numero di byte al secondo, viene usata la frequenza fotogrammi inferiore di 30 fps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートのスループットしきい値。\n1秒あたりに受信するバイト数がこの値を超えた場合、より低い30 fpsのフレームレートを使用する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임 레이트의 처리량 임계값.\n초당 이 바이트 수보다 많이 수신되면 더 낮은 프레임 레이트인 30fps를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa de transferência para a taxa de quadros adaptativa.\nSe forem recebidos mais bytes por segundo do que este valor, use a taxa de quadros mais baixa de 30 fps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог пропускной способности для адаптивной частоты кадров.\nЕсли скорость приёма данных превышает это значение байт в секунду, используется более низкая частота кадров 30 fps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlanabilir kare hızı için verim eşiği.\nSaniyede bu kadar bayttan fazlası alınırsa daha düşük olan 30 fps kare hızı kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应帧率的吞吐量阈值。\n如果每秒接收的字节数超过此值，则使用较低的 30 fps 帧率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自適應影格率的傳輸量門檻。\n如果每秒接收的位元組數超過此值，則使用較低的 30 fps 影格率。"
          }
        }
      }
    },
    "AdvancedSetting.adblockListURL" : {
      "comment" : "Advanced setting: adblockListURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL für die Werbeblocker-Filterliste\nDies sollte eine JSON-Datei im WebKit-Content-Blocker-Format sein. Die Liste wird automatisch alle 24 Stunden heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL for ad blocking filter list\nThis should be a JSON file in WebKit content blocker format. The list is downloaded automatically every 24 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL de la lista de filtros de bloqueo de anuncios\nDebe ser un archivo JSON en el formato de bloqueador de contenido de WebKit. La lista se descarga automáticamente cada 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL de la liste de filtres de blocage des publicités\nIl doit s’agir d’un fichier JSON au format de bloqueur de contenu WebKit. La liste est téléchargée automatiquement toutes les 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL dell’elenco di filtri per il blocco degli annunci\nDeve essere un file JSON nel formato dei blocchi di contenuti di WebKit. L’elenco viene scaricato automaticamente ogni 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告ブロックフィルターリストのURL\nWebKitコンテンツブロッカー形式のJSONファイルである必要があります。このリストは24時間ごとに自動的にダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 차단 필터 목록 URL\nWebKit 콘텐츠 차단기 형식의 JSON 파일이어야 합니다. 목록은 24시간마다 자동으로 다운로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL da lista de filtros de bloqueio de anúncios\nDeve ser um arquivo JSON no formato de bloqueador de conteúdo do WebKit. A lista é transferida automaticamente a cada 24 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL списка фильтров для блокировки рекламы.\nЭто должен быть файл JSON в формате блокировщика содержимого WebKit. Список автоматически загружается каждые 24 часа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reklam engelleme filtre listesinin URL’si\nBu, WebKit içerik engelleyici biçiminde bir JSON dosyası olmalıdır. Liste her 24 saatte bir otomatik olarak indirilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "广告拦截过滤器列表的 URL。\n这应该是一个 WebKit 内容拦截器格式的 JSON 文件。该列表每 24 小时自动下载一次"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "廣告封鎖過濾清單的 URL\n這應該是 WebKit 內容封鎖器格式的 JSON 檔案。此清單每 24 小時自動下載一次。"
          }
        }
      }
    },
    "AdvancedSetting.addDynamicTagToDynamicProfiles" : {
      "comment" : "Advanced setting: addDynamicTagToDynamicProfiles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dynamischen Profilen ein Tag „Dynamic“ hinzu.\nWenn aktiviert, erhalten dynamische Profile ein Tag „Dynamic“, mit dem sie gefiltert oder identifiziert werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a 'Dynamic' tag to dynamic profiles.\nWhen enabled, dynamic profiles will have a 'Dynamic' tag added to them, which can be used to filter or identify them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir una etiqueta “Dynamic” a los perfiles dinámicos.\nSi se activa, a los perfiles dinámicos se les añadirá una etiqueta “Dynamic” que se puede usar para filtrarlos o identificarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un tag « Dynamic » aux profils dynamiques.\nSi cette option est activée, un tag « Dynamic » est ajouté aux profils dynamiques, ce qui permet de les filtrer ou de les identifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un tag “Dynamic” ai profili dinamici.\nSe abilitato, ai profili dinamici viene aggiunto un tag “Dynamic” che può essere usato per filtrarli o identificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動的プロファイルに「Dynamic」タグを追加する。\n有効にすると、動的プロファイルに「Dynamic」タグが追加され、フィルタリングや識別に利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일에 'Dynamic' 태그 추가.\n활성화하면 동적 프로파일에 'Dynamic' 태그가 추가되며, 이를 사용하여 동적 프로파일을 필터링하거나 식별할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar uma tag “Dynamic” aos perfis dinâmicos.\nQuando ativado, os perfis dinâmicos terão uma tag “Dynamic” adicionada, que pode ser usada para filtrá-los ou identificá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлять тег «Dynamic» к динамическим профилям.\nПри включении к динамическим профилям добавляется тег «Dynamic», который можно использовать для их фильтрации или идентификации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik profillere bir “Dynamic” etiketi ekle.\nEtkinleştirildiğinde dinamik profillere, bunları filtrelemek veya tanımlamak için kullanılabilecek bir “Dynamic” etiketi eklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在动态配置文件中添加‘动态’标签。\n启用后，动态配置文件将添加‘动态’标签，可用于过滤或识别它们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為動態描述檔加入「動態」標籤。\n啟用後，動態描述檔會加上「動態」標籤，可用來篩選或識別它們。"
          }
        }
      }
    },
    "AdvancedSetting.addTabButtonUsesCurrentProfile" : {
      "comment" : "Advanced setting: addTabButtonUsesCurrentProfile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll die Schaltfläche „Neuer Tab“ in der Tableiste das Profil der aktuellen Sitzung verwenden?\nWenn aktiviert, öffnet ein Klick auf die Schaltfläche „+“ einen neuen Tab mit dem Profil der aktuellen Sitzung anstelle des Standardprofils."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should the “new tab” button in the tab bar use the current session’s profile?\nWhen enabled, clicking the “+” button opens a new tab with the current session’s profile instead of the default profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe el botón de “nueva pestaña” de la barra de pestañas usar el perfil de la sesión actual?\nSi se activa, al hacer clic en el botón “+” se abre una nueva pestaña con el perfil de la sesión actual en lugar del perfil predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton « nouvel onglet » de la barre d’onglets doit-il utiliser le profil de la session actuelle ?\nSi cette option est activée, un clic sur le bouton « + » ouvre un nouvel onglet avec le profil de la session actuelle au lieu du profil par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante “nuovo pannello” nella barra dei pannelli deve usare il profilo della sessione corrente?\nSe abilitato, facendo clic sul pulsante “+” si apre un nuovo pannello con il profilo della sessione corrente invece del profilo predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーの「新規タブ」ボタンは現在のセッションのプロファイルを使用しますか？\n有効にすると、「+」ボタンをクリックした際にデフォルトのプロファイルではなく、現在のセッションのプロファイルで新規タブが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대의 “새로운 탭” 버튼에서 현재 세션의 프로파일을 사용하겠습니까?\n켜면 “+” 버튼을 클릭할 때 기본 프로파일 대신 현재 세션의 프로파일로 새로운 탭이 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão de “nova aba” na barra de abas deve usar o perfil da sessão atual?\nQuando ativado, clicar no botão “+” abre uma nova aba com o perfil da sessão atual em vez do perfil padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли кнопка «новая вкладка» на панели вкладок использовать профиль текущей сессии?\nПри включении нажатие кнопки «+» открывает новую вкладку с профилем текущей сессии вместо профиля по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğundaki “yeni sekme” düğmesi geçerli oturumun profilini kullansın mı?\nEtkinleştirildiğinde “+” düğmesini tıklamak, varsayılan profil yerine geçerli oturumun profiliyle yeni bir sekme açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应让标签页栏中的“新标签页”按钮使用当前会话的配置文件？\n如果启用，点击“+”按钮将打开一个使用当前会话配置文件的标签页，而非默认配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁列中的「新增標籤頁」按鈕是否應使用目前工作階段的描述檔？\n啟用後，按一下「+」按鈕會以目前工作階段的描述檔打開新標籤頁，而不是預設描述檔。"
          }
        }
      }
    },
