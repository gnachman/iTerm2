    "AdvancedSetting.navigatePanesInReadingOrder" : {
      "comment" : "Advanced setting: navigatePanesInReadingOrder",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Befehle „Nächster Bereich“ und „Vorheriger Bereich“ verwenden die Lesereihenfolge statt des Zeitpunkts der letzten Verwendung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Next Pane and Previous Pane commands use reading order, not the time of last use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos Panel siguiente y Panel anterior usan el orden de lectura, no la hora del último uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes Volet suivant et Volet précédent utilisent l’ordre de lecture et non l’heure de dernière utilisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I comandi Riquadro successivo e Riquadro precedente usano l’ordine di lettura, non l’ora dell’ultimo utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次のペイン」および「前のペイン」コマンドは、最後に使用した時刻ではなく読み取り順序を使用します。"
