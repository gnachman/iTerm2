    "AdvancedSetting.supportREPCode" : {
      "comment" : "Advanced setting: supportREPCode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout podporu escape sekvence REP (opakování předchozího znaku)?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå understøttelse af escapesekvensen REP (gentag forrige tegn) til?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützung für die Escape-Sequenz REP (vorheriges Zeichen wiederholen) aktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable support for REP (Repeat previous character) escape sequence?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar la compatibilidad con la secuencia de escape REP (repetir carácter anterior)?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
