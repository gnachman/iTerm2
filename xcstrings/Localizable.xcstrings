    "AdvancedSetting.allowDragOfTabIntoNewWindow" : {
      "comment" : "Advanced setting: allowDragOfTabIntoNewWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass ein Tab außerhalb einer vorhandenen Tableiste abgelegt wird, um ein neues Fenster zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow a tab to be dragged and dropped outside any existing tab bar to create a new window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir arrastrar y soltar una pestaña fuera de cualquier barra de pestañas existente para crear una nueva ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettre de faire glisser un onglet hors de toute barre d’onglets existante pour créer une nouvelle fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti di trascinare e rilasciare un pannello fuori da qualsiasi barra dei pannelli esistente per creare una nuova finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを既存のタブバーの外にドラッグ＆ドロップして新しいウィンドウを作成できるようにする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 기존 탭 막대 밖으로 드래그 앤 드롭하여 새로운 윈도우를 만들 수 있도록 허용."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que uma aba seja arrastada e solta fora de qualquer barra de abas existente para criar uma nova janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить перетаскивание вкладки за пределы существующей панели вкладок для создания нового окна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sekmenin, mevcut herhangi bir sekme çubuğunun dışına sürüklenip bırakılarak yeni pencere oluşturmasına izin ver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
