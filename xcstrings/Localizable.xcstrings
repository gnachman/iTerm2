        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用旧式的 find 和 paste 进度指示器视图。\n此更改仅影响新窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用舊式的尋找和貼上進度指示器檢視。\n此變更只會影響新視窗。"
          }
        }
      }
    },
