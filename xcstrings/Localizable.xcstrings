    "AppSignature.CorruptButValidSignature" : {
      "comment" : "Shown when a required file is corrupt but the signature is valid",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, dennoch ist die Code-Signatur von iTerm2 entgegen aller Erwartung gültig. Bitte melden Sie einen Fehler unter https://iterm2.com/bugs"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted, yet against all odds the code signature for iTerm2 is valid. Please file a bug at https://iterm2.com/bugs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o que está dañado, pero, contra todo pronóstico, la firma de código de iTerm2 es válida. Informa del error en https://iterm2.com/bugs"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu, pourtant, contre toute attente, la signature de code d’iTerm2 est valide. Signalez un bogue sur https://iterm2.com/bugs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato, eppure, contro ogni previsione, la firma del codice di iTerm2 è valida. Segnala un bug su https://iterm2.com/bugs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようですが、意外なことにiTerm2のコード署名は有効です。https://iterm2.com/bugs にバグを報告してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이지만, 의외로 iTerm2의 코드 서명은 유효합니다. https://iterm2.com/bugs 에서 버그를 보고하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido, mas contra todas as probabilidades a assinatura de código do iTerm2 é válida. Registre um bug em https://iterm2.com/bugs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, отсутствует или повреждён необходимый файл, но, вопреки всему, подпись кода iTerm2 действительна. Пожалуйста, сообщите об ошибке на https://iterm2.com/bugs"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor, ancak tüm olasılıklara karşın iTerm2’nin kod imzası geçerli. Lütfen https://iterm2.com/bugs adresinden hata bildirin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个必需文件似乎缺失或已损坏，但万幸 iTerm2 的代码签名仍然有效。请在 https://iterm2.com/bugs 报告问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有必要的檔案似乎遺失或已損毀，但出乎意料的是，iTerm2 的程式碼簽章仍然有效。請至 https://iterm2.com/bugs 回報錯誤"
          }
        }
      }
    },
