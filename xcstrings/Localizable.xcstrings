    "Tip.0049.Body" : {
      "comment" : "Tip of the day body, id 0049",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⇧⌥⌘ gedrückt und ziehen Sie eine Sitzung in eine andere, um geteilte Bereiche zu erstellen oder zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⇧⌥⌘ and drag a session into another session to create or change split panes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas ⇧⌥⌘ y arrastra una sesión sobre otra para crear o cambiar paneles divididos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⇧⌥⌘ et faites glisser une session sur une autre session pour créer ou modifier des volets scindés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⇧⌥⌘ e trascina una sessione su un’altra sessione per creare o modificare i riquadri divisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌥⌘を押しながらセッションを別のセッションにドラッグすると、分割ペインを作成したり変更したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌥⌘를 누른 채 세션을 다른 세션으로 드래그하여 분할 패널을 만들거나 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⇧⌥⌘ pressionado e arraste uma sessão para outra sessão para criar ou alterar painéis divididos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⇧⌥⌘ и перетащите одну сессию в другую, чтобы создать или изменить разделённые панели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölme oluşturmak veya değiştirmek için ⇧⌥⌘ tuşlarını basılı tutup bir oturumu başka bir oturumun üzerine sürükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⇧⌥⌘ 键并拖动一个会话到另一个会话中，可创建或更改分屏窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⇧⌥⌘ 並將一個工作階段拖移到另一個工作階段中，即可建立或變更分割窗格。"
          }
        }
      }
    },
