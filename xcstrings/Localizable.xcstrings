    "KeysPreferences.HotkeyConfiguredBody" : {
      "comment" : "Body explaining the newly created hotkey window profile; the placeholder is the profile name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Sie wurde ein neues Profil namens „%@“ erstellt. Es ist auf die Hotkey-Fenster-Funktion abgestimmt und kann im Tab „Profile“ angepasst werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A new profile called “%@” was created for you. It is tuned to work well for the Hotkey Window feature and it can be customized in the Profiles tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha creado un nuevo perfil llamado “%@” para ti. Está ajustado para funcionar bien con la función Ventana de tecla rápida y se puede personalizar en la pestaña Perfiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau profil nommé « %@ » a été créé pour vous. Il est optimisé pour la fonction Fenêtre à raccourci global et peut être personnalisé dans l’onglet Profils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato creato per te un nuovo profilo chiamato “%@”. È ottimizzato per funzionare bene con la funzione finestra ad abbreviazione globale e può essere personalizzato nel pannello Profili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」という新しいプロファイルが作成されました。ホットキーウインドウ機能に適した設定になっており、プロファイルタブでカスタマイズできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”(이)라는 새로운 프로파일이 생성되었습니다. 이 프로파일은 단축키 윈도우 기능에 잘 맞도록 조정되어 있으며 프로파일 탭에서 사용자화할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo perfil chamado “%@” foi criado para você. Ele foi ajustado para funcionar bem com o recurso Janela de hotkey e pode ser personalizado na aba Perfis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для вас был создан новый профиль с именем «%@». Он настроен для оптимальной работы с функцией окна горячей клавиши, и его можно изменить на вкладке «Профили»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizin için “%@” adlı yeni bir profil oluşturuldu. Kısayol Tuşu Penceresi özelliğiyle iyi çalışacak şekilde ayarlandı ve Profiller sekmesinde özelleştirilebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已为你创建名为“%@”的新配置文件。它针对热键窗口功能进行了调优，可在“配置文件”标签页中自定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已為你建立名為「%@」的新描述檔。它已針對全域快速鍵視窗功能調整，並可在「描述檔」標籤頁中自訂。"
          }
        }
      }
    },
