    "PTYSession.JSONFeatureLocation" : {
      "comment" : "Informational message pointing out where to find the pretty-print JSON feature",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie finden diese Funktion unter Bearbeiten > Auswahl ersetzen > Durch formatiertes JSON ersetzen, wenn Sie sie erneut verwenden möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can find this feature under Edit > Replace Selection > Replace with Pretty-Printed JSON if you want to use it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes encontrar esta función en Edición > Reemplazar selección > Reemplazar por JSON con formato legible si quieres volver a usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous retrouverez cette fonctionnalité dans Édition > Remplacer la sélection > Remplacer par du JSON mis en forme si vous voulez la réutiliser."
