          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 “%@”을(를) 사용할 수 없습니다. Ollama 모델이라면 Ollama를 시작하십시오. 그렇지 않으면 다른 모델로 새로운 채팅을 시작하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen «%@» er ikke tilgjengelig. Hvis det er en Ollama-modell, start Ollama. Ellers kan du starte en ny chat med en annen modell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het model ‘%@’ is niet beschikbaar. Start Ollama als het een Ollama-model is. Begin anders een nieuwe chat met een ander model."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model „%@” jest niedostępny. Jeśli to model Ollama, uruchom Ollama. W przeciwnym razie rozpocznij nowy czat z innym modelem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo “%@” não está disponível. Se for um modelo do Ollama, inicie o Ollama. Caso contrário, comece um novo chat com outro modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
