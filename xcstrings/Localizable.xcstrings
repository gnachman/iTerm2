    "Tip.0107.Body" : {
      "comment" : "Tip of the day body, id 0107",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie die tmux-Integration für automatische Tastenzuordnungen, die die Tastenkombinationen von tmux nachbilden und über die Leader-Einstellungen konfigurierbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use tmux integration for automatic key bindings that emulate tmux’s shortcuts, configurable via the Leader settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la integración con tmux para tener asignaciones de teclas automáticas que emulan los atajos de tmux, configurables en los ajustes de Líder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l’intégration tmux pour obtenir des associations de touches automatiques qui reproduisent les raccourcis de tmux, configurables dans les réglages du raccourci préfixe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l’integrazione tmux per avere associazioni tasti automatiche che emulano le abbreviazioni di tmux, configurabili tramite le impostazioni dell’abbreviazione prefisso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合を使うと、tmuxのショートカットをエミュレートする自動キーバインディングが利用でき、リーダーの設定で調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합을 사용하면 tmux의 단축키를 에뮬레이션하는 자동 키 바인딩을 사용할 수 있으며, 리더 설정에서 구성할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o tmux integration para atalhos de teclado automáticos que emulam os atalhos do tmux, configuráveis pelos ajustes de Líder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте интеграцию с tmux для автоматических привязок клавиш, эмулирующих сочетания клавиш tmux, настраиваемых через параметры лидера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux’ın kısayollarını taklit eden otomatik tuş atamaları için tmux entegrasyonunu kullanın; Önek kısayolu ayarlarından yapılandırılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 集成功能实现自动按键绑定，可模拟 tmux 快捷键，通过 Leader 设置进行配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 整合可自動建立模擬 tmux 快速鍵的按鍵對應，並可透過前置快速鍵設定進行調整。"
          }
        }
      }
    },
