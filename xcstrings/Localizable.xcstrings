    "AdvancedSetting.enableContextualAlternates" : {
      "comment" : "Advanced setting: enableContextualAlternates",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout kontextové alternativy (calt) pro písma podporující ligatury.\nPokud je zapnuto, použije se úroveň ligatur 2, která kromě standardních ligatur aktivuje calt. Mnoho programátorských písem, například Monaspace, Iosevka a Cascadia Code, to pro fungování svých ligatur vyžaduje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå kontekstuelle alternativer (calt) til for skrifter, der understøtter ligaturer.\nNår det er slået til, bruges ligaturniveau 2, som aktiverer calt ud over standardligaturer. Mange kodeskrifter som Monaspace, Iosevka og Cascadia Code kræver dette, for at deres ligaturer virker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontextuelle Alternativen (calt) für ligaturfähige Schriftarten aktivieren.\nWenn aktiviert, wird Ligaturstufe 2 verwendet, die calt zusätzlich zu den Standardligaturen aktiviert. Viele Programmierschriftarten wie Monaspace, Iosevka und Cascadia Code benötigen dies, damit ihre Ligaturen funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable contextual alternates (calt) for ligature-capable fonts.\nWhen enabled, uses ligature level 2 which activates calt in addition to standard ligatures. Many coding fonts such as Monaspace, Iosevka, and Cascadia Code require this for their ligatures to work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar las alternativas contextuales (calt) para tipos de letra con ligaduras.\nSi se activa, usa el nivel de ligaduras 2, que activa calt además de las ligaduras estándar. Muchos tipos de letra para programar, como Monaspace, Iosevka y Cascadia Code, lo necesitan para que sus ligaduras funcionen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota kontekstuaaliset vaihtoehdot (calt) käyttöön ligatuuripohjaisille fonteille.\nKun tämä on käytössä, käytetään ligatuuritasoa 2, joka aktivoi calt-ominaisuuden tavallisten ligatuurien lisäksi. Monet ohjelmointifontit, kuten Monaspace, Iosevka ja Cascadia Code, vaativat tätä ligatuuriensa toimimiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer les alternatives contextuelles (calt) pour les polices compatibles avec les ligatures.\nSi cette option est activée, elle utilise le niveau de ligatures 2, qui active calt en plus des ligatures standard. De nombreuses polices de code comme Monaspace, Iosevka et Cascadia Code en ont besoin pour que leurs ligatures fonctionnent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita le alternative contestuali (calt) per i font con supporto alle legature.\nSe abilitato, usa il livello di legature 2 che attiva calt oltre alle legature standard. Molti font per la programmazione come Monaspace, Iosevka e Cascadia Code lo richiedono per il funzionamento delle loro legature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リガチャに対応したフォントで、文脈依存字形 (calt) を有効にします。\n有効にすると、標準のリガチャに加えて calt を有効にするリガチャレベル 2 を使用します。Monaspace、Iosevka、Cascadia Code など多くのコーディング用フォントは、リガチャを機能させるためにこれが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합자를 지원하는 서체에서 문맥 대체 글리프(calt) 활성화.\n활성화하면 표준 합자에 더해 calt도 활성화하는 합자 레벨 2를 사용합니다. Monaspace, Iosevka, Cascadia Code 같은 많은 코딩용 서체는 합자가 작동하려면 이 설정이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver kontekstuelle alternativer (calt) for fonter som støtter ligaturer.\nNår dette er aktivert, brukes ligaturnivå 2, som aktiverer calt i tillegg til standard ligaturer. Mange kodefonter, som Monaspace, Iosevka og Cascadia Code, krever dette for at ligaturene deres skal fungere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel contextuele alternatieven (calt) in voor lettertypen met ligaturen.\nAls dit is ingeschakeld, wordt ligatuurniveau 2 gebruikt, dat calt activeert naast de standaardligaturen. Veel codeerlettertypen zoals Monaspace, Iosevka en Cascadia Code hebben dit nodig om hun ligaturen te laten werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz alternatywy kontekstowe (calt) dla czcionek obsługujących ligatury.\nPo włączeniu używany jest poziom ligatur 2, który aktywuje calt oprócz standardowych ligatur. Wiele czcionek programistycznych, takich jak Monaspace, Iosevka i Cascadia Code, wymaga tego, aby ich ligatury działały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar alternativas contextuais (calt) para fontes compatíveis com ligaduras.\nQuando ativado, usa o nível 2 de ligaduras, que ativa calt além das ligaduras padrão. Muitas fontes de programação como Monaspace, Iosevka e Cascadia Code exigem isto para que suas ligaduras funcionem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить контекстные альтернативы (calt) для шрифтов с поддержкой лигатур.\nПри включении используется уровень лигатур 2, который активирует calt в дополнение к стандартным лигатурам. Многие шрифты для кода, такие как Monaspace, Iosevka и Cascadia Code, требуют этого для работы своих лигатур."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť kontextové alternatívy (calt) pre písma podporujúce ligatúry.\nAk je zapnuté, použije sa úroveň ligatúr 2, ktorá okrem štandardných ligatúr aktivuje aj calt. Mnohé programátorské písma, ako Monaspace, Iosevka a Cascadia Code, to vyžadujú, aby ich ligatúry fungovali."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči kontekstualne alternative (calt) za pisave z ligaturami.\nČe je omogočeno, uporabi raven ligatur 2, ki poleg standardnih ligatur aktivira calt. Številne programerske pisave, kot so Monaspace, Iosevka in Cascadia Code, to potrebujejo, da njihove ligature delujejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera kontextuella alternativ (calt) för typsnitt med stöd för ligaturer.\nNär detta är aktiverat används ligaturnivå 2, som aktiverar calt utöver standardligaturer. Många kodtypsnitt som Monaspace, Iosevka och Cascadia Code kräver detta för att deras ligaturer ska fungera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitişik harf destekli fontlar için bağlamsal alternatifleri (calt) etkinleştir.\nEtkinleştirildiğinde standart bitişik harflere ek olarak calt’ı etkinleştiren bitişik harf düzeyi 2’yi kullanır. Monaspace, Iosevka ve Cascadia Code gibi birçok kodlama fontu, bitişik harflerinin çalışması için buna ihtiyaç duyar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật các dạng thay thế theo ngữ cảnh (calt) cho phông chữ hỗ trợ chữ ghép.\nKhi bật, dùng mức chữ ghép 2 để kích hoạt calt bên cạnh các chữ ghép chuẩn. Nhiều phông chữ lập trình như Monaspace, Iosevka và Cascadia Code cần tùy chọn này để chữ ghép của chúng hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为支持连字功能的字体启用上下文替代选项。\n启用后，将使用二级连字功能，除了标准连字外还会激活上下文替代选项。许多编程字体，如 Monaspace、Iosevka 和 Cascadia Code，都需要此功能才能正常显示连字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為支援連字的字體啟用情境替代字形（calt）。\n啟用後，會使用連字層級 2，除了標準連字之外還會啟動 calt。許多程式設計字體，例如 Monaspace、Iosevka 和 Cascadia Code，需要此項才能讓連字運作。"
          }
        }
      }
    },
    "AdvancedSetting.enableSecureKeyboardEntryAutomatically" : {
      "comment" : "Advanced setting: enableSecureKeyboardEntryAutomatically",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky zapínat zabezpečené zadávání z klávesnice u výzev k zadání hesla?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå sikker tastaturindtastning til automatisk ved adgangskodeprompter?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Tastatureingabe bei Passwortabfragen automatisch aktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
