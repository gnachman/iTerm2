    "Tip.0033.Body" : {
      "comment" : "Tip of the day body, id 0033",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím pravým tlačítkem na panel můžete změnit jeho barvu, zavřít panely za ním nebo zavřít všechny ostatní panely."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på en fane for at ændre dens farve, lukke faner efter den eller lukke alle andre faner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie mit der rechten Maustaste auf einen Tab, um dessen Farbe zu ändern, nachfolgende Tabs zu schließen oder alle anderen Tabs zu schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Right click on a tab to change its color, close tabs after it, or to close all other tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic con el botón derecho en una pestaña para cambiar su color, cerrar las pestañas posteriores o cerrar todas las demás pestañas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa välilehteä oikealla painikkeella vaihtaaksesi sen väriä, sulkeaksesi sen jälkeiset välilehdet tai sulkeaksesi kaikki muut välilehdet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur un onglet pour changer sa couleur, fermer les onglets suivants ou fermer tous les autres onglets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con il tasto destro su un pannello per cambiarne il colore, chiudere i pannelli successivi o chiudere tutti gli altri pannelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを右クリックすると、色を変更したり、それ以降のタブを閉じたり、他のすべてのタブを閉じたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 오른쪽 클릭하여 탭 색상을 변경하거나, 그 뒤의 탭을 닫거나, 다른 모든 탭을 닫을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på en fane for å endre fargen, lukke fanene etter den eller lukke alle andre faner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een tabblad om de kleur te wijzigen, de tabbladen erna te sluiten of alle andere tabbladen te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij kartę prawym przyciskiem, aby zmienić jej kolor, zamknąć karty po niej lub zamknąć wszystkie pozostałe karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma aba para mudar sua cor, fechar as abas seguintes ou fechar todas as outras abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните правой кнопкой мыши по вкладке, чтобы изменить её цвет, закрыть вкладки после неё или закрыть все остальные вкладки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím pravým tlačidlom na tab môžete zmeniť jeho farbu, zatvoriť taby za ním alebo zatvoriť všetky ostatné taby."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z desnim klikom na zavihek lahko spremenite njegovo barvo, zaprete zavihke za njim ali zaprete vse druge zavihke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på en flik för att ändra dess färg, stänga flikar efter den eller stänga alla andra flikar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rengini değiştirmek, kendisinden sonraki sekmeleri kapatmak veya diğer tüm sekmeleri kapatmak için bir sekmeye sağ tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm chuột phải vào một tab để đổi màu, đóng các tab phía sau nó, hoặc đóng tất cả các tab khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签页上右键点击可更改其颜色，点击后关闭该标签页，或同时关闭所有其他标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在標籤頁上按一下右鍵，可以變更它的顏色、關閉它之後的標籤頁，或關閉所有其他標籤頁。"
          }
        }
      }
    },
