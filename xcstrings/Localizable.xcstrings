    "BrowserScriptingPermissions.AddInfo" : {
      "comment" : "Explains the dialog for adding a website that scripts may control; the buttons say what they will be able to do",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine Website ein, zum Beispiel https://example.com. Skripte können dies dann dort ohne Nachfrage tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter a website, such as https://example.com. Scripts will be able to do this on it without asking."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://example.com のようにWebサイトを入力してください。スクリプトは確認なしでこのWebサイトに対してこの操作を行えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://example.com과 같이 웹 사이트를 입력하십시오. 스크립트가 묻지 않고 해당 웹 사이트에서 이 작업을 할 수 있게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
