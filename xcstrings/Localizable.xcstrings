    "AdvancedSetting.navigatePanesInReadingOrder" : {
      "comment" : "Advanced setting: navigatePanesInReadingOrder",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Befehle „Nächster Bereich“ und „Vorheriger Bereich“ verwenden die Lesereihenfolge statt des Zeitpunkts der letzten Verwendung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Next Pane and Previous Pane commands use reading order, not the time of last use."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次のペイン」および「前のペイン」コマンドは、最後に使用した時刻ではなく読み取り順序を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 패널 및 이전 패널 명령이 마지막 사용 시간이 아닌 읽기 순서를 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os comandos Próximo painel e Painel anterior usam a ordem de leitura, não o horário de último uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды «Следующая панель» и «Предыдущая панель» используют порядок чтения, а не время последнего использования."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“下一个窗格”和“上一个窗格”命令使用阅读顺序，而非最后使用的时间。"
          }
        }
      }
    },
    "AdvancedSetting.neverWarnAboutMeta" : {
      "comment" : "Advanced setting: neverWarnAboutMeta",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung unterdrücken, wenn „⌥-Taste verhält sich wie Meta“ unter Einstellungen > Profile > Tasten aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress a warning when ⌥ Key Acts as Meta is enabled in Settings > Profiles > Keys."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 > プロファイル > キーで「⌥キーをMetaキーとして使う」が有効なときの警告を表示しない。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > 프로파일 > 키에서 ⌥ 키를 Meta로 사용이 활성화된 경우 경고를 표시하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir um aviso quando “A tecla ⌥ atua como Meta” está ativada em Ajustes > Perfis > Teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение, когда в разделе Settings > Profiles > Keys включена опция «⌥ Key Acts as Meta»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置 > 配置文件 > 按键中启用⌥键作为元键时，应隐藏警告信息。"
          }
        }
      }
    },
