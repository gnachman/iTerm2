          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживание изменения статуса выбранного сеанса. При следующем изменении появится оповещение, после чего отслеживание отключится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在监视所选会话的状态更改。下一次更改时会出现提醒，然后此选项会关闭。"
          }
        }
      }
    },
