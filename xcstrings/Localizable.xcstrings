            "state" : "translated",
            "value" : "Oluşturucu’nun Gelişmiş Özellikleri"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑器高级功能"
          }
        },
        "zh-Hant" : {
