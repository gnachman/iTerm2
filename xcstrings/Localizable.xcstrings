    "ImportExport.DryRunConfirmTitle" : {
      "comment" : "Confirmation body shown before a dry-run erase",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim zkušebního běhu je zapnut. iTerm2 zapíše do Console.app, co by smazal, a zůstane spuštěn. Ve skutečnosti nebude nic smazáno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testkørselstilstand er slået til. iTerm2 logger til Console.app, hvad det ville slette, og bliver ved med at køre. Der slettes ikke noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Testlauf-Modus ist aktiviert. iTerm2 protokolliert in Console.app, was gelöscht würde, und bleibt dabei aktiv. Es wird nichts tatsächlich gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dry-run mode is enabled. iTerm2 will log to Console.app what it would erase and stay running. Nothing will actually be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de simulacro está activado. iTerm2 registrará en Console.app lo que borraría y seguirá en ejecución. En realidad no se eliminará nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuivakäyntitila on käytössä. iTerm2 kirjaa Console.app-sovellukseen, mitä se poistaisi, ja jää käyntiin. Mitään ei todellisuudessa poisteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode simulation est activé. iTerm2 consignera dans Console.app ce qu’il effacerait et restera ouvert. Rien ne sera réellement supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità simulazione è abilitata. iTerm2 registrerà in Console.app ciò che cancellerebbe e resterà in esecuzione. In realtà non verrà eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライランモードが有効です。iTerm2 は消去する内容を Console.app に記録して実行を継続します。実際には何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시험 실행 모드가 켜져 있습니다. iTerm2는 지울 항목을 Console.app에 기록하고 계속 실행됩니다. 실제로는 아무것도 삭제되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøvekjøringsmodus er aktivert. iTerm2 logger til Console.app det som ville blitt slettet, og fortsetter å kjøre. Ingenting blir faktisk slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De proefrunmodus is ingeschakeld. iTerm2 legt in Console.app vast wat er gewist zou worden en blijft actief. Er wordt niets daadwerkelijk verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb symulacji jest włączony. iTerm2 zapisze w Console.app, co by usunął, i pozostanie uruchomiony. Nic nie zostanie faktycznie usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de simulação está ativado. O iTerm2 registrará no aplicativo Console o que apagaria e continuará em execução. Nada será realmente excluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включен пробный режим. iTerm2 запишет в Console.app то, что было бы удалено, и продолжит работу. Ничего не будет удалено на самом деле."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skúšobný režim je zapnutý. iTerm2 zaznamená do Console.app, čo by vymazal, a zostane spustený. Nič sa skutočne neodstráni."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način poskusnega brisanja je omogočen. iTerm2 bo v Console.app zabeležil, kaj bi izbrisal, in bo še naprej deloval. Dejansko ne bo izbrisano nič."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testkörningsläget är aktiverat. iTerm2 loggar till Console.app vad som skulle raderas och fortsätter köra. Ingenting raderas egentligen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme modu etkin. iTerm2 sileceği öğeleri Console.app’e kaydedecek ve çalışmaya devam edecek. Gerçekte hiçbir şey silinmeyecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ chạy thử đang bật. iTerm2 sẽ ghi vào Console.app những gì nó sẽ xóa và tiếp tục chạy. Thực tế sẽ không có gì bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟模式已开启。iTerm2 会将将要清除的内容记录到 Console.app 中，程序仍会继续运行。实际上不会删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已啟用模擬模式。iTerm2 會將原本會清除的內容記錄到 Console.app，並繼續執行。實際上不會刪除任何內容。"
          }
        }
      }
    },
