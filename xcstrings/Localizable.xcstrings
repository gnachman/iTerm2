    "Tip.0018.Body" : {
      "comment" : "Tip of the day body, id 0018",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⌥⌘B, um in einem Terminalfenster in der Zeit zurückzugehen. Verwenden Sie die Pfeiltasten, um Bild für Bild vorzugehen. Halten Sie ⇧ gedrückt und drücken Sie die Pfeiltasten, um schneller voranzukommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⌥⌘B to step back in time in a terminal window. Use arrow keys to go frame by frame. Hold ⇧ and press arrow keys to go faster."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘Bを押すと、ターミナルウィンドウの時間をさかのぼれます。矢印キーでフレームごとに移動できます。⇧を押しながら矢印キーを押すと、より速く移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 윈도우에서 시간을 거슬러 올라가려면 ⌥⌘B를 누르십시오. 화살표 키를 사용하여 프레임 단위로 이동할 수 있습니다. ⇧를 누른 채로 화살표 키를 누르면 더 빠르게 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⌥⌘B para voltar no tempo em uma janela de terminal. Use as teclas de seta para avançar quadro a quadro. Mantenha ⇧ pressionada e use as teclas de seta para ir mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⌥⌘B, чтобы вернуться назад во времени в окне терминала. Используйте клавиши со стрелками для перехода по кадрам. Удерживайте ⇧ и нажимайте стрелки, чтобы двигаться быстрее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按⌥⌘B可在终端窗口中倒带回到过去。使用箭头键逐帧移动。按住⇧并按箭头键可加快速度。"
          }
        }
      }
    },
