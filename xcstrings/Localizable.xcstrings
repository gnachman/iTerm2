    "ClaudeCodeOnboarding.IntroLead" : {
      "comment" : "Reassuring lead text on the intro sheet",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Panik! All dies kann später über iTerm2 > Claude-Code-Integration deinstallieren rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don’t panic! All of this can be undone later via iTerm2 > Uninstall Claude Code Integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡No te asustes! Todo esto se puede deshacer más tarde con iTerm2 > Desinstalar integración con Claude Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de panique ! Tout cela peut être annulé plus tard via iTerm2 > Désinstaller l’intégration de Claude Code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente panico! Tutto questo può essere annullato in seguito da iTerm2 > Disinstalla integrazione con Claude Code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心配ありません！これらはすべて、後でiTerm2 > Claude Code連携をアンインストールから元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걱정하지 마십시오! 이 모든 것은 나중에 iTerm2 > Claude Code 통합 제거로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não entre em pânico! Tudo isso pode ser desfeito mais tarde por meio de iTerm2 > Desinstalar integração do Claude Code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
