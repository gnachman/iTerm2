    "ClaudeCodeOnboarding.ConfigResolutionFailedBody" : {
      "comment" : "Body of the alert shown when iTerm2 could not read CLAUDE_CONFIG_DIR from the user’s shell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal z vašeho shellu přečíst CLAUDE_CONFIG_DIR, takže neví, kde Claude Code ukládá své nastavení. Zkusit znovu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke læse CLAUDE_CONFIG_DIR fra din shell, så den ved ikke, hvor Claude Code gemmer sine indstillinger. Vil du prøve igen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte CLAUDE_CONFIG_DIR nicht aus Ihrer Shell lesen und weiß daher nicht, wo Claude Code seine Einstellungen speichert. Erneut versuchen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t read CLAUDE_CONFIG_DIR from your shell, so it doesn’t know where Claude Code keeps its settings. Try again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo leer CLAUDE_CONFIG_DIR desde tu shell, así que no sabe dónde guarda Claude Code sus ajustes. ¿Volver a intentarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei pystynyt lukemaan CLAUDE_CONFIG_DIR-muuttujaa komentotulkistasi, joten se ei tiedä, missä Claude Code säilyttää asetuksiaan. Yritetäänkö uudelleen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu lire CLAUDE_CONFIG_DIR depuis votre shell, il ne sait donc pas où Claude Code conserve ses réglages. Réessayer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto leggere CLAUDE_CONFIG_DIR dalla tua shell, quindi non sa dove Claude Code conserva le sue impostazioni. Riprovare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はシェルからCLAUDE_CONFIG_DIRを読み取れなかったため、Claude Codeが設定を保存する場所がわかりません。もう一度試しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 셸에서 CLAUDE_CONFIG_DIR을 읽을 수 없어 Claude Code가 설정을 어디에 보관하는지 알 수 없습니다. 다시 시도하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke lese CLAUDE_CONFIG_DIR fra skallet ditt, så den vet ikke hvor Claude Code har innstillingene sine. Vil du prøve igjen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kon CLAUDE_CONFIG_DIR niet uit je shell lezen en weet dus niet waar Claude Code zijn instellingen bewaart. Opnieuw proberen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie mógł odczytać CLAUDE_CONFIG_DIR z twojej powłoki, więc nie wie, gdzie Claude Code przechowuje ustawienia. Spróbować ponownie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu ler CLAUDE_CONFIG_DIR do seu shell, portanto não sabe onde o Claude Code guarda as configurações. Tentar novamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не смог прочитать CLAUDE_CONFIG_DIR из вашей оболочки, поэтому не знает, где Claude Code хранит настройки. Попробовать снова?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal prečítať CLAUDE_CONFIG_DIR z vášho shellu, preto nevie, kde Claude Code ukladá svoje nastavenia. Skúsiť znovu?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ni mogel prebrati CLAUDE_CONFIG_DIR iz vaše lupine, zato ne ve, kje Claude Code hrani svoje nastavitve. Poskusite znova?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunde inte läsa CLAUDE_CONFIG_DIR från ditt skal, så den vet inte var Claude Code lagrar sina inställningar. Vill du försöka igen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kabuğunuzdan CLAUDE_CONFIG_DIR değerini okuyamadı; bu yüzden Claude Code’un ayarlarını nerede sakladığını bilmiyor. Yeniden denensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 không thể đọc CLAUDE_CONFIG_DIR từ shell của bạn, nên không biết Claude Code lưu cài đặt ở đâu. Thử lại?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法从你的 Shell 读取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 将设置保存在何处。要重试吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法從你的 shell 讀取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 將設定儲存在何處。要再試一次嗎？"
          }
        }
      }
    },
