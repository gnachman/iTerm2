    "Tip.0122.Body" : {
      "comment" : "Tip of the day body, id 0122",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte „Nastavení > Profily > Terminál > Kliknutím na cestu ve výzvě shellu otevřít Navigátor“ a procházejte souborový systém kliknutím na cesty ve výzvě. Vyžaduje integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå “Indstillinger > Profiler > Terminal > Klik på en sti i en shell-prompt for at åbne Navigator” til for at navigere i dit arkivsystem ved at klikke på stier i din prompt. Kræver shell-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Einstellungen > Profile > Terminal > Klick auf einen Pfad in einer Shell-Eingabeaufforderung öffnet Navigator“, um Ihr Dateisystem durch Klicken auf Pfade in Ihrer Eingabeaufforderung zu durchsuchen. Erfordert Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable “Settings > Profiles > Terminal > Click on a path in a shell prompt to open Navigator” to navigate your filesystem by clicking on paths in your prompt. Requires Shell Integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa “Ajustes > Perfiles > Terminal > Haz clic en una ruta en el prompt del shell para abrir el Navegador” para navegar por tu sistema de archivos haciendo clic en las rutas de tu prompt. Requiere la integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön ”Asetukset > Profiilit > Pääte > Avaa Navigator klikkaamalla polkua komentokehotteessa”, jotta voit selata tiedostojärjestelmääsi klikkaamalla kehotteesi polkuja. Vaatii komentotulkki-integraation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Réglages > Profils > Terminal > Cliquez sur un chemin dans une invite du shell pour ouvrir le navigateur de fichiers » pour parcourir votre système de fichiers en cliquant sur les chemins de votre invite. Nécessite l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita “Impostazioni > Profili > Terminale > Fai clic su un percorso nel prompt della shell per aprire Navigator” per navigare nel file system facendo clic sui percorsi nel prompt. Richiede l’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > ターミナル > シェルプロンプト内のパスをクリックしてナビゲーターを開く」を有効にすると、プロンプト内のパスをクリックしてファイルシステムを移動できます。シェル統合が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 터미널 > 셸 프롬프트의 경로를 클릭하여 탐색기 열기”를 켜면 프롬프트의 경로를 클릭하여 파일 시스템을 탐색할 수 있습니다. 셸 통합이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på «Innstillinger > Profiler > Terminal > Klikk på en bane i skallets ledetekst for å åpne Navigator» for å navigere i filsystemet ved å klikke på baner i ledeteksten. Krever skallintegrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel ‘Instellingen > Profielen > Terminal > Klik op een pad in een shell-prompt om Navigator te openen’ in om door je bestandssysteem te navigeren door op paden in je prompt te klikken. Vereist shell-integratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz „Ustawienia > Profile > Terminal > Kliknij ścieżkę w znaku zachęty powłoki, aby otworzyć Nawigator”, aby poruszać się po systemie plików, klikając ścieżki w znaku zachęty. Wymaga integracji z powłoką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Settings > Profiles > Terminal > Click on a path in a shell prompt to open Navigator” para navegar pelo seu sistema de arquivos clicando em caminhos no seu prompt. Requer o Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Настройки > Профили > Терминал > Щёлкать по пути в приглашении оболочки, чтобы открыть Навигатор», чтобы перемещаться по файловой системе, щёлкая по путям в приглашении. Требует интеграции с оболочкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite možnosť „Nastavenia > Profily > Terminál > Kliknutím na cestu vo výzve shellu otvoriť Navigátor“ a pohybujte sa po súborovom systéme kliknutím na cesty vo výzve. Vyžaduje integráciu shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopite »Nastavitve > Profili > Terminal > Kliknite pot v ukaznem pozivu lupine, da odprete Navigator«, da po datotečnem sistemu brskate s klikanjem poti v ukaznem pozivu. Zahteva integracijo lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på ”Inställningar > Profiler > Terminal > Klicka på en sökväg i en skalprompt för att öppna Navigator” för att navigera i filsystemet genom att klicka på sökvägar i din prompt. Kräver skalintegrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstemdeki yollara tıklayarak dosya sisteminizde gezinmek için “Ayarlar > Profiller > Terminal > Gezgini açmak için kabuk isteminde bir yola tıklayın” seçeneğini etkinleştirin. Kabuk Entegrasyonu gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật “Cài đặt > Hồ sơ > Terminal > Bấm vào đường dẫn trong dấu nhắc shell để mở Navigator” để duyệt hệ thống tệp bằng cách bấm vào các đường dẫn trong dấu nhắc. Yêu cầu Tích hợp shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用“设置 > 配置文件 > 终端 > 在shell提示符中点击路径以打开导航器”功能，通过点击提示符中的路径来浏览文件系统。需要Shell集成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「設定 > 描述檔 > 終端機 > 按一下 shell 提示符號中的路徑以打開導覽器」，即可按一下提示符號中的路徑來瀏覽檔案系統。需要 Shell 整合。"
          }
        }
      }
    },
