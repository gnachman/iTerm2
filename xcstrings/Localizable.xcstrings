        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fensternummer im Titelleisten-Zubehör anzeigen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show window number in titlebar accessory?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mostrar el número de ventana en el accesorio de la barra de título?"
          }
        },
        "fi" : {
