          },
          "substitutions" : {
            "sessions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Dadurch wird auch die Arbeitsgruppe „%1$@“ verlassen und %2$lld weitere Sitzung geschlossen."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
