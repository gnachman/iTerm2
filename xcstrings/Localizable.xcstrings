            "value" : "Disattiva l’avviso di impostazioni modificate quando le impostazioni vengono caricate da un URL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLから設定を読み込んだ際の変更警告を表示しない。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
