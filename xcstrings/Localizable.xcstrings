    "AdvancedSetting.showPinnedIndicator" : {
      "comment" : "Advanced setting: showPinnedIndicator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit indikátor u připnutých oken horké klávesy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis indikator for fastgjorte genvejstastvinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzeige für angeheftete Hotkey-Fenster anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show indicator for pinned hotkey windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un indicador para las ventanas de tecla rápida fijadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä ilmaisin kiinnitetyille pikanäppäinikkunoille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher l’indicateur pour les fenêtres à raccourci global épinglées."
          }
        },
        "it" : {
