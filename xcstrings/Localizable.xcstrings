    "CopyMode.NotificationDetail" : {
      "comment" : "Body of the notification introducing Copy Mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim kopírování umožňuje vytvořit výběr pomocí klávesnice. Kliknutím zobrazíte příručku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieringstilstand lader dig markere med tastaturet. Klik for at se manualen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kopiermodus können Sie eine Auswahl über die Tastatur treffen. Klicken Sie, um das Handbuch zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy Mode lets you make a selection with the keyboard. Click to view the manual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de copia te permite hacer una selección con el teclado. Haz clic para ver el manual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiointitilassa voit tehdä valinnan näppäimistöllä. Klikkaa nähdäksesi käyttöohjeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode copie permet de faire une sélection avec le clavier. Cliquez pour consulter le manuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità copia ti consente di fare una selezione con la tastiera. Fai clic per leggere il manuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーモードを使うとキーボードで選択できます。クリックするとマニュアルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사 모드를 사용하면 키보드로 선택할 수 있습니다. 설명서를 보려면 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med kopieringsmodus kan du markere med tastaturet. Klikk for å se håndboken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de kopieermodus maak je een selectie met het toetsenbord. Klik om de handleiding te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb kopiowania umożliwia zaznaczanie za pomocą klawiatury. Kliknij, aby zobaczyć instrukcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de cópia permite fazer uma seleção com o teclado. Clique para ver o manual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим копирования позволяет делать выделение с помощью клавиатуры. Нажмите, чтобы открыть руководство."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim kopírovania umožňuje vytvoriť výber pomocou klávesnice. Kliknutím zobrazíte príručku."
