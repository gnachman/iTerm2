    "ChatViewController.SafetyFlaggedWarning" : {
      "comment" : "Warning shown when the AI safety check flags a command as dangerous",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ **Kontrola bezpečnosti AI označila tento příkaz jako potenciálně nebezpečný. Pečlivě jej zkontrolujte.**\n\n"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ **AI-sikkerhedstjekket markerede denne kommando som potentielt farlig. Gennemgå den omhyggeligt.**\n\n"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
