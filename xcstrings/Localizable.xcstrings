    "AdvancedSetting.reportOnFirstMouse" : {
      "comment" : "Advanced setting: reportOnFirstMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesílat hlášení myši při kliknutí do okna, které ještě není v popředí?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send musrapporter, når du klikker i et vindue, der ikke allerede er forrest?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mausmeldungen senden, wenn Sie in ein Fenster klicken, das noch nicht im Vordergrund ist?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Send mouse reports when you click in a window that isn't already frontmouse?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Enviar informes del ratón al hacer clic en una ventana que aún no está al frente?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetäänkö hiiren raportit, kun klikataan ikkunaa, joka ei vielä ole etualalla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer des signalements de la souris lorsque vous cliquez dans une fenêtre qui n’est pas déjà au premier plan ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviare segnalazioni del mouse quando fai clic in una finestra che non è già in primo piano?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
