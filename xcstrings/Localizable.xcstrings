        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo analizar %@ como JSON. Ábrelo en un editor de texto y comprueba si tiene errores de sintaxis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
