    "ShellIntegrationInstaller.DiscoveredHelperShell" : {
      "comment" : "Shown when discovering the shell finds a helper shell (with a “>> ” prompt) that a canceled shell integration install left running in the terminal, instead of the user's own shell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Das Terminal befindet sich in einer Hilfs-Shell, die eine frühere Installation offen gelassen hat, nicht in Ihrer eigenen Shell. Geben Sie „exit“ ein, bis die Eingabeaufforderung Ihrer eigenen Shell wieder erscheint, und wählen Sie dann „Fortfahren“, um es erneut zu versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🛑 The terminal is in a helper shell that an earlier install left running, not in your own shell. Enter “exit” until your own shell’s prompt is back, then select “Continue” to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 La terminal está en un shell auxiliar que una instalación anterior dejó en ejecución, no en tu propio shell. Introduce “exit” hasta que vuelva el prompt de tu propio shell y luego selecciona “Continuar” para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Le terminal est dans un shell auxiliaire laissé en cours d’exécution par une installation précédente, et non dans votre propre shell. Saisissez « exit » jusqu’à ce que l’invite de votre shell réapparaisse, puis sélectionnez « Continuer » pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Il terminale si trova in una shell ausiliaria lasciata in esecuzione da un’installazione precedente, non nella tua shell. Inserisci “exit” finché non torna il prompt della tua shell, poi seleziona “Continua” per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 ターミナルは、以前のインストールが残したヘルパーシェルの中にあり、ご自分のシェルではありません。ご自分のシェルのプロンプトが戻るまで“exit”を入力してから、「続ける」を選択してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 터미널이 사용자 셸이 아니라 이전 설치에서 실행된 채로 남은 도우미 셸에 있습니다. 사용자 셸의 프롬프트가 돌아올 때까지 “exit”를 입력한 다음 “계속”을 선택하여 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 O terminal está em um shell auxiliar que uma instalação anterior deixou em execução, não no seu próprio shell. Digite “exit” até que o prompt do seu shell volte e selecione “Continuar” para tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Терминал находится во вспомогательной оболочке, которую оставила запущенной предыдущая установка, а не в вашей оболочке. Вводите «exit», пока не вернётся приглашение вашей оболочки, затем нажмите «Продолжить», чтобы повторить попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 Terminal, kendi kabuğunuzda değil, önceki bir yüklemenin çalışır durumda bıraktığı bir yardımcı kabuktadır. Kendi kabuğunuzun istemi gelene kadar “exit” girin, ardından yeniden denemek için “Devam Et”i seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 终端当前处于之前的安装遗留下来的辅助 shell 中，而不是你自己的 shell。请输入“exit”，直到你自己的 shell 提示符重新出现，然后选择“继续”重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🛑 終端機目前位於先前安裝時遺留的輔助 shell 中，而不是你自己的 shell。請輸入「exit」直到回到你自己的 shell 提示符號，然後按一下「繼續」再試一次。"
          }
        }
      }
    },
