    "EventTrigger.Help.JobEnded" : {
      "comment" : "Help text for the Job Ended event trigger",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí se, když proces odpovídající filtru procesů opustí řetězec předků procesu na popředí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløses, når en proces, der matcher procesfilteret, forlader forgrundsprocessens kæde af forfædre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ausgelöst, wenn ein Prozess, der dem Job-Filter entspricht, die Abstammungskette des Vordergrundprozesses verlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fires when a process matching the job filter leaves the foreground-job ancestry chain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dispara cuando un proceso que coincide con el filtro de procesos sale de la cadena de ascendencia del proceso en primer plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukeaa, kun prosessiin täsmäävä prosessi poistuu etualan prosessin esiisäketjusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déclenche quand un processus correspondant au filtre de processus quitte la chaîne d’ascendance du processus au premier plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si attiva quando un processo che corrisponde al filtro dei processi esce dalla catena di ascendenza del processo in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブフィルタに一致するプロセスがフォアグラウンドジョブの祖先チェーンから外れると発火します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 필터와 일치하는 프로세스가 포그라운드 작업 조상 체인에서 벗어날 때 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløses når en prosess som treffer prosessfilteret forlater kjeden av foreldreprosesser til forgrunnsprosessen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt geactiveerd wanneer een proces dat overeenkomt met het procesfilter de keten van voorgrondprocessen verlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzwala się, gdy proces pasujący do filtra procesów opuszcza łańcuch przodków procesu pierwszoplanowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara quando um processo que corresponde ao filtro de processo deixa a cadeia de ancestralidade do processo em primeiro plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает, когда процесс, соответствующий фильтру процессов, покидает цепочку предков активного процесса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí sa, keď proces zodpovedajúci filtru procesov opustí reťazec predkov procesu na popredí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sproži se, ko proces, ki ustreza filtru procesov, zapusti verigo prednikov procesa v ospredju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utlöses när en process som matchar processfiltret lämnar förgrundsprocessens släktkedja."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem filtresiyle eşleşen bir işlem, ön plan işlemi soy zincirinden çıktığında tetiklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích hoạt khi một tiến trình khớp với bộ lọc tiến trình rời khỏi chuỗi tổ tiên của tiến trình nền trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匹配作业过滤器的进程离开前台作业祖先链时触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "符合程序篩選條件的程序離開前景程序的祖先鏈時觸發。"
          }
        }
      }
    },
