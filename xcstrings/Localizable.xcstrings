          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle apper har lov til å bruke API-et, i henhold til «Innstillinger > Generelt > Magi > Tillat alle apper å koble til»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
