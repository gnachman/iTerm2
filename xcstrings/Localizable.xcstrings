            "value" : "Подчёркивать элементы, доступные для Semantic History, под курсором при удержании ⌘?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podčiarkovať položky vybrateľné Sémantickou históriou pod kurzorom pri podržaní ⌘?"
          }
