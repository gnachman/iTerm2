          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar o seletor de variação 16 tornando os emoji de largura total em todos os modos?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживать селектор вариации 16, делающий эмодзи полноширинными во всех режимах?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporovať variačný selektor 16, ktorý robí emoji plnej šírky vo všetkých režimoch?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se podpira izbirnik različice 16, ki emoji naredi polnoširok v vseh načinih?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stödja variationsväljare 16 som gör emojis helbreda i alla lägen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varyasyon seçici 16’nın emojileri tüm modlarda tam genişlikli yapması desteklensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỗ trợ bộ chọn biến thể 16 làm biểu tượng cảm xúc rộng đủ ở mọi chế độ?"
