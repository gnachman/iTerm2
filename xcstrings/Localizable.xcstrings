    "AdvancedSetting.preventEscapeSequenceFromChangingProfile" : {
      "comment" : "Advanced setting: preventEscapeSequenceFromChangingProfile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabránit řídicím sekvencím ve změně aktuálního profilu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhindr kontrolsekvenser i at ændre den aktuelle profil?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindern, dass Steuersequenzen das aktuelle Profil ändern?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent control sequences from changing the current profile?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Impedir que las secuencias de control cambien el perfil actual?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estetäänkö ohjaussarjoja vaihtamasta nykyistä profiilia?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêcher les séquences de contrôle de changer le profil actuel ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedire alle sequenze di controllo di cambiare il profilo corrente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制御シーケンスによる現在のプロファイルの変更を防止するか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 시퀀스가 현재 프로파일을 변경하지 못하게 하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindre kontrollsekvenser i å endre gjeldende profil?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorkomen dat besturingsreeksen het huidige profiel wijzigen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zapobiegać zmianie bieżącego profilu przez sekwencje sterujące?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir que sequências de controle alterem o perfil atual?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запретить управляющим последовательностям изменять текущий профиль?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabrániť riadiacim sekvenciám meniť aktuálny profil?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se krmilnim zaporedjem prepreči spreminjanje trenutnega profila?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindra styrsekvenser från att ändra aktuell profil?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim dizilerinin geçerli profili değiştirmesi engellensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn chuỗi điều khiển đổi hồ sơ hiện tại?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防止控制序列改变当前配置文件？"
