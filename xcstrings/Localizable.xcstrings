    "PseudoTerminal.KillOrHideTmux" : {
      "comment" : "Confirmation prompt when closing a tmux tab",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-Fenster beenden und dessen Prozesse abbrechen oder ausblenden? Ausgeblendete Fenster können über das tmux-Dashboard wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill tmux window, terminating its jobs, or hide it? Hidden windows may be restored from the tmux dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxウィンドウを強制終了してジョブを終了させますか、それとも非表示にしますか？非表示にしたウィンドウはtmuxダッシュボードから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 윈도우를 종료하여 작업을 끝내겠습니까, 아니면 가리겠습니까? 가린 윈도우는 tmux 대시보드에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar a janela do tmux, encerrando suas tarefas, ou ocultá-la? Janelas ocultas podem ser restauradas pelo painel do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть окно tmux, завершив его процессы, или скрыть его? Скрытые окна можно восстановить из панели tmux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终止 tmux 窗口及其任务，还是隐藏它？隐藏的窗口可以从 tmux 仪表盘中恢复。"
          }
        }
      }
    },
    "PseudoTerminal.KillTmuxWindowMany" : {
      "comment" : "Confirmation prompt when closing multiple tmux windows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tmux-Fenster und deren Prozesse beenden, Fenster ausblenden oder von der tmux-Sitzung trennen?\n\nAusgeblendete Fenster können über das tmux-Dashboard wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill all tmux windows and their jobs, hide windows from view, or detach from tmux session?\n\nHidden windows may be restored from the tmux dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのtmuxウィンドウとそのジョブを強制終了しますか、ウィンドウを非表示にしますか、それともtmuxセッションからデタッチしますか？\n\n非表示にしたウィンドウはtmuxダッシュボードから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 tmux 윈도우와 해당 작업을 종료하겠습니까, 윈도우를 가리겠습니까, 아니면 tmux 세션에서 분리하겠습니까?\n\n가린 윈도우는 tmux 대시보드에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar todas as janelas do tmux e suas tarefas, ocultar as janelas, ou desanexar da sessão do tmux?\n\nJanelas ocultas podem ser restauradas pelo painel do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть все окна tmux вместе с их процессами, скрыть окна из вида или отключиться от сеанса tmux?\n\nСкрытые окна можно восстановить из панели tmux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终止所有 tmux 窗口及其作业、从视图中隐藏窗口，或从 tmux 会话分离？\n\n隐藏的窗口可从 tmux 仪表盘中恢复。"
          }
        }
      }
    },
    "PseudoTerminal.KillTmuxWindowOne" : {
      "comment" : "Confirmation prompt when closing a single tmux window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
