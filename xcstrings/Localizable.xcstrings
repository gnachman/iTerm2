    "AdvancedSetting.acceptOSC7" : {
      "comment" : "Advanced setting: acceptOSC7",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přijímat OSC 7 k nastavení uživatelského jména, názvu hostitele a cesty. Integrace shellu iTerm2 nyní tyto informace hlásí pomocí OSC 7, takže vypnutí této volby vypne i sledování uživatelského jména, názvu hostitele a adresáře v integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptér OSC 7 til at angive brugernavn, værtsnavn og sti. Shell-integrationen i iTerm2 rapporterer nu disse oplysninger via OSC 7, så hvis du slår dette fra, slås shell-integrationens sporing af brugernavn, værtsnavn og mappe også fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7 zum Festlegen von Benutzername, Hostname und Pfad akzeptieren. iTerm2 Shell-Integration meldet diese Informationen jetzt über OSC 7, daher deaktiviert das Ausschalten dieser Option auch die Erfassung von Benutzername, Hostname und Verzeichnis durch die Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Accept OSC 7 to set username, hostname, and path. iTerm2 shell integration now reports this information using OSC 7, so turning this off also disables shell integration’s username, hostname, and directory tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar OSC 7 para definir el nombre de usuario, el nombre de host y la ruta. La integración con el shell de iTerm2 ahora informa de esta información mediante OSC 7, por lo que desactivarlo también desactiva el seguimiento del nombre de usuario, del nombre de host y del directorio de la integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy OSC 7 käyttäjätunnuksen, palvelinnimen ja polun asettamiseen. iTerm2:n komentotulkki-integraatio raportoi nämä tiedot nykyään OSC 7:llä, joten sen poistaminen käytöstä poistaa käytöstä myös komentotulkki-integraation käyttäjätunnuksen, palvelinnimen ja hakemiston seurannan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepter OSC 7 pour définir le nom d’utilisateur, le nom d’hôte et le chemin. L’intégration du shell d’iTerm2 signale désormais ces informations via OSC 7, donc la désactiver désactive aussi le suivi du nom d’utilisateur, du nom d’hôte et du répertoire par l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetta OSC 7 per impostare nome utente, nome host e percorso. L’integrazione shell di iTerm2 ora comunica queste informazioni tramite OSC 7, quindi disattivarlo disabilita anche il rilevamento di nome utente, nome host e directory dell’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名、ホスト名、パスの設定にOSC 7を受け付ける。iTerm2のシェル統合はこの情報をOSC 7を使って報告するようになったため、これをオフにすると、シェル統合によるユーザー名、ホスト名、ディレクトリの追跡も無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7로 사용자 이름, 호스트 이름, 경로를 설정하도록 허용합니다. 이제 iTerm2 셸 통합은 OSC 7로 이 정보를 보고하므로, 이 옵션을 끄면 셸 통합의 사용자 이름, 호스트 이름, 디렉토리 추적도 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godta OSC 7 for å angi brukernavn, vertsnavn og bane. Skallintegreringen i iTerm2 rapporterer nå denne informasjonen via OSC 7, så å slå dette av deaktiverer også skallintegreringens sporing av brukernavn, vertsnavn og mappe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepteer OSC 7 om gebruikersnaam, hostnaam en pad in te stellen. De shell-integratie van iTerm2 meldt deze informatie nu via OSC 7, dus als je dit uitschakelt, wordt ook het bijhouden van gebruikersnaam, hostnaam en map door de shell-integratie uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akceptuj OSC 7 do ustawiania nazwy użytkownika, nazwy hosta i ścieżki. Integracja iTerm2 z powłoką raportuje teraz te informacje za pomocą OSC 7, więc wyłączenie tej opcji wyłącza także śledzenie nazwy użytkownika, nazwy hosta i katalogu przez integrację z powłoką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceitar OSC 7 para definir nome de usuário, nome do host e caminho. A integração de shell do iTerm2 agora relata essas informações usando OSC 7, portanto desativar isto também desativa o rastreamento de nome de usuário, nome do host e diretório pela integração de shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принимать OSC 7 для установки имени пользователя, имени хоста и пути. Интеграция с оболочкой iTerm2 теперь передаёт эту информацию через OSC 7, поэтому отключение этого параметра также отключает отслеживание имени пользователя, имени хоста и каталога интеграцией с оболочкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijímať OSC 7 na nastavenie užívateľského mena, názvu hostiteľa a cesty. Integrácia shellu iTerm2 teraz tieto informácie hlási pomocou OSC 7, takže vypnutie tejto možnosti vypne aj sledovanie užívateľského mena, názvu hostiteľa a adresára v integrácii shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprejmi OSC 7 za nastavitev uporabniškega imena, imena gostitelja in poti. Integracija lupine iTerm2 zdaj te podatke sporoča z OSC 7, zato izklop te nastavitve onemogoči tudi sledenje uporabniškemu imenu, imenu gostitelja in imeniku v integraciji lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptera OSC 7 för att ange användarnamn, värdnamn och sökväg. iTerm2:s skalintegrering rapporterar nu den här informationen med OSC 7, så om du stänger av detta avaktiveras även skalintegreringens spårning av användarnamn, värdnamn och katalog."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adını, ana makine adını ve yolu belirlemek için OSC 7’yi kabul et. iTerm2 kabuk entegrasyonu artık bu bilgiyi OSC 7 ile bildirir; bu nedenle bunu kapatmak, kabuk entegrasyonunun kullanıcı adı, ana makine adı ve dizin izlemesini de devre dışı bırakır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chấp nhận OSC 7 để đặt tên người dùng, tên máy chủ và đường dẫn. Tích hợp shell của iTerm2 hiện báo cáo thông tin này bằng OSC 7, nên tắt tùy chọn này cũng sẽ tắt việc theo dõi tên người dùng, tên máy chủ và thư mục của tích hợp shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受 OSC 7，用于设置用户名、主机名和路径。iTerm2 的 Shell 集成现在使用 OSC 7 报告这些信息，因此关闭此项也会禁用 Shell 集成对用户名、主机名和目录的跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受 OSC 7 以設定使用者名稱、主機名稱和路徑。iTerm2 的 Shell 整合現在使用 OSC 7 回報這些資訊，因此關閉此項也會停用 Shell 整合對使用者名稱、主機名稱和目錄的追蹤。"
          }
        }
      }
    },
    "AdvancedSetting.activeUpdateCadence" : {
      "comment" : "Advanced setting: activeUpdateCadence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální snímková frekvence (FPS), když je adaptivní snímková frekvence vypnuta.\nPoznámka: u Maců s procesorem ARM se tato hodnota zdvojnásobuje pro displeje podporující alespoň 120 Hz. Změny tohoto nastavení neovlivní existující relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal billedhastighed (FPS), når adaptiv billedhastighed er slået fra.\nBemærk: den fordobles på ARM-Mac-computere med skærme, der understøtter mindst 120 Hz. Ændringer af denne indstilling påvirker ikke eksisterende sessioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Bildwiederholrate (FPS), wenn die adaptive Bildwiederholrate deaktiviert ist.\nHinweis: Dieser Wert wird auf ARM-Macs für Displays mit mindestens 120 Hz verdoppelt. Änderungen an dieser Einstellung wirken sich nicht auf bestehende Sitzungen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum frame rate (FPS) when adaptive framerate is disabled.\nNote: this is doubled on ARM Macs for displays that support at least 120hz. Modifications to this setting will not affect existing sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad de fotogramas máxima (FPS) cuando la velocidad de fotogramas adaptativa está desactivada.\nNota: se duplica en los Mac con procesador ARM para pantallas compatibles con al menos 120 Hz. Los cambios en este ajuste no afectan a las sesiones existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvataajuuden enimmäismäärä (FPS), kun mukautuva kuvataajuus on poistettu käytöstä.\nHuomaa: tämä kaksinkertaistuu ARM-Maceilla näytöillä, jotka tukevat vähintään 120 Hz:ää. Tämän asetuksen muutokset eivät vaikuta olemassa oleviin istuntoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence d’images maximale (FPS) lorsque la fréquence d’images adaptative est désactivée.\nRemarque : elle est doublée sur les Mac ARM pour les écrans compatibles avec au moins 120 Hz. Les modifications de ce réglage n’affectent pas les sessions existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza fotogrammi massima (FPS) quando la frequenza fotogrammi adattiva è disabilitata.\nNota: sui Mac con processore ARM raddoppia per i display che supportano almeno 120 Hz. Le modifiche a questa impostazione non influiscono sulle sessioni esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートが無効な場合の最大フレームレート（FPS）。\n注: 120Hz以上に対応したディスプレイを使用しているARM Macでは、この値は2倍になります。この設定を変更しても、既存のセッションには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임률이 꺼져 있을 때의 최대 프레임률(FPS).\n참고: ARM Mac에서 120Hz 이상을 지원하는 디스플레이에서는 이 값이 두 배가 됩니다. 이 설정을 변경해도 기존 세션에는 영향을 주지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal bildefrekvens (FPS) når adaptiv bildefrekvens er deaktivert.\nMerk: Dette dobles på Mac-maskiner med ARM-prosessor for skjermer som støtter minst 120 Hz. Endringer i denne innstillingen påvirker ikke eksisterende økter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale framesnelheid (FPS) wanneer adaptieve framesnelheid is uitgeschakeld.\nLet op: op Macs met ARM wordt dit verdubbeld voor beeldschermen die minstens 120 Hz ondersteunen. Wijzigingen in deze instelling hebben geen invloed op bestaande sessies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna liczba klatek na sekundę (FPS), gdy adaptacyjna liczba klatek jest wyłączona.\nUwaga: na Macach z procesorem ARM wartość ta jest podwajana dla wyświetlaczy obsługujących co najmniej 120 Hz. Zmiany tego ustawienia nie wpłyną na istniejące sesje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros máxima (FPS) quando a taxa de quadros adaptativa está desativada.\nObservação: isso é dobrado em Macs ARM para telas compatíveis com pelo menos 120 Hz. As alterações a esta configuração não afetam as sessões existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная частота кадров (FPS) при отключённой адаптивной частоте кадров.\nПримечание: на компьютерах Mac с ARM это значение удваивается для дисплеев с поддержкой не менее 120 Гц. Изменения этого параметра не затрагивают уже открытые сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximálna snímková frekvencia (FPS), keď je adaptívna snímková frekvencia vypnutá.\nPoznámka: na Macoch s ARM sa zdvojnásobuje pre displeje, ktoré podporujú aspoň 120 Hz. Zmeny tohto nastavenia sa nepremietnu do existujúcich relácií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največja hitrost sličic (FPS), ko je prilagodljiva hitrost sličic onemogočena.\nOpomba: na računalnikih Mac z ARM se podvoji za zaslone, ki podpirajo vsaj 120 Hz. Spremembe te nastavitve ne vplivajo na obstoječe seje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximal bildfrekvens (FPS) när adaptiv bildfrekvens är avaktiverad.\nObs: detta fördubblas på ARM-Mac för skärmar som stöder minst 120 Hz. Ändringar av den här inställningen påverkar inte befintliga sessioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlanabilir kare hızı devre dışıyken en yüksek kare hızı (FPS).\nNot: En az 120 Hz destekleyen ekranlarda ARM Mac’lerde bu değer ikiye katlanır. Bu ayarda yapılan değişiklikler mevcut oturumları etkilemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tốc độ khung hình tối đa (FPS) khi tắt tốc độ khung hình thích ứng.\nLưu ý: giá trị này được nhân đôi trên Mac ARM đối với màn hình hỗ trợ ít nhất 120 Hz. Thay đổi cài đặt này sẽ không ảnh hưởng đến các phiên hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应帧率被禁用时的最大帧率（FPS）。\n注意：对于支持至少 120hz 显示器的 ARM Mac 设备，此值会翻倍。对该设置的修改不会影响现有会话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用自適應影格率時的最大影格率（FPS）。\n注意：對於支援至少 120hz 的顯示器，此值在 ARM Mac 上會加倍。變更此設定不會影響現有的工作階段。"
          }
        }
      }
    },
    "AdvancedSetting.adaptiveFrameRateThroughputThreshold" : {
      "comment" : "Advanced setting: adaptiveFrameRateThroughputThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prahová hodnota propustnosti pro adaptivní snímkovou frekvenci.\nPokud se přijme více než tolik bajtů za sekundu, použije se nižší snímková frekvence 30 fps."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemløbstærskel for adaptiv billedhastighed.\nHvis der modtages flere byte pr. sekund end dette, bruges den lavere billedhastighed på 30 fps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsatzschwelle für die adaptive Bildwiederholrate.\nWenn mehr als diese Anzahl an Bytes pro Sekunde empfangen wird, wird die niedrigere Bildwiederholrate von 30 fps verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Throughput threshold for adaptive frame rate.\nIf more than this many bytes per second are received, use the lower frame rate of 30 fps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral de rendimiento para la velocidad de fotogramas adaptativa.\nSi se reciben más bytes por segundo que este valor, se usa la velocidad de fotogramas más baja de 30 fps."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukautuvan kuvataajuuden läpäisykyvyn kynnysarvo.\nJos sekunnissa vastaanotetaan tätä enemmän tavuja, käytetään alempaa 30 fps:n kuvataajuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil de débit pour la fréquence d’images adaptative.\nSi plus de ce nombre d’octets par seconde sont reçus, la fréquence d’images plus basse de 30 FPS est utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglia di throughput per la frequenza fotogrammi adattiva.\nSe vengono ricevuti più di questo numero di byte al secondo, viene usata la frequenza fotogrammi inferiore di 30 fps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートのスループットしきい値。\n1秒あたりに受信するバイト数がこの値を超えた場合、より低い30 fpsのフレームレートを使用する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임 레이트의 처리량 임계값.\n초당 이 바이트 수보다 많이 수신되면 더 낮은 프레임 레이트인 30fps를 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terskel for gjennomstrømming for adaptiv bildefrekvens.\nHvis det mottas flere byte per sekund enn dette, brukes den lavere bildefrekvensen på 30 fps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorvoerdrempel voor adaptieve framesnelheid.\nAls er meer dan dit aantal bytes per seconde wordt ontvangen, wordt de lagere framesnelheid van 30 fps gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próg przepustowości dla adaptacyjnej liczby klatek.\nJeśli odbierane jest więcej bajtów na sekundę niż ta wartość, używana jest niższa liczba klatek: 30 fps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa de transferência para a taxa de quadros adaptativa.\nSe forem recebidos mais bytes por segundo do que este valor, use a taxa de quadros mais baixa de 30 fps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог пропускной способности для адаптивной частоты кадров.\nЕсли скорость приёма данных превышает это значение байт в секунду, используется более низкая частота кадров 30 fps."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prah priepustnosti pre adaptívnu snímkovú frekvenciu.\nAk sa za sekundu prijme viac bajtov, ako je táto hodnota, použije sa nižšia snímková frekvencia 30 fps."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prag prepustnosti za prilagodljivo hitrost sličic.\nČe je prejetih več bajtov na sekundo od te vrednosti, se uporabi nižja hitrost sličic 30 FPS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genomströmningströskel för adaptiv bildfrekvens.\nOm fler än så här många byte per sekund tas emot används den lägre bildfrekvensen 30 fps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlanabilir kare hızı için verim eşiği.\nSaniyede bu kadar bayttan fazlası alınırsa daha düşük olan 30 fps kare hızı kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngưỡng thông lượng cho tốc độ khung hình thích ứng.\nNếu nhận được nhiều byte mỗi giây hơn mức này, hãy dùng tốc độ khung hình thấp hơn là 30 fps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应帧率的吞吐量阈值。\n如果每秒接收的字节数超过此值，则使用较低的 30 fps 帧率"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自適應影格率的傳輸量門檻。\n如果每秒接收的位元組數超過此值，則使用較低的 30 fps 影格率。"
          }
        }
      }
    },
    "AdvancedSetting.adblockListURL" : {
      "comment" : "Advanced setting: adblockListURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL seznamu filtrů pro blokování reklam\nMěl by to být soubor JSON ve formátu blokování obsahu WebKit. Seznam se automaticky stahuje každých 24 hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL til filterliste for annonceblokering\nDet skal være et JSON-arkiv i WebKits indholdsblokeringsformat. Listen hentes automatisk hver 24. time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL für die Werbeblocker-Filterliste\nDies sollte eine JSON-Datei im WebKit-Content-Blocker-Format sein. Die Liste wird automatisch alle 24 Stunden heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL for ad blocking filter list\nThis should be a JSON file in WebKit content blocker format. The list is downloaded automatically every 24 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL de la lista de filtros de bloqueo de anuncios\nDebe ser un archivo JSON en el formato de bloqueador de contenido de WebKit. La lista se descarga automáticamente cada 24 horas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mainosten estosuodatinluettelon URL\nTämän tulee olla JSON-tiedosto WebKitin sisällönestäjän muodossa. Luettelo ladataan automaattisesti 24 tunnin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL de la liste de filtres de blocage des publicités\nIl doit s’agir d’un fichier JSON au format de bloqueur de contenu WebKit. La liste est téléchargée automatiquement toutes les 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL dell’elenco di filtri per il blocco degli annunci\nDeve essere un file JSON nel formato dei blocchi di contenuti di WebKit. L’elenco viene scaricato automaticamente ogni 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告ブロックフィルターリストのURL\nWebKitコンテンツブロッカー形式のJSONファイルである必要があります。このリストは24時間ごとに自動的にダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광고 차단 필터 목록 URL\nWebKit 콘텐츠 차단기 형식의 JSON 파일이어야 합니다. 목록은 24시간마다 자동으로 다운로드됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL for filterlisten for annonseblokkering\nDette bør være en JSON-fil i WebKit-formatet for innholdsblokkering. Listen lastes ned automatisk hver 24. time."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL voor de filterlijst van de advertentieblokkering\nDit moet een JSON-bestand zijn in het contentblockerformaat van WebKit. De lijst wordt elke 24 uur automatisch gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL listy filtrów blokowania reklam\nPowinien to być plik JSON w formacie blokowania treści WebKit. Lista jest pobierana automatycznie co 24 godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL da lista de filtros de bloqueio de anúncios\nDeve ser um arquivo JSON no formato de bloqueador de conteúdo do WebKit. A lista é transferida automaticamente a cada 24 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL списка фильтров для блокировки рекламы.\nЭто должен быть файл JSON в формате блокировщика содержимого WebKit. Список автоматически загружается каждые 24 часа."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL zoznamu filtrov na blokovanie reklám\nMal by to byť súbor JSON vo formáte blokovača obsahu WebKit. Zoznam sa automaticky sťahuje každých 24 hodín."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL seznama filtrov za blokiranje oglasov\nTo mora biti datoteka JSON v obliki blokatorja vsebine WebKit. Seznam se samodejno prenese vsakih 24 ur."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL för filterlista för annonsblockering\nDen ska vara en JSON-fil i WebKits innehållsblockeringsformat. Listan hämtas automatiskt var 24:e timme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reklam engelleme filtre listesinin URL’si\nBu, WebKit içerik engelleyici biçiminde bir JSON dosyası olmalıdır. Liste her 24 saatte bir otomatik olarak indirilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL của danh sách bộ lọc chặn quảng cáo\nĐây phải là một tệp JSON ở định dạng trình chặn nội dung của WebKit. Danh sách được tải về tự động mỗi 24 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "广告拦截过滤器列表的 URL。\n这应该是一个 WebKit 内容拦截器格式的 JSON 文件。该列表每 24 小时自动下载一次"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "廣告封鎖過濾清單的 URL\n這應該是 WebKit 內容封鎖器格式的 JSON 檔案。此清單每 24 小時自動下載一次。"
          }
        }
      }
    },
    "AdvancedSetting.addDynamicTagToDynamicProfiles" : {
      "comment" : "Advanced setting: addDynamicTagToDynamicProfiles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidat dynamickým profilům štítek „Dynamic“.\nPokud je zapnuto, dynamické profily dostanou štítek „Dynamic“, podle kterého je lze filtrovat nebo rozpoznat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føj et tag med navnet “Dynamic” til dynamiske profiler.\nNår det er slået til, får dynamiske profiler tilføjet et tag med navnet “Dynamic”, som kan bruges til at filtrere eller identificere dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dynamischen Profilen ein Tag „Dynamic“ hinzu.\nWenn aktiviert, erhalten dynamische Profile ein Tag „Dynamic“, mit dem sie gefiltert oder identifiziert werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a 'Dynamic' tag to dynamic profiles.\nWhen enabled, dynamic profiles will have a 'Dynamic' tag added to them, which can be used to filter or identify them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir una etiqueta “Dynamic” a los perfiles dinámicos.\nSi se activa, a los perfiles dinámicos se les añadirá una etiqueta “Dynamic” que se puede usar para filtrarlos o identificarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää dynaamisiin profiileihin ”Dynamic”-tunniste.\nKun tämä on käytössä, dynaamisiin profiileihin lisätään ”Dynamic”-tunniste, jonka avulla ne voi suodattaa tai tunnistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un tag « Dynamic » aux profils dynamiques.\nSi cette option est activée, un tag « Dynamic » est ajouté aux profils dynamiques, ce qui permet de les filtrer ou de les identifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un tag “Dynamic” ai profili dinamici.\nSe abilitato, ai profili dinamici viene aggiunto un tag “Dynamic” che può essere usato per filtrarli o identificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動的プロファイルに「Dynamic」タグを追加する。\n有効にすると、動的プロファイルに「Dynamic」タグが追加され、フィルタリングや識別に利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일에 'Dynamic' 태그 추가.\n활성화하면 동적 프로파일에 'Dynamic' 태그가 추가되며, 이를 사용하여 동적 프로파일을 필터링하거나 식별할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en etikett ‘Dynamic’ på dynamiske profiler.\nNår dette er aktivert, får dynamiske profiler en etikett ‘Dynamic’ som kan brukes til å filtrere eller identifisere dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een tag ‘Dynamic’ toe aan dynamische profielen.\nAls dit is ingeschakeld, krijgen dynamische profielen een tag ‘Dynamic’, waarmee je ze kunt filteren of herkennen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj tag „Dynamic” do profili dynamicznych.\nPo włączeniu profile dynamiczne otrzymają tag „Dynamic”, którego można użyć do ich filtrowania lub identyfikowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar uma tag “Dynamic” aos perfis dinâmicos.\nQuando ativado, os perfis dinâmicos terão uma tag “Dynamic” adicionada, que pode ser usada para filtrá-los ou identificá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлять тег «Dynamic» к динамическим профилям.\nПри включении к динамическим профилям добавляется тег «Dynamic», который можно использовать для их фильтрации или идентификации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridať dynamickým profilom tag „Dynamic“.\nAk je zapnuté, dynamickým profilom sa pridá tag „Dynamic“, ktorý sa dá použiť na ich filtrovanie alebo identifikáciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamičnim profilom dodaj oznako »Dynamic«.\nČe je omogočeno, bo dinamičnim profilom dodana oznaka »Dynamic«, s katero jih lahko filtrirate ali prepoznate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till taggen ”Dynamic” på dynamiska profiler.\nOm detta är aktiverat får dynamiska profiler taggen ”Dynamic”, som kan användas för att filtrera eller identifiera dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik profillere bir “Dynamic” etiketi ekle.\nEtkinleştirildiğinde dinamik profillere, bunları filtrelemek veya tanımlamak için kullanılabilecek bir “Dynamic” etiketi eklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm thẻ “Dynamic” vào các hồ sơ động.\nKhi bật, các hồ sơ động sẽ được thêm thẻ “Dynamic”, có thể dùng để lọc hoặc nhận biết chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在动态配置文件中添加‘动态’标签。\n启用后，动态配置文件将添加‘动态’标签，可用于过滤或识别它们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為動態描述檔加入「動態」標籤。\n啟用後，動態描述檔會加上「動態」標籤，可用來篩選或識別它們。"
          }
        }
      }
    },
    "AdvancedSetting.addTabButtonUsesCurrentProfile" : {
      "comment" : "Advanced setting: addTabButtonUsesCurrentProfile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má tlačítko „nový panel“ v řádku panelů použít profil aktuální relace?\nPokud je zapnuto, kliknutí na tlačítko „+“ otevře nový panel s profilem aktuální relace místo výchozího profilu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal knappen “ny fane” i fanelinjen bruge den nuværende sessions profil?\nNår det er slået til, åbner et klik på knappen “+” en ny fane med den nuværende sessions profil i stedet for standardprofilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll die Schaltfläche „Neuer Tab“ in der Tableiste das Profil der aktuellen Sitzung verwenden?\nWenn aktiviert, öffnet ein Klick auf die Schaltfläche „+“ einen neuen Tab mit dem Profil der aktuellen Sitzung anstelle des Standardprofils."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should the “new tab” button in the tab bar use the current session’s profile?\nWhen enabled, clicking the “+” button opens a new tab with the current session’s profile instead of the default profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe el botón de “nueva pestaña” de la barra de pestañas usar el perfil de la sesión actual?\nSi se activa, al hacer clic en el botón “+” se abre una nueva pestaña con el perfil de la sesión actual en lugar del perfil predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttääkö välilehtipalkin ”uusi välilehti” -painike nykyisen istunnon profiilia?\nKun tämä on käytössä, ”+”-painikkeen klikkaaminen avaa uuden välilehden nykyisen istunnon profiililla oletusprofiilin sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton « nouvel onglet » de la barre d’onglets doit-il utiliser le profil de la session actuelle ?\nSi cette option est activée, un clic sur le bouton « + » ouvre un nouvel onglet avec le profil de la session actuelle au lieu du profil par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante “nuovo pannello” nella barra dei pannelli deve usare il profilo della sessione corrente?\nSe abilitato, facendo clic sul pulsante “+” si apre un nuovo pannello con il profilo della sessione corrente invece del profilo predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーの「新規タブ」ボタンは現在のセッションのプロファイルを使用しますか？\n有効にすると、「+」ボタンをクリックした際にデフォルトのプロファイルではなく、現在のセッションのプロファイルで新規タブが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대의 “새로운 탭” 버튼에서 현재 세션의 프로파일을 사용하겠습니까?\n켜면 “+” 버튼을 클릭할 때 기본 프로파일 대신 현재 세션의 프로파일로 새로운 탭이 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal «ny fane»-knappen i fanelinjen bruke profilen til gjeldende økt?\nNår dette er aktivert, åpner et klikk på «+»-knappen en ny fane med profilen til gjeldende økt i stedet for standardprofilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet de knop ‘nieuw tabblad’ in de tabbladbalk het profiel van de huidige sessie gebruiken?\nAls dit is ingeschakeld, opent een klik op de knop ‘+’ een nieuw tabblad met het profiel van de huidige sessie in plaats van het standaardprofiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy przycisk „nowa karta” na pasku kart ma używać profilu bieżącej sesji?\nPo włączeniu kliknięcie przycisku „+” otwiera nową kartę z profilem bieżącej sesji zamiast profilu domyślnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão de “nova aba” na barra de abas deve usar o perfil da sessão atual?\nQuando ativado, clicar no botão “+” abre uma nova aba com o perfil da sessão atual em vez do perfil padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли кнопка «новая вкладка» на панели вкладок использовать профиль текущей сессии?\nПри включении нажатие кнопки «+» открывает новую вкладку с профилем текущей сессии вместо профиля по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má tlačidlo „nový tab“ na lište s tabmi používať profil aktuálnej relácie?\nAk je zapnuté, kliknutie na tlačidlo „+“ otvorí nový tab s profilom aktuálnej relácie namiesto predvoleného profilu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj gumb »nov zavihek« v vrstici z zavihki uporabi profil trenutne seje?\nČe je omogočeno, klik na gumb »+« odpre nov zavihek s profilom trenutne seje namesto privzetega profila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ska knappen ”ny flik” i flikfältet använda den aktuella sessionens profil?\nOm detta är aktiverat öppnas en ny flik med den aktuella sessionens profil när du klickar på knappen ”+”, i stället för den förvalda profilen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğundaki “yeni sekme” düğmesi geçerli oturumun profilini kullansın mı?\nEtkinleştirildiğinde “+” düğmesini tıklamak, varsayılan profil yerine geçerli oturumun profiliyle yeni bir sekme açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút “tab mới” trên thanh tab có nên dùng hồ sơ của phiên hiện tại không?\nKhi bật, bấm nút “+” sẽ mở một tab mới với hồ sơ của phiên hiện tại thay vì hồ sơ mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应让标签页栏中的“新标签页”按钮使用当前会话的配置文件？\n如果启用，点击“+”按钮将打开一个使用当前会话配置文件的标签页，而非默认配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁列中的「新增標籤頁」按鈕是否應使用目前工作階段的描述檔？\n啟用後，按一下「+」按鈕會以目前工作階段的描述檔打開新標籤頁，而不是預設描述檔。"
          }
        }
      }
    },
    "AdvancedSetting.addUtilitiesToPATH" : {
      "comment" : "Advanced setting: addUtilitiesToPATH",
      "extractionState" : "extracted_with_value",
      "localizations" : {
