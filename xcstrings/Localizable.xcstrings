    },
    "AdvancedSetting.bellRateLimit" : {
      "comment" : "Advanced setting: bellRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestzeit zwischen Signalton oder Bildschirmblitz bei einem Klingelzeichen, in Sekunden.\nWenn das Zeitintervall zwischen Klingelzeichen kürzer als dieser Wert ist, wird es ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum time between beeping or flashing screen on bell, in seconds.\nIf the time interval between bells is less than this amount of time, it will be ignored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo mínimo entre pitidos o destellos de pantalla por la campana, en segundos.\nSi el intervalo entre campanas es menor que este tiempo, se ignorará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée minimale, en secondes, entre deux bips ou clignotements de l’écran lors d’une sonnerie.\nSi l’intervalle entre deux sonneries est inférieur à cette durée, la sonnerie est ignorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo minimo tra un segnale acustico o lampeggiamento dello schermo e il successivo in risposta al campanello, in secondi.\nSe l’intervallo tra due campanelli è inferiore a questo valore, il campanello verrà ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベル時にビープ音を鳴らしたり画面を点滅させたりする間隔の最小時間 (秒単位)。\nベルの間隔がこの時間より短い場合、無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벨이 울릴 때 경고음 또는 화면 깜빡임 사이의 최소 시간(초).\n벨 사이의 간격이 이 시간보다 짧으면 무시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo mínimo entre bipes ou piscadas da tela na campainha, em segundos.\nSe o intervalo de tempo entre campainhas for menor que este período, ela será ignorada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимальное время между звуковым сигналом или миганием экрана при сигнале колокольчика, в секундах.\nЕсли интервал между сигналами меньше этого значения, он будет проигнорирован."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilde bip sesi çıkarma veya ekranı yanıp söndürme arasındaki en kısa süre, saniye cinsinden.\nZiller arasındaki süre bu değerden kısaysa yok sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "铃声或屏幕闪烁之间的最小时间（秒）。  \n若铃声间隔小于此值，则会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "響鈴時發出嗶聲或閃爍螢幕之間的最短時間，以秒為單位。\n如果兩次響鈴的間隔短於此時間，就會被忽略。"
          }
        }
      }
    },
    "AdvancedSetting.bootstrapDaemon" : {
      "comment" : "Advanced setting: bootstrapDaemon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass Sitzungen ein Ab- und wieder Anmelden überstehen.\nDies bricht den „auth sufficient pam_tid.so“-Hack, den manche Leute verwenden, damit sudo sich per Touch ID authentifizieren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow sessions to survive logging out and back in.\nThis breaks the “auth sufficient pam_tid.so” hack some people use to allow sudo to authenticate with Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que las sesiones sobrevivan al cerrar y volver a iniciar sesión.\nEsto rompe el truco “auth sufficient pam_tid.so” que algunas personas usan para que sudo se autentique con Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettre aux sessions de survivre à une déconnexion puis reconnexion.\nCela casse l’astuce « auth sufficient pam_tid.so » que certains utilisent pour authentifier sudo avec Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti alle sessioni di sopravvivere a una disconnessione e a un nuovo accesso.\nQuesto interrompe il trucco “auth sufficient pam_tid.so” che alcuni usano per consentire a sudo di autenticarsi con Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウトして再度ログインしてもセッションを保持できるようにします。\nこれにより、一部のユーザーが sudo を Touch ID で認証させるために使っている「auth sufficient pam_tid.so」というハックが機能しなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그아웃했다가 다시 로그인해도 세션 유지 허용.\n일부 사용자가 sudo에서 Touch ID로 인증하기 위해 사용하는 “auth sufficient pam_tid.so” 편법이 작동하지 않게 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que sessões sobrevivam ao logout e login novamente.\nIsso quebra o truque “auth sufficient pam_tid.so” que algumas pessoas usam para permitir que o sudo autentique com Touch ID."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить сессиям переживать выход из системы и повторный вход.\nЭто нарушает хак «auth sufficient pam_tid.so», которым некоторые пользуются, чтобы разрешить sudo аутентификацию по Touch ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumların oturumu kapatıp yeniden açmadan sağ çıkmasına izin ver.\nBu, bazı kişilerin sudo’nun Touch ID ile kimlik doğrulamasına izin vermek için kullandığı “auth sufficient pam_tid.so” yöntemini bozar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许会话在登出后重新登录时继续运行。  \n此设置可解除部分用户使用的“auth sufficient pam_tid.so”技巧，该技巧用于允许sudo通过Touch ID认证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許工作階段在登出後再登入時繼續存在。\n這會破壞有些人用來讓 sudo 以 Touch ID 驗證的「auth sufficient pam_tid.so」做法。"
          }
        }
      }
    },
    "AdvancedSetting.bordersOnlyInLightMode" : {
      "comment" : "Advanced setting: bordersOnlyInLightMode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undurchsichtige Fenster haben nur im hellen Modus einen Rahmen.\nDiese Einstellung ändert „Rahmen um Fenster anzeigen“. Rahmen bei undurchsichtigen Fenstern im dunklen Modus sehen unschön aus, und das Betriebssystem zeichnet ohnehin einen brauchbaren Rahmen. Aktivieren Sie dies, wenn Sie Schwierigkeiten haben, sie zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opaque windows have a border only in light mode.\nThis setting modifies “Show border around windows”. Borders in opaque windows in dark mode are ugly and the OS draws one that is pretty serviceable. Enable this if you have trouble seeing them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas opacas tienen borde solo en el modo claro.\nEste ajuste modifica “Mostrar borde alrededor de las ventanas”. Los bordes de las ventanas opacas en el modo oscuro son feos y el sistema dibuja uno bastante aceptable. Actívalo si tienes problemas para verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres opaques n’ont de bordure qu’en mode clair.\nCe réglage modifie « Afficher une bordure autour des fenêtres ». Les bordures des fenêtres opaques en mode sombre sont laides et le système en dessine une tout à fait correcte. Activez cette option si vous avez du mal à les voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre opache hanno un bordo solo in modalità chiara.\nQuesta impostazione modifica “Mostra bordo attorno alle finestre”. I bordi nelle finestre opache in modalità scura sono brutti e il sistema ne disegna uno più che adeguato. Abilitala se hai difficoltà a vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明なウィンドウは、ライトモードのときのみ境界線を表示します。\nこの設定は「ウィンドウの周囲に境界線を表示」を変更します。ダークモードの不透明なウィンドウの境界線は見た目が悪く、OS が描画するもので十分実用的です。境界線が見えにくい場合はこれを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불투명 윈도우는 라이트 모드에서만 테두리를 가집니다.\n이 설정은 “윈도우 주위에 테두리 보기”를 변경합니다. 다크 모드에서 불투명 윈도우의 테두리는 보기 좋지 않으며 OS가 꽤 쓸 만한 테두리를 그려 줍니다. 테두리가 잘 보이지 않으면 이 설정을 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas opacas têm borda apenas no modo claro.\nEste ajuste modifica “Mostrar borda ao redor das janelas”. Bordas em janelas opacas no modo escuro são feias e o sistema desenha uma que é bastante útil. Ative isto se tiver dificuldade em vê-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрозрачные окна имеют рамку только в светлом режиме.\nЭта настройка изменяет «Показывать рамку вокруг окон». Рамки у непрозрачных окон в тёмном режиме выглядят некрасиво, а ОС и так рисует вполне приемлемую рамку. Включите это, если вам трудно их разглядеть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opak pencerelerin kenarlığı yalnızca açık modda olur.\nBu ayar “Pencerelerin çevresinde kenarlık göster” ayarını değiştirir. Koyu moddaki opak pencerelerde kenarlıklar çirkin görünür ve işletim sisteminin çizdiği kenarlık oldukça yeterlidir. Kenarlıkları görmekte zorlanıyorsanız bunu etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明窗口在亮色模式下仅有边框。  \n此设置修改“显示窗口边框”选项。暗色模式下的不透明窗口边框会显得丑陋，操作系统会自动绘制一个美观的边框。若难以看到边框，可启用此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明視窗僅在淺色模式下有邊框。\n此設定會變更「在視窗周圍顯示邊框」。深色模式下不透明視窗的邊框很難看，而系統繪製的邊框已相當堪用。如果你看不清楚邊框，請啟用此項。"
          }
        }
      }
    },
    "AdvancedSetting.bounceOnInactiveBell" : {
      "comment" : "Advanced setting: bounceOnInactiveBell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock-Symbol hüpfen lassen, wenn das Klingelzeichen ertönt, während eine andere App aktiv ist?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bounce dock icon when the bell rings while another app is active?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hacer rebotar el icono del Dock cuando suena la campana mientras otra app está activa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire rebondir l’icône du Dock quand la sonnerie retentit alors qu’une autre app est active ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Far rimbalzare l’icona del Dock quando suona il campanello mentre un’altra app è attiva?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリがアクティブなときにベルが鳴ったら、Dock アイコンをバウンスさせますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 활성 상태일 때 벨이 울리면 Dock 아이콘을 튀어 오르게 하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balançar o ícone no dock quando a campainha tocar enquanto outro app está ativo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпрыгивать значку в Dock при сигнале колокольчика, когда активно другое приложение?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama etkinken zil çaldığında Dock simgesi zıplasın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当其他应用运行时，铃声响起时是否弹跳窗口栏图标？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他 App 在使用中時響鈴，是否讓 Dock 圖像跳動？"
          }
        }
      }
    },
    "AdvancedSetting.browserBundleID" : {
      "comment" : "Advanced setting: browserBundleID",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundle-ID des Browsers, mit dem URLs geöffnet werden sollen.\nLeer lassen, um die Systemvorgabe zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bundle ID of browser to open URLs with.\nLeave empty to use system default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID de paquete del navegador con el que abrir las URL.\nDéjalo vacío para usar el predeterminado del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiant de bundle du navigateur avec lequel ouvrir les URL.\nLaissez vide pour utiliser celui du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID bundle del browser con cui aprire gli URL.\nLascia vuoto per usare quello predefinito del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL を開くブラウザのバンドル ID。\n空欄のままにするとシステムのデフォルトを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL을 열 때 사용할 브라우저의 번들 ID.\n시스템 기본값을 사용하려면 비워 두십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundle ID do navegador com que abrir URLs.\nDeixe vazio para usar o padrão do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundle ID браузера для открытия URL.\nОставьте пустым, чтобы использовать системный браузер по умолчанию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL’leri açacak tarayıcının paket kimliği.\nSistem varsayılanını kullanmak için boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开URL的浏览器包ID。  \n留空则使用系统默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用來打開 URL 的瀏覽器 Bundle ID。\n留空則使用系統預設值。"
          }
        }
      }
    },
    "AdvancedSetting.browserPluginPathHint" : {
      "comment" : "Advanced setting: browserPluginPathHint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicherort des Browser-Plug-ins, falls dieser nicht automatisch erkannt werden kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location of browser plugin if it cannot be auto-detected"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación del plugin del navegador si no se puede detectar automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emplacement du module du navigateur s’il ne peut pas être détecté automatiquement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizione del plug-in del browser se non può essere rilevata automaticamente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動検出できない場合のブラウザプラグインの場所"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 감지할 수 없는 경우 브라우저 플러그인의 위치"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localização do plugin do navegador se não puder ser detectada automaticamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расположение плагина браузера, если оно не может быть определено автоматически"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik algılanamazsa tarayıcı eklentisinin konumu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法自动检测到的浏览器插件位置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法自動偵測時，瀏覽器外掛程式的位置"
          }
        }
      }
    },
    "AdvancedSetting.browserProfiles" : {
      "comment" : "Advanced setting: browserProfiles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile im Browser-Stil aktivieren?\nSie müssen iTerm2 neu starten, damit dies wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable browser-style profiles?\nYou must restart iTerm2 for this to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar los perfiles de estilo navegador?\nDebes reiniciar iTerm2 para que surta efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer les profils de type navigateur ?\nVous devez redémarrer iTerm2 pour que cela prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare i profili in stile browser?\nDevi riavviare iTerm2 affinché abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザ形式のプロファイルを有効にしますか?\nこれを反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 스타일 프로파일을 활성화하겠습니까?\n이 설정을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar perfis no estilo de navegador?\nVocê deve reiniciar o iTerm2 para que isto tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить профили в стиле браузера?\nДля вступления в силу необходимо перезапустить iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı tarzı profiller etkinleştirilsin mi?\nBunun etkili olması için iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用浏览器式配置文件？  \n需重启iTerm2才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用瀏覽器式描述檔？\n你必須重新啟動 iTerm2 才會生效。"
          }
        }
      }
    },
    "AdvancedSetting.browserProxyEnabled" : {
      "comment" : "Advanced setting: browserProxyEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP-Proxy für den Webbrowser aktivieren?\nWenn aktiviert, wird der gesamte Browser-Datenverkehr über den konfigurierten Proxyserver geleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable HTTP proxy for web browser?\nWhen enabled, routes all browser traffic through the configured proxy server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar el proxy HTTP para el navegador web?\nSi se activa, todo el tráfico del navegador se dirige a través del servidor proxy configurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le proxy HTTP pour le navigateur web ?\nSi cette option est activée, tout le trafic du navigateur passe par le serveur proxy configuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare il proxy HTTP per il browser web?\nSe abilitato, instrada tutto il traffico del browser attraverso il server proxy configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web ブラウザ用の HTTP プロキシを有効にしますか?\n有効にすると、すべてのブラウザトラフィックが設定されたプロキシサーバー経由でルーティングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 브라우저에 HTTP 프록시를 활성화하겠습니까?\n활성화하면 모든 브라우저 트래픽이 구성된 프록시 서버를 거칩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar proxy HTTP para o navegador web?\nQuando ativado, roteia todo o tráfego do navegador pelo servidor proxy configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить HTTP-прокси для веб-браузера?\nПри включении весь трафик браузера направляется через настроенный прокси-сервер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web tarayıcısı için HTTP proxy etkinleştirilsin mi?\nEtkinleştirildiğinde tüm tarayıcı trafiğini yapılandırılmış proxy sunucusu üzerinden yönlendirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用网页浏览器HTTP代理？  \n启用后，所有浏览器流量将通过配置的代理服务器路由。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為網頁瀏覽器啟用 HTTP 代理伺服器？\n啟用後，所有瀏覽器流量都會經由設定的代理伺服器傳送。"
          }
        }
      }
    },
