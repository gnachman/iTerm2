    "ToolStatus.WatchingTooltipSession" : {
      "comment" : "Tooltip for the notify button when armed and targeting the selected session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwacht die ausgewählte Sitzung auf eine Statusänderung. Bei der nächsten Änderung erscheint ein Hinweis, danach wird dies wieder deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watching the selected session for a status change. An alert will appear on the next change, then turn this off."
