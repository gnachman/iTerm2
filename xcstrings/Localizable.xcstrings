    "Tip.0109.Body" : {
      "comment" : "Tip of the day body, id 0109",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessern Sie Ihre Bearbeitung im Composer mit mehreren Cursor, die Sie mit ^⇧-nach oben/unten oder ⌥-Ziehen erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enhance your editing in the Composer with multiple cursors, created using ^⇧-up/down or ⌥-drag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora tu edición en el compositor con varios cursores, que se crean con ^⇧-arriba/abajo o ⌥-arrastrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliorez votre édition dans le compositeur avec des curseurs multiples, créés avec ^⇧-haut/bas ou ⌥-glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliora la modifica nel Compositore con più cursori, creati con ^⇧-su/giù o ⌥-trascinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧上/下または⌥ドラッグで作成できる複数カーソルを使うと、コンポーザーでの編集がさらに快適になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧-위/아래 화살표 또는 ⌥-드래그로 만드는 다중 커서를 사용하여 컴포저에서 더 효율적으로 편집해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua edição no Compositor com múltiplos cursores, criados usando ^⇧-cima/baixo ou ⌥-arrastar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшите редактирование в Композере с помощью нескольких курсоров, создаваемых с помощью ^⇧-вверх/вниз или ⌥-перетаскивания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧-yukarı/aşağı veya ⌥-sürükleme ile oluşturulan birden çok imleçle Oluşturucu’daki düzenlemenizi geliştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Composer 中，使用 ^⇧-上/下或 ⌥-拖拽功能添加多个光标，以改进编辑体验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編寫器中使用多重游標提升編輯效率，可用 ^⇧-上/下或 ⌥-拖移來建立。"
          }
        }
      }
    },
