        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랙패드 스크롤을 빠르게 하겠습니까?\n이전 스크롤 속도를 사용하려면 아니요로 설정하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trackpad rola rápido?\nDefina como Não para a velocidade de rolagem legada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая прокрутка трекпадом?\nУстановите «Нет» для прежней скорости прокрутки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme dörtgeni hızlı kaydırsın mı?\nEski kaydırma hızı için Hayır yapın."
