    "ScriptsMenu.EnvMissingLaunch" : {
      "comment" : "Script Console message shown when a script's Python environment is missing at auto-launch",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Python-Umgebung für „%@“ fehlt (möglicherweise wurde die gemeinsam genutzte Laufzeitumgebung gelöscht). Starten Sie es über das Menü „Scripts“, um es neu zu erstellen.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python environment for “%@” is missing (the shared runtime may have been deleted). Launch it from the Scripts menu to rebuild it.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el entorno de Python de “%@” (puede que se haya eliminado el entorno de ejecución compartido). Inícialo desde el menú Scripts para reconstruirlo.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement Python de « %@ » est manquant (l’environnement d’exécution partagé a peut-être été supprimé). Lancez-le depuis le menu Scripts pour le reconstruire.\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente Python di “%@” manca (l’ambiente di esecuzione condiviso potrebbe essere stato eliminato). Avvialo dal menu Script per ricostruirlo.\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のPython環境が見つかりません（共有ランタイムが削除された可能性があります）。再構築するには、Scriptsメニューから起動してください。\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 Python 환경이 없습니다(공유 런타임이 삭제되었을 수 있음). 다시 빌드하려면 스크립트 메뉴에서 실행하십시오.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ambiente Python de “%@” está ausente (o runtime compartilhado pode ter sido apagado). Inicie-o pelo menu Scripts para reconstruí-lo.\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окружение Python для «%@» отсутствует (возможно, общая среда выполнения была удалена). Запустите его из меню Scripts, чтобы пересобрать.\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” için Python ortamı eksik (paylaşılan çalışma zamanı silinmiş olabilir). Yeniden oluşturmak için Betikler menüsünden başlatın.\n"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的 Python 环境缺失（共享运行时可能已被删除）。请从“脚本”菜单启动它以重建环境。\n"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」的 Python 環境已遺失（共用執行環境可能已被刪除）。請從「腳本」選單啟動它以重新建置。\n"
          }
        }
      }
    },
    "ScriptsMenu.EnvMissingRebuild" : {
