    "Tip.0102.Body" : {
      "comment" : "Tip of the day body, id 0102",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke správci hesel můžete přistupovat bez ověření úpravou nastavení v nabídce vedle jeho vyhledávacího pole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få adgang til din adgangskodeadministrator uden godkendelse ved at justere indstillingerne via menuen ved siden af dens søgefelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greifen Sie ohne Authentifizierung auf Ihren Passwort-Manager zu, indem Sie die Einstellungen über das Menü neben dessen Suchfeld anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access your password manager without authentication by adjusting the settings via the menu next to its search field."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accede a tu gestor de contraseñas sin autenticación ajustando la configuración desde el menú junto a su campo de búsqueda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä salasanojen hallintaa ilman todennusta säätämällä asetuksia hakukentän vieressä olevan valikon kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez à votre gestionnaire de mots de passe sans authentification en ajustant les réglages via le menu à côté de son champ de recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi al gestore password senza autenticazione regolando le impostazioni dal menu accanto al relativo campo di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドの横にあるメニューで設定を調整すると、認証なしでパスワードマネージャーにアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 필드 옆의 메뉴에서 설정을 조정하면 인증 없이 암호 관리자에 접근할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få tilgang til passordbehandleren uten autentisering ved å justere innstillingene via menyen ved siden av søkefeltet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open je wachtwoordbeheerder zonder authenticatie door de instellingen aan te passen via het menu naast het zoekveld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzyskuj dostęp do menedżera haseł bez uwierzytelniania, dostosowując ustawienia w menu obok jego pola wyszukiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesse seu cofre de senhas sem autenticação ajustando os ajustes pelo menu ao lado do seu campo de busca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте доступ к менеджеру паролей без аутентификации, изменив настройки в меню рядом с его полем поиска."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K správcovi hesiel získate prístup bez overenia úpravou nastavení v menu vedľa jeho vyhľadávacieho poľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do upravitelja gesel dostopajte brez overjanja, tako da prilagodite nastavitve prek menija ob njegovem iskalnem polju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få åtkomst till din lösenordshanterare utan autentisering genom att justera inställningarna via menyn bredvid dess sökfält."
          }
        },
        "tr" : {
          "stringUnit" : {
