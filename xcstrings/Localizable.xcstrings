    "SCPFile.AuthenticityUnknown" : {
      "comment" : "Prompt shown when connecting to a host for the first time; first %@ is the host, second %@ is the key hash type, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Authentizität des Hosts '%1$@' kann nicht festgestellt werden.\n\nDer %2$@-Schlüssel-Fingerabdruck lautet %3$@.\n\nTrotzdem verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The authenticity of host '%1$@' can't be established.\n\n%2$@ key fingerprint is %3$@.\n\nConnect anyway?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト '%1$@' の信頼性を確認できません。\n\n%2$@ 鍵のフィンガープリントは %3$@ です。\n\nこのまま接続しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 '%1$@'의 진위를 확인할 수 없습니다.\n\n%2$@ 키 지문은 %3$@입니다.\n\n그래도 연결하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível estabelecer a autenticidade do host “%1$@”.\n\nA impressão digital da chave %2$@ é %3$@.\n\nConectar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно установить подлинность узла «%1$@».\n\nОтпечаток ключа %2$@: %3$@.\n\nВсё равно подключиться?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认主机 '%1$@' 的真实性。\n\n%2$@ 按键指纹为 %3$@。\n\n仍要连接吗？"
          }
        }
      }
    },
