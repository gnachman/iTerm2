    "PasswordArchive.SummaryCancelled" : {
      "comment" : "Shown above the import summary when the user canceled partway through",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import byl zrušen. Hesla importovaná před zrušením byla zachována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importen blev annulleret. Adgangskoder, der blev importeret før annulleringen, blev beholdt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Import wurde abgebrochen. Vor dem Abbruch importierte Passwörter wurden beibehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The import was canceled. Passwords imported before canceling were kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la importación. Se conservaron las contraseñas importadas antes de cancelar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuonti kumottiin. Ennen kumoamista tuodut salasanat säilytettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importation a été annulée. Les mots de passe importés avant l’annulation ont été conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’importazione è stata annullata. Le password importate prima dell’annullamento sono state mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートはキャンセルされました。キャンセル前にインポートされたパスワードは保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오기가 취소되었습니다. 취소하기 전에 가져온 암호는 유지되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importen ble avbrutt. Passord som ble importert før avbruddet, er beholdt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De import is geannuleerd. Wachtwoorden die vóór het annuleren zijn geïmporteerd, zijn behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import został anulowany. Hasła zaimportowane przed anulowaniem zostały zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A importação foi cancelada. As senhas importadas antes do cancelamento foram mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импорт отменён. Пароли, импортированные до отмены, сохранены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import bol zrušený. Heslá importované pred zrušením boli ponechané."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvoz je bil preklican. Gesla, uvožena pred preklicem, so ohranjena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importen avbröts. Lösenord som importerades före avbrottet behölls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarma iptal edildi. İptal etmeden önce içe aktarılan parolalar korundu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc nhập đã bị hủy. Các mật khẩu đã nhập trước khi hủy được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入已取消。取消前已导入的密码均已保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入已取消。取消前已匯入的密碼均已保留。"
          }
        }
      }
    },
