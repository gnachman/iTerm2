    "MarkdownPorthole.ImageUnavailable" : {
      "comment" : "Shown in a popover when an image in Markdown displayed in the terminal can't be shown. The placeholder is the image's path or URL as written in the Markdown.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht angezeigt werden. Es können nur Bilder aus Dateien auf diesem Mac angezeigt werden, und Bilder aus dem Web werden nie heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn’t show “%@”. Only images in files on this Mac can be shown, and web images are never downloaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo mostrar “%@”. Solo se pueden mostrar imágenes de archivos de este Mac, y las imágenes web nunca se descargan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’afficher « %@ ». Seules les images dans des fichiers de ce Mac peuvent être affichées, et les images web ne sont jamais téléchargées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile mostrare “%@”. Possono essere mostrate solo le immagini presenti in file su questo Mac e le immagini web non vengono mai scaricate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を表示できませんでした。表示できるのはこのMac上のファイルの画像のみで、Web上の画像はダウンロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 표시할 수 없습니다. 이 Mac에 있는 파일의 이미지만 표시할 수 있으며, 웹 이미지는 다운로드하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível mostrar “%@”. Só é possível mostrar imagens de arquivos neste Mac, e imagens da web nunca são baixadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось показать «%@». Можно показывать только изображения из файлов на этом Mac, а изображения из интернета никогда не загружаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gösterilemedi. Yalnızca bu Mac’teki dosyalarda bulunan görüntüler gösterilebilir ve web görüntüleri asla indirilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法显示“%@”。只能显示此 Mac 上文件中的图像，并且绝不会下载网络图像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法顯示「%@」。只能顯示此 Mac 上檔案中的圖片，且絕不會下載網頁圖片。"
          }
        }
      }
    },
