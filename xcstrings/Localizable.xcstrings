    "AdvancedSetting.advancedPasteWaitsForPromptByDefault" : {
      "comment" : "Advanced setting: advancedPasteWaitsForPromptByDefault",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll Erweitertes Einfügen standardmäßig automatisch „Vor dem Einfügen jeder Zeile auf Shell-Prompt warten“ aktivieren, wenn Shell-Integration erkannt wird?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should Advanced Paste automatically enable “Wait for shell prompt before pasting each line” by default when shell integration is detected?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe el pegado avanzado activar automáticamente “Esperar el prompt del shell antes de pegar cada línea” de forma predeterminada cuando se detecta la integración con el shell?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage avancé doit-il activer automatiquement « Attendre l’invite du shell avant de coller chaque ligne » par défaut lorsque l’intégration du shell est détectée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’incolla avanzato deve abilitare automaticamente “Attendi il prompt della shell prima di incollare ogni riga” per impostazione predefinita quando viene rilevata l’integrazione shell?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合が検出された場合、高度な貼り付けはデフォルトで「各行を貼り付ける前にシェルプロンプトを待つ」を自動的に有効にしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 감지되면 고급 붙여넣기에서 기본적으로 “각 줄을 붙여넣기 전에 셸 프롬프트 기다리기”를 자동으로 켜겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Colagem avançada deve ativar automaticamente “Aguardar o prompt do shell antes de colar cada linha” por padrão quando a Shell Integration é detectada?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли функция «Расширенная вставка» по умолчанию автоматически включать параметр «Ждать приглашения оболочки перед вставкой каждой строки», если обнаружена интеграция с оболочкой?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk entegrasyonu algılandığında Gelişmiş Yapıştırma, “Her satırı yapıştırmadan önce kabuk istemini bekle” seçeneğini varsayılan olarak otomatik etkinleştirsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当检测到 shell 集成时，Advanced Paste 是否应默认自动启用“在粘贴每条行前等待 shell 提示符”功能？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到 Shell 整合時，進階貼上是否應預設自動啟用「貼上每一行前等待 Shell 提示符號」？"
          }
        }
      }
    },
    "AdvancedSetting.aggressiveBaseCharacterDetection" : {
      "comment" : "Advanced setting: aggressiveBaseCharacterDetection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basis-Unicode-Zeichen mit Nachschlagetabelle erkennen.\nApples Algorithmus zur Segmentierung zusammengesetzter Zeichen trifft schlechte Entscheidungen, etwa bei Tamil. Aktivieren Sie dies, um Textüberlappungen zu verringern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Detect base unicode characters with lookup table.\nApple's algorithm for segmenting composed characters makes bad choices, such as for Tamil. Enable this to reduce text overlapping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar caracteres Unicode base con una tabla de consulta.\nEl algoritmo de Apple para segmentar caracteres compuestos toma malas decisiones, por ejemplo con el tamil. Actívalo para reducir la superposición de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecter les caractères Unicode de base avec une table de correspondance.\nL’algorithme d’Apple pour segmenter les caractères composés fait de mauvais choix, par exemple pour le tamoul. Activez cette option pour réduire le chevauchement du texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rileva i caratteri Unicode di base con una tabella di ricerca.\nL’algoritmo di Apple per segmentare i caratteri composti fa scelte sbagliate, ad esempio per il tamil. Abilitalo per ridurre la sovrapposizione del testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルックアップテーブルを使用してUnicodeの基底文字を検出する。\n合成文字を分割するAppleのアルゴリズムは、タミル語などで不適切な判断をすることがあります。これを有効にすると、テキストの重なりを軽減できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조회 테이블로 기본 유니코드 문자를 감지합니다.\n조합 문자를 분할하는 Apple의 알고리즘은 타밀어 등에서 잘못된 선택을 합니다. 텍스트 겹침을 줄이려면 이 옵션을 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar caracteres unicode base com tabela de consulta.\nO algoritmo da Apple para segmentar caracteres compostos faz escolhas ruins, como no tâmil. Ative isto para reduzir a sobreposição de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определять базовые символы Юникода с помощью таблицы соответствий.\nАлгоритм Apple для сегментации составных символов делает неудачный выбор, например для тамильского языка. Включите этот параметр, чтобы уменьшить наложение текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel Unicode karakterlerini arama tablosuyla algıla.\nApple’ın birleşik karakterleri bölümleme algoritması, örneğin Tamilce için kötü seçimler yapar. Metin çakışmasını azaltmak için bunu etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过查找表检测基础 Unicode 字符。\nApple 的复合字符分割算法存在错误，例如泰米尔语中的处理方式。启用此功能可减少文本重叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以查詢表偵測基本 Unicode 字元。\nApple 的組合字元分割演算法會做出錯誤的選擇，例如泰米爾文。啟用此項可減少文字重疊。"
          }
        }
      }
    },
    "AdvancedSetting.aggressiveFocusFollowsMouse" : {
      "comment" : "Advanced setting: aggressiveFocusFollowsMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll bei aktiviertem „Fokus folgt der Maus“ das Fenster unter dem Zeiger aktiviert werden, wenn iTerm2 aktiv wird?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Focus Follows Mouse is enabled, activate the window under the cursor when iTerm2 becomes active?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando “El foco sigue al ratón” está activado, ¿activar la ventana que hay bajo el cursor cuando iTerm2 pasa a estar activo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Le focus suit la souris » est activé, activer la fenêtre sous le curseur quand iTerm2 devient actif ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Il focus segue il mouse” è abilitato, attivare la finestra sotto il cursore quando iTerm2 diventa attivo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウス追従フォーカスが有効な場合、iTerm2がアクティブになった際にカーソル下のウィンドウをアクティブにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포커스가 마우스를 따라가기가 켜져 있을 때 iTerm2가 활성화되면 커서 아래의 윈도우를 활성화하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Foco segue o mouse” está ativado, ativar a janela sob o cursor quando o iTerm2 se tornar ativo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активировать окно под курсором при активации iTerm2, если включён режим «Фокус следует за мышью»?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Odak fareyi izlesin” etkinken, iTerm2 etkin olduğunda imlecin altındaki pencere etkinleştirilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Focus Follows Mouse 被启用时，iTerm2 激活后是否应激活光标下的窗口？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「焦點跟隨滑鼠」時，iTerm2 變為使用中後，是否啟用游標下方的視窗？"
          }
        }
      }
    },
    "AdvancedSetting.aiChatRawWireLogging" : {
      "comment" : "Advanced setting: aiChatRawWireLogging",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rohe KI-API-Anfragen und -Antworten auf der Festplatte protokollieren.\nSchreibt jedes an den KI-Anbieter gesendete und von ihm empfangene Byte (vollständige Anfrage-Header, Body, Streaming-Chunks, endgültige Antwort, Fehler und Zeitangaben) nach ~/Library/Application Support/iTerm2/AIChatWire/. Eine Protokolldatei pro App-Start; rotieren oder löschen Sie sie selbst, wenn Sie fertig sind. WARNUNG: Das Protokoll erfasst Authorization-/API-Schlüssel-Header sowie den vollständigen Prompt- und Antwortinhalt im Klartext. Standardmäßig aus; nur zum Reproduzieren eines Problems aktivieren und die Dateien danach löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log raw AI API requests and responses to disk.\nWrites every byte sent to and received from the AI vendor (full request headers, body, streaming chunks, final response, errors, and timing) to ~/Library/Application Support/iTerm2/AIChatWire/. One log file per app launch; rotate or delete it yourself when done. WARNING: the log captures Authorization / API-key headers and full prompt + response content verbatim. Off by default; turn on only while reproducing an issue and delete the files when finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar en disco las solicitudes y respuestas sin procesar de la API de IA.\nEscribe cada byte enviado al proveedor de IA y recibido de él (encabezados completos de la solicitud, cuerpo, bloques de streaming, respuesta final, errores y tiempos) en ~/Library/Application Support/iTerm2/AIChatWire/. Un archivo de registro por inicio de la app; rótalo o elimínalo tú mismo cuando termines. AVISO: el registro captura los encabezados Authorization / de clave de API y el contenido completo del prompt y de la respuesta, literalmente. Desactivado de forma predeterminada; actívalo solo mientras reproduces un problema y elimina los archivos al terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journaliser sur le disque les requêtes et réponses brutes de l’API d’IA.\nÉcrit chaque octet envoyé au fournisseur d’IA et reçu de lui (en-têtes complets de la requête, corps, blocs de streaming, réponse finale, erreurs et durées) dans ~/Library/Application Support/iTerm2/AIChatWire/. Un fichier journal par lancement de l’app ; effectuez vous-même la rotation ou la suppression une fois terminé. AVERTISSEMENT : le journal capture les en-têtes Authorization / clé d’API et l’intégralité du contenu du prompt et de la réponse, tels quels. Désactivé par défaut ; activez-le uniquement pendant la reproduction d’un problème et supprimez les fichiers ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra su disco le richieste e le risposte grezze dell’API IA.\nScrive ogni byte inviato e ricevuto dal fornitore IA (intestazioni complete della richiesta, corpo, blocchi di streaming, risposta finale, errori e tempistiche) in ~/Library/Application Support/iTerm2/AIChatWire/. Un file di log per ogni avvio dell’app; ruotalo o eliminalo tu stesso al termine. ATTENZIONE: il log cattura le intestazioni Authorization / chiave API e il contenuto completo di prompt e risposta, alla lettera. Disattivato per impostazione predefinita; attivalo solo mentre riproduci un problema ed elimina i file al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生のAI APIリクエストとレスポンスをディスクに記録する。\nAIベンダーとの間で送受信されるすべてのバイト（完全なリクエストヘッダー、ボディ、ストリーミングチャンク、最終レスポンス、エラー、タイミング）を~/Library/Application Support/iTerm2/AIChatWire/に書き込みます。アプリの起動ごとに1つのログファイルが作成されます。ログのローテーションや削除は自分で行ってください。警告: このログには、Authorization / APIキーのヘッダーおよびプロンプトとレスポンスの内容全体がそのまま記録されます。デフォルトでは無効です。問題を再現する際にのみ有効にし、終わったらファイルを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI API 원시 요청 및 응답을 디스크에 기록\nAI 제공업체와 주고받는 모든 바이트(전체 요청 헤더, 본문, 스트리밍 청크, 최종 응답, 오류 및 타이밍)를 ~/Library/Application Support/iTerm2/AIChatWire/에 기록합니다. 앱을 실행할 때마다 로그 파일이 하나씩 생성되며, 다 쓴 후에는 직접 정리하거나 삭제해야 합니다. 경고: 로그에는 Authorization / API 키 헤더와 프롬프트 및 응답 전체 내용이 그대로 기록됩니다. 기본적으로 꺼져 있습니다. 문제를 재현하는 동안에만 켜고 끝나면 파일을 삭제하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar em disco as requisições e respostas brutas da API de IA.\nGrava cada byte enviado e recebido do fornecedor de IA (cabeçalhos completos da requisição, corpo, blocos de streaming, resposta final, erros e tempos) em ~/Library/Application Support/iTerm2/AIChatWire/. Um arquivo de log por inicialização do app; alterne ou apague-o você mesmo quando terminar. AVISO: o log captura cabeçalhos de Authorization / chave de API e o conteúdo completo do prompt e da resposta na íntegra. Desativado por padrão; ative apenas ao reproduzir um problema e apague os arquivos ao terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывать на диск необработанные запросы и ответы AI API.\nЗаписывает каждый байт, отправленный поставщику ИИ и полученный от него (полные заголовки запроса, тело, потоковые фрагменты, окончательный ответ, ошибки и тайминг), в ~/Library/Application Support/iTerm2/AIChatWire/. Один файл журнала на каждый запуск приложения; удаляйте или ротируйте его самостоятельно после использования. ПРЕДУПРЕЖДЕНИЕ: журнал записывает заголовки Authorization и API-ключа, а также полный текст запроса и ответа дословно. По умолчанию отключено; включайте только для воспроизведения проблемы и удаляйте файлы после завершения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ham YZ API isteklerini ve yanıtlarını diske günlükle.\nYZ sağlayıcısına gönderilen ve ondan alınan her baytı (tam istek üst bilgileri, gövde, akış parçaları, nihai yanıt, hatalar ve zamanlama) ~/Library/Application Support/iTerm2/AIChatWire/ konumuna yazar. Her uygulama başlatmasında bir günlük dosyası oluşur; işiniz bitince kendiniz döndürün veya silin. UYARI: Günlük, Authorization / API anahtarı üst bilgilerini ve istemin ile yanıtın tüm içeriğini olduğu gibi yakalar. Varsayılan olarak kapalıdır; yalnızca bir sorunu yeniden üretirken açın ve işiniz bitince dosyaları silin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应将原始 AI API 请求和响应记录到磁盘中？\n将发送给 AI 供应商的每一字节数据（完整的请求头、内容、流分块、最终响应、错误和计时信息）写入 ~/Library/Application Support/iTerm2/AIChatWire/。每个应用启动对应一个日志文件；使用完毕后可自行轮换或删除。注意：该日志会完整记录授权/API 密钥头以及完整的提示语和响应内容。默认关闭；仅在重现问题时开启，完成后删除文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將原始 AI API 請求和回應記錄到磁碟。\n將傳送給 AI 供應商及從其接收的每個位元組（完整的請求標頭、內文、串流區塊、最終回應、錯誤和時間資訊）寫入 ~/Library/Application Support/iTerm2/AIChatWire/。每次 App 啟動產生一個記錄檔；用完後請自行輪替或刪除。警告：記錄會逐字擷取 Authorization / API 金鑰標頭，以及完整的提示詞和回應內容。預設關閉；僅在重現問題時開啟，完成後請刪除這些檔案。"
          }
        }
      }
    },
    "AdvancedSetting.aiChatVerboseConsoleLogging" : {
      "comment" : "Advanced setting: aiChatVerboseConsoleLogging",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Chat-Datenverkehr in die Systemkonsole protokollieren.\nGibt pro Runde Einträge für Benutzer/Agent/Werkzeug über NSLog aus, damit Sie genau nachvollziehen können, was der Agent erhalten und erzeugt hat. Nützlich zum Debuggen der Werkzeugverteilung und der Verlaufsübersetzung. Standardmäßig aus; nur zum Reproduzieren eines Problems aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log AI chat traffic to the system console.\nEmits per-turn user / agent / tool entries via NSLog so you can trace exactly what the agent received and produced. Useful for debugging tool dispatch and history translation. Off by default; turn on only while reproducing an issue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar el tráfico del chat de IA en la consola del sistema.\nEmite entradas de usuario / agente / herramienta por turno mediante NSLog para que puedas rastrear exactamente lo que el agente recibió y produjo. Útil para depurar el despacho de herramientas y la traducción del historial. Desactivado de forma predeterminada; actívalo solo mientras reproduces un problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journaliser le trafic du chat IA dans la console système.\nÉmet via NSLog des entrées par tour pour l’utilisateur, l’agent et les outils, afin de retracer exactement ce que l’agent a reçu et produit. Utile pour déboguer la répartition des outils et la traduction de l’historique. Désactivé par défaut ; activez-le uniquement pendant la reproduction d’un problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra il traffico della chat IA nella console di sistema.\nEmette voci utente / agente / strumento per ogni turno tramite NSLog, così puoi tracciare esattamente ciò che l’agente ha ricevuto e prodotto. Utile per il debug dell’invio degli strumenti e della traduzione della cronologia. Disattivato per impostazione predefinita; attivalo solo mentre riproduci un problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIチャットの通信をシステムコンソールに記録する。\nNSLogを使って、ユーザー / エージェント / ツールのやり取りをターンごとに出力し、エージェントが受け取った内容と生成した内容を正確に追跡できるようにします。ツールのディスパッチや履歴変換のデバッグに役立ちます。デフォルトでは無効です。問題を再現する際にのみ有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 채팅 트래픽을 시스템 콘솔에 기록.\n턴마다 사용자/에이전트/도구 항목을 NSLog로 출력하므로 에이전트가 받고 생성한 내용을 정확히 추적할 수 있습니다. 도구 디스패치 및 기록 변환을 디버깅할 때 유용합니다. 기본적으로 꺼져 있으며, 문제를 재현하는 동안에만 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar o tráfego do chat de IA no console do sistema.\nEmite entradas por turno de usuário / agente / ferramenta via NSLog para que você possa rastrear exatamente o que o agente recebeu e produziu. Útil para depurar o despacho de ferramentas e a tradução do histórico. Desativado por padrão; ative apenas ao reproduzir um problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывать трафик чата ИИ в системную консоль.\nВыводит записи пользователя, агента и инструментов для каждого хода с помощью NSLog, чтобы можно было точно отследить, что получил и произвёл агент. Полезно для отладки диспетчеризации инструментов и преобразования истории. По умолчанию отключено; включайте только для воспроизведения проблемы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ sohbet trafiğini sistem konsoluna günlükle.\nAjanın tam olarak ne aldığını ve ne ürettiğini izleyebilmeniz için her tur için kullanıcı / ajan / araç girdilerini NSLog ile yayar. Araç dağıtımında ve geçmiş çevirisinde hata ayıklamak için yararlıdır. Varsayılan olarak kapalıdır; yalnızca bir sorunu yeniden üretirken açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应将 AI 聊天流量记录到系统控制台？\n通过 NSLog 输出每轮用户/代理/工具的条目，以便准确追踪代理接收和生成的内容。有助于调试工具调度和历史翻译问题。默认关闭；仅在重现问题时开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 AI 聊天流量記錄到系統主控台。\n透過 NSLog 輸出每個回合的使用者 / 代理程式 / 工具項目，以便準確追蹤代理程式收到和產生的內容。適用於除錯工具調度和歷史記錄轉換。預設關閉；僅在重現問題時開啟。"
          }
        }
      }
    },
    "AdvancedSetting.aiGeneratedTabTitles" : {
      "comment" : "Advanced setting: aiGeneratedTabTitles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs nach der auf dem Bildschirm sichtbaren Arbeit benennen, mithilfe von KI auf dem Gerät?\nWenn aktiviert, enthält die Sitzungsvariable „aiTitle“ einen kurzen Namen für die in der Sitzung sichtbare Aufgabe, den Sie anzeigen können, indem Sie die Titelkomponente „KI-generierter Name“ hinzufügen oder \\(session.aiTitle) in einem benutzerdefinierten Titelformat verwenden. Erfordert Apple Intelligence; die Bildschirminhalte verlassen diesen Mac nie, und es wird kein API-Schlüssel verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Name tabs after the work on screen, using on-device AI?\nWhen enabled, the session variable “aiTitle” holds a short name for the task visible in the session, which you can show by adding the “AI-generated name” title component or using \\(session.aiTitle) in a custom title format. Requires Apple Intelligence; the screen contents never leave this Mac, and no API key is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Nombrar las pestañas según el trabajo que se ve en pantalla, usando IA en el dispositivo?\nSi se activa, la variable de sesión “aiTitle” contiene un nombre corto para la tarea visible en la sesión, que puedes mostrar añadiendo el componente de título “Nombre generado por IA” o usando \\(session.aiTitle) en un formato de título personalizado. Requiere Apple Intelligence; el contenido de la pantalla nunca sale de este Mac y no se usa ninguna clave de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommer les onglets d’après le travail affiché à l’écran, avec l’IA sur l’appareil ?\nSi cette option est activée, la variable de session « aiTitle » contient un nom court pour la tâche visible dans la session, que vous pouvez afficher en ajoutant le composant de titre « Nom généré par l’IA » ou en utilisant \\(session.aiTitle) dans un format de titre personnalisé. Nécessite Apple Intelligence ; le contenu de l’écran ne quitte jamais ce Mac et aucune clé d’API n’est utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dare ai pannelli un nome basato sul lavoro a schermo, usando l’IA sul dispositivo?\nSe abilitato, la variabile di sessione “aiTitle” contiene un nome breve per l’attività visibile nella sessione, che puoi mostrare aggiungendo il componente del titolo “Nome generato dall’IA” oppure usando \\(session.aiTitle) in un formato del titolo personalizzato. Richiede Apple Intelligence; il contenuto dello schermo non lascia mai questo Mac e non viene usata alcuna chiave API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンデバイスAIを使って、画面上の作業内容に基づいてタブに名前を付けますか？\n有効にすると、セッション変数「aiTitle」にセッション内で表示されている作業内容の短い名前が保持され、「AI生成名」というタイトルコンポーネントを追加するか、カスタムタイトル形式で\\(session.aiTitle)を使うことで表示できます。Apple Intelligenceが必要です。画面の内容はこのMacの外に送信されることはなく、APIキーも使用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 내 AI를 사용하여 화면의 작업에 맞게 탭 이름을 지정하겠습니까?\n활성화하면 세션 변수 “aiTitle”에 세션에 보이는 작업의 짧은 이름이 저장되며, “AI 생성 이름” 제목 구성 요소를 추가하거나 사용자 지정 제목 형식에 \\(session.aiTitle)을 사용하여 표시할 수 있습니다. Apple Intelligence가 필요합니다. 화면 내용은 이 Mac 밖으로 나가지 않으며 API 키도 사용하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomear as abas de acordo com o trabalho na tela, usando IA no dispositivo?\nQuando ativado, a variável de sessão “aiTitle” contém um nome curto para a tarefa visível na sessão, que você pode exibir adicionando o componente de título “Nome gerado por IA” ou usando \\(session.aiTitle) em um formato de título personalizado. Requer o Apple Intelligence; o conteúdo da tela nunca sai deste Mac e nenhuma chave de API é usada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Называть вкладки по содержимому экрана с помощью ИИ на устройстве?\nПри включении переменная сессии «aiTitle» содержит краткое название задачи, видимой в сессии; его можно отобразить, добавив компонент заголовка «Имя, сгенерированное ИИ», или используя \\(session.aiTitle) в пользовательском формате заголовка. Требует Apple Intelligence; содержимое экрана никогда не покидает этот Mac, и API-ключ не используется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmelere, cihazdaki YZ kullanılarak ekrandaki işe göre ad verilsin mi?\nEtkinleştirildiğinde “aiTitle” oturum değişkeni, oturumda görünen görev için kısa bir ad tutar; bunu “YZ tarafından oluşturulan ad” başlık bileşenini ekleyerek veya özel başlık biçiminde \\(session.aiTitle) kullanarak gösterebilirsiniz. Apple Intelligence gerektirir; ekran içeriği bu Mac’ten asla çıkmaz ve hiçbir API anahtarı kullanılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应使用设备上的 AI 为标签页命名？\n如果启用，会话变量“aiTitle”将保存任务简短名称，可在自定义标题格式中通过添加“AI生成的名称”标题组件或使用 \\(session.aiTitle) 来显示。需要 Apple Intelligence；屏幕内容不会离开此 Mac，且不使用 API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用裝置上的 AI 依螢幕上的工作為標籤頁命名？\n啟用後，工作階段變數「aiTitle」會保存工作階段中可見工作的簡短名稱，你可以加入「AI 產生的名稱」標題元件，或在自訂標題格式中使用 \\(session.aiTitle) 來顯示。需要 Apple Intelligence；螢幕內容不會離開這部 Mac，也不使用 API 金鑰。"
          }
        }
      }
    },
    "AdvancedSetting.aiModelCatalogURL" : {
      "comment" : "Advanced setting: aiModelCatalogURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL zum Prüfen auf Aktualisierungen des KI-Modellkatalogs.\nDer Katalog definiert die integrierten KI-Modelle (Kontextfenster, Fähigkeiten und das empfohlene Modell pro Anbieter). iTerm2 lädt regelmäßig eine signierte neuere Kopie herunter, damit neue Modelle ohne App-Update verfügbar werden. Dies geschieht nur, wenn KI-Funktionen aktiviert sind und Sie die Erlaubnis erteilt haben; eine nicht leere URL allein aktiviert die Prüfung nicht. Wird diese URL geleert, wird die Prüfung vollständig deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL to check for updates to the AI model catalog.\nThe catalog defines the built-in AI models (context window, capabilities, and the recommended model per vendor). iTerm2 periodically downloads a signed newer copy so new models become available without an app update. This happens only when AI features are enabled and you have granted permission; a non-empty URL by itself does not enable checking. Clearing this URL disables checking entirely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL en la que buscar actualizaciones del catálogo de modelos de IA.\nEl catálogo define los modelos de IA integrados (ventana de contexto, capacidades y el modelo recomendado de cada proveedor). iTerm2 descarga periódicamente una copia firmada más reciente para que los nuevos modelos estén disponibles sin actualizar la app. Esto solo ocurre cuando las funciones de IA están activadas y has concedido permiso; una URL no vacía por sí sola no activa la comprobación. Borrar esta URL desactiva la comprobación por completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL à interroger pour les mises à jour du catalogue de modèles d’IA.\nLe catalogue définit les modèles d’IA intégrés (fenêtre de contexte, capacités et modèle recommandé par fournisseur). iTerm2 télécharge périodiquement une copie signée plus récente afin que de nouveaux modèles soient disponibles sans mise à jour de l’app. Cela n’a lieu que lorsque les fonctionnalités d’IA sont activées et que vous avez accordé l’autorisation ; une URL non vide ne suffit pas à activer la vérification. Effacer cette URL désactive complètement la vérification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL da cui cercare aggiornamenti del catalogo dei modelli IA.\nIl catalogo definisce i modelli IA integrati (finestra di contesto, funzionalità e modello consigliato per ogni fornitore). iTerm2 scarica periodicamente una copia firmata più recente così i nuovi modelli diventano disponibili senza aggiornare l’app. Questo avviene solo quando le funzioni IA sono abilitate e hai concesso l’autorizzazione; un URL non vuoto da solo non abilita il controllo. Cancellare questo URL disabilita completamente il controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIモデルカタログの更新を確認するためのURL。\nこのカタログは組み込みのAIモデル（コンテキストウィンドウ、機能、ベンダーごとの推奨モデル）を定義します。iTerm2は署名済みの新しいコピーを定期的にダウンロードするため、アプリを更新しなくても新しいモデルを利用できるようになります。これはAI機能が有効で、かつあなたが許可を与えている場合にのみ行われます。URLを空でない値にしただけでは確認は有効になりません。このURLを空にすると、確認は完全に無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 모델 카탈로그 업데이트를 확인할 URL.\n카탈로그는 내장 AI 모델(컨텍스트 윈도우, 기능, 공급업체별 권장 모델)을 정의합니다. iTerm2는 주기적으로 서명된 최신 사본을 다운로드하므로 앱을 업데이트하지 않아도 새 모델을 사용할 수 있습니다. 이 작업은 AI 기능이 켜져 있고 사용자가 권한을 부여한 경우에만 수행되며, URL이 비어 있지 않다는 것만으로는 확인이 켜지지 않습니다. 이 URL을 지우면 확인이 완전히 꺼집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL para verificar atualizações do catálogo de modelos de IA.\nO catálogo define os modelos de IA integrados (janela de contexto, recursos e o modelo recomendado por fornecedor). O iTerm2 baixa periodicamente uma cópia mais recente assinada para que novos modelos fiquem disponíveis sem uma atualização do app. Isso acontece apenas quando os recursos de IA estão ativados e você concedeu permissão; uma URL não vazia por si só não ativa a verificação. Limpar esta URL desativa a verificação por completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL для проверки обновлений каталога моделей ИИ.\nКаталог определяет встроенные модели ИИ (размер контекстного окна, возможности и рекомендуемую модель для каждого поставщика). iTerm2 периодически загружает более новую подписанную копию, чтобы новые модели становились доступны без обновления приложения. Это происходит только при включённых функциях ИИ и наличии вашего разрешения; сам по себе непустой URL не включает проверку. Очистка этого URL полностью отключает проверку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ model kataloğu güncellemelerini denetlemek için URL.\nKatalog, yerleşik YZ modellerini (bağlam penceresi, yetenekler ve her sağlayıcı için önerilen model) tanımlar. iTerm2, yeni modellerin uygulama güncellemesi olmadan kullanılabilmesi için düzenli olarak daha yeni imzalı bir kopya indirir. Bu yalnızca YZ özellikleri etkinse ve izin verdiyseniz gerçekleşir; boş olmayan bir URL tek başına denetlemeyi etkinleştirmez. Bu URL’yi temizlemek denetlemeyi tamamen devre dışı bırakır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于检查 AI 模型目录更新的 URL。\n该目录定义了内置 AI 模型（上下文窗口、能力以及各供应商推荐的模型）。iTerm2 会定期下载签名的新版本，因此无需应用更新即可获得新模型。仅当启用了 AI 功能且已授予权限时才会发生此情况；单独的非空 URL 无法启用检查。清除该 URL 将完全禁用检查功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於檢查 AI 模型目錄更新的 URL。\n目錄定義了內建的 AI 模型（上下文視窗、功能，以及各供應商的建議模型）。iTerm2 會定期下載已簽署的較新副本，因此不需更新 App 就能使用新模型。只有在啟用 AI 功能且你已授予權限時才會進行；單獨一個非空的 URL 並不會啟用檢查。清除此 URL 會完全停用檢查。"
          }
        }
      }
    },
    "AdvancedSetting.aiModernModelPrefixes" : {
      "comment" : "Advanced setting: aiModernModelPrefixes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilzeichenfolgen von KI-Modellnamen, die die moderne „completions“-API verwenden.\nTeilzeichenfolgen sollten durch Leerzeichen getrennt werden. Dies deckt Namen im OpenRouter-Stil wie „openai/gpt-4o“ ab. Beachten Sie, dass o1-Modelle eine andere API verwenden und fest codiertes Verhalten haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI model name substrings that use the modern 'completions' API.\nSubstrings should be space-delimited. This handles OpenRouter-style names like 'openai/gpt-4o'. Note that o1 models use a different API and have hard-coded behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subcadenas de nombres de modelos de IA que usan la API “completions” moderna.\nLas subcadenas deben separarse con espacios. Esto gestiona nombres al estilo de OpenRouter como “openai/gpt-4o”. Ten en cuenta que los modelos o1 usan una API diferente y tienen un comportamiento fijo en el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous-chaînes de noms de modèles d’IA qui utilisent l’API « completions » moderne.\nLes sous-chaînes doivent être séparées par des espaces. Cela gère les noms de type OpenRouter comme « openai/gpt-4o ». Notez que les modèles o1 utilisent une API différente et ont un comportement codé en dur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sottostringhe dei nomi di modelli IA che usano la moderna API “completions”.\nLe sottostringhe devono essere separate da spazi. Gestisce nomi in stile OpenRouter come “openai/gpt-4o”. Nota che i modelli o1 usano un’API diversa e hanno un comportamento fisso nel codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい「completions」APIを使用するAIモデル名の部分文字列。\n部分文字列はスペースで区切ってください。これは「openai/gpt-4o」のようなOpenRouter形式の名前に対応します。なお、o1モデルは異なるAPIを使用し、動作がハードコードされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 'completions' API를 사용하는 AI 모델 이름 부분 문자열.\n부분 문자열은 공백으로 구분해야 합니다. 'openai/gpt-4o' 같은 OpenRouter 스타일 이름을 처리합니다. o1 모델은 다른 API를 사용하며 동작이 하드코딩되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substrings de nome de modelo de IA que usam a API “completions” moderna.\nAs substrings devem ser separadas por espaços. Isso lida com nomes no estilo do OpenRouter como “openai/gpt-4o”. Observe que os modelos o1 usam uma API diferente e têm comportamento fixo no código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подстроки имён моделей ИИ, использующих современный API «completions».\nПодстроки должны разделяться пробелами. Это обрабатывает имена в стиле OpenRouter, например «openai/gpt-4o». Обратите внимание, что модели o1 используют другой API и имеют жёстко заданное поведение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern “completions” API’sini kullanan YZ model adı alt dizeleri.\nAlt dizeler boşlukla ayrılmalıdır. Bu, “openai/gpt-4o” gibi OpenRouter tarzı adları işler. o1 modellerinin farklı bir API kullandığını ve davranışlarının koda sabitlendiğini unutmayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用现代 'completions' API 的 AI 模型名称子字符串。\n这些子字符串应以空格分隔。这适用于类似 'openai/gpt-4o' 的 OpenRouter 风格名称。注意，o1 模型使用不同的 API 并具有固定行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用現代「completions」API 的 AI 模型名稱子字串。\n子字串應以空格分隔。這可處理像「openai/gpt-4o」這類 OpenRouter 風格的名稱。注意，o1 模型使用不同的 API，且行為是寫死的。"
          }
        }
      }
    },
    "AdvancedSetting.aiProxy" : {
      "comment" : "Advanced setting: aiProxy",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host und Port für den Proxy für KI-Anfragen.\nz. B. example.com:8080"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Host and port for proxy for AI requests.\ni.e., example.com:8080"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host y puerto del proxy para las solicitudes de IA.\np. ej., example.com:8080"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
