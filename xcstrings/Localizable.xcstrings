    "AdvancedSetting.toolbeltFontSize" : {
      "comment" : "Advanced setting: toolbeltFontSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schriftgröße des Toolbelt in Punkten.\nAuf 0 setzen, um die Systemvorgabe zu verwenden. Das Ändern dieser Einstellung wirkt sich nicht auf bestehende Fenster aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbelt font size in points.\nSet to 0 to use the system default. Changing this setting does not affect existing windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño de letra de la caja de herramientas en puntos.\nEstablécelo en 0 para usar el predeterminado del sistema. Cambiar este ajuste no afecta a las ventanas existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille de la police de la boîte à outils en points.\nDéfinissez 0 pour utiliser la valeur par défaut du système. La modification de ce réglage n’affecte pas les fenêtres existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensione del font della cassetta attrezzi in punti.\nImposta 0 per usare quella predefinita del sistema. La modifica di questa impostazione non influisce sulle finestre esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールベルトのフォントサイズ（ポイント単位）。\nシステムのデフォルトを使用するには0に設定してください。この設定を変更しても、既存のウィンドウには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 벨트 서체 크기(포인트).\n시스템 기본값을 사용하려면 0으로 설정하십시오. 이 설정을 변경해도 기존 윈도우에는 영향을 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho da fonte da Caixa de ferramentas em pontos.\nDefina como 0 para usar o padrão do sistema. Alterar este ajuste não afeta janelas existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер шрифта панели инструментов в пунктах.\nУстановите 0, чтобы использовать системное значение по умолчанию. Изменение этого параметра не влияет на уже открытые окна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç Kemeri font boyutu (punto).\nSistem varsayılanını kullanmak için 0 yapın. Bu ayarı değiştirmek mevcut pencereleri etkilemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbelt字体大小（点）。  \n设置为0则使用系统默认。更改此设置不会影响现有窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具帶字體大小，以點為單位。\n設為 0 則使用系統預設值。變更此設定不會影響現有的視窗。"
          }
        }
      }
    },
    "AdvancedSetting.trackingRunloopForLiveResize" : {
      "comment" : "Advanced setting: trackingRunloopForLiveResize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracking-Runloop für die Größenänderung in Echtzeit verwenden.\nDies ermöglicht dem Terminal, sich während eines Größenänderungsvorgangs neu zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use a tracking runloop for live resizing.\nThis allows the terminal to redraw during a resizing drag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un runloop de seguimiento para el cambio de tamaño en vivo.\nPermite que la terminal se redibuje durante un arrastre de cambio de tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser une boucle d’exécution de suivi pour le redimensionnement en direct.\nCela permet au terminal de se redessiner pendant un glissement de redimensionnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un runloop di tracciamento per il ridimensionamento in tempo reale.\nPermette al terminale di ridisegnarsi durante il trascinamento per il ridimensionamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブリサイズ時にトラッキングランループを使用します。\nこれにより、リサイズのドラッグ中でもターミナルが再描画されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 크기 조절 시 추적 런 루프 사용\n크기 조절을 위해 드래그하는 동안 터미널을 다시 그릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um runloop de rastreamento para redimensionamento ao vivo.\nIsso permite que o terminal redesenhe durante um arraste de redimensionamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать tracking runloop для обновления экрана в реальном времени при изменении размера.\nЭто позволяет терминалу перерисовываться во время перетаскивания при изменении размера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı yeniden boyutlandırma için izleme çalışma döngüsü kullan.\nBu, terminalin yeniden boyutlandırma sürüklemesi sırasında yeniden çizilmesine izin verir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用跟踪运行循环进行实时调整大小。  \n这允许终端在调整大小拖拽过程中重新绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用追蹤 runloop 進行即時調整大小。\n這讓終端機可在拖移調整大小的過程中重新繪製。"
          }
        }
      }
    },
    "AdvancedSetting.traditionalVisualBell" : {
      "comment" : "Advanced setting: traditionalVisualBell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der visuelle Signalton lässt den gesamten Bildschirm aufblitzen, nicht nur ein Glockensymbol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Visual bell flashes the whole screen, not just a bell icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana visual hace destellar toda la pantalla, no solo un icono de campana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sonnerie visuelle fait clignoter tout l’écran, et pas seulement une icône de sonnerie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il campanello visivo fa lampeggiare l’intero schermo, non solo un’icona di campanello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアルベルは、ベルアイコンだけでなく画面全体を点滅させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시각적 벨로 벨 아이콘뿐 아니라 화면 전체 깜빡이기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A campainha visual pisca a tela inteira, não apenas um ícone de campainha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Визуальный сигнал мигает всем экраном, а не только значком колокольчика."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel zil yalnızca bir zil simgesini değil tüm ekranı yakıp söndürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视觉铃铛会全屏闪烁，而不仅仅是铃铛图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覺響鈴會讓整個螢幕閃爍，而不只是響鈴圖像。"
          }
        }
      }
    },
