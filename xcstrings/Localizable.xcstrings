    "Tip.0117.Body" : {
      "comment" : "Tip of the day body, id 0117",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 verfügt jetzt über eine KI-Chat-Funktion! Verwenden Sie „Fenster > KI-Chats“ oder „Bearbeiten > Ausgabe mit KI erklären“. Der Assistent kann (mit Ihrer Erlaubnis) mit Ihrem Terminal interagieren und die Befehlsausgabe erklären, indem er Anmerkungen direkt im Terminal hinzufügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 now has an AI Chat feature! Use “Window > AI Chats” or “Edit > Explain Output with AI”. The assistant can interact with your terminal (with your permission) and explain command output, adding annotations right in the terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡iTerm2 ahora tiene una función de Chat de IA! Usa “Ventana > Chats de IA” o “Edición > Explicar salida con IA”. El asistente puede interactuar con tu terminal (con tu permiso) y explicar la salida de los comandos, añadiendo anotaciones directamente en la terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 dispose désormais d’un Chat IA ! Utilisez « Fenêtre > Chats IA » ou « Édition > Expliquer la sortie avec l’IA ». L’assistant peut interagir avec votre terminal (avec votre autorisation) et expliquer la sortie des commandes, en ajoutant des annotations directement dans le terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ora ha una funzione Chat IA! Usa “Finestra > Chat IA” oppure “Modifica > Spiega output con IA”. L’assistente può interagire con il tuo terminale (con la tua autorizzazione) e spiegare l’output dei comandi, aggiungendo annotazioni direttamente nel terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2にAIチャット機能が追加されました！「ウィンドウ > AIチャット」または「編集 > AIで出力を説明」を使ってみましょう。アシスタントは（許可があれば）ターミナルと対話し、コマンドの出力を説明したり、ターミナル内に直接注釈を追加したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 iTerm2에 AI 채팅 기능이 있습니다! “윈도우 > AI 채팅” 또는 “편집 > AI로 출력 설명”을 사용하십시오. 어시스턴트는 (사용자가 허락하면) 터미널과 상호 작용하고 명령 출력을 설명하며, 터미널에 바로 주석을 추가할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 agora tem um recurso de AI Chat! Use “Window > AI Chats” ou “Edit > Explain Output with AI”. O assistente pode interagir com o seu terminal (com sua permissão) e explicar a saída de comandos, adicionando anotações diretamente no terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь в iTerm2 есть функция AI Chat! Используйте «Окно > Чаты ИИ» или «Правка > Объяснить вывод с помощью ИИ». Ассистент может взаимодействовать с вашим терминалом (с вашего разрешения) и объяснять вывод команд, добавляя аннотации прямо в терминале."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’de artık YZ Sohbeti özelliği var! “Pencere > YZ Sohbetleri” veya “Düzen > Çıktıyı YZ ile Açıkla”yı kullanın. Asistan terminalinizle etkileşime girebilir (izninizle) ve komut çıktısını açıklayarak doğrudan terminale ek açıklamalar ekleyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2现在拥有AI聊天功能！使用“窗口 > AI聊天”或“编辑 > 用AI解释输出”。在您的允许下，助手可以与终端互动，并在终端中直接添加注释来解释命令输出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 現在有 AI 聊天功能了！使用「視窗 > AI 聊天」或「編輯 > 使用 AI 解釋輸出」。助理在你允許的情況下可以與終端機互動並解釋指令輸出，直接在終端機中加入註解。"
          }
        }
      }
    },
