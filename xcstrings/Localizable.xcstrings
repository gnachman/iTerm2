    "ProfileDocument.RenamedPrompt" : {
      "comment" : "Prompt asking which profile to open when a shortcut refers to a renamed profile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie das Profil öffnen, das früher %1$@ hieß und jetzt %2$@ heißt (auf das sich diese Tastenkombination bezieht), oder das Profil, das derzeit den Namen %3$@ trägt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Would you like to open the profile formerly named %1$@ that is now called %2$@ (which this shortcut refers to), or the profile that currently has the name %3$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres abrir el perfil que antes se llamaba %1$@ y ahora se llama %2$@ (al que se refiere este atajo), o el perfil que actualmente tiene el nombre %3$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous ouvrir le profil anciennement nommé %1$@ et désormais appelé %2$@ (celui auquel ce raccourci fait référence), ou le profil qui porte actuellement le nom %3$@ ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi aprire il profilo che prima si chiamava %1$@ e ora si chiama %2$@ (a cui si riferisce questa abbreviazione) oppure il profilo che attualmente ha il nome %3$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前は%1$@という名前で、現在は%2$@という名前になっているプロファイル（このショートカットが参照しているもの）を開きますか、それとも現在%3$@という名前のプロファイルを開きますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단축키가 가리키는, 이전 이름이 %1$@이고 현재 이름이 %2$@인 프로파일을 열겠습니까, 아니면 현재 이름이 %3$@인 프로파일을 열겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja abrir o perfil que antes se chamava %1$@ e agora se chama %2$@ (ao qual este atalho se refere), ou o perfil que atualmente tem o nome %3$@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть профиль, ранее называвшийся %1$@, который теперь называется %2$@ (на него ссылается этот ярлык), или профиль, который в настоящее время называется %3$@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce %1$@ adını taşıyan ve şimdi %2$@ olarak adlandırılan profili (bu kısayolun başvurduğu profil) mi yoksa şu anda %3$@ adına sahip profili mi açmak istersiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您希望打开之前名为 %1$@、现在称为 %2$@ 的配置文件（此快捷键所指向的），还是当前名为 %3$@ 的配置文件？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要打開先前名為 %1$@、現在稱為 %2$@ 的描述檔（此快速鍵所指向的），還是目前名為 %3$@ 的描述檔？"
          }
        }
      }
    },
