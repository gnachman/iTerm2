        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A galeria de cores on-line oferece mais de cem belos esquemas de cores que você pode transferir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В онлайн-галерее цветов представлено более ста прекрасных цветовых схем, которые можно загрузить."
          }
        },
        "zh-Hans" : {
