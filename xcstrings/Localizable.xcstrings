        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones son instrucciones guardadas para iTerm2. Por ejemplo, podrías crear una acción que abra una ventana nueva y luego cree un panel dividido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toiminnot ovat tallennettuja ohjeita iTerm2:lle. Voit esimerkiksi luoda toiminnon, joka avaa uuden ikkunan ja luo sitten jaetun paneelin."
