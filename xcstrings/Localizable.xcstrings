    "Tip.0062.Body" : {
      "comment" : "Tip of the day body, id 0062",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý seznam profilů má vyhledávací pole (např. v „Nastavení > Profily“). K upřesnění hledaného dotazu můžete použít různé operátory. Všechny podrobnosti zjistíte kliknutím na „Další informace“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver profilliste har et søgefelt (f.eks. i “Indstillinger > Profiler”). Du kan bruge forskellige operatorer til at afgrænse din søgeforespørgsel. Klik på “Læs mere” for alle detaljer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Profilliste verfügt über ein Suchfeld (zum Beispiel unter „Einstellungen > Profile“). Sie können verschiedene Operatoren verwenden, um Ihre Suchanfrage einzugrenzen. Klicken Sie auf „Mehr erfahren“, um alle Details zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every list of profiles has a search field (e.g., in ”Settings > Profiles.”) You can use various operators to restrict your search query. Click “Learn More” for all the details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lista de perfiles tiene un campo de búsqueda (por ejemplo, en “Ajustes > Perfiles”). Puedes usar varios operadores para restringir tu consulta de búsqueda. Haz clic en “Más información” para ver todos los detalles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisessa profiililuettelossa on hakukenttä (esim. kohdassa ”Asetukset > Profiilit”). Voit rajata hakulauseketta eri operaattoreilla. Saat kaikki tiedot klikkaamalla ”Lisätietoja”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque liste de profils comporte un champ de recherche (par exemple, dans « Réglages > Profils »). Vous pouvez utiliser divers opérateurs pour affiner votre requête. Cliquez sur « En savoir plus » pour tous les détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elenco di profili ha un campo di ricerca (ad esempio in “Impostazioni > Profili”). Puoi usare vari operatori per restringere la ricerca. Fai clic su “Ulteriori informazioni” per tutti i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの一覧には必ず検索フィールドがあります(たとえば「設定 > プロファイル」)。さまざまな演算子を使って検索クエリを絞り込めます。詳細は「詳しくはこちら」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 프로파일 목록에는 검색 필드가 있습니다(예: “설정 > 프로파일”). 다양한 연산자를 사용하여 검색어의 범위를 좁힐 수 있습니다. 자세한 내용은 “더 알아보기”를 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver profilliste har et søkefelt (f.eks. i «Innstillinger > Profiler»). Du kan bruke ulike operatorer for å avgrense søket. Klikk på «Finn ut mer» for alle detaljene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke lijst met profielen heeft een zoekveld (bijvoorbeeld in ‘Instellingen > Profielen’). Je kunt verschillende operatoren gebruiken om je zoekopdracht te beperken. Klik op ‘Meer informatie’ voor alle details."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda lista profili ma pole wyszukiwania (np. w „Ustawienia > Profile”). Możesz użyć różnych operatorów, aby zawęzić zapytanie. Kliknij „Więcej informacji”, aby poznać szczegóły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda lista de perfis tem um campo de busca (por exemplo, em “Ajustes > Perfis”). Você pode usar vários operadores para restringir sua consulta de busca. Clique em “Saiba mais” para todos os detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каждом списке профилей есть поле поиска (например, в «Настройки > Профили»). Вы можете использовать различные операторы, чтобы уточнить поисковый запрос. Нажмите «Подробнее», чтобы узнать все детали."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý zoznam profilov má vyhľadávacie pole (napríklad v časti „Nastavenia > Profily“). Vyhľadávací dotaz môžete obmedziť rôznymi operátormi. Všetky podrobnosti nájdete po kliknutí na „Viac informácií“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak seznam profilov ima iskalno polje (na primer v »Nastavitve > Profili«). Iskalno poizvedbo lahko omejite z različnimi operatorji. Za vse podrobnosti kliknite »Več o tem«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje lista med profiler har ett sökfält (t.ex. i ”Inställningar > Profiler”). Du kan använda olika operatorer för att begränsa sökfrågan. Klicka på ”Läs mer” för alla detaljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her profil listesinin bir arama alanı vardır (örneğin “Ayarlar > Profiller” bölümünde). Arama sorgunuzu kısıtlamak için çeşitli operatörler kullanabilirsiniz. Tüm ayrıntılar için “Daha Fazla Bilgi”ye tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi danh sách hồ sơ đều có một trường tìm kiếm (ví dụ, trong “Cài đặt > Hồ sơ.”) Bạn có thể dùng nhiều toán tử để giới hạn truy vấn tìm kiếm. Bấm “Tìm hiểu thêm” để xem toàn bộ chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个配置文件列表都包含搜索字段（例如在“设置 > 配置文件”中）。你可以使用各种运算符来限制搜索查询。点击“了解更多”可获取所有详情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個描述檔列表都有搜尋欄位（例如在「設定 > 描述檔」中）。你可以使用各種運算子來限制搜尋查詢。按一下「進一步了解」以取得所有詳細資訊。"
          }
        }
      }
    },
