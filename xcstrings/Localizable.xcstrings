        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skallet for denne kontoen, «%@», finnes ikke. Vil du endre profilen til å bruke /bin/zsh i stedet?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De shell voor dit account, ‘%@’, bestaat niet. Wil je het profiel wijzigen zodat /bin/zsh wordt gebruikt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powłoka dla tego konta, „%@”, nie istnieje. Zmienić profil, aby używał /bin/zsh?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O shell desta conta, “%@”, não existe. Alterar o perfil para usar /bin/zsh?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оболочка для этой учётной записи, «%@», не существует. Изменить профиль, чтобы использовать /bin/zsh вместо неё?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell pre tento účet „%@“ neexistuje. Zmeniť profil, aby namiesto neho používal /bin/zsh?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupina za ta račun, »%@«, ne obstaja. Želite spremeniti profil, da bo namesto nje uporabljal /bin/zsh?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalet för det här kontot, ”%@”, finns inte. Vill du ändra profilen så att /bin/zsh används i stället?"
          }
