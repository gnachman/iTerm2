    "Profiles.Window.WindowTitleContextMistake" : {
      "comment" : "Warning shown when a custom window title references session variables directly instead of through the window’s context.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento interpolovaný řetězec se vyhodnocuje v kontextu okna, nikoli relace. Pro přístup k proměnným aktuální relace použijte currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne interpolerede streng evalueres i vinduets kontekst, ikke sessionens kontekst. Brug currentTab.currentSession.sessionVariableNameHere for at få adgang til variabler i den aktuelle session"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese interpolierte Zeichenfolge wird im Kontext des Fensters ausgewertet, nicht im Kontext der Sitzung. Um auf Variablen der aktuellen Sitzung zuzugreifen, verwenden Sie currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This interpolated string is evaluated in the window’s context, not the session’s context. To access variables in the current session, use currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cadena interpolada se evalúa en el contexto de la ventana, no en el de la sesión. Para acceder a las variables de la sesión actual, usa currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä interpoloitu merkkijono arvioidaan ikkunan kontekstissa, ei istunnon kontekstissa. Käytä nykyisen istunnon muuttujia varten: currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette chaîne interpolée est évaluée dans le contexte de la fenêtre, pas dans celui de la session. Pour accéder aux variables de la session actuelle, utilisez currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa stringa interpolata viene valutata nel contesto della finestra, non in quello della sessione. Per accedere alle variabili della sessione corrente, usa currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この補間文字列はセッションのコンテキストではなく、ウインドウのコンテキストで評価されます。現在のセッションの変数にアクセスするには、currentTab.currentSession.sessionVariableNameHereを使用してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보간 문자열은 세션의 컨텍스트가 아니라 윈도우의 컨텍스트에서 평가됩니다. 현재 세션의 변수에 접근하려면 currentTab.currentSession.sessionVariableNameHere를 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne interpolerte strengen evalueres i vinduets kontekst, ikke øktens kontekst. Bruk currentTab.currentSession.sessionVariableNameHere for å få tilgang til variabler i gjeldende økt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze geïnterpoleerde tekenreeks wordt geëvalueerd in de context van het venster, niet in die van de sessie. Gebruik currentTab.currentSession.sessionVariableNameHere om variabelen in de huidige sessie te benaderen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten ciąg interpolowany jest obliczany w kontekście okna, a nie sesji. Aby uzyskać dostęp do zmiennych bieżącej sesji, użyj currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta string interpolada é avaliada no contexto da janela, não no contexto da sessão. Para acessar variáveis na sessão atual, use currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта интерполированная строка вычисляется в контексте окна, а не в контексте сессии. Чтобы получить доступ к переменным текущей сессии, используйте currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento interpolovaný reťazec sa vyhodnocuje v kontexte okna, nie relácie. Na prístup k premenným aktuálnej relácie použite currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta interpoliran niz se vrednoti v kontekstu okna, ne seje. Za dostop do spremenljivk trenutne seje uporabite currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här interpolerade strängen utvärderas i fönstrets kontext, inte sessionens. Om du vill komma åt variabler i den aktuella sessionen använder du currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ara değerli dize, oturumun değil pencerenin bağlamında değerlendirilir. Geçerli oturumdaki değişkenlere erişmek için currentTab.currentSession.sessionVariableNameHere kullanın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuỗi nội suy này được đánh giá trong ngữ cảnh của cửa sổ, không phải của phiên. Để truy cập các biến trong phiên hiện tại, hãy dùng currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字符串在窗口上下文中被计算，而非会话上下文。要访问当前会话中的变量，请使用 currentTab.currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字串是在視窗的環境中求值，而非工作階段的環境。若要存取目前工作階段中的變數，請使用 currentTab.currentSession.sessionVariableNameHere"
          }
        }
      }
    },
