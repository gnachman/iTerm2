    "Companion.InstallAIConfigured" : {
      "comment" : "Shown on the full setup screen instead of the API key field when the user’s AI model already works",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Funktionen verwenden das Modell, das Sie bereits unter Einstellungen > Allgemein > KI eingerichtet haben, daher ist hier kein API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI features will use the model you already set up in Settings > General > AI, so no API key is needed here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI機能では、設定 > 一般 > AIですでに設定したモデルが使用されるため、ここでAPIキーを入力する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 기능은 설정 > 일반 > AI에서 이미 설정한 모델을 사용하므로 여기에서는 API 키가 필요하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os recursos de IA usarão o modelo que você já configurou em Ajustes > Geral > IA, portanto não é necessária uma chave de API aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функции ИИ будут использовать модель, уже настроенную в Настройки > Общие > ИИ, поэтому ключ API здесь не нужен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 功能将使用您已在“设置 > 通用 > AI”中设置好的模型，因此无需在此输入 API 密钥。"
          }
        }
      }
    },
    "Companion.InstallAIManualModelNeedsConfiguration" : {
      "comment" : "Shown on the full setup screen instead of the API key field when the user’s manually chosen AI model cannot authenticate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das unter Einstellungen > Allgemein > KI ausgewählte KI-Modell benötigt einen API-Schlüssel oder eine gültige Konfiguration, bevor KI-Funktionen funktionieren. Sie können jetzt installieren und die Einrichtung des Modells später abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI model selected in Settings > General > AI needs an API key or a valid configuration before AI features will work. You can install now and finish setting up the model later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI機能を使用するには、設定 > 一般 > AIで選択したAIモデルにAPIキーまたは有効な設定が必要です。今すぐインストールして、モデルの設定は後で完了することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 기능을 사용하려면 설정 > 일반 > AI에서 선택한 AI 모델에 API 키 또는 유효한 구성이 필요합니다. 지금 설치하고 나중에 모델 설정을 완료할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo de IA selecionado em Ajustes > Geral > IA precisa de uma chave de API ou de uma configuração válida para que os recursos de IA funcionem. Você pode instalar agora e concluir a configuração do modelo mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели ИИ, выбранной в Настройки > Общие > ИИ, нужен ключ API или корректная конфигурация, чтобы функции ИИ заработали. Вы можете установить сейчас и завершить настройку модели позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 通用 > AI”中选择的 AI 模型需要 API 密钥或有效配置，AI 功能才能正常工作。您可以现在安装，稍后再完成模型设置。"
          }
        }
      }
    },
