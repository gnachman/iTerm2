        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehottaa valitsemaan profiilin ja jakaa sitten nykyisen istunnon vaakasuunnassa sijoittaen uuden istunnon alapuoliskoon."
