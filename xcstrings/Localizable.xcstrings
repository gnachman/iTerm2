    "AdvancedSetting.minimalTextLegibilityAdjustment" : {
      "comment" : "Advanced setting: minimalTextLegibilityAdjustment",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um wie viel soll der Kontrast für Text in Tabs im Design „Minimal“ erhöht werden?\nWählen Sie einen Wert größer als 1, um den Kontrast zu erhöhen. Werte zwischen 0 und 1 haben weniger Kontrast als der Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How much should contrast be increased for text in tabs in the Minimal theme?\nChoose a value larger than 1 to increase contrast. Values between 0 and 1 have less contrast than the default."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimalテーマで、タブ内のテキストのコントラストをどの程度上げるか？\n1より大きい値を指定するとコントラストが上がります。0から1の間の値はデフォルトよりコントラストが下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 테마에서 탭 텍스트의 대비를 얼마나 높이겠습니까?\n대비를 높이려면 1보다 큰 값을 선택하십시오. 0과 1 사이의 값은 기본값보다 대비가 낮습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o contraste deve ser aumentado para o texto nas abas no tema Minimal?\nEscolha um valor maior que 1 para aumentar o contraste. Valores entre 0 e 1 têm menos contraste que o padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько увеличить контраст текста на вкладках в теме Minimal?\nВыберите значение больше 1, чтобы увеличить контраст. Значения от 0 до 1 дают меньший контраст, чем по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Minimal 主题下，标签页中的文本对比度应提高多少？\n请选择大于 1 的数值以提升对比度。0 到 1 之间的数值对应的对比度低于默认值。"
          }
        }
      }
    },
    "AdvancedSetting.minimumTabDragDistance" : {
      "comment" : "Advanced setting: minimumTabDragDistance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit muss die Maus bewegt werden, bevor ein Tab-Drag beginnt?\nSie müssen iTerm2 nach dem Ändern dieser Einstellung neu starten, damit sie wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
