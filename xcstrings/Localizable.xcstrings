        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitro vrednotenje regularnih izrazov za sprožilce.\nTo je poskusno, ker bi lahko spremenilo razlago regularnih izrazov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabb utvärdering av reguljära uttryck för utlösare.\nDetta är experimentellt eftersom det kan ändra hur reguljära uttryck tolkas."
