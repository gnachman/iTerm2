        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa käyttöliittymän, jossa voit lisätä, päivittää tai poistaa Python API -skriptin pip-riippuvuuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
