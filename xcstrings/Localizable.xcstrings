    "StatusBarAction.MenuDetailedDescription" : {
      "comment" : "Detailed description of the actions menu status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet beim Anklicken ein Menü mit Aktionen. Aktionen ähneln benutzerdefinierten Tastenkombinationen, jedoch ohne zugeordneten Tastendruck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicked, opens a menu of actions. Actions are like custom key bindings, but without a keystroke attached."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer clic, abre un menú de acciones. Las acciones son como asignaciones de teclas personalizadas, pero sin una pulsación de tecla asociada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au clic, ouvre un menu d’actions. Les actions ressemblent à des associations de touches personnalisées, mais sans raccourci clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si fa clic, apre un menu di azioni. Le azioni sono come le associazioni tasti personalizzate, ma senza una combinazione di tasti associata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックするとアクションのメニューが開きます。アクションはカスタムキーバインドに似ていますが、キー操作が割り当てられていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 동작 메뉴가 열립니다. 동작은 사용자 지정 키 바인딩과 비슷하지만 키 입력이 연결되어 있지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando clicado, abre um menu de ações. As ações são como associações de teclas personalizadas, mas sem uma tecla associada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При нажатии открывает меню действий. Действия похожи на пользовательские сочетания клавиш, но без привязки к нажатию клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıklandığında bir eylem menüsü açar. Eylemler özel tuş atamalarına benzer, ancak bir tuş vuruşu bağlı değildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按后打开操作菜单。操作类似于自定义按键绑定，但不绑定按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下時會打開動作選單。動作類似自訂按鍵對應，但不綁定按鍵。"
          }
        }
      }
    },
