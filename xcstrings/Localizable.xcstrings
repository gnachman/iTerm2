    "DynamicProfiles.UnknownParentByGUID" : {
      "comment" : "Error shown when a dynamic profile references a parent GUID that cannot be found; %1$@ is the profile name and %2$@ is the GUID",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamický profil %1$@ odkazuje na neznámý nadřazený GUID %2$@. Jako nadřazený se použije výchozí profil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den dynamiske profil %1$@ henviser til det ukendte overordnede GUID %2$@. Bruger standardprofilen som overordnet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dynamische Profil %1$@ verweist auf die unbekannte übergeordnete GUID %2$@. Das Standardprofil wird als übergeordnetes Element verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamic profile %1$@ references unknown parent GUID %2$@. Using default profile as parent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil dinámico %1$@ hace referencia al GUID principal desconocido %2$@. Se usa el perfil predeterminado como principal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynaaminen profiili %1$@ viittaa tuntemattomaan ylätason GUID:hen %2$@. Ylätasona käytetään oletusprofiilia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil dynamique %1$@ référence un GUID parent inconnu %2$@. Le profil par défaut est utilisé comme parent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo dinamico %1$@ fa riferimento a un GUID genitore sconosciuto %2$@. Come genitore viene usato il profilo predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動的プロファイル %1$@ が不明な親GUID %2$@ を参照しています。デフォルトプロファイルを親として使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일 %1$@이(가) 알 수 없는 상위 GUID %2$@을(를) 참조합니다. 기본 프로파일을 상위 프로파일로 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den dynamiske profilen %1$@ refererer til den ukjente overordnede GUID-en %2$@. Bruker standardprofilen som overordnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het dynamische profiel %1$@ verwijst naar de onbekende bovenliggende GUID %2$@. Het standaardprofiel wordt als bovenliggend profiel gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil dynamiczny %1$@ odwołuje się do nieznanego nadrzędnego GUID: %2$@. Jako nadrzędny użyto profilu domyślnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil dinâmico %1$@ referencia o GUID pai desconhecido %2$@. Usando o perfil padrão como pai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамический профиль %1$@ ссылается на неизвестный родительский GUID %2$@. Используется профиль по умолчанию в качестве родительского."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamický profil %1$@ odkazuje na neznámy nadradený GUID %2$@. Ako nadradený sa použije predvolený profil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamični profil %1$@ se sklicuje na neznan nadrejeni GUID %2$@. Kot nadrejeni se uporabi privzeti profil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den dynamiska profilen %1$@ refererar till den okända överordnade GUID:en %2$@. Använder förvald profil som överordnad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dinamik profili bilinmeyen %2$@ üst GUID’sine başvuruyor. Üst profil olarak varsayılan profil kullanılıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ động %1$@ tham chiếu đến GUID cha không xác định %2$@. Dùng hồ sơ mặc định làm hồ sơ cha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态配置文件 %1$@ 引用了未知的父 GUID：%2$@。使用默认配置文件作为父级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態描述檔 %1$@ 參照了未知的上層 GUID %2$@。將使用預設描述檔作為上層。"
          }
        }
      }
    },
