    "AdvancedSetting.noSyncSuppressClipboardAccessDeniedWarning" : {
      "comment" : "Advanced setting: noSyncSuppressClipboardAccessDeniedWarning",
      "extractionState" : "extracted_with_value",
      "localizations" : {
