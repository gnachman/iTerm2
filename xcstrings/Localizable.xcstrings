    "ChatViewController.StreamStoppedAutomatically" : {
      "comment" : "System message shown when automatic sending of terminal commands stops on its own",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkazy terminálu se již nebudou automaticky odesílat do AI. Automatické odesílání se vždy ukončí při restartu iTerm2 nebo při změně aktuálního chatu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalkommandoer sendes ikke længere automatisk til AI. Automatisk afsendelse stopper altid, når iTerm2 startes igen, eller den aktuelle chat skifter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalbefehle werden nicht mehr automatisch an die KI gesendet. Das automatische Senden endet immer, wenn iTerm2 neu gestartet wird oder sich der aktuelle Chat ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Terminal commands will no longer be sent to AI automatically. Automatic sending always terminates when iTerm2 restarts or the current chat changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los comandos de terminal ya no se enviarán a la IA automáticamente. El envío automático siempre termina cuando iTerm2 se reinicia o cambia el chat actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätekomentoja ei enää lähetetä AI:lle automaattisesti. Automaattinen lähetys päättyy aina, kun iTerm2 käynnistyy uudelleen tai nykyinen keskustelu vaihtuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes de terminal ne seront plus envoyées automatiquement à l’IA. L’envoi automatique s’arrête toujours au redémarrage d’iTerm2 ou au changement de chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I comandi del terminale non verranno più inviati automaticamente all’IA. L’invio automatico termina sempre quando iTerm2 si riavvia o la chat corrente cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルコマンドは自動的にAIへ送信されなくなります。自動送信は、iTerm2を再起動するか現在のチャットが変更されると必ず終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 명령이 더 이상 AI로 자동 전송되지 않습니다. 자동 전송은 iTerm2를 재시작하거나 현재 채팅이 바뀌면 항상 종료됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalkommandoer sendes ikke lenger til KI automatisk. Automatisk sending avsluttes alltid når iTerm2 startes på nytt eller den gjeldende chatten endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalcommando’s worden niet meer automatisch naar de AI gestuurd. Automatisch versturen stopt altijd wanneer iTerm2 opnieuw start of de huidige chat verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecenia terminala nie będą już automatycznie wysyłane do AI. Automatyczne wysyłanie zawsze kończy się po ponownym uruchomieniu iTerm2 lub zmianie bieżącego czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os comandos de terminal não serão mais enviados à IA automaticamente. O envio automático sempre termina quando o iTerm2 reinicia ou o chat atual muda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды терминала больше не будут автоматически отправляться в ИИ. Автоматическая отправка всегда прекращается при перезапуске iTerm2 или смене текущего чата."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príkazy terminálu sa už nebudú automaticky odosielať do AI. Automatické odosielanie sa vždy ukončí pri reštarte iTerm2 alebo pri zmene aktuálneho chatu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazi terminala ne bodo več samodejno poslani v AI. Samodejno pošiljanje se vedno konča, ko se iTerm2 znova zažene ali se spremeni trenutni klepet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalkommandon skickas inte längre till AI automatiskt. Automatisk sändning avslutas alltid när iTerm2 startas om eller den aktuella chatten byts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal komutları artık YZ’ye otomatik olarak gönderilmeyecek. Otomatik gönderme, iTerm2 yeniden başladığında veya geçerli sohbet değiştiğinde her zaman sona erer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lệnh terminal sẽ không còn được tự động gửi cho AI. Việc gửi tự động luôn dừng khi iTerm2 khởi động lại hoặc cuộc trò chuyện hiện tại thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端命令将不再自动发送给 AI。自动发送仅在 iTerm2 重启或当前聊天内容改变时终止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端機指令將不再自動傳送給 AI。自動傳送一律會在 iTerm2 重新啟動或目前的聊天變更時終止。"
          }
        }
      }
    },
