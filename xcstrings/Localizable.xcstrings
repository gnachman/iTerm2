    "Codecierge.LongSessionBody" : {
      "comment" : "Body of the warning shown when a Codecierge session runs a long time",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše relace Codecierge běží již dlouho. Stále ji používáte? Pokud ne, zastavte ji, ušetříte peníze a ochráníte soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Codecierge-session har kørt i lang tid. Bruger du den stadig? Hvis ikke, så stop den for at spare penge og beskytte din anonymitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Codecierge-Sitzung läuft schon seit langer Zeit. Nutzen Sie sie noch? Falls nicht, beenden Sie sie, um Kosten zu sparen und Ihre Privatsphäre zu schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your codecierge session has been going on for a long time. Are you still using it? If not, stop it to save money and privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión de Codecierge lleva mucho tiempo en marcha. ¿La sigues usando? Si no, detenla para ahorrar dinero y proteger tu privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge-istuntosi on jatkunut pitkään. Käytätkö sitä vielä? Jos et, pysäytä se säästääksesi rahaa ja tietosuojaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session Codecierge dure depuis longtemps. L’utilisez-vous toujours ? Sinon, arrêtez-la pour économiser de l’argent et préserver votre confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua sessione di Codecierge va avanti da molto tempo. La stai ancora usando? Se no, interrompila per risparmiare denaro e proteggere la privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codeciergeのセッションが長時間続いています。まだ使用していますか？使用していない場合は、費用とプライバシーを守るために停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge 세션이 오랫동안 진행되고 있습니다. 아직 사용하고 있습니까? 사용하지 않는다면 비용을 절약하고 개인 정보를 보호하기 위해 중단하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge-økten din har pågått lenge. Bruker du den fortsatt? Hvis ikke, stopp den for å spare penger og personvern."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Codecierge-sessie loopt al heel lang. Gebruik je hem nog? Zo niet, stop hem dan om geld te besparen en je privacy te beschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja sesja Codecierge trwa już bardzo długo. Nadal z niej korzystasz? Jeśli nie, zatrzymaj ją, aby oszczędzić pieniądze i chronić prywatność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua sessão do codecierge está durando muito tempo. Você ainda está usando? Se não, pare-a para economizar dinheiro e preservar a privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш сеанс Codecierge длится уже долго. Вы всё ещё им пользуетесь? Если нет, остановите его, чтобы сэкономить деньги и защитить конфиденциальность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša relácia Codecierge trvá už dlho. Stále ju používate? Ak nie, zastavte ju, aby ste ušetrili peniaze a chránili súkromie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša seja Codecierge poteka že dolgo. Jo še uporabljate? Če ne, jo ustavite, da prihranite denar in zaščitite zasebnost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din codecierge-session har pågått länge. Använder du den fortfarande? Om inte, stoppa den för att spara pengar och skydda din integritet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge oturumunuz uzun süredir devam ediyor. Hâlâ kullanıyor musunuz? Kullanmıyorsanız, para ve gizlilik açısından durdurun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên Codecierge của bạn đã diễn ra rất lâu. Bạn vẫn đang dùng nó chứ? Nếu không, hãy dừng nó để tiết kiệm tiền và bảo vệ quyền riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 codecierge 会话已持续很长时间。你还在使用它吗？如果没有，请停止它，以节省费用并保护隐私。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 codecierge 工作階段已持續很長一段時間。你還在使用嗎？如果沒有，請停止它，以節省費用並保護隱私。"
          }
        }
      }
    },
