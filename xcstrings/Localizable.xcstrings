    "PTYSession.SessionBuriedDescription" : {
      "comment" : "Notification description explaining how to restore a buried session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lze ji obnovit odpojením od tmux nebo z nabídky „Relace > Zahrabané relace“."
          }
        },
        "da" : {
          "stringUnit" : {
