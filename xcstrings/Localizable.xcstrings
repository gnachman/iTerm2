    "AdvancedSetting.alwaysUseStatusBarComposer" : {
      "comment" : "Advanced setting: alwaysUseStatusBarComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorübergehend einen Composer zur Statusleiste hinzufügen, anstatt die große Composer-Ansicht zu öffnen, wenn eine Statusleiste vorhanden ist."
          }
        },
        "en" : {
