    "ClaudeCodeOnboarding.RemoteHostAlreadyAllowed" : {
      "comment" : "Shown in the remote install step when the host already has an always-allow grant; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostiteli %@ je již trvale povoleno používat API iTerm2. Můžete to změnit v části „Nastavení > Obecné > Kouzla > Přístup k API přes SSH“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har allerede altid tilladelse til at bruge iTerm2 API. Du kan ændre det i Indstillinger > Generelt > Magi > API-adgang via SSH."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ darf die iTerm2-API bereits dauerhaft verwenden. Sie können dies unter Einstellungen > Allgemein > Magie > API-Zugriff über SSH ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
