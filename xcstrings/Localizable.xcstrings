          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se izvajajo preverjanja celovitosti obnovljivega stanja?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utföra integritetskontroller av det återställningsbara tillståndet?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri yüklenebilir durum bütünlük denetimleri yapılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra tính toàn vẹn của trạng thái có thể khôi phục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "执行可恢复状态完整性检查？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
