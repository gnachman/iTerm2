    "AdvancedSetting.noSyncTurnOffBracketedPasteOnHostChange" : {
      "comment" : "Advanced setting: noSyncTurnOffBracketedPasteOnHostChange",
      "extractionState" : "extracted_with_value",
      "localizations" : {
