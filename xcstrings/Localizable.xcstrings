      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, dennoch ist die Code-Signatur von iTerm2 entgegen aller Erwartung gültig. Bitte melden Sie einen Fehler unter https://iterm2.com/bugs"
