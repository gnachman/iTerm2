    "BrowserSSHPage.NoConnectionMessage" : {
      "comment" : "Browser page shown when opening an ssh: URL for a host with no ssh integration connection. %@ is the host name, shown in bold.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde keine Verbindung zu %@ über die SSH-Integration gefunden. Stellen Sie in einem Terminalfenster eine Verbindung her und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No connection to %@ using ssh integration could be found. Please connect to it in a terminal window and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ninguna conexión con %@ mediante la integración con SSH. Conéctate a él en una ventana de terminal e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune connexion à %@ utilisant l’intégration SSH n’a été trouvée. Connectez-vous-y dans une fenêtre de terminal, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stata trovata alcuna connessione a %@ tramite l’integrazione SSH. Connettiti a esso in una finestra di terminale e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合を使用した %@ への接続が見つかりませんでした。ターミナルウインドウで接続してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합을 사용하는 %@ 연결을 찾을 수 없습니다. 터미널 윈도우에서 연결한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma conexão com %@ pela integração SSH foi encontrada. Conecte-se a ele em uma janela de terminal e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не найдено подключение к %@ через интеграцию SSH. Подключитесь к нему в окне терминала и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH entegrasyonu kullanılan ve %@ ana makinesine açık bir bağlantı bulunamadı. Lütfen bir terminal penceresinde bu makineye bağlanıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到通过 SSH 集成与 %@ 的连接。请在终端窗口中连接到它，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到使用 SSH 整合與 %@ 的連線。請在終端機視窗中連線到它，然後再試一次。"
          }
        }
      }
    },
