    "SCPFile.KnownHostsUnreadable" : {
      "comment" : "Warning shown when the known_hosts file cannot be read; first %@ is the host, second %@ is the key hash type, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei known_hosts konnte nicht gelesen werden.\nDaher kann die Authentizität des Hosts '%1$@' nicht festgestellt werden. Der %2$@-Schlüssel-Fingerabdruck lautet %3$@. Trotzdem verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read the known_hosts file.\nAs a result, the authenticity of host '%1$@' can't be established.%2$@ key fingerprint is %3$@. Connect anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el archivo known_hosts.\nPor ello, no se puede establecer la autenticidad del host “%1$@”. La huella de la clave %2$@ es %3$@. ¿Conectar de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le fichier known_hosts.\nPar conséquent, l’authenticité de l’hôte « %1$@ » ne peut pas être établie. L’empreinte de la clé %2$@ est %3$@. Se connecter quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il file known_hosts.\nDi conseguenza, non è possibile stabilire l’autenticità dell’host “%1$@”. L’impronta della chiave %2$@ è %3$@. Connettersi comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hostsファイルを読み込めませんでした。\nそのため、ホスト '%1$@' の信頼性を確認できません。%2$@ 鍵のフィンガープリントは %3$@ です。このまま接続しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hosts 파일을 읽을 수 없습니다.\n따라서 호스트 '%1$@'의 진위를 확인할 수 없습니다.%2$@ 키 지문은 %3$@입니다. 그래도 연결하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o arquivo known_hosts.\nComo resultado, não é possível estabelecer a autenticidade do host “%1$@”.A impressão digital da chave %2$@ é %3$@. Conectar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать файл known_hosts.\nВ результате невозможно установить подлинность узла «%1$@». Отпечаток ключа %2$@: %3$@. Всё равно подключиться?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hosts dosyası okunamadı.\nBu nedenle “%1$@” ana makinesinin gerçekliği doğrulanamıyor. %2$@ anahtar parmak izi: %3$@. Yine de bağlanılsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 known_hosts 文件。\n因此，无法确认主机 '%1$@' 的真实性。%2$@ 密钥指纹为 %3$@。是否仍要连接？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 known_hosts 檔案。\n因此無法確認主機「%1$@」的真實性。%2$@ 金鑰指紋為 %3$@。仍要連線嗎？"
          }
        }
      }
    },
