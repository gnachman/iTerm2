        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” può avviarsi automaticamente all’avvio di iTerm2. Vuoi consentirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
