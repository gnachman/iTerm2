    "MacOS13Notice.Message" : {
      "comment" : "Body of the notice warning macOS 12 users that a future version will require macOS 13",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zukünftige Versionen von iTerm2 erfordern macOS 13 (Ventura) oder neuer. Dies ist die letzte Version, die macOS 12 unterstützt. Entschuldigen Sie die Unannehmlichkeiten!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Future versions of iTerm2 will require macOS 13 (Ventura) or later. This is the last version that supports macOS 12. Sorry for the inconvenience!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones futuras de iTerm2 requerirán macOS 13 (Ventura) o posterior. Esta es la última versión compatible con macOS 12. ¡Disculpa las molestias!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les futures versions d’iTerm2 nécessiteront macOS 13 (Ventura) ou version ultérieure. Ceci est la dernière version compatible avec macOS 12. Nous nous excusons pour la gêne occasionnée !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le versioni future di iTerm2 richiederanno macOS 13 (Ventura) o versioni successive. Questa è l’ultima versione che supporta macOS 12. Ci scusiamo per il disagio!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後のバージョンのiTerm2はmacOS 13（Ventura）以降が必要になります。これはmacOS 12をサポートする最後のバージョンです。ご不便をおかけして申し訳ございません！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "향후 버전의 iTerm2에는 macOS 13(Ventura) 이상이 필요합니다. 이 버전이 macOS 12를 지원하는 마지막 버전입니다. 불편을 드려 죄송합니다!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versões futuras do iTerm2 exigirão o macOS 13 (Ventura) ou posterior. Esta é a última versão compatível com o macOS 12. Desculpe pelo transtorno!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будущие версии iTerm2 потребуют macOS 13 (Ventura) или более позднюю версию. Это последняя версия, поддерживающая macOS 12. Приносим извинения за неудобства!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin gelecek sürümleri macOS 13 (Ventura) veya üstünü gerektirecek. Bu, macOS 12’yi destekleyen son sürümdür. Rahatsızlık için özür dileriz!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来版本的 iTerm2 将需要 macOS 13（Ventura）或更高版本。这是支持 macOS 12 的最后一个版本。给你带来不便，敬请谅解！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未來版本的 iTerm2 將需要 macOS 13 (Ventura) 或更新版本。這是最後一個支援 macOS 12 的版本。造成不便，敬請見諒！"
          }
        }
      }
    },
