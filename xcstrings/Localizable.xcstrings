          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 안전 검사를 활성화하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar verificação de segurança de comandos?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить проверку безопасности команд?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
