    "ScriptArchive.ExplicitAutoLaunchMessage" : {
      "comment" : "Prompt asking whether to allow a script to auto-launch; %@ is the script name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann automatisch gestartet werden, wenn iTerm2 startet. Möchten Sie das zulassen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” can launch automatically when iTerm2 starts. Would you like to allow that?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” puede iniciarse automáticamente cuando se abra iTerm2. ¿Quieres permitirlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » peut se lancer automatiquement au démarrage d’iTerm2. Voulez-vous l’autoriser ?"
          }
        },
        "it" : {
          "stringUnit" : {
