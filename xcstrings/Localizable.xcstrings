        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan geen verbinding maken met %1$@:%2$d. Controleer of de hostnaam juist is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z %1$@:%2$d. Sprawdź, czy nazwa hosta jest prawidłowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao conectar a %1$@:%2$d. Verifique se o nome do host está correto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к %1$@:%2$d. Проверьте правильность имени узла."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa pripojiť k %1$@:%2$d. Skontrolujte, či je názov hostiteľa správny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezave z %1$@:%2$d ni bilo mogoče vzpostaviti. Preverite, ali je ime gostitelja pravilno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte ansluta till %1$@:%2$d. Kontrollera att värdnamnet är korrekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@:%2$d adresine bağlanılamadı. Ana makine adının doğru olduğunu kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối với %1$@:%2$d. Hãy kiểm tra lại tên máy chủ có đúng không."
          }
        },
        "zh-Hans" : {
