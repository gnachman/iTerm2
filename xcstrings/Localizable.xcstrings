    "KeysPreferences.LeaderHelp" : {
      "comment" : "Help text explaining what the leader key is",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předponová zkratka se chová jako modifikační klávesa, například Command nebo Option, ale je to samostatný stisk. Lze ji použít v přiřazení kláves. Pokud například nastavíte předponovou zkratku na ⌘b, můžete akci přiřadit dvoustiskovou sekvenci „⌘b x“. ⌘b je doporučená předponová zkratka a tento stisk nebude v budoucnu použit k jiným účelům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Præfiksgenvejen fungerer som en kombitast, f.eks. Kommando eller Alternativ, men er et separat tastetryk. Den kan bruges i tastetildelinger. Hvis du f.eks. angiver præfiksgenvejen til ⌘b, kan du knytte en handling til sekvensen af to tastetryk “⌘b x”. ⌘b er den anbefalede præfiksgenvej, og dette tastetryk bliver ikke brugt til andre formål i fremtiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Leader verhält sich wie eine Modifikatortaste, etwa Befehl oder Option, ist aber eine eigene Tastenkombination. Er kann in Tastenzuordnungen verwendet werden. Wenn Sie den Leader beispielsweise auf ⌘b festlegen, können Sie eine Aktion an die zweiteilige Tastenfolge „⌘b x“ binden. ⌘b ist der empfohlene Leader, und diese Tastenkombination wird in Zukunft nicht für andere Zwecke verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The leader behaves like a modifier key, such as Command or Option, but is a separate keystroke. It can be used in key bindings. For example, if you set the leader to ⌘b then you could bind an action to the two-keystroke sequence “⌘b x”. ⌘b is the recommended leader and that keystroke will not be used for other purposes in the future."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El líder se comporta como una tecla modificadora, como Comando u Opción, pero es una pulsación independiente. Se puede usar en asignaciones de teclas. Por ejemplo, si estableces el líder en ⌘b, podrías asignar una acción a la secuencia de dos pulsaciones “⌘b x”. ⌘b es el líder recomendado y esa combinación no se usará para otros fines en el futuro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etuliiteoikotie toimii kuten muuntonäppäin, esimerkiksi komento tai optio, mutta se on erillinen näppäinpainallus. Sitä voi käyttää näppäinmäärityksissä. Jos esimerkiksi asetat etuliiteoikotieksi ⌘b, voit sitoa toiminnon kahden painalluksen sarjaan ”⌘b x”. Suositeltu etuliiteoikotie on ⌘b, eikä sitä oteta jatkossa muuhun käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci préfixe se comporte comme une touche modificatrice, telle que Commande ou Option, mais c’est une frappe distincte. Il peut être utilisé dans les associations de touches. Par exemple, si vous définissez le raccourci préfixe sur ⌘b, vous pouvez associer une action à la séquence de deux frappes « ⌘b x ». ⌘b est le raccourci préfixe recommandé et cette frappe ne sera pas utilisée à d’autres fins à l’avenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbreviazione prefisso si comporta come un tasto modificatore, come Comando od Opzione, ma è una pressione di tasto separata. Può essere usata nelle associazioni tasti. Ad esempio, se imposti l’abbreviazione prefisso su ⌘b, puoi associare un’azione alla sequenza di due pressioni “⌘b x”. ⌘b è l’abbreviazione prefisso consigliata e quella combinazione non verrà usata per altri scopi in futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーはCommandやOptionなどの修飾キーのように動作しますが、独立したキーストロークです。キーバインドで使用できます。たとえば、リーダーを⌘bに設定すると、「⌘b x」という2回のキーストロークのシーケンスにアクションをバインドできます。⌘bが推奨されるリーダーで、このキーストロークは今後他の用途には使用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리더는 Command나 Option 같은 보조 키처럼 동작하지만 별도의 키 입력입니다. 키 바인딩에 사용할 수 있습니다. 예를 들어 리더를 ⌘b로 설정하면 두 번의 키 입력 시퀀스 “⌘b x”에 동작을 할당할 수 있습니다. ⌘b가 권장되는 리더이며, 이 키 입력은 앞으로 다른 용도로 사용되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefiks-snarveien fungerer som en spesialtast, for eksempel Kommando eller Tilvalg, men er en egen tastekombinasjon. Den kan brukes i tastetilordninger. Hvis du for eksempel setter prefiks-snarveien til ⌘b, kan du tilordne en handling til sekvensen «⌘b x». ⌘b anbefales, og den kombinasjonen blir ikke brukt til andre formål i framtiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De prefixtoets werkt als een speciale toets, zoals Command of Option, maar is een aparte toetsaanslag. Je kunt deze gebruiken in toetstoewijzingen. Als je de prefixtoets bijvoorbeeld instelt op ⌘b, kun je een actie koppelen aan de reeks van twee toetsaanslagen ‘⌘b x’. ⌘b is de aanbevolen prefixtoets en deze toetscombinatie wordt in de toekomst niet voor andere doeleinden gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrót prefiksowy zachowuje się jak klawisz modyfikujący, np. Command lub Option, ale jest osobnym naciśnięciem klawiszy. Można go używać w przypisaniach klawiszy. Na przykład jeśli ustawisz skrót prefiksowy ⌘b, możesz przypisać akcję do dwuetapowej sekwencji „⌘b x”. ⌘b jest zalecanym skrótem prefiksowym i ta kombinacja nie będzie w przyszłości używana do innych celów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O leader se comporta como uma tecla modificadora, como Command ou Option, mas é uma tecla separada. Ele pode ser usado em associações de teclas. Por exemplo, se você definir o leader como ⌘b, poderá associar uma ação à sequência de duas teclas “⌘b x”. ⌘b é o leader recomendado e essa tecla não será usada para outros fins no futuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лидер ведёт себя как модификатор, например Command или Option, но представляет собой отдельное нажатие клавиши. Его можно использовать в сочетаниях клавиш. Например, если назначить лидером ⌘b, можно привязать действие к последовательности из двух нажатий «⌘b x». ⌘b — рекомендуемый лидер, и это сочетание клавиш не будет использоваться для других целей в будущем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefixová skratka sa správa ako modifikačný kláves, napríklad Command alebo Option, ale je to samostatné stlačenie. Možno ju použiť v priradeniach klávesov. Ak napríklad nastavíte prefixovú skratku na ⌘b, môžete priradiť akciu dvojstlačovej sekvencii „⌘b x“. ⌘b je odporúčaná prefixová skratka a toto stlačenie sa v budúcnosti nebude používať na iné účely."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predponska bližnjica se obnaša kot modifikacijska tipka, na primer Command ali Option, vendar je ločen pritisk tipke. Uporabite jo lahko v dodelitvah tipk. Če na primer nastavite predponsko bližnjico ⌘b, lahko dejanje dodelite zaporedju dveh pritiskov »⌘b x«. ⌘b je priporočena predponska bližnjica in te kombinacije tipk v prihodnje ne bomo uporabili za druge namene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefixkortkommandot fungerar som en modifierartangent, till exempel kommando eller alternativ, men är ett separat tangenttryck. Det kan användas i tangentkopplingar. Om du till exempel ställer in prefixkortkommandot på ⌘b kan du koppla en åtgärd till tangentföljden ”⌘b x”. ⌘b är det rekommenderade prefixkortkommandot och kommer inte att användas för andra ändamål i framtiden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önek kısayolu, Command veya Option gibi bir değiştirici tuş gibi davranır ancak ayrı bir tuş vuruşudur. Tuş atamalarında kullanılabilir. Örneğin önek kısayolunu ⌘b olarak ayarlarsanız, bir eylemi “⌘b x” iki tuş vuruşluk dizisine atayabilirsiniz. ⌘b önerilen önek kısayoludur ve bu tuş vuruşu gelecekte başka amaçlarla kullanılmayacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tiền tố hoạt động giống như phím bổ trợ, chẳng hạn Command hoặc Option, nhưng là một lần nhấn phím riêng. Bạn có thể dùng nó trong gán phím. Ví dụ, nếu bạn đặt phím tiền tố là ⌘b thì có thể gán một tác vụ cho chuỗi hai lần nhấn phím “⌘b x”. ⌘b là phím tiền tố được khuyên dùng và tổ hợp phím này sẽ không được dùng cho mục đích khác trong tương lai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leader 键的行为类似修饰键（如 Command 或 Option），但它是一个独立的按键。它可用于按键绑定。例如，如果你将 leader 设置为 ⌘b，则可以将某个操作绑定到“⌘b x”这个双按键序列。⌘b 是推荐的 leader，且该按键将来不会用于其他用途。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前置快速鍵的行為類似變更鍵（例如 Command 或 Option），但它是獨立的按鍵。它可用於按鍵對應。例如，若將前置快速鍵設為 ⌘b，就可以將動作綁定至「⌘b x」這個雙按鍵序列。建議使用 ⌘b 作為前置快速鍵，且該按鍵日後不會用於其他用途。"
          }
        }
      }
    },
    "KeysPreferences.PossibleOverrideWarning" : {
      "comment" : "Warning that a global keyboard shortcut may be overridden by a profile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavená globální klávesová zkratka je přepsána alespoň jedním profilem. Pokud nefunguje podle očekávání, zkontrolujte nastavení klávesnice ve svých profilech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den globale tastaturgenvej, du har angivet, tilsidesættes af mindst én profil. Tjek tastaturindstillingerne i dine profiler, hvis den ikke virker som forventet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die von Ihnen festgelegte globale Tastenkombination wird von mindestens einem Profil überschrieben. Überprüfen Sie die Tastatureinstellungen Ihrer Profile, falls es nicht wie erwartet funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The global keyboard shortcut you have set is overridden by at least one profile. Check your profiles’ keyboard settings if it doesn't work as expected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atajo de teclado global que has establecido es reemplazado por al menos un perfil. Revisa los ajustes de teclado de tus perfiles si no funciona como esperas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähintään yksi profiili ohittaa asettamasi yleisen näppäinoikotien. Tarkista profiilien näppäimistöasetukset, jos se ei toimi odotetusti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci clavier global que vous avez défini est remplacé par au moins un profil. Si le raccourci ne fonctionne pas comme prévu, vérifiez les réglages de clavier de vos profils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbreviazione da tastiera globale che hai impostato viene sostituita da almeno un profilo. Se non funziona come previsto, controlla le impostazioni della tastiera dei tuoi profili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定したグローバルキーボードショートカットは、少なくとも1つのプロファイルによって上書きされています。想定どおりに動作しない場合は、プロファイルのキーボード設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정한 전역 키보드 단축키를 하나 이상의 프로파일이 덮어쓰고 있습니다. 예상대로 작동하지 않으면 프로파일의 키보드 설정을 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den globale tastatursnarveien du har valgt, overstyres av minst én profil. Sjekk tastaturinnstillingene i profilene dine hvis den ikke fungerer som forventet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De algemene toetscombinatie die je hebt ingesteld, wordt overschreven door minstens één profiel. Controleer de toetsenbordinstellingen van je profielen als het niet werkt zoals verwacht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawiony przez ciebie globalny skrót klawiszowy jest zastępowany przez co najmniej jeden profil. Jeśli nie działa zgodnie z oczekiwaniami, sprawdź ustawienia klawiatury w swoich profilach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho de teclado global que você definiu é substituído por ao menos um perfil. Verifique os ajustes de teclado dos seus perfis se ele não funcionar como esperado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заданное вами глобальное сочетание клавиш переопределено как минимум одним профилем. Проверьте настройки клавиатуры в профилях, если оно не работает так, как ожидалось."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Globálna klávesová skratka, ktorú ste nastavili, je prepísaná aspoň jedným profilom. Ak nefunguje podľa očakávania, skontrolujte nastavenia klávesnice vo svojich profiloch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavljeno globalno bližnjico na tipkovnici preglasi vsaj en profil. Če ne deluje po pričakovanjih, preverite nastavitve tipkovnice v svojih profilih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det globala kortkommando du har angett åsidosätts av minst en profil. Kontrollera profilernas tangentbordsinställningar om det inte fungerar som förväntat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarladığınız genel klavye kısayolu en az bir profil tarafından geçersiz kılınıyor. Beklendiği gibi çalışmazsa profillerinizin klavye ayarlarını kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt chung mà bạn đã đặt bị ghi đè bởi ít nhất một hồ sơ. Hãy kiểm tra cài đặt bàn phím của các hồ sơ nếu phím tắt không hoạt động như mong đợi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你设置的全局键盘快捷键被至少一个配置文件覆盖。如果它没有按预期工作，请检查配置文件的键盘设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你設定的全域鍵盤快速鍵被至少一個描述檔覆蓋。如果它未如預期運作，請檢查描述檔的鍵盤設定。"
          }
        }
      }
    },
