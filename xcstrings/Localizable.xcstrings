    "NaggingController.ReportVariableDenied" : {
      "comment" : "Prompt asking whether to allow reporting a variable in the future; placeholder is the variable name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anfrage zum Melden der Variable „%@“ wurde abgelehnt. Dies zukünftig erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A request to report variable “%@” was denied. Allow it in the future?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó una solicitud para informar de la variable “%@”. ¿Permitirla en el futuro?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de signalement de la variable « %@ » a été refusée. L’autoriser à l’avenir ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una richiesta di segnalare la variabile “%@” è stata rifiutata. Consentirla in futuro?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変数「%@」を報告するリクエストが拒否されました。今後は許可しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변수 “%@”을(를) 보고하라는 요청이 거부되었습니다. 앞으로는 허용하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma solicitação para relatar a variável “%@” foi recusada. Permitir no futuro?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос на отправку переменной «%@» был отклонён. Разрешить это в дальнейшем?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” değişkenini raporlama isteği reddedildi. Gelecekte buna izin verilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
