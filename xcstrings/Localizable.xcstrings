    "Companion.InstallAIManualModelNeedsConfiguration" : {
      "comment" : "Shown on the full setup screen instead of the API key field when the user’s manually chosen AI model cannot authenticate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das unter Einstellungen > Allgemein > KI ausgewählte KI-Modell benötigt einen API-Schlüssel oder eine gültige Konfiguration, bevor KI-Funktionen funktionieren. Sie können jetzt installieren und die Einrichtung des Modells später abschließen."
          }
