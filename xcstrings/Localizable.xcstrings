    "ShellIntegration.AboutBody" : {
      "comment" : "Body text explaining what shell integration provides",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Shell-Integrationsfunktionen wie Befehlsverlauf, Letzte Verzeichnisse, Ausgabe des letzten Befehls auswählen und Automatischer Profilwechsel zu nutzen, muss Ihre Shell richtig konfiguriert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To use shell integration features such as Command History, Recent Directories, Select Output of Last Command, and Automatic Profile Switching, your shell must be properly configured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar funciones de la integración con el shell, como Historial de comandos, Directorios recientes, Seleccionar salida del último comando y Cambio automático de perfil, tu shell debe estar configurado correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour utiliser les fonctionnalités de l’intégration du shell, comme l’historique des commandes, les répertoires récents, Sélectionner la sortie de la dernière commande et le changement automatique de profil, votre shell doit être correctement configuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per usare le funzioni di integrazione shell come Cronologia comandi, Directory recenti, Seleziona output dell’ultimo comando e Cambio automatico del profilo, la tua shell deve essere configurata correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンド履歴、最近使用したディレクトリ、直前のコマンドの出力を選択、自動プロファイル切り替えなどのShell Integration機能を使用するには、シェルが正しく設定されている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 기록, 최근 디렉토리, 마지막 명령의 출력 선택, 자동 프로파일 전환 같은 셸 통합 기능을 사용하려면 셸이 올바르게 구성되어 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar recursos do Shell Integration, como Histórico de comandos, Diretórios recentes, Selecionar a saída do último comando e Troca automática de perfil, seu shell precisa estar configurado corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать функции интеграции с оболочкой, такие как история команд, недавние папки, выбор вывода последней команды и автоматическое переключение профилей, ваша оболочка должна быть правильно настроена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut Geçmişi, Son Dizinler, Son Komutun Çıktısını Seç ve Otomatik Profil Değiştirme gibi kabuk entegrasyonu özelliklerini kullanmak için kabuğunuzun doğru yapılandırılmış olması gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用 Shell 集成功能（如命令历史、最近的目录、选择最后一条命令的输出以及自动配置文件切换），你的 shell 必须正确配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使用 Shell 整合功能，例如指令歷史記錄、最近的目錄、選取上一個指令的輸出，以及自動切換描述檔，必須正確設定你的 shell。"
          }
        }
      }
    },
