    "Tip.0057.Body" : {
      "comment" : "Tip of the day body, id 0057",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Bearbeiten > Auswahl berücksichtigt weiche Grenzen“, damit Trennlinien geteilter Bereiche in Programmen wie vi, emacs und tmux erkannt werden, sodass Sie mehrere Textzeilen auswählen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on “Edit > Selection Respects Soft Boundaries” to recognize split pane dividers in programs like vi, emacs, and tmux so you can select multiple lines of text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa “Edición > La selección respeta los límites flexibles” para reconocer los divisores de paneles en programas como vi, emacs y tmux y poder seleccionar varias líneas de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Édition > La sélection respecte les limites souples » pour reconnaître les séparateurs de volets scindés dans des programmes comme vi, emacs et tmux et ainsi sélectionner plusieurs lignes de texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva “Modifica > La selezione rispetta i limiti morbidi” per riconoscere i divisori dei riquadri in programmi come vi, emacs e tmux e poter selezionare più righe di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 選択範囲でソフト境界を考慮」をオンにすると、vi、emacs、tmuxなどのプログラムで分割ペインの区切りを認識できるようになり、複数行のテキストを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“편집 > 소프트 경계를 고려하여 선택”을 켜면 vi, emacs, tmux 같은 프로그램의 분할 패널 구분선을 인식하므로 여러 줄의 텍스트를 선택할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Editar > A seleção respeita limites flexíveis” para reconhecer divisórias de painéis em programas como vi, emacs e tmux, permitindo selecionar várias linhas de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Правка > Выделение учитывает мягкие границы», чтобы распознавать разделители панелей в таких программах, как vi, emacs и tmux, и выделять несколько строк текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vi, emacs ve tmux gibi programlardaki bölme ayırıcılarını tanıyıp birden çok metin satırı seçebilmek için “Düzen > Seçim Yumuşak Sınırlara Uyar”ı açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“编辑 > 选择遵循软边界”以识别 vi、emacs 和 tmux 等程序中的分屏窗格分隔线，从而可以选择多行文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「編輯 > 選取範圍遵循軟邊界」，即可辨識 vi、emacs 和 tmux 等程式中的分割窗格分隔線，讓你能選取多行文字。"
          }
        }
      }
    },
