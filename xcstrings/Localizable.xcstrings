          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade de piscar do cursor (segundos)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость мигания курсора (в секундах)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç yanıp sönme hızı (saniye)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标闪烁速度（秒）。"
          }
