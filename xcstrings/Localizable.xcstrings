    "PasswordArchive.SettingsImportDetail" : {
      "comment" : "Shown when importing settings that contain an encrypted password export",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Export enthält gespeicherte Passwörter. Geben Sie die Passphrase ein, mit der sie exportiert wurden, oder brechen Sie ab, um alles andere ohne sie zu importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This export includes saved passwords. Enter the passphrase that was used to export them, or cancel to import everything else without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta exportación incluye contraseñas guardadas. Introduce la frase de contraseña que se usó para exportarlas, o cancela para importar todo lo demás sin ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette exportation inclut des mots de passe enregistrés. Saisissez la phrase secrète utilisée pour les exporter, ou annulez pour importer tout le reste sans eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa esportazione include password salvate. Inserisci la passphrase usata per esportarle oppure annulla per importare tutto il resto senza di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエクスポートには保存されたパスワードが含まれています。エクスポート時に使用したパスフレーズを入力するか、キャンセルしてパスワード以外のすべてをインポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 내보내기 파일에는 저장된 암호가 포함되어 있습니다. 암호를 내보낼 때 사용한 암호 문구를 입력하거나, 취소하여 암호를 제외한 나머지를 모두 가져오십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta exportação inclui senhas salvas. Digite a frase secreta usada para exportá-las ou cancele para importar todo o resto sem elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот экспорт содержит сохранённые пароли. Введите парольную фразу, использованную при их экспорте, или отмените, чтобы импортировать всё остальное без них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dışa aktarma kayıtlı parolaları içeriyor. Bunları dışa aktarırken kullanılan parola ifadesini girin veya diğer her şeyi onlar olmadan içe aktarmak için vazgeçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此导出包含已保存的密码。请输入导出时使用的口令，或取消以导入除密码之外的所有其他内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此匯出內容包含已儲存的密碼。請輸入匯出時使用的密語，或取消以匯入除密碼以外的所有其他內容。"
          }
        }
      }
    },
