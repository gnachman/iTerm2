      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Größe geteilter Bereiche über die Tastatur mit ^⌘-Pfeiltaste an."
          }
        },
        "en" : {
          "stringUnit" : {
