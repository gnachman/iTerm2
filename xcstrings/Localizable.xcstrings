        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OS가 특별한 이유 없이 윈도우를 첫 번째 디스플레이로 이동시키는 macOS 버그를 우회합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgå en macOS-feil der operativsystemet flytter vinduer til den første skjermen uten grunn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omzeil een bug in macOS waarbij het besturingssysteem vensters zonder goede reden naar het eerste scherm verplaatst."
          }
