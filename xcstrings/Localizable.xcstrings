          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠르게 열기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir rapidamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрое открытие"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速打开"
          }
        }
      }
    },
    "Tip.0004.Body" : {
      "comment" : "Tip of the day body, id 0004",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie versehentlich eine Sitzung, einen Tab oder ein Fenster schließen, können Sie dies mit „Bearbeiten > Widerrufen“ (⌘Z) rückgängig machen. Standardmäßig haben Sie fünf Sekunden Zeit dafür, Sie können dieses Zeitlimit jedoch unter „Einstellungen > Profile > Sitzung“ anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you close a session, tab, or window by accident you can undo it with “Edit > Undo” (⌘Z). By default you have five seconds to undo, but you can adjust that timeout in “Settings > Profiles > Session.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション、タブ、ウインドウを誤って閉じてしまった場合は、「編集 > 取り消す」(⌘Z) で元に戻せます。デフォルトでは取り消せる時間は 5 秒間ですが、「設定 > プロファイル > セッション」でそのタイムアウトを調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실수로 세션, 탭 또는 윈도우를 닫았다면 “편집 > 실행 취소”(⌘Z)로 되돌릴 수 있습니다. 기본적으로 5초 안에 실행 취소할 수 있으며, 이 시간은 “설정 > 프로파일 > 세션”에서 조정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você fechar uma sessão, aba ou janela por acidente, pode desfazer com “Editar > Desfazer” (⌘Z). Por padrão, você tem cinco segundos para desfazer, mas pode ajustar esse tempo limite em “Ajustes > Perfis > Sessão”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы случайно закрыли сессию, вкладку или окно, это можно отменить с помощью «Правка > Отменить» (⌘Z). По умолчанию у вас есть пять секунд на отмену, но этот интервал можно изменить в «Настройки > Профили > Сессия»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不小心关闭了会话、标签页或窗口，可以使用“Edit > Undo” (⌘Z) 进行撤销操作。默认情况下，您有五秒的撤销时间，但可以在“Settings > Profiles > Session”中调整此超时时间。"
          }
        }
      }
    },
    "Tip.0004.Title" : {
      "comment" : "Tip of the day title, id 0004",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
