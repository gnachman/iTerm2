    "Tip.0045.Body" : {
      "comment" : "Tip of the day body, id 0045",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil můžete nastavit tak, aby vytvářel okna připojená k jednomu okraji obrazovky, v „Nastavení > Profily > Okno“. Jejich velikost změníte přetažením okrajů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bede din profil om at oprette vinduer, der er fastgjort til en kant af skærmen, i “Indstillinger > Profiler > Vindue”. Du kan ændre deres størrelse ved at trække i kanterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihrem Profil unter „Einstellungen > Profile > Fenster“ mitteilen, dass es Fenster erzeugen soll, die an einem Bildschirmrand andocken. Sie können deren Größe durch Ziehen der Ränder ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can tell your profile to create windows that are attached to one edge of the screen in “Settings > Profiles > Window.” You can resize them by dragging the edges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes indicar a tu perfil que cree ventanas ancladas a un borde de la pantalla en “Ajustes > Perfiles > Ventana”. Puedes cambiar su tamaño arrastrando los bordes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit käskeä profiiliasi luomaan ikkunoita, jotka kiinnittyvät näytön yhteen reunaan, kohdassa ”Asetukset > Profiilit > Ikkuna”. Voit muuttaa niiden kokoa vetämällä reunoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez indiquer à votre profil de créer des fenêtres fixées à un bord de l’écran dans « Réglages > Profils > Fenêtre ». Vous pouvez les redimensionner en faisant glisser les bords."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi indicare al tuo profilo di creare finestre agganciate a un bordo dello schermo in “Impostazioni > Profili > Finestra”. Puoi ridimensionarle trascinando i bordi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > ウィンドウ」で、画面の端に固定されたウィンドウを作成するようプロファイルに指定できます。端をドラッグしてサイズを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 윈도우”에서 화면의 한쪽 가장자리에 붙는 윈도우를 생성하도록 프로파일을 설정할 수 있습니다. 가장자리를 드래그하여 크기를 조절할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan be profilen din om å opprette vinduer som er festet til én kant av skjermen i «Innstillinger > Profiler > Vindu». Du kan endre størrelsen på dem ved å dra i kantene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt je profiel vensters laten maken die aan een rand van het scherm vastzitten, in ‘Instellingen > Profielen > Venster’. Je kunt het formaat wijzigen door de randen te slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz ustawić profil tak, aby tworzył okna przyczepione do jednej krawędzi ekranu, w „Ustawienia > Profile > Okno”. Możesz zmieniać ich rozmiar, przeciągając krawędzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar seu perfil para criar janelas fixadas em uma das bordas da tela em “Ajustes > Perfis > Janela”. Você pode redimensioná-las arrastando as bordas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить профиль так, чтобы он создавал окна, прикреплённые к одному из краёв экрана, в «Настройки > Профили > Окно». Их можно изменять в размере, перетаскивая края."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilu môžete nastaviť, aby vytváral okná pripojené k jednému okraju obrazovky, v časti „Nastavenia > Profily > Okno“. Ich veľkosť zmeníte potiahnutím okrajov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V »Nastavitve > Profili > Okno« lahko profilu določite, naj ustvarja okna, pripeta na rob zaslona. Njihovo velikost lahko spremenite z vlečenjem robov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan låta din profil skapa fönster som är fästa vid en skärmkant i ”Inställningar > Profiler > Fönster”. Du kan ändra storlek på dem genom att dra i kanterna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilinizin “Ayarlar > Profiller > Pencere” bölümünde ekranın bir kenarına bağlı pencereler oluşturmasını sağlayabilirsiniz. Kenarlarını sürükleyerek yeniden boyutlandırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể yêu cầu hồ sơ tạo các cửa sổ gắn vào một cạnh của màn hình trong “Cài đặt > Hồ sơ > Cửa sổ.” Bạn có thể đổi kích thước chúng bằng cách kéo các cạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在“设置 > 配置文件 > 窗口”中让你的配置文件创建固定在屏幕一边的窗口。你可以通过拖动边缘来调整其大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在「設定 > 描述檔 > 視窗」中，讓描述檔建立貼附於螢幕某一邊的視窗，並可拖移邊緣來調整大小。"
          }
        }
      }
    },
