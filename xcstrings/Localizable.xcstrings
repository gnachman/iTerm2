    "Tip.0016.Body" : {
      "comment" : "Tip of the day body, id 0016",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 umí automaticky provádět vámi definované akce, když přijme text odpovídající regulárnímu výrazu. Můžete například zvýraznit text nebo zobrazit dialog s upozorněním. Nastavíte to v „Nastavení > Profily > Pokročilé > Spouštěče“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan automatisk udføre handlinger, du definerer, når der modtages tekst, der matcher et regulært udtryk. Du kan f.eks. fremhæve tekst eller vise en advarselsdialog. Indstil det i “Indstillinger > Profiler > Avanceret > Udløsere”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann automatisch von Ihnen definierte Aktionen ausführen, sobald Text empfangen wird, der einem regulären Ausdruck entspricht. Sie können beispielsweise Text hervorheben oder ein Warnfenster anzeigen lassen. Richten Sie dies unter „Einstellungen > Profile > Erweitert > Trigger“ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can automatically perform actions you define when text matching a regular expression is received. For example, you can highlight text or show an alert box. Set it up in “Settings > Profiles > Advanced > Triggers.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 puede realizar automáticamente las acciones que definas cuando se recibe texto que coincide con una expresión regular. Por ejemplo, puedes resaltar texto o mostrar un cuadro de alerta. Configúralo en “Ajustes > Perfiles > Avanzado > Disparadores”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 voi suorittaa automaattisesti määrittämiäsi toimintoja, kun vastaanotetaan säännölliseen lausekkeeseen täsmäävää tekstiä. Voit esimerkiksi korostaa tekstiä tai näyttää varoitusikkunan. Määritä se kohdassa ”Asetukset > Profiilit > Lisävalinnat > Käynnistimet”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut exécuter automatiquement les actions que vous définissez lorsqu’un texte correspondant à une expression régulière est reçu. Par exemple, vous pouvez mettre du texte en surbrillance ou afficher une alerte. Configurez-le dans « Réglages > Profils > Avancé > Déclencheurs »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può eseguire automaticamente le azioni da te definite quando riceve testo che corrisponde a un’espressione regolare. Ad esempio, puoi evidenziare il testo o mostrare un avviso. Configuralo in “Impostazioni > Profili > Avanzate > Attivatori”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2では、正規表現に一致するテキストを受信したときに、あらかじめ定義したアクションを自動的に実行できます。たとえば、テキストをハイライトしたり、アラートボックスを表示したりできます。「設定 > プロファイル > 詳細 > トリガー」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 정규 표현식과 일치하는 텍스트를 수신하면 사용자가 정의한 동작을 자동으로 수행할 수 있습니다. 예를 들어 텍스트를 하이라이트하거나 경고 상자를 표시할 수 있습니다. “설정 > 프로파일 > 고급 > 트리거”에서 설정하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan automatisk utføre handlinger du definerer når tekst som treffer et regulært uttrykk mottas. Du kan for eksempel utheve tekst eller vise en varselboks. Sett det opp i «Innstillinger > Profiler > Avansert > Utløsere»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan automatisch door jou gedefinieerde acties uitvoeren wanneer tekst wordt ontvangen die overeenkomt met een reguliere expressie. Je kunt bijvoorbeeld tekst markeren of een waarschuwingsvenster tonen. Stel het in via ‘Instellingen > Profielen > Geavanceerd > Triggers’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 może automatycznie wykonywać zdefiniowane przez ciebie akcje po otrzymaniu tekstu pasującego do wyrażenia regularnego. Możesz na przykład wyróżnić tekst lub pokazać okno alertu. Skonfiguruj to w „Ustawienia > Profile > Zaawansowane > Wyzwalacze”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode executar automaticamente ações que você define quando um texto que corresponde a uma expressão regular é recebido. Por exemplo, você pode destacar um texto ou mostrar uma caixa de alerta. Configure em “Ajustes > Perfis > Avançado > Gatilhos”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может автоматически выполнять заданные вами действия, когда получен текст, соответствующий регулярному выражению. Например, можно выделить текст цветом или показать окно с предупреждением. Настройте это в «Настройки > Профили > Дополнительные > Триггеры»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 dokáže automaticky vykonať vami definované akcie, keď sa prijme text zodpovedajúci regulárnemu výrazu. Môžete napríklad zvýrazniť text alebo zobraziť dialóg s upozornením. Nastavíte to v časti „Nastavenia > Profily > Rozšírené > Spúšťače“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 lahko samodejno izvede dejanja, ki jih določite, ko prejme besedilo, ki ustreza regularnemu izrazu. Besedilo lahko na primer poudarite ali prikažete opozorilno okno. Nastavite ga v »Nastavitve > Profili > Napredno > Sprožilci«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan automatiskt utföra åtgärder som du definierar när text som matchar ett reguljärt uttryck tas emot. Du kan till exempel markera text eller visa en varningsruta. Ställ in det i ”Inställningar > Profiler > Avancerat > Utlösare”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, bir düzenli ifadeyle eşleşen metin alındığında tanımladığınız eylemleri otomatik olarak gerçekleştirebilir. Örneğin metni vurgulayabilir veya bir uyarı kutusu gösterebilirsiniz. “Ayarlar > Profiller > Gelişmiş > Tetikleyiciler” bölümünde ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 có thể tự động thực hiện các tác vụ do bạn định nghĩa khi nhận được văn bản khớp với một biểu thức chính quy. Ví dụ, bạn có thể tô sáng văn bản hoặc hiển thị hộp cảnh báo. Thiết lập trong “Cài đặt > Hồ sơ > Nâng cao > Trình kích hoạt.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当文本匹配正则表达式时，iTerm2 可以自动执行您定义的操作。例如，您可以高亮显示文本或显示警告框。在“设置 > 配置文件 > 高级 > 触发器”中配置即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當收到符合正規表示式的文字時，iTerm2 可以自動執行你定義的動作。例如，你可以醒目標示文字或顯示警示框。你可以在「設定 > 描述檔 > 進階 > 觸發器」中設定。"
          }
        }
      }
    },
