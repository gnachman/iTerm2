    "TmuxGateway.Tmux21QuirkError" : {
      "comment" : "Error shown when tmux 2.1 or earlier refuses to create a window pane with a missing working directory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyba: %1$@.\n\ntmux 2.1 a starší odmítnou vytvořit nové podokno okna s neexistujícím počátečním pracovním adresářem.\n\nInformace:\n%2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejl: %1$@.\n\ntmux 2.1 og tidligere nægter at oprette en ny vinduesrude med en ikke-eksisterende indledende arbejdsmappe.\n\nOplysninger:\n%2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler: %1$@.\n\ntmux 2.1 und früher verweigert die Erstellung eines neuen Fensterbereichs mit einem nicht vorhandenen anfänglichen Arbeitsverzeichnis.\n\nInfo:\n%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Error: %1$@.\n\nTmux 2.1 and earlier will refuse to create a new window pane with a nonexistent initial working directory.\n\nInfo:\n%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error: %1$@.\n\ntmux 2.1 y versiones anteriores se niegan a crear un nuevo panel de ventana con un directorio de trabajo inicial inexistente.\n\nInformación:\n%2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virhe: %1$@.\n\ntmux 2.1 ja sitä vanhemmat versiot kieltäytyvät luomasta uutta ikkunapaneelia, jonka alkuperäistä työhakemistoa ei ole olemassa.\n\nTiedot:\n%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur : %1$@.\n\ntmux 2.1 et les versions antérieures refusent de créer un nouveau volet de fenêtre avec un répertoire de travail initial inexistant.\n\nInfos :\n%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Errore: %1$@.\n\ntmux 2.1 e versioni precedenti si rifiutano di creare un nuovo riquadro di finestra con una directory di lavoro iniziale inesistente.\n\nInformazioni:\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エラー: %1$@\n\ntmux 2.1以前では、存在しない初期作業ディレクトリで新しいウィンドウペインを作成することはできません。\n\n情報:\n%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오류: %1$@.\n\ntmux 2.1 이하 버전은 존재하지 않는 초기 작업 디렉토리로 새로운 윈도우 패널을 생성하지 않습니다.\n\n정보:\n%2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feil: %1$@.\n\ntmux 2.1 og eldre vil nekte å opprette en ny vindusrute med en ikke-eksisterende opprinnelig arbeidsmappe.\n\nInfo:\n%2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fout: %1$@.\n\ntmux 2.1 en eerder weigeren een nieuw paneel te maken met een niet-bestaande initiële werkmap.\n\nInfo:\n%2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błąd: %1$@.\n\ntmux 2.1 i wcześniejsze wersje odmawiają utworzenia nowego panelu okna z nieistniejącym początkowym katalogiem roboczym.\n\nInformacje:\n%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro: %1$@.\n\nO tmux 2.1 e anteriores se recusam a criar um novo painel de janela com um diretório de trabalho inicial inexistente.\n\nInfo:\n%2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка: %1$@.\n\nTmux 2.1 и более ранних версий отказывается создавать новую панель окна с несуществующим исходным рабочим каталогом.\n\nСведения:\n%2$@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chyba: %1$@.\n\ntmux 2.1 a staršie verzie odmietnu vytvoriť nový panel okna s neexistujúcim počiatočným pracovným adresárom.\n\nInformácie:\n%2$@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napaka: %1$@.\n\ntmux 2.1 in starejši zavrnejo ustvarjanje novega podokna okna z neobstoječim začetnim delovnim imenikom.\n\nPodatki:\n%2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fel: %1$@.\n\ntmux 2.1 och äldre vägrar skapa en ny fönsterpanel med en ursprunglig arbetskatalog som inte finns.\n\nInfo:\n%2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata: %1$@.\n\ntmux 2.1 ve öncesi, var olmayan bir başlangıç çalışma dizini olan yeni bir pencere bölmesi oluşturmayı reddeder.\n\nBilgi:\n%2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lỗi: %1$@.\n\ntmux 2.1 trở về trước sẽ từ chối tạo khung cửa sổ mới với thư mục làm việc ban đầu không tồn tại.\n\nThông tin:\n%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错误：%1$@。\n\nTmux 2.1及更早版本会拒绝创建初始工作目录不存在的新窗口窗格。\n\n信息：\n%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錯誤：%1$@。\n\ntmux 2.1 及更早版本會拒絕建立初始工作目錄不存在的新視窗窗格。\n\n資訊：\n%2$@"
          }
        }
      }
    },
