          }
        }
      }
    },
    "HotKeyMigration.ChangesToMakeTitle" : {
      "comment" : "Title of the dialog listing settings to add to a dynamic profile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
