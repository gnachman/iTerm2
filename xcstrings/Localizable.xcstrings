    "MigrationHelper.MoveOpenAIKeyMessage" : {
      "comment" : "Message asking whether to move the OpenAI API key into the keychain",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI-API-Schlüssel in den Schlüsselbund verschieben? Er wird derzeit in User Defaults gespeichert, was weniger sicher ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move OpenAI API key into the keychain? It is currently stored in User Defaults, which is not as secure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mover la clave de API de OpenAI al llavero? Actualmente está guardada en User Defaults, que no es tan seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer la clé d’API OpenAI dans le trousseau ? Elle est actuellement stockée dans les préférences utilisateur (User Defaults), ce qui est moins sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare la chiave API di OpenAI nel portachiavi? Attualmente è salvata nelle preferenze utente, che sono meno sicure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI APIキーをキーチェーンに移動しますか?現在はUser Defaultsに保存されており、安全性が低くなっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI API 키를 키체인으로 이동하겠습니까? 현재는 보안 수준이 낮은 User Defaults에 저장되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover a chave da API da OpenAI para o Chaveiro? Ela está armazenada atualmente em User Defaults, que não é tão seguro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенести ключ API OpenAI в связку ключей? Сейчас он хранится в User Defaults, что менее безопасно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI API anahtarı anahtar zincirine taşınsın mı? Şu anda daha az güvenli olan Kullanıcı Varsayılanları’nda saklanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 OpenAI API 密钥移入钥匙串？它当前存储在“用户默认设置”中，不够安全。"
