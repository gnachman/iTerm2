    "Tip.0121.Body" : {
      "comment" : "Tip of the day body, id 0121",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Schnell öffnen“ (⇧⌘O) ist jetzt eine Befehlspalette! Geben Sie einfach den Namen eines Menüpunkts ein, um ihn zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Quickly (⇧⌘O) is now a command palette! Just type the name of a menu item to activate it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Abrir rápidamente (⇧⌘O) ahora es una paleta de comandos! Solo tienes que escribir el nombre de un ítem de menú para activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouverture rapide (⇧⌘O) est désormais une palette de commandes ! Il suffit de saisir le nom d’un élément de menu pour l’activer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apertura rapida (⇧⌘O) ora è una palette dei comandi! Basta digitare il nome di una voce di menu per attivarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すばやく開く」（⇧⌘O）がコマンドパレットになりました！メニュー項目の名前を入力するだけで実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠르게 열기(⇧⌘O)가 이제 명령 팔레트가 되었습니다! 메뉴 항목의 이름을 입력하기만 하면 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Open Quickly (⇧⌘O) agora é uma paleta de comandos! Basta digitar o nome de um item de menu para ativá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрое открытие (⇧⌘O) теперь работает как палитра команд! Просто введите название пункта меню, чтобы активировать его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı Aç (⇧⌘O) artık bir komut paleti! Etkinleştirmek için bir menü öğesinin adını yazmanız yeterli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“快速打开”（⇧⌘O）现在是一个命令面板！只需输入菜单项名称即可激活它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「快速打開」（⇧⌘O）現在是一個指令面板！只要輸入選單項目的名稱即可啟動它。"
          }
        }
      }
    },
