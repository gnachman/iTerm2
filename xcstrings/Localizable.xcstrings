    "ScriptImporter.SignatureVerifiedBody" : {
      "comment" : "Message shown when a script archive signature is verified, asking whether to install it",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpis skriptu „%1$@“ byl ověřen. Autor:\n\n%2$@\n\nChcete jej nainstalovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
