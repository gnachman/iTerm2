    "WorkgroupDetail.WhatIsExplanation" : {
      "comment" : "Explanatory markdown shown when the user asks what a Workgroup is",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine **Arbeitsgruppe** verwandelt eine einzelne Sitzung in eine koordinierte Gruppe zusammengehöriger Sitzungen, jede mit eigenem Befehl und eigener Symbolleiste; die vollständige Beschreibung finden Sie in der [Dokumentation zu Arbeitsgruppen](https://iterm2.com/documentation-workgroups.html)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A **Workgroup** turns a single session into a coordinated set of related sessions, each with its own command and toolbar; see the [Workgroups documentation](https://iterm2.com/documentation-workgroups.html) for the full story."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un **grupo de trabajo** convierte una sola sesión en un conjunto coordinado de sesiones relacionadas, cada una con su propio comando y su propia barra de herramientas; consulta la [documentación de grupos de trabajo](https://iterm2.com/documentation-workgroups.html) para conocer todos los detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un **groupe de travail** transforme une session unique en un ensemble coordonné de sessions liées, chacune avec sa propre commande et sa propre barre d’outils. Consultez la [documentation sur les groupes de travail](https://iterm2.com/documentation-workgroups.html) pour en savoir plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un **gruppo di lavoro** trasforma una singola sessione in un insieme coordinato di sessioni correlate, ciascuna con il proprio comando e la propria barra strumenti; consulta la [documentazione sui gruppi di lavoro](https://iterm2.com/documentation-workgroups.html) per tutti i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ワークグループ**は、単一のセッションを、それぞれ独自のコマンドとツールバーを持つ一連の関連セッションへとまとめます。詳しくは[ワークグループのドキュメント](https://iterm2.com/documentation-workgroups.html)をご覧ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**워크그룹**은 단일 세션을 서로 연관된 세션들의 조합으로 바꾸며, 각 세션은 고유한 명령과 도구 막대를 가집니다. 자세한 내용은 [워크그룹 문서](https://iterm2.com/documentation-workgroups.html)를 참조하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um **grupo de trabalho** transforma uma única sessão em um conjunto coordenado de sessões relacionadas, cada uma com seu próprio comando e barra de ferramentas; consulte a [documentação de grupos de trabalho](https://iterm2.com/documentation-workgroups.html) para a história completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Рабочая группа** превращает один сеанс в согласованный набор связанных сеансов, каждый из которых имеет свою команду и панель инструментов; подробности см. в [документации о рабочих группах](https://iterm2.com/documentation-workgroups.html)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir **Çalışma Grubu**, tek bir oturumu, her biri kendi komutuna ve araç çubuğuna sahip, eşgüdümlü ilişkili oturumlar kümesine dönüştürür; tüm ayrıntılar için [Çalışma Grupları belgelerine](https://iterm2.com/documentation-workgroups.html) bakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个**工作组**可以将单个会话转换为一组相关的会话，每个会话都有自己的命令和工具栏；详情请参阅[工作组文档](https://iterm2.com/documentation-workgroups.html))。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**工作群組**可將單一工作階段變成一組互相協調的相關工作階段，每個工作階段都有自己的指令和工具列；詳情請參閱[工作群組文件](https://iterm2.com/documentation-workgroups.html)。"
          }
        }
      }
    },
