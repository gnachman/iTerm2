    "CommandURL.SilentConfirmMessage" : {
      "comment" : "Body of the silent-run confirmation alert. %@ is the command line. Lines naming the user, host, and directory may follow.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Befehl „%@“ ausführen?\nEr wird lautlos im Hintergrund ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Run the command “%@”?\nIt will run silently in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ejecutar el comando “%@”?\nSe ejecutará en segundo plano sin avisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter la commande « %@ » ?\nElle s’exécutera silencieusement en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eseguire il comando “%@”?\nVerrà eseguito in background senza avvisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンド「%@」を実行しますか？\nバックグラウンドでサイレントに実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 명령을 실행하겠습니까?\n백그라운드에서 조용히 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executar o comando “%@”?\nEle será executado silenciosamente em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить команду «%@»?\nОна будет выполнена в фоновом режиме без вывода."
