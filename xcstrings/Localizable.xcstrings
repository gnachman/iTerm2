    "Tip.0000.Body" : {
      "comment" : "Tip of the day body, id 0000",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlavní novinkou iTerm2 verze 3 je integrace shellu. Všechny podrobnosti zjistíte kliknutím na „Další informace“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den store nyhed i iTerm2 version 3 er shell-integration. Klik på “Læs mere” for alle detaljer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die große neue Funktion von iTerm2 Version 3 ist die Shell-Integration. Klicken Sie auf „Mehr erfahren“ für alle Details."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The big new feature of iTerm2 version 3 is Shell Integration. Click “Learn More” for all the details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gran novedad de la versión 3 de iTerm2 es la integración con el shell. Haz clic en “Más información” para ver todos los detalles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:n version 3 suuri uusi ominaisuus on komentotulkki-integraatio. Saat kaikki tiedot klikkaamalla ”Lisätietoja”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grande nouveauté de la version 3 d’iTerm2 est l’intégration du shell. Cliquez sur « En savoir plus » pour tous les détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grande novità di iTerm2 versione 3 è l’integrazione shell. Fai clic su “Ulteriori informazioni” per tutti i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 バージョン 3 の大きな新機能はシェル統合です。詳細については「詳しく見る」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 버전 3의 가장 큰 새 기능은 셸 통합입니다. 자세한 내용은 “더 알아보기”를 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den store nyheten i iTerm2 versjon 3 er skallintegrering. Klikk på «Finn ut mer» for alle detaljene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grote nieuwe functie van iTerm2 versie 3 is shell-integratie. Klik op ‘Meer informatie’ voor alle details."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Największą nowością iTerm2 w wersji 3 jest integracja z powłoką. Kliknij „Więcej informacji”, aby poznać szczegóły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O grande novo recurso da versão 3 do iTerm2 é a Shell Integration. Clique em “Saiba mais” para todos os detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главной новой функцией iTerm2 версии 3 является Shell Integration. Нажмите «Подробнее», чтобы узнать больше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlavnou novinkou iTerm2 verzie 3 je integrácia shellu. Všetky podrobnosti nájdete po kliknutí na „Viac informácií“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glavna novost različice 3 aplikacije iTerm2 je integracija lupine. Za vse podrobnosti kliknite »Več o tem«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den stora nyheten i iTerm2 version 3 är skalintegrering. Klicka på ”Läs mer” för alla detaljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 3. sürümünün en büyük yeniliği Kabuk Entegrasyonu’dur. Tüm ayrıntılar için “Daha Fazla Bilgi”ye tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng mới lớn của iTerm2 phiên bản 3 là Tích hợp shell. Bấm “Tìm hiểu thêm” để xem toàn bộ chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 版本3的全新重要功能是Shell集成。点击“了解更多”可获取所有细节。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 第 3 版的重大新功能是 Shell 整合。按一下「進一步了解」以取得所有詳細資訊。"
          }
        }
      }
