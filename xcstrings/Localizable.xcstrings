    "CodeReviewPromptUpdate.ResetAction" : {
      "comment" : "What updating a code review system prompt that is a copy of an older default does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizace promptu jej nahradí aktuálním výchozím promptem, který pak zůstane aktuální."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater prompt erstatter den med den aktuelle standard, som så holdes opdateret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Prompt aktualisieren“ ersetzt ihn durch den aktuellen Standard, der dann auf dem neuesten Stand bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
