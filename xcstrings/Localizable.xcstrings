    "AdvancedSetting.jiggleTTYSizeOnClearBuffer" : {
      "comment" : "Advanced setting: jiggleTTYSizeOnClearBuffer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm nach Auswahl des Menüpunkts „Puffer leeren“ neu zeichnen.\nWenn aktiviert, wird die TTY-Größe nach dem Leeren des Puffers kurz geändert, damit die Shell oder die aktuelle App neu zeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Redraw the screen after the Clear Buffer menu item is selected.\nWhen enabled, the TTY size is briefly changed after clearing the buffer to cause the shell or current app to redraw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redibujar la pantalla después de seleccionar el elemento de menú Borrar búfer.\nSi se activa, el tamaño de la TTY se cambia brevemente tras borrar el búfer para que el shell o la app actual se redibujen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redessiner l’écran après la sélection de l’élément de menu Effacer le tampon.\nSi cette option est activée, la taille du TTY est brièvement modifiée après l’effacement du tampon pour forcer le shell ou l’app en cours à se redessiner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridisegna lo schermo dopo aver selezionato la voce di menu Cancella buffer.\nSe abilitato, la dimensione del TTY viene cambiata brevemente dopo la cancellazione del buffer per far ridisegnare la shell o l’app corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バッファをクリア」メニュー項目を選択した後、画面を再描画します。\n有効にすると、バッファをクリアした後に TTY のサイズを一時的に変更し、シェルまたは現在のアプリに再描画させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버퍼 지우기 메뉴 항목을 선택한 후 화면을 다시 그립니다.\n켜면 버퍼를 지운 후 TTY 크기를 잠시 변경하여 셸이나 현재 앱이 화면을 다시 그리도록 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesenhar a tela após o item de menu Limpar buffer ser selecionado.\nQuando ativado, o tamanho do TTY é alterado brevemente após limpar o buffer para fazer o shell ou o app atual redesenhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перерисовывать экран после выбора пункта меню «Очистить буфер».\nПри включении размер TTY ненадолго изменяется после очистки буфера, чтобы вызвать перерисовку в оболочке или текущем приложении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arabelleği Temizle menü öğesi seçildikten sonra ekranı yeniden çiz.\nEtkinleştirildiğinde, kabuğun veya geçerli uygulamanın yeniden çizmesini sağlamak için arabellek temizlendikten sonra TTY boyutu kısa süreliğine değiştirilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“清除缓冲区”菜单项后重新绘制屏幕。\n启用后，在清空缓冲区后 TTY 大小会短暂改变，使 shell 或当前应用重新绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取「清除緩衝區」選單項目後重繪螢幕。\n啟用後，清除緩衝區之後會短暫變更 TTY 大小，以促使 shell 或目前的 App 重繪。"
          }
        }
      }
    },
    "AdvancedSetting.keepJobsRunningWhenQuitInstallsUpdate" : {
      "comment" : "Advanced setting: keepJobsRunningWhenQuitInstallsUpdate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs weiterlaufen lassen, wenn iTerm2 zum Installieren eines Software-Updates beendet wird.\nWenn das Beenden von iTerm2 ein heruntergeladenes Update installieren wird (nach der Wahl von „Installieren beim Beenden“ oder wenn das Update bereit zur Installation ist), bleiben laufende Jobs erhalten und werden beim nächsten Start wiederhergestellt, wie bei „Installieren und App neu starten“. Gilt nur, wenn die Sitzungswiederherstellung aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep jobs running when quitting to install a software update.\nWhen quitting iTerm2 will install a downloaded update (after choosing “Install on Quit”, or with the update ready to install), running jobs are left alive so they are restored at the next launch, as happens for “Install and Relaunch”. Applies only when session restoration is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener los procesos en ejecución al salir para instalar una actualización de software.\nCuando al salir iTerm2 va a instalar una actualización descargada (tras elegir “Instalar al salir”, o con la actualización lista para instalar), los procesos en ejecución se dejan activos para restaurarlos en el siguiente inicio, como ocurre con “Instalar y reiniciar”. Solo se aplica cuando la restauración de sesiones está activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder les processus en cours lorsque la fermeture installe une mise à jour.\nLorsque la fermeture d’iTerm2 installe une mise à jour téléchargée (après avoir choisi « Installer à la fermeture », ou avec la mise à jour prête à installer), les processus en cours restent actifs afin d’être restaurés au prochain lancement, comme avec « Installer et relancer ». S’applique uniquement si la restauration des sessions est activée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni in esecuzione i processi quando si esce per installare un aggiornamento software.\nQuando l’uscita da iTerm2 installerà un aggiornamento scaricato (dopo aver scelto “Installa all’uscita” o con l’aggiornamento pronto per l’installazione), i processi in esecuzione restano attivi per essere ripristinati al prossimo avvio, come avviene con “Installa e riapri”. Si applica solo quando il ripristino delle sessioni è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソフトウェアアップデートのインストールのために終了するとき、ジョブを実行したままにします。\niTerm2 の終了によってダウンロード済みのアップデートがインストールされる場合（「終了時にインストール」を選んだ後、またはアップデートのインストール準備ができているとき）、実行中のジョブは終了されず、「インストールして再起動」の場合と同様に次回起動時に復元されます。セッション復元がオンの場合にのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소프트웨어 업데이트를 설치하기 위해 종료할 때 작업을 계속 실행합니다.\niTerm2를 종료하면 다운로드된 업데이트가 설치되는 경우(“종료 시 설치”를 선택한 후 또는 업데이트 설치 준비가 된 상태), 실행 중인 작업이 유지되어 “설치 & 재실행”과 마찬가지로 다음 실행 시 복원됩니다. 세션 복원이 켜져 있을 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter os processos em execução ao encerrar para instalar uma atualização de software.\nQuando encerrar o iTerm2 for instalar uma atualização baixada (depois de escolher “Instalar ao Encerrar” ou com a atualização pronta para instalar), os processos em execução são mantidos para que sejam restaurados na próxima abertura, como acontece com “Instalar e Reabrir”. Aplica-se somente quando a restauração de sessão está ativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставлять задания выполняться при выходе для установки обновления.\nЕсли при выходе из iTerm2 будет установлено загруженное обновление (после выбора «Установить при выходе» или когда обновление готово к установке), выполняющиеся задания не завершаются и восстанавливаются при следующем запуске, как и при «Установить и перезапустить». Применяется только при включённом восстановлении сессий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazılım güncellemesi yüklemek için çıkarken işlemleri çalışır durumda tut.\niTerm2’den çıkarken indirilmiş bir güncelleme yüklenecekse (“Çıkarken Yükle” seçildikten sonra veya güncelleme yüklenmeye hazırsa), çalışan işlemler “Yükle ve Yeniden Başlat”ta olduğu gibi bir sonraki açılışta geri yüklenmek üzere canlı bırakılır. Yalnızca oturum geri yükleme açıkken geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出以安装软件更新时保持作业运行。\n当退出 iTerm2 会安装已下载的更新时（选择“退出应用时安装”后，或更新已准备好安装时），正在运行的作业会保留下来，并在下次启动时恢复，与“安装并重启应用”时相同。仅当会话恢复开启时适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束以安裝軟體更新時，讓程序繼續執行。\niTerm2 結束時若要安裝已下載的更新（選擇「結束時安裝」之後，或更新已可安裝時），執行中的程序會保持存活，以便在下次啟動時回復，就像「安裝並重新開啟」一樣。僅在開啟工作階段回復時適用。"
          }
        }
      }
    },
    "AdvancedSetting.killJobsInServersOnQuit" : {
      "comment" : "Advanced setting: killJobsInServersOnQuit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vom Benutzer ausgelöstes Beenden (⌘Q) von iTerm2 beendet alle laufenden Jobs.\nGilt nur, wenn die Sitzungswiederherstellung aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "User-initiated Quit (⌘Q) of iTerm2 will kill all running jobs.\nApplies only when session restoration is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salir de iTerm2 por iniciativa del usuario (⌘Q) terminará todos los procesos en ejecución.\nSolo se aplica cuando la restauración de sesiones está activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter iTerm2 à la demande de l’utilisateur (⌘Q) tuera tous les processus en cours.\nS’applique uniquement si la restauration des sessions est activée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’uscita da iTerm2 richiesta dall’utente (⌘Q) terminerà tutti i processi in esecuzione.\nSi applica solo quando il ripristino delle sessioni è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーによる iTerm2 の終了 (⌘Q) は、実行中のすべてのジョブを終了させます。\nセッション復元がオンの場合にのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 iTerm2를 종료(⌘Q)하면 실행 중인 모든 작업이 강제 종료됩니다.\n세션 복원이 켜져 있을 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o iTerm2 iniciado pelo usuário (⌘Q) encerrará todos os processos em execução.\nAplica-se somente quando a restauração de sessão está ativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход из iTerm2 по инициативе пользователя (⌘Q) завершит все выполняющиеся задания.\nПрименяется только при включённом восстановлении сессий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı tarafından başlatılan iTerm2’den Çık (⌘Q) tüm çalışan işlemleri sonlandırır.\nYalnızca oturum geri yükleme açıkken geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的用户主动退出 (⌘Q) 会终止所有正在运行的作业。\n仅当会话恢复开启时适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用者主動結束 iTerm2（⌘Q）時，會終止所有執行中的程序。\n僅在開啟工作階段回復時適用。"
          }
        }
      }
    },
    "AdvancedSetting.killSessionsOnLogout" : {
      "comment" : "Advanced setting: killSessionsOnLogout",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen beim Abmelden beenden.\nEine mögliche Lösung für Issue 4147."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill sessions on logout.\nA possible fix for issue 4147."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar las sesiones al cerrar sesión.\nPosible solución al problema 4147."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuer les sessions à la déconnexion.\nUn correctif possible pour le ticket 4147."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
