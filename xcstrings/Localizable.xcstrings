    "PTYSession.PasswordPromptCheck" : {
      "comment" : "Warning asking the user to confirm they are at a password prompt because input appears echoed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu jste na výzvě k zadání hesla? Vypadá to, že se to, co píšete, zobrazuje na obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Står du virkelig ved en adgangskodeprompt? Det ser ud til, at det, du skriver, vises på skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befinden Sie sich wirklich an einem Passwort-Prompt? Es sieht so aus, als würde das, was Sie eingeben, auf dem Bildschirm angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Are you really at a password prompt? It looks like what you're typing is echoed to the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Realmente estás en un prompt de contraseña? Parece que lo que escribes se muestra en pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varmasti salasanakehotteessa? Näyttää siltä, että kirjoittamasi näkyy ruudulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous vraiment à une invite de mot de passe ? Ce que vous saisissez semble s’afficher à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei davvero in un prompt della password? Sembra che ciò che digiti venga mostrato sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当にパスワードプロンプトにいますか？入力内容が画面にエコー表示されているようです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 암호 프롬프트에 있습니까? 입력하는 내용이 화면에 그대로 표시되고 있는 것 같습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du virkelig ved en passordledetekst? Det ser ut til at det du skriver, vises på skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zit je echt bij een wachtwoordprompt? Het lijkt erop dat wat je typt op het scherm wordt weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno jesteś przy znaku zachęty hasła? Wygląda na to, że wpisywany tekst jest widoczny na ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está mesmo em um prompt de senha? Parece que o que você digita está sendo exibido na tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы действительно находитесь в строке ввода пароля? Похоже, вводимые символы отображаются на экране."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste naozaj pri výzve na heslo? Zdá sa, že to, čo píšete, sa zobrazuje na obrazovke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste res pri pozivu za geslo? Videti je, da se tisto, kar vnašate, prikazuje na zaslonu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Står du verkligen vid en lösenordsprompt? Det ser ut som att det du skriver visas på skärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçekten bir parola isteminde misiniz? Yazdığınız şey ekrana yansıtılıyor gibi görünüyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thật sự đang ở dấu nhắc mật khẩu không? Có vẻ những gì bạn gõ đang được hiển thị trên màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你确定在密码提示符处吗？看起来你输入的内容会回显到屏幕上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你真的在密碼提示符號處嗎？看起來你輸入的內容會顯示在螢幕上。"
          }
        }
      }
    },
