    "Tip.0060.Body" : {
      "comment" : "Tip of the day body, id 0060",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud vložíte text obsahující tabulátory, budete dotázáni, zda je chcete převést na mezery. Hodí se to u výzvy shellu, aby se nespouštělo doplňování názvů souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sætter tekst ind, der indeholder tabulatorer, bliver du spurgt, om du vil konvertere dem til mellemrum. Det er praktisk ved shell-prompten for at undgå at udløse fuldførelse af arkivnavne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Text einfügen, der Tabulatoren enthält, werden Sie gefragt, ob diese in Leerzeichen umgewandelt werden sollen. Das ist an der Shell-Eingabeaufforderung praktisch, um eine ungewollte Dateinamenvervollständigung zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you paste text containing tabs, you’ll be asked if you want to convert them to spaces. It’s handy at the shell prompt to avoid triggering filename completion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pegas texto que contiene tabuladores, se te preguntará si quieres convertirlos en espacios. Es útil en el prompt del shell para evitar activar la compleción de nombres de archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sijoitat tekstiä, joka sisältää sarkaimia, sinulta kysytään, haluatko muuntaa ne välilyönneiksi. Se on kätevää komentotulkin kehotteessa, jotta tiedostonimen täydennys ei laukea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous collez du texte contenant des tabulations, on vous demandera si vous souhaitez les convertir en espaces. C’est pratique à l’invite du shell pour éviter de déclencher la complétion des noms de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se incolli testo contenente tabulazioni, ti verrà chiesto se vuoi convertirle in spazi. È utile al prompt della shell per evitare di attivare il completamento dei nomi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブ文字を含むテキストをペーストすると、スペースに変換するかどうか尋ねられます。シェルプロンプトでファイル名補完が誤って発動するのを防ぐのに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭이 포함된 텍스트를 붙여넣으면 탭을 공백으로 변환할지 묻습니다. 셸 프롬프트에서 파일 이름 완성이 실행되지 않도록 할 때 편리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du limer inn tekst som inneholder tabulatorer, blir du spurt om du vil konvertere dem til mellomrom. Det er praktisk ved ledeteksten i skallet for å unngå å utløse fullføring av filnavn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je tekst met tabs plakt, wordt gevraagd of je die naar spaties wilt omzetten. Handig bij de shell-prompt om te voorkomen dat bestandsnamen worden aangevuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli wkleisz tekst zawierający tabulatory, zostaniesz zapytany, czy zamienić je na spacje. To przydatne przy znaku zachęty powłoki, aby uniknąć uruchomienia uzupełniania nazw plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você colar texto com tabulações, será perguntado se deseja convertê-las em espaços. Isso é útil no prompt do shell para evitar acionar o preenchimento automático de nomes de arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы вставляете текст, содержащий табуляции, вас спросят, хотите ли вы преобразовать их в пробелы. Это удобно в приглашении оболочки, чтобы не запускать автодополнение имён файлов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak vložíte text obsahujúci tabulátory, systém sa spýta, či ich chcete previesť na medzery. Hodí sa to pri výzve shellu, aby sa nespustilo dopĺňanie názvov súborov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če prilepite besedilo s tabulatorji, vas bo aplikacija vprašala, ali jih želite pretvoriti v presledke. To je priročno pri ukaznem pozivu lupine, da se izognete sprožitvi dopolnjevanja imen datotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du klistrar in text som innehåller tabbtecken får du frågan om du vill konvertera dem till mellanslag. Det är praktiskt vid skalpromten för att undvika att filnamnskomplettering utlöses."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme karakterleri içeren bir metin yapıştırırsanız bunları boşluğa dönüştürmek isteyip istemediğiniz sorulur. Dosya adı tamamlamayı tetiklememek için kabuk isteminde kullanışlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn dán văn bản chứa ký tự tab, bạn sẽ được hỏi có muốn chuyển chúng thành dấu cách không. Rất tiện ở dấu nhắc shell để tránh kích hoạt hoàn tất tên tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴包含标签页的文本时，系统会询问是否将其转换为空格。在终端提示符下使用此功能可避免触发文件名补全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果貼上的文字包含 Tab 字元，系統會詢問你是否要將它們轉換為空格。這在 shell 提示符號下很方便，可避免觸發檔名自動完成。"
          }
        }
      }
    },
