        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar temporariamente um compositor à barra de status em vez de abrir a visualização grande do compositor quando houver uma barra de status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временно добавлять композитор в строку состояния вместо открытия большого окна композитора, если строка состояния присутствует."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在状态栏存在时，临时添加一个 composer，而不是打开大的 composer视图。"
          }
        }
      }
    },
    "AdvancedSetting.alwaysWarnBeforePastingOverSize" : {
      "comment" : "Advanced setting: alwaysWarnBeforePastingOverSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einfügen von mehr als dieser Anzahl an Zeichen eine Bestätigung verlangen.\nAuf -1 setzen, um die Warnung zu deaktivieren.\nZeichen werden in UTF-16 gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When pasting more than this many characters, require confirmation.\nSet to -1 to disable warning.\nCharacters are counted in UTF-16."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この文字数を超える貼り付けを行う際に確認を必須にする。\n警告を無効にするには-1に設定してください。\n文字数はUTF-16でカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣는 문자 수가 이 값을 넘으면 확인 요구\n경고를 끄려면 -1로 설정하십시오.\n문자 수는 UTF-16 기준으로 셉니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar mais que esta quantidade de caracteres, exigir confirmação.\nDefina como -1 para desativar o aviso.\nOs caracteres são contados em UTF-16."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требовать подтверждение при вставке более указанного числа символов.\nУстановите -1, чтобы отключить предупреждение.\nСимволы подсчитываются в кодировке UTF-16."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当粘贴的字符数超过此数量时，需要确认。\n将值设为 -1 可禁用警告提示。\n字符按 UTF-16 计数。"
          }
        }
      }
    },
    "AdvancedSetting.animateGraphStatusBarComponents" : {
      "comment" : "Advanced setting: animateGraphStatusBarComponents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graphbasierte Statusleisten-Komponenten animieren?\nSchalten Sie dies aus, um die CPU-/GPU-Auslastung in WindowServer zu reduzieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animate graph-based status bar components?\nTurn this off to reduce CPU/GPU usage in WindowServer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフベースのステータスバーコンポーネントをアニメーション表示しますか？\nWindowServerのCPU/GPU使用率を減らすには、これをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래프 기반 상태 막대 구성 요소에 애니메이션을 적용하겠습니까?\nWindowServer의 CPU/GPU 사용량을 줄이려면 이 옵션을 끄십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animar componentes da barra de status baseados em gráfico?\nDesative isso para reduzir o uso de CPU/GPU no WindowServer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимировать компоненты строки состояния на основе графиков?\nОтключите этот параметр, чтобы снизить нагрузку на ЦП/ГП в WindowServer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否对基于图表的状态栏组件进行动画处理？\n关闭此选项以降低 WindowServer 中的 CPU/GPU 使用率。"
          }
        }
      }
    },
