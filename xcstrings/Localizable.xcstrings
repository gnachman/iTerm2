    "PTYSession.FileTransferAbortedOversize" : {
      "comment" : "Warning that a file transfer was aborted for exceeding its declared size",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přenos souboru byl přerušen, protože překročil deklarovanou velikost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En filoverførsel blev afbrudt, fordi den oversteg sin angivne størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Dateiübertragung wurde abgebrochen, da die angegebene Größe überschritten wurde."
          }
