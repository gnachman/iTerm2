    "PTYSession.OSC7DisabledMessage" : {
      "comment" : "Warning that shell integration is broken because the Accept OSC 7 advanced setting is disabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrace shellu v iTerm2 nyní hlásí vaše uživatelské jméno, název hostitele a aktuální adresář pomocí OSC 7, ale pokročilé nastavení „Přijímat OSC 7“ je vypnuto. Integrace shellu nebude správně fungovat, dokud je znovu nezapnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-integrationen i iTerm2 rapporterer nu dit brugernavn, værtsnavn og din aktuelle mappe via OSC 7, men den avancerede indstilling “Accepter OSC 7” er slået fra. Shell-integration fungerer ikke korrekt, før den slås til igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2s Shell-Integration meldet jetzt Ihren Benutzernamen, Hostnamen und das aktuelle Verzeichnis über OSC 7, aber die erweiterte Einstellung „Accept OSC 7“ ist deaktiviert. Die Shell-Integration funktioniert erst wieder richtig, wenn sie erneut aktiviert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2’s shell integration now reports your username, hostname, and current directory using OSC 7, but the “Accept OSC 7” advanced setting is turned off. Shell integration will not work correctly until it is turned back on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con el shell de iTerm2 ahora informa de tu nombre de usuario, nombre de host y directorio actual mediante OSC 7, pero el ajuste avanzado “Aceptar OSC 7” está desactivado. La integración con el shell no funcionará correctamente hasta que lo vuelvas a activar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:n komentotulkki-integraatio raportoi nyt käyttäjätunnuksesi, palvelinnimesi ja nykyisen hakemistosi OSC 7:n avulla, mutta lisäasetus ”Hyväksy OSC 7” on poistettu käytöstä. Komentotulkki-integraatio ei toimi oikein, ennen kuin asetus laitetaan takaisin päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration du shell d’iTerm2 signale désormais votre nom d’utilisateur, votre nom d’hôte et le répertoire actuel via OSC 7, mais le réglage avancé « Accept OSC 7 » est désactivé. L’intégration du shell ne fonctionnera pas correctement tant qu’il ne sera pas réactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione shell di iTerm2 ora segnala nome utente, nome host e directory corrente tramite OSC 7, ma l’impostazione avanzata “Accetta OSC 7” è disattivata. L’integrazione shell non funzionerà correttamente finché non la riattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 のシェル統合は、ユーザー名、ホスト名、現在のディレクトリを OSC 7 を使って報告するようになりましたが、詳細設定「Accept OSC 7」がオフになっています。オンに戻すまで、シェル統合は正しく動作しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 iTerm2의 셸 통합은 OSC 7을 사용하여 사용자 이름, 호스트 이름, 현재 디렉토리를 보고하지만 “OSC 7 허용” 고급 설정이 꺼져 있습니다. 이 설정을 다시 켤 때까지 셸 통합이 제대로 작동하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skallintegreringen i iTerm2 rapporterer nå brukernavn, vertsnavn og gjeldende mappe via OSC 7, men den avanserte innstillingen «Godta OSC 7» er slått av. Skallintegreringen fungerer ikke riktig før den slås på igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Shell-integratie van iTerm2 geeft je gebruikersnaam, hostnaam en huidige map nu door met OSC 7, maar de geavanceerde instelling ‘Accept OSC 7’ staat uit. Shell-integratie werkt niet goed totdat deze weer is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracja iTerm2 z powłoką raportuje teraz nazwę użytkownika, nazwę hosta i bieżący katalog przez OSC 7, ale zaawansowane ustawienie „Akceptuj OSC 7” jest wyłączone. Integracja z powłoką nie będzie działać poprawnie, dopóki go nie włączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A integração de shell do iTerm2 agora relata seu nome de usuário, nome do host e diretório atual usando OSC 7, mas a configuração avançada “Accept OSC 7” está desativada. A integração de shell não funcionará corretamente até ser reativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеграция с оболочкой iTerm2 теперь передаёт ваше имя пользователя, имя хоста и текущий каталог через OSC 7, но расширенная настройка «Accept OSC 7» отключена. Интеграция с оболочкой не будет работать правильно, пока её снова не включить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrácia shellu iTerm2 teraz hlási vaše užívateľské meno, názov hostiteľa a aktuálny adresár pomocou OSC 7, ale rozšírené nastavenie „Prijímať OSC 7 na nastavenie užívateľského mena, názvu hostiteľa a cesty“ je vypnuté. Integrácia shellu nebude fungovať správne, kým ho znova nezapnete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracija lupine v aplikaciji iTerm2 zdaj sporoča vaše uporabniško ime, ime gostitelja in trenutni imenik prek OSC 7, vendar je napredna nastavitev »Sprejmi OSC 7« izklopljena. Integracija lupine ne bo pravilno delovala, dokler je ne znova vklopite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:s skalintegrering rapporterar nu ditt användarnamn, värdnamn och aktuella katalog med OSC 7, men den avancerade inställningen ”Acceptera OSC 7” är avstängd. Skalintegreringen fungerar inte korrekt förrän den slås på igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin Kabuk Entegrasyonu artık kullanıcı adınızı, ana makine adınızı ve geçerli dizini OSC 7 ile bildiriyor, ancak “OSC 7’yi Kabul Et” gelişmiş ayarı kapalı. Yeniden açılana kadar Kabuk Entegrasyonu düzgün çalışmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tích hợp shell của iTerm2 hiện báo cáo tên người dùng, tên máy chủ và thư mục hiện tại của bạn bằng OSC 7, nhưng cài đặt nâng cao “Chấp nhận OSC 7” đang tắt. Tích hợp shell sẽ không hoạt động đúng cho đến khi bạn bật lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Shell 集成现在使用 OSC 7 报告您的用户名、主机名和当前目录，但高级设置“Accept OSC 7”已关闭。在重新开启之前，Shell 集成将无法正常工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Shell 整合現在使用 OSC 7 回報你的使用者名稱、主機名稱和目前目錄，但進階設定「Accept OSC 7」已關閉。重新開啟之前，Shell 整合將無法正常運作。"
          }
        }
      }
    },
