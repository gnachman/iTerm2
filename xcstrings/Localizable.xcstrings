        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricare le impostazioni dall’URL? Alcune modifiche apportate alla copia locale andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL から設定を読み込みますか？ローカルコピーへの変更が失われます。"
