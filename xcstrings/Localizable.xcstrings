    "AdvancedSetting.statusBarHeight" : {
      "comment" : "Advanced setting: statusBarHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výška stavového řádku v bodech.\nOvlivní to také výšku záhlaví jednotlivých podoken, protože v nich může být stavový řádek vložen. Chcete-li změnu tohoto nastavení uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højde på statuslinjen i punkter.\nDette påvirker også højden på titellinjerne for hver rude, da statuslinjen kan være indlejret i dem. Du skal starte iTerm2 igen efter ændring af denne indstilling, for at den træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe der Statusleiste in Punkten.\nDies wirkt sich auch auf die Höhe der Titelleisten pro Bereich aus, da die Statusleiste darin eingebettet sein kann. Sie müssen iTerm2 nach Ändern dieser Einstellung neu starten, damit sie wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Height of the status bar in points.\nThis will also affect the height of per-pane title bars becuase the status bar may be embedded in it. You must restart iTerm2 after changing this setting for it to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura de la barra de estado en puntos.\nTambién afectará a la altura de las barras de título de cada panel, porque la barra de estado puede estar incrustada en ellas. Debes reiniciar iTerm2 tras cambiar este ajuste para que surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilapalkin korkeus pisteinä.\nTämä vaikuttaa myös paneelikohtaisten otsikkopalkkien korkeuteen, koska tilapalkki voi olla upotettu niihin. Sinun on käynnistettävä iTerm2 uudelleen tämän asetuksen muuttamisen jälkeen, jotta se tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur de la barre d’état en points.\nCela affecte aussi la hauteur des barres de titre de chaque volet, car la barre d’état peut y être intégrée. Vous devez redémarrer iTerm2 après avoir modifié ce réglage pour qu’il prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza della barra di stato in punti.\nInfluirà anche sull’altezza delle barre del titolo dei singoli riquadri, perché la barra di stato può essere incorporata al loro interno. Devi riavviare iTerm2 dopo aver modificato questa impostazione affinché abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーの高さ（ポイント単位）。\nステータスバーがペインごとのタイトルバーに埋め込まれることがあるため、これは各ペインのタイトルバーの高さにも影響します。この設定の変更を反映させるにはiTerm2を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대 높이(포인트)\n상태 막대가 패널별 제목 막대에 포함될 수 있으므로 패널별 제목 막대의 높이에도 영향을 줍니다. 이 설정의 변경 사항을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyden på statuslinjen i punkter.\nDette påvirker også høyden på tittellinjene til rutene, siden statuslinjen kan være innebygd i dem. Du må starte iTerm2 på nytt etter at du har endret denne innstillingen for at den skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoogte van de statusbalk in punten.\nDit beïnvloedt ook de hoogte van de titelbalken per paneel, omdat de statusbalk erin kan zijn ingebed. Je moet iTerm2 herstarten na het wijzigen van deze instelling om die te laten ingaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysokość paska stanu w punktach.\nWpłynie to też na wysokość pasków tytułu poszczególnych paneli, ponieważ pasek stanu może być w nich osadzony. Aby zmiana tego ustawienia zaczęła działać, musisz uruchomić ponownie iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura da barra de status em pontos.\nIsso também afetará a altura das barras de título por painel porque a barra de status pode estar embutida nela. Você deve reiniciar o iTerm2 após alterar este ajuste para que ele tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота строки состояния в пунктах.\nЭто также повлияет на высоту заголовков панелей, так как строка состояния может быть встроена в них. Чтобы изменение этого параметра вступило в силу, необходимо перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výška stavovej lišty v bodoch.\nOvplyvní to aj výšku líšt s názvom jednotlivých panelov, pretože stavová lišta v nich môže byť vložená. Zmeny tohto nastavenia sa prejavia až po reštartovaní iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Višina vrstice stanja v točkah.\nTo vpliva tudi na višino naslovnih vrstic podoken, ker je vrstica stanja lahko vgrajena vanje. Po spremembi te nastavitve morate za uveljavitev znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusfältets höjd i punkter.\nDet påverkar också höjden på titelfälten för varje panel eftersom statusfältet kan vara inbäddat i dem. Du måste starta om iTerm2 efter att ha ändrat den här inställningen för att den ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum çubuğunun punto cinsinden yüksekliği.\nDurum çubuğu bölme başlık çubuklarına gömülebileceğinden bunların yüksekliğini de etkiler. Bu ayarı değiştirdikten sonra etkili olması için iTerm2’yi yeniden başlatmanız gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều cao của thanh trạng thái, tính bằng point.\nĐiều này cũng ảnh hưởng đến chiều cao thanh tiêu đề của từng khung vì thanh trạng thái có thể được nhúng trong đó. Bạn phải khởi động lại iTerm2 sau khi thay đổi cài đặt này để nó có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态栏的高度（单位：点）。\n这也会影响每个窗格标题栏的高度，因为状态栏可能嵌入其中。更改此设置后必须重启iTerm2才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "狀態列的高度，以點為單位。\n這也會影響各窗格標題列的高度，因為狀態列可能嵌入其中。變更此設定後必須重新啟動 iTerm2 才會生效。"
          }
        }
      }
    },
    "AdvancedSetting.statusBarIcon" : {
      "comment" : "Advanced setting: statusBarIcon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidat ikonu ve stavovém řádku, když je aplikace vyloučena z Docku?\nKdyž zapnete „Vyloučit z Docku a přepínače aplikací ⌘-Tab“, do řádku nabídek se přidá ikona, abyste mohli nastavení vypnout. Vypnutím ikonu odeberete. Pak je velmi obtížné se dostat do Nastavení. Chcete-li změnu tohoto nastavení uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj statuslinjesymbol, når appen er udeladt fra Dock?\nNår du slår “Udelad fra Dock og programvælgeren med ⌘-Tabulator” til, føjes et symbol til menulinjen, så du kan slå indstillingen fra igen. Slå dette fra for at fjerne symbolet. Det gør det meget svært at komme til Indstillinger. Du skal starte iTerm2 igen efter ændring af denne indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusleistensymbol hinzufügen, wenn aus dem Dock ausgeschlossen?\nWenn Sie „Aus Dock und ⌘-Tab-Anwendungswechsler ausschließen“ aktivieren, wird der Menüleiste ein Statusleistensymbol hinzugefügt, damit Sie die Einstellung wieder ausschalten können. Deaktivieren Sie dies, um das Statusleistensymbol zu entfernen. Dadurch wird der Zugriff auf die Einstellungen sehr erschwert. Sie müssen iTerm2 nach Ändern dieser Einstellung neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add status bar icon when excluded from dock?\nWhen you turn on “Exclude from Dock and ⌘-Tab Application Switcher” a status bar icon is added to the menu bar so you can switch the setting back off. Disable this to remove the status bar icon. Doing so makes it very hard to get to Settings. You must restart iTerm2 after changing this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Añadir un icono de barra de estado cuando se excluye del Dock?\nCuando activas “Excluir del Dock y del selector de apps” se añade un icono a la barra de menús para que puedas volver a desactivar el ajuste. Desactiva esto para quitar el icono. Hacerlo dificulta mucho llegar a Ajustes. Debes reiniciar iTerm2 tras cambiar este ajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisätäänkö tilapalkin kuvake, kun Dockista on poistettu?\nKun otat käyttöön ”Jätä pois Dockista ja ⌘-Tab-sovelluskytkimestä”, valikkoriville lisätään kuvake, jotta voit laittaa asetuksen takaisin pois päältä. Poista tämä käytöstä poistaaksesi kuvakkeen. Se vaikeuttaa Asetuksiin pääsyä huomattavasti. Sinun on käynnistettävä iTerm2 uudelleen tämän asetuksen muuttamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter une icône à la barre d’état lorsque l’app est exclue du Dock ?\nLorsque vous activez « Exclure du Dock et du sélecteur d’apps ⌘-Tab », une icône est ajoutée à la barre des menus pour que vous puissiez désactiver ce réglage. Désactivez cette option pour supprimer l’icône. Il sera alors très difficile d’accéder aux Réglages. Vous devez redémarrer iTerm2 après avoir modifié ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungere un’icona di stato quando escluso dal Dock?\nQuando attivi “Escludi dal Dock e dal selettore app ⌘-Tab”, nella barra dei menu viene aggiunta un’icona di stato per poter disattivare di nuovo l’impostazione. Disattiva questa opzione per rimuovere l’icona. Farlo rende molto difficile raggiungere le Impostazioni. Devi riavviare iTerm2 dopo aver modificato questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockから除外されているときにステータスバーアイコンを追加するか？\n「DockおよびCmd-Tabアプリケーションスイッチャーから除外する」を有効にすると、メニューバーにステータスバーアイコンが追加され、その設定を再びオフに戻せるようになります。これを無効にするとステータスバーアイコンが削除されます。その場合、設定にアクセスするのが非常に難しくなります。この設定の変更を反映させるにはiTerm2を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock에서 제외되었을 때 상태 막대 아이콘을 추가하겠습니까?\n“Dock 및 ⌘-Tab 응용 프로그램 전환기에서 제외”를 켜면 설정을 다시 끌 수 있도록 메뉴 막대에 상태 막대 아이콘이 추가됩니다. 상태 막대 아이콘을 제거하려면 이 옵션을 비활성화하십시오. 그러면 설정에 접근하기가 매우 어려워집니다. 이 설정을 변경한 후에는 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til statuslinjesymbol når appen er utelatt fra Dock?\nNår du slår på «Utelat fra Dock og programveksleren (med ⌘-Tab)», legges det til et symbol i menylinjen slik at du kan slå innstillingen av igjen. Deaktiver dette for å fjerne symbolet. Da blir det svært vanskelig å komme til Innstillinger. Du må starte iTerm2 på nytt etter at du har endret denne innstillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een statusbalksymbool toevoegen wanneer de app niet in het Dock staat?\nWanneer je ‘Sluit uit van Dock en de appkiezer met ⌘-Tab’ inschakelt, wordt een symbool aan de menubalk toegevoegd zodat je de instelling weer kunt uitschakelen. Schakel dit uit om het symbool te verwijderen. Daardoor is het erg lastig om bij Instellingen te komen. Je moet iTerm2 herstarten na het wijzigen van deze instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy dodawać ikonę na pasku menu, gdy aplikacja jest wykluczona z Docka?\nPo włączeniu „Wyklucz z Docka i przełącznika aplikacji ⌘-Tab” na pasku menu pojawia się ikona, dzięki której możesz ponownie wyłączyć to ustawienie. Wyłącz tę opcję, aby usunąć ikonę. Bardzo utrudni to dostęp do Ustawień. Po zmianie tego ustawienia musisz uruchomić ponownie iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar ícone na barra de menus quando excluído do Dock?\nQuando você ativa “Excluir do Dock e do alternador de aplicativos ⌘-Tab”, um ícone é adicionado à barra de menus para que você possa desativar o ajuste novamente. Desative isto para remover o ícone. Fazer isso torna muito difícil chegar aos Ajustes. Você deve reiniciar o iTerm2 após alterar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлять значок в строку меню, когда приложение исключено из Dock?\nПри включении параметра «Исключить из Dock и переключателя приложений ⌘-Tab» в строку меню добавляется значок, позволяющий снова выключить этот параметр. Отключите это, чтобы убрать значок из строки меню. При этом получить доступ к настройкам станет очень сложно. Чтобы изменение этого параметра вступило в силу, необходимо перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridať ikonu do lišty, keď je aplikácia vylúčená z Docku?\nKeď zapnete „Vylúčiť z Docku a prepínača aplikácií ⌘-Tab“, do lišty menu sa pridá ikona, aby ste mohli nastavenie opäť vypnúť. Vypnutím ikonu odstránite. Tým sa veľmi sťaží prístup k Nastaveniam. Po zmene tohto nastavenia musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se doda ikona vrstice stanja, ko je aplikacija izključena iz vrstice Dock?\nKo vklopite »Izključi iz vrstice Dock in preklopnika aplikacij ⌘-Tab«, se v menijsko vrstico doda ikona, s katero lahko nastavitev spet izklopite. Onemogočite za odstranitev te ikone. S tem je zelo težko priti do Nastavitev. Po spremembi te nastavitve morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägga till statusfältssymbol när appen är utesluten från Dock?\nNär du slår på ”Uteslut från Dock och programväljaren med ⌘-tabb” läggs en statusfältssymbol till i menyraden så att du kan slå av inställningen igen. Avaktivera det här för att ta bort statusfältssymbolen. Då blir det mycket svårt att komma åt Inställningar. Du måste starta om iTerm2 efter att ha ändrat den här inställningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock’tan hariç tutulduğunda durum çubuğu simgesi eklensin mi?\n“Dock’tan ve ⌘-Tab uygulama değiştiricisinden hariç tut” seçeneğini açtığınızda ayarı geri kapatabilmeniz için menü çubuğuna bir durum çubuğu simgesi eklenir. Simgeyi kaldırmak için bunu devre dışı bırakın. Bunu yapmak Ayarlar’a ulaşmayı çok zorlaştırır. Bu ayarı değiştirdikten sonra iTerm2’yi yeniden başlatmanız gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm biểu tượng thanh trạng thái khi bị loại khỏi Dock?\nKhi bạn bật “Loại khỏi Dock và bộ chuyển ứng dụng ⌘-Tab”, một biểu tượng thanh trạng thái được thêm vào thanh menu để bạn có thể tắt lại cài đặt. Tắt tùy chọn này để bỏ biểu tượng đó. Làm vậy sẽ rất khó truy cập Cài đặt. Bạn phải khởi động lại iTerm2 sau khi thay đổi cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当被排除在 Dock 中时，是否应添加状态栏图标？  \n当开启“从 Dock 排除并使用 ⌘-Tab 应用切换器”时，状态栏图标会添加到菜单栏中，以便您取消此设置。禁用该选项即可移除状态栏图标，但这样会使“设置”界面难以访问，更改后必须重启 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排除於 Dock 之外時，加入狀態列圖像？\n當你開啟「從 Dock 與 ⌘-Tab App 切換器中排除」時，選單列會加入一個狀態列圖像，讓你可以將該設定改回關閉。停用此項可移除狀態列圖像，但這樣會很難進入「設定」。變更此設定後必須重新啟動 iTerm2。"
          }
        }
      }
    },
    "AdvancedSetting.stealKeyFocus" : {
      "comment" : "Advanced setting: stealKeyFocus",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto „Fokus následuje myš“, převzít fokus klávesnice i při neaktivní aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når “Fokus følger musen” er slået til, tag tastaturfokus, selv når appen er inaktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Fokus folgt der Maus“ aktiviert ist, den Tastaturfokus auch dann übernehmen, wenn inaktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Focus Follows Mouse is enabled, steal key focus even when inactive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el foco sigue al ratón está activado, roba el foco del teclado incluso cuando está inactivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ”Kohdistus seuraa hiirtä” on käytössä, kaappaa näppäimistökohdistus myös silloin, kun ei ole aktiivinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque Le focus suit la souris est activé, prendre le focus clavier même si l’app est inactive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Il focus segue il mouse” è attivo, prendi il focus della tastiera anche quando inattivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus Follows Mouseが有効な場合、非アクティブでもキーフォーカスを奪う。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘포커스가 마우스를 따라감’이 켜져 있으면 비활성 상태일 때도 키 포커스를 가져옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Fokus følger musen er aktivert, ta tastaturfokus selv når appen er inaktiv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer Focus volgt muis is ingeschakeld, neem dan de toetsenbordfocus over, ook als de app inactief is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy „Fokus podąża za myszą” jest włączony, przejmuj fokus klawiatury nawet w stanie nieaktywnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “O foco segue o mouse” estiver ativado, roubar o foco do teclado mesmo quando inativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включена функция «Фокус следует за мышью» (Focus Follows Mouse), перехватывать фокус ввода, даже если приложение неактивно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté Fokus nasleduje myš, získať fokus klávesnice aj vtedy, keď je aplikácia neaktívna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je vklopljeno Fokus sledi miški, prevzemi fokus tipkovnice tudi, ko aplikacija ni dejavna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När Fokus följer musen är aktiverat, ta tangentbordsfokus även när appen är inaktiv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Odak fareyi izlesin” etkinken, uygulama etkin olmasa bile klavye odağını al."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật Tiêu điểm theo chuột, giành tiêu điểm bàn phím ngay cả khi không hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当“焦点跟随鼠标”功能启用时，即使未激活，也能窃取键盘焦点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「焦點跟隨滑鼠」時，即使在非使用中也搶佔按鍵焦點。"
          }
        }
      }
    },
