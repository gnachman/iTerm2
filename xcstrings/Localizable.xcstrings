    "Cockpit.GroupByStatusTooltip" : {
      "comment" : "Tooltip for the group-by-status option in the cockpit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seskupit relace podle stavu (Čeká / Pracuje / Nečinná) v rámci každého okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupper sessioner efter status (Venter / Arbejder / Passiv) inden for hvert vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen nach Status gruppieren (Wartet / Arbeitet / Inaktiv), innerhalb jedes Fensters."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Group sessions by status (Waiting / Working / Idle), within each window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupar sesiones por estado (En espera / Trabajando / Inactiva), dentro de cada ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmittele istunnot tilan mukaan (Odottaa / Työstää / Toimeton) kunkin ikkunan sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grouper les sessions par état (en attente / en cours / inactif), dans chaque fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppa le sessioni per stato (In attesa / In corso / Inattivo), all’interno di ogni finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ウインドウ内で、セッションをステータス（待機中 / 作業中 / アイドル）別にグループ化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 윈도우 내에서 세션을 상태별로 그룹화합니다(대기 중 / 작업 중 / 유휴)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupper økter etter status (Venter / Jobber / Inaktiv), innenfor hvert vindu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groepeer sessies op status (Wachtend / Bezig / Inactief), binnen elk venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupuj sesje według stanu (Oczekuje / Pracuje / Bezczynna) w obrębie każdego okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupar sessões por status (Aguardando / Trabalhando / Ocioso), dentro de cada janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группировать сессии по статусу (Ожидание / Работает / Простаивает) в пределах каждого окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoskupiť relácie podľa stavu (Čaká / Pracuje / Nečinná) v rámci každého okna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Združi seje po stanju (Čaka / Dela / Nedejavno) znotraj vsakega okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppera sessioner efter status (Väntar / Arbetar / Inaktiv) inom varje fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumları her pencerenin içinde duruma göre grupla (Bekliyor / Çalışıyor / Boşta)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhóm các phiên theo trạng thái (Đang chờ / Đang làm việc / Không hoạt động), trong từng cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个窗口内，按状态（等待 / 工作中 / 空闲）分组会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每個視窗內，依狀態（等待中／處理中／閒置）將工作階段分組。"
          }
        }
      }
    },
