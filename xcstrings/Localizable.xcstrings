    "ScriptsMenu.TakingTooLong" : {
      "comment" : "Warning shown when enumerating the scripts folder takes too long",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledání všech skriptů v umístění %@ trvá dlouho. Nevyužívejte pro složku skriptů mnoho souborů ani síťové svazky.\n\nPokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tager lang tid at finde alle instrukser under %@. Undgå at gemme mange arkiver eller bruge netværksmonteringer til instruksmappen.\n\nVil du fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Suchen aller Skripte unter %@ dauert sehr lange. Vermeiden Sie es, viele Dateien zu speichern oder Netzwerklaufwerke für den Skripte-Ordner zu verwenden.\n\nFortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is taking a long time to locate all scripts under %@. Avoid storing many files or using network mounts for the scripts folder.\n\nContinue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está tardando mucho en localizar todos los scripts en %@. Evita almacenar muchos archivos o usar volúmenes de red para la carpeta de scripts.\n\n¿Continuar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikkien skriptien etsiminen sijainnista %@ kestää kauan. Vältä tallentamasta skriptikansioon paljon tiedostoja tai käyttämästä verkkolevyjä.\n\nJatketaanko?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche de tous les scripts dans %@ prend beaucoup de temps. Évitez de stocker de nombreux fichiers ou d’utiliser des montages réseau pour le dossier des scripts.\n\nContinuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci vuole molto tempo per individuare tutti gli script in %@. Evita di salvare molti file o di usare volumi di rete per la cartella degli script.\n\nContinuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以下のすべてのスクリプトを検出するのに時間がかかっています。スクリプトフォルダに多数のファイルを保存したり、ネットワークマウントを使用したりしないでください。\n\n続行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 아래의 모든 스크립트를 찾는 데 오래 걸리고 있습니다. 스크립트 폴더에 많은 파일을 저장하거나 네트워크 마운트를 사용하지 마십시오.\n\n계속하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tar lang tid å finne alle skript under %@. Unngå å lagre mange filer eller bruke nettverksvolumer for skriptmappen.\n\nVil du fortsette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het duurt lang om alle scripts in %@ te vinden. Vermijd het bewaren van veel bestanden of het gebruik van netwerkvolumes voor de scriptmap.\n\nDoorgaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlokalizowanie wszystkich skryptów w %@ trwa długo. Unikaj przechowywania wielu plików lub używania zasobów sieciowych dla folderu skryptów.\n\nKontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está demorando muito para localizar todos os scripts em %@. Evite armazenar muitos arquivos ou usar montagens de rede na pasta de scripts.\n\nContinuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск всех скриптов в %@ занимает много времени. Избегайте хранения большого числа файлов или использования сетевых дисков для папки скриптов.\n\nПродолжить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhľadanie všetkých skriptov v umiestnení %@ trvá dlho. Vyhnite sa ukladaniu veľkého počtu súborov alebo používaniu sieťových zväzkov pre priečinok so skriptami.\n\nPokračovať?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iskanje vseh skriptov v %@ traja dolgo. Ne shranjujte veliko datotek in ne uporabljajte omrežnih nosilcev za mapo skriptov.\n\nŽelite nadaljevati?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det tar lång tid att hitta alla skript under %@. Undvik att lagra många filer eller använda nätverksvolymer för skriptmappen.\n\nVill du fortsätta?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ altındaki tüm betikleri bulmak uzun sürüyor. Betik klasörü için çok sayıda dosya saklamaktan veya ağ bağlama noktaları kullanmaktan kaçının.\n\nDevam edilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc xác định vị trí tất cả tập lệnh trong %@ đang mất nhiều thời gian. Hãy tránh lưu nhiều tệp hoặc dùng ổ đĩa mạng cho thư mục tập lệnh.\n\nTiếp tục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位 %@ 下的所有脚本耗时较长。避免在脚本文件夹中存储大量文件或使用网络挂载。\n\n继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋找 %@ 下的所有腳本花費了很長的時間。請避免在腳本檔案夾中存放大量檔案或使用網路掛載。\n\n要繼續嗎？"
          }
        }
      }
    },
