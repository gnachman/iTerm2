          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ťahanie obrázkov alebo vybraného textu musíte držať ⌘. Zabráni sa tak náhodnému ťahaniu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za vlečenje slik ali izbranega besedila morate držati ⌘. Tako se prepreči nenamerno vlečenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att dra bilder eller markerad text måste du hålla ned ⌘. Det förhindrar oavsiktliga dragningar."
