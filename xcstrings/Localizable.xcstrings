    "ToolStatus.SnoozeButtonTooltipSnooze" : {
      "comment" : "Tooltip for the snooze button when a session is selected and can be snoozed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versetzt die ausgewählte Sitzung in den Schlummerzustand, sodass sie ans Ende der Liste rutscht und abgedunkelt wird, bis sich ihr Status ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Snooze the selected session so it sinks to the bottom of the list and dims until its status changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pospón la sesión seleccionada para que baje al final de la lista y se atenúe hasta que cambie su estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez la session sélectionnée pour qu’elle descende en bas de la liste et soit estompée jusqu’à ce que son état change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posticipa la sessione selezionata: scende in fondo all’elenco e viene attenuata finché il suo stato non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したセッションをスヌーズすると、リストの最後に移動し、ステータスが変化するまで薄暗く表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 세션을 다시 알림으로 설정하여 상태가 바뀔 때까지 목록 맨 아래로 내리고 흐리게 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adie a sessão selecionada para que ela afunde para o fim da lista e escureça até que seu status mude."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложить выбранный сеанс, чтобы он опустился в конец списка и был затемнён до изменения его статуса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili oturumu ertele; durumu değişene kadar listenin en altına iner ve soluklaşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停所选会话，使其沉在列表底部并变暗直至状态变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對所選工作階段稍後提醒，讓它移到列表底部並調暗，直到狀態變更為止。"
          }
        }
      }
    },
