    "Tip.0063.Body" : {
      "comment" : "Tip of the day body, id 0063",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Online-Farbgalerie bietet über hundert wunderschöne Farbschemata zum Herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The online color gallery features over one hundred beautiful color schemes you can download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galería de colores en línea ofrece más de cien hermosos esquemas de colores que puedes descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galerie de couleurs en ligne propose plus d’une centaine de magnifiques jeux de couleurs à télécharger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galleria di colori online offre oltre cento splendide combinazioni di colori che puoi scaricare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインカラーギャラリーには、ダウンロードできる100種類以上の美しいカラースキームが用意されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 색상 갤러리에는 다운로드할 수 있는 아름다운 색상 구성표가 100개 넘게 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A galeria de cores on-line oferece mais de cem belos esquemas de cores que você pode transferir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В онлайн-галерее цветов представлено более ста прекрасных цветовых схем, которые можно загрузить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimiçi renk galerisi, indirebileceğiniz yüzden fazla güzel renk şeması sunar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该在线颜色图库提供超过一百种精美的颜色方案，可供下载使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線上配色圖庫提供超過一百種精美的配色供你下載。"
          }
        }
      }
    },
