    "Tip.0035.Body" : {
      "comment" : "Tip of the day body, id 0035",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud do štítku profilu vložíte lomítko, implicitně tím definujete hierarchii. V nabídce Profily ji uvidíte jako vnořené podnabídky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sætter en skråstreg i en profils tag, definerer det implicit et hierarki. Du kan se det i menuen Profiler som indlejrede undermenuer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie in den Tag eines Profils einen Schrägstrich einfügen, wird dadurch implizit eine Hierarchie festgelegt. Diese sehen Sie im Profile-Menü als verschachtelte Untermenüs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you put a slash in a profile’s tag, that implicitly defines a hierarchy. You can see it in the Profiles menu as nested submenus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pones una barra en la etiqueta de un perfil, eso define implícitamente una jerarquía. Puedes verla en el menú Perfiles como submenús anidados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos lisäät profiilin tunnisteeseen vinoviivan, se määrittää implisiittisesti hierarkian. Näet sen Profiilit-valikossa sisäkkäisinä alivalikkoina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous placez une barre oblique dans le tag d’un profil, cela définit implicitement une hiérarchie. Vous la voyez dans le menu Profils sous forme de sous-menus imbriqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inserisci una barra nel tag di un profilo, questo definisce implicitamente una gerarchia. La vedi nel menu Profili come sottomenu annidati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルのタグにスラッシュを入れると、暗黙的に階層が定義されます。これはプロファイルメニューに入れ子になったサブメニューとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일 태그에 슬래시를 넣으면 계층 구조가 암묵적으로 정의됩니다. 프로파일 메뉴에서 중첩된 하위 메뉴로 확인할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du setter en skråstrek i etiketten til en profil, definerer det implisitt et hierarki. Du ser det i Profiler-menyen som nestede undermenyer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een schuine streep in de tag van een profiel zet, definieert dat impliciet een hiërarchie. Je ziet die in het menu Profielen als geneste submenu’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli umieścisz ukośnik w tagu profilu, domyślnie definiuje to hierarchię. Zobaczysz ją w menu Profile jako zagnieżdżone podmenu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você colocar uma barra na tag de um perfil, isso define implicitamente uma hierarquia. Você pode vê-la no menu Perfis como submenus aninhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вставить в тег профиля косую черту, это неявно задаёт иерархию. Её можно увидеть в меню «Профили» в виде вложенных подменю."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak do tagu profilu vložíte lomku, implicitne tým definujete hierarchiu. V menu Profily ju uvidíte ako vnorené podmenu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če v oznako profila vstavite poševnico, to implicitno določi hierarhijo. V meniju Profili jo vidite kot ugnezdene podmenije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du sätter ett snedstreck i en profils tagg definierar det implicit en hierarki. Du ser den i menyn Profiler som kapslade undermenyer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir profilin etiketine eğik çizgi koyarsanız bu örtük olarak bir hiyerarşi tanımlar. Bunu Profiller menüsünde iç içe alt menüler olarak görebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đặt một dấu gạch chéo trong thẻ của hồ sơ, điều đó ngầm định nghĩa một cấp bậc. Bạn có thể thấy nó trong menu Hồ sơ dưới dạng các menu con lồng nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在配置文件的标签中加上斜杠，则隐含了层级关系。在“Profiles”菜单中可以看到嵌套的子菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在描述檔的標籤中加入斜線，就會隱含地定義出階層。你可以在「描述檔」選單中看到巢狀的子選單。"
          }
        }
      }
    },
