    "Appearance.ExcludeFromDockWarning" : {
      "comment" : "Warning shown when the user excludes iTerm2 from the Dock and app switcher",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je iTerm2 vyloučen z Docku, do Nastavení se vždy dostanete pomocí položky ve stavovém řádku. Hledejte ikonu iTerm2 na pravé straně řádku nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når iTerm2 er udeladt fra Dock, kan du altid vende tilbage til Indstillinger via statuslinjesymbolet. Se efter et iTerm2-symbol i højre side af menulinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn iTerm2 aus dem Dock ausgeschlossen ist, können Sie über das Statusleistensymbol jederzeit zu den Einstellungen zurückkehren. Suchen Sie nach einem iTerm2-Symbol auf der rechten Seite Ihrer Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When iTerm2 is excluded from the dock, you can always get back to Preferences using the status bar item. Look for an iTerm2 icon on the right side of your menu bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando iTerm2 se excluye del Dock, siempre puedes volver a Ajustes mediante el ítem de la barra de estado. Busca un icono de iTerm2 en el lado derecho de la barra de menús."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun iTerm2 on jätetty Dockin ulkopuolelle, pääset aina takaisin Asetuksiin tilapalkin kohteen kautta. Etsi iTerm2-kuvaketta valikkorivin oikeasta reunasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’iTerm2 est exclu du Dock, vous pouvez toujours revenir aux Réglages grâce à l’élément de la barre d’état. Cherchez une icône iTerm2 sur le côté droit de la barre des menus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando iTerm2 è escluso dal Dock, puoi sempre tornare alle Impostazioni usando l’elemento della barra di stato. Cerca un’icona di iTerm2 sul lato destro della barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2をDockから除外した場合でも、ステータスバー項目を使って常に環境設定に戻ることができます。メニューバーの右側にあるiTerm2アイコンを探してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2를 Dock에서 제외해도 메뉴 막대의 상태 항목을 사용하여 언제든지 설정으로 돌아갈 수 있습니다. 메뉴 막대 오른쪽에서 iTerm2 아이콘을 찾으십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når iTerm2 er utelatt fra Dock, kan du alltid komme tilbake til Innstillinger via statuslinjeobjektet. Se etter et iTerm2-symbol på høyre side av menylinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer iTerm2 is uitgesloten van het Dock, kun je altijd terug naar Instellingen via het statusbalkonderdeel. Zoek naar een iTerm2-symbool aan de rechterkant van je menubalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy iTerm2 jest wykluczony z Docka, zawsze możesz wrócić do Ustawień za pomocą ikony na pasku menu. Poszukaj ikony iTerm2 po prawej stronie paska menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o iTerm2 é excluído do Dock, você sempre pode voltar aos Ajustes usando o item da barra de menus. Procure um ícone do iTerm2 no lado direito da sua barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если iTerm2 исключён из Dock, вы всегда сможете вернуться в настройки с помощью элемента строки состояния. Ищите значок iTerm2 в правой части строки меню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je iTerm2 vylúčený z Docku, vždy sa môžete vrátiť do Nastavení pomocou položky v stavovej lište. Hľadajte ikonu iTerm2 na pravej strane lišty menu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je iTerm2 izključen iz vrstice Dock, se lahko do Nastavitev vedno vrnete prek elementa v menijski vrstici. Poiščite ikono iTerm2 na desni strani menijske vrstice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När iTerm2 är uteslutet från Dock kan du alltid komma tillbaka till Inställningar via statusfältssymbolen. Leta efter en iTerm2-symbol på höger sida av menyraden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 Dock’tan hariç tutulduğunda, durum çubuğu öğesini kullanarak her zaman Ayarlar’a dönebilirsiniz. Menü çubuğunuzun sağ tarafında bir iTerm2 simgesi arayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi iTerm2 bị loại khỏi Dock, bạn luôn có thể quay lại Cài đặt bằng mục trên thanh trạng thái. Hãy tìm biểu tượng iTerm2 ở bên phải thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
