    "Tip.0060.Body" : {
      "comment" : "Tip of the day body, id 0060",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Text einfügen, der Tabulatoren enthält, werden Sie gefragt, ob diese in Leerzeichen umgewandelt werden sollen. Das ist an der Shell-Eingabeaufforderung praktisch, um eine ungewollte Dateinamenvervollständigung zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you paste text containing tabs, you’ll be asked if you want to convert them to spaces. It’s handy at the shell prompt to avoid triggering filename completion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pegas texto que contiene tabuladores, se te preguntará si quieres convertirlos en espacios. Es útil en el prompt del shell para evitar activar la compleción de nombres de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous collez du texte contenant des tabulations, on vous demandera si vous souhaitez les convertir en espaces. C’est pratique à l’invite du shell pour éviter de déclencher la complétion des noms de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se incolli testo contenente tabulazioni, ti verrà chiesto se vuoi convertirle in spazi. È utile al prompt della shell per evitare di attivare il completamento dei nomi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブ文字を含むテキストをペーストすると、スペースに変換するかどうか尋ねられます。シェルプロンプトでファイル名補完が誤って発動するのを防ぐのに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭이 포함된 텍스트를 붙여넣으면 탭을 공백으로 변환할지 묻습니다. 셸 프롬프트에서 파일 이름 완성이 실행되지 않도록 할 때 편리합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você colar texto com tabulações, será perguntado se deseja convertê-las em espaços. Isso é útil no prompt do shell para evitar acionar o preenchimento automático de nomes de arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы вставляете текст, содержащий табуляции, вас спросят, хотите ли вы преобразовать их в пробелы. Это удобно в приглашении оболочки, чтобы не запускать автодополнение имён файлов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme karakterleri içeren bir metin yapıştırırsanız bunları boşluğa dönüştürmek isteyip istemediğiniz sorulur. Dosya adı tamamlamayı tetiklememek için kabuk isteminde kullanışlıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴包含标签页的文本时，系统会询问是否将其转换为空格。在终端提示符下使用此功能可避免触发文件名补全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果貼上的文字包含 Tab 字元，系統會詢問你是否要將它們轉換為空格。這在 shell 提示符號下很方便，可避免觸發檔名自動完成。"
          }
        }
      }
    },
