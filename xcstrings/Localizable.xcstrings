    "AIManualModels.ToggleEconomyModel" : {
      "comment" : "Tooltip for the toggle economy model button",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparmodell umschalten. Ein günstigeres Modell, das für häufige Hintergrundaufgaben wie Sicherheitsprüfungen von Befehlen und die Erkennung von Bildschirm-Leerlauf verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toggle Economy Model. A cheaper model used for frequent background jobs like command-safety checks and screen-idle detection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar/desactivar modelo económico. Un modelo más barato que se usa en tareas frecuentes en segundo plano, como las comprobaciones de seguridad de comandos y la detección de pantalla inactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer/désactiver le modèle économique. Un modèle moins cher utilisé pour les tâches fréquentes en arrière-plan, comme la vérification de la sécurité des commandes et la détection d’un écran inactif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva/disattiva modello economico. Un modello meno costoso usato per processi frequenti in background, come i controlli di sicurezza dei comandi e il rilevamento dello schermo inattivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エコノミーモデルを切り替えます。コマンドの安全性チェックや画面のアイドル検出など、頻繁に実行されるバックグラウンド処理に使用される、より安価なモデルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이코노미 모델 켜기/끄기. 명령 안전성 검사와 화면 유휴 감지처럼 자주 실행되는 백그라운드 작업에 사용하는 더 저렴한 모델입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar modelo econômico. Um modelo mais barato usado em tarefas frequentes em segundo plano, como verificações de segurança de comandos e detecção de tela ociosa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключить статус «экономичная модель». Более дешёвая модель, используемая для частых фоновых задач, таких как проверка безопасности команд и определение простоя экрана."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekonomi Modelini Aç/Kapat. Komut güvenliği denetimleri ve ekran boşta algılama gibi sık yapılan arka plan işleri için kullanılan daha ucuz bir model."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换经济模型。一种更便宜的模型，用于频繁的后台任务，例如命令安全检查与屏幕空闲检测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換經濟模型。一種較便宜的模型，用於頻繁的背景工作，例如指令安全檢查與螢幕閒置偵測。"
          }
        }
      }
    },
