    "StatusBarGit.SendCommandOverSshFormat" : {
      "comment" : "Warning shown before sending a git command over ssh; placeholder is the command",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že jste přes SSH připojeni jinam. Odeslat příkaz „%@“?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at du er forbundet via ssh et sted. Er det OK at sende kommandoen “%@”?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als wären Sie per SSH verbunden. Befehl „%@“ senden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like you're sshed somewhere. OK to send the command “%@”?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que estás conectado por ssh a otro equipo. ¿Quieres enviar el comando “%@”?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää siltä, että olet yhdistänyt ssh:lla jonnekin. Lähetetäänkö komento ”%@”?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous soyez connecté en ssh quelque part. Envoyer la commande « %@ » ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu sia connesso in ssh a un altro computer. Inviare il comando “%@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 接続中のようです。コマンド「%@」を送信してもよろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 곳에 ssh로 접속한 것 같습니다. “%@” 명령을 보내도 되겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at du er koblet til en annen maskin via ssh. Vil du sende kommandoen «%@»?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat je via ssh met een andere computer verbonden bent. Mag het commando ‘%@’ worden verstuurd?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że masz połączenie przez ssh z innym komputerem. Czy wysłać polecenie „%@”?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está conectado via ssh a algum lugar. Tudo bem enviar o comando “%@”?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы подключены по SSH. Отправить команду «%@»?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzerá to, že ste pripojení cez ssh. Odoslať príkaz „%@“?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da ste povezani prek ssh. Ali lahko pošljem ukaz »%@«?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det verkar som att du är ansluten via ssh någon annanstans. Vill du skicka kommandot ”%@”?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yere ssh ile bağlanmış gibisiniz. “%@” komutu gönderilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ bạn đang ssh vào một máy khác. Gửi lệnh “%@” được không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来你已 ssh 到某处。发送命令“%@”？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起來你正透過 ssh 連到其他地方。要傳送指令「%@」嗎？"
          }
        }
      }
