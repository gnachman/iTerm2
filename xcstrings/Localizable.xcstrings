    "PasswordArchive.NoKeychainScope" : {
      "comment" : "Shown when the user opens a passwords file while neither the terminal nor the browser password manager uses the Keychain",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesla lze importovat pouze do správce hesel „Svazek klíčů macOS“. Chcete-li je importovat, otevřete správce hesel, v jeho nabídce s ozubeným kolem vyberte „Svazek klíčů macOS“ a poté tento soubor otevřete znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangskoder kan kun importeres i adgangskodeadministratoren for macOS-nøgleringen. For at importere dem skal du åbne adgangskodeadministratoren, vælge macOS-nøglering i tandhjulsmenuen og derefter åbne dette arkiv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter können nur in den Passwort-Manager „macOS-Schlüsselbund“ importiert werden. Öffnen Sie dazu den Passwort-Manager, wählen Sie im Zahnradmenü „macOS-Schlüsselbund“ und öffnen Sie diese Datei dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Passwords can be imported only into the macOS Keychain password manager. To import them, open the password manager, choose macOS Keychain from its gear menu, and then open this file again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas solo se pueden importar en el gestor de contraseñas del llavero de macOS. Para importarlas, abre el gestor de contraseñas, elige llavero de macOS en su menú de engranaje y vuelve a abrir este archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasanoja voi tuoda vain macOS:n avainnipun salasanojen hallintaan. Voit tuoda ne avaamalla salasanojen hallinnan, valitsemalla sen rataskuvakkeen valikosta macOS:n avainnipun ja avaamalla tämän tiedoston uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe ne peuvent être importés que dans le gestionnaire de mots de passe Trousseau macOS. Pour les importer, ouvrez le gestionnaire de mots de passe, choisissez Trousseau macOS dans son menu en forme d’engrenage, puis rouvrez ce fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le password possono essere importate solo nel gestore password Portachiavi di macOS. Per importarle, apri il gestore password, scegli Portachiavi di macOS dal menu a forma di ingranaggio e poi riapri questo file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードは macOS キーチェーンのパスワードマネージャーにのみインポートできます。インポートするには、パスワードマネージャーを開き、歯車メニューから「macOS キーチェーン」を選択してから、このファイルをもう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 macOS 키체인 암호 관리자로만 가져올 수 있습니다. 가져오려면 암호 관리자를 열고 톱니바퀴 메뉴에서 macOS 키체인을 선택한 다음 이 파일을 다시 여십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passord kan bare importeres til passordbehandleren for macOS-nøkkelringen. For å importere dem åpner du passordbehandleren, velger macOS-nøkkelring fra tannhjulmenyen og åpner deretter denne filen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachtwoorden kunnen alleen worden geïmporteerd in de wachtwoordbeheerder van de sleutelhanger van macOS. Om ze te importeren, open je de wachtwoordbeheerder, kies je ‘macOS-sleutelhanger’ in het tandwielmenu en open je dit bestand opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasła można zaimportować tylko do menedżera haseł Pęku kluczy macOS. Aby to zrobić, otwórz menedżera haseł, wybierz Pęk kluczy macOS z menu z kołem zębatym, a następnie otwórz ten plik ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As senhas só podem ser importadas para o cofre de senhas da Keychain do macOS. Para importá-las, abra o cofre de senhas, escolha Keychain do macOS no menu de engrenagem e abra este arquivo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли можно импортировать только в менеджер паролей «Связка ключей macOS». Чтобы импортировать их, откройте менеджер паролей, выберите «Связка ключей macOS» в меню с шестерёнкой, а затем снова откройте этот файл."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslá možno importovať iba do správcu hesiel Kľúčenka macOS. Ak ich chcete importovať, otvorte správcu hesiel, v jeho menu s ozubeným kolieskom vyberte Kľúčenka macOS a potom tento súbor otvorte znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesla je mogoče uvoziti samo v upravitelja gesel z verigo ključev v sistemu macOS. Če jih želite uvoziti, odprite upravitelja gesel, v njegovem meniju z zobnikom izberite verigo ključev macOS in nato znova odprite to datoteko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösenord kan bara importeras till lösenordshanteraren för macOS-nyckelringen. Om du vill importera dem öppnar du lösenordshanteraren, väljer macOS-nyckelring i kugghjulsmenyn och öppnar sedan den här filen igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalar yalnızca macOS anahtar zinciri parola yöneticisine içe aktarılabilir. İçe aktarmak için parola yöneticisini açın, dişli menüsünden macOS anahtar zincirini seçin ve bu dosyayı yeniden açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu chỉ có thể được nhập vào trình quản lý mật khẩu chuỗi khóa macOS. Để nhập, hãy mở trình quản lý mật khẩu, chọn chuỗi khóa macOS từ menu bánh răng của nó, rồi mở lại tệp này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码只能导入到 macOS 钥匙串密码管理器中。要导入它们，请打开密码管理器，从其齿轮菜单中选择“macOS 钥匙串”，然后再次打开此文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼只能匯入 macOS 鑰匙圈密碼管理器。若要匯入，請打開密碼管理器，從其齒輪選單中選取「macOS 鑰匙圈」，然後再次打開此檔案。"
          }
        }
      }
    },
