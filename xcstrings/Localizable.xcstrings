    "Tip.0105.Body" : {
      "comment" : "Tip of the day body, id 0105",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využijte automatickou integraci shellu při vytvoření přihlašovacího shellu, takže nemusíte provádět žádné explicitní nastavení v Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplev automatisk shell-integration, når du opretter en login-shell, så du ikke behøver at konfigurere noget eksplicit på din Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erleben Sie automatische Shell-Integration beim Erstellen einer Login-Shell, ganz ohne dass eine ausdrückliche Einrichtung auf Ihrem Mac nötig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Experience automatic shell integration when creating a login shell, removing the need for explicit setup on your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disfruta de la integración automática con el shell al crear un shell de inicio de sesión, sin necesidad de una configuración explícita en tu Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koe automaattinen komentotulkki-integraatio kirjautumiskomentotulkkia luotaessa, jolloin erillistä määritystä Macissasi ei tarvita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profitez de l’intégration automatique du shell lors de la création d’un shell de connexion, sans configuration explicite sur votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri l’integrazione shell automatica quando crei una shell di login, senza bisogno di una configurazione esplicita sul tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインシェルを作成すると自動的にシェル統合が行われ、Mac上で明示的なセットアップを行う必要がなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 셸을 생성할 때 셸 통합이 자동으로 적용되므로 Mac에서 따로 설정할 필요가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opplev automatisk skallintegrering når du oppretter et påloggingsskall, uten behov for eget oppsett på Macen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ervaar automatische shell-integratie bij het maken van een inlogshell, zonder dat je op je Mac iets expliciet hoeft in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzystaj z automatycznej integracji z powłoką podczas tworzenia powłoki logowania, bez potrzeby jawnej konfiguracji na Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenha o Shell Integration automático ao criar um login shell, eliminando a necessidade de configuração explícita no seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получите автоматическую интеграцию с оболочкой при создании login shell без необходимости явной настройки на вашем Mac."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využite automatickú integráciu shellu pri vytvorení prihlasovacieho shellu bez nutnosti explicitného nastavenia na vašom Macu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izkusite samodejno integracijo lupine pri ustvarjanju prijavne lupine, brez izrecne nastavitve v računalniku Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upplev automatisk skalintegrering när ett inloggningsskal skapas, så att du slipper ställa in det själv på din Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturum açma kabuğu oluştururken otomatik kabuk entegrasyonunu deneyimleyin; Mac’inizde açık bir kuruluma gerek kalmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trải nghiệm tích hợp shell tự động khi tạo shell đăng nhập, không cần thiết lập thủ công trên Mac của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在创建登录shell时，支持自动shell集成功能，无需在Mac上进行额外设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立登入 shell 時可自動套用 Shell 整合，無需在你的 Mac 上另外明確設定。"
          }
        }
      }
    },
