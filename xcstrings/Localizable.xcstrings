    "AdvancedSetting.viewManPageCommand" : {
      "comment" : "Advanced setting: viewManPageCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkaz pro zobrazení man stránek.\nPoužívá se po stisknutí tlačítka man stránky na Touch Baru. %@ se nahradí příkazem. Ukončete příkaz znakem &, aby se neotevíralo okno iTerm2 (např. při spouštění externího prohlížeče)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommando til visning af man-sider.\nBruges, når du trykker på knappen til man-sider på Touch Bar. %@ erstattes med kommandoen. Afslut kommandoen med &, så et iTerm2-vindue ikke åbnes (f.eks. hvis du starter en ekstern fremviser)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl zum Anzeigen von Man-Pages.\nWird verwendet, wenn Sie die Man-Page-Schaltfläche auf der Touch Bar drücken. %@ wird durch den Befehl ersetzt. Beenden Sie den Befehl mit &, um zu verhindern, dass sich ein iTerm2-Fenster öffnet (z. B. wenn Sie einen externen Viewer starten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to view man pages.\nUsed when you press the man page button on the touch bar. %@ is replaced with the command. End the command with & to avoid opening an iTerm2 window (e.g., if you're launching an external viewer)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando para ver páginas del manual.\nSe usa al pulsar el botón de páginas del manual en la Touch Bar. %@ se sustituye por el comando. Termina el comando con & para evitar abrir una ventana de iTerm2 (p. ej., si inicias un visor externo)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komento man-sivujen katseluun.\nKäytetään, kun painat Touch Barin man-sivupainiketta. %@ korvataan komennolla. Päätä komento merkkiin &, jotta iTerm2-ikkunaa ei avata (esim. jos käynnistät ulkoisen katseluohjelman)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande pour afficher les pages de manuel.\nUtilisée lorsque vous appuyez sur le bouton des pages de manuel de la Touch Bar. %@ est remplacé par la commande. Terminez la commande par & pour éviter d’ouvrir une fenêtre iTerm2 (par exemple si vous lancez une visionneuse externe)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando per visualizzare le pagine man.\nUsato quando premi il pulsante delle pagine man sulla Touch Bar. %@ viene sostituito dal comando. Termina il comando con & per evitare di aprire una finestra di iTerm2 (ad es. se avvii un visualizzatore esterno)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "manページを表示するためのコマンド。\nTouch Barのmanページボタンを押したときに使用されます。%@はコマンドに置き換えられます。iTerm2のウィンドウが開かないようにするには、コマンドの末尾に&を付けてください（外部ビューアーを起動する場合など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "man 페이지를 보는 명령.\nTouch Bar의 man 페이지 버튼을 누를 때 사용됩니다. %@은(는) 명령으로 대치됩니다. iTerm2 윈도우를 열지 않으려면(예: 외부 뷰어를 실행하는 경우) 명령 끝에 &를 붙이십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommando for å vise man-sider.\nBrukes når du trykker på man-side-knappen på Touch Bar. %@ erstattes med kommandoen. Avslutt kommandoen med & for å unngå å åpne et iTerm2-vindu (f.eks. hvis du starter en ekstern viser)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commando om man-pagina’s te bekijken.\nWordt gebruikt wanneer je op de man-pagina-knop op de Touch Bar drukt. %@ wordt vervangen door het commando. Eindig het commando met & om te voorkomen dat een iTerm2-venster opent (bijvoorbeeld als je een externe viewer start)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecenie do wyświetlania stron podręcznika man.\nUżywane po naciśnięciu przycisku strony man na Touch Barze. %@ jest zastępowane poleceniem. Zakończ polecenie znakiem &, aby uniknąć otwarcia okna iTerm2 (np. przy uruchamianiu zewnętrznej przeglądarki)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando para visualizar páginas de manual.\nUsado quando você pressiona o botão de página de manual na touch bar. %@ é substituído pelo comando. Termine o comando com & para evitar abrir uma janela do iTerm2 (por exemplo, se você estiver iniciando um visualizador externo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда для просмотра man-страниц.\nИспользуется при нажатии кнопки man-страницы на Touch Bar. %@ заменяется командой. Завершите команду знаком &, чтобы избежать открытия окна iTerm2 (например, если вы запускаете внешнюю программу просмотра)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Príkaz na zobrazenie stránok man.\nPoužije sa po stlačení tlačidla stránky man na Touch Bar. %@ sa nahradí príkazom. Ak príkaz ukončíte znakom &, otvorenie okna iTerm2 sa nevykoná (napr. pri spúšťaní externého prehliadača)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukaz za ogled strani priročnika (man).\nUporablja se, ko pritisnete gumb strani priročnika v vrstici Touch Bar. %@ se zamenja z ukazom. Ukaz zaključite z &, da se izognete odpiranju okna iTerm2 (npr. če zaganjate zunanji pregledovalnik)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommando för att visa man-sidor.\nAnvänds när du trycker på man-sideknappen i Touch Bar. %@ ersätts med kommandot. Avsluta kommandot med & för att undvika att ett iTerm2-fönster öppnas (t.ex. om du startar en extern visare)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "man sayfalarını görüntülemek için komut.\nTouch Bar’daki man sayfası düğmesine bastığınızda kullanılır. %@ komutla değiştirilir. iTerm2 penceresi açılmasını önlemek için komutu & ile bitirin (örn. harici bir görüntüleyici başlatıyorsanız)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lệnh để xem trang man.\nĐược dùng khi bạn nhấn nút trang man trên Touch Bar. %@ được thay bằng lệnh. Kết thúc lệnh bằng & để tránh mở cửa sổ iTerm2 (ví dụ nếu bạn khởi chạy trình xem bên ngoài)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看 man 页面命令。\n当点击触摸栏上的 man 页面按钮时使用。%@ 被替换为命令，以 & 结束命令可避免打开 iTerm2 窗口（例如，如果正在启动外部查看器）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢視 man 頁面的指令。\n按下 Touch Bar 上的 man 頁面按鈕時使用。%@ 會被取代為指令。在指令結尾加上 & 可避免打開 iTerm2 視窗（例如，使用外部檢視器時）。"
          }
        }
      }
    },
    "AdvancedSetting.visibleSessionExecutionWeight" : {
      "comment" : "Advanced setting: visibleSessionExecutionWeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolikrát více času zpracování dostane viditelná relace než skrytá, když má výstup ke zpracování více relací, než jich může běžet současně.\nPlatí jen s novou implementací vstupu a výstupu relací. Chcete-li toto nastavení uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange gange så meget behandlingstid en synlig session får som en skjult, når flere sessioner har output at behandle, end der kan køre på én gang.\nGælder kun med den nye implementering af sessioners input og output. Du skal starte iTerm2 igen, for at denne indstilling træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel Mal mehr Verarbeitungszeit eine sichtbare Sitzung gegenüber einer verborgenen erhält, wenn mehr Sitzungen Ausgabe zu verarbeiten haben, als gleichzeitig laufen können.\nDies gilt nur für die neue Implementierung der Sitzungsein- und -ausgabe. Sie müssen iTerm2 neu starten, damit diese Einstellung wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How many times as much processing time a visible session gets as a hidden one when more sessions have output to process than can run at once.\nThis applies only with the new implementation of session input and output. You must restart iTerm2 for this setting to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas veces más tiempo de procesamiento recibe una sesión visible que una oculta cuando hay más sesiones con salida que procesar de las que pueden ejecutarse a la vez.\nSolo se aplica con la nueva implementación de entrada y salida de sesiones. Debes reiniciar iTerm2 para que este ajuste surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka moninkertaisen käsittelyajan näkyvä istunto saa piilotettuun verrattuna, kun useammalla istunnolla on käsiteltävää tulostetta kuin voi olla käynnissä kerrallaan.\nTämä pätee vain istunnon syötteen ja tulosteen uudessa toteutuksessa. Sinun on käynnistettävä iTerm2 uudelleen, jotta tämä asetus tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de fois plus de temps de traitement une session visible reçoit par rapport à une session masquée lorsque davantage de sessions ont de la sortie à traiter qu’il n’est possible d’en exécuter simultanément.\nS’applique uniquement avec la nouvelle implémentation de l’entrée et de la sortie des sessions. Vous devez redémarrer iTerm2 pour que ce réglage prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quante volte più tempo di elaborazione riceve una sessione visibile rispetto a una nascosta quando ci sono più sessioni con output da elaborare di quante ne possano girare contemporaneamente.\nSi applica solo con la nuova implementazione di input e output delle sessioni. Devi riavviare iTerm2 affinché questa impostazione abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時に実行できる数より多くのセッションに処理すべき出力がある場合に、表示中のセッションが非表示のセッションの何倍の処理時間を得るか。\nこれはセッションの入出力の新しい実装を使用している場合にのみ適用されます。この設定を反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출력을 처리할 세션이 동시에 실행할 수 있는 수보다 많을 때, 보이는 세션이 숨겨진 세션보다 몇 배의 처리 시간을 받을지 지정합니다.\n새로운 세션 입출력 구현을 사용할 때만 적용됩니다. 이 설정을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange ganger så mye behandlingstid en synlig økt får som en skjult når flere økter har utdata å behandle enn det som kan kjøre samtidig.\nDette gjelder bare med den nye implementeringen av øktenes inn- og utdata. Du må starte iTerm2 på nytt for at denne innstillingen skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel keer zoveel verwerkingstijd een zichtbare sessie krijgt als een verborgen sessie wanneer meer sessies uitvoer te verwerken hebben dan tegelijk kunnen draaien.\nDit geldt alleen met de nieuwe implementatie van sessie-invoer en -uitvoer. Je moet iTerm2 herstarten om deze instelling te laten ingaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile razy więcej czasu przetwarzania dostaje widoczna sesja niż ukryta, gdy więcej sesji ma wyjście do przetworzenia, niż może działać naraz.\nDotyczy tylko nowej implementacji wejścia i wyjścia sesji. Aby to ustawienie zaczęło działać, musisz uruchomić ponownie iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas vezes mais tempo de processamento uma sessão visível recebe em relação a uma oculta quando há mais sessões com saída a processar do que podem ser executadas ao mesmo tempo.\nIsto se aplica apenas à nova implementação de entrada e saída das sessões. Você deve reiniciar o iTerm2 para que este ajuste tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во сколько раз больше времени обработки получает видимый сеанс по сравнению со скрытым, когда вывод для обработки есть у большего числа сеансов, чем может работать одновременно.\nЭто действует только при новой реализации ввода и вывода сеансов. Для вступления настройки в силу нужно перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koľkokrát viac času spracovania dostane viditeľná relácia ako skrytá, keď má výstup na spracovanie viac relácií, než môže bežať naraz.\nPlatí iba pri novej implementácii vstupu a výstupu relácií. Aby sa nastavenie prejavilo, musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolikokrat več procesorskega časa dobi vidna seja kot skrita, ko ima več sej izhod za obdelavo, kot jih lahko teče hkrati.\nTo velja le z novo izvedbo vhoda in izhoda sej. Za uveljavitev te nastavitve morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur många gånger så mycket bearbetningstid en synlig session får jämfört med en dold när fler sessioner har utdata att bearbeta än vad som kan köras samtidigt.\nDet gäller bara med den nya implementationen av sessionens indata och utdata. Du måste starta om iTerm2 för att den här inställningen ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlenecek çıktısı olan oturum sayısı aynı anda çalışabilenden fazla olduğunda, görünür bir oturumun gizli bir oturuma göre kaç kat işlem süresi alacağı.\nBu yalnızca oturum girdi ve çıktısının yeni uygulamasında geçerlidir. Bu ayarın etkili olması için iTerm2’yi yeniden başlatmanız gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phiên hiển thị nhận được thời gian xử lý gấp bao nhiêu lần phiên bị ẩn khi có nhiều phiên cần xử lý đầu ra hơn số có thể chạy cùng lúc.\nChỉ áp dụng với cách triển khai mới của đầu vào và đầu ra phiên. Bạn phải khởi động lại iTerm2 để cài đặt này có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当有输出待处理的会话多于可同时运行的数量时，可见会话获得的处理时间是隐藏会话的多少倍。\n此设置仅适用于会话输入输出的新实现。必须重启 iTerm2 才能使此设置生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當有輸出待處理的工作階段多於可同時執行的數量時，可見工作階段獲得的處理時間是隱藏工作階段的幾倍。\n這僅適用於工作階段輸入與輸出的新實作。必須重新啟動 iTerm2 才會使此設定生效。"
          }
        }
      }
    },
    "AdvancedSetting.vs16Supported" : {
      "comment" : "Advanced setting: vs16Supported",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporovat variační selektor 16, který činí emoji plné šířky ve všech režimech?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøt, at variationsvælger 16 gør emojis i fuld bredde i alle tilstande?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützung dafür, dass Variationsselektor 16 Emojis in allen Modi in voller Breite darstellt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support variation selector 16 making emoji fullwidth in all modes?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Admitir que el selector de variación 16 haga que los emojis ocupen ancho completo en todos los modos?"
          }
        },
        "fi" : {
          "stringUnit" : {
