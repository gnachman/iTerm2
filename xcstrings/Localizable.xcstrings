            "value" : "Poizvedba, ki jo vnesete, jo bo nadomestila pri pogovoru z AI. Na primer: »Napiši ukaz unix za \\(ai.prompt).«"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frågan du skriver ersätter den när du talar med AI. Till exempel: ”Skriv ett unix-kommando för att \\(ai.prompt).”"
          }
