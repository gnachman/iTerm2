          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hexcodes die worden verstuurd om de opdrachtregel te wissen bij het openen van de opsteller.\n0x15 is ^U, 0x0b is ^K."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kody szesnastkowe wysyłane w celu wyczyszczenia wiersza poleceń po wejściu do edytora poleceń.\n0x15 to ^U, 0x0b to ^K."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Códigos hexadecimais a enviar para limpar a linha de comando ao entrar no compositor.\n0x15 é ^U, 0x0b é ^K."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шестнадцатеричные коды для отправки, чтобы очистить командную строку при входе в Композер.\n0x15 — это ^U, 0x0b — это ^K."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hexadecimálne kódy, ktoré sa odošlú na vymazanie príkazového riadka pri vstupe do editora príkazov.\n0x15 je ^U, 0x0b je ^K."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šestnajstiške kode za pošiljanje, ki počistijo ukazno vrstico ob vstopu v urejevalnik ukazov.\n0x15 je ^U, 0x0b je ^K."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hexkoder som skickas för att rensa kommandoraden när kommandoredigeraren öppnas.\n0x15 är ^U, 0x0b är ^K."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucuya girerken komut satırını temizlemek için gönderilecek onaltılık kodlar.\n0x15 ^U, 0x0b ^K’dir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã hex gửi để xóa dòng lệnh khi vào trình soạn lệnh.\n0x15 là ^U, 0x0b là ^K."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 composer 时清除命令行的十六进制代码。  \n0x15 对应 ^U，0x0b 对应 ^K。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進入編寫器時，為清除命令列而傳送的十六進位碼。\n0x15 是 ^U，0x0b 是 ^K。"
          }
        }
      }
    },
    "AdvancedSetting.conservativeURLGuessing" : {
      "comment" : "Advanced setting: conservativeURLGuessing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musí URL obsahovat schéma?\nZapnutím snížíte počet falešně pozitivních výsledků, které sémantická historie považuje za URL"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL’er skal indeholde et skema?\nSlå dette til for at mindske antallet af falske positive, som semantisk historik tror er en URL"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müssen URLs ein Schema enthalten?\nAktivieren Sie dies, um die Anzahl der Fehlalarme zu verringern, bei denen Semantic History fälschlich eine URL erkennt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URLs must contain a scheme?\nEnable this to reduce the number of false positives that semantic history thinks are a URL"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Las URL deben contener un esquema?\nActívalo para reducir el número de falsos positivos que el historial semántico considera una URL"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-osoitteiden on sisällettävä skeema?\nOta tämä käyttöön vähentääksesi vääriä positiivisia, joita semanttinen historia pitää URL-osoitteina"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les URL doivent-elles contenir un schéma ?\nActivez cette option pour réduire le nombre de faux positifs que l’historique sémantique prend pour des URL"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
