    "AdvancedSetting.asyncPreconvertMaxOutstandingBytes" : {
      "comment" : "Advanced setting: asyncPreconvertMaxOutstandingBytes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Bytes für ausstehende asynchrone Vorkonvertierungen.\nWird dieses Limit erreicht, werden neue Zeichenfolgen synchron im Mutation-Thread konvertiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum bytes of outstanding async pre-conversions.\nWhen this limit is reached, new strings are converted synchronously on the mutation thread."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非同期の事前変換で未処理のまま保持できる最大バイト数。\nこの上限に達すると、新しい文字列は mutation スレッド上で同期的に変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리 대기 중인 비동기 사전 변환의 최대 바이트 수.\n이 한도에 도달하면 새 문자열은 변경(mutation) 스레드에서 동기적으로 변환됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de bytes de pré-conversões assíncronas pendentes.\nQuando este limite é atingido, novas strings são convertidas de forma síncrona na thread de mutação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество байт незавершённых асинхронных преобразований.\nПри достижении этого предела новые строки преобразуются синхронно в потоке мутации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完成的异步预转换的最大字节数。\n当达到此限制时，新的字符串将在 mutation 线程上同步转换。"
          }
        }
      }
    },
    "AdvancedSetting.asyncPreconvertMinStringLength" : {
      "comment" : "Advanced setting: asyncPreconvertMinStringLength",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimale Zeichenfolgenlänge (in UTF-16-Codeeinheiten), ab der eine asynchrone Vorkonvertierung ausgelöst wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum string length (in UTF-16 code units) to dispatch for async pre-conversion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非同期の事前変換にディスパッチする文字列の最小長 (UTF-16 コード単位)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비동기 사전 변환으로 보낼 최소 문자열 길이(UTF-16 코드 단위)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimento mínimo de string (em unidades de código UTF-16) para despachar para pré-conversão assíncrona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимальная длина строки (в единицах кода UTF-16) для отправки на асинхронное преобразование."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于异步预转换的最小字符串长度（以 UTF-16 代码单位计）。"
          }
        }
      }
    },
    "AdvancedSetting.asyncPreconvertStrings" : {
      "comment" : "Advanced setting: asyncPreconvertStrings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange Nicht-ASCII-Zeichenfolgen in einer Hintergrundwarteschlange vorkonvertieren.\nDies entkoppelt die Vorkonvertierung vom Parser-Thread für einen besseren Durchsatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pre-convert long non-ASCII strings on a background queue.\nThis decouples preconversion from the parser thread for better throughput."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い非 ASCII 文字列をバックグラウンドキューで事前変換します。\nこれにより、事前変換をパーサースレッドから分離し、スループットを向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 큐에서 긴 비ASCII 문자열을 미리 변환.\n처리량을 높이기 위해 사전 변환을 파서 스레드와 분리합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-converter strings longas não-ASCII em uma fila em segundo plano.\nIsso desacopla a pré-conversão da thread do analisador para melhor taxa de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительно преобразовывать длинные строки не из ASCII в фоновой очереди.\nЭто отделяет предварительное преобразование от потока разбора для повышения пропускной способности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台队列中对长非 ASCII 字符串进行预转换。\n此操作将预转换与解析线程分离，以提高吞吐量。"
          }
        }
      }
    },
    "AdvancedSetting.autoLockSessionNameOnEdit" : {
      "comment" : "Advanced setting: autoLockSessionNameOnEdit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungsname nach dem Bearbeiten automatisch sperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-lock session name after editing it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション名を編集した後、自動的にロックします。"
          }
        },
        "ko" : {
