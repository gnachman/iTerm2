    "ClaudeCodeOnboarding.IntroLead" : {
      "comment" : "Reassuring lead text on the intro sheet",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez paniky! To vše lze později vrátit zpět přes „iTerm2 > Odinstalovat integraci s Claude Code“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolig! Alt dette kan fortrydes senere via iTerm2 > Afinstaller Claude Code-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Panik! All dies kann später über iTerm2 > Claude-Code-Integration deinstallieren rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don’t panic! All of this can be undone later via iTerm2 > Uninstall Claude Code Integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡No te asustes! Todo esto se puede deshacer más tarde con iTerm2 > Desinstalar integración con Claude Code."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä panikoi! Kaiken tämän voi perua myöhemmin valinnalla iTerm2 > Poista Claude Code -integraation asennus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de panique ! Tout cela peut être annulé plus tard via iTerm2 > Désinstaller l’intégration de Claude Code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente panico! Tutto questo può essere annullato in seguito da iTerm2 > Disinstalla integrazione con Claude Code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心配ありません！これらはすべて、後でiTerm2 > Claude Code連携をアンインストールから元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걱정하지 마십시오! 이 모든 것은 나중에 iTerm2 > Claude Code 통합 제거로 되돌릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen panikk! Alt dette kan angres senere via «iTerm2 > Avinstaller Claude Code-integrering»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen paniek! Dit alles kan later ongedaan worden gemaakt via iTerm2 > Verwijder installatie van Claude Code-integratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojnie! Wszystko to można później cofnąć przez iTerm2 > Odinstaluj integrację z Claude Code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não entre em pânico! Tudo isso pode ser desfeito mais tarde por meio de iTerm2 > Desinstalar integração do Claude Code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не паникуйте! Всё это можно будет отменить позже через iTerm2 > Uninstall Claude Code Integration."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepanikárte! Toto všetko možno neskôr vrátiť späť cez menu „iTerm2 > Odinštalovať integráciu Claude Code“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brez panike! Vse to je mogoče pozneje razveljaviti prek »iTerm2 > Odstrani integracijo s Claude Code«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen panik! Allt detta kan ångras senare via iTerm2 > Avinstallera Claude Code-integrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panik yapmayın! Bunların hepsi daha sonra iTerm2 > Claude Code Entegrasyonunu Kaldır ile geri alınabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng lo! Tất cả những điều này có thể được hoàn tác sau qua iTerm2 > Gỡ cài đặt tích hợp Claude Code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别慌！之后可以通过 iTerm2 > 卸载 Claude Code 集成 撤销所有这些操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別慌！之後可以透過「iTerm2 > 解除安裝 Claude Code 整合」還原所有這些操作。"
          }
        }
      }
