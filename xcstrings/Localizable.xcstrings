    "AdvancedSetting.alternateMouseScrollStringForDown" : {
      "comment" : "Advanced setting: alternateMouseScrollStringForDown",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mausrad nach unten sendet den angegebenen Text im alternativen Bildschirmmodus.\nDer Wert sollte die Vim-Syntax verwenden, zum Beispiel \\e für Escape."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel down sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desplazar la rueda hacia abajo se envía el texto especificado en el modo de pantalla alternativa.\nEl valor debe usar la sintaxis de Vim, como \\e para escape."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement vers le bas à la molette envoie le texte indiqué en mode écran alternatif.\nLa valeur doit utiliser la syntaxe de Vim, par exemple \\e pour Échap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorrendo la rotellina verso il basso in modalità schermo alternativo viene inviato il testo specificato.\nIl valore deve usare la sintassi di Vim, come \\e per escape."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替スクリーンモード中、スクロールホイールを下に回すと指定したテキストを送信する。\n値はVim構文（エスケープの場合は\\eなど）を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 화면 모드에서 스크롤 휠을 아래로 굴리면 지정한 텍스트를 보냅니다.\n값은 Vim 문법을 사용해야 합니다(예: Esc는 \\e)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem para baixo envia o texto especificado no modo de tela alternada.\nO valor deve usar a sintaxe do Vim, como \\e para escape."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутка колеса вниз отправляет указанный текст в альтернативном режиме экрана.\nЗначение должно использовать синтаксис Vim, например \\e для escape."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif ekran modundayken kaydırma tekerleği aşağı çevrildiğinde belirtilen metin gönderilir.\nDeğer, kaçış için \\e gibi Vim sözdizimini kullanmalıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动滚轮向下在交替屏幕模式下发送指定文本。\n值应使用Vim语法，例如 \\e 表示转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處於替代螢幕模式時，滾輪向下會傳送指定的文字。\n值應使用 Vim 語法，例如 \\e 代表跳脫。"
          }
        }
      }
    },
    "AdvancedSetting.alternateMouseScrollStringForUp" : {
      "comment" : "Advanced setting: alternateMouseScrollStringForUp",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mausrad nach oben sendet den angegebenen Text im alternativen Bildschirmmodus.\nDer Wert sollte die Vim-Syntax verwenden, zum Beispiel \\e für Escape."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel up sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desplazar la rueda hacia arriba se envía el texto especificado en el modo de pantalla alternativa.\nEl valor debe usar la sintaxis de Vim, como \\e para escape."
          }
