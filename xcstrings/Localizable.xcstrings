    "ProfilesKeys.MetaWarning" : {
      "comment" : "Warning shown when the user configures an option key to act as Meta",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolili jste, že klávesa Option bude fungovat jako Meta. Tato volba je užitečná pro zpětnou kompatibilitu se staršími systémy. Většině uživatelů se doporučuje volba „Esc+“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har valgt, at en alternativtast skal fungere som Meta. Denne indstilling er nyttig for bagudkompatibilitet med ældre systemer. Indstillingen “Esc+” anbefales til de fleste brugere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben sich dafür entschieden, dass eine Wahltaste als Meta fungiert. Diese Option ist nützlich für die Abwärtskompatibilität mit älteren Systemen. Für die meisten Benutzer wird die Option „Esc+“ empfohlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have chosen to have an option key act as Meta. This option is useful for backward compatibility with older systems. The \"Esc+\" option is recommended for most users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has elegido que una tecla Opción actúe como Meta. Esta opción es útil para la compatibilidad con sistemas antiguos. La opción “Esc+” se recomienda para la mayoría de los usuarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet valinnut, että optionäppäin toimii Metana. Tämä asetus on hyödyllinen taaksepäin yhteensopivuuden vuoksi vanhempien järjestelmien kanssa. Useimmille käyttäjille suositellaan asetusta ”Esc+”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez choisi qu’une touche Option agisse comme Meta. Cette option est utile pour la compatibilité avec des systèmes plus anciens. L’option « Échap+ » est recommandée pour la plupart des utilisateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto di far agire un tasto Opzione come Meta. Questa opzione è utile per la compatibilità con i sistemi più vecchi. L’opzione “Esc+” è consigliata alla maggior parte degli utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オプションキーをMetaとして機能させることを選択しました。このオプションは古いシステムとの後方互換性のために便利です。ほとんどのユーザーには「Esc+」オプションをお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option 키가 Meta로 작동하도록 선택했습니다. 이 옵션은 오래된 시스템과의 하위 호환성을 위해 유용합니다. 대부분의 사용자에게는 \"Esc+\" 옵션을 권장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har valgt at en Tilvalg-tast skal fungere som Meta. Dette alternativet er nyttig for bakoverkompatibilitet med eldre systemer. Alternativet «Esc+» anbefales for de fleste brukere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt ervoor gekozen dat een Option-toets als Meta fungeert. Deze optie is handig voor achterwaartse compatibiliteit met oudere systemen. De optie ‘Esc+’ wordt voor de meeste gebruikers aanbevolen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrano, aby klawisz Option działał jako Meta. Ta opcja jest przydatna dla zgodności wstecznej ze starszymi systemami. Większości użytkowników zalecana jest opcja „Esc+”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você optou por fazer uma tecla Option atuar como Meta. Esta opção é útil para compatibilidade com sistemas mais antigos. A opção “Esc+” é recomendada para a maioria dos usuários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы указали, что клавиша Option должна действовать как Meta. Этот вариант полезен для обратной совместимости со старыми системами. Большинству пользователей рекомендуется вариант «Esc+»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolili ste, že kláves Option bude fungovať ako Meta. Táto možnosť je užitočná pre spätnú kompatibilitu so staršími systémami. Väčšine užívateľov sa odporúča možnosť „Esc+“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrali ste, da tipka Option deluje kot Meta. Ta možnost je uporabna za združljivost s starejšimi sistemi. Večini uporabnikov je priporočena možnost »Esc+«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har valt att en alternativtangent ska fungera som Meta. Det här alternativet är användbart för bakåtkompatibilitet med äldre system. Alternativet ”Esc+” rekommenderas för de flesta användare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Option tuşunun Meta gibi davranmasını seçtiniz. Bu seçenek eski sistemlerle geriye dönük uyumluluk için kullanışlıdır. Çoğu kullanıcı için “Esc+” seçeneği önerilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã chọn để một phím Option hoạt động như Meta. Tùy chọn này hữu ích để tương thích ngược với các hệ thống cũ. Tùy chọn “Esc+” được khuyên dùng cho hầu hết người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已选择让 Option 键充当 Meta。此选项有助于与较旧系统向后兼容。建议大多数用户使用“Esc+”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已選擇讓 Option 鍵作為 Meta 使用。此選項有助於與較舊的系統向下相容。建議大多數使用者使用「Esc+」選項。"
          }
        }
      }
    },
    "ProfilesKeys.OptionAsMetaHelp" : {
      "comment" : "Help text explaining how the option key behaves as Meta or Alt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve většině režimů hlášení kláves může při hlášení speciálních kláves, například šipek, klávesa ⌥ fungovat jako Meta nebo Alt. Před verzí 3.5.6 používal iTerm2 Meta. Výchozí hodnota se změnila na Alt, protože ji některé programy, například Emacs, očekávají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I de fleste tilstande for rapportering af taster kan tasten ⌥ fungere som enten Meta eller Alt, når specialtaster som piletaster rapporteres. Før version 3.5.6 brugte iTerm2 Meta. Standarden blev ændret til Alt, fordi nogle programmer som Emacs forventer det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den meisten Modi zur Tastenmeldung kann die ⌥-Taste beim Melden spezieller Tasten wie Pfeiltasten entweder als Meta oder als Alt fungieren. Vor Version 3.5.6 verwendete iTerm2 Meta. Der Standard wurde auf Alt geändert, da einige Programme wie Emacs dies erwarten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In most key reporting modes, when reporting special keys like arrows, the ⌥ key may act as either Meta or Alt. Prior to version 3.5.6, iTerm2 used Meta. The default changed to Alt because some programs like Emacs expect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la mayoría de los modos de informe de teclas, al informar de teclas especiales como las flechas, la tecla ⌥ puede actuar como Meta o como Alt. Antes de la versión 3.5.6, iTerm2 usaba Meta. El valor predeterminado cambió a Alt porque algunos programas, como Emacs, lo esperan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useimmissa näppäinraportointitiloissa ⌥-näppäin voi toimia joko Metana tai Altina raportoitaessa erikoisnäppäimiä, kuten nuolia. Ennen versiota 3.5.6 iTerm2 käytti Metaa. Oletukseksi vaihdettiin Alt, koska jotkin ohjelmat, kuten Emacs, odottavat sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la plupart des modes de signalement des touches, pour les touches spéciales comme les flèches, la touche ⌥ peut agir comme Meta ou Alt. Avant la version 3.5.6, iTerm2 utilisait Meta. La valeur par défaut est devenue Alt, car certains programmes comme Emacs l’attendent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella maggior parte delle modalità di segnalazione dei tasti, quando si segnalano tasti speciali come le frecce, il tasto ⌥ può agire come Meta o come Alt. Prima della versione 3.5.6, iTerm2 usava Meta. L’impostazione predefinita è passata ad Alt perché alcuni programmi, come Emacs, se lo aspettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどのキー報告モードでは、矢印キーなどの特殊キーを報告する際に、⌥キーはMetaまたはAltのいずれかとして機能します。バージョン3.5.6より前は、iTerm2はMetaを使用していました。Emacsなどの一部のプログラムがAltを期待するため、デフォルトがAltに変更されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 키 리포팅 모드에서 화살표 같은 특수 키를 리포팅할 때 ⌥ 키는 Meta 또는 Alt로 동작할 수 있습니다. 버전 3.5.6 이전에는 iTerm2가 Meta를 사용했습니다. Emacs 같은 일부 프로그램에서 Alt를 기대하므로 기본값이 Alt로 변경되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I de fleste modi for tasterapportering, når spesialtaster som piltastene rapporteres, kan ⌥-tasten fungere som enten Meta eller Alt. Før versjon 3.5.6 brukte iTerm2 Meta. Standarden ble endret til Alt fordi enkelte programmer, som Emacs, forventer det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de meeste toetsrapportagemodi kan de ⌥-toets, bij het rapporteren van speciale toetsen zoals pijltoetsen, fungeren als Meta of Alt. Vóór versie 3.5.6 gebruikte iTerm2 Meta. De standaardwaarde is gewijzigd in Alt omdat sommige programma’s, zoals Emacs, dit verwachten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W większości trybów raportowania klawiszy, przy raportowaniu klawiszy specjalnych, takich jak strzałki, klawisz ⌥ może działać jako Meta lub Alt. Przed wersją 3.5.6 iTerm2 używał Meta. Wartość domyślna zmieniła się na Alt, ponieważ niektóre programy, takie jak Emacs, tego oczekują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na maioria dos modos de reporte de teclas, ao reportar teclas especiais como as setas, a tecla ⌥ pode atuar como Meta ou Alt. Antes da versão 3.5.6, o iTerm2 usava Meta. O padrão mudou para Alt porque alguns programas, como o Emacs, esperam isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В большинстве режимов передачи клавиш, при сообщении о специальных клавишах, таких как стрелки, клавиша ⌥ может действовать как Meta или как Alt. До версии 3.5.6 iTerm2 использовал Meta. Значение по умолчанию было изменено на Alt, поскольку некоторые программы, например Emacs, ожидают именно его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vo väčšine režimov hlásenia klávesov môže kláves ⌥ pri hlásení špeciálnych klávesov, ako sú šípky, fungovať ako Meta alebo Alt. Pred verziou 3.5.6 iTerm2 používal Meta. Predvolená hodnota sa zmenila na Alt, pretože ho niektoré programy, napríklad Emacs, očakávajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V večini načinov poročanja tipk lahko tipka ⌥ pri poročanju posebnih tipk, kot so puščice, deluje kot Meta ali Alt. Pred različico 3.5.6 je iTerm2 uporabljal Meta. Privzeto je zdaj Alt, ker ga nekateri programi, na primer Emacs, pričakujejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I de flesta lägen för tangentrapportering, när specialtangenter som piltangenterna rapporteras, kan ⌥-tangenten fungera som antingen Meta eller Alt. Före version 3.5.6 använde iTerm2 Meta. Förvalet ändrades till Alt eftersom vissa program, som Emacs, förväntar sig det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu tuş raporlama modunda, oklar gibi özel tuşlar raporlanırken ⌥ tuşu Meta veya Alt gibi davranabilir. 3.5.6 sürümünden önce iTerm2 Meta kullanıyordu. Emacs gibi bazı programlar bunu beklediği için varsayılan Alt olarak değiştirildi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong hầu hết các chế độ báo cáo phím, khi báo cáo các phím đặc biệt như phím mũi tên, phím ⌥ có thể hoạt động như Meta hoặc Alt. Trước phiên bản 3.5.6, iTerm2 dùng Meta. Mặc định đã đổi thành Alt vì một số chương trình như Emacs mong đợi như vậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大多数按键报告模式中，报告方向键等特殊按键时，⌥ 键可能充当 Meta 或 Alt。在 3.5.6 版本之前，iTerm2 使用 Meta。默认值已改为 Alt，因为 Emacs 等某些程序期望如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在大多數按鍵回報模式中，回報方向鍵等特殊按鍵時，⌥ 鍵可能作為 Meta 或 Alt 使用。3.5.6 版之前，iTerm2 使用 Meta。預設值已改為 Alt，因為 Emacs 等某些程式預期如此。"
          }
        }
      }
    },
    "ProfilesKeys.OverrideWarning" : {
      "comment" : "Warning shown when a profile shortcut overrides a global shortcut",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klávesová zkratka, kterou jste nastavili pro tento profil, bude mít přednost před existující globální zkratkou pro stejnou kombinaci kláves."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tastaturgenvej, du har angivet til denne profil, har forrang over en eksisterende genvej til den samme tastekombination i en global genvej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tastenkombination, die Sie für dieses Profil festgelegt haben, hat Vorrang vor einem vorhandenen globalen Shortcut für dieselbe Tastenkombination."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The keyboard shortcut you have set for this profile will take precedence over an existing shortcut for the same key combination in a global shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atajo de teclado que has definido para este perfil tendrá prioridad sobre un atajo existente para la misma combinación de teclas en un atajo global."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle profiilille asettamasi näppäinoikotie on ensisijainen samalle näppäinyhdistelmälle olemassa olevaan yleiseen oikotiehen nähden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccourci clavier que vous avez défini pour ce profil aura la priorité sur un raccourci global existant pour la même combinaison de touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbreviazione da tastiera che hai impostato per questo profilo avrà la precedenza su un’abbreviazione globale esistente per la stessa combinazione di tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルに設定したキーボードショートカットは、同じキーの組み合わせのグローバルショートカットに優先します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로파일에 설정한 키보드 단축키가 전역 단축키에서 같은 키 조합에 지정된 기존 단축키보다 우선합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastatursnarveien du har satt for denne profilen, har forrang over en eksisterende snarvei for samme tastekombinasjon i en global snarvei."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toetscombinatie die je voor dit profiel hebt ingesteld, heeft voorrang op een bestaande algemene toetscombinatie voor dezelfde toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrót klawiszowy ustawiony dla tego profilu będzie mieć pierwszeństwo przed istniejącym skrótem globalnym dla tej samej kombinacji klawiszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atalho de teclado que você definiu para este perfil terá precedência sobre um atalho existente para a mesma combinação de teclas em um atalho global."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комбинация клавиш, заданная для этого профиля, будет иметь приоритет над существующей глобальной комбинацией клавиш с тем же сочетанием клавиш."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klávesová skratka, ktorú ste nastavili pre tento profil, bude mať prednosť pred existujúcou skratkou pre rovnakú kombináciu klávesov v globálnej skratke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bližnjica na tipkovnici, ki ste jo nastavili za ta profil, bo imela prednost pred obstoječo bližnjico za isto kombinacijo tipk v globalni bližnjici."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortkommandot du har angett för den här profilen har företräde framför ett befintligt kortkommando för samma tangentkombination i ett globalt kortkommando."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profil için ayarladığınız klavye kısayolu, genel bir kısayolda aynı tuş birleşimi için var olan kısayola göre öncelikli olacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt bạn đã đặt cho hồ sơ này sẽ được ưu tiên hơn phím tắt toàn cục hiện có cho cùng tổ hợp phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你为此配置文件设置的键盘快捷键将优先于全局快捷键中的同一按键组合的现有快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你為此描述檔設定的鍵盤快速鍵，將優先於全域快速鍵中相同按鍵組合的現有快速鍵。"
          }
        }
      }
    },
