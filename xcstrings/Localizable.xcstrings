        }
      }
    },
    "MenuTip.PinHotkeyWindow" : {
      "comment" : "Menu item help for the ‘Pin Hotkey Window’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Připnuté** okno horké klávesy se po ztrátě fokusu klávesnice automaticky nezavře."
          }
        },
        "da" : {
          "stringUnit" : {
