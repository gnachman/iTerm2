          }
        }
      }
    },
    "StatusPriority.NewPatternInfo" : {
      "comment" : "Informative text of the new priority pattern dialog",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte podřetězec, který se bude porovnávat s textem stavu (bez rozlišení velikosti písmen)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv en delstreng, der skal matches med statusteksten (ignorerer store/små bogstaver)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine Teilzeichenfolge ein, die mit dem Statustext abgeglichen wird (Groß-/Kleinschreibung wird nicht beachtet)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter a substring to match against status text (case-insensitive)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una subcadena para comparar con el texto del estado (no distingue mayúsculas y minúsculas)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita osamerkkijono, jota verrataan tilatekstiin (ei huomioi kirjainkokoa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une sous-chaîne à comparer au texte de l’état (insensible à la casse)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci una sottostringa da confrontare con il testo dello stato (maiuscole/minuscole indifferenti)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータステキストと照合する部分文字列を入力してください (大文字小文字は区別されません)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
