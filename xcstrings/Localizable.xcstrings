    "AdvancedSetting.customTabBarFontSize" : {
      "comment" : "Advanced setting: customTabBarFontSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní velikost písma popisků panelů\nAby se projevila, zapněte volbu „Použít vlastní velikost písma pro popisky panelů?“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriftstørrelse for brugerdefinerede fanemærkater\nFor at det træder i kraft, skal du slå “Brug brugerdefineret skriftstørrelse til fanemærkater?” til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Schriftgröße für Tab-Beschriftungen\nDamit dies wirksam wird, aktivieren Sie „Benutzerdefinierte Schriftgröße für Tab-Beschriftungen verwenden?“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom tab label font size\nFor this to take effect, turn on “Use custom font size for tab labels?”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño de letra personalizado de las etiquetas de pestañas\nPara que surta efecto, activa “¿Usar un tamaño de letra personalizado para las etiquetas de pestañas?”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukautettu välilehtien nimiöiden fonttikoko\nTämän voimaantulo vaatii asetuksen ”Käytetäänkö välilehtien nimiöille mukautettua fonttikokoa?” käyttöönoton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille de police personnalisée des libellés d’onglets\nPour que cela prenne effet, activez « Utiliser une taille de police personnalisée pour les libellés d’onglets ? »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensione personalizzata del font delle etichette dei pannelli\nAffinché abbia effetto, attiva “Usare una dimensione del font personalizzata per le etichette dei pannelli?”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムタブラベルのフォントサイズ\nこれを反映するには、「タブラベルにカスタムフォントサイズを使用しますか?」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 탭 레이블 서체 크기\n이 설정을 적용하려면 “탭 레이블에 사용자 지정 서체 크기를 사용하겠습니까?”를 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egendefinert fontstørrelse for fanenavn\nFor at dette skal tre i kraft, må du slå på «Bruk egendefinert fontstørrelse for fanenavn?»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangepaste lettergrootte voor tabbladlabels\nOm dit door te voeren, schakel je ‘Aangepaste lettergrootte voor tabbladlabels gebruiken?’ in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własny rozmiar czcionki etykiet kart\nAby zadziałał, włącz „Czy używać niestandardowego rozmiaru czcionki etykiet kart?”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho de fonte personalizado do rótulo da aba\nPara que isto tenha efeito, ative “Usar tamanho de fonte personalizado para rótulos de abas?”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер шрифта для пользовательской подписи вкладки\nЧтобы это вступило в силу, включите «Использовать пользовательский размер шрифта для подписей вкладок?»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastná veľkosť písma popisov tabov\nAby sa to prejavilo, zapnite „Použiť vlastnú veľkosť písma pre popisy tabov?“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost pisave oznak zavihkov po meri\nZa uveljavitev vklopite »Ali naj se za oznake zavihkov uporabi velikost pisave po meri?«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassad typsnittsstorlek för fliketiketter\nFör att detta ska gälla måste du aktivera ”Använda egen typsnittsstorlek för fliketiketter?”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel sekme etiketi font boyutu\nBunun etkili olması için “Sekme etiketleri için özel font boyutu kullanılsın mı?” seçeneğini açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cỡ phông chữ tùy chỉnh cho nhãn tab\nĐể có hiệu lực, hãy bật “Dùng cỡ phông chữ tùy chỉnh cho nhãn tab?”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义标签页标签字体大小。\n要生效，请开启“使用自定义字体大小作为标签页标签？”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂標籤頁標籤的字體大小\n若要使其生效，請開啟「標籤頁標籤使用自訂字體大小？」。"
          }
        }
      }
    },
    "AdvancedSetting.darkModeInactiveTabDarkness" : {
      "comment" : "Advanced setting: darkModeInactiveTabDarkness",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tmavost (v rozsahu [0…1]) nevybraných panelů v jiném než minimalistickém motivu v tmavém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
