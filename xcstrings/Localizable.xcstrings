    "StatusBarRPC.InvalidReturnValueFormat" : {
      "comment" : "Error message when a status bar script returns an invalid value; first placeholder is the invocation, second is the returned value",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návratová hodnota z %1$@ je neplatná.\n\nMěla vrátit řetězec nebo seznam řetězců.\n\nMísto toho vrátila:\n\n%2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returværdien fra %1$@ er ugyldig.\n\nDen skulle have returneret en streng eller en liste af strenge.\n\nI stedet returnerede den:\n\n%2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rückgabewert von %1$@ ist ungültig.\n\nEr hätte eine Zeichenfolge oder eine Liste von Zeichenfolgen zurückgeben sollen.\n\nStattdessen wurde Folgendes zurückgegeben:\n\n%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Return value from %1$@ invalid.\n\nIt should have returned a string or a list of strings.\n\nInstead, it returned:\n\n%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor devuelto por %1$@ no es válido.\n\nDebería haber devuelto una cadena o una lista de cadenas.\n\nEn su lugar, devolvió:\n\n%2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktion %1$@ palautusarvo on virheellinen.\n\nSen olisi pitänyt palauttaa merkkijono tai merkkijonojen luettelo.\n\nSen sijaan se palautti:\n\n%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur de retour de %1$@ non valide.\n\nElle aurait dû renvoyer une chaîne ou une liste de chaînes.\n\nElle a renvoyé à la place :\n\n%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore restituito da %1$@ non è valido.\n\nDoveva restituire una stringa o un elenco di stringhe.\n\nHa invece restituito:\n\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ からの戻り値が無効です。\n\n文字列または文字列のリストを返す必要があります。\n\n代わりに、次の値が返されました:\n\n%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 반환 값이 유효하지 않습니다.\n\n문자열 또는 문자열 목록을 반환해야 합니다.\n\n대신 다음 값을 반환했습니다:\n\n%2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returverdien fra %1$@ er ugyldig.\n\nDen skulle ha returnert en streng eller en liste med strenger.\n\nI stedet returnerte den:\n\n%2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geretourneerde waarde van %1$@ is ongeldig.\n\nHet had een tekenreeks of een lijst met tekenreeksen moeten retourneren.\n\nIn plaats daarvan retourneerde het:\n\n%2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprawidłowa wartość zwrócona przez %1$@.\n\nPowinna to być wartość tekstowa lub lista wartości tekstowych.\n\nZwrócono:\n\n%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor de retorno de %1$@ inválido.\n\nEle deveria ter retornado uma string ou uma lista de strings.\n\nEm vez disso, retornou:\n\n%2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недопустимое возвращаемое значение от %1$@.\n\nОно должно было вернуть строку или список строк.\n\nВместо этого было возвращено:\n\n%2$@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Návratová hodnota z %1$@ je neplatná.\n\nMala vrátiť reťazec alebo zoznam reťazcov.\n\nNamiesto toho vrátila:\n\n%2$@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrnjena vrednost iz %1$@ je neveljavna.\n\nVrniti bi morala niz ali seznam nizov.\n\nVrnila pa je:\n\n%2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returvärdet från %1$@ är ogiltigt.\n\nDen borde ha returnerat en sträng eller en lista med strängar.\n\nI stället returnerade den:\n\n%2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ işlevinin döndürdüğü değer geçersiz.\n\nBir dize veya dize listesi döndürmesi gerekirdi.\n\nBunun yerine şunu döndürdü:\n\n%2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị trả về từ %1$@ không hợp lệ.\n\nNó phải trả về một chuỗi hoặc một danh sách chuỗi.\n\nThay vào đó, nó trả về:\n\n%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的返回值无效。\n\n它本应返回字符串或字符串列表。\n\n但实际上返回了：\n\n%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的回傳值無效。\n\n它應該回傳字串或字串列表。\n\n但實際回傳的是：\n\n%2$@"
          }
        }
      }
    },
