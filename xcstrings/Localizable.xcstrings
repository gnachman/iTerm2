    "ClaudeCode.UninstallBody" : {
      "comment" : "Explanation of what uninstalling the Claude Code integration does; the interpolated value is the absolute path to settings.json",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies entfernt den Status-Hook von iTerm2 aus %@, die Claude-Code-Arbeitsgruppe aus Ihren Einstellungen und die Trigger zum Betreten/Verlassen der Arbeitsgruppe aus jedem Profil. Sie können die Integration jederzeit über das iTerm2-Menü erneut einrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This removes iTerm2’s status hook from %@, the Claude Code workgroup from your settings, and the Enter/Exit Workgroup triggers from every profile. You can set up the integration again any time from the iTerm2 menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina el hook de estado de iTerm2 de %@, el grupo de trabajo de Claude Code de tus ajustes y los disparadores Entrar en grupo de trabajo/Salir del grupo de trabajo de todos los perfiles. Puedes volver a configurar la integración en cualquier momento desde el menú de iTerm2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime le hook d’état d’iTerm2 de %@, le groupe de travail Claude Code de vos réglages et les déclencheurs d’entrée/sortie de groupe de travail de chaque profil. Vous pourrez reconfigurer l’intégration à tout moment depuis le menu iTerm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove l’hook di stato di iTerm2 da %@, il gruppo di lavoro di Claude Code dalle tue impostazioni e gli attivatori Entra nel gruppo di lavoro/Esci dal gruppo di lavoro da ogni profilo. Puoi configurare di nuovo l’integrazione in qualsiasi momento dal menu iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、%@からiTerm2のステータスフックが削除され、設定からClaude Codeワークグループが削除され、すべてのプロファイルからワークグループ参加/退出トリガーが削除されます。iTerm2メニューからいつでも連携を再設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 iTerm2의 상태 훅을, 설정에서 Claude Code 워크그룹을, 모든 프로파일에서 워크그룹 진입/종료 트리거를 제거합니다. iTerm2 메뉴에서 언제든지 통합을 다시 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove o hook de status do iTerm2 de %@, o workgroup do Claude Code dos seus ajustes e os gatilhos de entrar/sair do workgroup de todos os perfis. Você pode configurar a integração novamente a qualquer momento pelo menu iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит хук статуса iTerm2 из %@, рабочую группу Claude Code из ваших настроек и триггеры Enter/Exit Workgroup из всех профилей. Снова настроить интеграцию можно в любой момент через меню iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, iTerm2’nin durum kancasını %@ dosyasından, Claude Code çalışma grubunu ayarlarınızdan ve Çalışma Grubuna Gir/Çalışma Grubundan Çık tetikleyicilerini tüm profillerden kaldırır. Entegrasyonu istediğiniz zaman iTerm2 menüsünden yeniden kurabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从 %@ 中移除 iTerm2 的状态钩子，从你的设置中移除 Claude Code 工作组，并从每个配置文件中移除“进入/退出工作组”触发器。你可以随时通过 iTerm2 菜单重新设置该集成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會從 %@ 中移除 iTerm2 的狀態 hook，從你的設定中移除 Claude Code 工作群組，並從每個描述檔中移除「進入／結束工作群組」觸發器。你可以隨時從 iTerm2 選單重新設定此整合功能。"
          }
        }
      }
    },
    "ClaudeCode.UninstallConnectedHost" : {
