    "Tip.0079.Body" : {
      "comment" : "Tip of the day body, id 0079",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⇧⌘., um den Composer zu öffnen. Er bietet Ihnen einen Entwurfsbereich, um einen Befehl zu bearbeiten, bevor Sie ihn an die Shell senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⇧⌘. to open the Composer. It gives you a scratchpad to edit a command before sending it to the shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘.を押すとコンポーザーが開きます。シェルに送信する前にコマンドを編集できるスクラッチパッドです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘.를 누르면 컴포저가 열립니다. 명령을 셸로 보내기 전에 편집할 수 있는 임시 작업 공간입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⇧⌘. para abrir o Compositor. Ele oferece um rascunho para editar um comando antes de enviá-lo ao shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⇧⌘., чтобы открыть Композер. Он предоставляет черновик для редактирования команды перед отправкой её в оболочку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下 ⇧⌘ 可打开 Composer。它提供了一个编辑区域，用于在将命令发送到 shell之前进行修改。"
          }
        }
      }
    },
