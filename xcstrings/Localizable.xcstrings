    "Tip.0062.Body" : {
      "comment" : "Tip of the day body, id 0062",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Profilliste verfügt über ein Suchfeld (zum Beispiel unter „Einstellungen > Profile“). Sie können verschiedene Operatoren verwenden, um Ihre Suchanfrage einzugrenzen. Klicken Sie auf „Mehr erfahren“, um alle Details zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every list of profiles has a search field (e.g., in ”Settings > Profiles.”) You can use various operators to restrict your search query. Click “Learn More” for all the details."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの一覧には必ず検索フィールドがあります(たとえば「設定 > プロファイル」)。さまざまな演算子を使って検索クエリを絞り込めます。詳細は「詳しくはこちら」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 프로파일 목록에는 검색 필드가 있습니다(예: “설정 > 프로파일”). 다양한 연산자를 사용하여 검색어의 범위를 좁힐 수 있습니다. 자세한 내용은 “더 알아보기”를 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda lista de perfis tem um campo de busca (por exemplo, em “Ajustes > Perfis”). Você pode usar vários operadores para restringir sua consulta de busca. Clique em “Saiba mais” para todos os detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каждом списке профилей есть поле поиска (например, в «Настройки > Профили»). Вы можете использовать различные операторы, чтобы уточнить поисковый запрос. Нажмите «Подробнее», чтобы узнать все детали."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个配置文件列表都包含搜索字段（例如在“设置 > 配置文件”中）。你可以使用各种运算符来限制搜索查询。点击“了解更多”可获取所有详情。"
          }
        }
      }
    },
