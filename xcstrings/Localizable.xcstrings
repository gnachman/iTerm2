    "IT2HostGrants.Empty" : {
      "comment" : "Shown in place of the list when no remote hosts are always allowed to use the iTerm2 API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind keine Remote-Hosts dauerhaft erlaubt. Wählen Sie „Diesen Host immer erlauben“, wenn ein Remote-Host anfragt, iTerm2 zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No remote hosts are always allowed. Choose Always Allow This Host when a remote host asks to control iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に許可されているリモートホストはありません。リモートホストがiTerm2の制御を求めてきたときに「このホストを常に許可」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 허용된 원격 호스트가 없습니다. 원격 호스트가 iTerm2 제어를 요청할 때 “이 호스트를 항상 허용”을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum host remoto tem permissão permanente. Escolha “Sempre permitir este host” quando um host remoto pedir para controlar o iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет удалённых хостов, которым всегда разрешён доступ. Выберите «Всегда разрешать этому хосту», когда удалённый хост запросит управление iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有始终允许的远程主机。当远程主机请求控制 iTerm2 时，请选择“始终允许此主机”。"
          }
        }
      }
    },
    "IT2HostGrants.Explanation" : {
      "comment" : "Explanation at the top of the list of remote hosts always allowed to use the iTerm2 API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Hosts können die iTerm2-API über die SSH-Integration verwenden, ohne vorher zu fragen. Wenn Sie einen Host entfernen, fragt er bei der nächsten Verbindung wieder nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These hosts can use the iTerm2 API over SSH integration without asking first. Removing a host makes it ask again the next time it connects."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのホストは、確認なしでSSH統合経由のiTerm2 APIを使用できます。ホストを削除すると、次回接続時に再び確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트들은 묻지 않고 SSH 통합을 통해 iTerm2 API를 사용할 수 있습니다. 호스트를 제거하면 다음에 연결할 때 다시 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes hosts podem usar a API do iTerm2 pela integração de SSH sem perguntar antes. Ao remover um host, ele voltará a perguntar na próxima vez que se conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти хосты могут использовать API iTerm2 через интеграцию по SSH без предварительного запроса. Если убрать хост, он снова запросит разрешение при следующем подключении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些主机无需事先询问即可通过 SSH 集成使用 iTerm2 API。移除某个主机后，它下次连接时会再次询问。"
          }
        }
      }
    },
