    "AdvancedSetting.cmdClickWhenInactiveInvokesSemanticHistory" : {
      "comment" : "Advanced setting: cmdClickWhenInactiveInvokesSemanticHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-Klick in einem aktiven Bereich ruft Semantic History auf, während iTerm2 nicht die aktive App ist.\nStandardmäßig hält sich iTerm2 an den Systemstandard, wonach ein ⌘-Klick in einer App ohne Tastaturfokus sich wie ein Klick ohne ⌘ verhält, der das Fenster nicht in den Vordergrund holt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘-click in an active pane while iTerm2 isn't the active app invokes Semantic History.\nBy default, iTerm2 respects the OS standard that ⌘-click in an app that doesn't have keyboard focus behaves like a non-⌘ click that does not raise the window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 がアクティブなアプリでないときに、アクティブなペインで ⌘ クリックするとセマンティック履歴を呼び出します。\nデフォルトでは、iTerm2 は OS の標準的な動作に従い、キーボードフォーカスを持たないアプリでの ⌘ クリックは、ウィンドウを前面に出さない非 ⌘ クリックと同様に動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 활성 앱이 아닐 때 활성 패널에서 ⌘-클릭하면 시맨틱 히스토리가 실행됩니다.\n기본적으로 iTerm2는 키보드 포커스가 없는 앱에서의 ⌘-클릭이 윈도우를 앞으로 가져오지 않는, ⌘ 없는 클릭처럼 동작하는 OS 표준을 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clique em um painel ativo enquanto o iTerm2 não é o app ativo invoca o Semantic History.\nPor padrão, o iTerm2 respeita o padrão do sistema de que ⌘-clique em um app que não tem o foco do teclado se comporta como um clique sem ⌘ que não traz a janela à frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-щелчок в активной панели, когда iTerm2 не является активным приложением, вызывает Semantic History.\nПо умолчанию iTerm2 соблюдает стандарт ОС, согласно которому ⌘-щелчок в приложении без фокуса клавиатуры ведёт себя как обычный щелчок без ⌘, не поднимающий окно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当iTerm2不是活动应用时，在活动窗格中按⌘键会触发语义历史功能\n默认情况下，iTerm2遵循操作系统标准：非键盘焦点的应用中的⌘键点击不会弹出窗口，行为类似于非⌘的点击。"
          }
        }
      }
    },
    "AdvancedSetting.codeciergeCommandWarningCount" : {
      "comment" : "Advanced setting: codeciergeCommandWarningCount",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dieser Anzahl an Befehlen soll Codecierge bestätigen lassen, dass Sie es weiterhin aktiviert lassen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
