    "APIHelper.DisablePerAppAuthMessage" : {
      "comment" : "Prompt asking whether to disable per-app API authentication",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete všem aplikacím spuštěným v tomto počítači povolit používat Python API?\n\nTím se vypne kontrola oprávnění Automatizace. Pokud souhlasíte, budete požádáni o přístup správce k provedení změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du tillade, at alle apps på denne maskine bruger Python API?\n\nDette slår kontrollen af tilladelsen Automatisering fra. Hvis du accepterer, bliver du bedt om administratoradgang for at foretage ændringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie allen auf diesem Computer laufenden Apps erlauben, die Python-API zu verwenden?\n\nDadurch wird die Überprüfung der Automatisierungsberechtigung deaktiviert. Wenn Sie zustimmen, werden Sie zur Eingabe von Administratorrechten aufgefordert, um die Änderung vorzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do you want to allow all apps running on this machine to use the Python API?\n\nThis will disable the check for Automation permission. If you agree, you’ll be prompted for administrator access to make the change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres permitir que todas las apps que se ejecutan en este equipo usen la API de Python?\n\nEsto desactivará la comprobación del permiso de Automatización. Si aceptas, se te pedirá acceso de administrador para realizar el cambio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko sallia kaikkien tässä koneessa toimivien sovellusten käyttää Python API:a?\n\nTämä poistaa Automaatio-luvan tarkistuksen käytöstä. Jos hyväksyt, sinulta pyydetään järjestelmänvalvojan oikeuksia muutoksen tekemiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous autoriser toutes les apps exécutées sur cette machine à utiliser l’API Python ?\n\nCela désactivera la vérification de l’autorisation d’automatisation. Si vous acceptez, l’accès administrateur vous sera demandé pour effectuer la modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi consentire a tutte le app in esecuzione su questo computer di usare l’API Python?\n\nQuesto disabiliterà il controllo dell’autorizzazione di Automazione. Se accetti, ti verrà richiesto l’accesso come amministratore per applicare la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシン上で動作するすべてのアプリにPython APIの使用を許可しますか？\n\nこれにより、オートメーション権限のチェックが無効になります。同意すると、変更を行うために管理者権限の入力を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 실행 중인 모든 앱이 Python API를 사용하도록 허용하겠습니까?\n\n이렇게 하면 자동화 권한 검사가 비활성화됩니다. 동의하면 변경을 위해 관리자 권한을 요청하는 메시지가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du la alle apper som kjører på denne maskinen bruke Python-API-et?\n\nDette deaktiverer kontrollen av Automatisering-tillatelsen. Hvis du godtar, blir du bedt om administratortilgang for å gjøre endringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je alle apps die op deze computer draaien toestaan de Python-API te gebruiken?\n\nHiermee wordt de controle op de toestemming Automatisering uitgeschakeld. Als je akkoord gaat, wordt om beheerderstoegang gevraagd om de wijziging door te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy chcesz pozwolić wszystkim aplikacjom uruchomionym na tym komputerze na używanie API Pythona?\n\nSpowoduje to wyłączenie sprawdzania uprawnienia Automatyzacja. Jeśli się zgodzisz, zostaniesz poproszony o dostęp administratora, aby wprowadzić zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja permitir que todos os apps em execução nesta máquina usem a API do Python?\n\nIsso desativará a verificação da permissão de Automação. Se você concordar, será solicitado o acesso de administrador para fazer a alteração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить всем приложениям, работающим на этом компьютере, использовать Python API?\n\nЭто отключит проверку разрешения Automation. Если вы согласитесь, вам будет предложено предоставить доступ администратора для внесения изменения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete povoliť všetkým apkám bežiacim na tomto počítači používať Python API?\n\nTýmto sa vypne kontrola povolenia Automatizácia. Ak súhlasíte, budete vyzvaní na zadanie prístupu správcu na vykonanie zmeny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali želite vsem aplikacijam, ki se izvajajo v tem računalniku, dovoliti uporabo API Python?\n\nS tem bo onemogočeno preverjanje dovoljenja za avtomatizacijo. Če se strinjate, boste za izvedbo spremembe pozvani k skrbniškemu dostopu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du tillåta att alla appar som körs på den här datorn använder Python-API:et?\n\nDet avaktiverar kontrollen av behörigheten Automatisering. Om du godkänner uppmanas du ange administratörsåtkomst för att göra ändringen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu makinede çalışan tüm uygulamaların Python API’sini kullanmasına izin vermek istiyor musunuz?\n\nBu, Otomasyon izni denetimini devre dışı bırakır. Kabul ederseniz değişikliği yapmak için yönetici erişimi istenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có muốn cho phép tất cả ứng dụng chạy trên máy này dùng API Python không?\n\nViệc này sẽ tắt kiểm tra quyền Tự động hóa. Nếu bạn đồng ý, bạn sẽ được yêu cầu cấp quyền quản trị để thực hiện thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要允许此机器上运行的所有应用使用 Python API 吗？\n\n这将停用对“自动化”权限的检查。如果你同意，系统将提示你提供管理员访问权限以进行更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要允許此部電腦上執行的所有 App 使用 Python API 嗎？\n\n這將停用對「自動化」權限的檢查。如果你同意，系統將提示你提供管理員取用權限以進行變更。"
          }
        }
      }
    },
