    "BackupUpdate.Message" : {
      "comment" : "Alert shown when the developer has flagged this version's automatic updates as broken; the placeholders are the available version and the installed version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je k dispozici iTerm2 %1$@, ale automatické aktualizace v této verzi (%2$@) nemusí fungovat. Novou verzi si můžete stáhnout z iterm2.com."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
