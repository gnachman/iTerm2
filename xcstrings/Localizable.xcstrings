    "Tip.0082.Body" : {
      "comment" : "Tip of the day body, id 0082",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkazem „Vykreslit výběr“ převedete vybraný text na přehledné zobrazení se zvýrazněním syntaxe, ideální pro JSON, Markdown nebo zdrojový kód. Tato funkce zahrnuje vodorovné posouvání pro pohodlné procházení protokolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdan markeret tekst til en pæn visning med syntaksfremhævning med kommandoen “Gengiv markering”, ideelt til JSON, Markdown eller kildekode. Funktionen omfatter vandret rulning, så det er nemt at navigere i logs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwandeln Sie ausgewählten Text mit dem Befehl „Auswahl rendern“ in eine aufbereitete Ansicht mit Syntaxhervorhebung, ideal für JSON, Markdown oder Quellcode. Diese Funktion umfasst horizontales Scrollen für eine einfache Navigation in Protokollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Transform selected text into a prettified, syntax-highlighted view with the “Render Selection” command, ideal for JSON, Markdown, or source code. This feature includes horizontal scrolling for easy log navigation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforma el texto seleccionado en una vista con formato y resaltado de sintaxis con el comando “Renderizar selección”, ideal para JSON, Markdown o código fuente. Esta función incluye desplazamiento horizontal para navegar cómodamente por los registros."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta valittu teksti muotoilluksi, syntaksikorostetuksi näkymäksi komennolla ”Renderöi valinta”, mikä sopii erinomaisesti JSON-, Markdown- tai lähdekoodille. Ominaisuus sisältää vaakavierityksen lokien helppoon selaamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez le texte sélectionné en une vue mise en forme avec coloration syntaxique grâce à la commande « Afficher le rendu de la sélection », idéale pour le JSON, le Markdown ou le code source. Cette fonctionnalité inclut le défilement horizontal pour faciliter la navigation dans les journaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma il testo selezionato in una vista formattata e con evidenziazione della sintassi con il comando “Esegui rendering della selezione”, ideale per JSON, Markdown o codice sorgente. Questa funzione include lo scorrimento orizzontale per navigare comodamente nei log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「選択範囲をレンダリング」コマンドを使うと、選択したテキストを整形され構文がハイライトされた表示に変換できます。JSON、Markdown、ソースコードなどに最適です。この機能には水平スクロールも含まれており、ログを簡単に閲覧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“선택 영역 렌더링” 명령을 사용하면 선택한 텍스트를 보기 좋게 정리되고 구문이 강조된 보기로 변환할 수 있어 JSON, Markdown 또는 소스 코드에 이상적입니다. 이 기능은 가로 스크롤을 지원하므로 로그를 쉽게 탐색할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør markert tekst om til en pent formatert visning med syntaksutheving med kommandoen «Gjengi markering», ideelt for JSON, Markdown eller kildekode. Denne funksjonen har horisontal rulling for enkel navigering i logger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet geselecteerde tekst om in een opgemaakte weergave met syntaxismarkering met het commando ‘Render selectie’, ideaal voor JSON, Markdown of broncode. Deze functie omvat horizontaal scrollen voor eenvoudig navigeren door logs."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekształć zaznaczony tekst w sformatowany widok z kolorowaniem składni poleceniem „Renderuj zaznaczenie”, idealnym dla JSON, Markdown lub kodu źródłowego. Funkcja obejmuje przewijanie poziome, ułatwiające przeglądanie dzienników."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme o texto selecionado em uma visualização formatada e com destaque de sintaxe usando o comando “Renderizar seleção”, ideal para JSON, Markdown ou código-fonte. Esse recurso inclui rolagem horizontal para facilitar a navegação em logs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразуйте выделенный текст в красиво оформленный вид с подсветкой синтаксиса с помощью команды «Отобразить выделение», которая отлично подходит для JSON, Markdown или исходного кода. Эта функция поддерживает горизонтальную прокрутку для удобной навигации по журналам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte text a príkazom „Vykresliť výber“ ho premeňte na formátované zobrazenie so zvýrazňovaním syntaxe, ideálne pre JSON, Markdown alebo zdrojový kód. Funkcia zahŕňa vodorovné rolovanie na pohodlné prechádzanie záznamov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrano besedilo pretvorite v olepšan pogled z barvnim označevanjem sintakse z ukazom »Upodobi izbor«, kar je idealno za JSON, Markdown ali izvorno kodo. Funkcija vključuje vodoravno pomikanje za lažje brskanje po dnevnikih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvandla markerad text till en snyggt formaterad vy med syntaxmarkering med kommandot ”Rendera markering”, perfekt för JSON, Markdown eller källkod. Funktionen har horisontell rullning för enkel navigering i loggar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili metni “Seçimi İşle” komutuyla biçimlendirilmiş, sözdizimi vurgulu bir görünüme dönüştürün; JSON, Markdown veya kaynak kod için idealdir. Bu özellik, günlüklerde kolay gezinme için yatay kaydırma içerir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển văn bản đã chọn thành chế độ xem được định dạng đẹp, tô sáng cú pháp bằng lệnh “Kết xuất vùng chọn”, lý tưởng cho JSON, Markdown hoặc mã nguồn. Tính năng này có cuộn ngang để dễ điều hướng nhật ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“Render Selection”命令将选中的文本转换为美观且带语法高亮的视图，特别适用于 JSON、Markdown 或源代码。该功能包含水平滚动功能，便于日志导航。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「繪製選取範圍」指令，將選取的文字轉換成美觀、含語法醒目標示的檢視，非常適合 JSON、Markdown 或原始碼。此功能支援水平捲動，方便瀏覽記錄。"
          }
        }
      }
    },
