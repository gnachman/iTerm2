    "StatusBarGit.DebugInfoFormat" : {
      "comment" : "Body of the git status bar debug info alert; placeholders are directory, cadence, enabled flag, seconds since last poll, repo state, and extra debug info",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzeichnis: %1$@\nAbfrageintervall: %2$@ Sek.\nAbfrage aktiviert: %3$@\nLetzte Abfrage vor %4$@ Sekunden\nRepository-Status: %5$@\n%6$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Directory: %1$@\nPolling cadence: %2$@ sec\nPolling enabled: %3$@\nLast polled %4$@ seconds ago\nRepo state: %5$@\n%6$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directorio: %1$@\nFrecuencia de sondeo: %2$@ s\nSondeo activado: %3$@\nÚltimo sondeo hace %4$@ segundos\nEstado del repositorio: %5$@\n%6$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répertoire : %1$@\nCadence d’interrogation : %2$@ s\nInterrogation activée : %3$@\nDernière interrogation il y a %4$@ secondes\nÉtat du dépôt : %5$@\n%6$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Directory: %1$@\nFrequenza di polling: %2$@ s\nPolling abilitato: %3$@\nUltimo polling %4$@ secondi fa\nStato del repository: %5$@\n%6$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディレクトリ: %1$@\nポーリング間隔: %2$@ 秒\nポーリング有効: %3$@\n前回のポーリングから %4$@ 秒経過\nリポジトリの状態: %5$@\n%6$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디렉토리: %1$@\n폴링 주기: %2$@초\n폴링 켜짐: %3$@\n마지막 폴링: %4$@초 전\n저장소 상태: %5$@\n%6$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diretório: %1$@\nCadência de sondagem: %2$@ s\nSondagem ativada: %3$@\nÚltima sondagem há %4$@ segundos\nEstado do repositório: %5$@\n%6$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог: %1$@\nЧастота опроса: %2$@ с\nОпрос включён: %3$@\nПоследний опрос: %4$@ с назад\nСостояние репозитория: %5$@\n%6$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dizin: %1$@\nSorgulama sıklığı: %2$@ sn\nSorgulama etkin: %3$@\nSon sorgulama %4$@ saniye önce\nDepo durumu: %5$@\n%6$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目录: %1$@\n轮询频率: %2$@ 秒\n启用轮询: %3$@\n上次轮询时间: %4$@ 秒前\n仓库状态: %5$@\n%6$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
