    "ClaudeCodeOnboarding.SettingsMalformed" : {
      "comment" : "Body of the alert shown when installing the Claude Code hook fails because settings.json is not valid JSON or is not a JSON object; the interpolated value is the absolute path to settings.json",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor %@ obsahuje chybu syntaxe nebo není objektem JSON, proto jej iTerm2 nezměnil, aby nepřišel o ostatní vaše nastavení Claude Code. Opravte soubor v textovém editoru nebo jej odstraňte a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har en syntaksfejl eller er ikke et JSON-objekt, så iTerm2 lod det være uændret for ikke at miste dine andre Claude Code-indstillinger. Ret arkivet i en teksteditor, eller fjern det, og prøv derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält einen Syntaxfehler oder ist kein JSON-Objekt. iTerm2 hat die Datei daher nicht verändert, damit Ihre übrigen Claude Code-Einstellungen nicht verloren gehen. Korrigieren Sie die Datei in einem Texteditor oder entfernen Sie sie und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ has a syntax error or isn’t a JSON object, so iTerm2 left it unchanged to avoid losing your other Claude Code settings. Fix the file in a text editor, or remove it, and then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene un error de sintaxis o no es un objeto JSON, así que iTerm2 lo dejó sin cambios para no perder el resto de tus ajustes de Claude Code. Corrige el archivo en un editor de texto, o elimínalo, y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostossa %@ on syntaksivirhe tai se ei ole JSON-objekti, joten iTerm2 jätti sen ennalleen, jotta muut Claude Code -asetuksesi eivät katoa. Korjaa tiedosto tekstieditorissa tai poista se ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contient une erreur de syntaxe ou n’est pas un objet JSON, iTerm2 l’a donc laissé inchangé pour éviter de perdre vos autres réglages de Claude Code. Corrigez le fichier dans un éditeur de texte, ou supprimez-le, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contiene un errore di sintassi o non è un oggetto JSON, quindi iTerm2 lo ha lasciato invariato per non perdere le altre impostazioni di Claude Code. Correggi il file in un editor di testo, o rimuovilo, e poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に構文エラーがあるか、JSON オブジェクトではありません。Claude Code のほかの設定が失われないよう、iTerm2 はこのファイルを変更しませんでした。テキストエディタでファイルを修正するか削除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 구문 오류가 있거나 JSON 객체가 아니므로, 다른 Claude Code 설정이 손실되지 않도록 iTerm2가 파일을 변경하지 않았습니다. 텍스트 편집기에서 파일을 수정하거나 제거한 다음 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har en syntaksfeil eller er ikke et JSON-objekt, så iTerm2 lot den være uendret for å unngå å miste de andre innstillingene dine for Claude Code. Rett opp filen i et tekstredigeringsprogram, eller fjern den, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bevat een syntaxisfout of is geen JSON-object, dus iTerm2 heeft het ongewijzigd gelaten om je andere Claude Code-instellingen niet te verliezen. Herstel het bestand in een teksteditor of verwijder het en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pliku %@ jest błąd składni lub nie jest on obiektem JSON, więc iTerm2 pozostawił go bez zmian, aby nie utracić innych ustawień Claude Code. Napraw plik w edytorze tekstu lub usuń go, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem um erro de sintaxe ou não é um objeto JSON, então o iTerm2 o deixou inalterado para não perder suas outras configurações do Claude Code. Corrija o arquivo em um editor de texto, ou remova-o, e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ содержит синтаксическую ошибку или не является объектом JSON, поэтому iTerm2 не стал его изменять, чтобы не потерять остальные настройки Claude Code. Исправьте файл в текстовом редакторе или удалите его, а затем повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor %@ obsahuje syntaktickú chybu alebo nie je objekt JSON, preto ho iTerm2 ponechal bez zmeny, aby neprišiel o vaše ostatné nastavenia Claude Code. Opravte súbor v textovom editore alebo ho odstráňte a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteka %@ vsebuje skladenjsko napako ali ni objekt JSON, zato je iTerm2 ni spremenil, da ne bi izgubil drugih nastavitev za Claude Code. Popravite datoteko v urejevalniku besedila ali jo odstranite in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har ett syntaxfel eller är inte ett JSON-objekt, så iTerm2 lämnade den oförändrad för att inte förlora dina andra Claude Code-inställningar. Åtgärda filen i en textredigerare, eller ta bort den, och försök sedan igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dosyasında sözdizimi hatası var veya bir JSON nesnesi değil; bu yüzden iTerm2 diğer Claude Code ayarlarınızı kaybetmemek için dosyayı değiştirmedi. Dosyayı bir metin düzenleyicide düzeltin veya kaldırın, sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ có lỗi cú pháp hoặc không phải đối tượng JSON, nên iTerm2 đã để nguyên để tránh mất các cài đặt Claude Code khác của bạn. Hãy sửa tệp trong trình soạn thảo văn bản, hoặc xóa nó, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 存在语法错误或不是 JSON 对象，因此 iTerm2 未对其进行更改，以免丢失你的其他 Claude Code 设置。请在文本编辑器中修复该文件或将其删除，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有語法錯誤或不是 JSON 物件，因此 iTerm2 未對其進行變更，以免遺失你其他的 Claude Code 設定。請在文字編輯器中修正該檔案或將其移除，然後再試一次。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.SettingsUnreadable" : {
      "comment" : "Body of the alert shown when installing the Claude Code hook fails because settings.json exists but could not be read; the interpolated value is the absolute path to settings.json",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal přečíst soubor %@, proto jej nezměnil. Zkontrolujte oprávnění k souboru a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke læse %@, så arkivet blev ladet uændret. Kontroller arkivets tilladelser, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte %@ nicht lesen und hat die Datei daher nicht verändert. Prüfen Sie die Dateiberechtigungen und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t read %@, so it left the file unchanged. Check the file’s permissions and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo leer %@, así que dejó el archivo sin cambios. Comprueba los permisos del archivo y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei pystynyt lukemaan tiedostoa %@, joten se jätti tiedoston ennalleen. Tarkista tiedoston käyttöoikeudet ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu lire %@ et a donc laissé le fichier inchangé. Vérifiez les autorisations du fichier et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto leggere %@, quindi ha lasciato il file invariato. Controlla le autorizzazioni del file e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 は %@ を読み込めなかったため、ファイルを変更しませんでした。ファイルのアクセス権を確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 %@을(를) 읽을 수 없어서 파일을 변경하지 않았습니다. 파일의 권한을 확인하고 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke lese %@, så filen ble latt være uendret. Kontroller tillatelsene for filen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kon %@ niet lezen en heeft het bestand ongewijzigd gelaten. Controleer de toestemmingen van het bestand en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie mógł odczytać pliku %@, więc pozostawił go bez zmian. Sprawdź uprawnienia pliku i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu ler %@, então deixou o arquivo inalterado. Verifique as permissões do arquivo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не удалось прочитать %@, поэтому файл не был изменён. Проверьте права доступа к файлу и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal prečítať súbor %@, preto ho ponechal bez zmeny. Skontrolujte prístupové práva súboru a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ni mogel prebrati datoteke %@, zato je ni spremenil. Preverite dovoljenja datoteke in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunde inte läsa %@, så filen lämnades oförändrad. Kontrollera filens behörigheter och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %@ dosyasını okuyamadı; bu yüzden dosyayı değiştirmedi. Dosya izinlerini denetleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 không thể đọc %@, nên đã để nguyên tệp. Hãy kiểm tra quyền của tệp rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法读取 %@，因此未更改该文件。请检查文件的权限，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法讀取 %@，因此未變更該檔案。請檢查該檔案的權限，然後再試一次。"
          }
        }
      }
    },
