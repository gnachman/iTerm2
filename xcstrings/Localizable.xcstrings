        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det är aktiverat får du bekräfta att du vill skicka en radbrytning när du klistrar in en enskild textrad som slutar med radbrytning. Skalintegrering krävs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinse, satır sonuyla biten tek satırlık bir metin yapıştırırken satır sonu göndermek istediğinizi onaylamanız istenir. Kabuk Entegrasyonu gereklidir."
