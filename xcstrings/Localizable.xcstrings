        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée en secondes de l’animation de hauteur de la fenêtre Ouverture rapide.\nDéfinissez 0 pour désactiver l’animation."
          }
        },
        "it" : {
          "stringUnit" : {
