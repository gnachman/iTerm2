    "PseudoTerminal.SessionNotAtPasswordPrompt" : {
      "comment" : "Warning message; %@ is the session name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace s názvem „%@“ zřejmě není u výzvy k heslu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen “%@” ser ikke ud til at være ved en adgangskodeprompt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung „%@“ scheint sich nicht an einem Passwort-Prompt zu befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The session named “%@” does not appear to be at a password prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión llamada “%@” no parece estar en un prompt de contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunto ”%@” ei näytä olevan salasanakehotteessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session nommée « %@ » ne semble pas être à une invite de mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione “%@” non sembra essere a un prompt di password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」という名前のセッションはパスワードプロンプトにないようです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 세션이 암호 프롬프트에 있지 않은 것 같습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økten «%@» ser ikke ut til å være ved en passordledetekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sessie ‘%@’ lijkt niet bij een wachtwoordprompt te staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że sesja „%@” nie jest przy monicie o hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão chamada “%@” não parece estar em um prompt de senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, сеанс с именем «%@» не находится в приглашении ввода пароля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácia „%@“ zrejme nie je pri výzve na heslo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da seja »%@« ni na pozivu za geslo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen ”%@” verkar inte vara vid en lösenordsprompt."
          }
