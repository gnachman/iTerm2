    "Companion.SAS.Body" : {
      "comment" : "Explanatory paragraph on the SAS confirmation screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den 6-stelligen Code ein, der auf Ihrem iPhone angezeigt wird. Damit wird bestätigt, dass Sie mit Ihrem eigenen Telefon koppeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type the 6-digit code shown on your iPhone. This confirms you’re pairing with your own phone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneに表示されている6桁のコードを入力してください。これにより、自分自身のiPhoneとペアリングしていることが確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에 표시된 6자리 코드를 입력하십시오. 본인의 iPhone과 페어링하고 있는지 확인하는 절차입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o código de 6 dígitos exibido no seu iPhone. Isto confirma que você está pareando com o seu próprio telefone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите 6-значный код, показанный на вашем iPhone. Это подтверждает, что вы сопрягаетесь с собственным телефоном."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入iPhone上显示的6位代码。这用于确认您正在与自己的手机配对。"
          }
        }
      }
    },
