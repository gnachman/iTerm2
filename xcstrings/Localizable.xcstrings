    },
    "Tip.0069.Body" : {
      "comment" : "Tip of the day body, id 0069",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in 3.1: Sie können mehrere Hotkey-Fenster verwenden. Jedes Profil kann einen oder mehrere Hotkeys besitzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can have multiple hotkey windows. Each profile can have one or more hotkeys."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1の新機能: 複数のホットキーウィンドウを持てるようになりました。各プロファイルは1つ以上のホットキーを持てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1의 새로운 기능: 여러 개의 단축키 윈도우를 사용할 수 있습니다. 각 프로파일에 하나 이상의 단축키를 지정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode ter várias janelas de atalho. Cada perfil pode ter uma ou mais teclas de atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое в 3.1: у вас может быть несколько окон горячих клавиш. У каждого профиля может быть одна или несколько горячих клавиш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1新功能：你可以拥有多个热键窗口。每个配置文件可以包含一个或多个热键。"
          }
        }
      }
    },
    "Tip.0069.Title" : {
