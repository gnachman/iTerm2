    "AIModelEditor.InvalidHeaderName" : {
      "comment" : "Validation error for an invalid custom HTTP header name; %@ is the name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název vlastní hlavičky „%@“ není platný. Použijte pouze znaky tokenu podle RFC 7230 (písmena, číslice a libovolný ze znaků !#$%%&'*+-.^_`|~)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet på den brugerdefinerede header “%@” er ugyldigt. Brug kun RFC 7230-tokentegn (bogstaver, cifre og et af tegnene !#$%%&'*+-.^_`|~)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der benutzerdefinierte Header-Name „%@“ ist ungültig. Verwenden Sie nur RFC-7230-Token-Zeichen (Buchstaben, Ziffern und die Zeichen !#$%%&'*+-.^_`|~)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom header name “%@” is not valid. Use only RFC 7230 token characters (letters, digits, and any of !#$%%&'*+-.^_`|~)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de encabezado personalizado “%@” no es válido. Usa solo caracteres de token de RFC 7230 (letras, dígitos y cualquiera de !#$%%&'*+-.^_`|~)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukautetun otsakkeen nimi ”%@” ei kelpaa. Käytä vain RFC 7230 -tokenimerkkejä (kirjaimia, numeroita ja mitä tahansa merkeistä !#$%%&'*+-.^_`|~)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d’en-tête personnalisé « %@ » n’est pas valide. Utilisez uniquement des caractères de jeton RFC 7230 (lettres, chiffres et l’un de !#$%%&'*+-.^_`|~)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome di intestazione personalizzata “%@” non è valido. Usa solo caratteri token RFC 7230 (lettere, cifre e uno qualsiasi tra !#$%%&'*+-.^_`|~)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムヘッダー名「%@」は無効です。RFC 7230のトークン文字（英数字、および !#$%%&'*+-.^_`|~ のいずれか）のみを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 헤더 이름 “%@”이(가) 유효하지 않습니다. RFC 7230 토큰 문자(문자, 숫자 및 !#$%%&'*+-.^_`|~ 중 하나)만 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet «%@» på det egendefinerte hodet er ugyldig. Bruk bare tegn tillatt i RFC 7230-tokens (bokstaver, sifre og hvilke som helst av !#$%%&'*+-.^_`|~)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De aangepaste headernaam ‘%@’ is ongeldig. Gebruik alleen RFC 7230-tokentekens (letters, cijfers en een van !#$%%&'*+-.^_`|~)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa własnego nagłówka „%@” jest nieprawidłowa. Używaj wyłącznie znaków tokenu RFC 7230 (litery, cyfry i dowolne z !#$%%&'*+-.^_`|~)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de cabeçalho personalizado “%@” não é válido. Use apenas caracteres de token do RFC 7230 (letras, dígitos e qualquer um de !#$%%&'*+-.^_`|~)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользовательского заголовка «%@» недопустимо. Используйте только символы токена RFC 7230 (буквы, цифры и любые из !#$%%&'*+-.^_`|~)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názov vlastnej hlavičky „%@“ nie je platný. Použite iba znaky tokenu podľa RFC 7230 (písmená, číslice a ktorýkoľvek zo znakov !#$%%&'*+-.^_`|~)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ime glave po meri »%@« ni veljavno. Uporabite samo znake žetonov RFC 7230 (črke, števke in katerega koli od znakov !#$%%&'*+-.^_`|~)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den anpassade rubrikens namn ”%@” är inte giltigt. Använd bara tokentecken enligt RFC 7230 (bokstäver, siffror och något av !#$%%&'*+-.^_`|~)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” özel üst bilgi adı geçerli değil. Yalnızca RFC 7230 token karakterlerini kullanın (harfler, rakamlar ve !#$%%&'*+-.^_`|~ karakterlerinden herhangi biri)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên tiêu đề tùy chỉnh “%@” không hợp lệ. Chỉ dùng các ký tự token của RFC 7230 (chữ cái, chữ số và bất kỳ ký tự nào trong !#$%%&'*+-.^_`|~)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义标题“%@”无效。仅可使用RFC 7230令牌字符（字母、数字以及!#$%%&'*+-.^_`|~）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂標頭名稱「%@」無效。僅可使用 RFC 7230 token 字元（字母、數字，以及 !#$%%&'*+-.^_`|~ 其中任一個）。"
          }
        }
      }
    },
    "AIModelEditor.InvalidHeaderValue" : {
      "comment" : "Validation error for an invalid custom HTTP header value; %@ is the header name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota vlastní hlavičky „%@“ nesmí obsahovat znaky nového řádku ani nulové znaky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdien for den brugerdefinerede header “%@” må ikke indeholde linjeskift eller nul-tegn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wert für den benutzerdefinierten Header „%@“ darf keine Zeilenumbruch- oder Null-Zeichen enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The value for custom header “%@” must not contain newline or null characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor del encabezado personalizado “%@” no debe contener saltos de línea ni caracteres nulos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukautetun otsakkeen ”%@” arvo ei saa sisältää rivinvaihtoja eikä null-merkkejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur de l’en-tête personnalisé « %@ » ne doit pas contenir de saut de ligne ni de caractère nul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore dell’intestazione personalizzata “%@” non deve contenere caratteri di nuova riga o nulli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムヘッダー「%@」の値には、改行文字やヌル文字を含めることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 헤더 “%@”의 값에는 줄바꿈 문자나 null 문자가 포함될 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdien for det egendefinerte hodet «%@» kan ikke inneholde linjeskift eller nulltegn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De waarde voor de aangepaste header ‘%@’ mag geen regeleinden of nultekens bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość własnego nagłówka „%@” nie może zawierać znaków nowego wiersza ani znaków null."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor do cabeçalho personalizado “%@” não pode conter caracteres de nova linha ou nulos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение пользовательского заголовка «%@» не должно содержать символы новой строки или null."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota vlastnej hlavičky „%@“ nesmie obsahovať znaky nového riadka ani nulové znaky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednost glave po meri »%@« ne sme vsebovati znakov za novo vrstico ali ničelnih znakov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värdet för den anpassade rubriken ”%@” får inte innehålla nyradstecken eller nolltecken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” özel üst bilgisinin değeri satır sonu veya null karakterleri içermemelidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị của tiêu đề tùy chỉnh “%@” không được chứa ký tự xuống dòng hoặc ký tự null."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义标题“%@”的值不得包含换行或空字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂標頭「%@」的值不得包含換行或空字元。"
          }
        }
      }
    },
