    "AIConnectionTester.SelfHostedAuthHint" : {
      "comment" : "Advice shown when a request to a self-hosted AI server fails and no credential header is configured; the placeholder is an HTTP header name such as Authorization or x-api-key, and “Custom headers” is the label of a section of the model editor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 hat mit dieser Anfrage keinen API-Schlüssel gesendet. Wenn dieser Endpunkt eine Authentifizierung erfordert, fügen Sie den Header „%@“ unter „Benutzerdefinierte Header“ hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 did not send an API key with this request. If this endpoint requires authentication, add the header “%@” under “Custom headers”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no envió una clave de API con esta solicitud. Si este endpoint requiere autenticación, añade el encabezado “%@” en “Encabezados personalizados”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas envoyé de clé d’API avec cette requête. Si ce point de terminaison exige une authentification, ajoutez l’en-tête « %@ » sous « En-têtes personnalisés »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha inviato una chiave API con questa richiesta. Se questo endpoint richiede l’autenticazione, aggiungi l’intestazione “%@” in “Intestazioni personalizzate”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はこのリクエストでAPIキーを送信しませんでした。このエンドポイントが認証を必要とする場合は、「カスタムヘッダー」に「%@」ヘッダーを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 이 요청에 API 키를 보내지 않았습니다. 이 엔드포인트에 인증이 필요하면 “사용자 지정 헤더” 아래에 “%@” 헤더를 추가하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não enviou uma chave de API com esta solicitação. Se este endpoint exigir autenticação, adicione o cabeçalho “%@” em “Cabeçalhos personalizados”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не отправил ключ API с этим запросом. Если этой конечной точке требуется аутентификация, добавьте заголовок «%@» в разделе «Пользовательские заголовки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 bu istekle birlikte API anahtarı göndermedi. Bu uç nokta kimlik doğrulaması gerektiriyorsa “Özel üst bilgiler” altına “%@” üst bilgisini ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 未随此请求发送 API 密钥。如果此端点需要身份验证，请在“自定义头信息”中添加“%@”头信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 未隨此請求傳送 API 金鑰。如果此端點需要驗證，請在「自訂標頭」中加入標頭「%@」。"
          }
        }
      }
    },
