    "APIHelper.NoCookieSuffix" : {
      "comment" : "Suffix appended when a script did not present a valid cookie; %@ is the base message",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nObwohl Sie sich dafür entschieden haben, Verbindungen automatisch zuzulassen, hat dieses Skript kein gültiges Cookie vorgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@\n\nAlthough you have chosen to allow connections automatically, this script has not presented a valid cookie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAunque has elegido permitir conexiones automáticamente, este script no ha presentado una cookie válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBien que vous ayez choisi d’autoriser les connexions automatiquement, ce script n’a pas présenté de cookie valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nPur avendo scelto di consentire le connessioni automaticamente, questo script non ha presentato un cookie valido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n接続を自動的に許可する設定になっていますが、このスクリプトは有効なCookieを提示していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n연결을 자동으로 허용하도록 선택했지만 이 스크립트가 유효한 쿠키를 제시하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nEmbora você tenha optado por permitir conexões automaticamente, este script não apresentou um cookie válido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nХотя вы разрешили автоматически принимать подключения, этот скрипт не предоставил действительный cookie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBağlantılara otomatik olarak izin vermeyi seçmiş olsanız da bu betik geçerli bir çerez sunmadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n虽然你已选择自动允许连接，但此脚本未提供有效的 cookie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n雖然你已選擇自動允許連線，但此腳本未提供有效的 cookie。"
          }
        }
      }
    },
    "APIHelper.PermissionsChangeErrorHeading" : {
      "comment" : "Heading when changing API permissions fails",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler beim Ändern der API-Berechtigungseinstellung"
          }
        },
