    "Workgroup.ExitOneWorkgroupCloseSessions" : {
      "comment" : "Confirmation; first placeholder is the workgroup name, second is the number of other sessions that will close",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
