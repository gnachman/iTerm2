    "Tip.0101.Body" : {
      "comment" : "Tip of the day body, id 0101",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie LastPass oder 1Password mit dem Passwort-Manager, indem Sie ihn über das Menü neben dem Suchfeld konfigurieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Utilize LastPass or 1Password with the password manager by configuring it in the menu next to the search field."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa LastPass o 1Password con el gestor de contraseñas configurándolo en el menú junto al campo de búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez LastPass ou 1Password avec le gestionnaire de mots de passe en le configurant dans le menu à côté du champ de recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa LastPass o 1Password con il gestore password configurandolo nel menu accanto al campo di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドの横にあるメニューで設定すると、パスワードマネージャーでLastPassや1Passwordを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 필드 옆의 메뉴에서 구성하면 암호 관리자에서 LastPass나 1Password를 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize o LastPass ou o 1Password com o cofre de senhas configurando-o no menu ao lado do campo de busca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте LastPass или 1Password вместе с менеджером паролей, настроив это в меню рядом с полем поиска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama alanının yanındaki menüden yapılandırarak parola yöneticisiyle LastPass veya 1Password kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过在搜索字段旁边的菜单中配置密码管理器 LastPass 或 1Password，即可使用该工具。"
          }
