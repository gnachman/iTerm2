    "Tip.0087.Body" : {
      "comment" : "Tip of the day body, id 0087",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigieren Sie mühelos durch Ihren Befehlsverlauf, indem Sie Zeilen im Terminal mit „benannten Markierungen“ Namen zuweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Navigate your command history effortlessly with “named marks” by assigning names to lines in the terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navega por tu historial de comandos sin esfuerzo con las “marcas con nombre”, asignando nombres a líneas de la terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez sans effort votre historique de commandes avec les « marques nommées » en attribuant des noms à des lignes du terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naviga senza fatica nella cronologia dei comandi con i “contrassegni con nome”, assegnando nomi alle righe del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナル内の行に名前を割り当てる「名前付きマーク」を使うと、コマンド履歴を簡単に移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널의 줄에 이름을 지정하는 “이름 있는 마크”로 명령 기록을 손쉽게 탐색하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue pelo seu histórico de comandos sem esforço com as “marcas nomeadas”, atribuindo nomes a linhas no terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легко перемещайтесь по истории команд с помощью «именованных меток», присваивая имена строкам в терминале."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminaldeki satırlara ad vererek “adlandırılmış işaretlerle” komut geçmişinizde zahmetsizce gezinin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过为终端中的行分配名称，使用“命名标记”轻松导航命令历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為終端機中的行指定名稱，使用「具名標記」輕鬆瀏覽你的指令歷史記錄。"
          }
        }
      }
    },
