    "AdvancedSetting.alertTriggerRateLimit" : {
      "comment" : "Advanced setting: alertTriggerRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratenbegrenzung für Warnmeldungs-Trigger.\nWenn derselbe Trigger mit weniger als diesem Zeitintervall (in Sekunden) zwischen den Auslösungen feuert, wird er unterdrückt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rate limit for Alert triggers.\nIf the same trigger fires with less than this time interval (in seconds) between firings, it will be suppressed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de frecuencia de los disparadores de alerta.\nSi el mismo disparador se activa con un intervalo de tiempo (en segundos) menor que este entre activaciones, se suprimirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de fréquence pour les déclencheurs d’alerte.\nSi le même déclencheur s’active avec un intervalle inférieur à cette durée (en secondes) entre deux activations, il sera ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite di frequenza per gli attivatori Avviso.\nSe lo stesso attivatore scatta con meno di questo intervallo di tempo (in secondi) tra un’attivazione e l’altra, verrà disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラートトリガーのレート制限。\n同じトリガーがこの間隔（秒）未満で連続して発動した場合、抑制されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고 트리거의 빈도 제한.\n같은 트리거가 이 시간 간격(초)보다 짧은 간격으로 실행되면 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa para gatilhos de Alerta.\nSe o mesmo gatilho disparar com menos que este intervalo de tempo (em segundos) entre disparos, ele será suprimido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничение частоты для триггеров типа «Оповещение».\nЕсли один и тот же триггер срабатывает чаще, чем раз в указанный интервал (в секундах), последующие срабатывания подавляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı tetikleyicileri için hız sınırı.\nAynı tetikleyici, tetiklenmeleri arasında bu süreden (saniye cinsinden) kısa bir aralıkla tetiklenirse bastırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert触发器的限制时间。\n如果同一触发器在小于该间隔（以秒为单位）的时间内再次触发，则会被抑制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警示觸發器的速率限制。\n如果同一個觸發器兩次觸發的間隔短於此時間（以秒為單位），就會被抑制。"
          }
        }
      }
    },
