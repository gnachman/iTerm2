        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlaj rozmiar sesji bezpośrednio w tytułach kart, aby mieć wygodny wgląd w informacje na pierwszy rzut oka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiba o tamanho da sessão diretamente nos títulos das abas para uma informação prática à primeira vista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображайте размер сессии прямо в заголовках вкладок для удобной информации на первый взгляд."
          }
        },
        "sk" : {
          "stringUnit" : {
