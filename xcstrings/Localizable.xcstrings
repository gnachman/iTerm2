    "Tip.0001.Body" : {
      "comment" : "Tip of the day body, id 0001",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ansicht > Zeitstempel anzeigen“ zeigt die Uhrzeit (und gegebenenfalls das Datum) an, zu der jede Zeile zuletzt geändert wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“View > Show Timestamps” shows the time (and date, if appropriate) when each line was last modified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Visualización > Mostrar marcas de tiempo” muestra la hora (y la fecha, si procede) en que se modificó por última vez cada línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Présentation > Afficher les horodatages » affiche l’heure (et la date, si nécessaire) de la dernière modification de chaque ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vista > Mostra timestamp” mostra l’ora (e la data, se opportuno) dell’ultima modifica di ogni riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「表示 > タイムスタンプを表示」で、各行が最後に変更された時刻 (必要に応じて日付も) が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“보기 > 타임스탬프 보기”는 각 줄이 마지막으로 수정된 시간(필요한 경우 날짜 포함)을 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Visualizar > Mostrar carimbos de data e hora” mostra a hora (e a data, quando apropriado) em que cada linha foi modificada pela última vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Вид > Показать метки времени» показывает время (а при необходимости и дату) последнего изменения каждой строки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Görüntü > Zaman Damgalarını Göster”, her satırın en son değiştirildiği saati (ve uygunsa tarihi) gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“View > Show Timestamps” 显示每行最后被修改的时间（及日期，如适用）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「顯示方式 > 顯示時間戳記」會顯示每一行最後變更的時間（必要時包含日期）。"
          }
        }
      }
    },
