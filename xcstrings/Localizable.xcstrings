    "SemanticHistory.OpenFileCaveat" : {
      "comment" : "Explanation of the open-file semantic history action",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když aktivujete sémantickou historii na názvu souboru, přidružená aplikace soubor načte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du aktiverer Semantisk historik på et arkivnavn, indlæser den tilknyttede app arkivet."
          }
        },
        "de" : {
          "stringUnit" : {
