    "Tip.0031.Body" : {
      "comment" : "Tip of the day body, id 0031",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weisen Sie einer Regel der Intelligenten Auswahl unter „Einstellungen > Profile > Erweitert > Intelligente Auswahl > Aktionen bearbeiten“ eine Aktion zu. Diese erscheinen im Kontextmenü und überschreiben den Semantischen Verlauf beim ⌘-Klick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Assign an action to a Smart Selection rule in “Settings > Profiles > Advanced > Smart Selection > Edit Actions.” They go in the context menu and override semantic history on ⌘-click."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna una acción a una regla de selección inteligente en “Ajustes > Perfiles > Avanzado > Selección inteligente > Editar acciones”. Aparecen en el menú contextual y reemplazan el historial semántico al hacer clic con ⌘."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez une action à une règle de sélection intelligente dans « Réglages > Profils > Avancé > Sélection intelligente > Modifier les actions ». Elles apparaissent dans le menu contextuel et remplacent l’historique sémantique lors d’un clic avec ⌘."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna un’azione a una regola di selezione intelligente in “Impostazioni > Profili > Avanzate > Selezione intelligente > Modifica azioni”. Compaiono nel menu contestuale e sostituiscono la cronologia semantica con il clic ⌘."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > 詳細 > スマート選択 > アクションを編集」で、スマート選択のルールにアクションを割り当てられます。アクションはコンテキストメニューに表示され、⌘クリック時にはセマンティックヒストリーより優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 고급 > 스마트 선택 > 동작 편집”에서 스마트 선택 규칙에 동작을 지정할 수 있습니다. 지정한 동작은 문맥 메뉴에 나타나며 ⌘-클릭 시 시맨틱 히스토리보다 우선합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atribua uma ação a uma regra de Seleção inteligente em “Ajustes > Perfis > Avançado > Seleção inteligente > Editar ações”. Elas vão para o menu de contexto e substituem o Semantic History ao clicar com ⌘."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначьте действие правилу умного выделения в «Настройки > Профили > Дополнительные > Умное выделение > Изменить действия». Они появляются в контекстном меню и переопределяют семантическую историю при щелчке с ⌘."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ayarlar > Profiller > Gelişmiş > Akıllı Seçim > Eylemleri Düzenle” bölümünde bir Akıllı Seçim kuralına eylem atayın. Eylemler bağlam menüsünde yer alır ve ⌘ basılıyken tıklamada anlamsal geçmişin yerine geçer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 高级 > 智能选取 > 编辑操作”中为智能选取规则分配操作。这些操作会出现在上下文菜单中，通过⌘键点击可以覆盖语义历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 描述檔 > 進階 > 智慧型選取 > 編輯動作」中，可以為智慧型選取規則指定動作。這些動作會出現在快顯選單中，並在按住 ⌘ 按一下時覆蓋語意歷史記錄。"
          }
        }
      }
    },
