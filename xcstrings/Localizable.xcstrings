    "UndoMigration.Message" : {
      "comment" : "Body of the one-time notice shown the first time ⌘Z is pressed while a recently closed session can still be restored",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z nyní odvolává úpravy textu. Chcete-li znovu otevřít právě zavřenou relaci, použijte „Shell > Odvolat zavření“ (⌘⇧T).\n\nCo chcete udělat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z fortryder nu tekstredigering. Hvis du vil genåbne en session, du lige har lukket, skal du bruge Shell ▸ Fortryd lukning (⌘⇧T).\n\nHvad vil du gøre nu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z macht jetzt Texteingaben rückgängig. Um eine gerade geschlossene Sitzung wieder zu öffnen, verwenden Sie Shell ▸ Schließen widerrufen (⌘⇧T).\n\nWas möchten Sie jetzt tun?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘Z now undoes text editing. To reopen a session you just closed, use Shell ▸ Undo Close (⌘⇧T).\n\nWhat would you like to do now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z ahora deshace la edición de texto. Para reabrir una sesión que acabas de cerrar, usa Shell ▸ Deshacer cierre (⌘⇧T).\n\n¿Qué quieres hacer ahora?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z peruu nyt tekstin muokkauksen. Jos haluat avata juuri sulkemasi istunnon uudelleen, käytä kohtaa Komentotulkki ▸ Peru sulkeminen (⌘⇧T).\n\nMitä haluat tehdä nyt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z annule désormais la saisie de texte. Pour rouvrir une session que vous venez de fermer, utilisez Shell ▸ Annuler la fermeture (⌘⇧T).\n\nQue souhaitez-vous faire maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z ora annulla la modifica del testo. Per riaprire una sessione appena chiusa, usa Shell ▸ Annulla chiusura (⌘⇧T).\n\nCosa vuoi fare ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Zは現在、テキスト編集の取り消しに使用されます。閉じたばかりのセッションを再度開くには、シェル ▸ クローズを元に戻す（⌘⇧T）を使用してください。\n\n今すぐどうしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 ⌘Z는 텍스트 편집을 실행 취소합니다. 방금 닫은 세션을 다시 열려면 셸 ▸ 닫기 실행 취소(⌘⇧T)를 사용하십시오.\n\n지금 무엇을 하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z angrer nå tekstredigering. For å åpne en økt du nettopp lukket, bruk «Skall > Angre lukking» (⌘⇧T).\n\nHva vil du gjøre nå?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z maakt nu tekstbewerkingen ongedaan. Om een sessie te heropenen die je zojuist hebt gesloten, gebruik je Shell ▸ Herstel sluiten (⌘⇧T).\n\nWat wil je nu doen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z teraz cofa edycję tekstu. Aby ponownie otworzyć właśnie zamkniętą sesję, użyj Powłoka ▸ Cofnij zamknięcie (⌘⇧T).\n\nCo chcesz teraz zrobić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z agora desfaz a edição de texto. Para reabrir uma sessão que você acabou de fechar, use Shell ▸ Desfazer Fechamento (⌘⇧T).\n\nO que você gostaria de fazer agora?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z теперь отменяет редактирование текста. Чтобы повторно открыть только что закрытую сессию, используйте Shell ▸ Отменить закрытие (⌘⇧T).\n\nЧто вы хотите сделать сейчас?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z teraz odvoláva úpravu textu. Ak chcete znovu otvoriť práve zatvorenú reláciu, použite „Shell > Odvolať zatvorenie“ (⌘⇧T).\n\nČo chcete urobiť teraz?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z zdaj razveljavi urejanje besedila. Če želite znova odpreti pravkar zaprto sejo, uporabite Lupina ▸ Razveljavi zapiranje (⌘⇧T).\n\nKaj želite storiti zdaj?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z ångrar nu textredigering. Om du vill öppna en session du precis stängde igen använder du Skal ▸ Ångra stängning (⌘⇧T).\n\nVad vill du göra nu?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z artık metin düzenlemeyi geri alıyor. Az önce kapattığınız bir oturumu yeniden açmak için Kabuk ▸ Kapatmayı Geri Al (⌘⇧T) komutunu kullanın.\n\nŞimdi ne yapmak istersiniz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z giờ đây hoàn tác việc sửa văn bản. Để mở lại một phiên bạn vừa đóng, hãy dùng Shell ▸ Hoàn tác đóng (⌘⇧T).\n\nBạn muốn làm gì bây giờ?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z 现在用于撤销文本编辑。要重新打开刚关闭的会话，请使用 Shell ▸ 撤销关闭（⌘⇧T）。\n\n您现在想要做什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Z 現在用於還原文字編輯。若要重新打開剛關閉的工作階段，請使用 Shell ▸ 還原關閉（⌘⇧T）。\n\n現在要執行什麼操作？"
          }
        }
      }
    },
