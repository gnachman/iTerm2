    "AdvancedSetting.noSyncDontWarnAboutTmuxPause" : {
      "comment" : "Advanced setting: noSyncDontWarnAboutTmuxPause",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat oznámení, že tmux relaci pozastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul meddelelsen om, at tmux sætter en session på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis, dass tmux eine Sitzung pausiert, unterdrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress announcement that tmux will pause a session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime el anuncio de que tmux pausará una sesión."
          }
        },
        "fi" : {
