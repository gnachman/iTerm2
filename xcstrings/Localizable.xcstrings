    "AdvancedSetting.bufferDepth" : {
      "comment" : "Advanced setting: bufferDepth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an zu puffernden Chunks.\nIm Allgemeinen sind diese Chunks 1024 Byte groß. Ein größerer Wert erhöht die Pufferaufblähung, kann aber bis zu einem gewissen Grad die Leistung im schnellen Pfad für ASCII-Text verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of chunks to buffer.\nIn general, these chunks are 1024 bytes. A larger value increases buffer bloat but—up to a limit—can improve performance in the fast path of ASCII text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de bloques que se guardan en búfer.\nEn general, estos bloques son de 1024 bytes. Un valor mayor aumenta el exceso de búfer pero, hasta cierto límite, puede mejorar el rendimiento en la ruta rápida del texto ASCII."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal de blocs à mettre en tampon.\nEn général, ces blocs font 1024 octets. Une valeur plus élevée augmente la surcharge de tampon mais peut, jusqu’à une certaine limite, améliorer les performances sur le chemin rapide du texte ASCII."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di blocchi da mettere in buffer.\nIn genere questi blocchi sono di 1024 byte. Un valore più alto aumenta il buffer bloat ma, entro un certo limite, può migliorare le prestazioni nel percorso rapido del testo ASCII."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッファリングするチャンクの最大数。\n通常、これらのチャンクは 1024 バイトです。値を大きくするとバッファの肥大化が増えますが、ある程度までは ASCII テキストの高速パスでのパフォーマンスを向上させられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버퍼링할 최대 청크 수.\n일반적으로 청크 하나는 1024바이트입니다. 값이 클수록 버퍼 블로트가 커지지만, 일정 한도까지는 ASCII 텍스트의 빠른 경로 성능을 향상시킬 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de blocos a armazenar em buffer.\nEm geral, esses blocos têm 1024 bytes. Um valor maior aumenta o inchaço do buffer mas, até um limite, pode melhorar o desempenho no caminho rápido de texto ASCII."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество буферизуемых блоков.\nОбычно эти блоки имеют размер 1024 байта. Большее значение увеличивает раздутие буфера, но — до определённого предела — может повысить производительность на быстром пути для ASCII-текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arabelleğe alınacak en fazla parça sayısı.\nGenellikle bu parçalar 1024 bayttır. Daha büyük bir değer arabellek şişmesini artırır ancak bir sınıra kadar hızlı ASCII metin yolunda performansı iyileştirebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大缓冲区块数\n通常这些块为1024字节。较大的数值会增加缓冲区占用，但在限制内可提升ASCII文本的传输性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要緩衝的最大區塊數。\n一般而言，這些區塊為 1024 位元組。較大的值會增加緩衝膨脹，但在一定限度內可提升 ASCII 文字快速路徑的效能。"
          }
        }
      }
    },
