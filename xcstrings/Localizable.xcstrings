            "value" : "Anlamsal geçmiş eşleşmeleri için cmd ile üzerine gelindiğinde URL önizlemesi göster."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị xem trước URL khi rê cmd lên các kết quả khớp lịch sử ngữ nghĩa."
          }
        },
        "zh-Hans" : {
