    "ProfilesColors.ThemeForcesDarkMode" : {
      "comment" : "Warning shown in profile color settings when the app theme is set to a dark theme, which overrides the system appearance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš motiv vždy používá tmavý režim, takže se barvy světlého režimu nepoužijí, dokud motiv nezměníte. Můžete to udělat v části „Nastavení > Vzhled > Obecné > Motiv“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit tema bruger altid mørk tilstand, så farverne til lys tilstand bruges ikke, medmindre du ændrer temaet. Du kan ændre det i Indstillinger > Udseende > Generelt > Tema."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Thema verwendet immer den dunklen Modus, daher werden die Farben für den hellen Modus nicht verwendet, solange Sie das Thema nicht ändern. Sie können es unter Einstellungen > Erscheinungsbild > Allgemein > Thema ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your theme always uses dark mode, so the light mode colors won’t be used unless you change the theme. You can change it in Settings > Appearance > General > Theme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tema siempre usa el modo oscuro, así que los colores del modo claro no se usarán a menos que cambies el tema. Puedes cambiarlo en Ajustes > Apariencia > General > Tema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teemasi käyttää aina tummaa tilaa, joten vaalean tilan värejä ei käytetä, ellet vaihda teemaa. Voit vaihtaa sen kohdassa Asetukset > Ulkoasu > Yleiset > Teema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre thème utilise toujours le mode sombre, les couleurs du mode clair ne seront donc pas utilisées tant que vous ne changerez pas de thème. Vous pouvez le faire dans Réglages > Apparence > Général > Thème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo tema usa sempre la modalità scura, quindi i colori della modalità chiara non verranno usati a meno che tu non cambi il tema. Puoi cambiarlo in Impostazioni > Aspetto > Generali > Tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のテーマは常にダークモードを使用するため、テーマを変更しない限りライトモードの色は使用されません。「設定 > 外観 > 一般 > テーマ」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 테마는 항상 다크 모드를 사용하므로, 테마를 변경하지 않는 한 라이트 모드 색상은 사용되지 않습니다. 설정 > 모양 > 일반 > 테마에서 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temaet ditt bruker alltid mørk modus, så fargene for lys modus brukes ikke med mindre du endrer temaet. Du kan endre det i «Innstillinger > Utseende > Generelt > Tema»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je thema gebruikt altijd de donkere modus, dus de kleuren voor de lichte modus worden niet gebruikt tenzij je het thema wijzigt. Je kunt dit wijzigen in Instellingen > Weergave > Algemeen > Thema."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój motyw zawsze używa trybu ciemnego, więc kolory trybu jasnego nie będą używane, dopóki nie zmienisz motywu. Możesz to zrobić w Ustawienia > Wygląd > Ogólne > Motyw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu tema sempre usa o modo escuro, portanto as cores do modo claro não serão usadas a menos que você altere o tema. Você pode alterá-lo em Ajustes > Aparência > Geral > Tema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая тема всегда использует тёмный режим, поэтому цвета светлого режима не будут использоваться, пока вы не смените тему. Это можно изменить в разделе Настройки > Внешний вид > Общие > Тема."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša téma vždy používa tmavý režim, takže farby svetlého režimu sa nepoužijú, kým tému nezmeníte. Môžete ju zmeniť v časti „Nastavenia > Vzhľad > Všeobecné > Téma“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša tema vedno uporablja temni način, zato barve svetlega načina ne bodo uporabljene, razen če spremenite temo. Spremenite jo lahko v »Nastavitve > Videz > Splošno > Tema«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt tema använder alltid mörkt läge, så färgerna för ljust läge används inte om du inte byter tema. Du kan byta det i ”Inställningar > Utseende > Allmänt > Tema”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temanız her zaman koyu mod kullanıyor, bu nedenle temayı değiştirmediğiniz sürece açık mod renkleri kullanılmaz. Bunu Ayarlar > Görünüm > Genel > Tema bölümünden değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chủ đề của bạn luôn dùng chế độ tối, nên màu của chế độ sáng sẽ không được dùng trừ khi bạn đổi chủ đề. Bạn có thể đổi trong Cài đặt > Giao diện > Chung > Chủ đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前主题始终使用深色模式，因此除非更改主题，否则不会使用浅色模式的颜色。可在“设置”>“外观”>“通用”>“主题”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的主題一律使用深色模式，因此除非變更主題，否則不會使用淺色模式的顏色。你可以在「設定 > 外觀 > 一般 > 主題」中變更。"
          }
        }
      }
    },
