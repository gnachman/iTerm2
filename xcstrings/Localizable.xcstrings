    "ConductorUpload.NameCheckFailed" : {
      "comment" : "Error shown when an upload over SSH integration is stopped because checking for an existing file of the same name failed. The first value is the file name; the second is the reason the check failed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht geprüft werden, ob „%1$@“ auf dem Remote-Host bereits vorhanden ist, daher wurde die Datei nicht hochgeladen: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn’t check whether “%1$@” already exists on the remote host, so it was not uploaded: %2$@"
