    "AdvancedSetting.minimalEdgeDragSize" : {
      "comment" : "Advanced setting: minimalEdgeDragSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Design „Minimal“ können Sie das Fenster verschieben, indem Sie in einem Bereich am Rand nahe der Fensterbegrenzung mit dem Ziehen beginnen. Dies gibt die Größe dieses Bereichs an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, you can move the window by dragging starting in a region on the edge near the window border. This gives the size of that region."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimalテーマでは、ウィンドウの境界に近い端の領域からドラッグを開始してウィンドウを移動できます。この設定はその領域のサイズを指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 테마에서는 윈도우 테두리 근처 가장자리 영역에서 드래그를 시작하여 윈도우를 이동할 수 있습니다. 이 값은 해당 영역의 크기입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, você pode mover a janela arrastando a partir de uma região na borda próxima ao limite da janela. Isto define o tamanho dessa região."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В теме Minimal можно перемещать окно, начав перетаскивание в области у края окна, рядом с его границей. Этот параметр задаёт размер этой области."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在Minimal主题中，可以通过拖动窗口边缘的区域来移动窗口，该区域决定了窗口的大小。"
          }
        }
      }
    },
    "AdvancedSetting.minimalSelectedTabUnderlineProminence" : {
