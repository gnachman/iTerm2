    "PTYSession.HorizontalScrollInfo" : {
      "comment" : "Announcement explaining that horizontal scrolling does not switch tabs while mouse reporting is on",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Maus-Berichterstattung aktiviert ist, wechselt horizontales Scrollen nicht den Tab.\nHalten Sie beim Wischen die Wahltaste gedrückt oder deaktivieren Sie die Berichterstattung für horizontales Scrollen, um Tabs zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When mouse reporting is on, horizontal scrolling does not switch tabs.\nHold option while swiping or disable horizontal scroll reporting to switch tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el informe del ratón está activado, el desplazamiento horizontal no cambia de pestaña.\nMantén pulsada Opción mientras deslizas o desactiva el informe del desplazamiento horizontal para cambiar de pestaña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le signalement de la souris est activé, le défilement horizontal ne change pas d’onglet.\nMaintenez Option pendant le balayage ou désactivez le signalement du défilement horizontal pour changer d’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la segnalazione del mouse è attiva, lo scorrimento orizzontale non cambia pannello.\nTieni premuto Opzione mentre scorri o disattiva la segnalazione dello scorrimento orizzontale per cambiare pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスレポートがオンのとき、横スクロールではタブが切り替わりません。\nタブを切り替えるには、スワイプ中にoptionキーを押し続けるか、横スクロールのレポートを無効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅이 켜져 있으면 가로 스크롤로 탭을 전환할 수 없습니다.\n탭을 전환하려면 Option 키를 누른 채 쓸어넘기거나 가로 스크롤 리포팅을 끄십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o relatório do mouse está ativado, a rolagem horizontal não troca de abas.\nSegure Option ao deslizar ou desative o relatório de rolagem horizontal para trocar de abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда отслеживание мыши включено, горизонтальная прокрутка не переключает вкладки.\nУдерживайте Option при прокрутке или отключите отслеживание горизонтальной прокрутки, чтобы переключать вкладки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare raporlama açıkken yatay kaydırma sekmeleri değiştirmez.\nSekmeleri değiştirmek için kaydırırken Option tuşunu basılı tutun veya yatay kaydırma raporlamasını devre dışı bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启鼠标报告时，水平滚动不会切换标签页。\n按住 Option 键轻扫，或停用水平滚动报告以切换标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟滑鼠回報時，水平捲動不會切換標籤頁。\n輕掃時按住 Option 鍵，或停用水平捲動回報，即可切換標籤頁。"
          }
        }
      }
    },
    "PTYSession.IT2AuthorizationPrompt" : {
      "comment" : "Prompt asking whether to allow a remote session to control iTerm2 via the API; placeholder is the session name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte iTerm2 mittels der API über die SSH-Integration steuern. Die API kann Inhalte von iTerm2 anzeigen und ändern. Für diese Sitzung erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ wants to control iTerm2 using the API over SSH integration. The API can view and modify iTerm2’s contents. Allow it for this session?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quiere controlar iTerm2 con la API a través de la integración con SSH. La API puede ver y modificar el contenido de iTerm2. ¿Permitirlo para esta sesión?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ veut contrôler iTerm2 via l’API par l’intégration SSH. L’API peut voir et modifier le contenu d’iTerm2. L’autoriser pour cette session ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuole controllare iTerm2 tramite l’API con l’integrazione SSH. L’API può visualizzare e modificare il contenuto di iTerm2. Vuoi consentirlo per questa sessione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がSSH統合経由のAPIを使用してiTerm2を制御しようとしています。このAPIはiTerm2の内容を表示・変更できます。このセッションで許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 SSH 통합을 통한 API를 사용하여 iTerm2를 제어하려고 합니다. API는 iTerm2의 내용을 보고 수정할 수 있습니다. 이 세션에 허용하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quer controlar o iTerm2 usando a API pela integração de SSH. A API pode ver e modificar o conteúdo do iTerm2. Permitir isso para esta sessão?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ хочет управлять iTerm2 с помощью API через интеграцию по SSH. API может просматривать и изменять содержимое iTerm2. Разрешить это для данной сессии?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, SSH Entegrasyonu üzerinden API ile iTerm2’yi denetlemek istiyor. API, iTerm2’nin içeriğini görüntüleyebilir ve değiştirebilir. Bu oturum için izin verilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@想要通过 SSH 集成使用 API 控制 iTerm2。此 API 可查看和修改 iTerm2 的内容。是否允许本次会话使用该 API？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 想要透過 SSH 整合使用 API 控制 iTerm2。此 API 可檢視並修改 iTerm2 的內容。要允許此工作階段使用嗎？"
          }
        }
      }
    },
