        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 패널 및 이전 패널 명령이 마지막 사용 시간이 아닌 읽기 순서를 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os comandos Próximo painel e Painel anterior usam a ordem de leitura, não o horário de último uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды «Следующая панель» и «Предыдущая панель» используют порядок чтения, а не время последнего использования."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki Bölme ve Önceki Bölme komutları son kullanım zamanını değil okuma sırasını kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
