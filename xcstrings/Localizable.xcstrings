    "Tip.0103.Body" : {
      "comment" : "Tip of the day body, id 0103",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generujte silná a bezpečná hesla pomocí nové funkce správce hesel pro generování hesel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generer stærke, sikre adgangskoder med adgangskodeadministratorens nye funktion til generering af adgangskoder."
          }
        },
        "de" : {
          "stringUnit" : {
