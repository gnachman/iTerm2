    "ChatViewController.OrchestrationDisabledNotice" : {
      "comment" : "Notice shown when orchestration is disabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orchestrierung deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Orchestration disabled."
          }
        },
        "ja" : {
