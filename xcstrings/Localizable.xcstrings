    "NightlyBuild.OldWarning" : {
      "comment" : "Warning that the nightly build is over 30 days old",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato noční verze je starší než 30 dní. Zvažte brzkou aktualizaci: můžete trpět otřesnými chybami a nic o tom nevědět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne nightly-version er over 30 dage gammel. Overvej at opdatere snart, ellers lider du måske af forfærdelige fejl i salig uvidenhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Nightly Build ist über 30 Tage alt. Erwägen Sie ein baldiges Update: Möglicherweise leiden Sie gerade in seliger Unwissenheit unter schlimmen Fehlern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This nightly build is over 30 days old. Consider updating soon: you may be suffering from awful bugs in blissful ignorance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión nightly tiene más de 30 días. Considera actualizar pronto: puede que estés sufriendo errores terribles sin saberlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä yöversio on yli 30 päivää vanha. Harkitse päivitystä pian: saatat kärsiä kamalista virheistä tietämättäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version nocturne date de plus de 30 jours. Pensez à la mettre à jour bientôt : vous souffrez peut-être de bugs terribles sans le savoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa build nightly ha più di 30 giorni. Valuta di aggiornare presto: potresti soffrire di bug terribili senza saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このNightly Buildは30日以上前のものです。ひどいバグに気づかないまま使っている可能性があるので、早めの更新を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 나이틀리 빌드는 30일이 넘었습니다. 곧 업데이트하는 것이 좋습니다. 모르는 사이에 심각한 버그를 겪고 있을 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette nattlige bygget er over 30 dager gammelt. Vurder å oppdatere snart: du kan ha forferdelige feil uten å vite om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze nightly build is meer dan 30 dagen oud. Overweeg snel bij te werken: misschien heb je last van vervelende bugs zonder het te weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja nightly ma ponad 30 dni. Rozważ szybkie uaktualnienie: możesz błogo nieświadomie cierpieć z powodu okropnych błędów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão nightly tem mais de 30 dias. Considere atualizar em breve: você pode estar sofrendo com bugs terríveis sem saber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой ночной сборке больше 30 дней. Рекомендуем обновиться в ближайшее время: возможно, вы уже страдаете от ужасных ошибок, даже не подозревая об этом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento nočný build je starší ako 30 dní. Zvážte skorú aktualizáciu: v blaženej nevedomosti vás môžu trápiť strašné chyby."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta nočna gradnja je stara več kot 30 dni. Razmislite o čimprejšnji posodobitvi: morda v blaženi nevednosti trpite zaradi hudih napak."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här nattliga versionen är över 30 dagar gammal. Överväg att uppdatera snart: du kan drabbas av förfärliga fel utan att veta om det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gecelik sürüm 30 günden eski. Yakında güncellemeyi düşünün: bilmeden mutlu mutlu korkunç hatalarla uğraşıyor olabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng nightly này đã hơn 30 ngày tuổi. Hãy cân nhắc cập nhật sớm: bạn có thể đang chịu những lỗi khủng khiếp mà không hề hay biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 nightly 构建已超过 30 天。建议尽快更新：你可能在不知不觉中深受严重 bug 之苦。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 nightly 版本已超過 30 天。建議儘快更新：你可能正在不知不覺中受到嚴重錯誤的影響。"
          }
        }
      }
    },
