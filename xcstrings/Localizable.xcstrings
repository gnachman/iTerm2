    "AdvancedSetting.showSessionRestoredBanner" : {
      "comment" : "Advanced setting: showSessionRestoredBanner",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při obnově relace bez obnovení běžícího procesu nakreslit pod obnoveným obsahem banner „Obsah relace obnoven“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en session gendannes uden at gendanne en kørende proces, tegnes et banner med teksten “Sessionens indhold blev gendannet” under det gendannede indhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen einer Sitzung ohne einen laufenden Job ein Banner mit dem Text „Sitzungsinhalt wiederhergestellt“ unter dem wiederhergestellten Inhalt anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When restoring a session without restoring a running job, draw a banner saying “Session Contents Restored” below the restored contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restaurar una sesión sin restaurar un proceso en ejecución, dibuja un banner que dice “Contenido de la sesión restaurado” bajo el contenido restaurado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun istunto palautetaan palauttamatta käynnissä olevaa prosessia, piirrä palautetun sisällön alle banneri, jossa lukee ”Istunnon sisältö palautettu”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la restauration d’une session sans restaurer un processus en cours, dessiner une bannière « Contenu de la session restauré » sous le contenu restauré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si ripristina una sessione senza ripristinare un processo in esecuzione, disegna un banner con la scritta “Contenuto della sessione ripristinato” sotto il contenuto ripristinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のジョブを復元せずにセッションを復元する場合、復元された内容の下に「セッションの内容を復元しました」というバナーを表示する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 작업을 복원하지 않고 세션을 복원할 때, 복원된 내용 아래에 “세션 내용 복원됨” 배너를 그립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en økt gjenopprettes uten at en kjørende prosess gjenopprettes, tegn et banner med teksten «Øktinnhold gjenopprettet» under det gjenopprettede innholdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teken bij het herstellen van een sessie zonder een lopend proces te herstellen een banner met de tekst ‘Sessie-inhoud hersteld’ onder de herstelde inhoud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy przywracaniu sesji bez przywracania działającego procesu rysuj pod przywróconą zawartością baner z napisem „Przywrócono zawartość sesji”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao restaurar uma sessão sem restaurar um processo em execução, desenhar um banner dizendo “Conteúdo da sessão restaurado” abaixo do conteúdo restaurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При восстановлении сеанса без восстановления работающей задачи показывать под восстановленным содержимым баннер с надписью «Содержимое сеанса восстановлено»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri obnove relácie bez obnovy bežiaceho procesu nakresliť pod obnoveným obsahom banner s textom „Obsah relácie bol obnovený“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko se seja obnovi brez obnovitve tekočega procesa, pod obnovljeno vsebino izriši pasico z besedilom »Vsebina seje obnovljena«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en session återställs utan att en process som kördes återställs, rita en banderoll med texten ”Sessionens innehåll återställt” under det återställda innehållet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan bir işlem geri yüklenmeden oturum geri yüklenirken, geri yüklenen içeriğin altına “Oturum İçeriği Geri Yüklendi” yazan bir başlık çiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi khôi phục một phiên mà không khôi phục tiến trình đang chạy, vẽ biểu ngữ “Đã khôi phục nội dung phiên” bên dưới nội dung được khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在恢复会话而不恢复正在运行的作业时，在恢复的内容下方显示“会话内容已恢复”的横幅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復工作階段但未回復執行中的工作時，在回復的內容下方繪製寫著「工作階段內容已回復」的橫幅。"
          }
        }
      }
    },
    "AdvancedSetting.showSuiteNameInDockIcon" : {
      "comment" : "Advanced setting: showSuiteNameInDockIcon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překrýt ikonu v Docku názvem sady při spuštění s -suite.\nKdyž spustíte izolovanou instanci s argumentem -suite, její název se nakreslí přes spodní třetinu ikony v Docku, abyste instance rozlišili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg suitens navn over symbolet i Dock, når appen startes med -suite.\nNår du kører en isoleret instans med argumentet -suite, tegnes dens navn henover den nederste tredjedel af symbolet i Dock, så du kan kende instanserne fra hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Suite-Namen beim Start mit -suite über dem Dock-Symbol einblenden.\nWenn Sie eine isolierte Instanz mit dem Argument -suite ausführen, wird ihr Name über das untere Drittel des Dock-Symbols gezeichnet, damit Sie die Instanzen unterscheiden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Overlay the suite name on the dock icon when launched with -suite.\nWhen you run an isolated instance with the -suite argument, its name is drawn across the lower third of the dock icon so you can tell instances apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superpone el nombre del suite en el icono del Dock cuando se inicia con -suite.\nAl ejecutar una instancia aislada con el argumento -suite, su nombre se dibuja en el tercio inferior del icono del Dock para distinguir las instancias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peitä suite-nimi Dockin kuvakkeella, kun käynnistetty argumentilla -suite.\nKun ajat eristettyä instanssia argumentilla -suite, sen nimi piirretään Dockin kuvakkeen alakolmanneksen poikki, jotta instanssit erottaa toisistaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superposer le nom de la suite sur l’icône du Dock lorsque l’app est lancée avec -suite.\nLorsque vous exécutez une instance isolée avec l’argument -suite, son nom est dessiné sur le tiers inférieur de l’icône du Dock pour distinguer les instances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovrapponi il nome della suite all’icona nel Dock quando si avvia con -suite.\nQuando esegui un’istanza isolata con l’argomento -suite, il suo nome viene disegnato sul terzo inferiore dell’icona nel Dock per distinguere le istanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-suiteで起動したとき、Dockアイコンにスイート名を重ねて表示する。\n-suite引数で独立したインスタンスを実行すると、その名前がDockアイコンの下3分の1に描画され、インスタンスを区別できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-suite로 실행했을 때 Dock 아이콘에 스위트 이름 겹쳐 표시.\n-suite 인수로 격리된 인스턴스를 실행하면 Dock 아이콘의 아래쪽 3분의 1에 이름이 표시되어 인스턴스를 구별할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg suite-navnet over Dock-symbolet når appen startes med -suite.\nNår du kjører en isolert instans med argumentet -suite, tegnes navnet over den nedre tredjedelen av Dock-symbolet slik at du kan se forskjell på instansene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de suitenaam over het Dock-symbool wanneer gestart met -suite.\nWanneer je een geïsoleerde instantie met het argument -suite uitvoert, wordt de naam over het onderste derde deel van het Dock-symbool getekend zodat je instanties kunt onderscheiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakładaj nazwę zestawu na ikonę w Docku po uruchomieniu z -suite.\nGdy uruchamiasz odizolowane wystąpienie z argumentem -suite, jego nazwa jest rysowana w dolnej trzeciej części ikony w Docku, aby można było odróżnić wystąpienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepor o nome do suite no ícone do dock ao iniciar com -suite.\nQuando você executa uma instância isolada com o argumento -suite, o nome dela é desenhado no terço inferior do ícone do dock para que você possa distinguir as instâncias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Накладывать имя набора (suite) на значок в Dock при запуске с параметром -suite.\nПри запуске изолированного экземпляра с аргументом -suite его имя отображается в нижней трети значка в Dock, чтобы можно было отличать экземпляры друг от друга."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť názov sady na ikone v Docku pri spustení s -suite.\nKeď spustíte izolovanú inštanciu s argumentom -suite, jej názov sa vykreslí cez spodnú tretinu ikony v Docku, aby ste inštancie rozlíšili."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekrij ikono v vrstici Dock z imenom zbirke, ko je zagnano z -suite.\nKo zaženete izoliran primerek z argumentom -suite, se njegovo ime izriše čez spodnjo tretjino ikone v vrstici Dock, da primerke ločite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg suffixnamnet över symbolen i Dock när appen startas med -suite.\nNär du kör en isolerad instans med argumentet -suite ritas dess namn över den nedre tredjedelen av symbolen i Dock så att du kan skilja instanserna åt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-suite ile başlatıldığında suite adını Dock simgesinin üzerine bindir.\n-suite bağımsız değişkeniyle yalıtılmış bir örnek çalıştırdığınızda, örnekleri ayırt edebilmeniz için adı Dock simgesinin alt üçte birine çizilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phủ tên suite lên biểu tượng Dock khi khởi chạy với -suite.\nKhi bạn chạy một phiên bản tách biệt với đối số -suite, tên của nó được vẽ ngang một phần ba phía dưới của biểu tượng Dock để bạn phân biệt các phiên bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 -suite 参数启动时，在窗口栏图标上显示套件名称。\n当使用 -suite 参数运行独立实例时，其名称会显示在窗口栏图标的下三分之一位置，以便区分不同实例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 -suite 啟動時，在 Dock 圖像上疊加 suite 名稱。\n當你以 -suite 引數執行獨立的實例時，其名稱會繪製在 Dock 圖像下方三分之一處，方便區分不同的實例。"
          }
        }
      }
    },
    "AdvancedSetting.showURLPreviewForSemanticHistory" : {
      "comment" : "Advanced setting: showURLPreviewForSemanticHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit náhled URL při najetí s Cmd na shody sémantické historie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis eksempel på URL ved Kommando-svæv for forekomster i semantisk historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-Vorschau beim Bewegen der Maus bei gedrückter cmd-Taste über Treffer der Semantic History anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show URL preview on cmd-hover for semantic history matches."
