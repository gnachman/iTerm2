    "AdvancedSetting.warnAboutSecureKeyboardInputWithOpenCommand" : {
      "comment" : "Advanced setting: warnAboutSecureKeyboardInputWithOpenCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornit, pokud se zdá, že příkaz `open` selhal při zapnutém zabezpečeném zadávání z klávesnice?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar, hvis kommandoen `open` ser ud til at mislykkes, når sikker tastaturindtastning er slået til?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnen, wenn der Befehl `open` bei aktivierter sicherer Tastatureingabe zu scheitern scheint?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warn if the `open` command appears to fail when secure keyboard input is enabled?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Advertir si el comando `open` parece fallar cuando la entrada segura de teclado está activada?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoitetaanko, jos `open`-komento näyttää epäonnistuvan, kun suojattu näppäimistösyöttö on käytössä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertir si la commande `open` semble échouer lorsque l’entrée clavier sécurisée est activée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisare se il comando `open` sembra non riuscire quando l’inserimento sicuro da tastiera è attivo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュアキーボード入力が有効なときに`open`コマンドが失敗したように見える場合、警告しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 키보드 입력이 켜져 있을 때 `open` 명령이 실패한 것으로 보이면 경고하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar hvis kommandoen `open` ser ut til å mislykkes når sikker tastaturinntasting er aktivert?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwen als het commando `open` lijkt te mislukken wanneer beveiligde toetsenbordinvoer is ingeschakeld?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ostrzegać, gdy polecenie `open` wydaje się nie działać przy włączonym bezpiecznym wprowadzaniu z klawiatury?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar se o comando `open` parecer falhar quando a entrada de teclado segura estiver ativada?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждать, если команда `open` не срабатывает при включённом безопасном вводе с клавиатуры?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorniť, ak príkaz `open` zrejme zlyhá, keď je zapnuté zabezpečené zadávanie z klávesnice?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozori, če ukaz `open` očitno ne uspe, ko je vklopljen varen vnos s tipkovnico?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varna om kommandot `open` verkar misslyckas när säker tangentbordsinmatning är aktiverad?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli klavye girişi etkinken `open` komutu başarısız olacak gibi göründüğünde uyarılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo nếu lệnh `open` có vẻ không thành công khi bật nhập bằng bàn phím an toàn?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在启用安全键盘输入时，如果 `open` 命令似乎失败，是否发出警告？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用安全鍵盤輸入時，如果 `open` 指令似乎失敗，則發出警告？"
          }
        }
      }
    },
