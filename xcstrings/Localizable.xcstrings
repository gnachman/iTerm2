          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Map voor downloads.\nAls dit is ingesteld, komen gedownloade bestanden op deze locatie terecht in plaats van in de map $HOME/Downloads van de gebruiker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder pobranych plików.\nJeśli ustawiony, pobrane pliki trafiają w to miejsce zamiast do folderu $HOME/Downloads użytkownika."
          }
        },
        "pt-BR" : {
