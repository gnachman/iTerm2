    "Tip.0002.Body" : {
      "comment" : "Tip of the day body, id 0002",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wussten Sie, dass iTerm2 einen Passwort-Manager hat? Öffnen Sie ihn über „Fenster > Passwort-Manager“. Sie können einen Trigger definieren, der ihn bei einer Passwortabfrage automatisch öffnet, unter „Einstellungen > Profile > Erweitert > Trigger“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Did you know iTerm2 has a password manager? Open it with “Window > Password Manager.” You can define a Trigger to open it for you at a password prompt in “Settings > Profiles > Advanced > Triggers.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 にパスワードマネージャーがあるのをご存知ですか? 「ウインドウ > パスワードマネージャー」から開けます。「設定 > プロファイル > 詳細 > トリガー」でトリガーを定義すれば、パスワードプロンプトで自動的に開かせることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2에 암호 관리자가 있다는 것을 알고 있었습니까? “윈도우 > 암호 관리자”로 열 수 있습니다. “설정 > 프로파일 > 고급 > 트리거”에서 암호 프롬프트가 나타날 때 암호 관리자를 열어 주는 트리거를 정의할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sabia que o iTerm2 tem um cofre de senhas? Abra-o em “Janela > Cofre de senhas”. Você pode definir um gatilho para abri-lo automaticamente em um prompt de senha em “Ajustes > Perfis > Avançado > Gatilhos”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаете ли вы, что в iTerm2 есть менеджер паролей? Откройте его через «Окно > Менеджер паролей». Вы можете настроить триггер, который будет открывать его автоматически при появлении запроса пароля, в «Настройки > Профили > Дополнительно > Триггеры»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道 iTerm2 有密码管理器吗？通过“Window > Password Manager”打开它。你可以在“Settings > Profiles > Advanced > Triggers”中定义触发器，在密码输入提示时自动打开它。"
          }
        }
      }
    },
