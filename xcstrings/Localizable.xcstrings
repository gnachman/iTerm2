    "Tip.0106.Body" : {
      "comment" : "Tip of the day body, id 0106",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie detaillierte Informationen zu Befehlen, indem Sie bei gedrückter ⌘-Taste auf die Eingabeaufforderung klicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Get detailed information about commands by ⌘-clicking on the command prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén información detallada sobre los comandos haciendo ⌘-clic en el prompt de comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez des informations détaillées sur les commandes en cliquant avec ⌘ sur l’invite de commande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni informazioni dettagliate sui comandi facendo clic con ⌘ sul prompt dei comandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドプロンプトを⌘クリックすると、コマンドに関する詳細情報を取得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 프롬프트를 ⌘-클릭하면 명령에 관한 자세한 정보를 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenha informações detalhadas sobre comandos com ⌘-clique no prompt de comando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте подробную информацию о командах, щёлкая с ⌘ по приглашению оболочки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut istemine ⌘ basılıyken tıklayarak komutlar hakkında ayrıntılı bilgi alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
