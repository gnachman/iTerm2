        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ **La comprobación de seguridad de la IA marcó este comando como potencialmente peligroso. Revísalo con cuidado.**\n\n"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
