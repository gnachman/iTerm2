      }
    },
    "AdvancedSetting.openUntitledFile" : {
      "comment" : "Advanced setting: openUntitledFile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřít nové okno po kliknutí na ikonu v Docku, když nejsou otevřena žádná okna, a také při spuštění aplikace, když nejsou otevřena žádná jiná okna?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn et nyt vindue, når du klikker på symbolet i Dock, og der ikke er nogen åbne vinduer, og også ved start af appen, når der ikke er andre åbne vinduer?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Fenster öffnen, wenn Sie auf das Dock-Symbol klicken und keine Fenster geöffnet sind, sowie beim Start der App, wenn keine anderen Fenster geöffnet sind?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open a new window when you click the dock icon and no windows are already open, and also on app launch when no other windows are open?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Abrir una ventana nueva al hacer clic en el icono del Dock cuando no hay ventanas abiertas, y también al iniciar la app cuando no hay otras ventanas abiertas?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avataanko uusi ikkuna, kun klikataan Dockin kuvaketta eikä ikkunoita ole auki, ja myös sovellusta käynnistettäessä, kun muita ikkunoita ei ole auki?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir une nouvelle fenêtre lorsque vous cliquez sur l’icône du Dock alors qu’aucune fenêtre n’est ouverte, et aussi au lancement de l’app lorsqu’aucune autre fenêtre n’est ouverte ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprire una nuova finestra quando fai clic sull’icona nel Dock e non ci sono finestre aperte, e anche all’avvio dell’app quando non ci sono altre finestre aperte?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウが開いていない状態でDockアイコンをクリックしたとき、およびアプリ起動時に他のウィンドウが開いていないとき、新しいウィンドウを開くか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려 있는 윈도우가 없을 때 Dock 아이콘을 클릭하거나, 다른 윈도우가 열려 있지 않은 상태로 앱을 실행하면 새로운 윈도우를 열겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne et nytt vindu når du klikker på Dock-symbolet og ingen vinduer er åpne fra før, og også ved oppstart av appen når ingen andre vinduer er åpne?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nieuw venster openen wanneer je op het Dock-symbool klikt en er nog geen vensters open zijn, en ook bij het opstarten van de app wanneer er geen andere vensters open zijn?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy otwierać nowe okno po kliknięciu ikony w Docku, gdy nie ma otwartych okien, a także przy uruchomieniu aplikacji, gdy nie ma innych otwartych okien?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir uma nova janela quando você clica no ícone do dock e nenhuma janela está aberta, e também ao iniciar o app quando nenhuma outra janela está aberta?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывать новое окно при щелчке по значку в Dock, если нет открытых окон, а также при запуске приложения, если нет других открытых окон?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoriť nové okno po kliknutí na ikonu v Docku, keď nie je otvorené žiadne okno, a tiež pri spustení aplikácie, keď nie sú otvorené žiadne iné okná?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se odpre novo okno ob kliku ikone v vrstici Dock, ko ni odprtega nobenega okna, in tudi ob zagonu aplikacije, ko ni odprtih drugih oken?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna ett nytt fönster när du klickar på symbolen i Dock och inga fönster redan är öppna, och även vid appstart när inga andra fönster är öppna?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock simgesine tıklandığında ve hiç pencere açık değilken, ayrıca uygulama açılışında başka pencere açık değilken yeni pencere açılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở cửa sổ mới khi bạn bấm biểu tượng Dock mà chưa có cửa sổ nào mở, và cả khi mở ứng dụng mà chưa có cửa sổ nào khác?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击窗口栏图标时打开新窗口，且当前没有其他窗口打开？以及应用启动时如果没有其他窗口也适用？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下 Dock 圖像且沒有任何視窗打開時，以及 App 啟動且沒有其他視窗打開時，是否打開新視窗？"
          }
        }
      }
    },
    "AdvancedSetting.optimumTabWidth" : {
      "comment" : "Advanced setting: optimumTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferovaná šířka panelu, když mají panely stejnou velikost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
