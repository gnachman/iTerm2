    "NaggingController.PasteBracketingLeftOn" : {
      "comment" : "Prompt asking whether to turn off paste bracketing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als sei der Paste-Bracketing-Modus aktiviert geblieben, als eine ssh-Sitzung unerwartet endete oder sich eine App falsch verhalten hat. Ausschalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like paste bracketing was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが予期せず終了したか、アプリが誤動作したため、ペーストブラケッティングがオンのままになっているようです。オフにしますか?"
          }
