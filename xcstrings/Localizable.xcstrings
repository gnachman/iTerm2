    "AdvancedSetting.alwaysAcceptFirstMouse" : {
      "comment" : "Advanced setting: alwaysAcceptFirstMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy přijímat první událost myši v oknech terminálu.\nZnamená to, že kliknutí fungují stejně, když je iTerm2 aktivní, jako když je neaktivní. Pro hlášení myši při prvním kliknutí existuje samostatné nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptér altid den første musehændelse i terminalvinduer.\nDet betyder, at klik virker på samme måde, når iTerm2 er aktiv, som når den er inaktiv. Bemærk, at der er en separat indstilling for musrapportering ved første musehændelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer das erste Mausereignis in Terminalfenstern akzeptieren.\nDas bedeutet, dass Klicks unabhängig davon, ob iTerm2 aktiv oder inaktiv ist, gleich funktionieren. Beachten Sie, dass es eine separate Einstellung für die Maus-Berichterstattung beim ersten Klick gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always accept first mouse event on terminal windows.\nThis means clicks will work the same when iTerm2 is active as when it’s inactive. Note that there is a separate setting for mouse reporting on first mouse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar siempre el primer evento de ratón en las ventanas de terminal.\nEsto significa que los clics funcionarán igual cuando iTerm2 esté activo que cuando esté inactivo. Ten en cuenta que hay un ajuste independiente para el informe del ratón en el primer clic."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy aina ensimmäinen hiiritapahtuma päätteen ikkunoissa.\nTämä tarkoittaa, että klikkaukset toimivat samoin iTerm2:n ollessa aktiivinen kuin sen ollessa epäaktiivinen. Huomaa, että hiiren raportoinnille ensimmäisessä hiiritapahtumassa on erillinen asetus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours accepter le premier événement de souris sur les fenêtres de terminal.\nLes clics fonctionneront ainsi de la même façon qu’iTerm2 soit actif ou inactif. Notez qu’il existe un réglage distinct pour le signalement de la souris au premier clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accetta sempre il primo evento del mouse sulle finestre del terminale.\nQuesto significa che i clic funzionano allo stesso modo quando iTerm2 è attivo e quando è inattivo. Nota che esiste un’impostazione separata per la segnalazione del mouse al primo clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルウィンドウで常に最初のマウスイベントを受け付ける。\nこれにより、iTerm2がアクティブな場合も非アクティブな場合も、クリックが同じように動作します。なお、最初のマウスイベントでのマウスレポートについては別の設定があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 윈도우에서 항상 첫 번째 마우스 이벤트를 수락합니다.\niTerm2가 활성 상태일 때와 비활성 상태일 때 클릭이 똑같이 작동합니다. 첫 번째 마우스 이벤트에 대한 마우스 리포팅은 별도의 설정이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godta alltid første museklikk i terminalvinduer.\nDette betyr at klikk fungerer likt når iTerm2 er aktiv som når den er inaktiv. Merk at det finnes en egen innstilling for museknapprapportering ved første klikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accepteer altijd de eerste muisgebeurtenis in terminalvensters.\nHierdoor werken klikken hetzelfde wanneer iTerm2 actief is als wanneer het inactief is. Let op: voor muisrapportage bij de eerste muisklik is er een aparte instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze akceptuj pierwsze zdarzenie myszy w oknach terminala.\nOznacza to, że kliknięcia działają tak samo, gdy iTerm2 jest aktywny, jak gdy jest nieaktywny. Pamiętaj, że istnieje osobne ustawienie raportowania myszy przy pierwszym kliknięciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre aceitar o primeiro evento de mouse em janelas do terminal.\nIsso significa que os cliques funcionarão da mesma forma quando o iTerm2 estiver ativo e quando estiver inativo. Observe que há um ajuste separado para relatório de mouse no primeiro clique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда принимать первое событие мыши в окнах терминала.\nЭто означает, что щелчки будут работать одинаково независимо от того, активен iTerm2 или нет. Обратите внимание, что для отчётов о первом событии мыши есть отдельная настройка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy prijať prvú udalosť myši v oknách terminálu.\nZnamená to, že kliknutia budú fungovať rovnako, keď je iTerm2 aktívny, ako keď je neaktívny. Hlásenie myši pri prvom kliknutí má samostatné nastavenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedno sprejmi prvi dogodek miške v oknih terminala.\nTo pomeni, da kliki delujejo enako, ko je iTerm2 aktiven, kot ko je neaktiven. Za poročanje miške ob prvem kliku obstaja ločena nastavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptera alltid den första musklicken i terminalfönster.\nDet betyder att klick fungerar likadant när iTerm2 är aktivt som när det är inaktivt. Observera att det finns en separat inställning för musrapportering vid första musklicket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal pencerelerindeki ilk fare olayını her zaman kabul et.\nBu, iTerm2 etkinken tıklamaların etkin değilken olduğu gibi çalışacağı anlamına gelir. İlk fare olayında fare raporlama için ayrı bir ayar bulunduğunu unutmayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn chấp nhận sự kiện chuột đầu tiên trên cửa sổ terminal.\nNghĩa là bấm chuột hoạt động giống nhau dù iTerm2 đang hoạt động hay không. Lưu ý rằng có một cài đặt riêng cho báo cáo chuột ở lần bấm đầu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终接受终端窗口上的第一个鼠标事件。  \n这意味着在 iTerm2 运行期间，无论是否激活该软件，点击操作效果相同。请注意，针对第一个鼠标事件还有单独的鼠标报告设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一律接受終端機視窗上的第一次滑鼠事件。\n這表示 iTerm2 在使用中與非使用中時，按一下的運作方式相同。請注意，第一次滑鼠事件的滑鼠回報另有獨立的設定。"
          }
        }
      }
    },
