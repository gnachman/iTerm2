    "ToolStatus.SnoozeButtonTooltipSnooze" : {
      "comment" : "Tooltip for the snooze button when a session is selected and can be snoozed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložit vybranou relaci, aby klesla na konec seznamu a byla ztlumená, dokud se její stav nezmění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snooze den valgte session, så den synker ned nederst på listen og dæmpes, indtil dens status ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versetzt die ausgewählte Sitzung in den Schlummerzustand, sodass sie ans Ende der Liste rutscht und abgedunkelt wird, bis sich ihr Status ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Snooze the selected session so it sinks to the bottom of the list and dims until its status changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pospón la sesión seleccionada para que baje al final de la lista y se atenúe hasta que cambie su estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torkuta valittu istunto, niin se vajoaa listan loppuun ja himmenee, kunnes sen tila muuttuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reportez la session sélectionnée pour qu’elle descende en bas de la liste et soit estompée jusqu’à ce que son état change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posticipa la sessione selezionata: scende in fondo all’elenco e viene attenuata finché il suo stato non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したセッションをスヌーズすると、リストの最後に移動し、ステータスが変化するまで薄暗く表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 세션을 다시 알림으로 설정하여 상태가 바뀔 때까지 목록 맨 아래로 내리고 흐리게 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slumre den markerte økten, så den havner nederst i listen og dempes til statusen endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de geselecteerde sessie sluimeren, zodat ze onderaan de lijst komt en gedimd wordt tot de status verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odłóż zaznaczoną sesję, aby przeniosła się na koniec listy i była przyciemniona do czasu zmiany jej stanu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adie a sessão selecionada para que ela afunde para o fim da lista e escureça até que seu status mude."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отложить выбранный сеанс, чтобы он опустился в конец списка и был затемнён до изменения его статуса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložiť vybranú reláciu, aby sa presunula na koniec zoznamu a zjemnila, kým sa nezmení jej stav."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dremež za izbrano sejo: potisne se na dno seznama in je zatemnjena do spremembe stanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snooza den markerade sessionen så att den sjunker längst ned i listan och tonas ned tills dess status ändras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili oturumu ertele; durumu değişene kadar listenin en altına iner ve soluklaşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạm hoãn phiên đã chọn để nó chìm xuống cuối danh sách và mờ đi cho đến khi trạng thái của nó thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停所选会话，使其沉在列表底部并变暗直至状态变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對所選工作階段稍後提醒，讓它移到列表底部並調暗，直到狀態變更為止。"
          }
        }
      }
    },
