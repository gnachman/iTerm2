    "AdvancedSetting.updateScreenParamsDelay" : {
      "comment" : "Advanced setting: updateScreenParamsDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung nach Änderung der Bildschirmanzahl/-auflösung bis zur Aktualisierung (Sekunden).\nDies umgeht Betriebssystemfehler, bei denen es nach einer Bildschirmänderung eine gewisse Zeit dauert, bevor Fenster gefahrlos in der Größe geändert werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay after changing number of screens/resolution until refresh (seconds).\nThis works around OS bugs where it takes some time after a screen change before it is safe to resize windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retraso hasta la actualización tras cambiar el número de pantallas/resolución (segundos).\nEvita errores del sistema operativo por los que pasa un tiempo tras un cambio de pantalla hasta que es seguro redimensionar ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai d’actualisation après un changement du nombre d’écrans ou de la résolution (secondes).\nCela contourne des bogues du système où un certain temps s’écoule après un changement d’écran avant qu’il soit sûr de redimensionner les fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo dopo la modifica del numero di schermi/risoluzione prima dell’aggiornamento (secondi).\nAggira i bug del sistema operativo per cui, dopo una modifica agli schermi, passa un po’ di tempo prima che sia sicuro ridimensionare le finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面数や解像度を変更してから再描画するまでの遅延（秒）。\nこれは、画面変更後にウィンドウのサイズ変更が安全になるまで時間がかかるというOSのバグを回避するためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 수/해상도 변경 후 새로 고칠 때까지의 지연 시간(초).\n화면이 변경된 후 윈도우 크기를 안전하게 조절할 수 있을 때까지 시간이 걸리는 OS 버그를 우회합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso após alterar o número de telas/resolução até a atualização (segundos).\nIsso contorna erros do sistema em que leva algum tempo após uma mudança de tela antes de ser seguro redimensionar janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержка после изменения количества экранов или разрешения до обновления (в секундах).\nЭто обходит ошибки ОС, из-за которых после изменения экрана требуется время, прежде чем можно безопасно изменять размер окон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran sayısı/çözünürlüğü değiştikten sonra yenilemeye kadar gecikme (saniye).\nBu, bir ekran değişikliğinden sonra pencereleri yeniden boyutlandırmanın güvenli hâle gelmesinin bir süre aldığı işletim sistemi hatalarına geçici çözümdür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改屏幕数/分辨率后的刷新延迟时间（秒）。  \n针对操作系统中的漏洞，屏幕更换后需要一段时间才能安全调整窗口大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變更螢幕數量/解析度後，到重新整理之前的延遲（秒）。\n這可解決作業系統的錯誤：螢幕變更後需要一段時間，才能安全地調整視窗大小。"
          }
        }
      }
    },
    "AdvancedSetting.urlHandlerCommand" : {
      "comment" : "Advanced setting: urlHandlerCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl, der beim Öffnen einer angeklickten URL ausgeführt wird, statt das Betriebssystem darum zu bitten, sie zu öffnen.\nWenn nicht leer, läuft dieser Befehl als stille Hintergrundaufgabe über /bin/sh -c, sobald Sie eine URL anklicken (einschließlich OSC-8-Hyperlinks und automatisch erkannter URLs), die iTerm2 andernfalls an das System übergeben würde. Dies ist eine interpolierte Zeichenfolge; verwenden Sie \\(url) für die URL und \\(background) dafür, ob ein Öffnen im Hintergrund angefordert wurde (1, wenn beim Klicken die Wahltaste gedrückt gehalten wurde, sonst 0). Der Befehl ist dafür verantwortlich, die URL nach Belieben zu öffnen (z. B. „open -g \\(url)“, um im Hintergrund zu öffnen). Wenn leer, werden URLs normal geöffnet. iTerm2-interne Schemata (iterm2:), einem Profil zugeordnete URL-Schemata und Dateilinks der Semantic History sind davon nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to run when opening a clicked URL, instead of asking the OS to open it.\nWhen non-empty, this command runs as a silent background task via /bin/sh -c whenever you click a URL (including OSC 8 hyperlinks and auto-detected URLs) that iTerm2 would otherwise hand to the system. This is an interpolated string; use \\(url) for the URL and \\(background) for whether a background open was requested (1 if you held option while clicking, otherwise 0). The command is responsible for opening the URL however it likes (e.g., “open -g \\(url)” to open in the background). When empty, URLs open normally. iTerm2-internal schemes (iterm2:), URL schemes bound to a profile, and Semantic History file links are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando que se ejecuta al abrir una URL en la que se hace clic, en lugar de pedirle al sistema operativo que la abra.\nCuando no está vacío, este comando se ejecuta como tarea silenciosa en segundo plano mediante /bin/sh -c cada vez que haces clic en una URL (incluidos hiperenlaces OSC 8 y URLs detectadas automáticamente) que iTerm2 entregaría de otro modo al sistema. Es una cadena interpolada; usa \\(url) para la URL y \\(background) para saber si se pidió abrir en segundo plano (1 si mantuviste pulsada Opción al hacer clic, de lo contrario 0). El comando se encarga de abrir la URL como quiera (p. ej., “open -g \\(url)” para abrirla en segundo plano). Si está vacío, las URLs se abren con normalidad. No afecta a los esquemas internos de iTerm2 (iterm2:), a los esquemas de URL vinculados a un perfil ni a los enlaces a archivos del historial semántico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande à exécuter à l’ouverture d’une URL cliquée, au lieu de demander au système de l’ouvrir.\nSi non vide, cette commande s’exécute comme tâche silencieuse en arrière-plan via /bin/sh -c chaque fois que vous cliquez sur une URL (y compris les liens hypertexte OSC 8 et les URL détectées automatiquement) qu’iTerm2 transmettrait sinon au système. C’est une chaîne interpolée ; utilisez \\(url) pour l’URL et \\(background) pour savoir si une ouverture en arrière-plan a été demandée (1 si vous avez maintenu Option en cliquant, sinon 0). La commande se charge d’ouvrir l’URL comme elle l’entend (par exemple « open -g \\(url) » pour ouvrir en arrière-plan). Si vide, les URL s’ouvrent normalement. Les schémas internes à iTerm2 (iterm2:), les schémas d’URL liés à un profil et les liens de fichiers de l’historique sémantique ne sont pas affectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando da eseguire quando si apre un URL su cui si è fatto clic, invece di chiedere al sistema operativo di aprirlo.\nSe non è vuoto, questo comando viene eseguito come attività silenziosa in background tramite /bin/sh -c ogni volta che fai clic su un URL (inclusi i link OSC 8 e gli URL rilevati automaticamente) che iTerm2 passerebbe altrimenti al sistema. È una stringa interpolata; usa \\(url) per l’URL e \\(background) per indicare se è stata richiesta un’apertura in background (1 se hai tenuto premuto Opzione durante il clic, altrimenti 0). Il comando è responsabile di aprire l’URL come preferisce (ad es. “open -g \\(url)” per aprirlo in background). Se vuoto, gli URL si aprono normalmente. Gli schemi interni di iTerm2 (iterm2:), gli schemi URL associati a un profilo e i link a file della Cronologia semantica non sono interessati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックしたURLを開く際に、OSに開かせる代わりに実行するコマンド。\n空でない場合、iTerm2がシステムに渡すはずだったURL（OSC 8ハイパーリンクや自動検出されたURLを含む）をクリックするたびに、このコマンドが/bin/sh -c経由でサイレントなバックグラウンドタスクとして実行されます。これは補間文字列であり、URLには\\(url)を、バックグラウンドで開くことが要求されたかどうか（クリック時にoptionキーを押していた場合は1、それ以外は0）には\\(background)を使用します。このコマンドは、好きな方法でURLを開く責任を負います（例えば、バックグラウンドで開くには「open -g \\(url)」など）。空の場合、URLは通常どおり開きます。iTerm2内部のスキーム（iterm2:）、プロファイルに紐付けられたURLスキーム、およびセマンティックヒストリーのファイルリンクには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭한 URL을 열 때 OS에 요청하는 대신 실행할 명령.\n비어 있지 않으면 iTerm2가 시스템에 넘겨주었을 URL(OSC 8 하이퍼링크 및 자동 감지된 URL 포함)을 클릭할 때마다 이 명령이 /bin/sh -c를 통해 조용한 백그라운드 작업으로 실행됩니다. 이 값은 보간 문자열입니다. URL에는 \\(url)을, 백그라운드 열기 요청 여부에는 \\(background)를 사용하십시오(클릭할 때 Option을 누르고 있었으면 1, 그렇지 않으면 0). URL을 원하는 방식으로 여는 것은 명령이 담당합니다(예: 백그라운드에서 열려면 “open -g \\(url)”). 비어 있으면 URL이 평소대로 열립니다. iTerm2 내부 스킴(iterm2:), 프로파일에 연결된 URL 스킴, 시맨틱 히스토리 파일 링크는 영향을 받지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando a executar ao abrir uma URL clicada, em vez de pedir ao sistema para abri-la.\nQuando não vazio, este comando é executado como uma tarefa silenciosa em segundo plano via /bin/sh -c sempre que você clica em uma URL (incluindo hyperlinks OSC 8 e URLs detectadas automaticamente) que o iTerm2 normalmente entregaria ao sistema. Esta é uma string interpolada; use \\(url) para a URL e \\(background) para indicar se uma abertura em segundo plano foi solicitada (1 se você segurou option ao clicar, caso contrário 0). O comando é responsável por abrir a URL como preferir (por exemplo, “open -g \\(url)” para abrir em segundo plano). Quando vazio, as URLs abrem normalmente. Esquemas internos do iTerm2 (iterm2:), esquemas de URL vinculados a um perfil e links de arquivos do Semantic History não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда, которая выполняется при открытии URL по клику, вместо того чтобы поручать это ОС.\nЕсли задано, эта команда выполняется как тихая фоновая задача через /bin/sh -c при каждом клике по URL (включая гиперссылки OSC 8 и автоматически распознанные URL), который иначе iTerm2 передал бы системе. Это интерполированная строка; используйте \\(url) для URL и \\(background) для указания, был ли запрошен фоновый режим открытия (1, если при клике удерживалась клавиша Option, иначе 0). Команда сама отвечает за то, как открыть URL (например, «open -g \\(url)» откроет его в фоновом режиме). Если поле пустое, URL открываются как обычно. Это не затрагивает внутренние схемы iTerm2 (iterm2:), схемы URL, привязанные к профилю, и ссылки на файлы Semantic History."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıklanan bir URL açılırken, işletim sisteminden açmasını istemek yerine çalıştırılacak komut.\nBoş değilse, iTerm2’nin normalde sisteme devredeceği bir URL’ye (OSC 8 bağlantıları ve otomatik algılanan URL’ler dahil) tıkladığınızda bu komut /bin/sh -c ile sessiz bir arka plan görevi olarak çalışır. Bu ara değerli bir dizedir; URL için \\(url), arka planda açma istenip istenmediği için \\(background) kullanın (tıklarken Option tuşunu basılı tuttuysanız 1, aksi halde 0). Komut, URL’yi istediği gibi açmaktan sorumludur (örn. arka planda açmak için “open -g \\(url)”). Boşsa URL’ler normal şekilde açılır. iTerm2’nin dahili şemaları (iterm2:), bir profile bağlı URL şemaları ve Anlamsal Geçmiş dosya bağlantıları etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击URL后运行的命令，而非让操作系统打开它。  \n当该值为非空时，每次点击URL（包括OSC 8超链接和自动检测到的URL）都会通过 /bin/sh -c 作为静默后台任务运行此命令。这是插值字符串；使用 \\(url) 表示URL，\\(background) 表示是否请求后台打开（按选项键点击时为1，否则为0）。该命令可按照任意方式打开URL（例如“open -g \\(url)”在后台打开）。当为空时，URL正常打开。iTerm2内部协议、绑定到配置文件的URL协议以及语义历史文件链接不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開按一下的 URL 時要執行的指令，而不是請作業系統打開。\n不為空時，每當你按一下 iTerm2 原本會交給系統處理的 URL（包括 OSC 8 超連結和自動偵測到的 URL），就會透過 /bin/sh -c 以靜默背景工作的方式執行此指令。這是插值字串；使用 \\(url) 表示 URL，使用 \\(background) 表示是否要求在背景打開（按一下時按住 Option 為 1，否則為 0）。該指令負責以任何方式打開 URL（例如，「open -g \\(url)」會在背景打開）。為空時，URL 會正常打開。iTerm2 內部的配置（iterm2:）、繫結至描述檔的 URL 配置，以及語意歷史記錄的檔案連結不受影響。"
          }
        }
      }
    },
    "AdvancedSetting.useAdaptiveFrameRate" : {
      "comment" : "Advanced setting: useAdaptiveFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptive Bildwiederholrate verwenden.\nBei geringem Durchsatz wird der Bildschirm mit 60 Bildern pro Sekunde aktualisiert. Bei höherem Durchsatz sinkt sie auf eine konfigurierbare Rate (standardmäßig 15 fps)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use adaptive framerate.\nWhen throughput is low, the screen will update at 60 frames per second. When throughput is higher, it will drop to a configurable rate (15 fps by default)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa velocidad de fotogramas adaptativa.\nCuando el rendimiento es bajo, la pantalla se actualizará a 60 fotogramas por segundo. Cuando es mayor, bajará a una velocidad configurable (15 fps de forma predeterminada)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser la fréquence d’images adaptative.\nLorsque le débit est faible, l’écran se met à jour à 60 images par seconde. Lorsque le débit est plus élevé, la fréquence descend à une valeur configurable (15 ips par défaut)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la frequenza fotogrammi adattiva.\nQuando il throughput è basso, lo schermo si aggiorna a 60 fotogrammi al secondo. Quando è più alto, scende a una frequenza configurabile (15 fps per impostazione predefinita)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートを使用します。\nスループットが低い場合、画面は毎秒60フレームで更新されます。スループットが高い場合は、設定可能なレート（デフォルトは15fps）まで低下します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임 속도 사용.\n처리량이 적으면 화면이 초당 60프레임으로 업데이트됩니다. 처리량이 많으면 설정 가능한 속도(기본값 15fps)로 낮아집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar taxa de quadros adaptável.\nQuando a vazão é baixa, a tela será atualizada a 60 quadros por segundo. Quando a vazão é maior, ela cairá para uma taxa configurável (15 fps por padrão)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать адаптивную частоту кадров.\nПри низкой пропускной способности экран будет обновляться с частотой 60 кадров в секунду. При более высокой пропускной способности частота снизится до настраиваемого значения (по умолчанию 15 кадров в секунду)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlamalı kare hızı kullan.\nVeri akışı düşükken ekran saniyede 60 kare güncellenir. Veri akışı yüksekken yapılandırılabilir bir hıza düşer (varsayılan 15 fps)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自适应帧率。  \n当吞吐量较低时，屏幕以每秒60帧更新；当吞吐量较高时，可降至可配置速率（默认15 fps）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自適應影格速率。\n輸送量低時，螢幕會以每秒 60 個影格更新。輸送量較高時，會降到可設定的速率（預設為 15 fps）。"
          }
        }
      }
    },
    "AdvancedSetting.useBlackFillerColorForTmuxInFullScreen" : {
