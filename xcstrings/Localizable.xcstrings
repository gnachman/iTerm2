        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3를 기본 색 공간으로 사용하겠습니까? 아니요인 경우 sRGB가 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
