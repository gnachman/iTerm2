    "ConductorUpload.NameCheckFailed" : {
      "comment" : "Error shown when an upload over SSH integration is stopped because checking for an existing file of the same name failed. The first value is the file name; the second is the reason the check failed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se ověřit, zda soubor „%1$@“ na vzdáleném hostiteli již existuje, proto nebyl nahrán: %2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke kontrollere, om “%1$@” allerede findes på den eksterne vært, så arkivet blev ikke overført: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht geprüft werden, ob „%1$@“ auf dem Remote-Host bereits vorhanden ist, daher wurde die Datei nicht hochgeladen: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn’t check whether “%1$@” already exists on the remote host, so it was not uploaded: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo comprobar si “%1$@” ya existe en el host remoto, por lo que no se subió: %2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei voitu tarkistaa, onko tiedosto ”%1$@” jo olemassa etäpalvelimella, joten sitä ei lähetetty: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de vérifier si « %1$@ » existe déjà sur l’hôte distant. Le fichier n’a donc pas été téléversé : %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile verificare se “%1$@” esista già sull’host remoto, quindi non è stato caricato: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートホストに“%1$@”が既に存在するかどうかを確認できなかったため、アップロードしませんでした: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 호스트에 “%1$@”이(가) 이미 있는지 확인할 수 없어 업로드하지 않았습니다: %2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke sjekke om «%1$@» allerede finnes på den eksterne verten, så den ble ikke lastet opp: %2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet controleren of ‘%1$@’ al bestaat op de externe host, dus het is niet geüpload: %2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się sprawdzić, czy plik „%1$@” już istnieje na zdalnym hoście, więc nie został wysłany: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar se “%1$@” já existe no host remoto, então o arquivo não foi enviado: %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить, существует ли «%1$@» на удалённом хосте, поэтому файл не был отправлен: %2$@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa overiť, či súbor „%1$@“ už na vzdialenom hostiteľovi existuje, preto nebol odoslaný: %2$@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni bilo mogoče preveriti, ali datoteka »%1$@« že obstaja na oddaljenem gostitelju, zato ni bila naložena: %2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte kontrollera om ”%1$@” redan finns på fjärrvärden, så den överfördes inte: %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzak ana makinede “%1$@” dosyasının zaten var olup olmadığı denetlenemedi, bu yüzden yüklenmedi: %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kiểm tra xem “%1$@” đã tồn tại trên máy chủ từ xa chưa, nên chưa tải lên: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检查“%1$@”是否已存在于远程主机上，因此未上传：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法檢查「%1$@」是否已存在於遠端主機上，因此未上傳：%2$@"
          }
        }
      }
    },
