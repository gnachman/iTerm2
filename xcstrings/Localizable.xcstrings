    "BrowserErrorHandler.CannotConnectMessage" : {
      "comment" : "Error message: cannot connect to host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann keine sichere Verbindung zum Server herstellen. Der Server ist möglicherweise nicht erreichbar oder offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can’t establish a secure connection to the server. The server may be down or unreachable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はサーバーとの安全な接続を確立できません。サーバーがダウンしているか、到達できない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 서버에 보안 연결을 설정할 수 없습니다. 서버가 다운되었거나 연결할 수 없는 상태일 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não consegue estabelecer uma conexão segura com o servidor. O servidor pode estar fora do ar ou inacessível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может установить безопасное соединение с сервером. Возможно, сервер недоступен или не работает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法建立与服务器的安全连接。服务器可能已关闭或不可访问。"
          }
        }
      }
    },
