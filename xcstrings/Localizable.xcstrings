    "PasteboardReporter.ConfirmEnableBody" : {
      "comment" : "Warning body shown before enabling clipboard reporting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Melden des Inhalts der Zwischenablage an Apps, die innerhalb von iTerm2 ausgeführt werden, kann vertrauliche Informationen wie Passwörter offenlegen. Überlegen Sie sich gut, ob Sie dies aktivieren möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reporting the content of the clipboard to apps running inside iTerm2 may expose sensitive information such as passwords. Think carefully before enabling this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informar del contenido del portapapeles a las apps que se ejecutan dentro de iTerm2 puede exponer información sensible, como contraseñas. Piénsalo bien antes de activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler le contenu du presse-papiers aux apps exécutées dans iTerm2 peut exposer des informations sensibles, comme des mots de passe. Réfléchissez bien avant de l’activer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnalare il contenuto degli Appunti alle app in esecuzione in iTerm2 può esporre informazioni sensibili, come le password. Rifletti bene prima di abilitarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの内容をiTerm2内で実行されているアプリに報告すると、パスワードなどの機密情報が漏洩する可能性があります。有効にする前によく検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 안에서 실행 중인 앱에 클립보드 내용을 보고하면 암호 같은 민감한 정보가 노출될 수 있습니다. 켜기 전에 신중히 생각하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar o conteúdo da área de transferência para apps em execução dentro do iTerm2 pode expor informações confidenciais, como senhas. Pense bem antes de ativar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передача содержимого буфера обмена приложениям, запущенным внутри iTerm2, может раскрыть конфиденциальную информацию, например пароли. Хорошо подумайте, прежде чем включать эту функцию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pano içeriğini iTerm2 içinde çalışan uygulamalara bildirmek, parolalar gibi hassas bilgileri açığa çıkarabilir. Bunu etkinleştirmeden önce dikkatle düşünün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将剪贴板内容报告给在 iTerm2 内运行的应用可能会暴露密码等敏感信息。启用前请慎重考虑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將剪貼簿內容回報給在 iTerm2 內執行的 App，可能會暴露密碼等敏感資訊。啟用前請審慎考慮。"
          }
        }
      }
    },
