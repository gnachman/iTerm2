    "Tmux.OpenTitleTab" : {
      "comment" : "Prompt to open a new tmux tab or use the default profile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Sitzung ist eine tmux-Sitzung. Möchten Sie einen neuen tmux-Tab erstellen oder das Standardprofil verwenden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The current session is a tmux session. Would you like to create a new tmux tab or use the default profile?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のセッションはtmuxセッションです。新規tmuxタブを作成しますか、それともデフォルトプロファイルを使用しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 세션은 tmux 세션입니다. 새로운 tmux 탭을 만들겠습니까, 아니면 기본 프로파일을 사용하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão atual é uma sessão tmux. Você quer criar uma nova aba tmux ou usar o perfil padrão?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий сеанс является сеансом tmux. Хотите создать новую вкладку tmux или использовать профиль по умолчанию?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前会话是一个 tmux 会话。您想要创建新的 tmux 标签页或使用默认配置文件吗？"
          }
        }
      }
    },
