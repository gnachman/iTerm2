    "UvMigration.CompatibilityNote" : {
      "comment" : "Trailing note in the startup warning shown when migration bumps a script’s pinned Python version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-Versionen sind zwischen Releases nicht immer kompatibel, daher benötigt ein aktualisiertes Skript möglicherweise kleine Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Python versions are not always compatible across releases, so a bumped script may need small changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones de Python no siempre son compatibles entre versiones, por lo que un script actualizado puede necesitar pequeños cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les versions de Python ne sont pas toujours compatibles d’une version à l’autre, un script mis à niveau peut donc nécessiter de petites modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le versioni di Python non sono sempre compatibili tra una release e l’altra, quindi uno script aggiornato potrebbe richiedere piccole modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythonのバージョンはリリース間で必ずしも互換性があるとは限らないため、バージョンが上がったスクリプトには軽微な変更が必要になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 버전은 릴리스 간에 항상 호환되지는 않으므로, 버전이 올라간 스크립트는 약간 수정해야 할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
