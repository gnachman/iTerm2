            "state" : "translated",
            "value" : "Komponent stavovej lišty „%1$@“ (%2$@) zlyhal.\n\nVolanie tejto funkcie spôsobilo chybu:\n\n%3$@\n\nChyba:\n\n%4$@\n\n%5$@"
          }
        },
        "sl" : {
