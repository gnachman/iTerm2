    "NaggingController.OrphanRestored" : {
      "comment" : "Announcement that an already-running session was restored without saved contents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese bereits laufende Sitzung wurde wiederhergestellt, aber ihr Inhalt wurde nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This already-running session was restored but its contents were not saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión que ya se estaba ejecutando se restauró, pero su contenido no se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
