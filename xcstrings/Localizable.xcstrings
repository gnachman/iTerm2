    "Tip.0064.Body" : {
      "comment" : "Tip of the day body, id 0064",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro text ASCII a jiný než ASCII můžete mít samostatné písmo. Zapněte to v „Nastavení > Profily > Text“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan have en separat skrift til ASCII og ikke-ASCII-tekst. Slå det til i “Indstillinger > Profiler > Tekst”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können für ASCII- und Nicht-ASCII-Text jeweils eine eigene Schriftart verwenden. Aktivieren Sie dies unter „Einstellungen > Profile > Text“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can have a separate font for ASCII versus non-ASCII text. Enable it in “Settings > Profiles > Text.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes tener un tipo de letra distinto para el texto ASCII y el no ASCII. Actívalo en “Ajustes > Perfiles > Texto”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit käyttää eri fonttia ASCII- ja ei-ASCII-tekstille. Ota se käyttöön kohdassa ”Asetukset > Profiilit > Teksti”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser une police distincte pour le texte ASCII et non ASCII. Activez cette option dans « Réglages > Profils > Texte »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi usare un font diverso per il testo ASCII e per quello non ASCII. Abilitalo in “Impostazioni > Profili > Testo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASCII文字と非ASCII文字で別々のフォントを使用できます。「設定 > プロファイル > テキスト」で有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASCII 텍스트와 비ASCII 텍스트에 별도의 서체를 사용할 수 있습니다. “설정 > 프로파일 > 텍스트”에서 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ha en egen font for ASCII-tekst og tekst som ikke er ASCII. Slå det på i «Innstillinger > Profiler > Tekst»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een apart lettertype gebruiken voor ASCII- en niet-ASCII-tekst. Schakel dit in via ‘Instellingen > Profielen > Tekst’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz mieć osobną czcionkę dla tekstu ASCII i innego niż ASCII. Włącz to w „Ustawienia > Profile > Tekst”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode ter uma fonte separada para texto ASCII e não ASCII. Ative isso em “Ajustes > Perfis > Texto”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете использовать отдельные шрифты для ASCII и не-ASCII текста. Включите это в «Настройки > Профили > Текст»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre text ASCII a text mimo ASCII môžete mať samostatné písmo. Zapnite to v časti „Nastavenia > Profily > Text“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za besedilo ASCII in besedilo, ki ni ASCII, lahko uporabite različni pisavi. Omogočite to v »Nastavitve > Profili > Besedilo«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ha ett separat typsnitt för ASCII och icke-ASCII-text. Aktivera det i ”Inställningar > Profiler > Text”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASCII ve ASCII olmayan metin için ayrı bir font kullanabilirsiniz. “Ayarlar > Profiller > Metin” bölümünden etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể dùng phông chữ riêng cho văn bản ASCII so với văn bản không phải ASCII. Bật trong “Cài đặt > Hồ sơ > Văn bản.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以为ASCII与非ASCII文本设置独立的字体。在“设置 > 配置文件 > 文本”中启用此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以為 ASCII 和非 ASCII 文字使用不同的字體。在「設定 > 描述檔 > 文字」中啟用。"
          }
        }
      }
    },
