          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python APIスクリプトのpip依存関係を追加、更新、削除できるUIを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API 스크립트의 pip 의존성을 추가, 업데이트 또는 제거할 수 있는 UI를 엽니다."
          }
        },
        "nb" : {
