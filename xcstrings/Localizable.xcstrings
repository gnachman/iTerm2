          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur Ollama pour lister ses modèles. Vérifiez qu’il est en cours d’exécution et que l’URL est correcte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
