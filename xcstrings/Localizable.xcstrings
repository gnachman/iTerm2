        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, será solicitado que você confirme que deseja enviar uma quebra de linha ao colar uma única linha de texto terminada em quebra de linha. É necessária a Shell Integration."
