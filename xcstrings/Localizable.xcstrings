    "ProfilesKeys.RemoveConflictingBindings" : {
      "comment" : "Warning asking whether to remove preset key bindings that conflict with CSI u",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Profil enthält einige Tastenkombinationen aus einer Voreinstellung, die mit CSI u in Konflikt stehen. Sollen sie entfernt werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This profile has some key bindings from a preset that conflict with CSI u. Remove them?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil tiene algunas asignaciones de teclas de un preajuste que entran en conflicto con CSI u. ¿Eliminarlas?"
          }
        },
        "fr" : {
          "stringUnit" : {
