    "AdvancedSetting.xtermVersion" : {
      "comment" : "Advanced setting: xtermVersion",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-Version für Secondary Device Attributes (SDA).\nEine Erhöhung dieser Zahl aktiviert mehr Funktionen in Apps, kann aber Dinge kaputt machen. Verwenden Sie 95, um das Verhalten vor 3.4.10 wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "xterm version for secondary device attributes (SDA).\nIncreasing this number enables more features in apps but may break things. Use 95 to recover pre-3.4.10 behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión de xterm para los atributos de dispositivo secundarios (SDA).\nAumentar este número activa más funciones en las apps pero puede romper cosas. Usa 95 para recuperar el comportamiento anterior a 3.4.10."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version de xterm pour les attributs d’appareil secondaires (SDA).\nAugmenter ce nombre active davantage de fonctions dans les apps mais peut casser certaines choses. Utilisez 95 pour retrouver le comportement antérieur à la version 3.4.10."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione di xterm per gli attributi secondari del dispositivo (SDA).\nAumentare questo numero abilita più funzioni nelle app ma può causare problemi. Usa 95 per ripristinare il comportamento precedente alla 3.4.10."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セカンダリデバイス属性（SDA）用のxtermバージョン。\nこの数値を増やすとアプリでより多くの機能が有効になりますが、動作が壊れる可能性があります。3.4.10以前の動作に戻すには95を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 장치 속성(SDA)에 대한 xterm 버전\n이 숫자를 늘리면 앱에서 더 많은 기능이 활성화되지만 문제가 생길 수 있습니다. 3.4.10 이전 동작으로 되돌리려면 95를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão do xterm para atributos secundários de dispositivo (SDA).\nAumentar este número ativa mais recursos nos apps, mas pode quebrar coisas. Use 95 para recuperar o comportamento anterior à 3.4.10."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия xterm для вторичных атрибутов устройства (SDA).\nУвеличение этого числа включает больше возможностей в приложениях, но может что-то сломать. Используйте 95, чтобы вернуть поведение, как до версии 3.4.10."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkincil aygıt öznitelikleri (SDA) için xterm sürümü.\nBu sayıyı artırmak uygulamalarda daha çok özelliği etkinleştirir ancak bazı şeyleri bozabilir. 3.4.10 öncesi davranışı geri getirmek için 95 kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于辅助设备属性（SDA）的 xterm 版本。\n将此数值增大可启用应用程序中的更多功能，但也可能导致问题。使用 95 可恢复 3.4.10 之前的行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次要裝置屬性（SDA）使用的 xterm 版本。\n增大此數字會在 App 中啟用更多功能，但可能造成問題。使用 95 可回復 3.4.10 之前的行為。"
          }
        }
      }
    },
    "AdvancedSetting.zeroWidthSpaceAdvancesCursor" : {
      "comment" : "Advanced setting: zeroWidthSpaceAdvancesCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückt ein Leerzeichen ohne Breite (Zero-Width Space, U+200B) den Cursor vor?\nObwohl ein Leerzeichen ohne Breite laut Unicode-Spezifikation den Cursor nicht vorrücken sollte, tun dies sowohl Terminal.app als auch Konsole, und Weechat ist darauf angewiesen. Sie müssen iTerm2 nach Ändern dieser Einstellung neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zero-Width Space (U+200B) advances cursor?\nWhile a zero-width space should not advance the cursor per the Unicode spec, both Terminal.app and Konsole do this, and Weechat depends on it. You must restart iTerm2 after changing this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El espacio de ancho cero (U+200B) avanza el cursor?\nAunque según la especificación Unicode un espacio de ancho cero no debería avanzar el cursor, tanto Terminal.app como Konsole lo hacen, y Weechat depende de ello. Debes reiniciar iTerm2 tras cambiar este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace de largeur nulle (U+200B) fait avancer le curseur ?\nBien qu’une espace de largeur nulle ne doive pas faire avancer le curseur selon la spécification Unicode, Terminal.app et Konsole le font tous deux, et Weechat en dépend. Vous devez redémarrer iTerm2 après avoir modifié ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio a larghezza zero (U+200B) fa avanzare il cursore?\nSebbene secondo la specifica Unicode uno spazio a larghezza zero non dovrebbe far avanzare il cursore, sia Terminal.app sia Konsole lo fanno, e Weechat dipende da questo comportamento. Devi riavviare iTerm2 dopo aver modificato questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゼロ幅スペース（U+200B）でカーソルを進めますか？\nUnicode仕様では、ゼロ幅スペースはカーソルを進めるべきではありませんが、Terminal.appとKonsoleはどちらもこれを行い、Weechatはこれに依存しています。この設定を変更した後はiTerm2を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폭 없는 공백(U+200B)에서 커서를 이동하겠습니까?\n유니코드 사양에 따르면 폭 없는 공백은 커서를 이동하지 않아야 하지만, Terminal.app과 Konsole 모두 커서를 이동하며 Weechat이 이 동작에 의존합니다. 이 설정을 변경한 후에는 iTerm2를 재시작해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço de largura zero (U+200B) avança o cursor?\nEmbora um espaço de largura zero não deva avançar o cursor conforme a especificação Unicode, tanto o Terminal.app quanto o Konsole fazem isso, e o Weechat depende disso. Você deve reiniciar o iTerm2 após alterar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продвигать курсор при вводе пробела нулевой ширины (U+200B)?\nХотя по спецификации Unicode пробел нулевой ширины не должен продвигать курсор, и Terminal.app, и Konsole делают это, а Weechat на это полагается. После изменения этого параметра перезапустите iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıfır Genişlikli Boşluk (U+200B) imleci ilerletsin mi?\nUnicode belirtimine göre sıfır genişlikli bir boşluk imleci ilerletmemelidir, ancak hem Terminal.app hem Konsole bunu yapar ve Weechat buna bağlıdır. Bu ayarı değiştirdikten sonra iTerm2’yi yeniden başlatmanız gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零宽度空格（U+200B）是否推进光标？\n虽然根据 Unicode 标准，零宽度空格不应推进光标，但 Terminal.app 和 Konsole 会这样做，Weechat 也依赖此行为。更改此设置后必须重启 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零寬度空格（U+200B）會使游標前進？\n依照 Unicode 規範，零寬度空格不應使游標前進，但 Terminal.app 和 Konsole 都會這樣做，Weechat 也依賴此行為。變更此設定後必須重新啟動 iTerm2。"
          }
        }
      }
    },
    "AdvancedSetting.zippyTextDrawing" : {
      "comment" : "Advanced setting: zippyTextDrawing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellen Textzeichenalgorithmus verwenden?\nDies zeichnet Nicht-ASCII-Text schneller, aber mit geringerer Genauigkeit. Diese Einstellung wird ignoriert, wenn in Einstellungen > Profile > Text Ligaturen aktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use zippy text drawing algorithm?\nThis draws non-ASCII text more quickly but with lower fidelity. This setting is ignored if ligatures are enabled in Settings > Profiles > Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar el algoritmo de dibujo de texto rápido?\nDibuja el texto no ASCII más deprisa pero con menor fidelidad. Este ajuste se ignora si las ligaduras están activadas en Ajustes > Perfiles > Texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser l’algorithme de dessin de texte rapide (zippy) ?\nCela dessine le texte non ASCII plus rapidement mais avec une moindre fidélité. Ce réglage est ignoré si les ligatures sont activées dans Réglages > Profils > Texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare l’algoritmo di disegno veloce del testo?\nDisegna il testo non ASCII più rapidamente ma con minore fedeltà. Questa impostazione viene ignorata se le legature sono abilitate in Impostazioni > Profili > Testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速テキスト描画アルゴリズムを使用しますか？\nこれにより非ASCIIテキストがより速く描画されますが、精度は下がります。「設定 > プロファイル > テキスト」で合字が有効になっている場合、この設定は無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 텍스트 그리기 알고리즘을 사용하겠습니까?\n비ASCII 텍스트를 더 빠르게 그리지만 정확도는 떨어집니다. 설정 > 프로파일 > 텍스트에서 합자가 켜져 있으면 이 설정은 무시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o algoritmo de desenho de texto rápido?\nIsso desenha texto não ASCII mais rapidamente, mas com menor fidelidade. Este ajuste é ignorado se as ligaduras estiverem ativadas em Ajustes > Perfis > Texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать быстрый (zippy) алгоритм отрисовки текста?\nОн отрисовывает не-ASCII текст быстрее, но с меньшей точностью. Этот параметр игнорируется, если в разделе Настройки > Профили > Текст включены лигатуры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı metin çizim algoritması kullanılsın mı?\nBu, ASCII olmayan metni daha hızlı ancak daha düşük aslına uygunlukla çizer. Ayarlar > Profiller > Metin bölümünde bitişik harfler etkinse bu ayar yok sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 zippy 文本绘制算法？\n此算法可更快速绘制非 ASCII 文本，但保真度较低。若在设置 > 配置文件 > 文本中启用了连字，此设置将被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 zippy 文字繪製演算法？\n這會更快地繪製非 ASCII 文字，但保真度較低。如果在「設定 > 描述檔 > 文字」中啟用了連字，則會忽略此設定。"
          }
        }
      }
    },
    "AdvancedSettings.DisplayName" : {
      "comment" : "Display name of the Advanced Preferences section in settings search",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
