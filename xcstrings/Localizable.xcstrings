    "ClaudeCodeOnboarding.RemoteConfigResolutionFailedBody" : {
      "comment" : "Body of the alert shown when iTerm2 could not read CLAUDE_CONFIG_DIR on a remote host; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal přečíst CLAUDE_CONFIG_DIR z vašeho přihlašovacího shellu na hostiteli %@, takže neví, kde tam Claude Code ukládá své nastavení. Zkusit znovu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke læse CLAUDE_CONFIG_DIR fra din loginshell på %@, så den ved ikke, hvor Claude Code gemmer sine indstillinger der. Vil du prøve igen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte CLAUDE_CONFIG_DIR nicht aus Ihrer Login-Shell auf %@ lesen und weiß daher nicht, wo Claude Code dort seine Einstellungen speichert. Erneut versuchen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t read CLAUDE_CONFIG_DIR from your login shell on %@, so it doesn’t know where Claude Code keeps its settings there. Try again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo leer CLAUDE_CONFIG_DIR desde tu shell de inicio de sesión en %@, así que no sabe dónde guarda Claude Code sus ajustes allí. ¿Volver a intentarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei pystynyt lukemaan CLAUDE_CONFIG_DIR-muuttujaa kirjautumiskomentotulkistasi palvelimella %@, joten se ei tiedä, missä Claude Code säilyttää asetuksiaan siellä. Yritetäänkö uudelleen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu lire CLAUDE_CONFIG_DIR depuis votre shell de connexion sur %@, il ne sait donc pas où Claude Code y conserve ses réglages. Réessayer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto leggere CLAUDE_CONFIG_DIR dalla tua shell di login su %@, quindi non sa dove Claude Code conserva lì le sue impostazioni. Riprovare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は%@のログインシェルからCLAUDE_CONFIG_DIRを読み取れなかったため、そこでClaude Codeが設定をどこに保存しているかわかりません。もう一度試しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 %@의 로그인 셸에서 CLAUDE_CONFIG_DIR을 읽을 수 없어 그곳에서 Claude Code가 설정을 어디에 보관하는지 알 수 없습니다. 다시 시도하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunne ikke lese CLAUDE_CONFIG_DIR fra påloggingsskallet ditt på %@, så den vet ikke hvor Claude Code har innstillingene sine der. Vil du prøve igjen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kon CLAUDE_CONFIG_DIR niet uit je inlogshell op %@ lezen en weet dus niet waar Claude Code daar zijn instellingen bewaart. Opnieuw proberen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie mógł odczytać CLAUDE_CONFIG_DIR z twojej powłoki logowania na hoście %@, więc nie wie, gdzie Claude Code przechowuje tam ustawienia. Spróbować ponownie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu ler CLAUDE_CONFIG_DIR do seu shell de login em %@, portanto não sabe onde o Claude Code guarda as configurações lá. Tentar novamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не смог прочитать CLAUDE_CONFIG_DIR из вашей оболочки входа на %@, поэтому не знает, где Claude Code хранит там настройки. Попробовать снова?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nedokázal prečítať CLAUDE_CONFIG_DIR z vášho prihlasovacieho shellu na hostiteľovi %@, preto nevie, kde tam Claude Code ukladá svoje nastavenia. Skúsiť znovu?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ni mogel prebrati CLAUDE_CONFIG_DIR iz vaše prijavne lupine v gostitelju %@, zato ne ve, kje tam Claude Code hrani svoje nastavitve. Poskusite znova?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kunde inte läsa CLAUDE_CONFIG_DIR från ditt inloggningsskal på %@, så den vet inte var Claude Code lagrar sina inställningar där. Vill du försöka igen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, %@ ana makinesindeki oturum açma kabuğunuzdan CLAUDE_CONFIG_DIR değerini okuyamadı; bu yüzden Claude Code’un orada ayarlarını nerede sakladığını bilmiyor. Yeniden denensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 không thể đọc CLAUDE_CONFIG_DIR từ shell đăng nhập của bạn trên %@, nên không biết Claude Code lưu cài đặt ở đó ở đâu. Thử lại?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法从 %@ 上的登录 Shell 读取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 在那里将设置保存在何处。要重试吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法從 %@ 上的登入 shell 讀取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 在該處將設定儲存在何處。要再試一次嗎？"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.RemoteDisconnected" : {
