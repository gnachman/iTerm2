        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de caracteres antes y después del lugar del clic en los que buscar al aplicar patrones de expresiones regulares de selección de palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
