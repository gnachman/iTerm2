    "Tip.0047.Body" : {
      "comment" : "Tip of the day body, id 0047",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⌥⌘ při přetahování a vytvoříte obdélníkový výběr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold ⌥⌘ nede, mens du trækker, for at lave en rektangulær markering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie beim Ziehen ⌥⌘ gedrückt, um eine rechteckige Auswahl zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥⌘ while dragging to make a rectangular selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ⌥⌘ mientras arrastras para hacer una selección rectangular."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ⌥⌘ painettuna vetäessäsi tehdäksesi suorakulmaisen valinnan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌥⌘ tout en faisant glisser pour effectuer une sélection rectangulaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⌥⌘ mentre trascini per fare una selezione rettangolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘を押しながらドラッグすると、矩形選択ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘를 누른 채 드래그하면 직사각형으로 선택할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede ⌥⌘ mens du drar for å lage en rektangulær markering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ⌥⌘ ingedrukt tijdens het slepen om een rechthoekige selectie te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ⌥⌘ podczas przeciągania, aby wykonać zaznaczenie prostokątne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥⌘ pressionado ao arrastar para fazer uma seleção retangular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌥⌘ при перетаскивании, чтобы сделать прямоугольное выделение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⌥⌘ počas ťahania a vytvoríte obdĺžnikový výber."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med vlečenjem držite ⌥⌘, da naredite pravokotni izbor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned ⌥⌘ medan du drar för att göra en rektangulär markering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikdörtgen seçim yapmak için sürüklerken ⌥⌘ tuşlarını basılı tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ ⌥⌘ khi kéo để tạo vùng chọn hình chữ nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动时按住⌥⌘可创建矩形选择区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移時按住 ⌥⌘，即可建立矩形選取範圍。"
          }
        }
      }
    },
