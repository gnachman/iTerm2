    "AIKeyHint.NoneSelected" : {
      "comment" : "Hint shown when the user chose to send no API key for a manual AI model",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird kein API-Schlüssel gesendet. Wenn der Endpunkt eine Authentifizierung erfordert, verwenden Sie einen benutzerdefinierten Header."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No API key is sent. If the endpoint requires authentication, use a custom header."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキーは送信されません。エンドポイントで認証が必要な場合は、カスタムヘッダーを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키를 보내지 않습니다. 엔드포인트에 인증이 필요하면 사용자 지정 헤더를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de API é enviada. Se o endpoint exigir autenticação, use um cabeçalho personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API не отправляется. Если конечная точка требует аутентификации, используйте пользовательский заголовок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不发送 API 密钥。如果端点需要身份验证，请使用自定义头信息。"
          }
        }
      }
    },
    "AIKeyHint.SelfHosted" : {
      "comment" : "Hint shown when the model URL is on the local network, where iTerm2 withholds the API key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
