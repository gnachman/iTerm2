    "PasswordArchive.SettingsImportDetail" : {
      "comment" : "Shown when importing settings that contain an encrypted password export",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento export obsahuje uložená hesla. Zadejte heslovou frázi použitou při exportu, nebo zrušte akci a importujte vše ostatní bez nich."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne eksport indeholder gemte adgangskoder. Skriv den adgangssætning, der blev brugt til at eksportere dem, eller annuller for at importere alt andet uden dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Export enthält gespeicherte Passwörter. Geben Sie die Passphrase ein, mit der sie exportiert wurden, oder brechen Sie ab, um alles andere ohne sie zu importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This export includes saved passwords. Enter the passphrase that was used to export them, or cancel to import everything else without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta exportación incluye contraseñas guardadas. Introduce la frase de contraseña que se usó para exportarlas, o cancela para importar todo lo demás sin ellas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä vienti sisältää tallennettuja salasanoja. Syötä niiden viennissä käytetty salalause tai kumoa, jolloin kaikki muu tuodaan ilman niitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette exportation inclut des mots de passe enregistrés. Saisissez la phrase secrète utilisée pour les exporter, ou annulez pour importer tout le reste sans eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa esportazione include password salvate. Inserisci la passphrase usata per esportarle oppure annulla per importare tutto il resto senza di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエクスポートには保存されたパスワードが含まれています。エクスポート時に使用したパスフレーズを入力するか、キャンセルしてパスワード以外のすべてをインポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 내보내기 파일에는 저장된 암호가 포함되어 있습니다. 암호를 내보낼 때 사용한 암호 문구를 입력하거나, 취소하여 암호를 제외한 나머지를 모두 가져오십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne eksporten inneholder lagrede passord. Skriv inn passfrasen som ble brukt til å eksportere dem, eller avbryt for å importere alt annet uten dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze export bevat bewaarde wachtwoorden. Voer de wachtwoordzin in die is gebruikt om ze te exporteren, of annuleer om al het andere zonder de wachtwoorden te importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten eksport zawiera zapisane hasła. Wpisz hasło zabezpieczające użyte do ich wyeksportowania lub anuluj, aby zaimportować wszystko inne bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta exportação inclui senhas salvas. Digite a frase secreta usada para exportá-las ou cancele para importar todo o resto sem elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот экспорт содержит сохранённые пароли. Введите парольную фразу, использованную при их экспорте, или отмените, чтобы импортировать всё остальное без них."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento export obsahuje uložené heslá. Zadajte prístupovú frázu, ktorá bola použitá pri ich exporte, alebo zrušte a importujte všetko ostatné bez nich."
          }
        },
        "sl" : {
          "stringUnit" : {
