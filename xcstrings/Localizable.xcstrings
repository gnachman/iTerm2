    "SemanticHistory.EditorCaveat" : {
      "comment" : "Explanation of the open-in-editor semantic history action",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když aktivujete sémantickou historii na textovém souboru, otevře jej zadaný editor.\nOstatní druhy souborů se otevřou ve svých výchozích aplikacích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du aktiverer semantisk historik på et tekstarkiv, åbner den angivne editor det.\nAndre typer arkiver åbnes med deres standardapps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Semantic History auf einer Textdatei aktivieren, öffnet der angegebene Editor sie.\nAndere Dateitypen werden mit ihren Standardprogrammen geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you activate Semantic History on a text file, the specified editor opens it.\nOther kinds of files will be opened with their default apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando activas el historial semántico en un archivo de texto, el editor especificado lo abre.\nLos demás tipos de archivo se abrirán con sus apps predeterminadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun aktivoit semanttisen historian tekstitiedostossa, määritetty editori avaa sen.\nMuun tyyppiset tiedostot avataan niiden oletussovelluksilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous activez l’historique sémantique sur un fichier texte, l’éditeur indiqué l’ouvre.\nLes autres types de fichiers seront ouverts avec leurs apps par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando attivi la cronologia semantica su un file di testo, l’editor specificato lo apre.\nGli altri tipi di file verranno aperti con le rispettive app predefinite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストファイルでSemantic Historyを起動すると、指定したエディタでそれが開かれます。\nその他の種類のファイルはデフォルトのアプリで開かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 파일에서 시맨틱 히스토리를 활성화하면 지정한 편집기에서 파일이 열립니다.\n다른 종류의 파일은 해당 기본 앱으로 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du aktiverer semantisk historikk på en tekstfil, åpnes den i den angitte editoren.\nAndre filtyper åpnes med standardappene sine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je Semantische geschiedenis activeert op een tekstbestand, wordt het geopend in de opgegeven editor.\nAndere soorten bestanden worden geopend met hun standaardapps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy aktywujesz historię semantyczną na pliku tekstowym, otworzy go wskazany edytor.\nInne rodzaje plików zostaną otwarte w ich domyślnych aplikacjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você ativa o Semantic History em um arquivo de texto, o editor especificado o abre.\nOutros tipos de arquivo serão abertos com seus apps padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При активации Semantic History для текстового файла он открывается в указанном редакторе.\nФайлы других типов будут открыты в приложениях по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď aktivujete sémantickú históriu na textovom súbore, otvorí ho zadaný editor.\nĎalšie typy súborov sa otvoria v predvolených apkách."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko aktivirate semantično zgodovino na besedilni datoteki, jo odpre določeni urejevalnik.\nDrugi tipi datotek se odprejo s privzetimi aplikacijami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du aktiverar semantisk historik på en textfil öppnas den i den angivna redigeraren.\nÖvriga filtyper öppnas med sina förvalda appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir metin dosyasında Anlamsal Geçmiş’i etkinleştirdiğinizde dosya belirtilen düzenleyicide açılır.\nDiğer dosya türleri varsayılan uygulamalarıyla açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn kích hoạt Lịch sử ngữ nghĩa trên một tệp văn bản, trình soạn thảo được chỉ định sẽ mở tệp đó.\nCác loại tệp khác sẽ được mở bằng ứng dụng mặc định của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在文本文件上启用语义历史记录时，指定的编辑器会打开它。\n其他类型的文件将用默认应用打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在文字檔案上啟用語意歷史記錄時，會以指定的編輯器打開它。\n其他類型的檔案將以其預設的 App 打開。"
          }
        }
      }
    },
