    "Tip.0025.Body" : {
      "comment" : "Tip of the day body, id 0025",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shell-Integration zeigt einen blauen Pfeil neben Ihrer Shell-Eingabeaufforderung an. Wenn ein ausgeführter Befehl fehlschlägt, wird er rot. Klicken Sie mit der rechten Maustaste darauf, um Laufzeit und Status zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Shell Integration feature puts a blue arrow next to your shell prompt. If you run a command that fails, it turns red. Right click on it to get the running time and status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con el shell coloca una flecha azul junto al prompt del shell. Si ejecutas un comando que falla, se vuelve roja. Haz clic con el botón derecho en ella para ver el tiempo de ejecución y el estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration du shell place une flèche bleue à côté de l’invite de votre shell. Si une commande échoue, elle devient rouge. Faites un clic droit dessus pour obtenir la durée d’exécution et l’état."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione shell inserisce una freccia blu accanto al prompt della shell. Se esegui un comando che non riesce, diventa rossa. Fai clic con il tasto destro su di essa per vedere il tempo di esecuzione e lo stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合機能は、シェルプロンプトの横に青い矢印を表示します。実行したコマンドが失敗すると、矢印は赤くなります。右クリックすると、実行時間とステータスを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합 기능은 셸 프롬프트 옆에 파란색 화살표를 표시합니다. 실행한 명령이 실패하면 빨간색으로 바뀝니다. 화살표를 오른쪽 클릭하면 실행 시간과 상태를 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso Shell Integration coloca uma seta azul ao lado do seu prompt do shell. Se você executar um comando que falha, ela fica vermelha. Clique nela com o botão direito para ver o tempo de execução e o status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция «Интеграция с оболочкой» отображает синюю стрелку рядом с приглашением оболочки. Если выполненная команда завершается ошибкой, стрелка становится красной. Щёлкните по ней правой кнопкой мыши, чтобы узнать время выполнения и статус."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu özelliği kabuk isteminizin yanına mavi bir ok koyar. Başarısız bir komut çalıştırırsanız ok kırmızıya döner. Çalışma süresini ve durumu görmek için sağ tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell集成功能会在您的shell提示符旁添加蓝色箭头。如果运行的命令失败，它会变为红色。点击右键可查看运行时间和状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 整合功能會在 shell 提示符號旁放置一個藍色箭頭。如果執行的指令失敗，箭頭會變成紅色。在它上面按一下右鍵可查看執行時間和狀態。"
          }
        }
      }
    },
