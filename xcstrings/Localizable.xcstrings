    "PTYTask.TempFileError" : {
      "comment" : "Error shown when a temporary file could not be created. %@ is the temporary directory path.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při vytváření dočasného souboru pomocí mkstemps došlo k chybě. Ověřte, že složka %@ existuje a je zapisovatelná."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod en fejl under oprettelse af en midlertidig fil med mkstemps. Kontroller, at %@ findes, og at der kan skrives til den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Erstellen einer temporären Datei mit mkstemps ist ein Fehler aufgetreten. Stellen Sie sicher, dass %@ existiert und beschreibbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An error was encountered while creating a temporary file with mkstemps. Verify that %@ exists and is writable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se produjo un error al crear un archivo temporal con mkstemps. Comprueba que %@ exista y tenga permiso de escritura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väliaikaisen tiedoston luonnissa mkstempsillä tapahtui virhe. Varmista, että %@ on olemassa ja siihen voi kirjoittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite lors de la création d’un fichier temporaire avec mkstemps. Vérifiez que %@ existe et est accessible en écriture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un errore durante la creazione di un file temporaneo con mkstemps. Verifica che %@ esista e sia scrivibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mkstempsで一時ファイルを作成中にエラーが発生しました。%@が存在し、書き込み可能であることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mkstemps로 임시 파일을 생성하는 중 오류가 발생했습니다. %@이(가) 존재하고 쓰기 가능한지 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det oppsto en feil under opprettelse av en midlertidig fil med mkstemps. Kontroller at %@ finnes og er skrivbar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een fout opgetreden bij het maken van een tijdelijk bestand met mkstemps. Controleer of %@ bestaat en beschrijfbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystąpił błąd podczas tworzenia pliku tymczasowego przez mkstemps. Sprawdź, czy katalog %@ istnieje i czy można w nim zapisywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro ao criar um arquivo temporário com mkstemps. Verifique se %@ existe e tem permissão de escrita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Произошла ошибка при создании временного файла с помощью mkstemps. Убедитесь, что %@ существует и доступен для записи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vytváraní dočasného súboru pomocou mkstemps došlo k chybe. Skontrolujte, či %@ existuje a či doň možno zapisovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri ustvarjanju začasne datoteke z mkstemps je prišlo do napake. Preverite, ali %@ obstaja in je zapisljiv."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett fel uppstod när en tillfällig fil skapades med mkstemps. Kontrollera att %@ finns och är skrivbar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mkstemps ile geçici dosya oluşturulurken bir hata oluştu. %@ dizininin var olduğunu ve yazılabilir olduğunu doğrulayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra lỗi khi tạo tệp tạm bằng mkstemps. Hãy kiểm tra xem %@ có tồn tại và có thể ghi được không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 mkstemps 创建临时文件时出错。请确认 %@ 存在且可写入。"
