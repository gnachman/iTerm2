    "AIConnectionTester.ReviewPlaceholder" : {
      "comment" : "Result of the AI connection test when the App Review placeholder key is configured",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzhalterschlüssel in Verwendung: KI-Antworten werden für die App-Überprüfung simuliert, es wird kein externer Dienst kontaktiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
