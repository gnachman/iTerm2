    "Tip.0044.Body" : {
      "comment" : "Tip of the day body, id 0044",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⌥ a kliknutím přesuňte kurzor. Nejlépe to funguje s nainstalovanou integrací shellu (aby se do shellu neposílaly klávesy šipka nahoru/dolů)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold ⌥ nede, og klik for at flytte din markør. Det fungerer bedst med shell-integration installeret (for at undgå at sende pil op/ned-taster til din shell)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⌥ gedrückt und klicken Sie, um Ihren Cursor zu bewegen. Am besten funktioniert das mit installierter Shell-Integration (um zu vermeiden, dass die Pfeiltasten „nach oben“ und „nach unten“ an Ihre Shell gesendet werden)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥ and click to move your cursor. It works best with Shell Integration installed (to avoid sending up/down arrow keys to your shell)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ⌥ y haz clic para mover el cursor. Funciona mejor con la integración con el shell instalada (para evitar enviar al shell las teclas de flecha arriba/abajo)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ⌥ painettuna ja klikkaa siirtääksesi kohdistinta. Toiminta on parasta komentotulkki-integraation kanssa (jotta komentotulkille ei lähetetä ylös- ja alanuolinäppäimiä)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌥ et cliquez pour déplacer votre curseur. Cela fonctionne mieux avec l’intégration du shell installée (pour éviter d’envoyer les touches fléchées haut/bas à votre shell)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⌥ e fai clic per spostare il cursore. Funziona al meglio con l’integrazione shell installata (per evitare di inviare alla shell i tasti freccia su/giù)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥を押しながらクリックすると、カーソルを移動できます。シェル統合をインストールしていると最も効果的に機能します(シェルに上下矢印キーを送らずに済みます)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ 키를 누른 채 클릭하면 커서를 이동할 수 있습니다. 셸 통합이 설치되어 있을 때 가장 잘 작동합니다(셸에 위/아래 화살표 키를 보내지 않기 위해)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede ⌥ og klikk for å flytte markøren. Det fungerer best med skallintegrering installert (for å unngå å sende pil opp/ned-taster til skallet)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ⌥ ingedrukt en klik om je cursor te verplaatsen. Het werkt het best met shell-integratie geïnstalleerd (om te voorkomen dat pijl-omhoog/pijl-omlaag naar je shell worden gestuurd)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ⌥ i kliknij, aby przesunąć kursor. Działa najlepiej z zainstalowaną integracją z powłoką (aby nie wysyłać do powłoki klawiszy strzałek w górę/w dół)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥ pressionado e clique para mover o cursor. Funciona melhor com o Shell Integration instalado (para evitar o envio das teclas de seta para cima/baixo ao shell)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌥ и щёлкайте, чтобы переместить курсор. Лучше всего это работает при установленной интеграции с оболочкой (чтобы избежать отправки клавиш со стрелками вверх/вниз в оболочку)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⌥ a kliknutím presuniete kurzor. Najlepšie funguje s nainštalovanou integráciou shellu (aby sa do shellu neposielali klávesy so šípkou nahor/nadol)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite ⌥ in kliknite, da premaknete kazalec. Najbolje deluje z nameščeno integracijo lupine (da lupini ni treba pošiljati puščičnih tipk navzgor/navzdol)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned ⌥ och klicka för att flytta markören. Det fungerar bäst med skalintegrering installerad (för att undvika att skicka piltangenterna upp/ned till skalet)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmlecinizi taşımak için ⌥ tuşunu basılı tutup tıklayın. Kabuk Entegrasyonu yüklüyken en iyi sonucu verir (kabuğunuza yukarı/aşağı ok tuşları göndermemek için)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ ⌥ và bấm để di chuyển con trỏ. Hoạt động tốt nhất khi đã cài đặt Tích hợp shell (để tránh gửi phím mũi tên lên/xuống đến shell)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌥ 键并点击以移动光标。此功能在已安装 Shell Integration 时效果最佳（以避免将向上/向下箭头键发送到 shell）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌥ 並按一下即可移動游標。安裝 Shell 整合時效果最佳（可避免將上/下方向鍵傳送給 shell）。"
          }
        }
      }
    },
