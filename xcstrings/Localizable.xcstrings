    "AdvancedSetting.minimalTextLegibilityAdjustment" : {
      "comment" : "Advanced setting: minimalTextLegibilityAdjustment",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O kolik se má v motivu Minimalistický zvýšit kontrast textu v panelech?\nPro zvýšení kontrastu zvolte hodnotu větší než 1. Hodnoty mezi 0 a 1 mají nižší kontrast než výchozí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor meget skal kontrasten øges for tekst i faner i temaet Minimal?\nVælg en værdi større end 1 for at øge kontrasten. Værdier mellem 0 og 1 giver mindre kontrast end standarden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um wie viel soll der Kontrast für Text in Tabs im Design „Minimal“ erhöht werden?\nWählen Sie einen Wert größer als 1, um den Kontrast zu erhöhen. Werte zwischen 0 und 1 haben weniger Kontrast als der Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How much should contrast be increased for text in tabs in the Minimal theme?\nChoose a value larger than 1 to increase contrast. Values between 0 and 1 have less contrast than the default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto debe aumentar el contraste del texto de las pestañas en el tema Minimalista?\nElige un valor mayor que 1 para aumentar el contraste. Los valores entre 0 y 1 tienen menos contraste que el predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka paljon välilehtien tekstin kontrastia tulee lisätä Minimaalinen-teemassa?\nValitse arvo, joka on suurempi kuin 1, lisätäksesi kontrastia. Arvoilla välillä 0 ja 1 kontrasti on oletusta pienempi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De combien le contraste du texte des onglets doit-il être augmenté dans le thème Minimal ?\nChoisissez une valeur supérieure à 1 pour augmenter le contraste. Les valeurs entre 0 et 1 donnent moins de contraste que la valeur par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di quanto deve aumentare il contrasto del testo nei pannelli nel tema Minimale?\nScegli un valore maggiore di 1 per aumentare il contrasto. I valori tra 0 e 1 hanno meno contrasto rispetto a quello predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimalテーマで、タブ内のテキストのコントラストをどの程度上げるか？\n1より大きい値を指定するとコントラストが上がります。0から1の間の値はデフォルトよりコントラストが下がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 테마에서 탭 텍스트의 대비를 얼마나 높이겠습니까?\n대비를 높이려면 1보다 큰 값을 선택하십시오. 0과 1 사이의 값은 기본값보다 대비가 낮습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mye skal kontrasten økes for tekst i faner i temaet Minimal?\nVelg en verdi større enn 1 for å øke kontrasten. Verdier mellom 0 og 1 gir lavere kontrast enn standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel moet het contrast van tekst in tabbladen worden verhoogd in het thema Minimaal?\nKies een waarde groter dan 1 om het contrast te verhogen. Waarden tussen 0 en 1 hebben minder contrast dan de standaardwaarde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak bardzo zwiększyć kontrast tekstu na kartach w motywie Minimalny?\nWybierz wartość większą niż 1, aby zwiększyć kontrast. Wartości między 0 a 1 dają mniejszy kontrast niż domyślny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o contraste deve ser aumentado para o texto nas abas no tema Minimal?\nEscolha um valor maior que 1 para aumentar o contraste. Valores entre 0 e 1 têm menos contraste que o padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько увеличить контраст текста на вкладках в теме Minimal?\nВыберите значение больше 1, чтобы увеличить контраст. Значения от 0 до 1 дают меньший контраст, чем по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O koľko sa má v téme Minimalistická zvýšiť kontrast textu v tabech?\nHodnota väčšia ako 1 kontrast zvýši. Hodnoty medzi 0 a 1 majú nižší kontrast ako predvolená hodnota."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko naj se poveča kontrast besedila v zavihkih v temi Minimalna?\nZa večji kontrast izberite vrednost, večjo od 1. Vrednosti med 0 in 1 imajo manjši kontrast od privzetega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur mycket ska kontrasten ökas för text i flikar i temat Minimal?\nVälj ett värde större än 1 för att öka kontrasten. Värden mellan 0 och 1 ger lägre kontrast än förvalet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal temada sekmelerdeki metnin kontrastı ne kadar artırılsın?\nKontrastı artırmak için 1’den büyük bir değer seçin. 0 ile 1 arasındaki değerler varsayılandan daha düşük kontrast sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần tăng độ tương phản của văn bản trong tab ở chủ đề Tối giản bao nhiêu?\nChọn giá trị lớn hơn 1 để tăng độ tương phản. Giá trị từ 0 đến 1 có độ tương phản thấp hơn mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Minimal 主题下，标签页中的文本对比度应提高多少？\n请选择大于 1 的数值以提升对比度。0 到 1 之间的数值对应的对比度低于默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 極簡主題中，標籤頁內文字的對比度應提高多少？\n請選擇大於 1 的值以提高對比度。介於 0 和 1 之間的值對比度會低於預設值。"
          }
        }
      }
    },
    "AdvancedSetting.minimumTabDragDistance" : {
      "comment" : "Advanced setting: minimumTabDragDistance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak daleko se musí myš posunout, než se zahájí přetahování panelu?\nChcete-li změnu tohoto nastavení uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor langt skal musen flyttes, før et fanetræk begynder?\nDu skal starte iTerm2 igen efter ændring af denne indstilling, for at den træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit muss die Maus bewegt werden, bevor ein Tab-Drag beginnt?\nSie müssen iTerm2 nach dem Ändern dieser Einstellung neu starten, damit sie wirksam wird."
