    "Tip.0050.Body" : {
      "comment" : "Tip of the day body, id 0050",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýraznění kurzoru v „Nastavení > Profily > Barvy“ ztlumí všechny barvy kromě kurzoru. Použijte jasně bílý kurzor a bude vynikat!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster Markørforstærkning i “Indstillinger > Profiler > Farver” for at dæmpe alle farver undtagen markørens. Brug en klar hvid markør, så springer den i øjnene!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie Cursor-Boost unter „Einstellungen > Profile > Farben“ an, damit alle Farben gedämpfter wirken, außer dem Cursor. Verwenden Sie einen leuchtend weißen Cursor, damit er richtig heraussticht!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust Cursor Boost in “Settings > Profiles > Colors” to make all colors more muted, except the cursor. Use a bright white cursor and it pops!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el realce del cursor en “Ajustes > Perfiles > Colores” para atenuar todos los colores excepto el del cursor. ¡Usa un cursor blanco brillante y destacará!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä kohdistimen tehostusta kohdassa ”Asetukset > Profiilit > Värit”, jolloin kaikki värit himmenevät kohdistinta lukuun ottamatta. Käytä kirkkaan valkoista kohdistinta, niin se erottuu!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le renforcement du curseur dans « Réglages > Profils > Couleurs » pour atténuer toutes les couleurs, sauf celle du curseur. Avec un curseur blanc éclatant, il ressort bien !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola l’intensificazione del cursore in “Impostazioni > Profili > Colori” per attenuare tutti i colori tranne quello del cursore. Usa un cursore bianco brillante e risalterà!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」でカーソルブーストを調整すると、カーソル以外のすべての色を控えめにできます。明るい白のカーソルを使えば、くっきりと際立ちます!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상”에서 커서 부스트를 조정하면 커서를 제외한 모든 색상을 차분하게 만들 수 있습니다. 밝은 흰색 커서를 사용하면 눈에 확 띕니다!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster Markørforsterkning i «Innstillinger > Profiler > Farger» for å gjøre alle farger mer dempede, unntatt markøren. Bruk en lys hvit markør, så springer den ut!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas Cursorversterking aan in ‘Instellingen > Profielen > Kleuren’ om alle kleuren gedempter te maken, behalve de cursor. Gebruik een felwitte cursor en die springt eruit!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj wzmocnienie kursora w „Ustawienia > Profile > Kolory”, aby wszystkie kolory z wyjątkiem kursora były bardziej stonowane. Użyj jasnobiałego kursora, a będzie się wyróżniał!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o Realce do cursor em “Ajustes > Perfis > Cores” para deixar todas as cores mais suaves, exceto o cursor. Use um cursor branco brilhante e ele se destaca!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте «Усиление курсора» в «Настройки > Профили > Цвета», чтобы сделать все цвета более приглушёнными, кроме курсора. Используйте ярко-белый курсор, и он будет выделяться!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zosilnenie kurzora upravíte v časti „Nastavenia > Profily > Farby“, čím stlmíte všetky farby okrem kurzora. Použite jasnobiely kurzor a bude vynikať!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite okrepitev kazalca v »Nastavitve > Profili > Barve«, da bodo vse barve, razen barve kazalca, bolj zadušene. Uporabite svetlo bel kazalec in izstopal bo!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera Markörförstärkning i ”Inställningar > Profiler > Färger” för att dämpa alla färger utom markörens. Använd en klarvit markör så syns den tydligt!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç dışındaki tüm renkleri daha soluk yapmak için “Ayarlar > Profiller > Renkler” bölümünde “İmleç vurgusu”nu ayarlayın. Parlak beyaz bir imleç kullanın, öne çıksın!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh Tăng cường con trỏ trong “Cài đặt > Hồ sơ > Màu” để làm mọi màu dịu đi, trừ con trỏ. Dùng con trỏ trắng sáng và nó sẽ nổi bật!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 颜色”中调整光标增强功能，使所有颜色变暗，仅保留光标为亮色。若使用明亮的白色光标，会非常显眼！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 描述檔 > 顏色」中調整「游標增強」，可讓游標以外的所有顏色變得更柔和。搭配亮白色的游標會特別醒目！"
          }
        }
      }
    },
