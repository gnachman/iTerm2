    "Tip.0088.Body" : {
      "comment" : "Tip of the day body, id 0088",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können bestimmten Unicode-Bereichen eigene Schriftarten zuweisen. Verwenden Sie „Einstellungen > Profile > Text > Besondere Ausnahmen verwalten“, um dies zu verwalten und einen umfangreichen Satz an Powerline-Symbolen zu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can assign specific fonts to Unicode ranges. Use 'Settings > Profiles > Text > Manage Special Exceptions' to manage it and to install a huge set of Powerline symbols."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes asignar tipos de letra específicos a intervalos Unicode. Usa “Ajustes > Perfiles > Texto > Gestionar excepciones especiales” para gestionarlo y para instalar un enorme conjunto de símbolos Powerline."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez attribuer des polices spécifiques à des plages Unicode. Utilisez « Réglages > Profils > Texte > Gérer les exceptions spéciales » pour les gérer et installer un immense ensemble de symboles Powerline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi assegnare font specifici a intervalli Unicode. Usa “Impostazioni > Profili > Testo > Gestisci eccezioni speciali” per gestirli e per installare un vasto insieme di simboli Powerline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unicodeの範囲ごとに特定のフォントを割り当てられます。「設定 > プロファイル > テキスト > 特殊な例外を管理」を使って管理したり、大量のPowerlineシンボルをインストールしたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유니코드 범위에 특정 서체를 할당할 수 있습니다. ‘설정 > 프로파일 > 텍스트 > 특수 예외 관리’를 사용하여 관리하고 방대한 Powerline 기호 세트를 설치할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode atribuir fontes específicas a intervalos Unicode. Use 'Settings > Profiles > Text > Manage Special Exceptions' para gerenciá-los e para instalar um enorme conjunto de símbolos Powerline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете назначать определённые шрифты диапазонам Unicode. Используйте «Настройки > Профили > Текст > Управление особыми исключениями», чтобы настроить это и установить обширный набор символов Powerline."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unicode aralıklarına belirli fontlar atayabilirsiniz. Bunu yönetmek ve çok büyük bir Powerline sembolleri kümesi yüklemek için “Ayarlar > Profiller > Metin > Özel İstisnaları Yönet” bölümünü kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以为Unicode范围分配特定的字体。使用“设置 > 配置文件 > 文本 > 管理特殊异常”来管理和安装大量Powerline符号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以為 Unicode 範圍指定特定字體。使用「設定 > 描述檔 > 文字 > 管理特殊例外」來管理，並安裝大量的 Powerline 符號。"
          }
        }
      }
    },
