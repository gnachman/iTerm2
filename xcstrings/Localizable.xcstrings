    "Tip.0040.Body" : {
      "comment" : "Tip of the day body, id 0040",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainstalujte integraci shellu a zapněte „Nastavení > Obecné > Ukládat historii kopírování/vkládání a příkazů na disk“, aby si iTerm2 pamatoval historii příkazů pro každého hostitele i po restartu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer shell-integration, og slå “Indstillinger > Generelt > Gem kopierings-/indsætnings- og kommandohistorik på disken” til for at huske kommandohistorikken pr. vært på tværs af genstarter af iTerm2."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren Sie die Shell-Integration und aktivieren Sie „Einstellungen > Allgemein > Kopieren/Einfügen- und Befehlsverlauf auf der Festplatte speichern“, damit der Befehlsverlauf pro Host über Neustarts von iTerm2 hinweg erhalten bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install Shell Integration and turn on “Settings > General > Save copy/paste and command history to disk” to remember command history per host across restarts of iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala la integración con el shell y activa “Ajustes > General > Guardar en disco el historial de copiar/pegar y de comandos” para recordar el historial de comandos por host entre reinicios de iTerm2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asenna komentotulkki-integraatio ja ota käyttöön ”Asetukset > Yleiset > Tallenna sijoitus- ja komentohistoria levylle”, niin komentohistoria muistetaan palvelinkohtaisesti iTerm2:n uudelleenkäynnistysten yli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez l’intégration du shell et activez « Réglages > Général > Enregistrer sur le disque l’historique de copier-coller et des commandes » pour conserver l’historique des commandes par hôte d’un redémarrage d’iTerm2 à l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa l’integrazione shell e attiva “Impostazioni > Generali > Salva su disco la cronologia di copia/incolla e dei comandi” per ricordare la cronologia dei comandi per host anche dopo il riavvio di iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合をインストールし、「設定 > 一般 > コピー/ペーストとコマンド履歴をディスクに保存」をオンにすると、iTerm2を再起動してもホストごとのコマンド履歴を記憶できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합을 설치하고 “설정 > 일반 > 복사/붙여넣기 및 명령 기록을 디스크에 저장”을 켜면 iTerm2를 재시작해도 호스트별 명령 기록이 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer skallintegrering og slå på «Innstillinger > Generelt > Lagre innlimings-, kopierings- og kommandohistorikk på disk» for å huske kommandohistorikken per vert på tvers av omstarter av iTerm2."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer shell-integratie en schakel ‘Instellingen > Algemeen > Bewaar kopieer-/plakgeschiedenis en commandogeschiedenis op schijf’ in om de commandogeschiedenis per host te onthouden na het herstarten van iTerm2."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zainstaluj integrację z powłoką i włącz „Ustawienia > Ogólne > Zapisuj historię kopiowania/wklejania i poleceń na dysku”, aby zapamiętywać historię poleceń dla każdego hosta po ponownym uruchomieniu iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale a Shell Integration e ative “Ajustes > Geral > Salvar histórico de cópia/colagem e de comandos no disco” para lembrar o histórico de comandos por host entre reinicializações do iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите интеграцию с оболочкой и включите «Настройки > Общие > Сохранять историю копирования/вставки и команд на диск», чтобы запоминать историю команд для каждого хоста между перезапусками iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainštalujte integráciu shellu a zapnite možnosť „Nastavenia > Všeobecné > Ukladať históriu kopírovania/vkladania a príkazov na disk“, aby sa história príkazov pre každého hostiteľa zachovala aj po reštarte iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namestite integracijo lupine in vklopite »Nastavitve > Splošno > Shrani zgodovino kopiranja/lepljenja in ukazov na disk«, da se zgodovina ukazov po gostitelju ohrani med ponovnimi zagoni aplikacije iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installera skalintegrering och slå på ”Inställningar > Allmänt > Spara historiken för kopiering/inklistring och kommandon på disk” för att komma ihåg kommandohistoriken per värd mellan omstarter av iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu’nu yükleyin ve iTerm2 yeniden başlatıldığında da ana makine başına komut geçmişini hatırlamak için “Ayarlar > Genel > Kopyalama/yapıştırma ve komut geçmişini diske kaydet”i açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt Tích hợp shell và bật “Cài đặt > Chung > Lưu lịch sử sao chép/dán và lệnh vào đĩa” để ghi nhớ lịch sử lệnh theo từng máy chủ qua các lần khởi động lại iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Shell Integration 并开启“设置 > 通用 > 将复制粘贴和命令历史保存至磁盘”，以便在 iTerm2 重启时保持每台主机上的命令历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝 Shell 整合並開啟「設定 > 一般 > 將拷貝/貼上與指令歷史記錄儲存到磁碟」，即可在 iTerm2 重新啟動後仍記住每個主機的指令歷史記錄。"
          }
        }
      }
    },
