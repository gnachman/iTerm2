          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzyskaj szczegółowe informacje o poleceniach, klikając znak zachęty polecenia z klawiszem ⌘."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenha informações detalhadas sobre comandos com ⌘-clique no prompt de comando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте подробную информацию о командах, щёлкая с ⌘ по приглашению оболочки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrobné informácie o príkazoch získate kliknutím so stlačeným ⌘ na výzvu príkazu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
