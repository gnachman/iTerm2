    "Tip.0108.Body" : {
      "comment" : "Tip of the day body, id 0108",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisieren Sie Ihren tmux-Einfügepuffer mit der lokalen Zwischenablage für eine nahtlose Integration (erfordert tmux 3.4)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sync your tmux paste buffer with the local clipboard for seamless integration (requires tmux 3.4)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza el búfer de pegado de tmux con el portapapeles local para una integración fluida (requiere tmux 3.4)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez le tampon de collage de tmux avec le presse-papiers local pour une intégration transparente (nécessite tmux 3.4)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza il buffer di incolla di tmux con gli Appunti locali per un’integrazione fluida (richiede tmux 3.4)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxのペーストバッファをローカルのクリップボードと同期し、シームレスな連携を実現します(tmux 3.4以降が必要です)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 붙여넣기 버퍼를 로컬 클립보드와 동기화하여 매끄럽게 연동할 수 있습니다(tmux 3.4 필요)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize o buffer de colagem do tmux com a área de transferência local para uma integração perfeita (requer tmux 3.4)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизируйте буфер вставки tmux с локальным буфером обмена для полной интеграции (требуется tmux 3.4)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorunsuz entegrasyon için tmux yapıştırma arabelleğinizi yerel panoyla eşitleyin (tmux 3.4 gerektirir)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 tmux 粘贴缓冲区与本地剪贴板同步，实现无缝集成（需使用 tmux 3.4）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 tmux 貼上緩衝區與本機剪貼簿同步，達到無縫整合（需要 tmux 3.4）。"
          }
        }
      }
    },
