    "TmuxController.UnsupportedOptionMessage" : {
      "comment" : "Error explaining that a tmux option is incompatible with iTerm2; %@ is the option name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tmux je zapnutá volba „%@“. Není kompatibilní s integrací iTerm2 a tmux. Vypněte ji a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillingen “%@” er slået til i tmux. Den er ikke kompatibel med integrationen mellem iTerm2 og tmux. Slå den fra, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Option „%@“ ist in tmux aktiviert. Sie ist nicht mit der iTerm2-tmux-Integration kompatibel. Bitte deaktivieren Sie sie und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “%@” option is turned on in tmux. It is not compatible with the iTerm2-tmux integration. Please disable it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción “%@” está activada en tmux. No es compatible con la integración de iTerm2 con tmux. Desactívala e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetus ”%@” on päällä tmuxissa. Se ei ole yhteensopiva iTerm2:n ja tmuxin integraation kanssa. Poista se käytöstä ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option « %@ » est activée dans tmux. Elle n’est pas compatible avec l’intégration iTerm2-tmux. Désactivez-la et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opzione “%@” è attiva in tmux. Non è compatibile con l’integrazione di iTerm2 con tmux. Disattivala e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxで「%@」オプションがオンになっています。これはiTerm2とtmuxの統合機能に対応していません。無効にしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux에서 “%@” 옵션이 켜져 있습니다. 이 옵션은 iTerm2-tmux 통합과 호환되지 않습니다. 옵션을 끄고 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativet «%@» er slått på i tmux. Det er ikke kompatibelt med iTerm2-tmux-integreringen. Slå det av og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De optie ‘%@’ is ingeschakeld in tmux. Die is niet compatibel met de integratie van iTerm2 en tmux. Schakel de optie uit en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja „%@” jest włączona w tmux. Nie jest zgodna z integracją iTerm2 z tmux. Wyłącz ją i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção “%@” está ativada no tmux. Ela não é compatível com a integração iTerm2-tmux. Desative-a e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опция «%@» включена в tmux. Она несовместима с интеграцией iTerm2-tmux. Отключите её и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voľba „%@“ je v tmux zapnutá. Nie je kompatibilná s integráciou iTerm2 a tmux. Vypnite ju a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnost »%@« je v tmux vklopljena. Ni združljiva z integracijo iTerm2-tmux. Izklopite jo in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativet ”%@” är påslaget i tmux. Det är inte kompatibelt med integreringen mellan iTerm2 och tmux. Stäng av det och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux’ta “%@” seçeneği açık. Bu seçenek iTerm2-tmux entegrasyonuyla uyumlu değil. Lütfen devre dışı bırakıp yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn “%@” đang được bật trong tmux. Nó không tương thích với tích hợp iTerm2-tmux. Vui lòng tắt nó và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 中启用了“%@”选项。它与 iTerm2-tmux 集成不兼容。请将其停用后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 中已開啟「%@」選項，它與 iTerm2 的 tmux 整合不相容。請停用該選項後再試一次。"
          }
        }
      }
