    "ClaudeCodeOnboarding.InstallTriggersBody" : {
      "comment" : "Body of the alert asking which profiles to add auto-enter triggers to",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte profily, ve kterých budete spouštět claude. Do každého z nich přidáme spouštěče „Vstoupit do pracovní skupiny“ a „Opustit pracovní skupinu“, aby se do pracovní skupiny Claude Code vstupovalo automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de profiler, du kører claude i. Vi tilføjer udløserne Gå ind i arbejdsgruppe og Forlad arbejdsgruppe til hver af dem, så Claude Code-arbejdsgruppen startes automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Profile aus, in denen Sie claude ausführen. Wir fügen jedem davon Trigger zum Betreten/Verlassen der Arbeitsgruppe hinzu, damit die Claude-Code-Arbeitsgruppe automatisch betreten wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pick the profiles you’ll run claude in. We’ll add Enter/Exit Workgroup triggers to each one so the Claude Code workgroup is entered automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los perfiles en los que ejecutarás claude. Añadiremos disparadores Entrar en grupo de trabajo/Salir del grupo de trabajo a cada uno para que se entre automáticamente en el grupo de trabajo de Claude Code."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse profiilit, joissa suoritat clauden. Lisäämme jokaiseen Siirry työryhmään / Poistu työryhmästä -käynnistimet, jotta Claude Code -työryhmään siirrytään automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les profils dans lesquels vous exécuterez claude. Nous ajouterons à chacun des déclencheurs d’entrée/sortie de groupe de travail afin que le groupe de travail Claude Code soit activé automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli i profili in cui eseguirai claude. Aggiungeremo a ciascuno gli attivatori Entra nel gruppo di lavoro/Esci dal gruppo di lavoro, così il gruppo di lavoro di Claude Code viene attivato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "claudeを実行するプロファイルを選択してください。Claude Codeワークグループが自動的に開始されるよう、それぞれにワークグループ参加/退出トリガーを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "claude를 실행할 프로파일을 선택하십시오. 각 프로파일에 워크그룹 진입/종료 트리거를 추가하여 Claude Code 워크그룹에 자동으로 진입하도록 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg profilene du kjører claude i. Vi legger til utløsere for å gå inn i og ut av arbeidsgruppe i hver av dem, slik at Claude Code-arbeidsgruppen åpnes automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de profielen waarin je claude gaat uitvoeren. We voegen aan elk profiel de triggers Ga naar werkgroep/Verlaat werkgroep toe, zodat de werkgroep Claude Code automatisch wordt betreden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz profile, w których będziesz uruchamiać claude. Do każdego z nich dodamy wyzwalacze „Dołącz do grupy roboczej” i „Opuść grupę roboczą”, aby grupa robocza Claude Code była włączana automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os perfis nos quais você executará o claude. Adicionaremos gatilhos de entrar/sair do workgroup a cada um deles para que o workgroup do Claude Code seja acessado automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите профили, в которых вы будете запускать claude. Мы добавим в каждый из них триггеры Enter/Exit Workgroup, чтобы рабочая группа Claude Code входила автоматически."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte profily, v ktorých budete spúšťať claude. Do každého z nich pridáme spúšťače Vstúpiť do pracovnej skupiny/Opustiť pracovnú skupinu, aby sa do pracovnej skupiny Claude Code vstupovalo automaticky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite profile, v katerih boste zagnali claude. Vsakemu bomo dodali sprožilca »Vstopi v delovno skupino« in »Zapusti delovno skupino«, da se v delovno skupino Claude Code vstopi samodejno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj de profiler du kör claude i. Vi lägger till utlösarna Gå in i/Lämna arbetsgrupp i var och en så att arbetsgruppen Claude Code öppnas automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude’u çalıştıracağınız profilleri seçin. Claude Code çalışma grubuna otomatik girilmesi için her birine Çalışma Grubuna Gir/Çalışma Grubundan Çık tetikleyicileri ekleyeceğiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn các hồ sơ bạn sẽ chạy claude. Chúng tôi sẽ thêm các trình kích hoạt Vào/Thoát nhóm làm việc vào từng hồ sơ để nhóm làm việc Claude Code được vào tự động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你将在其中运行 claude 的配置文件。我们将为每个配置文件添加“进入/退出工作组”触发器，以便自动进入 Claude Code 工作组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇你會在其中執行 claude 的描述檔。我們會為每個描述檔加入「進入／結束工作群組」觸發器，以便自動進入 Claude Code 工作群組。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.InstallTriggersDescription" : {
      "comment" : "Description of the install-triggers onboarding step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte profily terminálu, ve kterých spouštíte claude. iTerm2 přidá spouštěče, aby se do pracovní skupiny Claude Code vstoupilo automaticky při spuštění claude a opustila se po jeho ukončení.\n\nBez toho můžete do pracovní skupiny stále vstoupit ručně přes „Shell > Pracovní skupiny > Claude Code“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de terminalprofiler, hvor du kører claude. iTerm2 tilføjer udløsere, så Claude Code-arbejdsgruppen startes automatisk, når claude starter, og forlades, når den stopper.\n\nUden dette kan du stadig starte arbejdsgruppen manuelt via Shell > Arbejdsgrupper > Claude Code."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die Terminalprofile aus, in denen Sie claude ausführen. iTerm2 fügt Trigger hinzu, damit die Claude-Code-Arbeitsgruppe automatisch betreten wird, wenn claude startet, und verlassen wird, wenn es endet.\n\nOhne dies können Sie die Arbeitsgruppe weiterhin manuell über Shell > Arbeitsgruppen > Claude Code betreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pick the terminal profiles where you run claude. iTerm2 will add triggers so the Claude Code workgroup is entered automatically when claude starts and exited when it stops.\n\nWithout this, you can still enter the workgroup manually via Shell > Workgroups > Claude Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige los perfiles de terminal en los que ejecutas claude. iTerm2 añadirá disparadores para que se entre automáticamente en el grupo de trabajo de Claude Code cuando claude se inicie y se salga cuando se detenga.\n\nSin esto, aún puedes entrar en el grupo de trabajo manualmente desde Shell > Grupos de trabajo > Claude Code."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse päätteen profiilit, joissa suoritat clauden. iTerm2 lisää käynnistimet, jotta Claude Code -työryhmään siirrytään automaattisesti clauden käynnistyessä ja siitä poistutaan sen pysähtyessä.\n\nIlman tätä voit silti siirtyä työryhmään käsin valikosta Komentotulkki > Työryhmät > Claude Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les profils de terminal dans lesquels vous exécutez claude. iTerm2 ajoutera des déclencheurs pour que le groupe de travail Claude Code soit activé automatiquement au démarrage de claude et quitté à son arrêt.\n\nSans cela, vous pouvez toujours entrer manuellement dans le groupe de travail via Shell > Groupes de travail > Claude Code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli i profili di terminale in cui esegui claude. iTerm2 aggiungerà attivatori in modo che il gruppo di lavoro di Claude Code venga attivato automaticamente all’avvio di claude e abbandonato quando termina.\n\nSenza questo, puoi comunque entrare nel gruppo di lavoro manualmente da Shell > Gruppi di lavoro > Claude Code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "claudeを実行するターミナルプロファイルを選択してください。iTerm2は、claudeの開始時に自動的にClaude Codeワークグループに入り、終了時に自動的に抜けるようにトリガーを追加します。\n\nこれを行わなくても、Shell > ワークグループ > Claude Codeから手動でワークグループに入ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "claude를 실행하는 터미널 프로파일을 선택하십시오. iTerm2가 트리거를 추가하여 claude가 시작되면 Claude Code 워크그룹에 자동으로 진입하고 claude가 중단되면 워크그룹에서 나옵니다.\n\n이 설정이 없어도 셸 > 워크그룹 > Claude Code에서 수동으로 워크그룹에 진입할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg terminalprofilene der du kjører claude. iTerm2 legger til utløsere slik at Claude Code-arbeidsgruppen åpnes automatisk når claude starter og avsluttes når den stopper.\n\nUten dette kan du fortsatt gå inn i arbeidsgruppen manuelt via «Skall > Arbeidsgrupper > Claude Code»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de terminalprofielen waarin je claude uitvoert. iTerm2 voegt triggers toe, zodat de werkgroep Claude Code automatisch wordt betreden wanneer claude start en wordt verlaten wanneer claude stopt.\n\nZonder dit kun je de werkgroep nog steeds handmatig betreden via Shell > Werkgroepen > Claude Code."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz profile terminala, w których uruchamiasz claude. iTerm2 doda wyzwalacze, dzięki którym grupa robocza Claude Code będzie włączana automatycznie po uruchomieniu claude i opuszczana po jego zatrzymaniu.\n\nBez tego nadal możesz wejść do grupy roboczej ręcznie przez Powłoka > Grupy robocze > Claude Code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os perfis de terminal nos quais você executa o claude. O iTerm2 adicionará gatilhos para que o workgroup do Claude Code seja acessado automaticamente quando o claude iniciar e deixado quando ele parar.\n\nSem isso, você ainda pode entrar no workgroup manualmente por meio de Shell > Workgroups > Claude Code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите профили терминала, в которых вы запускаете claude. iTerm2 добавит триггеры, чтобы рабочая группа Claude Code входила автоматически при запуске claude и выходила при его остановке.\n\nБез этого вы всё равно сможете войти в рабочую группу вручную через Shell > Workgroups > Claude Code."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte profily terminálu, v ktorých spúšťate claude. iTerm2 pridá spúšťače, aby sa do pracovnej skupiny Claude Code vstúpilo automaticky pri spustení claude a opustila sa pri jeho zastavení.\n\nBez tohto môžete do pracovnej skupiny stále vstúpiť ručne cez menu „Shell > Pracovné skupiny > Claude Code“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izberite profile terminala, v katerih zaganjate claude. iTerm2 bo dodal sprožilce, tako da se v delovno skupino Claude Code vstopi samodejno ob zagonu claude in izstopi ob njegovem koncu.\n\nBrez tega lahko v delovno skupino še vedno vstopite ročno prek »Lupina > Delovne skupine > Claude Code«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj de terminalprofiler där du kör claude. iTerm2 lägger till utlösare så att arbetsgruppen Claude Code öppnas automatiskt när claude startar och lämnas när den stoppar.\n\nUtan detta kan du fortfarande gå in i arbetsgruppen manuellt via Skal > Arbetsgrupper > Claude Code."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude’u çalıştırdığınız terminal profillerini seçin. iTerm2, claude başladığında Claude Code çalışma grubuna otomatik girilmesi ve durduğunda çıkılması için tetikleyiciler ekler.\n\nBu olmadan da çalışma grubuna Kabuk > Çalışma Grupları > Claude Code ile elle girebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn các hồ sơ terminal nơi bạn chạy claude. iTerm2 sẽ thêm các trình kích hoạt để nhóm làm việc Claude Code được tự động vào khi claude khởi động và thoát khi claude dừng.\n\nNếu không, bạn vẫn có thể vào nhóm làm việc bằng tay qua Shell > Nhóm làm việc > Claude Code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你运行 claude 的终端配置文件。iTerm2 会添加触发器，使 Claude Code 工作组在 claude 启动时自动进入、停止时自动退出。\n\n如果没有此项，你仍可通过 外壳 > 工作组 > Claude Code 手动进入工作组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇你執行 claude 的終端機描述檔。iTerm2 會加入觸發器，讓 Claude Code 工作群組在 claude 啟動時自動進入、停止時自動結束。\n\n如果沒有此項，你仍可透過「Shell > 工作群組 > Claude Code」手動進入工作群組。"
          }
        }
      }
    },
