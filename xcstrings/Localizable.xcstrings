        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyiciler için hızlı düzenli ifade değerlendirmesi.\nDüzenli ifadelerin yorumlanma biçimini değiştirebileceğinden bu deneyseldir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh giá biểu thức chính quy nhanh cho trình kích hoạt.\nĐây là thử nghiệm vì có thể thay đổi cách diễn giải biểu thức chính quy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于触发器的快速正则表达式评估功能。\n该功能仍处于测试阶段，因为可能会改变正则表达式的解析方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
