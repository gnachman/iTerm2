    "Workgroup.TmuxTooOld" : {
      "comment" : "Shown when the user tries to enter a workgroup in a tmux Integration session whose tmux is older than 3.2",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsgruppen in einer tmux-Integrationssitzung erfordern tmux 3.2 oder neuer. Aktualisieren Sie tmux oder rufen Sie die Arbeitsgruppe in einer Sitzung auf, die keine tmux-Integration verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Workgroups in a tmux Integration session need tmux 3.2 or later. Update tmux, or enter the workgroup in a session that isn’t using tmux Integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos de trabajo en una sesión con integración con tmux requieren tmux 3.2 o posterior. Actualiza tmux o entra en el grupo de trabajo en una sesión que no use la integración con tmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes de travail dans une session avec Intégration tmux nécessitent tmux 3.2 ou une version ultérieure. Mettez tmux à jour, ou entrez dans le groupe de travail depuis une session qui n’utilise pas l’Intégration tmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi di lavoro in una sessione con Integrazione tmux richiedono tmux 3.2 o successivo. Aggiorna tmux oppure entra nel gruppo di lavoro in una sessione che non usa l’Integrazione tmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合のセッションでワークグループを使うには、tmux 3.2以降が必要です。tmuxをアップデートするか、tmux統合を使用していないセッションでワークグループに入ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합 세션에서 워크그룹을 사용하려면 tmux 3.2 이상이 필요합니다. tmux를 업데이트하거나 tmux 통합을 사용하지 않는 세션에서 워크그룹에 진입하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupos de trabalho em uma sessão de Integração com tmux exigem o tmux 3.2 ou posterior. Atualize o tmux ou entre no grupo de trabalho em uma sessão que não use a Integração com tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для рабочих групп в сеансе интеграции с tmux нужен tmux 3.2 или новее. Обновите tmux или войдите в рабочую группу в сеансе, который не использует интеграцию с tmux."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux Entegrasyonu oturumundaki çalışma grupları tmux 3.2 veya daha yenisini gerektirir. tmux’u güncelleyin ya da çalışma grubuna tmux Entegrasyonu kullanmayan bir oturumda girin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 集成会话中使用工作组需要 tmux 3.2 或更高版本。请更新 tmux，或在未使用 tmux 集成的会话中进入工作组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 整合工作階段中的工作群組需要 tmux 3.2 或更新版本。請更新 tmux，或在未使用 tmux 整合的工作階段中進入工作群組。"
          }
        }
      }
    },
