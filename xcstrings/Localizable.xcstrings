    "AdvancedSetting.hotKeyDoubleTapMaxDelay" : {
      "comment" : "Advanced setting: hotKeyDoubleTapMaxDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální doba povolená mezi stisky modifikační klávesy při dvojitém stisku modifikační klávesy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
