    "Tip.0033.Body" : {
      "comment" : "Tip of the day body, id 0033",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie mit der rechten Maustaste auf einen Tab, um dessen Farbe zu ändern, nachfolgende Tabs zu schließen oder alle anderen Tabs zu schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Right click on a tab to change its color, close tabs after it, or to close all other tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic con el botón derecho en una pestaña para cambiar su color, cerrar las pestañas posteriores o cerrar todas las demás pestañas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur un onglet pour changer sa couleur, fermer les onglets suivants ou fermer tous les autres onglets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con il tasto destro su un pannello per cambiarne il colore, chiudere i pannelli successivi o chiudere tutti gli altri pannelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを右クリックすると、色を変更したり、それ以降のタブを閉じたり、他のすべてのタブを閉じたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 오른쪽 클릭하여 탭 색상을 변경하거나, 그 뒤의 탭을 닫거나, 다른 모든 탭을 닫을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma aba para mudar sua cor, fechar as abas seguintes ou fechar todas as outras abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните правой кнопкой мыши по вкладке, чтобы изменить её цвет, закрыть вкладки после неё или закрыть все остальные вкладки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rengini değiştirmek, kendisinden sonraki sekmeleri kapatmak veya diğer tüm sekmeleri kapatmak için bir sekmeye sağ tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签页上右键点击可更改其颜色，点击后关闭该标签页，或同时关闭所有其他标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在標籤頁上按一下右鍵，可以變更它的顏色、關閉它之後的標籤頁，或關閉所有其他標籤頁。"
          }
        }
      }
    },
