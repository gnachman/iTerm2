    "Companion.ShowCode.Body" : {
      "comment" : "Explanatory paragraph on the show-pairing-code screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na svém iPhonu otevřete iTerm2 Buddy a klepněte na Skenovat. Poté níže zobrazte párovací kód a zaměřte na něj kameru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn iTerm2 Buddy på din iPhone, og tryk på Scan. Vis derefter sammenkoblingskoden nedenfor, og ret kameraet mod den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie auf Ihrem iPhone iTerm2 Buddy und tippen Sie auf Scannen. Zeigen Sie dann den Kopplungscode unten an und richten Sie die Kamera darauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On your iPhone, open iTerm2 Buddy and tap Scan. Then reveal the pairing code below and point the camera at it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu iPhone, abre iTerm2 Buddy y toca Escanear. Luego muestra el código de emparejamiento de abajo y apunta la cámara hacia él."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa iPhonessasi iTerm2 Buddy ja napauta Skannaa. Paljasta sitten alla oleva parin muodostuskoodi ja osoita kameralla siihen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre iPhone, ouvrez iTerm2 Buddy et touchez Scanner. Puis affichez le code d’association ci-dessous et pointez l’appareil photo vers lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul tuo iPhone, apri iTerm2 Buddy e tocca Scansiona. Poi mostra qui sotto il codice di associazione e inquadralo con la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでiTerm2 Buddyを開き、「スキャン」をタップしてください。次に、下のペアリングコードを表示してカメラを向けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 iTerm2 Buddy를 열고 Scan을 탭하십시오. 그런 다음 아래의 페어링 코드를 표시하고 카메라를 코드에 맞추십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne iTerm2 Buddy på iPhone og trykk på Skann. Vis deretter paringskoden nedenfor og pek kameraet mot den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open iTerm2 Buddy op je iPhone en tik op Scan. Toon daarna hieronder de koppelcode en richt de camera erop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na urządzeniu iPhone otwórz iTerm2 Buddy i stuknij Skanuj. Następnie pokaż poniższy kod parowania i skieruj na niego aparat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu iPhone, abra o iTerm2 Buddy e toque em Escanear. Depois revele o código de pareamento abaixo e aponte a câmera para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем iPhone откройте iTerm2 Buddy и нажмите «Сканировать». Затем откройте код сопряжения ниже и наведите на него камеру."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhone otvorte iTerm2 Buddy a klepnite na „Skenovať“. Potom nižšie zobrazte párovací kód a zamierte naň kameru."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhonu odprite iTerm2 Buddy in tapnite »Skeniraj«. Nato spodaj prikažite kodo za seznanjanje in nanjo usmerite kamero."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna iTerm2 Buddy på din iPhone och tryck på Skanna. Visa sedan ihopparningskoden nedan och rikta kameran mot den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzda iTerm2 Buddy’yi açıp Tara’ya dokunun. Ardından aşağıdaki eşleştirme kodunu gösterip kamerayı ona doğrultun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên iPhone, hãy mở iTerm2 Buddy và chạm vào Quét. Sau đó hiển thị mã ghép nối bên dưới và hướng camera vào mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打开 iTerm2 Buddy，点击“Scan”。然后显示下方的配对代码，并将摄像头对准该代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打開 iTerm2 Buddy 並點一下 Scan。然後顯示下方的配對代碼，並將相機對準該代碼。"
          }
        }
      }
    },
