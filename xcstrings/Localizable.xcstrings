    "Tip.0046.Body" : {
      "comment" : "Tip of the day body, id 0046",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barvy panelů můžete přiřadit v „Nastavení > Profily > Barvy“ nebo v nabídce Zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan tildele farver til faner i “Indstillinger > Profiler > Farver” eller i menuen Oversigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Tabs Farben zuweisen, entweder unter „Einstellungen > Profile > Farben“ oder im Menü „Ansicht“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can assign colors to tabs in “Settings > Profiles > Colors,” or in the View menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes asignar colores a las pestañas en “Ajustes > Perfiles > Colores” o en el menú Visualización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit määrittää värejä välilehdille kohdassa ”Asetukset > Profiilit > Värit” tai Näytä-valikossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez attribuer des couleurs aux onglets dans « Réglages > Profils > Couleurs » ou dans le menu Présentation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi assegnare colori ai pannelli in “Impostazioni > Profili > Colori” oppure nel menu Vista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」、または表示メニューでタブに色を割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상” 또는 보기 메뉴에서 탭에 색상을 지정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan tilordne farger til faner i «Innstillinger > Profiler > Farger» eller i Vis-menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt kleuren aan tabbladen toewijzen in ‘Instellingen > Profielen > Kleuren’ of in het menu Weergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolory kart możesz przypisać w „Ustawienia > Profile > Kolory” lub w menu Widok."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode atribuir cores às abas em “Ajustes > Perfis > Cores” ou no menu Visualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
