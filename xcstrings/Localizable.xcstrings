    "NaggingController.ResetKeyReportingMode" : {
      "comment" : "Prompt asking whether to reset the key reporting mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Modus zur Tastenberichterstattung wurde möglicherweise in einer ungewöhnlichen Einstellung belassen, als eine ssh-Sitzung abbrach oder eine App abgestürzt ist. Wiederherstellen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The key reporting mode may have been left in an unusual setting when an ssh session died or an app crashed. Restore?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el modo de informe de teclas haya quedado en un estado inusual cuando una sesión ssh murió o una app falló. ¿Restaurarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode de signalement des touches a peut-être été laissé dans un état inhabituel après la fin d’une session ssh ou le plantage d’une app. Le restaurer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità di segnalazione dei tasti potrebbe essere rimasta in un’impostazione insolita perché una sessione ssh è terminata o un’app è andata in crash. Ripristinarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが切断されたか、アプリがクラッシュしたため、キーレポートモードが通常とは異なる設定のままになっている可能性があります。復元しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh 세션이 종료되거나 앱이 충돌했을 때 키 리포팅 모드가 비정상적인 설정으로 남아 있을 수 있습니다. 복원하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de relatório de teclas pode ter ficado em uma configuração incomum quando uma sessão ssh foi encerrada ou um app travou. Restaurar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
