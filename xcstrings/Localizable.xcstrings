    "Tip.0109.Body" : {
      "comment" : "Tip of the day body, id 0109",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vylepšete úpravy v editoru příkazů pomocí více kurzorů, které vytvoříte pomocí ^⇧-nahoru/dolů nebo ⌥-přetažením."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedr din redigering i kommandoeditoren med flere markører, som oprettes med ^⇧-op/ned eller ⌥-træk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessern Sie Ihre Bearbeitung im Composer mit mehreren Cursor, die Sie mit ^⇧-nach oben/unten oder ⌥-Ziehen erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enhance your editing in the Composer with multiple cursors, created using ^⇧-up/down or ⌥-drag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora tu edición en el compositor con varios cursores, que se crean con ^⇧-arriba/abajo o ⌥-arrastrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehosta muokkausta komentoeditorissa useilla kohdistimilla, jotka luodaan näppäimillä ^⇧-ylös/alas tai ⌥-vetämällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliorez votre édition dans le compositeur avec des curseurs multiples, créés avec ^⇧-haut/bas ou ⌥-glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliora la modifica nel Compositore con più cursori, creati con ^⇧-su/giù o ⌥-trascinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧上/下または⌥ドラッグで作成できる複数カーソルを使うと、コンポーザーでの編集がさらに快適になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧-위/아래 화살표 또는 ⌥-드래그로 만드는 다중 커서를 사용하여 컴포저에서 더 효율적으로 편집해 보십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedre redigeringen i kommandoskriveren med flere markører, som lages med ^⇧-opp/ned eller ⌥-dra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbeter het bewerken in de Opsteller met meerdere cursors, aan te maken met ^⇧-omhoog/omlaag of ⌥-slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulepsz edycję w edytorze poleceń za pomocą wielu kursorów, tworzonych skrótem ^⇧ + strzałka w górę/w dół lub przeciąganiem z ⌥."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua edição no Compositor com múltiplos cursores, criados usando ^⇧-cima/baixo ou ⌥-arrastar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшите редактирование в Композере с помощью нескольких курсоров, создаваемых с помощью ^⇧-вверх/вниз или ⌥-перетаскивания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vylepšite úpravy v editore príkazov pomocou viacerých kurzorov, ktoré vytvoríte pomocou ^⇧-nahor/nadol alebo ⌥-ťahania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izboljšajte urejanje v urejevalniku ukazov z več kazalci, ki jih ustvarite z ^⇧-navzgor/navzdol ali ⌥-vlečenjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förbättra redigeringen i kommandoredigeraren med flera markörer, som skapas med ^⇧-upp/ned eller ⌥-dra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧-yukarı/aşağı veya ⌥-sürükleme ile oluşturulan birden çok imleçle Oluşturucu’daki düzenlemenizi geliştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nâng cao khả năng sửa trong Trình soạn lệnh với nhiều con trỏ, tạo bằng ^⇧-lên/xuống hoặc ⌥-kéo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Composer 中，使用 ^⇧-上/下或 ⌥-拖拽功能添加多个光标，以改进编辑体验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編寫器中使用多重游標提升編輯效率，可用 ^⇧-上/下或 ⌥-拖移來建立。"
          }
        }
      }
    },
