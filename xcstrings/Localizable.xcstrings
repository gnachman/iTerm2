    "ChatViewController.NeedsLiveSessionBrowser" : {
      "comment" : "Shown when the AI needs a live web browser session but none is attached",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent AI potřebuje spouštět příkazy v aktivní relaci webového prohlížeče, ale k tomuto chatu žádná není připojena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-agenten skal køre kommandoer i en aktiv webbrowsersession, men ingen er knyttet til denne chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der KI-Agent muss Befehle in einer aktiven Webbrowser-Sitzung ausführen, aber diesem Chat ist keine zugeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI agent needs to run commands in a live web browser session, but none is attached to this chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente de IA necesita ejecutar comandos en una sesión de navegador web activa, pero no hay ninguna adjunta a este chat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-agentin täytyy suorittaa komentoja aktiivisessa verkkoselainistunnossa, mutta tähän keskusteluun ei ole liitetty yhtään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agent IA doit exécuter des commandes dans une session de navigateur web active, mais aucune n’est jointe à ce chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agente IA deve eseguire comandi in una sessione attiva del browser web, ma nessuna è collegata a questa chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIエージェントはライブのWebブラウザセッションでコマンドを実行する必要がありますが、このチャットには接続されているセッションがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 에이전트가 실행 중인 웹 브라우저 세션에서 명령을 실행해야 하지만 이 채팅에 연결된 세션이 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-agenten må kjøre kommandoer i en aktiv nettleserøkt, men ingen er koblet til denne chatten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AI-agent moet commando’s uitvoeren in een actieve webbrowsersessie, maar er is er geen aan deze chat gekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent AI musi uruchamiać polecenia w aktywnej sesji przeglądarki internetowej, ale żadna nie jest dołączona do tego czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agente de IA precisa executar comandos em uma sessão de navegador da web ativa, mas nenhuma está anexada a este chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агенту ИИ нужно выполнить команды в активной сессии веб-браузера, но к этому чату не подключена ни одна сессия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
