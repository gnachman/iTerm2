    "PTYSession.ShellDoesNotExist" : {
      "comment" : "Warning that the account’s shell does not exist; placeholder is the shell path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shell für dieses Konto, „%@“, existiert nicht. Soll das Profil stattdessen /bin/zsh verwenden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The shell for this account, “%@”, does not exist. Change the profile to use /bin/zsh instead?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El shell de esta cuenta, “%@”, no existe. ¿Cambiar el perfil para usar /bin/zsh?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le shell de ce compte, « %@ », n’existe pas. Modifier le profil pour utiliser /bin/zsh à la place ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La shell di questo account, “%@”, non esiste. Vuoi modificare il profilo per usare /bin/zsh?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのシェル「%@」は存在しません。プロファイルを/bin/zshを使用するように変更しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 셸 “%@”이(가) 존재하지 않습니다. 대신 /bin/zsh를 사용하도록 프로파일을 변경하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O shell desta conta, “%@”, não existe. Alterar o perfil para usar /bin/zsh?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оболочка для этой учётной записи, «%@», не существует. Изменить профиль, чтобы использовать /bin/zsh вместо неё?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesabın kabuğu olan “%@” mevcut değil. Bunun yerine /bin/zsh kullanmak için profil değiştirilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户的 shell“%@”不存在。是否将配置文件更改为使用 /bin/zsh？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此帳號的 shell「%@」不存在。要將描述檔改為使用 /bin/zsh 嗎？"
          }
        }
      }
    },
