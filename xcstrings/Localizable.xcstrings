        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursief omzetten in omgekeerde video in tmux-integratie?\nDit werkt wanneer de standaard TERM die tmux meldt overeenkomt met *screen*."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamieniać kursywę na odwrócony obraz w integracji z tmux?\nDziała, gdy domyślny TERM zgłaszany przez tmux pasuje do *screen*."
