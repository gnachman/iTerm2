    "AdvancedSetting.cmdClickWhenInactiveInvokesSemanticHistory" : {
      "comment" : "Advanced setting: cmdClickWhenInactiveInvokesSemanticHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-Klick in einem aktiven Bereich ruft Semantic History auf, während iTerm2 nicht die aktive App ist.\nStandardmäßig hält sich iTerm2 an den Systemstandard, wonach ein ⌘-Klick in einer App ohne Tastaturfokus sich wie ein Klick ohne ⌘ verhält, der das Fenster nicht in den Vordergrund holt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘-click in an active pane while iTerm2 isn't the active app invokes Semantic History.\nBy default, iTerm2 respects the OS standard that ⌘-click in an app that doesn't have keyboard focus behaves like a non-⌘ click that does not raise the window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer ⌘-clic en un panel activo mientras iTerm2 no es la app activa se invoca el historial semántico.\nDe forma predeterminada, iTerm2 respeta el estándar del sistema por el que un ⌘-clic en una app que no tiene el foco del teclado se comporta como un clic sin ⌘ que no trae la ventana al frente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clic dans un volet actif alors qu’iTerm2 n’est pas l’app active invoque l’historique sémantique.\nPar défaut, iTerm2 respecte la norme du système selon laquelle un ⌘-clic dans une app qui n’a pas le focus clavier se comporte comme un clic sans ⌘ qui ne place pas la fenêtre au premier plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clic in un riquadro attivo mentre iTerm2 non è l’app attiva richiama la cronologia semantica.\nPer impostazione predefinita, iTerm2 rispetta lo standard del sistema per cui ⌘-clic in un’app che non ha il focus della tastiera si comporta come un clic senza ⌘ che non porta la finestra in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 がアクティブなアプリでないときに、アクティブなペインで ⌘ クリックするとセマンティック履歴を呼び出します。\nデフォルトでは、iTerm2 は OS の標準的な動作に従い、キーボードフォーカスを持たないアプリでの ⌘ クリックは、ウィンドウを前面に出さない非 ⌘ クリックと同様に動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 활성 앱이 아닐 때 활성 패널에서 ⌘-클릭하면 시맨틱 히스토리가 실행됩니다.\n기본적으로 iTerm2는 키보드 포커스가 없는 앱에서의 ⌘-클릭이 윈도우를 앞으로 가져오지 않는, ⌘ 없는 클릭처럼 동작하는 OS 표준을 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clique em um painel ativo enquanto o iTerm2 não é o app ativo invoca o Semantic History.\nPor padrão, o iTerm2 respeita o padrão do sistema de que ⌘-clique em um app que não tem o foco do teclado se comporta como um clique sem ⌘ que não traz a janela à frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-щелчок в активной панели, когда iTerm2 не является активным приложением, вызывает Semantic History.\nПо умолчанию iTerm2 соблюдает стандарт ОС, согласно которому ⌘-щелчок в приложении без фокуса клавиатуры ведёт себя как обычный щелчок без ⌘, не поднимающий окно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 etkin uygulama değilken etkin bir bölmede ⌘-tıklama Anlamsal Geçmişi çağırır.\nVarsayılan olarak iTerm2, klavye odağı olmayan bir uygulamada ⌘-tıklamanın, pencereyi öne getirmeyen ⌘’siz bir tıklama gibi davranması yönündeki işletim sistemi standardına uyar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当iTerm2不是活动应用时，在活动窗格中按⌘键会触发语义历史功能\n默认情况下，iTerm2遵循操作系统标准：非键盘焦点的应用中的⌘键点击不会弹出窗口，行为类似于非⌘的点击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 不是使用中的 App 時，在使用中的窗格內按 ⌘ 並按一下會叫用語意歷史記錄。\n依預設，iTerm2 遵循系統標準：在沒有鍵盤焦點的 App 中按 ⌘ 並按一下，其行為如同不按 ⌘ 的按一下，且不會將視窗移至最前。"
          }
        }
      }
    },
    "AdvancedSetting.codeciergeCommandWarningCount" : {
      "comment" : "Advanced setting: codeciergeCommandWarningCount",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dieser Anzahl an Befehlen soll Codecierge bestätigen lassen, dass Sie es weiterhin aktiviert lassen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "After this many commands, make codecierge confirm that you intend to keep it enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras esta cantidad de comandos, hacer que codecierge confirme que quieres mantenerlo activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
