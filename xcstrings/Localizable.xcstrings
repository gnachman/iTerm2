    "Tip.0118.Body" : {
      "comment" : "Tip of the day body, id 0118",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können ein Profil als Webbrowser konfigurieren! Stellen Sie unter „Einstellungen > Profile > Allgemein“ den „Profiltyp“ auf „Webbrowser“. Tastenkombinationen, intelligente Auswahl und der Passwort-Manager funktionieren auch in Browser-Sitzungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can configure a profile to be a web browser! In “Settings > Profiles > General”, set “Profile Type” to “Web Browser”. Key bindings, smart selection, and the password manager all work in browser sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Puedes configurar un perfil para que sea un navegador web! En “Ajustes > Perfiles > General”, establece “Tipo de perfil” en “Navegador web”. Las asignaciones de teclas, la selección inteligente y el gestor de contraseñas funcionan en las sesiones de navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez configurer un profil pour qu’il soit un navigateur web ! Dans « Réglages > Profils > Général », définissez « Type de profil » sur « Navigateur web ». Les associations de touches, la sélection intelligente et le gestionnaire de mots de passe fonctionnent tous dans les sessions de navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi configurare un profilo come browser web! In “Impostazioni > Profili > Generali” imposta “Tipo di profilo” su “Browser web”. Le associazioni tasti, la selezione intelligente e il gestore password funzionano nelle sessioni del browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルをウェブブラウザとして設定できます！「設定 > プロファイル > 一般」で「プロファイルタイプ」を「ウェブブラウザ」に設定してください。キーバインド、スマート選択、パスワードマネージャーはすべてブラウザセッションでも動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일을 웹 브라우저로 설정할 수 있습니다! “설정 > 프로파일 > 일반”에서 “프로파일 유형”을 “웹 브라우저”로 설정하십시오. 키 바인딩, 스마트 선택, 암호 관리자 모두 브라우저 세션에서 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar um perfil para ser um navegador da web! Em “Settings > Profiles > General”, defina “Profile Type” como “Web Browser”. Atalhos de teclado, seleção inteligente e o cofre de senhas funcionam todos em sessões de navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить профиль так, чтобы он работал как веб-браузер! В разделе «Настройки > Профили > Общие» установите для параметра «Тип профиля» значение «Веб-браузер». Привязки клавиш, умный выбор и менеджер паролей работают и в сеансах браузера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir profili web tarayıcısı olacak şekilde yapılandırabilirsiniz! “Ayarlar > Profiller > Genel” bölümünde “Profil Türü”nü “Web Tarayıcısı” olarak ayarlayın. Tuş atamaları, akıllı seçim ve parola yöneticisi tarayıcı oturumlarında çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以配置配置文件为网页浏览器！在“设置 > 配置文件 > 通用”中，将“配置文件类型”设置为“网页浏览器”。按键绑定、智能选取以及密码管理器均可在浏览器会话中正常使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以將描述檔設定為網頁瀏覽器！在「設定 > 描述檔 > 一般」中，將「描述檔類型」設為「瀏覽器」。按鍵對應、智慧型選取和密碼管理器都能在瀏覽器工作階段中使用。"
          }
        }
      }
    },
