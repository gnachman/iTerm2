    "PasswordManager.GeneratePasswordTooltip" : {
      "comment" : "Tooltip for the generate-password (dice) button",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vygeneruje náhodné heslo. Podržením Option použijete pouze alfanumerické znaky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generer en tilfældig adgangskode. Hold Alternativ nede for kun at bruge bogstaver og tal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein zufälliges Passwort generieren. Halten Sie die Wahltaste gedrückt, um nur alphanumerische Zeichen zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
