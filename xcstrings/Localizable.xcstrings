    "AdvancedSetting.dryRunEraseAllSettingsAndData" : {
      "comment" : "Advanced setting: dryRunEraseAllSettingsAndData",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkušební spuštění akce „Smazat všechna nastavení a data“.\nPokud je zapnuto, tlačítko Smazat všechna nastavení a data zapíše do protokolu (přes NSLog), co by smazalo, místo aby cokoli skutečně smazalo, a aplikaci neukončí. Určeno k testování funkce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testkørsel af “Slet alle indstillinger og data”.\nNår det er slået til, logger knappen Slet alle indstillinger og data, hvad den ville slette (via NSLog), i stedet for rent faktisk at slette noget, og afslutter ikke. Beregnet til test af funktionen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testlauf für „Alle Einstellungen und Daten löschen“.\nWenn aktiviert, protokolliert die Schaltfläche „Alle Einstellungen und Daten löschen“ (per NSLog), was sie löschen würde, anstatt tatsächlich etwas zu löschen, und beendet die App nicht. Zum Testen der Funktion gedacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dry-run “Erase All Settings and Data”.\nWhen enabled, the Erase All Settings and Data button logs what it would delete (via NSLog) instead of actually deleting anything, and does not quit. Intended for testing the feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulacro de “Borrar todos los ajustes y datos”.\nSi se activa, el botón Borrar todos los ajustes y datos registra lo que eliminaría (mediante NSLog) en lugar de eliminar nada realmente, y no sale de la app. Pensado para probar la función."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuloi toimintoa ”Poista kaikki asetukset ja tiedot”.\nKun tämä on käytössä, painike ”Poista kaikki asetukset ja tiedot” kirjaa (NSLogin kautta), mitä se poistaisi, sen sijaan että poistaisi mitään, eikä lopeta sovellusta. Tarkoitettu ominaisuuden testaamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulation de « Effacer tous les réglages et données ».\nSi cette option est activée, le bouton Effacer tous les réglages et données journalise ce qu’il supprimerait (via NSLog) au lieu de supprimer quoi que ce soit, et ne quitte pas l’app. Destiné à tester la fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a vuoto di “Cancella tutte le impostazioni e i dati”.\nSe abilitato, il pulsante Cancella tutte le impostazioni e i dati registra (tramite NSLog) ciò che eliminerebbe invece di eliminare davvero qualcosa, e non esce. Pensato per testare la funzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すべての設定とデータを消去」のドライラン。\n有効にすると、「すべての設定とデータを消去」ボタンは実際には何も削除せず、削除する予定の内容を (NSLog 経由で) ログに記録するだけで、終了もしません。この機能をテストするためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“모든 설정 및 데이터 지우기” 시험 실행.\n활성화하면 모든 설정 및 데이터 지우기 버튼이 실제로 아무것도 삭제하지 않고 삭제할 항목을 (NSLog로) 기록하며, 종료하지도 않습니다. 기능 테스트용입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøvekjøring av «Slett alle innstillinger og data».\nNår dette er aktivert, logger knappen «Slett alle innstillinger og data» hva den ville ha slettet (via NSLog) i stedet for å slette noe, og avslutter ikke. Beregnet for testing av funksjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proefrun van ‘Wis alle instellingen en gegevens’.\nAls dit is ingeschakeld, logt de knop Wis alle instellingen en gegevens (via NSLog) wat hij zou verwijderen in plaats van daadwerkelijk iets te verwijderen, en stopt de app niet. Bedoeld om de functie te testen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbny przebieg „Usuń wszystkie ustawienia i dane”.\nPo włączeniu przycisk „Usuń wszystkie ustawienia i dane” zapisuje w dzienniku (przez NSLog), co by usunął, zamiast faktycznie cokolwiek usuwać, i nie kończy programu. Przeznaczone do testowania funkcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simular “Apagar todos os ajustes e dados”.\nQuando ativado, o botão Apagar todos os ajustes e dados registra o que apagaria (via NSLog) em vez de realmente apagar algo, e não encerra. Destinado a testar o recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробный запуск «Стереть все настройки и данные».\nПри включении кнопка «Стереть все настройки и данные» записывает в журнал (через NSLog), что было бы удалено, вместо фактического удаления, и не завершает работу приложения. Предназначено для тестирования этой функции."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skúšobný beh ‚Vymazať všetky nastavenia a údaje‘.\nAk je zapnuté, tlačidlo „Vymazať všetky nastavenia a údaje“ zaznamená (cez NSLog), čo by odstránilo, namiesto skutočného odstránenia, a aplikácia sa neukončí. Určené na testovanie funkcie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskusni zagon »Izbriši vse nastavitve in podatke«.\nČe je omogočeno, gumb Izbriši vse nastavitve in podatke zabeleži (prek NSLog), kaj bi izbrisal, namesto da bi dejansko kaj izbrisal, in se ne zapre. Namenjeno preizkušanju funkcije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testkörning av ”Radera alla inställningar och data”.\nNär detta är aktiverat loggar knappen Radera alla inställningar och data vad den skulle radera (via NSLog) i stället för att faktiskt radera något, och avslutar inte. Avsett för att testa funktionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tüm Ayarları ve Verileri Sil” için deneme çalıştırması.\nEtkinleştirildiğinde Tüm Ayarları ve Verileri Sil düğmesi, gerçekten bir şey silmek yerine neyi sileceğini (NSLog ile) günlüğe yazar ve çıkış yapmaz. Özelliği test etmek içindir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy thử “Xóa tất cả cài đặt và dữ liệu”.\nKhi bật, nút Xóa tất cả cài đặt và dữ liệu sẽ ghi nhật ký những gì nó sẽ xóa (qua NSLog) thay vì thực sự xóa bất cứ thứ gì, và không thoát. Dành cho việc kiểm thử tính năng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟执行“清除所有设置和数据”操作。\n启用后，该按钮会通过 NSLog 记录将要删除的内容，而不会实际执行任何删除操作，且不会退出程序。此功能用于测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行「清除所有設定和資料」。\n啟用後，「清除所有設定和資料」按鈕只會記錄（透過 NSLog）它將會刪除的內容，而不會真的刪除任何東西，也不會結束。供測試此功能使用。"
          }
        }
      }
    },
    "AdvancedSetting.duplicatedTabsOpenAdjacentToOriginal" : {
      "comment" : "Advanced setting: duplicatedTabsOpenAdjacentToOriginal",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má se při duplikování panelu kopie otevřít bezprostředně vpravo od původního panelu?\nPokud je vypnuto, duplikované panely se řídí obecným nastavením umístění „Nové panely se přidávají“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du dubler en fane, skal kopien så åbnes lige til højre for den oprindelige fane?\nNår det er slået fra, følger duplikerede faner i stedet den generelle placeringsindstilling “Nye faner tilføjes”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll die Kopie beim Duplizieren eines Tabs direkt rechts neben dem ursprünglichen Tab geöffnet werden?\nWenn deaktiviert, folgen duplizierte Tabs stattdessen der allgemeinen Einstellung „Neue Tabs werden hinzugefügt“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you duplicate a tab, should the copy open immediately to the right of the original tab?\nWhen disabled, duplicated tabs follow the general “New tabs are added” placement setting instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando duplicas una pestaña, ¿debe abrirse la copia inmediatamente a la derecha de la pestaña original?\nSi está desactivado, las pestañas duplicadas siguen el ajuste general de ubicación “Las pestañas nuevas se añaden”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avautuuko monistetun välilehden kopio heti alkuperäisen välilehden oikealle puolelle?\nKun tämä on pois käytöstä, monistetut välilehdet noudattavat yleistä ”Uudet välilehdet lisätään” -sijoitusasetusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous dupliquez un onglet, la copie doit-elle s’ouvrir immédiatement à droite de l’onglet d’origine ?\nSi cette option est désactivée, les onglets dupliqués suivent le réglage général de placement « Nouveaux onglets »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando duplichi un pannello, la copia deve aprirsi subito a destra dell’originale?\nSe disabilitato, i pannelli duplicati seguono invece l’impostazione generale di posizionamento “I nuovi pannelli vengono aggiunti”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを複製したとき、複製されたタブは元のタブのすぐ右に開きますか？\n無効にすると、複製されたタブは代わりに一般設定の「新規タブの追加位置」に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 복제할 때 사본을 원본 탭 바로 오른쪽에 열겠습니까?\n비활성화하면 복제된 탭은 대신 일반 설정인 “새로운 탭 추가 위치” 배치 설정을 따릅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du dupliserer en fane, skal kopien åpnes rett til høyre for den opprinnelige fanen?\nNår dette er deaktivert, følger duplikatfaner i stedet den generelle plasseringsinnstillingen «Nye faner legges til»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet bij het dupliceren van een tabblad de kopie direct rechts van het oorspronkelijke tabblad openen?\nAls dit is uitgeschakeld, volgen gedupliceerde tabbladen in plaats daarvan de algemene plaatsingsinstelling ‘Nieuwe tabbladen worden toegevoegd’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy po zduplikowaniu karty kopia ma otwierać się tuż po prawej stronie oryginału?\nGdy wyłączone, zduplikowane karty stosują ogólne ustawienie umiejscowienia „Nowe karty są dodawane”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao duplicar uma aba, a cópia deve abrir imediatamente à direita da aba original?\nQuando desativado, as abas duplicadas seguem a configuração geral de posicionamento “Novas abas são adicionadas”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли копия вкладки открываться сразу справа от исходной вкладки при дублировании?\nЕсли отключено, дублированные вкладки будут располагаться согласно общей настройке «Новые вкладки добавляются»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má sa pri duplikovaní tabu kópia otvoriť hneď vpravo od pôvodného tabu?\nAk je vypnuté, duplikované taby sa riadia všeobecným nastavením umiestnenia „Nové taby sa pridávajú“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se ob podvajanju zavihka kopija odpre takoj desno od izvirnega zavihka?\nČe je onemogočeno, podvojeni zavihki sledijo splošni nastavitvi umestitve »Novi zavihki se dodajo«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du duplicerar en flik, ska kopian öppnas direkt till höger om originalfliken?\nNär detta är avaktiverat följer duplicerade flikar den allmänna placeringsinställningen ”Nya flikar läggs till”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sekmeyi çoğalttığınızda kopya, özgün sekmenin hemen sağında açılsın mı?\nDevre dışı bırakıldığında çoğaltılan sekmeler bunun yerine genel “Yeni sekmeler eklenir” yerleşim ayarını izler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn tạo bản sao của một tab, bản sao có nên mở ngay bên phải tab gốc không?\nKhi tắt, các tab được sao chép sẽ theo cài đặt vị trí chung “Tab mới được thêm”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制标签时，副本是否应立即在原标签的右侧打开？\n禁用后，复制的标签将改为遵循常规的“新建标签的添加位置”设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製標籤頁時，拷貝是否應緊接在原標籤頁右側打開？\n停用時，複製的標籤頁會改為遵循一般的「新標籤頁加入位置」設定。"
          }
        }
      }
    },
    "AdvancedSetting.dwcLineCache" : {
      "comment" : "Advanced setting: dwcLineCache",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout mezipaměť umístění znaků dvojité šířky?\nMělo by to zlepšit výkon. V nočních sestaveních je zapnuta vždy. Aby se toto nastavení projevilo, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå cache over placeringer af tegn med dobbelt bredde til?\nDet burde forbedre ydelsen. Den er altid slået til i nightly builds. Du skal starte iTerm2 igen, for at denne indstilling træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischenspeicher für die Positionen doppelt breiter Zeichen aktivieren?\nDies sollte die Leistung verbessern. In Nightly-Builds ist es immer aktiviert. Sie müssen iTerm2 neu starten, damit diese Einstellung wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable cache of double-width character locations?\nThis should improve performance. It is always on in nightly builds. You must restart iTerm2 for this setting to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar la caché de ubicaciones de caracteres de doble anchura?\nDebería mejorar el rendimiento. Siempre está activada en las compilaciones nightly. Debes reiniciar iTerm2 para que este ajuste surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaanko kaksoisleveiden merkkien sijaintien välimuisti käyttöön?\nTämän pitäisi parantaa suorituskykyä. Se on aina käytössä nightly-versioissa. iTerm2 on käynnistettävä uudelleen, jotta tämä asetus tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le cache des emplacements de caractères double largeur ?\nCela devrait améliorer les performances. Il est toujours activé dans les versions nightly. Vous devez redémarrer iTerm2 pour que ce réglage prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare la cache delle posizioni dei caratteri a doppia larghezza?\nDovrebbe migliorare le prestazioni. È sempre attiva nelle build nightly. Devi riavviare iTerm2 affinché questa impostazione abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全角文字の位置のキャッシュを有効にしますか?\nこれによりパフォーマンスが向上するはずです。ナイトリービルドでは常にオンになっています。この設定を反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전각 문자 위치 캐시를 켜겠습니까?\n성능이 향상됩니다. 나이틀리 빌드에서는 항상 켜져 있습니다. 이 설정을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivere buffer for plasseringer av tegn med dobbel bredde?\nDette bør forbedre ytelsen. Det er alltid på i nattlige bygg. Du må starte iTerm2 på nytt for at denne innstillingen skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache van locaties van tekens met dubbele breedte inschakelen?\nDit zou de prestaties moeten verbeteren. Het staat altijd aan in nightly builds. Je moet iTerm2 herstarten om deze instelling door te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączyć pamięć podręczną położeń znaków podwójnej szerokości?\nPowinno to poprawić wydajność. W kompilacjach nightly jest zawsze włączona. Aby ustawienie zaczęło działać, musisz uruchomić iTerm2 ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar cache de localizações de caracteres de largura dupla?\nIsto deve melhorar o desempenho. Está sempre ativado em builds noturnos. Você deve reiniciar o iTerm2 para que este ajuste tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить кэш расположений широких символов?\nЭто должно повысить производительность. В ночных сборках всегда включено. Для вступления настройки в силу нужно перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť vyrovnávaciu pamäť umiestnení znakov dvojitej šírky?\nMalo by to zlepšiť výkon. V nočných zostaveniach je vždy zapnutá. Aby sa toto nastavenie prejavilo, musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči predpomnilnik lokacij dvojno širokih znakov?\nTo bi moralo izboljšati zmogljivost. V nočnih zgradbah je vedno vklopljeno. Za uveljavitev te nastavitve morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera cache för platser för tecken med dubbel bredd?\nDetta bör förbättra prestandan. Det är alltid på i nightly-byggen. Du måste starta om iTerm2 för att den här inställningen ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çift genişlikli karakter konumları önbelleği etkinleştirilsin mi?\nBu, performansı iyileştirmelidir. Gecelik yapılarda her zaman açıktır. Bu ayarın etkili olması için iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật bộ nhớ đệm vị trí các ký tự rộng gấp đôi?\nĐiều này nên cải thiện hiệu năng. Luôn bật trong các bản dựng nightly. Bạn phải khởi động lại iTerm2 để cài đặt này có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否启用双宽字符位置的缓存？\n这应有助于提升性能。在夜间构建版本中该功能始终处于开启状态。要使此设置生效，必须重启 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用雙倍寬度字元位置的快取？\n這應該能提升效能。在每日建置版本中一律啟用。你必須重新啟動 iTerm2，此設定才會生效。"
          }
        }
      }
    },
    "AdvancedSetting.dynamicProfilesNotificationLatency" : {
      "comment" : "Advanced setting: dynamicProfilesNotificationLatency",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodleva mezi zjištěním změny dynamických profilů a jejím zpracováním.\nPokud ve složce DynamicProfiles dochází k mnoha změnám, delší prodleva pomůže sloučit události souborového systému a snížit využití CPU."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelse mellem registrering af en ændring i dynamiske profiler og handling på den.\nHvis der sker mange ændringer i mappen DynamicProfiles, hjælper en længere forsinkelse med at samle arkivsystemets hændelser og dermed mindske CPU-forbruget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung zwischen dem Erkennen einer Änderung an dynamischen Profilen und der Reaktion darauf.\nWenn viele Änderungen im Ordner DynamicProfiles auftreten, hilft eine längere Verzögerung dabei, Dateisystemereignisse zusammenzufassen und so die CPU-Auslastung zu verringern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay between detecting a change to dynamic profiles and acting on it.\nIf a lot of changes happen to the DynamicProfiles folder a longer delay will help coalesce filesystem events to reduce CPU usage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retraso entre detectar un cambio en los perfiles dinámicos y actuar sobre él.\nSi se producen muchos cambios en la carpeta DynamicProfiles, un retraso mayor ayuda a agrupar los eventos del sistema de archivos y reduce el uso de CPU."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viive dynaamisten profiilien muutoksen havaitsemisen ja siihen reagoimisen välillä.\nJos DynamicProfiles-kansioon tulee paljon muutoksia, pidempi viive auttaa yhdistämään tiedostojärjestelmän tapahtumia ja vähentää CPU-käyttöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai entre la détection d’une modification des profils dynamiques et sa prise en compte.\nSi de nombreuses modifications touchent le dossier DynamicProfiles, un délai plus long aide à regrouper les événements du système de fichiers et réduit l’utilisation du CPU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo tra il rilevamento di una modifica ai profili dinamici e la relativa azione.\nSe nella cartella DynamicProfiles avvengono molte modifiche, un ritardo più lungo aiuta a unire gli eventi del file system e riduce l’uso della CPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミックプロファイルへの変更を検出してから反映するまでの遅延。\nDynamicProfiles フォルダに多くの変更が発生する場合、遅延を長くするとファイルシステムイベントがまとめられ、CPU 使用率を抑えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일의 변경을 감지한 후 반영하기까지의 지연 시간\nDynamicProfiles 폴더에 변경이 많이 발생하는 경우 지연 시간을 늘리면 파일 시스템 이벤트가 합쳐져 CPU 사용량이 줄어듭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelse mellom oppdagelse av en endring i dynamiske profiler og handling på den.\nHvis mange endringer skjer i mappen DynamicProfiles, vil en lengre forsinkelse bidra til å slå sammen filsystemhendelser og redusere CPU-bruken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraging tussen het detecteren van een wijziging in dynamische profielen en het uitvoeren ervan.\nAls er veel wijzigingen in de map DynamicProfiles plaatsvinden, helpt een langere vertraging om bestandssysteemgebeurtenissen samen te voegen en het CPU-gebruik te verlagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opóźnienie między wykryciem zmiany w profilach dynamicznych a reakcją na nią.\nJeśli w folderze DynamicProfiles zachodzi wiele zmian, dłuższe opóźnienie pomoże połączyć zdarzenia systemu plików i zmniejszyć użycie CPU."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso entre detectar uma alteração em perfis dinâmicos e agir sobre ela.\nSe muitas alterações acontecerem na pasta DynamicProfiles, um atraso maior ajudará a agrupar eventos do sistema de arquivos para reduzir o uso de CPU."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержка между обнаружением изменения в динамических профилях и реакцией на него.\nЕсли в папке DynamicProfiles происходит много изменений, более долгая задержка поможет объединить события файловой системы для снижения нагрузки на процессор."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oneskorenie medzi zistením zmeny dynamických profilov a reakciou na ňu.\nAk v priečinku DynamicProfiles nastane veľa zmien, dlhšie oneskorenie pomôže zlúčiť udalosti súborového systému a znížiť využitie CPU."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakasnitev med zaznavo spremembe dinamičnih profilov in odzivom nanjo.\nČe se v mapi DynamicProfiles zgodi veliko sprememb, daljša zakasnitev pomaga združiti dogodke datotečnega sistema in zmanjša porabo CPU."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fördröjning mellan att en ändring av dynamiska profiler upptäcks och att den hanteras.\nOm många ändringar sker i mappen DynamicProfiles hjälper en längre fördröjning till att slå ihop filsystemshändelser för att minska CPU-användningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik profillerdeki bir değişikliği algılama ile buna göre davranma arasındaki gecikme.\nDynamicProfiles klasöründe çok sayıda değişiklik olursa daha uzun bir gecikme, CPU kullanımını azaltmak için dosya sistemi olaylarını birleştirmeye yardımcı olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ trễ giữa lúc phát hiện thay đổi hồ sơ động và lúc xử lý nó.\nNếu có nhiều thay đổi trong thư mục DynamicProfiles, độ trễ dài hơn sẽ giúp gộp các sự kiện hệ thống tệp để giảm mức dùng CPU."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测动态配置文件发生变化并采取相应操作之间的延迟时间。\n如果 DynamicProfiles 文件夹中发生大量更改，较长的延迟有助于合并文件系统事件，从而降低 CPU 使用率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到動態描述檔變更與採取動作之間的延遲。\n如果 DynamicProfiles 檔案夾發生大量變更，較長的延遲有助於合併檔案系統事件，以降低 CPU 使用量。"
          }
        }
      }
    },
    "AdvancedSetting.dynamicProfilesPath" : {
      "comment" : "Advanced setting: dynamicProfilesPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesta ke složce s dynamickými profily.\nPokud je prázdná, použije se ~/Library/Application Support/iTerm2/DynamicProfiles. Po změně tohoto nastavení musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sti til mappen med dynamiske profiler.\nNår feltet er tomt, bruges ~/Library/Application Support/iTerm2/DynamicProfiles. Du skal starte iTerm2 igen, når du har ændret denne indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfad zum Ordner mit dynamischen Profilen.\nWenn leer, wird ~/Library/Application Support/iTerm2/DynamicProfiles verwendet. Sie müssen iTerm2 nach dem Ändern dieser Einstellung neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to folder with dynamic profiles.\nWhen empty, ~/Library/Application Support/iTerm2/DynamicProfiles will be used. You must restart iTerm2 after modifying this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta de la carpeta con los perfiles dinámicos.\nSi está vacía, se usará ~/Library/Application Support/iTerm2/DynamicProfiles. Debes reiniciar iTerm2 después de modificar este ajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynaamisten profiilien kansion polku.\nKun tämä on tyhjä, käytetään polkua ~/Library/Application Support/iTerm2/DynamicProfiles. iTerm2 on käynnistettävä uudelleen tämän asetuksen muuttamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chemin du dossier des profils dynamiques.\nSi vide, ~/Library/Application Support/iTerm2/DynamicProfiles est utilisé. Vous devez redémarrer iTerm2 après avoir modifié ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorso della cartella con i profili dinamici.\nSe vuoto, verrà usato ~/Library/Application Support/iTerm2/DynamicProfiles. Devi riavviare iTerm2 dopo aver modificato questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミックプロファイルが格納されているフォルダへのパス。\n空欄の場合、~/Library/Application Support/iTerm2/DynamicProfiles が使用されます。この設定を変更した後は iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일이 있는 폴더의 경로입니다.\n비워 두면 ~/Library/Application Support/iTerm2/DynamicProfiles가 사용됩니다. 이 설정을 수정한 후에는 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bane til mappen med dynamiske profiler.\nNår den er tom, brukes ~/Library/Application Support/iTerm2/DynamicProfiles. Du må starte iTerm2 på nytt etter at du har endret denne innstillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pad naar de map met dynamische profielen.\nAls dit leeg is, wordt ~/Library/Application Support/iTerm2/DynamicProfiles gebruikt. Je moet iTerm2 herstarten na het wijzigen van deze instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżka do folderu z profilami dynamicznymi.\nGdy puste, używany jest ~/Library/Application Support/iTerm2/DynamicProfiles. Po zmianie tego ustawienia musisz uruchomić iTerm2 ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para a pasta com perfis dinâmicos.\nQuando vazio, ~/Library/Application Support/iTerm2/DynamicProfiles será usado. Você deve reiniciar o iTerm2 após modificar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путь к папке с динамическими профилями.\nЕсли пусто, будет использована ~/Library/Application Support/iTerm2/DynamicProfiles. После изменения этой настройки нужно перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesta k priečinku s dynamickými profilmi.\nAk je prázdna, použije sa ~/Library/Application Support/iTerm2/DynamicProfiles. Po zmene tohto nastavenia musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pot do mape z dinamičnimi profili.\nČe je prazna, bo uporabljena ~/Library/Application Support/iTerm2/DynamicProfiles. Po spremembi te nastavitve morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökväg till mappen med dynamiska profiler.\nNär den är tom används ~/Library/Application Support/iTerm2/DynamicProfiles. Du måste starta om iTerm2 efter att du ändrat den här inställningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik profiller klasörünün yolu.\nBoşken ~/Library/Application Support/iTerm2/DynamicProfiles kullanılır. Bu ayarı değiştirdikten sonra iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường dẫn đến thư mục chứa hồ sơ động.\nKhi để trống, ~/Library/Application Support/iTerm2/DynamicProfiles sẽ được dùng. Bạn phải khởi động lại iTerm2 sau khi sửa cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态配置文件所在文件夹的路径。\n如果该路径为空，则会使用 ~/Library/Application Support/iTerm2/DynamicProfiles。修改此设置后必须重启 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態描述檔檔案夾的路徑。\n留空時，將使用 ~/Library/Application Support/iTerm2/DynamicProfiles。變更此設定後，你必須重新啟動 iTerm2。"
          }
        }
      }
    },
    "AdvancedSetting.echoProbeDuration" : {
      "comment" : "Advanced setting: echoProbeDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doba čekání (v sekundách) při testování, zda je zapnuto echo.\nPoužívá ji správce hesel k ověření, že se nacházíte u výzvy k zadání hesla. Hodnotou 0 se sonda echa vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventetid under test af, om ekko er slået til (sekunder).\nBruges af adgangskodeadministratoren til at sikre, at du står ved en adgangskodeprompt. Angiv 0 for at slå ekkoprøven fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartezeit beim Testen, ob Echo aktiviert ist (in Sekunden).\nDies wird vom Passwort-Manager verwendet, um sicherzustellen, dass Sie sich an einer Passwortabfrage befinden. Auf 0 setzen, um die Echo-Prüfung zu deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Amount of time to wait while testing if echo is on (seconds).\nThis is used by the password manager to ensure you're at a password prompt. Set to 0 to disable echo probe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera (en segundos) mientras se comprueba si el eco está activado.\nEl gestor de contraseñas lo usa para asegurarse de que estás en un prompt de contraseña. Usa 0 para desactivar la sonda de eco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotusaika (sekunteina) kaiun käytössäolon testauksessa.\nSalasanojen hallinta käyttää tätä varmistaakseen, että olet salasanakehotteessa. Aseta arvoon 0 poistaaksesi kaikukokeen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’attente (en secondes) lors du test de l’activation de l’écho.\nUtilisé par le gestionnaire de mots de passe pour s’assurer que vous êtes à une invite de mot de passe. Définissez 0 pour désactiver la sonde d’écho."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo di attesa (in secondi) mentre si verifica se l’eco è attivo.\nÈ usato dal gestore password per assicurarsi che ti trovi a un prompt di password. Imposta 0 per disabilitare la verifica dell’eco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エコーが有効かどうかをテストする際に待機する時間 (秒単位)。\nこれは、パスワードマネージャーがパスワードプロンプトにいることを確認するために使用します。エコープローブを無効にするには 0 を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에코가 켜져 있는지 테스트할 때 기다리는 시간(초).\n암호 관리자가 암호 프롬프트에 있는지 확인하는 데 사용합니다. 에코 검사를 끄려면 0으로 설정하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid å vente (sekunder) mens det testes om ekko er på.\nDette brukes av passordbehandleren for å sikre at du er ved en passordledetekst. Angi 0 for å deaktivere ekkoprøven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoelang (in seconden) wordt gewacht tijdens het testen of echo aan staat.\nDit wordt door de wachtwoordbeheerder gebruikt om te controleren of je bij een wachtwoordprompt bent. Stel in op 0 om de echotest uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas oczekiwania (w sekundach) podczas sprawdzania, czy echo jest włączone.\nUżywane przez menedżera haseł, aby upewnić się, że jesteś w znaku zachęty hasła. Ustaw 0, aby wyłączyć sondowanie echa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo a aguardar ao testar se o eco está ativado (segundos).\nIsto é usado pelo cofre de senhas para garantir que você está em um prompt de senha. Defina como 0 para desativar a sondagem de eco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время ожидания при проверке того, включено ли эхо (в секундах).\nИспользуется менеджером паролей, чтобы убедиться, что вы находитесь в запросе пароля. Установите 0, чтобы отключить проверку эха."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas čakania pri testovaní, či je echo zapnuté (v sekundách).\nPoužíva ho správca hesiel na overenie, že ste pri výzve na heslo. Hodnotou 0 sa test echa vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas čakanja pri preverjanju, ali je odmev vklopljen (v sekundah).\nUporablja ga upravitelj gesel, da se prepriča, da ste pri pozivu za geslo. Nastavite na 0 za onemogočenje sonde odmeva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge (sekunder) som ska väntas medan det testas om eko är på.\nDen används av lösenordshanteraren för att säkerställa att du befinner dig vid en lösenordsprompt. Ange 0 för att avaktivera ekoprobning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yankının açık olup olmadığı sınanırken beklenecek süre (saniye).\nParola yöneticisi, bir parola isteminde olduğunuzdan emin olmak için bunu kullanır. Yankı yoklamasını devre dışı bırakmak için 0 yapın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian chờ khi kiểm tra echo có bật không (giây).\nTrình quản lý mật khẩu dùng giá trị này để đảm bảo bạn đang ở dấu nhắc mật khẩu. Đặt là 0 để tắt kiểm tra echo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测是否开启回显功能时的等待时间（秒）。\n密码管理器会使用此设置来确保用户处于密码输入界面。将其设置为 0 可禁用回显检测功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測試回音是否開啟時要等待的時間（秒）。\n密碼管理器用它來確認你正處於密碼提示符號。設為 0 可停用回音探測。"
          }
        }
      }
    },
    "AdvancedSetting.enableCharacterAccentMenu" : {
      "comment" : "Advanced setting: enableCharacterAccentMenu",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout nabídku diakritiky znaků.\nTím se vypne běžné chování opakování kláves při podržení. Aby se tato změna projevila, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå menuen med tegnaccenter til.\nDette slår den almindelige tastegentagelse ved tryk og hold fra. Du skal starte iTerm2 igen, for at ændringen træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen-Akzentmenü aktivieren.\nDies deaktiviert das übliche Verhalten der Tastenwiederholung beim Gedrückthalten. Sie müssen iTerm2 neu starten, damit diese Änderung wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable character accent menu.\nThis disables the ordinary key repeat behavior for press-and-hold. You must restart iTerm2 for this change to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar el menú de acentos de caracteres.\nEsto desactiva el comportamiento normal de repetición de teclas al mantener pulsada una tecla. Debes reiniciar iTerm2 para que este cambio surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota merkkien aksenttivalikko käyttöön.\nTämä poistaa käytöstä tavallisen näppäimen toistotoiminnon pitämällä painettaessa. iTerm2 on käynnistettävä uudelleen, jotta muutos tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le menu des accents de caractères.\nCela désactive le comportement habituel de répétition de touche en cas d’appui prolongé. Vous devez redémarrer iTerm2 pour que cette modification prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il menu degli accenti dei caratteri.\nQuesto disabilita il normale comportamento di ripetizione del tasto per la pressione prolungata. Devi riavviare iTerm2 affinché la modifica abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字のアクセントメニューを有効にします。\nこれにより、長押し時の通常のキーリピート動作が無効になります。この変更を反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자 악센트 메뉴를 켭니다.\n길게 누를 때의 일반적인 키 반복 동작이 꺼집니다. 이 변경 사항을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver aksentmenyen for tegn.\nDette deaktiverer vanlig tastegjentakelse ved trykk og hold. Du må starte iTerm2 på nytt for at denne endringen skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel het accentmenu voor tekens in.\nHierdoor wordt het gewone herhaalgedrag van toetsen bij ingedrukt houden uitgeschakeld. Je moet iTerm2 herstarten om deze wijziging door te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz menu akcentów znaków.\nWyłącza zwykłe powtarzanie klawisza przy przytrzymaniu. Aby zmiana zaczęła działać, musisz uruchomić iTerm2 ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o menu de acentos de caractere.\nIsto desativa o comportamento comum de repetição de tecla para pressionar e segurar. Você deve reiniciar o iTerm2 para que esta alteração tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить меню акцентов символа.\nЭто отключает обычное поведение повтора клавиши при удержании. Для вступления изменения в силу нужно перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť menu akcentov znakov.\nTýmto sa vypne bežné opakovanie klávesu pri podržaní. Aby sa zmena prejavila, musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči meni naglasov znakov.\nTo onemogoči običajno ponavljanje tipke ob držanju. Za uveljavitev te spremembe morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera menyn för teckenaccenter.\nDetta avaktiverar det vanliga tangentupprepningsbeteendet vid tryck och håll. Du måste starta om iTerm2 för att ändringen ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karakter vurgu menüsünü etkinleştir.\nBu, basılı tutma için olağan tuş tekrarı davranışını devre dışı bırakır. Bu değişikliğin etkili olması için iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật menu dấu của ký tự.\nĐiều này tắt hành vi lặp phím thông thường khi nhấn và giữ. Bạn phải khởi động lại iTerm2 để thay đổi này có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用字符重音菜单。\n此选项会禁用按住键时的普通重复输入功能。要使此更改生效，必须重启 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用字元重音選單。\n這會停用按住按鍵時的一般按鍵重複行為。你必須重新啟動 iTerm2，此變更才會生效。"
          }
        }
      }
    },
    "AdvancedSetting.enableCmdClickPromptForShowCommandInfo" : {
      "comment" : "Advanced setting: enableCmdClickPromptForShowCommandInfo",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-kliknutí na výzvu zobrazí okno Informace o příkazu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-klik i prompten viser vinduet Kommandooplysninger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-Klick im Prompt zeigt das Fenster „Befehlsinfo“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘-click in the prompt shows the Command Info window"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-clic en el prompt muestra la ventana de información del comando"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-klikkaus komentokehotteessa näyttää Komennon tiedot -ikkunan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
