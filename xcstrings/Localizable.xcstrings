          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всем приложениям разрешено использовать API согласно настройке «Настройки > Общие > Магия > Разрешить подключение всем приложениям»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetkým apkám je povolené používať API podľa nastavenia „Nastavenia > Všeobecné > Mágia > Povoliť pripojenie všetkých aplikácií“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse aplikacije smejo uporabljati API, v skladu z »Nastavitve > Splošno > Čarovnija > Dovoli povezavo vsem aplikacijam«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla appar får använda API:et enligt ”Inställningar > Allmänt > Magi > Tillåt alla appar att ansluta”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm uygulamaların API’yi kullanmasına, “Ayarlar > Genel > Sihir > Tüm uygulamaların bağlanmasına izin ver” uyarınca izin verilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả ứng dụng đều được phép dùng API, theo “Cài đặt > Chung > Phép thuật > Cho phép mọi ứng dụng kết nối”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据“设置 > 通用 > Magic > 允许所有应用连接”，所有应用均被允许使用API。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據「設定 > 一般 > 魔法 > 允許所有 App 連線」，所有 App 均被允許使用 API。"
          }
