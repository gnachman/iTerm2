    "PTYSession.TmuxIntegrationCannotNest" : {
      "comment" : "Warning shown when tmux -CC is run inside a session that is itself a tmux integration pane",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrace tmux se nemůže spustit v relaci, která již je součástí integrace tmux. Nový klient tmux čeká v řídicím režimu; ukončíte ho stisknutím Return v této relaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-integration kan ikke startes i en session, der allerede er en del af tmux-integration. Den nye tmux-klient venter i kontroltilstand. Tryk på Retur i denne session for at afslutte den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die tmux-Integration kann nicht in einer Sitzung starten, die bereits Teil einer tmux-Integration ist. Der neue tmux-Client wartet im Steuerungsmodus; drücke in dieser Sitzung die Eingabetaste, um ihn zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "tmux integration can’t start in a session that is already part of tmux integration. The new tmux client is waiting in control mode; press Return in this session to end it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con tmux no puede iniciarse en una sesión que ya forma parte de una integración con tmux. El nuevo cliente tmux está esperando en modo de control; pulsa Retorno en esta sesión para terminarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-integraatiota ei voi käynnistää istunnossa, joka on jo osa tmux-integraatiota. Uusi tmux-asiakas odottaa ohjaustilassa. Lopeta se painamalla rivinvaihtoa tässä istunnossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration tmux ne peut pas démarrer dans une session qui fait déjà partie d’une intégration tmux. Le nouveau client tmux attend en mode contrôle ; appuyez sur Retour dans cette session pour y mettre fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione tmux non può avviarsi in una sessione che fa già parte di un’integrazione tmux. Il nuovo client tmux è in attesa in modalità di controllo; premi Invio in questa sessione per terminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに tmux 統合の一部になっているセッションでは tmux 統合を開始できません。新しい tmux クライアントはコントロールモードで待機しています。このセッションで Return キーを押すと終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 tmux 통합에 속한 세션에서는 tmux 통합을 시작할 수 없습니다. 새로운 tmux 클라이언트가 제어 모드에서 대기 중입니다. 종료하려면 이 세션에서 Return 키를 누르십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-integrering kan ikke startes i en økt som allerede er en del av tmux-integrering. Den nye tmux-klienten venter i kontrollmodus. Trykk på retur i denne økten for å avslutte den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-integratie kan niet starten in een sessie die al deel uitmaakt van tmux-integratie. De nieuwe tmux-client wacht in besturingsmodus; druk in deze sessie op Return om hem te beëindigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracja z tmux nie może zostać uruchomiona w sesji, która już jest częścią integracji z tmux. Nowy klient tmux czeka w trybie sterowania; naciśnij Return w tej sesji, aby go zakończyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A integração com o tmux não pode iniciar em uma sessão que já faz parte de uma integração com o tmux. O novo cliente tmux está aguardando no modo de controle; pressione Return nesta sessão para encerrá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеграция с tmux не может запуститься в сеансе, который уже входит в интеграцию с tmux. Новый клиент tmux ожидает в режиме управления; нажмите Return в этом сеансе, чтобы завершить его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrácia tmux sa nemôže spustiť v relácii, ktorá je už súčasťou integrácie tmux. Nový klient tmux čaká v riadiacom režime; ukončite ho stlačením Return v tejto relácii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracije tmux ni mogoče zagnati v seji, ki je že del integracije tmux. Novi odjemalec tmux čaka v krmilnem načinu; za njegovo zaključitev v tej seji pritisnite Return."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-integrering kan inte startas i en session som redan ingår i tmux-integrering. Den nya tmux-klienten väntar i kontrolläge. Tryck på retur i den här sessionen för att avsluta den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux Entegrasyonu, zaten tmux Entegrasyonu’nun parçası olan bir oturumda başlatılamaz. Yeni tmux istemcisi denetim modunda bekliyor; sonlandırmak için bu oturumda Return tuşuna basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tích hợp tmux không thể bắt đầu trong phiên đã là một phần của Tích hợp tmux. Ứng dụng khách tmux mới đang chờ ở chế độ điều khiển; nhấn Return trong phiên này để kết thúc nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在已属于 tmux 集成的会话中启动 tmux 集成。新的 tmux 客户端正在控制模式下等待；在此会话中按 Return 键即可结束它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 整合無法在已屬於 tmux 整合的工作階段中啟動。新的 tmux 用戶端正在控制模式下等待；在此工作階段中按 Return 即可結束它。"
          }
        }
      }
    },
