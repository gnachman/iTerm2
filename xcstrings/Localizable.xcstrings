    "RemotePreferences.LoadFromURLPrompt" : {
      "comment" : "Prompt asking whether to load settings from a URL and lose local changes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načíst nastavení z URL? V místní kopii byly provedeny změny, které budou ztraceny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du indlæse indstillinger fra URL? Der er foretaget nogle ændringer i den lokale kopi, som går tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen von der URL laden? Einige Änderungen an der lokalen Kopie gehen dabei verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Load settings from URL? Some changes were made to the local copy that will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cargar los ajustes desde la URL? Se hicieron algunos cambios en la copia local que se perderán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladataanko asetukset URL-osoitteesta? Paikalliseen kopioon on tehty muutoksia, jotka menetetään."
