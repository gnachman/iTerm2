    "SecureUserDefaults.CreateFolderPrompt" : {
      "comment" : "Authorization prompt shown when iTerm2 needs privileges to create the fallback secure-settings folder; %@ is the folder path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 potřebuje vytvořit složku %@ pro uložení zabezpečeného nastavení, protože vaše domovská složka je v síťovém systému souborů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 skal oprette %@ for at gemme sikre indstillinger, fordi din hjemmemappe ligger på et netværksarkivsystem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 muss %@ erstellen, um sichere Einstellungen zu speichern, da sich Ihr Home-Verzeichnis auf einem Netzwerkdateisystem befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 needs to create %@ to store secure settings because your home directory is on a network file system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 necesita crear %@ para almacenar los ajustes seguros porque tu directorio de inicio está en un sistema de archivos de red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:n on luotava kansio %@ suojattujen asetusten tallentamista varten, koska kotihakemistosi on verkkotiedostojärjestelmässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 doit créer %@ pour stocker les réglages sécurisés, car votre répertoire de départ se trouve sur un système de fichiers réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 deve creare %@ per salvare le impostazioni sicure perché la tua cartella Inizio si trova su un file system di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームディレクトリがネットワークファイルシステム上にあるため、iTerm2はセキュア設定を保存するために%@を作成する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 디렉토리가 네트워크 파일 시스템에 있으므로 iTerm2가 보안 설정을 저장하기 위해 %@을(를) 생성해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 må opprette %@ for å lagre sikre innstillinger fordi Hjem-mappen din ligger på et nettverksfilsystem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 moet %@ aanmaken om beveiligde instellingen op te slaan, omdat je thuismap zich op een netwerkbestandssysteem bevindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przechowywać bezpieczne ustawienia, iTerm2 musi utworzyć folder %@, ponieważ twój katalog domowy znajduje się w sieciowym systemie plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 precisa criar %@ para armazenar ajustes seguros porque seu diretório home está em um sistema de arquivos de rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 необходимо создать %@ для хранения безопасных настроек, поскольку домашняя папка находится на сетевой файловой системе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 potrebuje vytvoriť priečinok %@ na uloženie zabezpečených nastavení, pretože váš domovský priečinok je v sieťovom súborovom systéme."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ker je vaš domači imenik v omrežnem datotečnem sistemu, mora iTerm2 ustvariti %@ za shranjevanje varnih nastavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 behöver skapa %@ för att lagra säkra inställningar eftersom din hemmapp ligger på ett nätverksfilsystem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana dizininiz bir ağ dosya sisteminde olduğundan, güvenli ayarları saklamak için iTerm2’nin %@ klasörünü oluşturması gerekiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 cần tạo %@ để lưu các cài đặt bảo mật vì thư mục chính của bạn nằm trên hệ thống tệp mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于您的主目录位于网络文件系统上，iTerm2需要创建%@以存储安全设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於你的個人專屬目錄位於網路檔案系統上，iTerm2 需要建立 %@ 來儲存安全設定。"
          }
        }
      }
    },
