          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaardbreedte van de tabstop voor nieuwe sessies.\nLet op: hierdoor gaat het tekenen in emacs en andere apps stuk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślna szerokość tabulatora dla nowych sesji.\nUwaga: zepsuje to rysowanie w emacsie i innych aplikacjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura padrão da parada de tabulação para novas sessões.\nObservação: isto quebrará o desenho no emacs e em outros apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина табуляции по умолчанию для новых сессий.\nПримечание: это нарушит отрисовку в emacs и других приложениях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvolená šírka zarážky tabulátora pre nové relácie.\nPoznámka: naruší vykresľovanie v emacse a iných apkách."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privzeta širina tabulatorskega stopa za nove seje.\nOpomba: to bo pokvarilo risanje v emacsu in drugih aplikacijah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvald tabbstoppsbredd för nya sessioner.\nObs: detta förstör ritningen i emacs och andra appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni oturumlar için varsayılan sekme durağı genişliği.\nNot: Bu, emacs ve diğer uygulamalarda çizimi bozar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ rộng điểm dừng tab mặc định cho các phiên mới.\nLưu ý: điều này sẽ làm hỏng việc vẽ trong emacs và các ứng dụng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新会话的默认标签页停止宽度。\n注意：此设置会破坏Emacs等应用程序的绘图功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新工作階段的預設定位停駐點寬度。\n注意：這會破壞 emacs 和其他 App 的繪製。"
          }
        }
      }
    },
    "AdvancedSetting.defaultURLScheme" : {
      "comment" : "Advanced setting: defaultURLScheme",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí schéma URL.\nPoužije se u názvů hostitelů, které nejsou jedním slovem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-URL-skema.\nDette anvendes på værtsnavne, der ikke er ét ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-URL-Schema.\nDies wird auf Hostnamen angewendet, die nicht aus einem einzigen Wort bestehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default URL scheme.\nThis is applied to hostnames that are not a single word."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquema de URL predeterminado.\nSe aplica a los nombres de host que no son una sola palabra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletus-URL-skeema.\nTätä sovelletaan palvelinnimiin, jotka eivät ole yksi sana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schéma d’URL par défaut.\nIl est appliqué aux noms d’hôte qui ne se composent pas d’un seul mot."
          }
