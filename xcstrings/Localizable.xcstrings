    "Companion.ChooseMode.Body" : {
      "comment" : "Explanatory paragraph on the choose-mode screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihr iPhone koppeln, um mit einer KI über Ihre Sitzungen zu chatten, oder einfach nur, um Ihre Terminals aus der Ferne anzuzeigen und zu steuern. Sie können die KI später aktivieren, falls Sie Ihre Meinung ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can pair your iPhone to chat with AI about your sessions, or just to view and control your terminals remotely. You can turn on AI later if you change your mind."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneをペアリングして、セッションについてAIとチャットしたり、単に端末を遠隔で表示・操作したりできます。後で気が変わった場合は、AIを後から有効にすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 페어링하여 세션에 대해 AI와 채팅하거나, 터미널을 원격으로 보고 제어하기만 할 수도 있습니다. 마음이 바뀌면 나중에 AI를 켤 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode emparelhar seu iPhone para conversar com a IA sobre suas sessões, ou apenas para visualizar e controlar seus terminais remotamente. Você pode ativar a IA mais tarde, se mudar de ideia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете подключить iPhone, чтобы общаться с ИИ о своих сессиях, или просто просматривать и удалённо управлять терминалами. Позже вы можете включить ИИ, если измените решение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以将 iPhone 配对，以便与 AI 讨论您的会话，也可以仅用于远程查看和控制您的终端。如果之后改变想法，可以随时开启 AI 功能。"
          }
        }
      }
    },
    "Companion.ChooseMode.TerminalOnlyButton" : {
      "comment" : "Button that starts companion-only (no AI) setup",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Terminalanzeige & -steuerung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Terminal Viewing & Control Only"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
