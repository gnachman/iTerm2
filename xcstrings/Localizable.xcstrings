            "value" : "When rendering natively, use wide mode by default?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネイティブでレンダリングする場合、デフォルトでワイドモードを使用しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네이티브로 렌더링할 때 기본적으로 와이드 모드를 사용합니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
