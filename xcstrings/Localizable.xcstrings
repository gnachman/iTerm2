    "CommandURL.SilentConfirmMessage" : {
      "comment" : "Body of the silent-run confirmation alert. %@ is the command line. Lines naming the user, host, and directory may follow.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustit příkaz „%@“?\nSpustí se tiše na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du køre kommandoen “%@”?\nDen kører lydløst i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Befehl „%@“ ausführen?\nEr wird lautlos im Hintergrund ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Run the command “%@”?\nIt will run silently in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ejecutar el comando “%@”?\nSe ejecutará en segundo plano sin avisar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suoritetaanko komento ”%@”?\nSe suoritetaan äänettömästi taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter la commande « %@ » ?\nElle s’exécutera silencieusement en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eseguire il comando “%@”?\nVerrà eseguito in background senza avvisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンド「%@」を実行しますか？\nバックグラウンドでサイレントに実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 명령을 실행하겠습니까?\n백그라운드에서 조용히 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du kjøre kommandoen «%@»?\nDen kjører stille i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het commando ‘%@’ uitvoeren?\nHet wordt stil op de achtergrond uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchomić polecenie „%@”?\nZostanie uruchomione po cichu w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executar o comando “%@”?\nEle será executado silenciosamente em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить команду «%@»?\nОна будет выполнена в фоновом режиме без вывода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustiť príkaz „%@“?\nSpustí sa potichu na pozadí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zagnati ukaz »%@«?\nZagnan bo tiho v ozadju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köra kommandot ”%@”?\nDet körs tyst i bakgrunden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” komutu çalıştırılsın mı?\nArka planda sessizce çalışacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy lệnh “%@”?\nLệnh sẽ chạy ngầm trong nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行命令“%@”？\n它将在后台静默运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要執行指令「%@」嗎？\n它會在背景中靜默執行。"
          }
        }
      }
    },
