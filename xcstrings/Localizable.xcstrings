    "Tip.0036.Body" : {
      "comment" : "Tip of the day body, id 0036",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann Dateien herunterladen, indem es sie Base64-codiert. Klicken Sie auf „Mehr erfahren“, um ein Shellskript herunterzuladen, das dies vereinfacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can download files by base-64 encoding them. Click “Learn More” to download a shell script that makes it easy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、ファイルをBase64エンコードすることでダウンロードできます。「詳しくはこちら」をクリックすると、これを簡単にするシェルスクリプトをダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 파일을 base-64로 인코딩하여 다운로드할 수 있습니다. 이를 쉽게 해 주는 셸 스크립트를 다운로드하려면 “더 알아보기”를 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode transferir arquivos codificando-os em base-64. Clique em “Saiba mais” para transferir um shell script que facilita isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может загружать файлы, кодируя их в base-64. Нажмите «Подробнее», чтобы загрузить сценарий оболочки, который упрощает этот процесс."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以通过 Base-64 编码来下载文件。点击“了解更多”，可以下载一个 shell 脚本，方便使用。"
          }
        }
      }
    },
    "Tip.0036.Title" : {
