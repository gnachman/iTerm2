    "SCPFile.HostIdentificationChanged" : {
      "comment" : "Warning shown when a host's key fingerprint has changed; first %@ is the key hash type, second %@ is the host, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDENTIFIKACE VZDÁLENÉHO HOSTITELE SE ZMĚNILA!\n\nOtisk klíče %1$@ hostitele „%2$@“ se změnil. Nyní je %3$@.\n\nPrávě vás může někdo odposlouchávat (útok typu man-in-the-middle)!\nJe také možné, že byl klíč hostitele právě změněn.\nPřesto se připojit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FJERNVÆRTENS IDENTIFIKATION ER ÆNDRET!\n\nFingeraftrykket for %1$@-nøglen til værten “%2$@” er ændret. Det er %3$@.\n\nNogen kan være ved at aflytte dig lige nu (man-in-the-middle-angreb)!\nDet er også muligt, at en værtsnøgle netop er blevet ændret.\nVil du oprette forbindelse alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DIE IDENTIFIZIERUNG DES REMOTE-HOSTS HAT SICH GEÄNDERT!\n\nDer %1$@-Schlüssel-Fingerabdruck des Hosts '%2$@' hat sich geändert. Er lautet jetzt %3$@.\n\nMöglicherweise belauscht Sie gerade jemand (Man-in-the-Middle-Angriff)!\nEs ist auch möglich, dass ein Host-Schlüssel einfach geändert wurde.\nTrotzdem verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "REMOTE HOST IDENTIFICATION HAS CHANGED!\n\nThe %1$@ key fingerprint of host '%2$@' has changed. It is %3$@.\n\nSomeone could be eavesdropping on you right now (man-in-the-middle attack)!\nIt is also possible that a host key has just been changed.\nConnect anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡LA IDENTIFICACIÓN DEL HOST REMOTO HA CAMBIADO!\n\nLa huella de la clave %1$@ del host “%2$@” ha cambiado. Es %3$@.\n\n¡Alguien podría estar espiándote ahora mismo (ataque de intermediario)!\nTambién es posible que se acabe de cambiar la clave del host.\n¿Conectar de todos modos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETÄPALVELIMEN TUNNISTE ON MUUTTUNUT!\n\nPalvelimen ”%2$@” %1$@-avaimen sormenjälki on muuttunut. Se on %3$@.\n\nJoku voi salakuunnella sinua juuri nyt (välimieshyökkäys)!\nOn myös mahdollista, että palvelimen avain on juuri vaihdettu.\nYhdistetäänkö silti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IDENTIFICATION DE L’HÔTE DISTANT A CHANGÉ !\n\nL’empreinte de la clé %1$@ de l’hôte « %2$@ » a changé. Elle est %3$@.\n\nQuelqu’un pourrait vous espionner en ce moment (attaque de l’homme du milieu) !\nIl est aussi possible qu’une clé d’hôte vienne d’être modifiée.\nSe connecter quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IDENTIFICAZIONE DELL’HOST REMOTO È CAMBIATA!\n\nL’impronta della chiave %1$@ dell’host “%2$@” è cambiata. È %3$@.\n\nQualcuno potrebbe essere in ascolto in questo momento (attacco man-in-the-middle)!\nÈ anche possibile che la chiave dell’host sia appena stata cambiata.\nConnettersi comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートホストの識別情報が変更されました!\n\nホスト '%2$@' の %1$@ 鍵のフィンガープリントが変更されました。現在のフィンガープリントは %3$@ です。\n\n何者かが盗聴している可能性があります(中間者攻撃)!\nホスト鍵が単に変更されただけの可能性もあります。\nこのまま接続しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 호스트 식별 정보가 변경되었습니다!\n\n호스트 '%2$@'의 %1$@ 키 지문이 변경되었습니다. 현재 지문은 %3$@입니다.\n\n누군가 지금 도청하고 있을 수 있습니다(중간자 공격)!\n호스트 키가 방금 변경되었을 가능성도 있습니다.\n그래도 연결하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDENTIFIKASJONEN AV DEN EKSTERNE VERTEN ER ENDRET!\n\nNøkkelfingeravtrykket for %1$@ for verten «%2$@» er endret. Det er %3$@.\n\nNoen kan avlytte deg akkurat nå (man-in-the-middle-angrep)!\nDet er også mulig at en vertsnøkkel nettopp er endret.\nVil du koble til likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DE IDENTIFICATIE VAN DE EXTERNE HOST IS GEWIJZIGD!\n\nDe vingerafdruk van de %1$@-sleutel van host ‘%2$@’ is gewijzigd. Deze is %3$@.\n\nIemand kan je op dit moment afluisteren (man-in-the-middle-aanval)!\nHet is ook mogelijk dat een hostsleutel zojuist is gewijzigd.\nToch verbinden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOŻSAMOŚĆ HOSTA ZDALNEGO ULEGŁA ZMIANIE!\n\nOdcisk klucza %1$@ hosta „%2$@” zmienił się. Wynosi %3$@.\n\nKtoś może właśnie podsłuchiwać twoją komunikację (atak typu man-in-the-middle)!\nMożliwe też, że klucz hosta został dopiero co zmieniony.\nPołączyć mimo to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IDENTIFICAÇÃO DO HOST REMOTO MUDOU!\n\nA impressão digital da chave %1$@ do host “%2$@” mudou. Ela é %3$@.\n\nAlguém pode estar interceptando você neste momento (ataque man-in-the-middle)!\nTambém é possível que uma chave de host tenha acabado de ser alterada.\nConectar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИДЕНТИФИКАЦИЯ УДАЛЁННОГО УЗЛА ИЗМЕНИЛАСЬ!\n\nОтпечаток ключа %1$@ узла «%2$@» изменился. Теперь это %3$@.\n\nВозможно, кто-то перехватывает соединение прямо сейчас (атака «человек посередине»)!\nТакже возможно, что ключ узла был просто изменён.\nВсё равно подключиться?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDENTIFIKÁCIA VZDIALENÉHO HOSTITEĽA SA ZMENILA!\n\nOdtlačok kľúča %1$@ hostiteľa „%2$@“ sa zmenil. Je to %3$@.\n\nNiekto vás môže práve odpočúvať (útok typu man-in-the-middle)!\nMožné je aj to, že sa kľúč hostiteľa práve zmenil.\nPripojiť sa aj tak?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDENTIFIKACIJA ODDALJENEGA GOSTITELJA SE JE SPREMENILA!\n\nPrstni odtis ključa %1$@ gostitelja »%2$@« se je spremenil. Zdaj je %3$@.\n\nNekdo vam morda prav zdaj prisluškuje (napad človek v sredini)!\nMogoče je tudi, da je bil ključ gostitelja pravkar spremenjen.\nŽelite kljub temu vzpostaviti povezavo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FJÄRRVÄRDENS IDENTIFIERING HAR ÄNDRATS!\n\n%1$@-fingeravtrycket för värden ”%2$@” har ändrats. Det är %3$@.\n\nNågon kan avlyssna dig just nu (man-in-the-middle-attack)!\nDet är också möjligt att en värdnyckel just har ändrats.\nVill du ansluta ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UZAK ANA MAKİNENİN KİMLİĞİ DEĞİŞTİ!\n\n“%2$@” ana makinesinin %1$@ anahtar parmak izi değişti. Yeni parmak izi: %3$@.\n\nŞu anda biri sizi dinliyor olabilir (ortadaki adam saldırısı)!\nBir ana makine anahtarının yeni değiştirilmiş olması da mümkündür.\nYine de bağlanılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NHẬN DẠNG CỦA MÁY CHỦ TỪ XA ĐÃ THAY ĐỔI!\n\nDấu vân tay khóa %1$@ của máy chủ “%2$@” đã thay đổi. Giá trị mới là %3$@.\n\nCó thể ai đó đang nghe lén bạn ngay lúc này (tấn công trung gian)!\nCũng có thể khóa của máy chủ vừa được thay đổi.\nVẫn kết nối?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "REMOTE HOST IDENTIFICATION HAS CHANGED!\n\n主机 '%2$@' 的 %1$@ 密钥指纹已变更，当前值为 %3$@。\n\n可能有人正在窃听您（中间人攻击）！\n也可能只是主机密钥发生了变更。\n仍要连接吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端主機的身分識別已變更！\n\n主機「%2$@」的 %1$@ 金鑰指紋已變更，目前為 %3$@。\n\n可能有人正在竊聽你的連線（中間人攻擊）！\n也有可能只是主機金鑰剛被更換。\n仍要連線嗎？"
          }
        }
      }
    },
    "SCPFile.InvalidFilename" : {
      "comment" : "Error shown when the remote path has no valid filename component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
