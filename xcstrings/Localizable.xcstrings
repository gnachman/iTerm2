    "BrowserScriptingPermissions.Explanation" : {
      "comment" : "Explanation at the top of the panel listing websites that scripts may control in a browser session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor ein Skript URLs lädt oder JavaScript auf einer Website in einer Browser-Sitzung ausführt, fragt iTerm2 Sie. Gespeicherte Antworten werden hier aufgeführt und gelten für alle Skripte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before a script loads URLs or runs JavaScript on a website in a browser session, iTerm2 asks you. Remembered answers are listed here and apply to all scripts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトがブラウザセッションでWebサイトのURLを読み込んだりJavaScriptを実行したりする前に、iTerm2は確認を求めます。記憶された回答はここに一覧表示され、すべてのスクリプトに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 세션에서 스크립트가 웹 사이트의 URL을 로드하거나 JavaScript를 실행하기 전에 iTerm2가 사용자에게 묻습니다. 기억된 응답은 여기에 나열되며 모든 스크립트에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de um script carregar URLs ou executar JavaScript em um site em uma sessão do navegador, o iTerm2 pergunta a você. As respostas lembradas aparecem aqui e valem para todos os scripts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем скрипт загрузит URL или выполнит JavaScript на веб-сайте в сессии браузера, iTerm2 спрашивает вас. Запомненные ответы перечислены здесь и действуют для всех скриптов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在脚本于浏览器会话中载入网站的 URL 或在网站上运行 JavaScript 之前，iTerm2 会先询问你。记住的回答会列在这里，并适用于所有脚本。"
          }
        }
      }
    },
