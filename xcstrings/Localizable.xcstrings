          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの選択を促した後、現在のセッションを水平に分割し、新しいセッションを下半分に配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
