    "ChatViewController.LinkedSessionHelp" : {
      "comment" : "Help text explaining what linking a terminal session to the chat allows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je s tímto chatem propojena relace terminálu, AI může zobrazovat obsah terminálu a spouštět v dané relaci příkazy. Než bude moci relaci terminálu zobrazit, psát do ní nebo ji měnit, budete požádáni o oprávnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en terminalsession er knyttet til denne chat, kan AI se terminalindhold og køre kommandoer i den session. Du bliver bedt om tilladelse, før den kan se, skrive i eller ændre en terminalsession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Terminalsitzung mit diesem Chat verknüpft ist, kann die KI den Terminalinhalt einsehen und Befehle in dieser Sitzung ausführen. Sie werden aufgefordert, die Berechtigung zu erteilen, bevor sie eine Terminalsitzung einsehen, in sie tippen oder sie ändern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When a terminal session is linked to this chat, the AI may view terminal contents and run commands in that session. You will be prompted to grant permission before it is able to view, type to, or modify a terminal session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una sesión de terminal está vinculada a este chat, la IA puede ver el contenido de la terminal y ejecutar comandos en esa sesión. Se te pedirá permiso antes de que pueda ver, escribir en o modificar una sesión de terminal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun päätteen istunto on linkitetty tähän keskusteluun, AI voi katsoa päätteen sisältöä ja suorittaa komentoja kyseisessä istunnossa. Sinulta pyydetään lupa ennen kuin se voi katsoa päätteen istuntoa, kirjoittaa siihen tai muokata sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’une session de terminal est liée à ce chat, l’IA peut voir le contenu du terminal et exécuter des commandes dans cette session. Votre autorisation vous sera demandée avant qu’elle puisse voir, saisir dans ou modifier une session de terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una sessione di terminale è collegata a questa chat, l’IA può vedere il contenuto del terminale ed eseguire comandi in quella sessione. Ti verrà chiesta l’autorizzazione prima che possa visualizzare, digitare in o modificare una sessione di terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルセッションがこのチャットにリンクされている場合、AIはそのセッションのターミナル内容を閲覧したり、コマンドを実行したりできます。ターミナルセッションを閲覧、入力、または変更する前には、許可を求めるダイアログが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 세션이 이 채팅에 연결되어 있으면 AI가 해당 세션의 터미널 내용을 보고 명령을 실행할 수 있습니다. AI가 터미널 세션을 보거나, 입력하거나, 수정하기 전에 권한을 부여하라는 요청이 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en terminaløkt er koblet til denne chatten, kan KI se terminalinnholdet og kjøre kommandoer i økten. Du blir bedt om å gi tillatelse før den kan se, skrive til eller endre en terminaløkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een terminalsessie aan deze chat is gekoppeld, kan de AI de terminalinhoud bekijken en commando’s in die sessie uitvoeren. Je wordt om toestemming gevraagd voordat de AI een terminalsessie kan bekijken, erin kan typen of deze kan wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy sesja terminala jest powiązana z tym czatem, AI może wyświetlać zawartość terminala i uruchamiać polecenia w tej sesji. Zanim AI będzie mogło wyświetlać sesję terminala, pisać w niej lub ją modyfikować, zostaniesz poproszony o zgodę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma sessão de terminal está vinculada a este chat, a IA pode ver o conteúdo do terminal e executar comandos nessa sessão. Você será solicitado a conceder permissão antes que ela possa ver, digitar ou modificar uma sessão de terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда сессия терминала привязана к этому чату, ИИ может просматривать содержимое терминала и выполнять команды в этой сессии. Вам будет предложено предоставить разрешение, прежде чем он сможет просматривать, вводить текст или изменять сессию терминала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je k tomuto chatu prepojená relácia terminálu, AI môže zobrazovať obsah terminálu a spúšťať príkazy v tejto relácii. Predtým, než bude môcť reláciu terminálu zobraziť, písať do nej alebo ju upravovať, budete požiadaní o povolenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je seja terminala povezana s tem klepetom, lahko AI vidi vsebino terminala in v tej seji izvaja ukaze. Preden bo lahko videl, tipkal ali spreminjal sejo terminala, boste pozvani, da to dovolite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en terminalsession är länkad till den här chatten kan AI visa terminalinnehåll och köra kommandon i sessionen. Du tillfrågas om tillstånd innan den kan visa, skriva i eller ändra en terminalsession."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir terminal oturumu bu sohbete bağlandığında YZ, terminal içeriğini görebilir ve o oturumda komut çalıştırabilir. Bir terminal oturumunu görüntülemesi, oturuma yazması veya oturumu değiştirmesi için önce izin vermeniz istenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi một phiên terminal được liên kết với cuộc trò chuyện này, AI có thể xem nội dung terminal và chạy lệnh trong phiên đó. Bạn sẽ được yêu cầu cấp quyền trước khi AI có thể xem, nhập vào hoặc sửa đổi một phiên terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当终端会话链接到此聊天时，AI 可以查看终端内容并在该会话中运行命令。在它能够查看、输入或修改终端会话之前，系统会先提示你授予权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當終端機工作階段連結到此聊天時，AI 可以檢視終端機內容，並在該工作階段中執行指令。在它能檢視、輸入或修改終端機工作階段之前，系統會先提示你授予權限。"
          }
        }
      }
    },
