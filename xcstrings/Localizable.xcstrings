    "AdvancedSetting.tabColorMenuOptions" : {
      "comment" : "Advanced setting: tabColorMenuOptions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barvy pro položku nabídky barvy panelu.\nŘetězce oddělené mezerami jako #rrggbb nebo #rgb v barevném prostoru sRGB. Pokud je dostupný barevný prostor P3, můžete použít řetězce jako: color(p3 1 0.5 0.25)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farver til menuemnet for fanefarve.\nStrenge adskilt af mellemrum som #rrggbb eller #rgb i farverummet sRGB. Hvis farverummet P3 er tilgængeligt, kan du bruge strenge som: color(p3 1 0.5 0.25)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben für den Menüpunkt „Tab-Farbe“.\nDurch Leerzeichen getrennte Zeichenfolgen wie #rrggbb oder #rgb im sRGB-Farbraum. Wenn der P3-Farbraum verfügbar ist, können Sie Zeichenfolgen wie color(p3 1 0.5 0.25) verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Colors for tab color menu item.\nSpace delimited strings like #rrggbb or #rgb in sRGB color space. If the P3 color space is available, you can use strings like: color(p3 1 0.5 0.25)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores del ítem de menú de color de pestaña.\nCadenas separadas por espacios como #rrggbb o #rgb en el espacio de color sRGB. Si el espacio de color P3 está disponible, puedes usar cadenas como: color(p3 1 0.5 0.25)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välilehden värivalikkokohteen värit.\nVälilyönnillä erotetut merkkijonot kuten #rrggbb tai #rgb sRGB-värimaailmassa. Jos P3-värimaailma on saatavilla, voit käyttää merkkijonoja kuten: color(p3 1 0.5 0.25)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleurs de l’élément de menu de couleur d’onglet.\nChaînes séparées par des espaces comme #rrggbb ou #rgb dans l’espace colorimétrique sRGB. Si l’espace colorimétrique P3 est disponible, vous pouvez utiliser des chaînes comme : color(p3 1 0.5 0.25)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colori per la voce di menu del colore del pannello.\nStringhe separate da spazi come #rrggbb o #rgb nello spazio colore sRGB. Se lo spazio colore P3 è disponibile, puoi usare stringhe come: color(p3 1 0.5 0.25)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブの色メニュー項目の色。\nsRGBカラースペースでの#rrggbbや#rgbのようなスペース区切りの文字列。P3カラースペースが利用可能な場合、color(p3 1 0.5 0.25)のような文字列も使用できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 색상 메뉴 항목에 사용할 색상입니다.\nsRGB 색 공간의 #rrggbb 또는 #rgb 같은 문자열을 공백으로 구분하여 입력합니다. P3 색 공간을 사용할 수 있으면 다음과 같은 문자열을 사용할 수 있습니다: color(p3 1 0.5 0.25)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farger for menyobjektet for fanefarge.\nStrenger atskilt med mellomrom, som #rrggbb eller #rgb i sRGB-fargerommet. Hvis P3-fargerommet er tilgjengelig, kan du bruke strenger som: color(p3 1 0.5 0.25)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleuren voor het menuonderdeel voor tabbladkleur.\nDoor spaties gescheiden tekenreeksen zoals #rrggbb of #rgb in de sRGB-kleurruimte. Als de kleurruimte P3 beschikbaar is, kun je tekenreeksen gebruiken zoals: color(p3 1 0.5 0.25)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolory dla elementu menu koloru karty.\nCiągi oddzielone spacjami, takie jak #rrggbb lub #rgb w przestrzeni kolorów sRGB. Jeśli dostępna jest przestrzeń kolorów P3, możesz użyć ciągów takich jak: color(p3 1 0.5 0.25)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores para o item de menu de cor de aba.\nStrings separadas por espaço, como #rrggbb ou #rgb no espaço de cores sRGB. Se o espaço de cores P3 estiver disponível, você pode usar strings como: color(p3 1 0.5 0.25)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвета для пункта меню цвета вкладки.\nСтроки, разделённые пробелами, вида #rrggbb или #rgb в цветовом пространстве sRGB. Если доступно цветовое пространство P3, можно использовать строки вида: color(p3 1 0.5 0.25)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farby pre položku menu farby tabu.\nReťazce oddelené medzerami, napríklad #rrggbb alebo #rgb vo farebnom priestore sRGB. Ak je dostupný farebný priestor P3, môžete použiť reťazce ako: color(p3 1 0.5 0.25)"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barve za element menija z barvo zavihka.\nNizi, ločeni s presledki, kot #rrggbb ali #rgb v barvnem prostoru sRGB. Če je na voljo barvni prostor P3, lahko uporabite nize, kot je: color(p3 1 0.5 0.25)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färger för menyobjektet för flikfärg.\nMellanslagsavgränsade strängar som #rrggbb eller #rgb i färgrymden sRGB. Om färgrymden P3 är tillgänglig kan du använda strängar som: color(p3 1 0.5 0.25)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme rengi menü öğesi için renkler.\nsRGB renk alanında #rrggbb veya #rgb gibi boşlukla ayrılmış dizeler. P3 renk alanı varsa şu gibi dizeler kullanabilirsiniz: color(p3 1 0.5 0.25)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu cho mục menu màu tab.\nCác chuỗi phân tách bằng dấu cách như #rrggbb hoặc #rgb trong không gian màu sRGB. Nếu có không gian màu P3, bạn có thể dùng các chuỗi như: color(p3 1 0.5 0.25)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页颜色菜单项的颜色。  \n如 sRGB 颜色空间中的空格分隔字符串，例如 #rrggbb 或 #rgb。若可用 P3 颜色空间，可使用类似格式：color(p3 1 0.5 0.25)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁顏色選單項目的顏色。\n以空格分隔的字串，例如 sRGB 色彩空間中的 #rrggbb 或 #rgb。如果可以使用 P3 色彩空間，則可使用像這樣的字串：color(p3 1 0.5 0.25)"
          }
        }
      }
    },
    "AdvancedSetting.tabFlashAnimationDuration" : {
      "comment" : "Advanced setting: tabFlashAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
