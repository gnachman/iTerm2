    "SemanticHistory.SendTextCaveat" : {
      "comment" : "Explanation of the send-text semantic history action",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text wird gesendet, wenn Sie Semantic History auf einem beliebigen Dateinamen aktivieren. Verwenden Sie Sonderzeichen im vim-Stil. Verwenden Sie \\1 für den Dateinamen, \\2 für die Zeilennummer, \\3 für den Text vor dem Klick, \\4 für den Text nach dem Klick und \\5 für das Arbeitsverzeichnis (pwd). "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Text is sent when you activate Semantic History on any filename. Use vim-style special characters.Use \\1 for filename, \\2 for line number, \\3 for text before click, \\4 for text after click, \\5 for pwd. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto se envía cuando activas el historial semántico en cualquier nombre de archivo. Usa caracteres especiales al estilo de vim. Usa \\1 para el nombre de archivo, \\2 para el número de línea, \\3 para el texto anterior al clic, \\4 para el texto posterior al clic y \\5 para pwd. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte est envoyé lorsque vous activez l’historique sémantique sur n’importe quel nom de fichier. Utilisez les caractères spéciaux de style vim. Utilisez \\1 pour le nom de fichier, \\2 pour le numéro de ligne, \\3 pour le texte avant le clic, \\4 pour le texte après le clic, \\5 pour le répertoire de travail. "
