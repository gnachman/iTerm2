    "ToolStatus.WatchingTooltipSession" : {
      "comment" : "Tooltip for the notify button when armed and targeting the selected session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje se změna stavu vybrané relace. Při příští změně se zobrazí upozornění a sledování se vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder øje med, om den valgte sessions status ændres. En advarsel vises ved næste ændring, og derefter slås dette fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwacht die ausgewählte Sitzung auf eine Statusänderung. Bei der nächsten Änderung erscheint ein Hinweis, danach wird dies wieder deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watching the selected session for a status change. An alert will appear on the next change, then turn this off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigilando el cambio de estado de la sesión seleccionada. Aparecerá una alerta en el próximo cambio y después esto se desactivará."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valittua istuntoa tarkkaillaan tilan muutosten varalta. Varoitus tulee seuraavasta muutoksesta, minkä jälkeen tämä menee pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillance de la session sélectionnée en cas de changement d’état. Une alerte apparaîtra au prochain changement, puis cette option sera désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo del cambio di stato della sessione selezionata. Al prossimo cambio apparirà un avviso, poi questa opzione si disattiverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したセッションのステータス変化を監視しています。次に変化したときにアラートが表示され、その後この機能はオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 세션의 상태 변경을 감시하는 중입니다. 다음 변경 시 경고가 나타난 후 이 기능은 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvåker den markerte økten for statusendring. Et varsel vises ved neste endring, og deretter slås dette av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde sessie wordt in de gaten gehouden voor een statuswijziging. Bij de volgende wijziging verschijnt een melding, daarna wordt dit uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwowanie zmiany stanu zaznaczonej sesji. Przy następnej zmianie pojawi się alert, a potem ta opcja zostanie wyłączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitorando a mudança de status da sessão selecionada. Um alerta aparecerá na próxima mudança, e então isto será desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживание изменения статуса выбранного сеанса. При следующем изменении появится оповещение, после чего отслеживание отключится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje sa zmena stavu vybranej relácie. Pri ďalšej zmene sa zobrazí upozornenie a potom sa toto vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljanje spremembe stanja izbrane seje. Ob naslednji spremembi se bo prikazalo opozorilo, nato se bo to izklopilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevakar den markerade sessionen efter en statusändring. En varning visas vid nästa ändring, och sedan stängs det här av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili oturumun durum değişikliği izleniyor. Bir sonraki değişiklikte bir uyarı görünür, ardından bu özellik kapanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang theo dõi sự thay đổi trạng thái của phiên đã chọn. Một cảnh báo sẽ xuất hiện ở lần thay đổi tiếp theo, sau đó tùy chọn này sẽ tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在监视所选会话的状态更改。下一次更改时会出现提醒，然后此选项会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在監看所選工作階段的狀態變更。下次變更時會出現警示，然後此選項會關閉。"
          }
        }
      }
    },
