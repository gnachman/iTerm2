    "AdvancedSetting.smartCursorColorBgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorBgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práh Chytré barvy kurzoru pro barvu pozadí (0 až 1).\n0 znamená, že barva pozadí kurzoru bude vždy barvou textu buňky, 1 znamená, že bude vždy černá nebo bílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tærskel for Smart markørfarve for baggrundsfarve (0 til 1).\n0 betyder, at markørens baggrundsfarve altid er cellens tekstfarve, mens 1 betyder, at den altid er sort eller hvid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert der intelligenten Cursorfarbe für die Hintergrundfarbe (0 bis 1).\n0 bedeutet, dass die Hintergrundfarbe des Cursors immer die Textfarbe der Zelle ist, während 1 bedeutet, dass sie immer Schwarz oder Weiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for background color (0 to 1).\n0 means the cursor’s background color will always be the cell’s text color, while 1 means it will always be black or white."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbral del color inteligente del cursor para el color de fondo (0 a 1).\n0 significa que el color de fondo del cursor siempre será el color de texto de la celda, mientras que 1 significa que siempre será negro o blanco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älykkään kohdistinvärin kynnysarvo taustavärille (0–1).\n0 tarkoittaa, että kohdistimen taustaväri on aina solun tekstiväri, ja 1 tarkoittaa, että se on aina musta tai valkoinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil de la couleur de curseur intelligente pour la couleur d’arrière-plan (0 à 1).\n0 signifie que la couleur d’arrière-plan du curseur sera toujours la couleur du texte de la cellule, et 1 qu’elle sera toujours noire ou blanche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglia del colore intelligente del cursore per il colore di sfondo (da 0 a 1).\n0 significa che il colore di sfondo del cursore sarà sempre il colore del testo della cella, mentre 1 significa che sarà sempre nero o bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Cursor Colorの背景色のしきい値（0から1）。\n0はカーソルの背景色が常にセルのテキスト色になり、1は常に黒または白になることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경 색상에 대한 스마트 커서 색상의 임계값(0~1)입니다.\n0이면 커서의 배경 색상이 항상 셀의 텍스트 색상이 되고, 1이면 항상 검은색 또는 흰색이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terskel for smart markørfarge for bakgrunnsfarge (0 til 1).\n0 betyr at markørens bakgrunnsfarge alltid er cellens tekstfarge, mens 1 betyr at den alltid er svart eller hvit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drempel voor Slimme cursorkleur voor achtergrondkleur (0 tot 1).\n0 betekent dat de achtergrondkleur van de cursor altijd de tekstkleur van de cel is, terwijl 1 betekent dat die altijd zwart of wit is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próg Inteligentnego koloru kursora dla koloru tła (od 0 do 1).\n0 oznacza, że kolor tła kursora będzie zawsze kolorem tekstu komórki, a 1, że zawsze będzie czarny lub biały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor de plano de fundo (0 a 1).\n0 significa que a cor de plano de fundo do cursor será sempre a cor do texto da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог для функции «умный цвет курсора» (Smart Cursor Color) для цвета фона (от 0 до 1).\n0 означает, что цвет фона курсора всегда будет совпадать с цветом текста ячейки, а 1 — что он всегда будет чёрным или белым."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prah inteligentnej farby kurzora pre farbu pozadia (0 až 1).\n0 znamená, že farba pozadia kurzora bude vždy farba textu bunky, 1 že bude vždy čierna alebo biela."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prag za pametno barvo kazalca za barvo ozadja (0 do 1).\n0 pomeni, da bo barva ozadja kazalca vedno barva besedila celice, 1 pa, da bo vedno črna ali bela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tröskelvärde för smart markörfärg för bakgrundsfärg (0 till 1).\n0 betyder att markörens bakgrundsfärg alltid är cellens textfärg, medan 1 betyder att den alltid är svart eller vit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan rengi için Akıllı İmleç Rengi eşiği (0 ile 1).\n0, imlecin arka plan renginin her zaman hücrenin metin rengi olacağı, 1 ise her zaman siyah veya beyaz olacağı anlamına gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngưỡng của Màu con trỏ thông minh cho màu nền (0 đến 1).\n0 nghĩa là màu nền của con trỏ luôn là màu văn bản của ô, còn 1 nghĩa là luôn là đen hoặc trắng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景颜色智能光标颜色的阈值（0到1）。\n0表示光标背景颜色始终为单元格文本颜色，1则表示始终为黑色或白色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景顏色的智慧型游標顏色閾值（0 到 1）。\n0 表示游標的背景顏色一律為儲存格的文字顏色，1 則表示一律為黑色或白色。"
          }
        }
      }
    },
    "AdvancedSetting.smartCursorColorFgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorFgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
