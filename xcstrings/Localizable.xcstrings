    "StatusBarSnippet.DetailedDescription" : {
      "comment" : "Detailed description of the snippets menu status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknutí otevře nabídku úryvků. Úryvky jsou uložené textové řetězce, které lze rychle vložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner en menu med tekststykker, når der klikkes. Tekststykker er gemte tekststrenge, der hurtigt kan sættes ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet beim Anklicken ein Menü mit Schnipseln. Schnipsel sind gespeicherte Textbausteine, die schnell eingefügt werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When clicked, opens a menu of snippets. Snippets are saved text strings that can be pasted quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer clic, abre un menú de fragmentos. Los fragmentos son cadenas de texto guardadas que se pueden pegar rápidamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikattaessa avaa katkelmavalikon. Katkelmat ovat tallennettuja tekstijonoja, jotka voi sijoittaa nopeasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au clic, ouvre un menu d’extraits. Les extraits sont des chaînes de texte enregistrées qui peuvent être collées rapidement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si fa clic, apre un menu di frammenti. I frammenti sono stringhe di testo salvate che possono essere incollate rapidamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックするとスニペットのメニューが開きます。スニペットは、すばやく貼り付けられる保存済みのテキスト文字列です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 스니펫 메뉴가 열립니다. 스니펫은 빠르게 붙여넣을 수 있도록 저장해 둔 텍스트 문자열입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du klikker, åpnes en meny med tekstbiter. Tekstbiter er lagrede tekststrenger som raskt kan limes inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent bij klikken een menu met fragmenten. Fragmenten zijn bewaarde tekenreeksen die snel kunnen worden geplakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknięciu otwiera menu fragmentów kodu. Fragmenty kodu to zapisane ciągi tekstu, które można szybko wkleić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando clicado, abre um menu de Fragmentos. Os Fragmentos são textos salvos que podem ser colados rapidamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При нажатии открывает меню фрагментов. Фрагменты представляют собой сохранённые текстовые строки, которые можно быстро вставить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknutí otvorí menu úryvkov. Úryvky sú uložené textové reťazce, ktoré možno rýchlo vložiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob kliku odpre meni izrezkov. Izrezki so shranjeni nizi besedila, ki jih lahko hitro prilepite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar en meny med textsnuttar när du klickar. Textsnuttar är sparade textsträngar som snabbt kan klistras in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıklandığında bir parçacık menüsü açar. Parçacıklar, hızla yapıştırılabilen kayıtlı metin dizeleridir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bấm, mở một menu đoạn mã. Đoạn mã là các chuỗi văn bản đã lưu có thể dán nhanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按后打开代码片段菜单。代码片段是已保存的文本，可快速粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
