    "Warning.RememberedSelectionExplanation" : {
      "comment" : "Explanation shown when a suppressed alert is displayed anyway; first %@ is the original message, second %@ is the saved selection label",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nU tohoto upozornění byla uložena volba „%2$@“. Zobrazuje se, protože je v části „iTerm2 > Potlačená upozornění“ zapnuta volba „Vždy zobrazovat upozornění se zapamatovanou volbou“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nDenne advarsel havde det gemte valg “%2$@”. Den vises, fordi “Vis altid advarsler med huskede valg” er slået til i iTerm2 > Skjulte advarsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nDiese Meldung hatte eine gespeicherte Auswahl von „%2$@“. Sie wird angezeigt, weil „Warnungen mit gespeicherter Auswahl immer anzeigen“ unter iTerm2 > Unterdrückte Warnungen aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\n\nThis alert had a saved selection of “%2$@”. It is being shown because “Always show alerts with remembered selections” is turned on in iTerm2 > Suppressed Alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nEsta alerta tenía guardada la selección “%2$@”. Se muestra porque “Mostrar siempre las alertas con selecciones recordadas” está activado en iTerm2 > Alertas suprimidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nTällä varoituksella oli tallennettu valinta ”%2$@”. Se näytetään, koska ”Näytä aina varoitukset, joissa on muistettu valinta” on päällä kohdassa iTerm2 > Vaimennetut varoitukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nCette alerte avait un choix enregistré, « %2$@ ». Elle s’affiche car l’option « Toujours afficher les alertes dont le choix est mémorisé » est activée dans iTerm2 > Alertes désactivées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nPer questo avviso era salvata la selezione “%2$@”. Viene mostrato perché l’opzione “Mostra sempre gli avvisi con selezioni ricordate” è attiva in iTerm2 > Avvisi disattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nこのアラートには「%2$@」という保存された選択がありました。iTerm2 > 抑制されたアラートで「記憶された選択があるアラートを常に表示する」がオンになっているため表示されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n이 경고에는 “%2$@”(으)로 저장된 선택이 있었습니다. iTerm2 > 숨긴 경고에서 “기억된 선택이 있는 경고 항상 보기”가 켜져 있으므로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nDette varselet hadde et lagret valg: «%2$@». Det vises fordi «Vis alltid varsler med husket valg» er slått på i «iTerm2 > Skjulte varsler»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nVoor deze waarschuwing was de keuze ‘%2$@’ bewaard. Ze wordt getoond omdat ‘Toon altijd waarschuwingen met onthouden keuzes’ is ingeschakeld in iTerm2 > Onderdrukte waarschuwingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nTen alert miał zapisany wybór „%2$@”. Jest pokazywany, ponieważ w iTerm2 > Wyciszone alerty włączono opcję „Zawsze pokazuj alerty z zapamiętanymi wyborami”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nEste alerta tinha uma seleção salva de “%2$@”. Ele está sendo mostrado porque “Sempre mostrar alertas com seleções lembradas” está ativado em iTerm2 > Alertas suprimidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nДля этого предупреждения был сохранён выбор «%2$@». Оно отображается, потому что параметр «Всегда показывать предупреждения с запомненным выбором» включён в iTerm2 > Подавленные предупреждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nPre toto upozornenie bol uložený výber „%2$@“. Zobrazuje sa, pretože je zapnutá voľba „Vždy zobrazovať upozornenia so zapamätanými voľbami“ v menu „iTerm2 > Potlačené upozornenia“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nTo opozorilo je imelo shranjen izbor »%2$@«. Prikazano je, ker je v »iTerm2 > Utišana opozorila« vklopljena možnost »Vedno prikaži opozorila z zapomnjenimi izbirami«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nDen här varningen hade det sparade valet ”%2$@”. Den visas eftersom ”Visa alltid varningar med ihågkomna val” är aktiverat i iTerm2 > Dolda varningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nBu uyarının kayıtlı bir seçimi vardı: “%2$@”. iTerm2 > Gizlenen Uyarılar bölümünde “Hatırlanan seçimleri olan uyarıları her zaman göster” açık olduğu için gösteriliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\nCảnh báo này có một lựa chọn đã lưu là “%2$@”. Nó được hiển thị vì “Luôn hiển thị cảnh báo có lựa chọn đã ghi nhớ” đang bật trong iTerm2 > Cảnh báo đã ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n此警报保留了“%2$@”的选中内容。显示该消息是因为在 iTerm2 > 抑制警报中已开启“始终以保留的选中内容显示警报”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n\n此警示已儲存的選擇為「%2$@」。之所以顯示，是因為在 iTerm2 > 不再顯示的警示中已開啟「一律顯示已記住選擇的警示」。"
          }
        }
      }
    },
    "Warning.SuppressPermanently" : {
