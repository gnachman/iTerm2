    "UndoMigration.Heading" : {
      "comment" : "Heading of the one-time notice explaining that ⌘Z no longer reopens a closed session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odvolání zavření bylo přesunuto"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortryd lukning er flyttet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
