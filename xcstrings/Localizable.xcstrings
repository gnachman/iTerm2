    "AdvancedSetting.remapModifiersWithoutEventTap" : {
      "comment" : "Advanced setting: remapModifiersWithoutEventTap",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnout přemapování modifikačních kláves pro systémové zkratky.\nTím se předejde žádosti o oprávnění ke zpřístupnění. Přemapování systémových zkratek, jako je cmd-tab, nebude fungovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå omtildeling af kombitaster til systemgenveje fra.\nDet forhindrer, at der bedes om tilladelse til tilgængelighed. Det forhindrer omtildeling af systemgenveje som Kommando-Tabulator."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbelegen von Modifizierertasten für Systemtastenkombinationen deaktivieren.\nDadurch entfällt die Abfrage der Bedienungshilfen-Berechtigung. Das Umbelegen von Systemtastenkombinationen wie Cmd-Tab funktioniert dadurch nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable remapping modifiers for system shortcuts.\nThis prevents asking for accessibility permission. It breaks remapping system shortcuts like cmd-tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva la reasignación de modificadores para atajos del sistema.\nEvita pedir permiso de accesibilidad. Impide reasignar atajos del sistema como cmd-tab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista käytöstä muuntonäppäinten uudelleenmääritys järjestelmän oikoteille.\nTämä estää käyttöavun luvan pyytämisen. Se rikkoo järjestelmän oikoteiden, kuten cmd-tab, uudelleenmäärityksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver le remappage des modificateurs pour les raccourcis système.\nCela évite de demander l’autorisation d’accessibilité. Cela empêche le remappage de raccourcis système comme cmd-tab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabilita la rimappatura dei tasti modificatori per le abbreviazioni di sistema.\nEvita di richiedere l’autorizzazione di accessibilità. Impedisce di rimappare abbreviazioni di sistema come cmd-tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムショートカットの修飾キー再マッピングを無効にする。\nこれによりアクセシビリティ権限の要求を防げます。ただし、cmd-tabのようなシステムショートカットの再マッピングが機能しなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 단축키에 대한 보조 키 재지정 끄기\n손쉬운 사용 권한을 요청하지 않게 됩니다. 대신 cmd-tab 같은 시스템 단축키의 재지정이 작동하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver omtilordning av spesialtaster for systemsnarveier.\nDette hindrer at det spørres om tilgjengelighetstillatelse. Det ødelegger omtilordning av systemsnarveier som ⌘-Tab."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel het opnieuw toewijzen van speciale toetsen voor systeemsneltoetsen uit.\nDit voorkomt dat om toestemming voor Toegankelijkheid wordt gevraagd. Het verstoort het opnieuw toewijzen van systeemsneltoetsen zoals cmd-tab."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz zmianę przypisania klawiszy modyfikujących dla skrótów systemowych.\nZapobiega to prośbie o uprawnienie dostępności. Uniemożliwia zmianę przypisania skrótów systemowych, takich jak Cmd-Tab."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o remapeamento de modificadores para atalhos do sistema.\nIsto evita solicitar permissão de acessibilidade. Isto quebra o remapeamento de atalhos do sistema como cmd-tab."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить переназначение модификаторов для системных сочетаний клавиш.\nЭто предотвращает запрос разрешения специальных возможностей. При этом перестаёт работать переназначение системных сочетаний клавиш, например cmd-tab."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnúť premapovanie modifikačných klávesov pre systémové skratky.\nZabráni sa tým žiadosti o povolenie prístupnosti. Preruší to premapovanie systémových skratiek, ako je cmd-tab."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogoči preslikavo modifikatorjev za sistemske bližnjice.\nTako se prepreči zahteva za dovoljenje za dostopnost. Pokvari preslikavo sistemskih bližnjic, kot je cmd-tab."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaktivera omkoppling av modifierartangenter för systemkortkommandon.\nDet förhindrar att behörighet för hjälpmedel begärs. Det gör att omkoppling av systemkortkommandon som ⌘-tabb inte fungerar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem kısayolları için değiştirici tuş yeniden atamayı devre dışı bırak.\nBu, erişilebilirlik izni istenmesini önler. cmd-tab gibi sistem kısayollarının yeniden atanmasını bozar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt gán lại phím bổ trợ cho phím tắt hệ thống.\nĐiều này tránh yêu cầu quyền trợ năng. Nó làm hỏng việc gán lại các phím tắt hệ thống như cmd-tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用系统快捷键的映射转换。\n这可以防止请求无障碍权限，同时会破坏如cmd-tab这样的快捷键映射功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用為系統快速鍵重新對應變更鍵。\n這可避免要求輔助使用權限，但會使 cmd-tab 等系統快速鍵的重新對應失效。"
          }
        }
      }
    },
    "AdvancedSetting.rememberTmuxWindowSizes" : {
      "comment" : "Advanced setting: rememberTmuxWindowSizes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamatovat si velikosti oken v integraci tmux?\nVyžaduje tmux 2.9 nebo novější. Musí být zapnuto pokročilé nastavení „Povolit proměnné velikosti oken v integraci tmux“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk vinduesstørrelser i tmux-integration?\nKræver tmux 2.9 eller nyere. Den avancerede indstilling “variabel vinduesstørrelse” skal være slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstergrößen bei der tmux-Integration merken?\nErfordert tmux 2.9 oder höher. Die erweiterte Einstellung „Variable Fenstergröße“ muss aktiviert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remember window sizes in tmux integration?\nRequires tmux 2.9 or later. The “variable window size” advanced setting must be enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Recordar los tamaños de ventana en la integración con tmux?\nRequiere tmux 2.9 o posterior. Debe estar activado el ajuste avanzado “tamaño de ventana variable”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistetaanko ikkunoiden koot tmux-integraatiossa?\nVaatii tmux 2.9:n tai uudemman. Lisäasetuksen ”muuttuva ikkunakoko” on oltava käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoriser la taille des fenêtres dans l’intégration tmux ?\nNécessite tmux 2.9 ou version ultérieure. Le réglage avancé « taille de fenêtre variable » doit être activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricordare le dimensioni delle finestre nell’integrazione tmux?\nRichiede tmux 2.9 o successivo. L’impostazione avanzata “Consenti dimensioni variabili delle finestre” deve essere attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合でウィンドウサイズを記憶するか？\ntmux 2.9以降が必要です。「可変ウィンドウサイズ」詳細設定を有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합에서 윈도우 크기를 기억하겠습니까?\ntmux 2.9 이상이 필요합니다. “가변 윈도우 크기” 고급 설정이 켜져 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk vindusstørrelser i tmux-integrering?\nKrever tmux 2.9 eller nyere. Den avanserte innstillingen «Tillat variable vindusstørrelser i tmux-integrering» må være aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venstergroottes onthouden in de tmux-integratie?\nVereist tmux 2.9 of later. De geavanceerde instelling ‘variabele venstergrootte’ moet zijn ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zapamiętywać rozmiary okien w integracji z tmux?\nWymaga tmux 2.9 lub nowszego. Musi być włączone ustawienie zaawansowane „zmienny rozmiar okna”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar os tamanhos das janelas na integração do tmux?\nRequer tmux 2.9 ou posterior. O ajuste avançado “tamanho de janela variável” deve estar ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запоминать размеры окон при интеграции с tmux?\nТребуется tmux версии 2.9 или новее. Должен быть включён дополнительный параметр «variable window size»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamätať si veľkosti okien v integrácii tmux?\nVyžaduje tmux 2.9 alebo novší. Musí byť zapnuté rozšírené nastavenie „Povoliť premenlivé veľkosti okien v integrácii tmux“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj si integracija tmux zapomni velikosti oken?\nZahteva tmux 2.9 ali novejši. Napredna nastavitev »variable window size« mora biti omogočena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komma ihåg fönsterstorlekar i tmux-integrering?\nKräver tmux 2.9 eller senare. Den avancerade inställningen ”variabel fönsterstorlek” måste vara aktiverad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux entegrasyonunda pencere boyutları hatırlansın mı?\ntmux 2.9 veya üzerini gerektirir. “tmux entegrasyonunda değişken pencere boyutlarına izin ver” gelişmiş ayarı etkin olmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi nhớ kích thước cửa sổ trong tích hợp tmux?\nYêu cầu tmux 2.9 trở lên. Cài đặt nâng cao “kích thước cửa sổ thay đổi” phải được bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在tmux集成中是否记得窗口大小？\n需要使用tmux 2.9或更高版本。必须启用“变量窗口大小”高级设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 整合中記住視窗大小？\n需要 tmux 2.9 或更新版本。必須啟用「可變視窗大小」進階設定。"
          }
        }
      }
    },
    "AdvancedSetting.removeAddTabButton" : {
      "comment" : "Advanced setting: removeAddTabButton",
