    "Tip.0059.Body" : {
      "comment" : "Tip of the day body, id 0059",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ^ gedrückt, während Sie die Größe eines Fensters ändern, damit es nicht am Zeichenraster einrastet: So können Sie es auf jede beliebige Größe bringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ^ while resizing a window and it won’t snap to the character grid: you can make it any size you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ^ mientras cambias el tamaño de una ventana y no se ajustará a la cuadrícula de caracteres: puedes darle el tamaño que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ^ pendant que vous redimensionnez une fenêtre et elle ne s’alignera pas sur la grille de caractères : vous pouvez lui donner la taille que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ^ mentre ridimensioni una finestra e non si adatterà alla griglia dei caratteri: potrai darle la dimensione che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^を押しながらウィンドウのサイズを変更すると、文字グリッドにスナップしなくなり、好きなサイズに調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^ 키를 누른 채 윈도우 크기를 조절하면 문자 격자에 맞춰지지 않으므로 원하는 크기로 만들 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ^ pressionado ao redimensionar uma janela e ela não se ajustará à grade de caracteres: você pode deixá-la com qualquer tamanho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ^ при изменении размера окна, и оно не будет привязываться к сетке символов: вы сможете сделать его любого размера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencereyi yeniden boyutlandırırken ^ tuşunu basılı tutun; karakter ızgarasına oturmaz ve istediğiniz boyutu verebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整窗口大小时按住 ^ 键，窗口不会自动对齐字符网格；可任意设置大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整視窗大小時按住 ^，視窗就不會貼齊字元格線，你可以調整成任何想要的大小。"
          }
        }
      }
    },
