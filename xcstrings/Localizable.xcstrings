        }
      }
    },
    "AdvancedSetting.workAroundNumericKeypadBug" : {
      "comment" : "Advanced setting: workAroundNumericKeypadBug",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Považovat znak rovná se na numerické klávesnici za klávesu numerické klávesnice.\nZ nejasných důvodů macOS tuto klávesu nepovažuje za součást numerické klávesnice. Zapnutím tohoto nastavení chybu obejdete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandl lighedstegnet på det numeriske tastatur som en tast på det numeriske tastatur.\nAf mystiske årsager behandler macOS ikke denne tast som en del af det numeriske tastatur. Slå denne indstilling til for at omgå fejlen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gleichheitszeichen auf dem Ziffernblock als Taste des Ziffernblocks behandeln.\nAus mysteriösen Gründen behandelt macOS diese Taste nicht als Teil des Ziffernblocks. Aktivieren Sie diese Einstellung, um den Fehler zu umgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Treat the equals sign on the numeric keypad as a key on the numeric keypad.\nFor mysterious reasons, macOS does not treat this key as belonging to the numeric keypad. Enable this setting to work around the bug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trata el signo igual del teclado numérico como una tecla del teclado numérico.\nPor motivos misteriosos, macOS no trata esta tecla como parte del teclado numérico. Activa este ajuste para evitar el error."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsittele numeronäppäimistön yhtäläisyysmerkkiä numeronäppäimistön näppäimenä.\nSalaperäisistä syistä macOS ei käsittele tätä näppäintä numeronäppäimistöön kuuluvana. Ota tämä asetus käyttöön virheen kiertämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traiter le signe égal du pavé numérique comme une touche du pavé numérique.\nPour des raisons mystérieuses, macOS ne considère pas cette touche comme appartenant au pavé numérique. Activez ce réglage pour contourner le bogue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratta il segno di uguale del tastierino numerico come un tasto del tastierino numerico.\nPer misteriosi motivi, macOS non considera questo tasto parte del tastierino numerico. Attiva questa impostazione per aggirare il bug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テンキーのイコール記号をテンキーのキーとして扱います。\n不可解な理由により、macOSはこのキーをテンキーに属するものとして扱いません。このバグを回避するには、この設定を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자 키패드의 등호 키를 숫자 키패드 키로 취급.\n알 수 없는 이유로 macOS는 이 키를 숫자 키패드에 속한 키로 취급하지 않습니다. 이 버그를 우회하려면 이 설정을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle likhetstegnet på talltastaturet som en tast på talltastaturet.\nAv uforklarlige grunner behandler ikke macOS denne tasten som en del av talltastaturet. Aktiver denne innstillingen for å omgå feilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandel het isgelijkteken op het numerieke toetsenblok als toets van het numerieke toetsenblok.\nOm onduidelijke redenen beschouwt macOS deze toets niet als deel van het numerieke toetsenblok. Schakel deze instelling in om de bug te omzeilen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traktuj znak równości na klawiaturze numerycznej jako klawisz klawiatury numerycznej.\nZ niejasnych powodów macOS nie traktuje tego klawisza jako należącego do klawiatury numerycznej. Włącz to ustawienie, aby obejść błąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar o sinal de igual do teclado numérico como uma tecla do teclado numérico.\nPor razões misteriosas, o macOS não trata esta tecla como pertencente ao teclado numérico. Ative este ajuste para contornar o erro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считать знак равенства на цифровой клавиатуре клавишей цифровой клавиатуры.\nПо непонятным причинам macOS не считает эту клавишу принадлежащей цифровой клавиатуре. Включите этот параметр, чтобы обойти ошибку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Považovať znak rovná sa na numerickej klávesnici za kláves numerickej klávesnice.\nZ záhadných dôvodov macOS tento kláves nepovažuje za súčasť numerickej klávesnice. Zapnutím tohto nastavenia chybu obídete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znak enačaja na številski tipkovnici obravnavaj kot tipko številske tipkovnice.\nZ nepojasnjenih razlogov macOS te tipke ne šteje za del številske tipkovnice. Omogočite to nastavitev za zaobid napake."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandla likhetstecknet på det numeriska tangentbordet som en tangent på det numeriska tangentbordet.\nAv oklar anledning behandlar macOS inte den här tangenten som en del av det numeriska tangentbordet. Aktivera den här inställningen för att kringgå felet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayısal tuş takımındaki eşittir işaretini sayısal tuş takımının bir tuşu olarak ele al.\nÇözülemeyen nedenlerle macOS bu tuşu sayısal tuş takımına ait saymaz. Hataya geçici çözüm için bu ayarı etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coi dấu bằng trên bàn phím số như một phím của bàn phím số.\nVì lý do khó hiểu, macOS không coi phím này thuộc bàn phím số. Bật cài đặt này để khắc phục lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将数字小键盘上的等号视为数字小键盘的按键。\n由于神秘原因，macOS 不将此键视为数字小键盘的一部分。开启此设置可解决该缺陷。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將數字鍵台上的等號視為數字鍵台上的按鍵。\n基於不明原因，macOS 不會將此按鍵視為屬於數字鍵台。啟用此設定可解決該錯誤。"
          }
        }
      }
    },
    "AdvancedSetting.workgroupAutoSendSubmitDelay" : {
      "comment" : "Advanced setting: workgroupAutoSendSubmitDelay",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prodleva v sekundách před Return, který odešle automaticky odeslanou revizi kódu.\nKdyž panel nástrojů pracovní skupiny revize kódu automaticky odesílá výsledky revize do hlavní relace, vloží výsledky a potom odešle Return k jejich odeslání. Toto je doba, po kterou se čeká po dokončení vložených výsledků před odesláním Return. TUI s odrušením vkládání (například Claude Code) zpracuje vložení a Return, které přijdou společně, jako jednu dávku, takže Return může být spolknut a revize se neodešle; prodleva způsobí, že Return dorazí při pozdějším čtení, a tak se odešle. Výchozí hodnota odpovídá 500ms okénku ustálení vkládání v Claude Code. Hodnotou 0 se odešle okamžitě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelse i sekunder før Retur, der indsender en automatisk sendt kodegennemgang.\nNår værktøjslinjen i arbejdsgruppen til kodegennemgang automatisk sender gennemgangens resultater til hovedsessionen, indsætter den resultaterne og sender derefter Retur for at indsende dem. Det er så lang tid, den venter, efter at de indsatte resultater er færdige, før den sender Retur. En TUI, der debouncer indsætning (som Claude Code), behandler en indsætning og en Retur, der ankommer sammen, som ét parti, så Retur kan blive slugt, og gennemgangen indsendes aldrig. Forsinkelsen får Retur til at lande i en senere læsning, så den indsendes. Standardværdien svarer til Claude Codes vindue på 500 ms til at lade indsætning falde til ro. Sæt til 0 for at sende den med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung in Sekunden vor der Eingabetaste, die eine automatisch gesendete Code-Review übermittelt.\nWenn die Workgroup-Symbolleiste für die Code-Review Überprüfungsergebnisse automatisch an die Hauptsitzung sendet, fügt sie die Ergebnisse ein und sendet anschließend eine Eingabetaste, um sie zu übermitteln. Diese Einstellung gibt an, wie lange nach dem Abschluss des Einfügens gewartet wird, bevor diese Eingabetaste gesendet wird. Eine TUI mit Paste-Entprellung (wie Claude Code) verarbeitet ein Einfügen und eine Eingabetaste, die zusammen in einem Batch eintreffen, sodass die Eingabetaste verschluckt werden kann und die Überprüfung nie übermittelt wird; die Verzögerung sorgt dafür, dass die Eingabetaste in einem späteren Lesevorgang ankommt, sodass sie übermittelt wird. Die Vorgabe entspricht dem 500-ms-Fenster von Claude Code zum Abschließen des Einfügevorgangs. Auf 0 setzen, um sie sofort zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay in seconds before the Return that submits an auto-sent code review.\nWhen the code-review workgroup toolbar auto-sends review results to the main session, it pastes the results and then sends a Return to submit them. This is how long it waits, after the pasted results finish, before sending that Return. A paste-debouncing TUI (such as Claude Code) processes a paste and a Return that arrive together as one batch, so the Return can be swallowed and the review never submits; the delay makes the Return land in a later read so it submits. The default matches Claude Code’s 500 ms paste-settling window. Set to 0 to send it immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retraso en segundos antes del Retorno que envía una revisión de código enviada automáticamente.\nCuando la barra de herramientas del grupo de trabajo de revisión de código envía automáticamente los resultados de la revisión a la sesión principal, pega los resultados y luego envía un Retorno para enviarlos. Este es el tiempo que espera, una vez terminado el pegado, antes de enviar ese Retorno. Una TUI que agrupa pegados (como Claude Code) procesa como un solo lote un pegado y un Retorno que llegan juntos, por lo que el Retorno puede perderse y la revisión nunca se envía; el retraso hace que el Retorno llegue en una lectura posterior para que se envíe. El valor predeterminado coincide con la ventana de 500 ms de Claude Code para asentar el pegado. Establécelo en 0 para enviarlo de inmediato."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viive sekunteina ennen rivinvaihtoa, joka lähettää automaattisesti lähetetyn koodikatselmoinnin.\nKun koodikatselmoinnin työryhmän työkalupalkki lähettää katselmoinnin tulokset automaattisesti pääistuntoon, se sijoittaa tulokset ja lähettää sitten rivinvaihdon niiden lähettämiseksi. Tämä on aika, jonka se odottaa sijoitettujen tulosten valmistumisen jälkeen ennen rivinvaihdon lähettämistä. Sijoituksia tasaava TUI (kuten Claude Code) käsittelee yhdessä saapuvan sijoituksen ja rivinvaihdon yhtenä eränä, jolloin rivinvaihto voi nielaistua eikä katselmointi koskaan lähde; viive saa rivinvaihdon saapumaan myöhemmässä lukuvaiheessa, jolloin se lähettää. Oletus vastaa Claude Coden 500 ms:n sijoituksen tasaantumisikkunaa. Aseta 0, jos haluat lähettää sen heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai en secondes avant le Retour qui soumet une revue de code envoyée automatiquement.\nLorsque la barre d’outils du groupe de travail de revue de code envoie automatiquement les résultats de la revue à la session principale, elle colle les résultats puis envoie un Retour pour les soumettre. Voici le temps d’attente, après la fin du collage, avant d’envoyer ce Retour. Une TUI qui regroupe les collages (comme Claude Code) traite un collage et un Retour arrivant ensemble comme un seul lot, si bien que le Retour peut être avalé et la revue jamais soumise ; le délai fait arriver le Retour lors d’une lecture ultérieure pour qu’il soumette. La valeur par défaut correspond à la fenêtre de stabilisation du collage de Claude Code, 500 ms. Définissez 0 pour l’envoyer immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo in secondi prima dell’Invio che conferma una revisione del codice inviata automaticamente.\nQuando la barra strumenti del gruppo di lavoro di revisione del codice invia automaticamente i risultati della revisione alla sessione principale, incolla i risultati e poi invia un Invio per confermarli. Questo è il tempo di attesa, al termine dell’incolla, prima di inviare quell’Invio. Una TUI che raggruppa gli incolla (come Claude Code) elabora come un unico blocco un incolla e un Invio che arrivano insieme, quindi l’Invio può andare perso e la revisione non viene mai confermata; il ritardo fa arrivare l’Invio in una lettura successiva, così viene confermata. Il valore predefinito corrisponde alla finestra di 500 ms di Claude Code per assestare l’incolla. Imposta 0 per inviarlo subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動送信されるコードレビューを送信するReturnキーまでの遅延（秒）。\nコードレビューワークグループツールバーがレビュー結果をメインセッションに自動送信する際、結果をペーストしてからReturnキーを送信して送信を確定します。これは、ペーストした結果が完了してからそのReturnキーを送信するまでの待機時間です。ペーストのデバウンス処理を行うTUI（Claude Codeなど）は、同時に届いたペーストとReturnキーを1つのバッチとして処理するため、Returnキーが飲み込まれてレビューが送信されないことがあります。この遅延により、Returnキーは後の読み取りに含まれるようになり、送信されるようになります。デフォルト値は、Claude Codeの500ミリ秒のペースト確定ウィンドウに合わせています。すぐに送信するには0に設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 전송된 코드 리뷰를 제출하는 Return 전의 지연 시간(초).\n코드 리뷰 워크그룹 도구 막대가 리뷰 결과를 주 세션에 자동으로 보낼 때, 결과를 붙여넣은 다음 Return을 보내 제출합니다. 이 값은 붙여넣기가 끝난 뒤 Return을 보내기까지 기다리는 시간입니다. 붙여넣기 디바운싱을 하는 TUI(예: Claude Code)는 함께 도착한 붙여넣기와 Return을 하나의 묶음으로 처리하므로 Return이 무시되어 리뷰가 제출되지 않을 수 있습니다. 지연을 두면 Return이 나중 읽기에서 처리되어 제출됩니다. 기본값은 Claude Code의 붙여넣기 안정화 시간인 500ms와 같습니다. 즉시 보내려면 0으로 설정하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsinkelse i sekunder før Retur som sender en automatisk sendt kodegjennomgang.\nNår verktøylinjen for arbeidsgruppen for kodegjennomgang automatisk sender gjennomgangsresultater til hovedøkten, limer den inn resultatene og sender deretter en Retur for å sende dem. Dette er hvor lenge den venter, etter at innlimingen er ferdig, før Retur sendes. Et TUI med innlimingsdebouncing (som Claude Code) behandler en innliming og en Retur som kommer samtidig som én batch, slik at Retur kan bli slukt og gjennomgangen aldri sendes; forsinkelsen gjør at Retur kommer i en senere lesing slik at den sendes. Standarden tilsvarer Claude Codes innlimingsvindu på 500 ms. Sett til 0 for å sende den umiddelbart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraging in seconden vóór de Return die een automatisch verstuurde codereview indient.\nWanneer de knoppenbalk van de codereview-werkgroep reviewresultaten automatisch naar de hoofdsessie stuurt, plakt die de resultaten en stuurt daarna een Return om ze in te dienen. Dit is hoelang er na het plakken van de resultaten wordt gewacht voordat die Return wordt gestuurd. Een TUI die plakken debounced (zoals Claude Code) verwerkt een plakactie en een Return die samen aankomen als één batch, waardoor de Return kan worden opgeslokt en de review nooit wordt ingediend; de vertraging zorgt ervoor dat de Return in een latere leesactie aankomt en dus wordt ingediend. De standaardwaarde komt overeen met het plakstabilisatievenster van 500 ms van Claude Code. Stel in op 0 om hem direct te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opóźnienie w sekundach przed klawiszem Return zatwierdzającym automatycznie wysłany przegląd kodu.\nGdy pasek narzędzi grupy roboczej przeglądu kodu automatycznie wysyła wyniki przeglądu do głównej sesji, wkleja wyniki, a następnie wysyła Return, aby je zatwierdzić. Tyle czeka po zakończeniu wklejania, zanim wyśle ten Return. TUI z odsiewaniem wklejeń (takie jak Claude Code) przetwarza wklejenie i Return, które nadeszły razem, jako jedną partię, więc Return może zostać połknięty i przegląd nigdy się nie zatwierdzi; opóźnienie sprawia, że Return trafia w późniejszym odczycie i zostaje zatwierdzony. Wartość domyślna odpowiada 500-milisekundowemu oknu uspokajania wklejenia w Claude Code. Ustaw 0, aby wysłać natychmiast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso em segundos antes do Return que envia uma revisão de código enviada automaticamente.\nQuando a barra de ferramentas do grupo de trabalho de revisão de código envia automaticamente os resultados da revisão para a sessão principal, ela cola os resultados e depois envia um Return para submetê-los. Este é o tempo que ela espera, após os resultados colados terminarem, antes de enviar esse Return. Uma TUI que faz debounce de colagem (como o Claude Code) processa uma colagem e um Return que chegam juntos como um único lote, então o Return pode ser engolido e a revisão nunca é submetida; o atraso faz o Return chegar em uma leitura posterior para que seja submetido. O padrão corresponde à janela de estabilização de colagem de 500 ms do Claude Code. Defina como 0 para enviá-lo imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержка в секундах перед нажатием Return, которое отправляет автоматически отправленную проверку кода.\nКогда панель инструментов рабочей группы проверки кода автоматически отправляет результаты проверки в основной сеанс, она вставляет результаты, а затем отправляет Return для их отправки. Это время, которое проходит после завершения вставки результатов, перед отправкой этого Return. TUI с подавлением дребезга вставки (например, Claude Code) обрабатывает вставку и Return, пришедшие вместе, как один пакет, поэтому Return может быть «проглочен», и проверка так и не будет отправлена; задержка позволяет Return попасть в более позднее чтение, чтобы он отправился. Значение по умолчанию соответствует окну стабилизации вставки Claude Code в 500 мс. Установите 0, чтобы отправлять его немедленно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oneskorenie v sekundách pred klávesom Return, ktorý odošle automaticky odoslanú revíziu kódu.\nKeď panel s nástrojmi pracovnej skupiny revízie kódu automaticky odošle výsledky revízie hlavnej relácii, vloží ich a potom odošle Return na ich potvrdenie. Toto je čas, ktorý po dokončení vloženia čaká pred odoslaním Return. TUI s debouncingom vkladania (napríklad Claude Code) spracuje vloženie a Return, ktoré prídu spolu, ako jednu dávku, takže Return sa môže stratiť a revízia sa neodošle; oneskorením Return dorazí v neskoršom čítaní a odošle sa. Predvolená hodnota zodpovedá 500 ms oknu ustálenia vkladania v Claude Code. Hodnotou 0 sa odošle okamžite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakasnitev v sekundah pred tipko Return, ki odda samodejno poslan pregled kode.\nKo orodna vrstica delovne skupine za pregled kode samodejno pošlje rezultate pregleda glavni seji, jih prilepi in nato pošlje Return za oddajo. To je čas, ki ga počaka po končanem lepljenju rezultatov, preden pošlje ta Return. TUI, ki pri lepljenju združuje vnose (kot Claude Code), obdela lepljenje in Return, ki prispeta skupaj, kot eno celoto, zato se Return lahko izgubi in pregled se nikoli ne odda; zakasnitev poskrbi, da Return pride v poznejšem branju in se odda. Privzeta vrednost ustreza Claude Codovemu 500-ms oknu umiritve lepljenja. Nastavite 0 za takojšnje pošiljanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fördröjning i sekunder före Retur som skickar in en automatiskt skickad kodgranskning.\nNär verktygsfältet för kodgranskningsarbetsgruppen automatiskt skickar granskningsresultat till huvudsessionen klistrar det in resultaten och skickar sedan en Retur för att skicka in dem. Det här är hur länge det väntar, efter att de inklistrade resultaten är klara, innan Retur skickas. Ett TUI som debouncar inklistring (som Claude Code) bearbetar en inklistring och en Retur som kommer samtidigt som en enda omgång, så Retur kan sväljas och granskningen skickas aldrig in; fördröjningen gör att Retur kommer i en senare läsning så att den skickas in. Förvalet motsvarar Claude Codes inklistringsfönster på 500 ms. Ange 0 för att skicka direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik gönderilen kod incelemesini gönderen Return’den önceki gecikme (saniye).\nKod incelemesi çalışma grubu araç çubuğu inceleme sonuçlarını ana oturuma otomatik gönderdiğinde sonuçları yapıştırır ve ardından göndermek için bir Return yollar. Bu, yapıştırılan sonuçlar bittikten sonra o Return’ü göndermeden önce ne kadar bekleneceğidir. Yapıştırmayı geciktiren bir TUI (Claude Code gibi), birlikte gelen bir yapıştırmayı ve Return’ü tek bir toplu iş olarak işler; bu yüzden Return yutulabilir ve inceleme hiç gönderilmez. Gecikme, Return’ün sonraki bir okumaya düşüp gönderilmesini sağlar. Varsayılan, Claude Code’un 500 ms’lik yapıştırma oturma penceresiyle eşleşir. Hemen göndermek için 0 yapın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ trễ (giây) trước khi gửi Return để nộp bản xem xét mã được gửi tự động.\nKhi thanh công cụ nhóm làm việc xem xét mã tự động gửi kết quả xem xét đến phiên chính, nó dán kết quả rồi gửi Return để nộp. Đây là thời gian chờ, sau khi dán xong, trước khi gửi Return đó. Một TUI chống dồn lệnh dán (như Claude Code) xử lý lệnh dán và Return đến cùng lúc như một lô, nên Return có thể bị nuốt và bản xem xét không bao giờ được nộp; độ trễ khiến Return đến ở lần đọc sau để được nộp. Mặc định khớp với khoảng chờ ổn định sau dán 500 ms của Claude Code. Đặt 0 để gửi ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提交自动发送的代码评审的 Return 键的延迟时间（以秒为单位）。\n当代码评审工作区工具栏自动将评审结果发送到主会话时，它会粘贴结果然后发送 Return 键以提交它们。在粘贴结果完成之后，直到发送该 Return 键所经历的等待时间即为延迟时间。像 Claude Code 这样的粘贴缓冲 TUI 会将一起到来的粘贴和 Return 键视为一个批次，因此 Return 键会被忽略，代码评审也不会被提交；此延迟使 Return 键在稍后的读取中提交。默认设置与 Claude Code 的 500 毫秒粘贴等待窗口一致。设置为 0 可立即提交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送出自動傳送之程式碼審查的 Return 前的延遲秒數。\n當程式碼審查工作群組工具列自動將審查結果傳送到主要工作階段時，會貼上結果，然後傳送 Return 以送出。這是貼上的結果完成後，在傳送該 Return 之前等待的時間。具有貼上防抖動的 TUI（例如 Claude Code）會將同時抵達的貼上與 Return 當作同一批處理，因此 Return 可能被吞掉，審查就不會送出；此延遲會讓 Return 在稍後的讀取中抵達而得以送出。預設值與 Claude Code 的 500 毫秒貼上穩定時間相符。設為 0 則立即傳送。"
          }
        }
      }
    },
    "AdvancedSetting.wrapFocus" : {
      "comment" : "Advanced setting: wrapFocus",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má se navigace mezi rozdělenými podokny podle směru zacyklit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal navigation mellem opdelte ruder efter retning fortsætte i den anden ende?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll die Navigation zwischen geteilten Bereichen nach Richtung umlaufen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should split pane navigation by direction wrap around?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe la navegación entre paneles divididos por dirección dar la vuelta al llegar al borde?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiertääkö jaettujen paneelien suuntanavigointi ympäri?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigation entre volets scindés par direction doit-elle boucler ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigazione tra riquadri divisi per direzione deve ricominciare dal lato opposto al raggiungimento del bordo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "方向によるスプリットペインのナビゲーションを循環させますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방향으로 분할 패널을 탐색할 때 끝에서 반대쪽 끝으로 순환하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal navigering mellom delte ruter etter retning gå rundt?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet navigeren tussen gesplitste panelen per richting doorlopen aan de andere kant?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy nawigacja między panelami podzielonymi według kierunku ma zawijać się na krawędzi?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A navegação de painéis divididos por direção deve dar a volta?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли навигация по разделённым панелям в заданном направлении зацикливаться?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má navigácia medzi rozdelenými panelmi podľa smeru pokračovať od opačného okraja?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se navigacija med razdeljenimi podokni po smeri ovije okoli?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ska navigering mellan delade paneler i en riktning fortsätta från andra sidan?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöne göre bölme gezintisi baştan başlayarak devam etsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều hướng khung chia theo hướng có nên quay vòng không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分屏窗格导航是否应支持方向环绕？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依方向導覽分割窗格時是否應循環？"
          }
        }
      }
    },
    "AdvancedSetting.xtermVersion" : {
      "comment" : "Advanced setting: xtermVersion",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze xterm pro sekundární atributy zařízení (SDA).\nZvýšení tohoto čísla zapne více funkcí v aplikacích, ale může něco rozbít. Hodnota 95 obnoví chování před verzí 3.4.10."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-version til sekundære enhedsattributter (SDA).\nHvis tallet øges, aktiveres flere funktioner i apps, men der kan gå noget i stykker. Brug 95 for at få adfærden fra før 3.4.10 tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-Version für Secondary Device Attributes (SDA).\nEine Erhöhung dieser Zahl aktiviert mehr Funktionen in Apps, kann aber Dinge kaputt machen. Verwenden Sie 95, um das Verhalten vor 3.4.10 wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "xterm version for secondary device attributes (SDA).\nIncreasing this number enables more features in apps but may break things. Use 95 to recover pre-3.4.10 behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión de xterm para los atributos de dispositivo secundarios (SDA).\nAumentar este número activa más funciones en las apps pero puede romper cosas. Usa 95 para recuperar el comportamiento anterior a 3.4.10."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-versio toissijaisille laitteen attribuuteille (SDA).\nTämän luvun suurentaminen ottaa käyttöön enemmän ominaisuuksia sovelluksissa, mutta voi rikkoa asioita. Käytä arvoa 95 palauttaaksesi version 3.4.10:tä edeltävän toiminnan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version de xterm pour les attributs d’appareil secondaires (SDA).\nAugmenter ce nombre active davantage de fonctions dans les apps mais peut casser certaines choses. Utilisez 95 pour retrouver le comportement antérieur à la version 3.4.10."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione di xterm per gli attributi secondari del dispositivo (SDA).\nAumentare questo numero abilita più funzioni nelle app ma può causare problemi. Usa 95 per ripristinare il comportamento precedente alla 3.4.10."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セカンダリデバイス属性（SDA）用のxtermバージョン。\nこの数値を増やすとアプリでより多くの機能が有効になりますが、動作が壊れる可能性があります。3.4.10以前の動作に戻すには95を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 장치 속성(SDA)에 대한 xterm 버전\n이 숫자를 늘리면 앱에서 더 많은 기능이 활성화되지만 문제가 생길 수 있습니다. 3.4.10 이전 동작으로 되돌리려면 95를 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-versjon for sekundære enhetsattributter (SDA).\nHvis du øker dette tallet, aktiveres flere funksjoner i apper, men det kan ødelegge ting. Bruk 95 for å gjenopprette oppførselen fra før 3.4.10."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-versie voor secundaire apparaatattributen (SDA).\nHet verhogen van dit getal schakelt meer functies in apps in, maar kan dingen breken. Gebruik 95 om het gedrag van vóór 3.4.10 terug te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersja xterm dla wtórnych atrybutów urządzenia (SDA).\nZwiększenie tej liczby włącza więcej funkcji w aplikacjach, ale może coś zepsuć. Użyj 95, aby przywrócić zachowanie sprzed 3.4.10."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versão do xterm para atributos secundários de dispositivo (SDA).\nAumentar este número ativa mais recursos nos apps, mas pode quebrar coisas. Use 95 para recuperar o comportamento anterior à 3.4.10."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия xterm для вторичных атрибутов устройства (SDA).\nУвеличение этого числа включает больше возможностей в приложениях, но может что-то сломать. Используйте 95, чтобы вернуть поведение, как до версии 3.4.10."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzia xterm pre sekundárne atribúty zariadenia (SDA).\nZvýšenie tohto čísla zapne v aplikáciách viac funkcií, ale môže niečo pokaziť. Hodnotou 95 obnovíte správanie spred verzie 3.4.10."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različica xterm za sekundarne atribute naprave (SDA).\nPovečanje te številke omogoči več funkcij v aplikacijah, a lahko kaj pokvari. Uporabite 95 za povrnitev vedenja pred 3.4.10."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "xterm-version för sekundära enhetsattribut (SDA).\nOm du ökar det här talet aktiveras fler funktioner i appar, men det kan förstöra saker. Använd 95 för att återfå beteendet från före 3.4.10."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkincil aygıt öznitelikleri (SDA) için xterm sürümü.\nBu sayıyı artırmak uygulamalarda daha çok özelliği etkinleştirir ancak bazı şeyleri bozabilir. 3.4.10 öncesi davranışı geri getirmek için 95 kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản xterm cho thuộc tính thiết bị phụ (SDA).\nTăng số này bật thêm tính năng trong ứng dụng nhưng có thể gây hỏng. Dùng 95 để khôi phục hành vi trước 3.4.10."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于辅助设备属性（SDA）的 xterm 版本。\n将此数值增大可启用应用程序中的更多功能，但也可能导致问题。使用 95 可恢复 3.4.10 之前的行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次要裝置屬性（SDA）使用的 xterm 版本。\n增大此數字會在 App 中啟用更多功能，但可能造成問題。使用 95 可回復 3.4.10 之前的行為。"
          }
        }
      }
    },
    "AdvancedSetting.zeroWidthSpaceAdvancesCursor" : {
      "comment" : "Advanced setting: zeroWidthSpaceAdvancesCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posouvá mezera nulové šířky (U+200B) kurzor?\nAčkoli by mezera nulové šířky podle specifikace Unicode neměla kurzor posouvat, Terminal.app i Konsole to dělají a Weechat na tom závisí. Chcete-li změnu tohoto nastavení uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rykker et mellemrum med nul bredde (U+200B) markøren frem?\nSelvom et mellemrum med nul bredde ifølge Unicode-specifikationen ikke bør rykke markøren frem, gør både Terminal.app og Konsole det, og Weechat afhænger af det. Du skal starte iTerm2 igen efter ændring af denne indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückt ein Leerzeichen ohne Breite (Zero-Width Space, U+200B) den Cursor vor?\nObwohl ein Leerzeichen ohne Breite laut Unicode-Spezifikation den Cursor nicht vorrücken sollte, tun dies sowohl Terminal.app als auch Konsole, und Weechat ist darauf angewiesen. Sie müssen iTerm2 nach Ändern dieser Einstellung neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Zero-Width Space (U+200B) advances cursor?\nWhile a zero-width space should not advance the cursor per the Unicode spec, both Terminal.app and Konsole do this, and Weechat depends on it. You must restart iTerm2 after changing this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El espacio de ancho cero (U+200B) avanza el cursor?\nAunque según la especificación Unicode un espacio de ancho cero no debería avanzar el cursor, tanto Terminal.app como Konsole lo hacen, y Weechat depende de ello. Debes reiniciar iTerm2 tras cambiar este ajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirtääkö nollaleveyksinen välilyönti (U+200B) kohdistinta?\nVaikka nollaleveyksisen välilyönnin ei Unicode-määrityksen mukaan pitäisi siirtää kohdistinta, sekä Terminal.app että Konsole tekevät niin, ja Weechat riippuu siitä. Sinun on käynnistettävä iTerm2 uudelleen tämän asetuksen muuttamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace de largeur nulle (U+200B) fait avancer le curseur ?\nBien qu’une espace de largeur nulle ne doive pas faire avancer le curseur selon la spécification Unicode, Terminal.app et Konsole le font tous deux, et Weechat en dépend. Vous devez redémarrer iTerm2 après avoir modifié ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio a larghezza zero (U+200B) fa avanzare il cursore?\nSebbene secondo la specifica Unicode uno spazio a larghezza zero non dovrebbe far avanzare il cursore, sia Terminal.app sia Konsole lo fanno, e Weechat dipende da questo comportamento. Devi riavviare iTerm2 dopo aver modificato questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゼロ幅スペース（U+200B）でカーソルを進めますか？\nUnicode仕様では、ゼロ幅スペースはカーソルを進めるべきではありませんが、Terminal.appとKonsoleはどちらもこれを行い、Weechatはこれに依存しています。この設定を変更した後はiTerm2を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폭 없는 공백(U+200B)에서 커서를 이동하겠습니까?\n유니코드 사양에 따르면 폭 없는 공백은 커서를 이동하지 않아야 하지만, Terminal.app과 Konsole 모두 커서를 이동하며 Weechat이 이 동작에 의존합니다. 이 설정을 변경한 후에는 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter blankt tegn med null bredde (U+200B) markøren?\nSelv om et blankt tegn med null bredde ifølge Unicode-spesifikasjonen ikke skal flytte markøren, gjør både Terminal.app og Konsole det, og Weechat er avhengig av det. Du må starte iTerm2 på nytt etter at du har endret denne innstillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spatie met breedte nul (U+200B) verplaatst de cursor?\nHoewel een spatie met breedte nul volgens de Unicode-specificatie de cursor niet zou moeten verplaatsen, doen zowel Terminal.app als Konsole dat wel, en Weechat is ervan afhankelijk. Je moet iTerm2 herstarten na het wijzigen van deze instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy spacja o zerowej szerokości (U+200B) przesuwa kursor?\nChoć według specyfikacji Unicode spacja o zerowej szerokości nie powinna przesuwać kursora, robią to zarówno Terminal.app, jak i Konsole, a Weechat na tym polega. Po zmianie tego ustawienia musisz uruchomić ponownie iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço de largura zero (U+200B) avança o cursor?\nEmbora um espaço de largura zero não deva avançar o cursor conforme a especificação Unicode, tanto o Terminal.app quanto o Konsole fazem isso, e o Weechat depende disso. Você deve reiniciar o iTerm2 após alterar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продвигать курсор при вводе пробела нулевой ширины (U+200B)?\nХотя по спецификации Unicode пробел нулевой ширины не должен продвигать курсор, и Terminal.app, и Konsole делают это, а Weechat на это полагается. После изменения этого параметра перезапустите iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posúva medzera nulovej šírky (U+200B) kurzor?\nHoci by medzera nulovej šírky podľa špecifikácie Unicode nemala posúvať kurzor, Terminal.app aj Konsole to robia a Weechat na tom závisí. Po zmene tohto nastavenia musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj presledek ničelne širine (U+200B) premakne kazalec?\nČeprav po specifikaciji Unicode presledek ničelne širine ne bi smel premakniti kazalca, to počneta Terminal.app in Konsole, Weechat pa je od tega odvisen. Po spremembi te nastavitve morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar mellanslag med nollbredd (U+200B) fram markören?\nEtt mellanslag med nollbredd ska enligt Unicode-specifikationen inte flytta fram markören, men både Terminal.app och Konsole gör det, och Weechat är beroende av det. Du måste starta om iTerm2 efter att ha ändrat den här inställningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıfır Genişlikli Boşluk (U+200B) imleci ilerletsin mi?\nUnicode belirtimine göre sıfır genişlikli bir boşluk imleci ilerletmemelidir, ancak hem Terminal.app hem Konsole bunu yapar ve Weechat buna bağlıdır. Bu ayarı değiştirdikten sonra iTerm2’yi yeniden başlatmanız gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng trắng độ rộng bằng không (U+200B) làm con trỏ tiến lên?\nTheo đặc tả Unicode, khoảng trắng độ rộng bằng không không nên làm con trỏ tiến lên, nhưng cả Terminal.app và Konsole đều làm vậy, và Weechat phụ thuộc vào điều đó. Bạn phải khởi động lại iTerm2 sau khi thay đổi cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零宽度空格（U+200B）是否推进光标？\n虽然根据 Unicode 标准，零宽度空格不应推进光标，但 Terminal.app 和 Konsole 会这样做，Weechat 也依赖此行为。更改此设置后必须重启 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "零寬度空格（U+200B）會使游標前進？\n依照 Unicode 規範，零寬度空格不應使游標前進，但 Terminal.app 和 Konsole 都會這樣做，Weechat 也依賴此行為。變更此設定後必須重新啟動 iTerm2。"
          }
        }
      }
    },
    "AdvancedSetting.zippyTextDrawing" : {
      "comment" : "Advanced setting: zippyTextDrawing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít rychlý algoritmus kreslení textu?\nKreslí text mimo ASCII rychleji, ale s nižší věrností. Toto nastavení se ignoruje, pokud jsou zapnuté ligatury v „Nastavení > Profily > Text“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug den hurtige algoritme til tekstegning?\nDen tegner ikke-ASCII-tekst hurtigere, men med lavere troværdighed. Denne indstilling ignoreres, hvis ligaturer er slået til i Indstillinger > Profiler > Tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellen Textzeichenalgorithmus verwenden?\nDies zeichnet Nicht-ASCII-Text schneller, aber mit geringerer Genauigkeit. Diese Einstellung wird ignoriert, wenn in Einstellungen > Profile > Text Ligaturen aktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use zippy text drawing algorithm?\nThis draws non-ASCII text more quickly but with lower fidelity. This setting is ignored if ligatures are enabled in Settings > Profiles > Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar el algoritmo de dibujo de texto rápido?\nDibuja el texto no ASCII más deprisa pero con menor fidelidad. Este ajuste se ignora si las ligaduras están activadas en Ajustes > Perfiles > Texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetäänkö nopeaa tekstinpiirtoalgoritmia?\nTämä piirtää ei-ASCII-tekstin nopeammin mutta heikommalla tarkkuudella. Tämä asetus ohitetaan, jos ligatuurit ovat käytössä kohdassa Asetukset > Profiilit > Teksti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser l’algorithme de dessin de texte rapide (zippy) ?\nCela dessine le texte non ASCII plus rapidement mais avec une moindre fidélité. Ce réglage est ignoré si les ligatures sont activées dans Réglages > Profils > Texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare l’algoritmo di disegno veloce del testo?\nDisegna il testo non ASCII più rapidamente ma con minore fedeltà. Questa impostazione viene ignorata se le legature sono abilitate in Impostazioni > Profili > Testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速テキスト描画アルゴリズムを使用しますか？\nこれにより非ASCIIテキストがより速く描画されますが、精度は下がります。「設定 > プロファイル > テキスト」で合字が有効になっている場合、この設定は無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 텍스트 그리기 알고리즘을 사용하겠습니까?\n비ASCII 텍스트를 더 빠르게 그리지만 정확도는 떨어집니다. 설정 > 프로파일 > 텍스트에서 합자가 켜져 있으면 이 설정은 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk den raske tegnealgoritmen for tekst?\nDette tegner ikke-ASCII-tekst raskere, men med lavere nøyaktighet. Innstillingen ignoreres hvis ligaturer er aktivert i «Innstillinger > Profiler > Tekst»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het snelle algoritme voor tekstweergave gebruiken?\nDit tekent niet-ASCII-tekst sneller maar met lagere kwaliteit. Deze instelling wordt genegeerd als ligaturen zijn ingeschakeld in Instellingen > Profielen > Tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy używać szybkiego algorytmu rysowania tekstu?\nRysuje tekst spoza ASCII szybciej, ale z mniejszą wiernością. To ustawienie jest ignorowane, jeśli ligatury są włączone w Ustawienia > Profile > Tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar o algoritmo de desenho de texto rápido?\nIsso desenha texto não ASCII mais rapidamente, mas com menor fidelidade. Este ajuste é ignorado se as ligaduras estiverem ativadas em Ajustes > Perfis > Texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать быстрый (zippy) алгоритм отрисовки текста?\nОн отрисовывает не-ASCII текст быстрее, но с меньшей точностью. Этот параметр игнорируется, если в разделе Настройки > Профили > Текст включены лигатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použiť rýchly algoritmus kreslenia textu?\nText mimo ASCII sa kreslí rýchlejšie, ale s nižšou vernosťou. Toto nastavenie sa ignoruje, ak sú v časti „Nastavenia > Profily > Text“ zapnuté ligatúry."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se uporabi živahen algoritem za risanje besedila?\nTo hitreje nariše besedilo, ki ni ASCII, a z manjšo zvestobo. Ta nastavitev se prezre, če so ligature omogočene v »Nastavitve > Profili > Besedilo«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använda den snabba algoritmen för textritning?\nDen ritar icke-ASCII-text snabbare men med lägre kvalitet. Den här inställningen ignoreras om ligaturer är aktiverade i Inställningar > Profiler > Text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı metin çizim algoritması kullanılsın mı?\nBu, ASCII olmayan metni daha hızlı ancak daha düşük aslına uygunlukla çizer. Ayarlar > Profiller > Metin bölümünde bitişik harfler etkinse bu ayar yok sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng thuật toán vẽ văn bản zippy?\nVẽ văn bản không phải ASCII nhanh hơn nhưng độ trung thực thấp hơn. Cài đặt này bị bỏ qua nếu chữ ghép được bật trong Cài đặt > Hồ sơ > Văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 zippy 文本绘制算法？\n此算法可更快速绘制非 ASCII 文本，但保真度较低。若在设置 > 配置文件 > 文本中启用了连字，此设置将被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 zippy 文字繪製演算法？\n這會更快地繪製非 ASCII 文字，但保真度較低。如果在「設定 > 描述檔 > 文字」中啟用了連字，則會忽略此設定。"
          }
        }
      }
    },
