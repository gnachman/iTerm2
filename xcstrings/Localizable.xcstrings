    },
    "AdvancedSetting.screenshotMaxPixelHeight" : {
      "comment" : "Advanced setting: screenshotMaxPixelHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální výška jednoho souboru snímku obrazovky v pixelech.\nVyšší snímky obrazovky se rozdělí do více souborů. Ovlivňuje také maximální celkový počet pixelů (tato hodnota na druhou / 5)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal højde i pixel for ét skærmbilledearkiv.\nSkærmbilleder, der er højere end dette, deles op i flere arkiver. Påvirker også det maksimale samlede antal pixel (denne værdi i anden / 5)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Pixelhöhe für eine einzelne Screenshot-Datei.\nScreenshots, die höher sind, werden auf mehrere Dateien aufgeteilt. Beeinflusst auch die maximale Gesamtpixelzahl (dieser Wert zum Quadrat / 5)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum pixel height for a single screenshot file.\nScreenshots taller than this will be split into multiple files. Also affects the maximum total pixels (this value squared / 5)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima en píxeles de un único archivo de captura de pantalla.\nLas capturas más altas se dividirán en varios archivos. También afecta al total máximo de píxeles (este valor al cuadrado / 5)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäisen kuvakaappaustiedoston enimmäiskorkeus kuvapisteinä.\nTätä korkeammat kuvakaappaukset jaetaan useaan tiedostoon. Vaikuttaa myös kuvapisteiden kokonaismäärän enimmäisarvoon (tämä arvo toiseen / 5)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur maximale en pixels d’un fichier de capture d’écran.\nLes captures plus hautes seront scindées en plusieurs fichiers. Affecte aussi le nombre total maximal de pixels (cette valeur au carré / 5)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza massima in pixel di un singolo file di istantanea.\nLe istantanee più alte verranno divise in più file. Influisce anche sul totale massimo di pixel (questo valore al quadrato / 5)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショット1ファイルあたりの最大ピクセル高。\nこれより高いスクリーンショットは複数のファイルに分割されます。最大合計ピクセル数（この値の2乗を5で割った値）にも影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단일 스크린샷 파일의 최대 픽셀 높이.\n이보다 높은 스크린샷은 여러 파일로 분할됩니다. 최대 총 픽셀 수(이 값의 제곱 / 5)에도 영향을 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal pikselhøyde for én skjermbildefil.\nSkjermbilder som er høyere enn dette, deles i flere filer. Påvirker også maksimalt totalt antall piksler (denne verdien i andre / 5)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale hoogte in pixels voor één schermafbeeldingsbestand.\nHogere schermafbeeldingen worden over meerdere bestanden verdeeld. Beïnvloedt ook het maximale totale aantal pixels (deze waarde in het kwadraat / 5)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna wysokość w pikselach pojedynczego pliku zrzutu ekranu.\nWyższe zrzuty ekranu zostaną podzielone na wiele plików. Wpływa też na maksymalną łączną liczbę pikseli (ta wartość do kwadratu / 5)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima em pixels para um único arquivo de captura de tela.\nCapturas de tela mais altas que isto serão divididas em múltiplos arquivos. Também afeta o total máximo de pixels (este valor ao quadrado / 5)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная высота в пикселях для одного файла скриншота.\nСкриншоты выше этого значения будут разделены на несколько файлов. Также влияет на максимальное общее число пикселей (это значение в квадрате, делённое на 5)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximálna výška jedného súboru so snímkou obrazovky v pixeloch.\nSnímky obrazovky vyššie ako táto hodnota sa rozdelia do viacerých súborov. Ovplyvňuje aj maximálny celkový počet pixelov (táto hodnota na druhú / 5)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največja višina v slikovnih pikah za posamezno datoteko posnetka zaslona.\nVišji posnetki se razdelijo na več datotek. Vpliva tudi na največje skupno število slikovnih pik (ta vrednost na kvadrat / 5)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högsta pixelhöjd för en enskild skärmbildsfil.\nSkärmbilder som är högre än så delas upp i flera filer. Påverkar också högsta totala antal pixlar (det här värdet i kvadrat / 5)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir ekran görüntüsü dosyası için azami piksel yüksekliği.\nBundan yüksek ekran görüntüleri birden çok dosyaya bölünür. Ayrıca azami toplam pikseli de etkiler (bu değerin karesi / 5)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều cao pixel tối đa của một tệp ảnh chụp màn hình.\nẢnh chụp cao hơn mức này sẽ được tách thành nhiều tệp. Cũng ảnh hưởng đến tổng số pixel tối đa (giá trị này bình phương / 5)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单个截图文件的最大像素高度。  \n高于此高度的截图将拆分为多个文件。也影响最大总像素数（该值的平方除以5）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一螢幕截圖檔案的最大像素高度。\n高度超過此值的螢幕截圖會被分割成多個檔案。這也會影響總像素數上限（此值的平方除以 5）。"
          }
        }
      }
    },
    "AdvancedSetting.screenshotSaveLocation" : {
      "comment" : "Advanced setting: screenshotSaveLocation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složka, do které tlačítko „Uložit“ v okně snímku obrazovky zapisuje soubory.\nPonechte prázdné pro uložení na plochu. Tlačítko „Uložit jako…“ to ignoruje a vždy se zeptá na umístění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappe, hvor knappen “Gem” i skærmbillevinduet skriver arkiver.\nLad den være tom for at gemme på skrivebordet. Knappen “Gem som…” ignorerer dette og spørger altid om en placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner, in den die Schaltfläche „Sichern“ im Screenshot-Fenster Dateien schreibt.\nLeer lassen, um auf dem Schreibtisch zu sichern. Die Schaltfläche „Sichern unter…“ ignoriert dies und fragt immer nach einem Speicherort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder where the “Save” button in the screenshot window writes files.\nLeave empty to save to the Desktop. The “Save As…” button ignores this and always prompts for a location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta donde escribe los archivos el botón “Guardar” de la ventana de captura de pantalla.\nDéjala vacía para guardar en el Escritorio. El botón “Guardar como…” la ignora y siempre pide una ubicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansio, johon kuvakaappausikkunan ”Tallenna”-painike kirjoittaa tiedostot.\nJätä tyhjäksi tallentaaksesi työpöydälle. ”Tallenna nimellä…” -painike ohittaa tämän ja kysyy aina sijaintia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier où le bouton « Enregistrer » de la fenêtre de capture d’écran écrit les fichiers.\nLaissez vide pour enregistrer sur le bureau. Le bouton « Enregistrer sous… » l’ignore et demande toujours un emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella in cui il pulsante “Salva” della finestra dell’istantanea scrive i file.\nLascia vuoto per salvare sulla scrivania. Il pulsante “Salva come…” la ignora e chiede sempre una posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットウィンドウの「保存」ボタンがファイルを書き込むフォルダ。\n空欄の場合はデスクトップに保存されます。「名前を付けて保存…」ボタンはこの設定を無視し、常に保存場所を尋ねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷 윈도우의 “저장” 버튼이 파일을 저장하는 폴더\n비워 두면 데스크탑에 저장됩니다. “다른 이름으로 저장…” 버튼은 이 설정을 무시하고 항상 위치를 묻습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappe der knappen «Lagre» i skjermbildevinduet skriver filer.\nLa stå tom for å lagre på skrivebordet. Knappen «Lagre som…» ignorerer dette og spør alltid om plassering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Map waarin de knop ‘Bewaar’ in het venster voor schermafbeeldingen bestanden schrijft.\nLaat leeg om op het bureaublad te bewaren. De knop ‘Bewaar als…’ negeert dit en vraagt altijd om een locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder, do którego przycisk „Zachowaj” w oknie zrzutu ekranu zapisuje pliki.\nPozostaw puste, aby zapisywać na biurku. Przycisk „Zachowaj jako…” ignoruje to i zawsze pyta o lokalizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta onde o botão “Salvar” na janela de captura de tela grava os arquivos.\nDeixe vazio para salvar na Mesa. O botão “Salvar como…” ignora isto e sempre solicita um local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, в которую кнопка «Сохранить» в окне скриншота записывает файлы.\nОставьте пустым, чтобы сохранять на рабочий стол. Кнопка «Сохранить как…» игнорирует этот параметр и всегда запрашивает расположение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priečinok, do ktorého tlačidlo „Uložiť“ v okne snímky obrazovky zapisuje súbory.\nAk ho ponecháte prázdny, uloží sa na plochu. Tlačidlo „Uložiť ako…“ to ignoruje a vždy sa opýta na umiestnenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa, v katero gumb »Shrani« v oknu posnetka zaslona zapiše datoteke.\nPustite prazno za shranjevanje na namizje. Gumb »Shrani kot …« to prezre in vedno vpraša za lokacijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapp där knappen ”Spara” i skärmbildsfönstret skriver filer.\nLämna tomt för att spara på skrivbordet. Knappen ”Spara som…” ignorerar det här och frågar alltid efter en plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntüsü penceresindeki “Kaydet” düğmesinin dosyaları yazdığı klasör.\nMasaüstü’ne kaydetmek için boş bırakın. “Farklı Kaydet…” düğmesi bunu yok sayar ve her zaman konum sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục nơi nút “Lưu” trong cửa sổ ảnh chụp màn hình ghi tệp.\nĐể trống để lưu vào màn hình nền. Nút “Lưu thành…” bỏ qua cài đặt này và luôn hỏi vị trí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图窗口中“保存”按钮写入文件的文件夹。  \n留空则保存到桌面。“另存为…”按钮忽略此设置，始终会提示位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖視窗中「儲存」按鈕寫入檔案的檔案夾。\n留空則儲存到桌面。「儲存為…」按鈕會忽略此設定，並一律詢問位置。"
          }
        }
      }
    },
    "AdvancedSetting.scrollWheelAcceleration" : {
      "comment" : "Advanced setting: scrollWheelAcceleration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrychlit gesta posouvání tímto činitelem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør rullebevægelser hurtigere med denne faktor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scroll-Gesten um diesen Faktor beschleunigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Speed up scroll gestures by this factor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelera los gestos de desplazamiento por este factor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeuta vieritysliikkeitä tällä kertoimella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accélérer les gestes de défilement selon ce facteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accelera i gesti di scorrimento di questo fattore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロールジェスチャーの速度をこの倍率で加速する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 제스처의 속도를 이 배율만큼 높입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øk hastigheten på rullebevegelser med denne faktoren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versnel scrollgebaren met deze factor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyspiesz gesty przewijania o ten współczynnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acelerar os gestos de rolagem por este fator."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускорять жесты прокрутки в указанное число раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrýchliť gestá rolovania týmto faktorom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pospeši poteze pomikanja za ta faktor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabba upp rullningsgester med den här faktorn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırma hareketlerini bu çarpanla hızlandır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng tốc cử chỉ cuộn theo hệ số này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动手势的加速倍数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以此倍數加快捲動手勢的速度。"
          }
        }
      }
    },
    "AdvancedSetting.scrollableTabWidth" : {
      "comment" : "Advanced setting: scrollableTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šířka panelu, když je řádek panelů posouvatelný.\nPoužívá se jako pevná šířka, když mají panely stejnou velikost, a jako minimální šířka, když jsou povoleny nestejné šířky panelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanebredde, når fanelinjen kan rulles.\nBruges som fast bredde, når faner har samme størrelse, og som mindste bredde, når ujævne fanebredder er tilladt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab-Breite, wenn die Tableiste scrollbar ist.\nWird als feste Breite verwendet, wenn Tabs gleich groß sind, und als Mindestbreite, wenn ungleichmäßige Tab-Breiten zulässig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab width when the tab bar is scrollable.\nUsed as the fixed width when tabs are equally sized, and as the minimum width when uneven tab widths are allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancho de pestaña cuando la barra de pestañas es desplazable.\nSe usa como ancho fijo cuando las pestañas tienen el mismo tamaño, y como ancho mínimo cuando se permiten anchos desiguales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välilehden leveys, kun välilehtipalkki on vieritettävä.\nKäytetään kiinteänä leveytenä, kun välilehdet ovat yhtä suuret, ja vähimmäisleveytenä, kun epätasaiset leveydet sallitaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largeur des onglets lorsque la barre d’onglets est défilante.\nUtilisée comme largeur fixe lorsque les onglets ont la même taille, et comme largeur minimale lorsque des largeurs inégales sont autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larghezza dei pannelli quando la barra dei pannelli è scorrevole.\nViene usata come larghezza fissa quando i pannelli hanno la stessa dimensione e come larghezza minima quando sono consentite larghezze irregolari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーがスクロール可能なときのタブ幅。\nタブが均等なサイズのときは固定幅として、不均一なタブ幅が許可されている場合は最小幅として使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대를 스크롤할 수 있을 때의 탭 너비.\n탭 크기가 모두 같을 때는 고정 너비로, 탭 너비가 달라도 될 때는 최소 너비로 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanebredde når fanelinjen kan rulles.\nBrukes som fast bredde når alle faner har lik størrelse, og som minstebredde når ujevn fanebredde er tillatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbladbreedte wanneer de tabbladbalk scrolbaar is.\nWordt gebruikt als vaste breedte wanneer tabbladen even breed zijn en als minimale breedte wanneer ongelijke tabbladbreedtes zijn toegestaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerokość karty, gdy pasek kart jest przewijany.\nUżywana jako stała szerokość, gdy karty mają równy rozmiar, i jako minimalna szerokość, gdy dozwolone są nierówne szerokości kart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura da aba quando a barra de abas é rolável.\nUsada como a largura fixa quando as abas têm o mesmo tamanho, e como a largura mínima quando larguras de abas desiguais são permitidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина вкладки, когда панель вкладок прокручиваемая.\nИспользуется как фиксированная ширина, когда все вкладки одинакового размера, и как минимальная ширина, когда допускается неравная ширина вкладок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šírka tabu, keď je lišta s tabmi rolovateľná.\nPoužije sa ako pevná šírka, keď majú všetky taby rovnakú veľkosť, a ako minimálna šírka, keď sú povolené nerovnomerné šírky tabov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Širina zavihka, ko se vrstica z zavihki lahko pomika.\nUporablja se kot stalna širina, ko so zavihki enako veliki, in kot najmanjša širina, ko so dovoljene neenake širine zavihkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flikbredd när flikfältet är rullningsbart.\nAnvänds som fast bredd när flikarna är lika stora och som minsta bredd när ojämna flikbredder tillåts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğu kaydırılabilirken sekme genişliği.\nSekmeler eşit boyutluyken sabit genişlik, eşit olmayan genişliklere izin verildiğinde ise asgari genişlik olarak kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiều rộng tab khi thanh tab có thể cuộn.\nĐược dùng làm chiều rộng cố định khi các tab có kích thước bằng nhau, và làm chiều rộng tối thiểu khi cho phép chiều rộng tab không đều."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页栏可滚动时的标签宽度。  \n作为等宽标签的固定宽度，以及非等宽标签的最小宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁列可捲動時的標籤頁寬度。\n標籤頁大小一致時作為固定寬度，允許標籤頁寬度不一致時則作為最小寬度。"
          }
        }
      }
    },
    "AdvancedSetting.searchCommand" : {
      "comment" : "Advanced setting: searchCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šablona URL vyhledávače.\niTerm2 nahradí řetězec „%@“ hledaným textem. Použije se procentové kódování parametrů dotazu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skabelon for søgemaskinens URL.\niTerm2 erstatter strengen “%@” med den tekst, der søges efter. Procentkodning af forespørgselsparametre bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlage für die URL der Suchmaschine.\niTerm2 ersetzt den String „%@“ durch den gesuchten Text. Dabei wird Prozent-Escaping für Abfrageparameter verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Template for URL of search engine.\niTerm2 replaces the string “%@” with the text to search for. Query parameter percent escaping is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantilla de la URL del motor de búsqueda.\niTerm2 sustituye la cadena “%@” por el texto que se busca. Se usa el escape con porcentaje de parámetros de consulta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakukoneen URL-mallipohja.\niTerm2 korvaa merkkijonon ”%@” haettavalla tekstillä. Kyselyparametreissa käytetään prosenttimerkkikoodausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle d’URL du moteur de recherche.\niTerm2 remplace la chaîne « %@ » par le texte à rechercher. L’échappement par pourcentage des paramètres de requête est utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modello dell’URL del motore di ricerca.\niTerm2 sostituisce la stringa “%@” con il testo da cercare. Viene usata la codifica percentuale dei parametri di query."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索エンジンのURLテンプレート。\niTerm2は文字列「%@」を検索対象のテキストに置き換えます。クエリパラメータのパーセントエスケープが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 엔진 URL 템플릿\niTerm2는 문자열 “%@”을(를) 검색할 텍스트로 대치합니다. 쿼리 매개변수 퍼센트 이스케이프가 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mal for URL-en til søkemotoren.\niTerm2 erstatter strengen «%@» med teksten det skal søkes etter. Prosentkoding for spørringsparametere brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjabloon voor de URL van de zoekmachine.\niTerm2 vervangt de tekenreeks ‘%@’ door de tekst waarnaar wordt gezocht. Procentcodering voor queryparameters wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szablon URL-a wyszukiwarki.\niTerm2 zastępuje ciąg „%@” szukanym tekstem. Używane jest kodowanie procentowe parametrów zapytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo para a URL do mecanismo de busca.\nO iTerm2 substitui a string “%@” pelo texto a buscar. É usado o escape de porcentagem para parâmetros de consulta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблон URL-адреса поисковой системы.\niTerm2 заменяет строку «%@» на текст для поиска. Используется процентное экранирование параметра запроса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šablóna URL vyhľadávača.\niTerm2 nahradí reťazec „%@“ hľadaným textom. Použije sa percentové kódovanie parametrov dopytu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predloga za URL iskalnika.\niTerm2 niz »%@« zamenja z besedilom za iskanje. Uporabljeno je odstotkovno kodiranje parametrov poizvedbe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mall för sökmotorns URL.\niTerm2 ersätter strängen ”%@” med texten som ska sökas efter. Procentkodning av frågeparametrar används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama motoru URL’si için şablon.\niTerm2, “%@” dizesini aranacak metinle değiştirir. Sorgu parametresi yüzde kaçışı kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mẫu URL của công cụ tìm kiếm.\niTerm2 thay chuỗi “%@” bằng văn bản cần tìm. Dùng mã hóa phần trăm cho tham số truy vấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索引擎URL的模板。  \niTerm2将字符串“%@”替换为搜索文本，使用查询参数百分比转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋引擎 URL 的範本。\niTerm2 會將字串「%@」取代為要搜尋的文字。使用查詢參數百分比跳脫。"
          }
        }
      }
    },
