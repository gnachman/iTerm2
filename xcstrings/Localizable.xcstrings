    "AdvancedSetting.badgeRightMargin" : {
      "comment" : "Advanced setting: badgeRightMargin",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardwert für den rechten Rand des Badges\nWie viel Platz zwischen dem rechten Rand des Badges und dem rechten Rand des Terminals gelassen werden soll. Kann durch eine Profileinstellung überschrieben werden. Dies ist der Standardwert, wenn ein Profil keine Einstellung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default value for right margin for the badge\nHow much space to leave between the right edge of the badge and the right edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor predeterminado del margen derecho de la insignia\nCuánto espacio dejar entre el borde derecho de la insignia y el borde derecho de la terminal. Un ajuste del perfil puede anularlo. Es el valor predeterminado si un perfil no tiene este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur par défaut de la marge droite du badge\nEspace à laisser entre le bord droit du badge et le bord droit du terminal. Peut être remplacée par un réglage de profil. C’est la valeur par défaut si un profil n’a pas de réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valore predefinito del margine destro del badge\nQuanto spazio lasciare tra il bordo destro del badge e il bordo destro del terminale. Può essere sostituito da un’impostazione del profilo. È il valore predefinito se un profilo non ha un’impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジの右マージンのデフォルト値\nバッジの右端とターミナルの右端の間に空ける余白の量です。プロファイルの設定で上書きできます。プロファイルに設定がない場合のデフォルト値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배지 오른쪽 여백의 기본값\n배지 오른쪽 가장자리와 터미널 오른쪽 가장자리 사이에 둘 공간입니다. 프로파일 설정으로 재정의할 수 있습니다. 프로파일에 설정이 없을 때 사용되는 기본값입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor padrão para a margem direita do selo\nQuanto espaço deixar entre a borda direita do selo e a borda direita do terminal. Pode ser substituído por um ajuste de perfil. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение по умолчанию для правого отступа плашки\nКакое расстояние оставлять между правым краем плашки и правым краем терминала. Может быть переопределено настройкой профиля. Это значение по умолчанию, если оно не задано в профиле."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozet için varsayılan sağ kenar boşluğu\nRozetin sağ kenarı ile terminalin sağ kenarı arasında ne kadar boşluk bırakılacağı. Bir profil ayarıyla geçersiz kılınabilir. Bir profilde ayar yoksa varsayılan değer budur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角标右边缘的默认间距\n即角标与终端右侧边缘之间的空间距离。可通过配置文件设置调整，若配置文件未设置，则采用此默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標記牌右邊界的預設值\n標記牌右緣與終端機右緣之間要保留多少空間。可由描述檔設定覆寫。描述檔未設定時，會使用此預設值。"
          }
        }
      }
    },
