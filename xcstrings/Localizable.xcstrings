    "ClaudeCode.HookRemovalFailedBody" : {
      "comment" : "Body shown when hook removal failed, asking whether to continue uninstalling",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sollen die Arbeitsgruppe und die Trigger trotzdem entfernt werden? Der Status-Hook von iTerm2 läuft weiter, bis Sie das zugrunde liegende Problem beheben und es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ Continue removing the workgroup and triggers anyway? iTerm2’s status hook will keep running until you fix the underlying issue and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ¿Quieres continuar de todos modos con la eliminación del grupo de trabajo y los disparadores? El hook de estado de iTerm2 seguirá ejecutándose hasta que soluciones el problema de fondo y vuelvas a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Continuer quand même la suppression du groupe de travail et des déclencheurs ? Le hook d’état d’iTerm2 continuera de s’exécuter jusqu’à ce que vous corrigiez le problème sous-jacent et réessayiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vuoi comunque continuare a rimuovere il gruppo di lavoro e gli attivatori? L’hook di stato di iTerm2 continuerà a funzionare finché non risolvi il problema di fondo e riprovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ それでもワークグループとトリガーの削除を続けますか？根本的な問題を修正して再試行するまで、iTerm2のステータスフックは動作し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 그래도 워크그룹과 트리거 제거를 계속하겠습니까? 근본적인 문제를 해결하고 다시 시도할 때까지 iTerm2의 상태 훅은 계속 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Continuar removendo o grupo de trabalho e os gatilhos mesmo assim? O hook de status do iTerm2 continuará em execução até você corrigir o problema subjacente e tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Всё равно продолжить удаление рабочей группы и триггеров? Хук статуса iTerm2 будет продолжать работать, пока вы не устраните проблему и не повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Yine de çalışma grubunu ve tetikleyicileri kaldırmaya devam edilsin mi? iTerm2’nin durum kancası, altta yatan sorunu giderip yeniden deneyene kadar çalışmaya devam edecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 仍要继续移除工作组和触发器吗？在你修复根本问题并重试之前，iTerm2 的状态钩子将继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 仍要繼續移除工作群組和觸發器嗎？在你修正根本問題並重試之前，iTerm2 的狀態 hook 將持續執行。"
          }
        }
      }
    },
