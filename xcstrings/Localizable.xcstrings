    "TipController.PermissionInformative" : {
      "comment" : "Explanatory text for the alert asking permission to show Tip of the Day messages.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann Ihnen eine Nachricht mit dem Tipp des Tages anzeigen, damit Sie die vielen Funktionen kennenlernen. Möchten Sie das?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can show you a Tip of the Day message to help you learn about its many features. Are you interested?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、多くの機能について学べる「今日のヒント」メッセージを表示できます。表示してみますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 다양한 기능을 익힐 수 있도록 오늘의 팁 메시지를 보여 줄 수 있습니다. 관심이 있습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode mostrar uma mensagem de Dica do Dia para ajudar você a conhecer seus muitos recursos. Você tem interesse?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может показывать вам сообщения «Совет дня», чтобы помочь вам узнать о его многочисленных возможностях. Хотите включить эту функцию?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以向你显示“每日提示”消息，帮助你了解其众多功能。你有兴趣吗？"
          }
        }
      }
