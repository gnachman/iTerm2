    "SecureUserDefaults.CreateFolderPrompt" : {
      "comment" : "Authorization prompt shown when iTerm2 needs privileges to create the fallback secure-settings folder; %@ is the folder path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 muss %@ erstellen, um sichere Einstellungen zu speichern, da sich Ihr Home-Verzeichnis auf einem Netzwerkdateisystem befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 needs to create %@ to store secure settings because your home directory is on a network file system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 necesita crear %@ para almacenar los ajustes seguros porque tu directorio de inicio está en un sistema de archivos de red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 doit créer %@ pour stocker les réglages sécurisés, car votre répertoire de départ se trouve sur un système de fichiers réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 deve creare %@ per salvare le impostazioni sicure perché la tua cartella Inizio si trova su un file system di rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームディレクトリがネットワークファイルシステム上にあるため、iTerm2はセキュア設定を保存するために%@を作成する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 디렉토리가 네트워크 파일 시스템에 있으므로 iTerm2가 보안 설정을 저장하기 위해 %@을(를) 생성해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 precisa criar %@ para armazenar ajustes seguros porque seu diretório home está em um sistema de arquivos de rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 необходимо создать %@ для хранения безопасных настроек, поскольку домашняя папка находится на сетевой файловой системе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana dizininiz bir ağ dosya sisteminde olduğundan, güvenli ayarları saklamak için iTerm2’nin %@ klasörünü oluşturması gerekiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于您的主目录位于网络文件系统上，iTerm2需要创建%@以存储安全设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於你的個人專屬目錄位於網路檔案系統上，iTerm2 需要建立 %@ 來儲存安全設定。"
          }
        }
      }
    },
