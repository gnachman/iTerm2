    "AdvancedSetting.NoSyncSuppressRestartSessionConfirmationAlert" : {
      "comment" : "Advanced setting: NoSyncSuppressRestartSessionConfirmationAlert",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat potvrzení restartu relace.\nPři ručním restartu relace nežádat o potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul advarslen om bekræftelse af ny start af session.\nBed ikke om bekræftelse, når en session startes igen manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigungsdialog zum Neustart einer Sitzung unterdrücken.\nBeim manuellen Neustart einer Sitzung nicht um Bestätigung bitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress restart session confirmation alert.\nDon't ask for a confirmation when manually restarting a session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir la alerta de confirmación al reiniciar sesión.\nNo pedir confirmación al reiniciar manualmente una sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä näytä istunnon uudelleenkäynnistyksen vahvistusvaroitusta.\nÄlä kysy vahvistusta, kun istunto käynnistetään uudelleen käsin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’alerte de confirmation du redémarrage de session.\nNe pas demander de confirmation lors du redémarrage manuel d’une session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso di conferma del riavvio della sessione.\nNon chiedere conferma quando si riavvia manualmente una sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション再起動の確認アラートを抑制する。\nセッションを手動で再起動する際に確認を求めない。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 재시작 확인 경고 표시 안 함.\n세션을 직접 재시작할 때 확인을 묻지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis bekreftelsesvarselet ved omstart av økt.\nIkke be om bekreftelse når en økt startes på nytt manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk bevestigingsmelding bij herstarten van sessie.\nVraag niet om bevestiging wanneer je een sessie handmatig herstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń alert potwierdzenia ponownego uruchomienia sesji.\nNie pytaj o potwierdzenie przy ręcznym ponownym uruchamianiu sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir alerta de confirmação de reinício de sessão.\nNão pedir confirmação ao reiniciar manualmente uma sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение о перезапуске сессии.\nНе запрашивать подтверждение при ручном перезапуске сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať upozornenie na potvrdenie reštartu relácie.\nNepýtať sa na potvrdenie pri ručnom reštartovaní relácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži opozorila s potrditvijo ob ponovnem zagonu seje.\nNe zahtevaj potrditve ob ročnem ponovnem zagonu seje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa inte bekräftelsevarningen vid omstart av session.\nFråga inte om bekräftelse när en session startas om manuellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu yeniden başlatma onay uyarısını gizle.\nBir oturumu elle yeniden başlatırken onay isteme."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị lại cảnh báo xác nhận khởi động lại phiên.\nKhông hỏi xác nhận khi khởi động lại phiên theo cách thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏会话的重启确认提示。\n手动重启会话时无需请求确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不顯示重新啟動工作階段的確認警示。\n手動重新啟動工作階段時不要求確認。"
          }
        }
      }
    },
    "AdvancedSetting.URLCharacterSet" : {
      "comment" : "Advanced setting: URLCharacterSet",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nealfanumerické znaky považované v sémantické historii za součást URL nebo názvu souboru.\nPísmena a číslice se vždy považují za součást URL. Tyto nealfanumerické znaky se navíc používají ke zjištění, kde URL začíná a končí. Aby se změna tohoto nastavení projevila, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke-alfanumeriske tegn, der regnes som en del af en URL eller et arkivnavn i Semantisk historik.\nBogstaver og tal regnes altid som en del af URL’en. Disse ikke-alfanumeriske tegn bruges desuden til at afgøre, hvor en URL begynder og slutter. Du skal starte iTerm2 igen, for at ændringer af denne indstilling træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht alphanumerische Zeichen, die für die Semantic History als Teil einer URL oder eines Dateinamens gelten.\nBuchstaben und Zahlen gelten immer als Teil der URL. Diese nicht alphanumerischen Zeichen werden zusätzlich verwendet, um zu bestimmen, wo eine URL beginnt und endet. Sie müssen iTerm2 neu starten, damit Änderungen an dieser Einstellung wirksam werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Non-alphanumeric characters considered part of a URL or file name for Semantic History.\nLetters and numbers are always considered part of the URL. These non-alphanumeric characters are used in addition for the purposes of figuring out where a URL begins and ends. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres no alfanuméricos que se consideran parte de una URL o de un nombre de archivo para el historial semántico.\nLas letras y los números siempre se consideran parte de la URL. Estos caracteres no alfanuméricos se usan además para determinar dónde empieza y termina una URL. Debes reiniciar iTerm2 para que los cambios de este ajuste surtan efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei-aakkosnumeeriset merkit, joiden katsotaan kuuluvan URL-osoitteeseen tai tiedostonimeen semanttisessa historiassa.\nKirjaimet ja numerot katsotaan aina kuuluvan URL-osoitteeseen. Näitä ei-aakkosnumeerisia merkkejä käytetään lisäksi selvitettäessä, missä URL alkaa ja päättyy. iTerm2 on käynnistettävä uudelleen, jotta tämän asetuksen muutokset tulevat voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractères non alphanumériques considérés comme faisant partie d’une URL ou d’un nom de fichier pour l’historique sémantique.\nLes lettres et les chiffres font toujours partie de l’URL. Ces caractères non alphanumériques sont utilisés en plus pour déterminer où une URL commence et se termine. Vous devez redémarrer iTerm2 pour que les modifications de ce réglage prennent effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caratteri non alfanumerici considerati parte di un URL o di un nome file per la cronologia semantica.\nLettere e numeri sono sempre considerati parte dell’URL. Questi caratteri non alfanumerici vengono usati in aggiunta per stabilire dove inizia e dove finisce un URL. Devi riavviare iTerm2 affinché le modifiche a questa impostazione abbiano effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セマンティックヒストリーでURLまたはファイル名の一部とみなす英数字以外の文字。\n文字と数字は常にURLの一部とみなされます。これらの英数字以外の文字は、URLの開始位置と終了位置を判断するために追加で使用されます。この設定の変更を反映させるにはiTerm2を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시맨틱 히스토리에서 URL 또는 파일 이름의 일부로 간주하는 영숫자가 아닌 문자.\n문자와 숫자는 항상 URL의 일부로 간주됩니다. URL의 시작과 끝을 판단할 때 이 영숫자가 아닌 문자들이 추가로 사용됩니다. 이 설정의 변경 사항을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke-alfanumeriske tegn som regnes som en del av en URL eller et filnavn for semantisk historikk.\nBokstaver og tall regnes alltid som en del av URL-en. Disse ikke-alfanumeriske tegnene brukes i tillegg for å finne ut hvor en URL begynner og slutter. Du må starte iTerm2 på nytt for at endringer i denne innstillingen skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet-alfanumerieke tekens die voor Semantische geschiedenis als onderdeel van een URL of bestandsnaam gelden.\nLetters en cijfers gelden altijd als onderdeel van de URL. Deze niet-alfanumerieke tekens worden daarnaast gebruikt om te bepalen waar een URL begint en eindigt. Je moet iTerm2 herstarten om wijzigingen aan deze instelling door te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki niealfanumeryczne uznawane za część adresu URL lub nazwy pliku w historii semantycznej.\nLitery i cyfry zawsze są uznawane za część adresu URL. Te znaki niealfanumeryczne są używane dodatkowo do ustalenia, gdzie adres URL się zaczyna i kończy. Aby zmiana tego ustawienia zaczęła działać, musisz uruchomić iTerm2 ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres não alfanuméricos considerados parte de uma URL ou nome de arquivo para o Semantic History.\nLetras e números são sempre considerados parte da URL. Estes caracteres não alfanuméricos são usados adicionalmente para determinar onde uma URL começa e termina. Você precisa reiniciar o iTerm2 para que as alterações desta configuração tenham efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неалфавитно-цифровые символы, которые считаются частью URL-адреса или имени файла для функции «Смысловая история».\nБуквы и цифры всегда считаются частью URL-адреса. Эти неалфавитно-цифровые символы дополнительно используются для определения начала и конца URL-адреса. Чтобы изменения этого параметра вступили в силу, перезапустите iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nealfanumerické znaky považované za súčasť URL alebo názvu súboru pre Sémantickú históriu.\nPísmená a číslice sa vždy považujú za súčasť URL. Tieto nealfanumerické znaky sa používajú navyše na zistenie, kde URL začína a končí. Aby sa zmeny tohto nastavenia prejavili, musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nealfanumerični znaki, ki veljajo za del URL-ja ali imena datoteke za semantično zgodovino.\nČrke in številke vedno veljajo za del URL-ja. Ti nealfanumerični znaki se dodatno uporabljajo za ugotavljanje, kje se URL začne in konča. Za uveljavitev sprememb te nastavitve morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icke-alfanumeriska tecken som räknas som del av en URL eller ett filnamn för semantisk historik.\nBokstäver och siffror räknas alltid som del av URL:en. Dessa icke-alfanumeriska tecken används dessutom för att avgöra var en URL börjar och slutar. Du måste starta om iTerm2 för att ändringar av den här inställningen ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamsal Geçmiş için URL’nin veya dosya adının parçası sayılan alfasayısal olmayan karakterler.\nHarfler ve rakamlar her zaman URL’nin parçası sayılır. Bir URL’nin nerede başlayıp bittiğini belirlemek için bu alfasayısal olmayan karakterler de kullanılır. Bu ayardaki değişikliklerin etkili olması için iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ký tự không phải chữ và số được xem là một phần của URL hoặc tên tệp đối với Lịch sử ngữ nghĩa.\nChữ cái và chữ số luôn được xem là một phần của URL. Các ký tự không phải chữ và số này được dùng thêm để xác định nơi một URL bắt đầu và kết thúc. Bạn phải khởi động lại iTerm2 để thay đổi cài đặt này có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非字母数字字符被视为URL或文件名的一部分，用于语义历史功能。  \n字母和数字始终视为URL的一部分。这些非字母数字字符还用于确定URL的起始和结束位置。必须重启iTerm2才能使此设置生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在語意歷史記錄中被視為 URL 或檔名一部分的非英數字元。\n字母和數字一律視為 URL 的一部分。這些非英數字元會另外用於判斷 URL 的起點和終點。你必須重新啟動 iTerm2，此設定的變更才會生效。"
          }
        }
      }
    },
    "AdvancedSetting.URLCharacterSetExclusions" : {
      "comment" : "Advanced setting: URLCharacterSetExclusions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaky, které se nikdy nepovažují za součást URL.\nZnaky v tomto řetězci se v URL nikdy nesmějí vyskytovat; když je jeden nalezen, vymezuje začátek nebo konec URL."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn, der aldrig regnes som en del af en URL.\nTegnene i denne streng må aldrig forekomme i en URL. Når et af dem ses, markerer det begyndelsen eller slutningen af en URL."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen, die niemals als Teil einer URL gelten.\nDie Zeichen in dieser Zeichenfolge dürfen niemals in einer URL vorkommen; wird eines davon erkannt, markiert es den Anfang oder das Ende einer URL."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Characters never considered part of a URL.\nThe characters in this string may never occur in a URL; when one is seen that delineates the beginning or end of a URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres que nunca se consideran parte de una URL.\nLos caracteres de esta cadena nunca pueden aparecer en una URL; cuando se ve uno, delimita el comienzo o el final de una URL."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkit, joiden ei koskaan katsota kuuluvan URL-osoitteeseen.\nTämän merkkijonon merkit eivät voi esiintyä URL-osoitteessa; kun sellainen havaitaan, se rajaa URL-osoitteen alun tai lopun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractères jamais considérés comme faisant partie d’une URL.\nLes caractères de cette chaîne ne peuvent jamais apparaître dans une URL ; lorsque l’un d’eux est rencontré, il délimite le début ou la fin d’une URL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caratteri mai considerati parte di un URL.\nI caratteri di questa stringa non possono mai comparire in un URL; quando ne viene rilevato uno, questo delimita l’inizio o la fine di un URL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLの一部として決してみなされない文字。\nこの文字列に含まれる文字はURL中に現れることがないため、見つかった場合はURLの開始または終了の区切りとみなされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL의 일부로 절대 간주하지 않는 문자.\n이 문자열의 문자는 URL에 나타날 수 없으며, 이 문자가 보이면 URL의 시작이나 끝으로 구분합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn som aldri regnes som en del av en URL.\nTegnene i denne strengen kan aldri forekomme i en URL. Når ett av dem blir funnet, markerer det begynnelsen eller slutten av en URL."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekens die nooit als onderdeel van een URL gelden.\nDe tekens in deze tekenreeks mogen nooit in een URL voorkomen; als er een wordt aangetroffen, markeert die het begin of einde van een URL."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki nigdy niebędące częścią adresu URL.\nZnaki z tego ciągu nigdy nie mogą występować w adresie URL; gdy zostanie napotkany jeden z nich, wyznacza początek lub koniec adresu URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres nunca considerados parte de uma URL.\nOs caracteres nesta string nunca podem ocorrer em uma URL; quando um deles aparece, ele delimita o início ou o fim de uma URL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символы, которые никогда не считаются частью URL-адреса.\nСимволы в этой строке никогда не встречаются в URL-адресе; когда такой символ обнаружен, он обозначает начало или конец URL-адреса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaky, ktoré sa nikdy nepovažujú za súčasť URL.\nZnaky v tomto reťazci sa nikdy nesmú vyskytnúť v URL; keď sa nájde niektorý z nich, vymedzuje začiatok alebo koniec URL."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki, ki nikoli ne veljajo za del URL-ja.\nZnaki v tem nizu se v URL-ju ne smejo pojaviti; ko je opažen eden, označuje začetek ali konec URL-ja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tecken som aldrig räknas som del av en URL.\nTecknen i den här strängen kan aldrig förekomma i en URL; när ett sådant tecken ses avgränsar det början eller slutet på en URL."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL’nin parçası sayılmayan karakterler.\nBu dizedeki karakterler URL içinde hiçbir zaman yer alamaz; bunlardan biri görüldüğünde URL’nin başlangıcını veya sonunu belirler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ký tự không bao giờ được xem là một phần của URL.\nCác ký tự trong chuỗi này không bao giờ xuất hiện trong URL; khi gặp một ký tự như vậy, nó đánh dấu phần đầu hoặc phần cuối của URL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远不会被视为URL字符的字符。  \n该字符串中的字符可能永远不会出现在URL中；当出现此类字符时，表示URL的起始或结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一律不視為 URL 一部分的字元。\n此字串中的字元不可能出現在 URL 中；看到其中任一字元時，即表示 URL 的開頭或結尾。"
          }
        }
      }
    },
    "AdvancedSetting.aboutToPasteTabsWithCancel" : {
      "comment" : "Advanced setting: aboutToPasteTabsWithCancel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat varování při vkládání tabulátorů s nabídkou převodu na mezery nebo použití pokročilého vkládání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul advarslen ved indsætning af tabulatorer, hvor du kan vælge at konvertere dem til mellemrum eller bruge avanceret indsætning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung beim Einfügen von Tabulatoren unterdrücken, die anbietet, sie in Leerzeichen umzuwandeln oder erweitertes Einfügen durchzuführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning when pasting tabs with offer to convert them to spaces or perform advanced paste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir el aviso al pegar tabuladores, con la opción de convertirlos en espacios o de usar el pegado avanzado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä näytä varoitusta sijoitettaessa sarkaimia, kun tarjotaan niiden muuntamista välilyönneiksi tai edistynyttä sijoitusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’avertissement lors du collage de tabulations, avec la proposition de les convertir en espaces ou d’effectuer un collage avancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso quando si incollano tabulazioni, con l’offerta di convertirle in spazi o di eseguire l’incolla avanzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを貼り付ける際、スペースへの変換や高度な貼り付けの実行を提案する警告を抑制する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 문자를 붙여넣을 때 공백으로 변환하거나 고급 붙여넣기를 제안하는 경고 표시 안 함."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis advarselen ved innliming av tabulatorer, som tilbyr å konvertere dem til mellomrom eller bruke avansert innliming."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk de waarschuwing bij het plakken van tabs, met de optie om ze om te zetten in spaties of geavanceerd plakken te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń ostrzeżenie przy wklejaniu tabulatorów z propozycją zamiany ich na spacje lub użycia zaawansowanego wklejania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir aviso ao colar tabulações, com a opção de convertê-las em espaços ou executar a colagem avançada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение при вставке табуляций с предложением преобразовать их в пробелы или выполнить расширенную вставку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať upozornenie pri vkladaní tabulátorov s ponukou ich prevodu na medzery alebo použitia rozšíreného vkladania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži opozorila ob lepljenju tabulatorjev s ponudbo za pretvorbo v presledke ali napredno lepljenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa inte varningen vid inklistring av tabbtecken, med erbjudande om att konvertera dem till mellanslag eller göra avancerad inklistring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeleri yapıştırırken, bunları boşluğa dönüştürme veya gelişmiş yapıştırma seçeneği sunan uyarıyı gizle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị lại cảnh báo khi dán tab, kèm tùy chọn chuyển chúng thành dấu cách hoặc dùng dán nâng cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在粘贴带有将标签页转换为空格或执行高级粘贴的提示的标签页时，隐藏警告信息"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上含有定位字元的內容時，若提供轉換為空格或進行進階貼上的選項，則不顯示警告。"
          }
        }
      }
    },
