    "LLMMetadata.ManualModelUnavailable" : {
      "comment" : "Error shown in an AI chat that uses a model the user configured manually (for example, one on a local server) after that model was removed or renamed in Settings, instead of sending the message to a different AI provider. The placeholder is the model's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model „%@“ již není nastaven v „Nastavení > Obecné > AI“. Přidejte jej znovu se stejným názvem nebo zahajte nový chat s jiným modelem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen “%@” er ikke længere konfigureret i Indstillinger > Generelt > AI. Tilføj den igen med samme navn, eller start en ny chat med en anden model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell „%@“ ist nicht mehr unter Einstellungen > Allgemein > KI konfiguriert. Fügen Sie es mit demselben Namen wieder hinzu, oder beginnen Sie einen neuen Chat mit einem anderen Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The model “%@” is no longer configured in Settings > General > AI. Add it again with the same name, or start a new chat with a different model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo “%@” ya no está configurado en Ajustes > General > IA. Añádelo de nuevo con el mismo nombre o inicia un chat nuevo con otro modelo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mallia ”%@” ei ole enää määritetty kohdassa Asetukset > Yleiset > AI. Lisää se uudelleen samalla nimellä tai aloita uusi keskustelu toisella mallilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle « %@ » n’est plus configuré dans Réglages > Général > IA. Ajoutez-le à nouveau avec le même nom, ou démarrez un nouveau chat avec un autre modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello “%@” non è più configurato in Impostazioni > Generali > IA. Aggiungilo di nuovo con lo stesso nome oppure avvia una nuova chat con un altro modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデル「%@」は「設定 > 一般 > AI」で構成されなくなりました。同じ名前で再度追加するか、別のモデルで新しいチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 “%@”이(가) 더 이상 설정 > 일반 > AI에 구성되어 있지 않습니다. 같은 이름으로 다시 추가하거나 다른 모델로 새로운 채팅을 시작하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen «%@» er ikke lenger konfigurert i «Innstillinger > Generelt > KI». Legg den til igjen med samme navn, eller start en ny chat med en annen modell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het model ‘%@’ is niet meer geconfigureerd in ‘Instellingen’ > ‘Algemeen’ > ‘AI’. Voeg het opnieuw toe met dezelfde naam, of begin een nieuwe chat met een ander model."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model „%@” nie jest już skonfigurowany w „Ustawienia > Ogólne > AI”. Dodaj go ponownie pod tą samą nazwą lub rozpocznij nowy czat z innym modelem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo “%@” não está mais configurado em Ajustes > Geral > IA. Adicione-o novamente com o mesmo nome ou inicie um novo chat com outro modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель «%@» больше не настроена в разделе «Настройки > Основные > ИИ». Добавьте её снова с тем же именем или начните новый чат с другой моделью."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model „%@“ už nie je nastavený v časti „Nastavenia > Všeobecné > AI“. Pridajte ho znova s rovnakým názvom alebo začnite nový chat s iným modelom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model »%@« ni več konfiguriran v »Nastavitve > Splošno > AI«. Znova ga dodajte z istim imenom ali začnite nov klepet z drugim modelom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen ”%@” är inte längre konfigurerad i Inställningar > Allmänt > AI. Lägg till den igen med samma namn, eller starta en ny chatt med en annan modell."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” modeli artık Ayarlar > Genel > YZ bölümünde yapılandırılmış değil. Aynı adla yeniden ekleyin veya farklı bir modelle yeni bir sohbet başlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình “%@” không còn được định cấu hình trong Cài đặt > Chung > AI. Hãy thêm lại với cùng tên, hoặc bắt đầu cuộc trò chuyện mới với mô hình khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型“%@”已不再在“设置 > 通用 > AI”中配置。请使用相同名称重新添加，或使用其他模型开始新的聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型「%@」已不在「設定 > 一般 > AI」中設定。請以相同名稱重新加入，或以其他模型開始新的聊天。"
          }
        }
      }
    },
    "LLMMetadata.ModelUnavailable" : {
      "comment" : "Error shown in an AI chat whose Llama-family model is no longer available, instead of sending the message to a different AI provider. The placeholder is the model's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model „%@“ není k dispozici. Pokud jde o model Ollama, spusťte Ollama. Jinak zahajte nový chat s jiným modelem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellen “%@” er ikke tilgængelig. Hvis det er en Ollama-model, skal du starte Ollama. Ellers skal du starte en ny chat med en anden model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell „%@“ ist nicht verfügbar. Wenn es ein Ollama-Modell ist, starten Sie Ollama. Beginnen Sie andernfalls einen neuen Chat mit einem anderen Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The model “%@” is not available. If it is an Ollama model, start Ollama. Otherwise, start a new chat with a different model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo “%@” no está disponible. Si es un modelo de Ollama, inicia Ollama. De lo contrario, inicia un chat nuevo con otro modelo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malli ”%@” ei ole käytettävissä. Jos se on Ollama-malli, käynnistä Ollama. Muuten aloita uusi keskustelu toisella mallilla."
