    "PTYSession.ResizePrompt" : {
      "comment" : "Prompt asking whether to allow a program to resize the window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program se pokusil změnit velikost okna. Povolit to?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et program har forsøgt at ændre vinduets størrelse. Vil du tillade det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm hat versucht, die Fenstergröße zu ändern. Erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A program has tried to resize the window. Allow it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa ha intentado cambiar el tamaño de la ventana. ¿Permitirlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjelma yritti muuttaa ikkunan kokoa. Sallitaanko se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme a tenté de redimensionner la fenêtre. L’autoriser ?"
          }
        },
        "it" : {
          "stringUnit" : {
