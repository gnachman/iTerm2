    "AdvancedSetting.dockIconTogglesWindow" : {
      "comment" : "Advanced setting: dockIconTogglesWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das einzige Fenster ein Hotkey-Fenster ist, zeigt oder verbirgt ein Klick auf das Dock-Symbol es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If the only window is a hotkey window, then clicking the dock icon shows or hides it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la única ventana es una ventana de tecla rápida, al hacer clic en el icono del Dock se muestra u oculta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la seule fenêtre est une fenêtre à raccourci global, un clic sur l’icône du Dock l’affiche ou la masque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’unica finestra è una finestra ad abbreviazione globale, fare clic sull’icona del Dock la mostra o la nasconde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唯一のウィンドウがホットキーウィンドウである場合、Dock アイコンをクリックするとそれを表示または非表示にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유일한 윈도우가 단축키 윈도우이면 Dock 아이콘을 클릭할 때 해당 윈도우를 보이거나 가립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a única janela for uma janela de hotkey, clicar no ícone do dock a mostra ou oculta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если единственное окно — это окно по горячей клавише, то щелчок по значку в Dock показывает или скрывает его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek pencere bir kısayol tuşu penceresiyse Dock simgesini tıklamak onu gösterir veya gizler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果唯一的窗口是热键窗口，那么点击 Dock 图标即可显示或隐藏它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果唯一的視窗是全域快速鍵視窗，按一下 Dock 圖像會顯示或隱藏它。"
          }
        }
      }
    },
    "AdvancedSetting.doubleClickTabToEdit" : {
      "comment" : "Advanced setting: doubleClickTabToEdit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll ein Doppelklick auf einen Tab ein Fenster zum Bearbeiten seines Titels öffnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should double-clicking a tab open a window to edit its title?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe abrirse una ventana para editar el título al hacer doble clic en una pestaña?"
