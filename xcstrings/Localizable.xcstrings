            "value" : "Hex-Codes, die beim Aufrufen des Composers gesendet werden, um die Befehlszeile zu leeren.\n0x15 ist ^U, 0x0b ist ^K."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hex codes to send to clear the command line when entering the composer.\n0x15 is ^U, 0x0b is ^K."
          }
