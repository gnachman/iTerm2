    "AdvancedSetting.unameCommand" : {
      "comment" : "Advanced setting: unameCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl zum Setzen der Variable `uname`.\nDer Hauptzweck besteht darin, sie im KI-Prompt zu verwenden, damit das Sprachmodell das Betriebssystem kennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command used to set the `uname` variable.\nThe main use of this is to use in the AI prompt so the language model knows the operating system."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`uname`変数を設定するために使用するコマンド。\n主に、言語モデルがオペレーティングシステムを認識できるようAIプロンプトで使用するためのものです。"
