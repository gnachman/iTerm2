    "AITerm.NoModelAPIKey" : {
      "comment" : "Error shown when a manual AI model is configured to use its own API key but none is stored; “Manage AI Models” is the name of a settings window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell ist so eingestellt, dass es einen eigenen API-Schlüssel verwendet, aber es wurde keiner eingegeben. Bearbeiten Sie das Modell unter „KI-Modelle verwalten“, um einen einzugeben."
          }
        },
