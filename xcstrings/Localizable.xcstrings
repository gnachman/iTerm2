    "AdvancedSetting.fastTriggerRegexes" : {
      "comment" : "Advanced setting: fastTriggerRegexes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelle Auswertung regulärer Ausdrücke für Trigger.\nDies ist experimentell, da es die Interpretation regulärer Ausdrücke möglicherweise verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast regular expression evaluation for triggers.\nThis is experimental because it could potentially change how regular expressions are interpreted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evaluación rápida de expresiones regulares para los disparadores.\nEs experimental porque podría cambiar cómo se interpretan las expresiones regulares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évaluation rapide des expressions régulières pour les déclencheurs.\nC’est expérimental, car cela pourrait modifier l’interprétation des expressions régulières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valutazione rapida delle espressioni regolari per gli attivatori.\nÈ sperimentale perché potrebbe cambiare il modo in cui le espressioni regolari vengono interpretate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガー用の高速な正規表現評価。\n正規表現の解釈方法が変わる可能性があるため、これは実験的な機能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거의 정규 표현식을 빠르게 평가합니다.\n정규 표현식의 해석 방식이 바뀔 수 있으므로 실험적 기능입니다."
