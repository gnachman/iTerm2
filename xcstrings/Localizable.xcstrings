    "RestorableState.RestoreWindowsMessage" : {
      "comment" : "Warning asking whether to retry restoring windows after a failure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při posledním spuštění iTerm2 se některá okna nepodařilo obnovit. Zkusit to znovu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle vinduer havde problemer med at blive gendannet, sidste gang iTerm2 startede. Vil du prøve igen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim letzten Start von iTerm2 gab es Probleme bei der Wiederherstellung einiger Fenster. Erneut versuchen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some windows had trouble restoring last time iTerm2 launched. Try again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas ventanas tuvieron problemas al restaurarse la última vez que se inició iTerm2. ¿Volver a intentarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joidenkin ikkunoiden palauttamisessa oli ongelmia iTerm2:n edellisellä käynnistyksellä. Yritetäänkö uudelleen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines fenêtres ont rencontré des difficultés lors de leur restauration au dernier lancement d’iTerm2. Réessayer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune finestre hanno avuto problemi di ripristino all’ultimo avvio di iTerm2. Riprovare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回iTerm2を起動したとき、一部のウィンドウの復元に問題がありました。もう一度試しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난번 iTerm2를 실행했을 때 일부 윈도우를 복원하는 데 문제가 있었습니다. 다시 시도하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen vinduer hadde problemer med å gjenopprettes forrige gang iTerm2 startet. Vil du prøve igjen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige vensters konden de vorige keer dat iTerm2 werd gestart niet goed worden teruggezet. Opnieuw proberen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre okna miały problemy z przywróceniem podczas ostatniego uruchomienia iTerm2. Spróbować ponownie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas janelas tiveram problemas ao serem restauradas na última vez que o iTerm2 foi iniciado. Tentar novamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При последнем запуске iTerm2 не удалось восстановить некоторые окна. Повторить попытку?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré okná sa pri poslednom spustení iTerm2 nepodarilo obnoviť. Skúsiť znovu?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri obnavljanju nekaterih oken je ob zadnjem zagonu aplikacije iTerm2 prišlo do težav. Poskusiti znova?"
          }
        },
        "sv" : {
          "stringUnit" : {
