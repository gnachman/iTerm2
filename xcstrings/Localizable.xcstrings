    "PasteboardReporter.ConfirmEnableBody" : {
      "comment" : "Warning body shown before enabling clipboard reporting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlášení obsahu schránky aplikacím běžícím v iTerm2 může odhalit citlivé informace, například hesla. Před zapnutím to dobře zvažte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapportering af udklipsholderens indhold til programmer, der kører i iTerm2, kan afsløre følsomme oplysninger som adgangskoder. Overvej det nøje, før du slår det til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Melden des Inhalts der Zwischenablage an Apps, die innerhalb von iTerm2 ausgeführt werden, kann vertrauliche Informationen wie Passwörter offenlegen. Überlegen Sie sich gut, ob Sie dies aktivieren möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reporting the content of the clipboard to apps running inside iTerm2 may expose sensitive information such as passwords. Think carefully before enabling this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informar del contenido del portapapeles a las apps que se ejecutan dentro de iTerm2 puede exponer información sensible, como contraseñas. Piénsalo bien antes de activarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leikepöydän sisällön raportointi iTerm2:ssa käynnissä oleville sovelluksille voi paljastaa arkaluonteisia tietoja, kuten salasanoja. Harkitse tarkkaan ennen kuin otat tämän käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler le contenu du presse-papiers aux apps exécutées dans iTerm2 peut exposer des informations sensibles, comme des mots de passe. Réfléchissez bien avant de l’activer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnalare il contenuto degli Appunti alle app in esecuzione in iTerm2 può esporre informazioni sensibili, come le password. Rifletti bene prima di abilitarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの内容をiTerm2内で実行されているアプリに報告すると、パスワードなどの機密情報が漏洩する可能性があります。有効にする前によく検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 안에서 실행 중인 앱에 클립보드 내용을 보고하면 암호 같은 민감한 정보가 노출될 수 있습니다. 켜기 전에 신중히 생각하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å rapportere innholdet på utklippstavlen til programmer som kjører i iTerm2, kan avsløre sensitiv informasjon som passord. Tenk deg nøye om før du slår dette på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de inhoud van het klembord doorgeeft aan apps die in iTerm2 draaien, kan gevoelige informatie zoals wachtwoorden worden blootgesteld. Denk goed na voordat je dit inschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportowanie zawartości schowka aplikacjom działającym w iTerm2 może ujawnić poufne informacje, takie jak hasła. Zastanów się dobrze, zanim to włączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar o conteúdo da área de transferência para apps em execução dentro do iTerm2 pode expor informações confidenciais, como senhas. Pense bem antes de ativar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передача содержимого буфера обмена приложениям, запущенным внутри iTerm2, может раскрыть конфиденциальную информацию, например пароли. Хорошо подумайте, прежде чем включать эту функцию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlásenie obsahu schránky aplikáciám bežiacim v iTerm2 môže odhaliť citlivé informácie, napríklad heslá. Dobre si to rozmyslite, kým to zapnete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporočanje vsebine odložišča aplikacijam, ki se izvajajo v aplikaciji iTerm2, lahko razkrije občutljive podatke, kot so gesla. Dobro premislite, preden to omogočite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om innehållet i urklipp rapporteras till program som körs i iTerm2 kan känslig information som lösenord avslöjas. Tänk efter noga innan du aktiverar detta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pano içeriğini iTerm2 içinde çalışan uygulamalara bildirmek, parolalar gibi hassas bilgileri açığa çıkarabilir. Bunu etkinleştirmeden önce dikkatle düşünün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo nội dung bảng nhớ tạm cho các ứng dụng chạy trong iTerm2 có thể làm lộ thông tin nhạy cảm như mật khẩu. Hãy cân nhắc kỹ trước khi bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将剪贴板内容报告给在 iTerm2 内运行的应用可能会暴露密码等敏感信息。启用前请慎重考虑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將剪貼簿內容回報給在 iTerm2 內執行的 App，可能會暴露密碼等敏感資訊。啟用前請審慎考慮。"
          }
        }
      }
    },
