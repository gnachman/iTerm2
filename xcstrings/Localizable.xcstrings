    "AdvancedSetting.scrollableTabWidth" : {
      "comment" : "Advanced setting: scrollableTabWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab-Breite, wenn die Tableiste scrollbar ist.\nWird als feste Breite verwendet, wenn Tabs gleich groß sind, und als Mindestbreite, wenn ungleichmäßige Tab-Breiten zulässig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab width when the tab bar is scrollable.\nUsed as the fixed width when tabs are equally sized, and as the minimum width when uneven tab widths are allowed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancho de pestaña cuando la barra de pestañas es desplazable.\nSe usa como ancho fijo cuando las pestañas tienen el mismo tamaño, y como ancho mínimo cuando se permiten anchos desiguales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largeur des onglets lorsque la barre d’onglets est défilante.\nUtilisée comme largeur fixe lorsque les onglets ont la même taille, et comme largeur minimale lorsque des largeurs inégales sont autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larghezza dei pannelli quando la barra dei pannelli è scorrevole.\nViene usata come larghezza fissa quando i pannelli hanno la stessa dimensione e come larghezza minima quando sono consentite larghezze irregolari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーがスクロール可能なときのタブ幅。\nタブが均等なサイズのときは固定幅として、不均一なタブ幅が許可されている場合は最小幅として使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대를 스크롤할 수 있을 때의 탭 너비.\n탭 크기가 모두 같을 때는 고정 너비로, 탭 너비가 달라도 될 때는 최소 너비로 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura da aba quando a barra de abas é rolável.\nUsada como a largura fixa quando as abas têm o mesmo tamanho, e como a largura mínima quando larguras de abas desiguais são permitidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина вкладки, когда панель вкладок прокручиваемая.\nИспользуется как фиксированная ширина, когда все вкладки одинакового размера, и как минимальная ширина, когда допускается неравная ширина вкладок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğu kaydırılabilirken sekme genişliği.\nSekmeler eşit boyutluyken sabit genişlik, eşit olmayan genişliklere izin verildiğinde ise asgari genişlik olarak kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页栏可滚动时的标签宽度。  \n作为等宽标签的固定宽度，以及非等宽标签的最小宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁列可捲動時的標籤頁寬度。\n標籤頁大小一致時作為固定寬度，允許標籤頁寬度不一致時則作為最小寬度。"
          }
        }
      }
    },
    "AdvancedSetting.searchCommand" : {
      "comment" : "Advanced setting: searchCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlage für die URL der Suchmaschine.\niTerm2 ersetzt den String „%@“ durch den gesuchten Text. Dabei wird Prozent-Escaping für Abfrageparameter verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Template for URL of search engine.\niTerm2 replaces the string “%@” with the text to search for. Query parameter percent escaping is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plantilla de la URL del motor de búsqueda.\niTerm2 sustituye la cadena “%@” por el texto que se busca. Se usa el escape con porcentaje de parámetros de consulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modèle d’URL du moteur de recherche.\niTerm2 remplace la chaîne « %@ » par le texte à rechercher. L’échappement par pourcentage des paramètres de requête est utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modello dell’URL del motore di ricerca.\niTerm2 sostituisce la stringa “%@” con il testo da cercare. Viene usata la codifica percentuale dei parametri di query."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索エンジンのURLテンプレート。\niTerm2は文字列「%@」を検索対象のテキストに置き換えます。クエリパラメータのパーセントエスケープが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 엔진 URL 템플릿\niTerm2는 문자열 “%@”을(를) 검색할 텍스트로 대치합니다. 쿼리 매개변수 퍼센트 이스케이프가 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo para a URL do mecanismo de busca.\nO iTerm2 substitui a string “%@” pelo texto a buscar. É usado o escape de porcentagem para parâmetros de consulta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблон URL-адреса поисковой системы.\niTerm2 заменяет строку «%@» на текст для поиска. Используется процентное экранирование параметра запроса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama motoru URL’si için şablon.\niTerm2, “%@” dizesini aranacak metinle değiştirir. Sorgu parametresi yüzde kaçışı kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索引擎URL的模板。  \niTerm2将字符串“%@”替换为搜索文本，使用查询参数百分比转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋引擎 URL 的範本。\niTerm2 會將字串「%@」取代為要搜尋的文字。使用查詢參數百分比跳脫。"
          }
        }
      }
    },
    "AdvancedSetting.searchSuggestURL" : {
      "comment" : "Advanced setting: searchSuggestURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
