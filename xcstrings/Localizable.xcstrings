    "Tip.0104.Body" : {
      "comment" : "Tip of the day body, id 0104",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rufen Sie die Tipps des Tages mit dem Kommandozeilen-Dienstprogramm it2tip ab. Aktivieren Sie es, indem Sie Shell-Integration und Dienstprogramme installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access tips of the day with the it2tip utility, a command line app. Enable it by installing shell integration and utilities."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accede a los consejos del día con la utilidad it2tip, una app de línea de comandos. Actívala instalando la integración con el shell y las utilidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez aux astuces du jour avec l’utilitaire it2tip, une app en ligne de commande. Activez-le en installant l’intégration du shell et les utilitaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi ai suggerimenti del giorno con l’utilità it2tip, un’app da riga di comando. Abilitala installando l’integrazione shell e le utilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドラインアプリのit2tipユーティリティを使うと、今日のヒントにアクセスできます。シェル統合とユーティリティをインストールすると有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령줄 앱인 it2tip 유틸리티로 오늘의 팁을 볼 수 있습니다. 셸 통합과 유틸리티를 설치하면 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesse as dicas do dia com o utilitário it2tip, um app de linha de comando. Ative-o instalando o Shell Integration e os utilitários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте доступ к советам дня с помощью утилиты командной строки it2tip. Включите её, установив интеграцию с оболочкой и утилиты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün ipuçlarına, bir komut satırı uygulaması olan it2tip yardımcı programıyla erişin. Kabuk entegrasyonunu ve yardımcı programları yükleyerek etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用命令行应用 it2tip，可以获取每日访问提示。通过安装shell集成工具即可启用该功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用命令列 App it2tip 工具來查看每日小技巧。安裝 Shell 整合與公用工具即可啟用。"
          }
        }
      }
    },
