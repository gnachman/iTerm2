        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitişik Zaman Damgaları"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相邻的时间戳"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "並列的時間戳記"
          }
        }
      }
    },
    "Tip.0120.Body" : {
      "comment" : "Tip of the day body, id 0120",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markieren Sie einen JSON-Textblock und wählen Sie „Bearbeiten > Auswahl ersetzen > Mit formatiertem JSON ersetzen“, um ihn lesbar zu machen. Perfekt zum Debuggen von API-Antworten und Protokolldateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a block of JSON text and choose “Edit > Replace Selection > Replace with Pretty-Printed JSON” to make it readable. Perfect for debugging API responses and log files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un bloque de texto JSON y elige “Edición > Reemplazar selección > Reemplazar por JSON con formato legible” para hacerlo legible. Perfecto para depurar respuestas de API y archivos de registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un bloc de texte JSON et choisissez « Édition > Remplacer la sélection > Remplacer par du JSON mis en forme » pour le rendre lisible. Parfait pour déboguer des réponses d’API et des fichiers journaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona un blocco di testo JSON e scegli “Modifica > Sostituisci selezione > Sostituisci con JSON formattato” per renderlo leggibile. Perfetto per il debug delle risposte API e dei file di log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSONテキストのブロックを選択し、「編集 > 選択範囲を置換 > 整形されたJSONに置換」を選ぶと読みやすくなります。APIレスポンスやログファイルのデバッグに最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON 텍스트 블록을 선택하고 “편집 > 선택 영역 대치 > 보기 좋게 정리된 JSON으로 대치”를 선택하면 읽기 쉽게 만들 수 있습니다. API 응답과 로그 파일을 디버깅할 때 안성맞춤입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um bloco de texto JSON e escolha “Edit > Replace Selection > Replace with Pretty-Printed JSON” para torná-lo legível. Perfeito para depurar respostas de API e arquivos de log."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделите блок текста JSON и выберите «Правка > Заменить выделенное > Заменить отформатированным JSON», чтобы сделать его удобочитаемым. Отлично подходит для отладки ответов API и файлов журналов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir JSON metin bloğu seçip okunabilir hale getirmek için “Düzen > Seçimi Değiştir > Biçimlendirilmiş JSON ile Değiştir”i seçin. API yanıtlarında ve günlük dosyalarında hata ayıklamak için mükemmel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一段JSON文本，然后选择“编辑 > 替换选中内容 > 用格式化JSON替换”，使其更易于阅读。非常适合调试API响应和日志文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取一段 JSON 文字，然後選擇「編輯 > 取代選取範圍 > 取代為格式化的 JSON」，讓它更容易閱讀。非常適合用來除錯 API 回應和記錄檔。"
          }
        }
      }
    },
