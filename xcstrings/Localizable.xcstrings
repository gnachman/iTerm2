    "KeysPreferences.TouchBarItemAddedDescription" : {
      "comment" : "Notification body explaining how to enable a newly added Touch Bar item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novou položku Touch Baru zapnete volbou „Zobrazení > Přizpůsobit Touch Bar“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Oversigt > Indstil Touch Bar for at slå dit nye Touch Bar-emne til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie „Darstellung“ > „Touch Bar anpassen“, um Ihr neues Touch Bar-Element zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
