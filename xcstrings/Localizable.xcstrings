    "PythonRuntimeDownloader.DownloadOptionalMessage" : {
      "comment" : "Prompt to download the runtime; %@ is the download size",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běhové prostředí Pythonu využívají skripty v Pythonu, které spolupracují s iTerm2. Stahování má přibližně %@. Chcete jej stáhnout hned?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-kørselsmiljøet bruges af Python-instrukser, der arbejder sammen med iTerm2. Hentningen er på ca. %@. Vil du hente det nu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Python-Laufzeitumgebung wird von Python-Skripten verwendet, die mit iTerm2 zusammenarbeiten. Der Download ist etwa %@ groß. Jetzt herunterladen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python Runtime is used by Python scripts that work with iTerm2. The download is about %@. OK to download it now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entorno de ejecución de Python lo usan los scripts de Python que funcionan con iTerm2. La descarga ocupa unos %@. ¿Quieres descargarlo ahora?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-suoritusympäristöä käyttävät iTerm2:n kanssa toimivat Python-skriptit. Lataus on noin %@. Ladataanko se nyt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement d’exécution Python est utilisé par les scripts Python qui fonctionnent avec iTerm2. Le téléchargement représente environ %@. Le télécharger maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente di esecuzione Python è usato dagli script Python che funzionano con iTerm2. Il download è di circa %@. Vuoi scaricarlo ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python ランタイムは、iTerm2 と連携する Python スクリプトで使用されます。ダウンロードサイズは約 %@ です。今すぐダウンロードしてもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 런타임은 iTerm2와 연동되는 Python 스크립트에서 사용됩니다. 다운로드 크기는 약 %@입니다. 지금 다운로드하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-kjøremiljøet brukes av Python-skript som fungerer med iTerm2. Nedlastingen er på omtrent %@. Vil du laste det ned nå?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Python-runtime wordt gebruikt door Python-scripts die met iTerm2 werken. De download is ongeveer %@. Wil je deze nu downloaden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Środowisko uruchomieniowe Pythona jest używane przez skrypty Pythona współpracujące z iTerm2. Rozmiar pobieranych danych to około %@. Czy pobrać je teraz?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Runtime do Python é usado por scripts Python que funcionam com o iTerm2. A transferência tem cerca de %@. Deseja transferi-lo agora?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среда выполнения Python используется скриптами Python, работающими с iTerm2. Размер загрузки составляет около %@. Загрузить её сейчас?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripty Python, ktoré spolupracujú s iTerm2, používajú behové prostredie Python. Sťahovanie má približne %@. Chcete ho stiahnuť teraz?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvajalno okolje Python uporabljajo skripti Python, ki delujejo z aplikacijo iTerm2. Prenos je velik približno %@. Ga želite prenesti zdaj?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
