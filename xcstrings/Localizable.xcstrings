    "BrowserGateway.InvalidCodeSignature" : {
      "comment" : "Error shown when the browser plugin fails code signature verification",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Code-Signatur des Plugins unter %@ ist ungültig. Laden Sie es erneut herunter und stellen Sie sicher, dass Ihr Antivirenprogramm es nicht unter Quarantäne stellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The code signature of the plugin at %@ is invalid. Download it again, and ensure your anti-virus does not quarantine it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma de código del plugin en %@ no es válida. Descárgalo de nuevo y asegúrate de que tu antivirus no lo ponga en cuarentena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La signature de code du module situé à %@ n’est pas valide. Téléchargez-le à nouveau et assurez-vous que votre antivirus ne le met pas en quarantaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La firma del codice del plug-in in %@ non è valida. Scaricalo di nuovo e assicurati che l’antivirus non lo metta in quarantena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にあるプラグインのコード署名が無効です。もう一度ダウンロードし、ウイルス対策ソフトによって隔離されないようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 있는 플러그인의 코드 서명이 유효하지 않습니다. 다시 다운로드하고 바이러스 백신 프로그램이 플러그인을 격리하지 않도록 하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura de código do plugin em %@ é inválida. Transfira-o novamente e certifique-se de que seu antivírus não o coloque em quarentena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись кода плагина по пути %@ недействительна. Загрузите его снова и убедитесь, что антивирус не помещает его в карантин."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentinin (%@) kod imzası geçersiz. Yeniden indirin ve virüsten koruma yazılımınızın onu karantinaya almadığından emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件在%@的代码签名无效。重新下载，并确保您的反病毒软件不会将其隔离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於 %@ 的外掛程式，其程式碼簽章無效。請重新下載，並確保你的防毒軟體沒有將它隔離。"
          }
        }
      }
    },
    "BrowserGateway.NotBrowserPlugin" : {
      "comment" : "Error shown when the selected file is not the browser plugin",
