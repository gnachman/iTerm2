    "AdvancedSetting.timeoutForStringEvaluation" : {
      "comment" : "Advanced setting: timeoutForStringEvaluation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (Sekunden) für die Auswertung von RPCs.\nDies gilt für den Aufruf von Funktionen, die von Skripten registriert wurden, wenn die Swift-Syntax für Inline-Ausdrücke verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout (seconds) for evaluating RPCs.\nThis applies to invoking functions registered by scripts when using the Swift syntax for inline expressions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera (segundos) para evaluar RPC.\nSe aplica al invocar funciones registradas por scripts cuando se usa la sintaxis Swift para expresiones en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai d’expiration (secondes) pour l’évaluation des RPC.\nS’applique à l’appel de fonctions enregistrées par des scripts lors de l’utilisation de la syntaxe Swift pour les expressions en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (secondi) per la valutazione delle RPC.\nSi applica all’invocazione di funzioni registrate dagli script quando si usa la sintassi Swift per le espressioni inline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPCを評価する際のタイムアウト（秒）。\nこれは、インライン式にSwift構文を使用する際にスクリプトが登録した関数を呼び出す場合に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPC 평가 시간 제한(초).\n인라인 표현식에 Swift 구문을 사용할 때 스크립트가 등록한 함수를 호출하는 경우에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo limite (segundos) para avaliar RPCs.\nIsso se aplica à invocação de funções registradas por scripts ao usar a sintaxe Swift para expressões inline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайм-аут (в секундах) для вычисления RPC.\nПрименяется при вызове функций, зарегистрированных скриптами, если используется синтаксис Swift для встроенных выражений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPC’leri değerlendirmek için zaman aşımı (saniye).\nBu, satır içi ifadeler için Swift sözdizimi kullanılırken betiklerin kaydettiği işlevlerin çağrılmasında geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评估RPCs的超时时间（秒）。  \n此规则适用于使用Swift内联表达式语法时由脚本注册的函数调用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評估 RPC 的逾時時間（秒）。\n這適用於使用 Swift 語法的內嵌運算式時，呼叫由腳本註冊的函式。"
          }
        }
      }
    },
    "AdvancedSetting.tmuxIncludeClientNameInWindowTitle" : {
      "comment" : "Advanced setting: tmuxIncludeClientNameInWindowTitle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll bei Verwendung der tmux-Integration der tmux-Client-Name (in der Regel der Name der verbindenden Sitzung oder der Hostname) in Klammern im Fenstertitel erscheinen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using tmux integration, should the tmux client name (typically the name of the attaching session or the host name) appear in brackets in the window title?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al usar la integración con tmux, ¿debe aparecer entre corchetes en el título de la ventana el nombre del cliente de tmux (normalmente el nombre de la sesión a la que se conecta o el nombre del host)?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l’intégration tmux, le nom du client tmux (généralement le nom de la session d’attachement ou le nom d’hôte) doit-il apparaître entre crochets dans le titre de la fenêtre ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si usa l’integrazione tmux, il nome del client tmux (di solito il nome della sessione a cui ci si collega o il nome host) deve comparire tra parentesi quadre nel titolo della finestra?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合を使用する場合、tmuxクライアント名（通常は接続先セッション名またはホスト名）をウィンドウタイトルに角括弧で表示しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합을 사용할 때 tmux 클라이언트 이름(일반적으로 연결하는 세션의 이름 또는 호스트 이름)을 윈도우 제목에 괄호로 표시합니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar a integração com tmux, o nome do cliente tmux (normalmente o nome da sessão que se conecta ou o nome do host) deve aparecer entre colchetes no título da janela?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать ли имя клиента tmux (обычно это имя подключаемого сеанса или имя хоста) в квадратных скобках в заголовке окна при использовании интеграции с tmux?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux entegrasyonu kullanılırken tmux istemci adı (genellikle bağlanan oturumun adı veya ana makine adı) pencere başlığında köşeli ayraç içinde görünsün mü?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用tmux集成时，tmux客户端名称（通常是连接会话或主机名）是否应出现在窗口标题的方括号中？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 整合時，tmux 用戶端名稱（通常是附加工作階段的名稱或主機名稱）是否應顯示在視窗標題的括號中？"
          }
        }
      }
    },
