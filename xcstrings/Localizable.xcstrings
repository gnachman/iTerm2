    "AdvancedSetting.lightModeInactiveTabDarkness" : {
      "comment" : "Advanced setting: lightModeInactiveTabDarkness",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tmavost (v rozsahu [0…1]) nevybraných panelů v jiném než minimalistickém motivu ve světlém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørkhed (i [0…1]) for faner, der ikke er valgt, i andre temaer end Minimal i lys tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkelheit (im Bereich [0…1]) für nicht ausgewählte Tabs in Designs außer „Minimal“ im hellen Modus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Darkness (in [0…1]) for non-selected tabs in non-Minimal theme in light mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscuridad (en [0…1]) de las pestañas no seleccionadas en un tema no minimalista en modo claro."
