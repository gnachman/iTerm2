    "Tip.0079.Body" : {
      "comment" : "Tip of the day body, id 0079",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⇧⌘., um den Composer zu öffnen. Er bietet Ihnen einen Entwurfsbereich, um einen Befehl zu bearbeiten, bevor Sie ihn an die Shell senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⇧⌘. to open the Composer. It gives you a scratchpad to edit a command before sending it to the shell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⇧⌘. para abrir el compositor. Te ofrece un bloc de notas para editar un comando antes de enviarlo al shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⇧⌘. pour ouvrir le compositeur. Il offre un bloc-notes pour modifier une commande avant de l’envoyer au shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi ⇧⌘. per aprire il Compositore. Ti offre un blocco appunti per modificare un comando prima di inviarlo alla shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘.を押すとコンポーザーが開きます。シェルに送信する前にコマンドを編集できるスクラッチパッドです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘.를 누르면 컴포저가 열립니다. 명령을 셸로 보내기 전에 편집할 수 있는 임시 작업 공간입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⇧⌘. para abrir o Compositor. Ele oferece um rascunho para editar um comando antes de enviá-lo ao shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⇧⌘., чтобы открыть Композер. Он предоставляет черновик для редактирования команды перед отправкой её в оболочку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucu’yu açmak için ⇧⌘. tuşlarına basın. Bir komutu kabuğa göndermeden önce düzenlemeniz için bir karalama alanı sunar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下 ⇧⌘ 可打开 Composer。它提供了一个编辑区域，用于在将命令发送到 shell之前进行修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ⇧⌘. 可打開編寫器。它提供一塊草稿區，讓你在將指令傳送給 shell 之前先編輯。"
          }
        }
      }
    },
