    "ChatViewController.PermissionGrantedBody" : {
      "comment" : "Notice shown when the chat is granted permission to control a mentioned entity",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Diesem Chat wurde die Berechtigung erteilt, „%@“ zu steuern.**\n\nSie haben es mit @ erwähnt, daher kann der Agent dort ohne Rückfrage handeln. Widerrufen Sie die Berechtigung, um wieder eine Genehmigung zu verlangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Granted this chat permission to control “%@”.**\n\nYou @-mentioned it, so the agent can act there without asking. Revoke to require approval again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**このチャットに「%@」を制御する権限を付与しました。**\n\n@メンションしたため、エージェントは確認なしでそこで操作できます。再度承認を必須にするには取り消してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**이 채팅에 “%@”을(를) 제어할 권한을 부여했습니다.**\n\n@멘션했으므로 에이전트가 묻지 않고 해당 대상에서 작업할 수 있습니다. 다시 승인을 요구하려면 권한을 취소하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Concedida a este chat a permissão para controlar “%@”.**\n\nVocê o mencionou com @, então o agente pode agir ali sem perguntar. Revogue para exigir aprovação novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Этому чату предоставлено разрешение управлять «%@».**\n\nВы упомянули его через @, поэтому агент может действовать там без запроса. Отзовите разрешение, чтобы снова требовать подтверждение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**已授予此聊天权限以控制“%@”。**\n\n您提到了这一点，因此代理可以在不询问的情况下执行操作。要撤销则需再次获得批准。"
          }
        }
      }
    },
