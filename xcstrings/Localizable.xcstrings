    "AIKeyHint.UnrecognizedHost" : {
      "comment" : "Hint shown when a manual AI model’s endpoint is not its provider’s own server (for example a third-party gateway), where the automatic API key choice sends no key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nicht automatisch ein API-Schlüssel gesendet, da dieser Endpunkt nicht vom Anbieter des Modells betrieben wird. Wählen Sie den benötigten Schlüssel aus oder verwenden Sie einen benutzerdefinierten Header."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No API key is sent automatically, since this endpoint is not run by the model’s provider. Choose the key it needs, or use a custom header."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía ninguna clave de API automáticamente, ya que este endpoint no lo gestiona el proveedor del modelo. Elige la clave que necesita o usa un encabezado personalizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé d’API n’est envoyée automatiquement, car ce point de terminaison n’est pas exploité par le fournisseur du modèle. Choisissez la clé requise ou utilisez un en-tête personnalisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene inviata alcuna chiave API automaticamente, perché questo endpoint non è gestito dal provider del modello. Scegli la chiave necessaria o usa un’intestazione personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンドポイントはモデルのプロバイダーが運営していないため、APIキーは自動では送信されません。必要なキーを選択するか、カスタムヘッダーを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 엔드포인트는 모델 제공업체가 운영하지 않으므로 API 키가 자동으로 전송되지 않습니다. 필요한 키를 선택하거나 사용자 지정 헤더를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de API é enviada automaticamente, pois este endpoint não é operado pelo provedor do modelo. Escolha a chave necessária ou use um cabeçalho personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API не отправляется автоматически, так как эта конечная точка не обслуживается поставщиком модели. Выберите нужный ключ или используйте пользовательский заголовок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uç nokta modelin sağlayıcısı tarafından işletilmediği için API anahtarı otomatik olarak gönderilmiyor. Gereken anahtarı seçin ya da özel bir üst bilgi kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于此端点并非由模型的提供商运营，因此不会自动发送 API 密钥。请选择它所需的密钥，或使用自定义头信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於此端點並非由模型的供應商營運，因此不會自動傳送 API 金鑰。請選擇它所需的金鑰，或使用自訂標頭。"
          }
        }
      }
    },
