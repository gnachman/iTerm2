    "ClaudeCodeOnboarding.ShowToolbeltDescription" : {
      "comment" : "Description of the show-toolbelt onboarding step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazte pás nástrojů a zapněte nástroj Stav relace. Pás nástrojů se zobrazí na pravé straně okna terminálu.\n\nPás nástrojů můžete zapnout nebo vypnout přes „Zobrazení > Pás nástrojů > Zobrazit pás nástrojů“ nebo zkratkou ⌘⇧B."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis værktøjsbæltet, og slå værktøjet Sessionsstatus til. Værktøjsbæltet vises i højre side af dit terminalvindue.\n\nDu kan slå værktøjsbæltet til/fra via Oversigt > Værktøjsbælte > Vis værktøjsbælte eller med genvejen ⌘⇧B."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Werkzeugkasten an und aktiviert das Werkzeug „Sitzungsstatus“. Der Werkzeugkasten erscheint auf der rechten Seite Ihres Terminalfensters.\n\nSie können den Werkzeugkasten über Ansicht > Werkzeugkasten > Werkzeugkasten anzeigen ein- oder ausblenden, oder mit dem Tastaturkürzel ⌘⇧B."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the toolbelt and enable the Session Status tool. The toolbelt appears on the right side of your terminal window.\n\nYou can toggle the toolbelt from View > Toolbelt > Show Toolbelt, or with the shortcut ⌘⇧B."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la caja de herramientas y activa la herramienta Estado de la sesión. La caja de herramientas aparece en el lado derecho de la ventana de la terminal.\n\nPuedes activarla o desactivarla desde Visualización > Caja de herramientas > Mostrar caja de herramientas, o con el atajo ⌘⇧B."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä työkaluvyö ja ota istunnon tila -työkalu käyttöön. Työkaluvyö tulee näkyviin päätteen ikkunan oikealle puolelle.\n\nVoit näyttää tai kätkeä työkaluvyön valikosta Näytä > Työkaluvyö > Näytä työkaluvyö tai oikotiellä ⌘⇧B."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez la boîte à outils et activez l’outil État des sessions. La boîte à outils apparaît sur le côté droit de la fenêtre du terminal.\n\nVous pouvez l’afficher ou la masquer via Présentation > Boîte à outils > Afficher la boîte à outils, ou avec le raccourci ⌘⇧B."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la cassetta attrezzi e abilita lo strumento Stato sessione. La cassetta attrezzi appare sul lato destro della finestra del terminale.\n\nPuoi attivarla o disattivarla da Vista > Cassetta attrezzi > Mostra cassetta attrezzi, o con l’abbreviazione ⌘⇧B."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールベルトを表示し、セッションステータスツールを有効にします。ツールベルトはターミナルウインドウの右側に表示されます。\n\nツールベルトの表示/非表示は、表示 > ツールベルト > ツールベルトを表示から切り替えるか、ショートカット⌘⇧Bを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 벨트를 보이고 세션 상태 도구를 활성화합니다. 도구 벨트는 터미널 윈도우의 오른쪽에 나타납니다.\n\n보기 > 도구 벨트 > 도구 벨트 보기에서 또는 단축키 ⌘⇧B로 도구 벨트를 켜고 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis verktøybeltet og aktiver verktøyet Øktstatus. Verktøybeltet vises på høyre side av terminalvinduet.\n\nDu kan slå verktøybeltet av/på fra «Vis > Verktøybelte > Vis verktøybelte», eller med snarveien ⌘⇧B."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de gereedschapsriem en schakel de tool Sessiestatus in. De gereedschapsriem verschijnt aan de rechterkant van je terminalvenster.\n\nJe kunt de gereedschapsriem in- of uitschakelen via Weergave > Gereedschapsriem > Toon gereedschapsriem, of met de toetscombinatie ⌘⇧B."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż pas narzędzi i włącz narzędzie „Stan sesji”. Pas narzędzi pojawia się po prawej stronie okna terminala.\n\nPas narzędzi możesz przełączać przez Widok > Pas narzędzi > Pokaż pas narzędzi lub skrótem ⌘⇧B."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre a barra de ferramentas e ative a ferramenta Status da sessão. A barra de ferramentas aparece no lado direito da janela do terminal.\n\nVocê pode alternar a barra de ferramentas em Visualizar > Barra de ferramentas > Mostrar barra de ferramentas, ou com o atalho ⌘⇧B."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покажите набор инструментов и включите инструмент «Статус сессии». Набор инструментов появляется в правой части окна терминала.\n\nПереключить набор инструментов можно через View > Toolbelt > Show Toolbelt или сочетанием клавиш ⌘⇧B."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť pás s nástrojmi a zapnúť nástroj Stav relácie. Pás s nástrojmi sa zobrazí na pravej strane okna terminálu.\n\nPás s nástrojmi môžete zapnúť alebo vypnúť cez menu „Zobraziť > Pás s nástrojmi > Zobraziť pás s nástrojmi“ alebo skratkou ⌘⇧B."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite pas z orodji in omogočite orodje Stanje seje. Pas z orodji se pojavi na desni strani okna terminala.\n\nPas z orodji lahko vklopite ali izklopite v »Prikaz > Pas z orodji > Prikaži pas z orodji« ali z bližnjico ⌘⇧B."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa verktygsbältet och aktivera verktyget Sessionsstatus. Verktygsbältet visas på höger sida av terminalfönstret.\n\nDu kan slå på/av verktygsbältet med Innehåll > Verktygsbälte > Visa verktygsbältet, eller med kortkommandot ⌘⇧B."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç kemerini gösterin ve Oturum Durumu aracını etkinleştirin. Araç kemeri terminal pencerenizin sağ tarafında görünür.\n\nAraç kemerini Görüntü > Araç Kemeri > Araç Kemerini Göster ile veya ⌘⇧B kısayoluyla açıp kapatabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị đai công cụ và bật công cụ Trạng thái phiên. Đai công cụ xuất hiện ở bên phải cửa sổ terminal của bạn.\n\nBạn có thể bật/tắt đai công cụ từ Xem > Đai công cụ > Hiển thị đai công cụ, hoặc bằng phím tắt ⌘⇧B."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示工具箱并启用“会话状态”工具。工具箱出现在终端窗口的右侧。\n\n你可以从 显示 > 工具箱 > 显示工具箱 切换工具箱，或使用快捷键 ⌘⇧B。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示工具帶並啟用「工作階段狀態」工具。工具帶會出現在終端機視窗的右側。\n\n你可以從「顯示方式 > 工具帶 > 顯示工具帶」切換工具帶，或使用快速鍵 ⌘⇧B。"
          }
        }
      }
    },
