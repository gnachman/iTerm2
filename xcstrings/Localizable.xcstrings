    "AdvancedSetting.selectsTabsOnMouseDown" : {
      "comment" : "Advanced setting: selectsTabsOnMouseDown",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybírat panely při stisknutí tlačítka myši?\nZměna tohoto nastavení neovlivní existující okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg faner ved museknap ned?\nÆndring af denne indstilling påvirker ikke eksisterende vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs bei Mausklick (Mouse-Down) auswählen?\nDas Ändern dieser Einstellung wirkt sich nicht auf bestehende Fenster aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select tabs on mouse-down?\nChanging this setting will not affect existing windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seleccionar pestañas al pulsar el botón del ratón?\nCambiar este ajuste no afectará a las ventanas existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitaanko välilehdet hiiren painalluksesta?\nTämän asetuksen muuttaminen ei vaikuta olemassa oleviin ikkunoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionner les onglets à l’appui sur le bouton de la souris ?\nLa modification de ce réglage n’affectera pas les fenêtres existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selezionare i pannelli alla pressione del pulsante del mouse?\nLa modifica di questa impostazione non influirà sulle finestre esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスボタンを押した時点でタブを選択するか？\nこの設定の変更は既存のウィンドウには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 누를 때 탭을 선택하겠습니까?\n이 설정을 변경해도 기존 윈도우에는 영향을 주지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg faner ved museknapp ned?\nEndring av denne innstillingen påvirker ikke eksisterende vinduer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbladen selecteren bij het indrukken van de muisknop?\nHet wijzigen van deze instelling heeft geen invloed op bestaande vensters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zaznaczać karty po naciśnięciu przycisku myszy?\nZmiana tego ustawienia nie wpłynie na istniejące okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar abas ao pressionar o mouse?\nAlterar este ajuste não afetará as janelas existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирать вкладки при нажатии кнопки мыши (mouse-down)?\nИзменение этого параметра не повлияет на уже открытые окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberať taby pri stlačení tlačidla myši?\nZmena tohto nastavenia neovplyvní existujúce okná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se zavihki izberejo ob pritisku miške?\nSprememba te nastavitve ne vpliva na obstoječa okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera flikar vid musnedtryckning?\nÄndringen av den här inställningen påverkar inte befintliga fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeler fare düğmesine basıldığında seçilsin mi?\nBu ayarı değiştirmek mevcut pencereleri etkilemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn tab khi nhấn chuột xuống?\nThay đổi cài đặt này sẽ không ảnh hưởng đến các cửa sổ hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠标按下时选择标签页？  \n更改此设置不会影响现有窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下滑鼠時選取標籤頁？\n變更此設定不會影響現有的視窗。"
          }
        }
      }
    },
    "AdvancedSetting.sensitiveScrollWheel" : {
      "comment" : "Advanced setting: sensitiveScrollWheel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posouvat při jakémkoli pohybu kolečka, i když je sebemenší?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rul ved enhver bevægelse af rullehjulet, uanset hvor lille?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jeder Mausradbewegung scrollen, egal wie klein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll on any scroll wheel movement, no matter how small?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Desplazar con cualquier movimiento de la rueda, por pequeño que sea?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vieritetäänkö mistä tahansa vierityskiekon liikkeestä, olipa se kuinka pieni tahansa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire défiler au moindre mouvement de la molette, même minime ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorrere a qualsiasi movimento della rotellina, per quanto piccolo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どんなに小さなスクロールホイールの動きでもスクロールするか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 휠이 아무리 조금 움직여도 스크롤하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rull ved enhver bevegelse av rullehjulet, uansett hvor liten?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollen bij elke beweging van het scrolwiel, hoe klein ook?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewijaj przy każdym ruchu kółka, bez względu na to, jak mały jest?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolar a qualquer movimento da roda de rolagem, por menor que seja?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокручивать при любом, даже самом малом, движении колеса мыши?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolovať pri akomkoľvek pohybe kolieska myši, nech je akokoľvek malý?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se pomika ob vsakem premiku kolesca, ne glede na to, kako majhen je?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulla vid varje rörelse av rullhjulet, hur liten den än är?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne kadar küçük olursa olsun her kaydırma tekerleği hareketinde kaydırılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn với mọi chuyển động của con lăn chuột, dù nhỏ đến đâu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论移动多小，使用滚动轮滚动时是否响应？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑鼠滾輪有任何移動就捲動，不論移動多小？"
          }
        }
      }
    },
    "AdvancedSetting.serializeOpeningMultipleFullScreenWindows" : {
      "comment" : "Advanced setting: serializeOpeningMultipleFullScreenWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při otevírání více oken v celé obrazovce přecházet do celé obrazovky po jednom okně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når flere vinduer åbnes i fuld skærm, skift til fuld skærm ét vindue ad gangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Öffnen mehrerer Vollbildfenster jeweils nur ein Fenster nach dem anderen in den Vollbildmodus versetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When opening multiple fullscreen windows, enter fullscreen one window at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al abrir varias ventanas en pantalla completa, entra en pantalla completa una ventana a la vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun avataan useita koko näytön ikkunoita, siirry koko näytön tilaan yksi ikkuna kerrallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de l’ouverture de plusieurs fenêtres en plein écran, passer en plein écran une fenêtre à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si aprono più finestre a tutto schermo, passa a tutto schermo una finestra alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のフルスクリーンウィンドウを開くとき、1つずつ順番にフルスクリーンにする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 개의 전체 화면 윈도우를 열 때 한 번에 하나씩 전체 화면으로 전환합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når flere fullskjermvinduer åpnes, gå til fullskjerm ett vindu om gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het openen van meerdere schermvullende vensters schakel je één venster tegelijk naar schermvullende weergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy otwieraniu wielu okien pełnoekranowych przechodź do trybu pełnoekranowego po jednym oknie naraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao abrir múltiplas janelas em tela cheia, entrar em tela cheia uma janela de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При открытии нескольких полноэкранных окон переводить их в полноэкранный режим по одному."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri otváraní viacerých okien na celej obrazovke prepínať na celú obrazovku po jednom okne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri odpiranju več celozaslonskih oken vstopi v celozaslonski način po eno okno naenkrat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När flera helskärmsfönster öppnas, gå in i helskärmsläge ett fönster i taget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden çok tam ekran pencere açılırken pencereleri tek tek tam ekrana geçir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi mở nhiều cửa sổ toàn màn hình, vào chế độ toàn màn hình từng cửa sổ một."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开多个全屏窗口时，一次仅打开一个全屏窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開多個全螢幕視窗時，一次只讓一個視窗進入全螢幕。"
          }
        }
      }
    },
    "AdvancedSetting.sessionEndMessageDividerCharacter" : {
      "comment" : "Advanced setting: sessionEndMessageDividerCharacter",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znak použitý pro dělicí čáry ve zprávách o ukončení relace. Ponechte prázdné pro zabezpečenou výchozí hodnotu (obrázek BrokenPipeDivider). Příklady: ━ ─ ═ ╌ ┄"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn til skillelinjer i meddelelser om sessionens afslutning. Lad feltet være tomt for at bruge den sikre standard (billedet BrokenPipeDivider). Eksempler: ━ ─ ═ ╌ ┄"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen für Trennlinien in Meldungen zum Sitzungsende. Leer lassen, um den sicheren Standard (BrokenPipeDivider-Bild) zu verwenden. Beispiele: ━ ─ ═ ╌ ┄"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Character to use for divider lines in session end messages. Leave empty to use secure default (BrokenPipeDivider image). Examples: ━ ─ ═ ╌ ┄"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carácter para las líneas divisorias en los mensajes de fin de sesión. Déjalo vacío para usar el valor seguro predeterminado (imagen BrokenPipeDivider). Ejemplos: ━ ─ ═ ╌ ┄"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunnon päättymisviestien jakajaviivoissa käytettävä merkki. Jätä tyhjäksi käyttääksesi turvallista oletusta (BrokenPipeDivider-kuva). Esimerkkejä: ━ ─ ═ ╌ ┄"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractère à utiliser pour les lignes de séparation dans les messages de fin de session. Laissez vide pour utiliser la valeur par défaut sécurisée (image BrokenPipeDivider). Exemples : ━ ─ ═ ╌ ┄"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carattere da usare per le righe divisorie nei messaggi di fine sessione. Lascia vuoto per usare il valore predefinito sicuro (immagine BrokenPipeDivider). Esempi: ━ ─ ═ ╌ ┄"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション終了メッセージの区切り線に使用する文字。空欄の場合は安全なデフォルト（BrokenPipeDivider画像）を使用します。例：━ ─ ═ ╌ ┄"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 종료 메시지의 구분선에 사용할 문자. 안전한 기본값(BrokenPipeDivider 이미지)을 사용하려면 비워 두십시오. 예: ━ ─ ═ ╌ ┄"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn som brukes til skillelinjer i meldinger om avsluttet økt. La stå tom for å bruke sikker standard (bildet BrokenPipeDivider). Eksempler: ━ ─ ═ ╌ ┄"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teken voor scheidingslijnen in sessie-eindberichten. Laat leeg voor de veilige standaardwaarde (afbeelding BrokenPipeDivider). Voorbeelden: ━ ─ ═ ╌ ┄"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znak używany w liniach separatora w komunikatach o zakończeniu sesji. Pozostaw puste, aby użyć bezpiecznej wartości domyślnej (obraz BrokenPipeDivider). Przykłady: ━ ─ ═ ╌ ┄"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractere a usar nas linhas divisórias das mensagens de fim de sessão. Deixe vazio para usar o padrão seguro (imagem BrokenPipeDivider). Exemplos: ━ ─ ═ ╌ ┄"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символ для линий-разделителей в сообщениях о завершении сеанса. Оставьте пустым, чтобы использовать безопасное значение по умолчанию (изображение BrokenPipeDivider). Примеры: ━ ─ ═ ╌ ┄"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znak použitý pre deliace čiary v správach o konci relácie. Ak chcete použiť zabezpečenú predvolenú hodnotu (obrázok BrokenPipeDivider), nechajte prázdne. Príklady: ━ ─ ═ ╌ ┄"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znak za ločilne črte v sporočilih o koncu seje. Pustite prazno za varno privzeto vrednost (slika BrokenPipeDivider). Primeri: ━ ─ ═ ╌ ┄"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tecken som används för avdelarlinjer i meddelanden om avslutade sessioner. Lämna tomt för att använda det säkra förvalet (bilden BrokenPipeDivider). Exempel: ━ ─ ═ ╌ ┄"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum sonu iletilerinde ayırıcı çizgiler için kullanılacak karakter. Güvenli varsayılanı (BrokenPipeDivider görüntüsü) kullanmak için boş bırakın. Örnekler: ━ ─ ═ ╌ ┄"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký tự dùng cho các dòng phân cách trong thông báo kết thúc phiên. Để trống để dùng mặc định an toàn (hình BrokenPipeDivider). Ví dụ: ━ ─ ═ ╌ ┄"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话结束消息中用于分隔线的字符。留空则使用默认安全分隔符（BrokenPipeDivider图像）。示例： ━ ─ ═ ╌ ┄"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段結束訊息中用於分隔線的字元。留空則使用安全的預設值（BrokenPipeDivider 圖像）。範例：━ ─ ═ ╌ ┄"
          }
        }
      }
    },
