    "AdvancedSetting.requireCmdForDraggingText" : {
      "comment" : "Advanced setting: requireCmdForDraggingText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Bilder oder ausgewählten Text zu ziehen, müssen Sie ⌘ gedrückt halten. Dies verhindert versehentliches Ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To drag images or selected text, you must hold ⌘. This prevents accidental drags."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像や選択したテキストをドラッグするには⌘を押しておく必要があります。これにより誤ったドラッグを防止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지나 선택한 텍스트를 드래그하려면 ⌘를 누르고 있어야 합니다. 실수로 드래그하는 것을 방지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para arrastar imagens ou texto selecionado, você precisa manter ⌘ pressionado. Isto evita arrastos acidentais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы перетаскивать изображения или выделенный текст, нужно удерживать ⌘. Это предотвращает случайные перетаскивания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动图片或选中文本时，必须按住⌘键。这可以防止意外拖动。"
          }
        }
      }
    },
    "AdvancedSetting.requireOptionToDragSplitPaneTitleBar" : {
      "comment" : "Advanced setting: requireOptionToDragSplitPaneTitleBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordern, dass die Wahltaste (Option) gedrückt wird, um einen Split-Bereich an seiner Titelleiste zu ziehen?\nDies hilft, versehentliches Ziehen zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Require Option to be pressed to drag a split pane by its title bar?\nThis helps prevent accidental drags."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインをタイトルバーからドラッグするにはOptionキーを押す必要がありますか？\nこれにより誤ったドラッグを防止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할된 패널을 제목 막대로 드래그하려면 Option 키를 눌러야 합니까?\n실수로 드래그하는 것을 방지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir que Option esteja pressionado para arrastar um painel dividido pela sua barra de título?\nIsto ajuda a evitar arrastos acidentais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требовать нажатия Option для перетаскивания разделённой панели за заголовок?\nЭто помогает предотвратить случайные перетаскивания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否要求按下Option键才能通过标题栏拖动分屏窗格？\n这有助于防止意外拖动。"
          }
        }
      }
    },
    "AdvancedSetting.requireSlashInURLGuess" : {
      "comment" : "Advanced setting: requireSlashInURLGuess",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Domainnamen mit zwei oder mehr Teilen nur dann als URL betrachten, wenn er auch einen Schrägstrich enthält.\nDiese Einstellung wird verwendet, um zu erraten, ob ein String für Semantic History eine URL ist. Wenn aktiviert, würde `example.com` nicht als URL gelten, `example.com/` hingegen schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only consider a two+ part domain-name to be a URL if it also contains a slash.\nThis setting is used when guessing if a string is a URL for semantic history. When enabled, `example.com` would not be considered a URL but `example.com/` would be."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つ以上のパートを持つドメイン名について、スラッシュも含まれる場合のみURLとみなす。\nこの設定はSemantic Historyの文字列がURLかどうかを推測する際に使用されます。有効にすると、`example.com`はURLとみなされませんが、`example.com/`はURLとみなされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 부분 이상으로 된 도메인 이름은 슬래시도 포함된 경우에만 URL로 간주합니다.\n이 설정은 시맨틱 히스토리에서 문자열이 URL인지 추측할 때 사용됩니다. 켜면 `example.com`은 URL로 간주되지 않지만 `example.com/`은 URL로 간주됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considerar um nome de domínio com duas ou mais partes como URL apenas se também contiver uma barra.\nEste ajuste é usado ao adivinhar se uma string é uma URL para o Semantic History. Quando ativado, `example.com` não seria considerado uma URL, mas `example.com/` seria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считать доменное имя из двух и более частей URL-адресом, только если оно также содержит косую черту.\nЭтот параметр используется при определении того, является ли строка URL-адресом для «Семантической истории». Если включено, `example.com` не будет считаться URL-адресом, а `example.com/` — будет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当域名包含斜杠时，才将其视为URL。\n此设置用于判断字符串是否为URL，以保留语义历史记录。启用后，`example.com`不会被视为URL，而`example.com/`会。"
          }
        }
      }
    },
    "AdvancedSetting.resetSGROnPrompt" : {
      "comment" : "Advanced setting: resetSGROnPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben an der Shell-Eingabeaufforderung zurücksetzen?\nVerwendet Shell Integration, um eine Shell-Eingabeaufforderung zu erkennen, und setzt bei Aktivierung die Farben auf ihre Standardwerte zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reset colors at shell prompt?\nUses shell integration to detect a shell prompt and, if enabled, resets colors to their defaults."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルプロンプトで色をリセットするか？\nShell Integrationを使ってシェルプロンプトを検出し、有効な場合は色をデフォルトにリセットします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 프롬프트에서 색상을 재설정하겠습니까?\n셸 통합을 사용하여 셸 프롬프트를 감지하고, 켜져 있으면 색상을 기본값으로 재설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefinir as cores no prompt do shell?\nUsa o Shell Integration para detectar um prompt do shell e, se ativado, redefine as cores para os padrões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбрасывать цвета в командной строке оболочки?\nИспользует Shell Integration для определения командной строки и, если включено, сбрасывает цвета к значениям по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在shell提示符下是否重置颜色？\n使用shell集成来检测shell提示符，若启用则将颜色重置为默认设置。"
          }
        }
      }
    },
