    "Tip.0077.Body" : {
      "comment" : "Tip of the day body, id 0077",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs können ein Symbol anzeigen, das die aktuelle Anwendung angibt. Konfigurieren Sie dies unter „Einstellungen > Profile > Allgemein > Symbol“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tabs can show an icon indicating the current application. Configure it in “Settings > Profiles > General > Icon.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pestañas pueden mostrar un icono que indique la aplicación actual. Configúralo en “Ajustes > Perfiles > General > Icono”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les onglets peuvent afficher une icône indiquant l’application actuelle. Configurez-la dans « Réglages > Profils > Général > Icône »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pannelli possono mostrare un’icona che indica l’applicazione corrente. Configurala in “Impostazioni > Profili > Generali > Icona”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブには現在のアプリケーションを示すアイコンを表示できます。「設定 > プロファイル > 一般 > アイコン」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭에 현재 응용 프로그램을 나타내는 아이콘을 표시할 수 있습니다. “설정 > 프로파일 > 일반 > 아이콘”에서 구성하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas podem exibir um ícone indicando o aplicativo atual. Configure isso em “Ajustes > Perfis > Geral > Ícone”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладки могут отображать значок, показывающий текущее приложение. Настройте это в «Настройки > Профили > Общие > Значок»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeler, geçerli uygulamayı belirten bir simge gösterebilir. “Ayarlar > Profiller > Genel > Simge” bölümünden yapılandırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页可以显示表示当前应用程序的图标。在“设置 > 配置文件 > 通用 > 图标”中进行配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁可以顯示代表目前應用程式的圖像。在「設定 > 描述檔 > 一般 > 圖像」中設定。"
          }
        }
      }
    },
