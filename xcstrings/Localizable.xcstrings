    "AdvancedSetting.translateScreenToXterm" : {
      "comment" : "Advanced setting: translateScreenToXterm",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporovat TERM=screen\nHlavně opravuje, že kurzíva nahrazuje inverzní text."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understøt TERM=screen\nDet løser især, at kursiv erstatter omvendt tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen unterstützen\nInsbesondere behebt dies, dass Kursivschrift invertierten Text ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support TERM=screen\nMost notably, this fixes italics replacing inverse text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admite TERM=screen\nSobre todo, corrige que las cursivas sustituyan al texto invertido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tue TERM=screen\nKorjaa erityisesti sen, että kursiivi korvaa käänteisen tekstin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre en charge TERM=screen\nCela corrige notamment l’italique qui remplaçait le texte inversé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporta TERM=screen\nIn particolare, risolve il problema del corsivo che sostituisce il testo invertito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screenをサポート\n特に、イタリック体が反転表示の代わりに使われる問題を修正します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen 지원\n특히 반전 텍스트 대신 이탤릭체가 표시되는 문제를 해결합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtt TERM=screen\nDette fikser særlig at kursiv erstatter invertert tekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondersteun TERM=screen\nDit verhelpt vooral dat cursief de omgekeerde tekst vervangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsługuj TERM=screen\nPrzede wszystkim naprawia zastępowanie tekstu odwróconego kursywą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar TERM=screen\nMais notavelmente, isso corrige o itálico substituindo o texto invertido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержка TERM=screen\nВ первую очередь это исправляет замену инверсного текста курсивом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podporovať TERM=screen\nPredovšetkým to opraví nahrádzanie inverzného textu kurzívou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpiraj TERM=screen\nTo predvsem popravi, da ležeče črke zamenjajo obrnjeno besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stöd TERM=screen\nDet åtgärdar framför allt att kursiv stil ersätter inverterad text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen desteği\nÖzellikle, ters metnin yerine italiklerin geçmesini düzeltir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỗ trợ TERM=screen\nĐáng chú ý nhất, điều này sửa lỗi chữ nghiêng thay thế văn bản đảo màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
