    "AISettings.CouldNotReachOllamaBody" : {
      "comment" : "Alert body shown when the local Ollama server can't be reached; %@ is the server endpoint URL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Ollama na adrese %@ se nepodařilo kontaktovat. Ujistěte se, že Ollama běží, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke kontakte Ollama-serveren på %@. Kontroller, at Ollama kører, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ollama-Server unter %@ konnte nicht erreicht werden. Stellen Sie sicher, dass Ollama läuft, und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not reach the Ollama server at %@. Make sure Ollama is running, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el servidor Ollama en %@. Asegúrate de que Ollama se está ejecutando e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama-palvelimeen osoitteessa %@ ei saatu yhteyttä. Varmista, että Ollama on käynnissä, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre le serveur Ollama à l’adresse %@. Vérifiez qu’Ollama est en cours d’exécution, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile contattare il server Ollama su %@. Assicurati che Ollama sia in esecuzione, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のOllamaサーバーに接続できませんでした。Ollamaが実行中であることを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Ollama 서버에 연결할 수 없습니다. Ollama가 실행 중인지 확인한 다음 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå Ollama-tjeneren på %@. Kontroller at Ollama kjører, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de Ollama-server op %@ niet bereiken. Controleer of Ollama draait en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z serwerem Ollama pod adresem %@. Upewnij się, że Ollama jest uruchomiona, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao servidor Ollama em %@. Certifique-se de que o Ollama esteja em execução e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к серверу Ollama по адресу %@. Убедитесь, что Ollama запущена, и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa kontaktovať server Ollama na adrese %@. Uistite sa, že Ollama beží, a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnika Ollama na naslovu %@ ni mogoče doseči. Preverite, ali se Ollama izvaja, in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte nå Ollama-servern på %@. Kontrollera att Ollama körs och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adresindeki Ollama sunucusuna ulaşılamadı. Ollama’nın çalıştığından emin olun ve yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối đến máy chủ Ollama tại %@. Hãy đảm bảo Ollama đang chạy, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
