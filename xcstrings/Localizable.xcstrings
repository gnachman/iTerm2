        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larghezza predefinita della tabulazione per le nuove sessioni.\nNota: questo comprometterà la visualizzazione in emacs e in altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいセッションのデフォルトのタブストップ幅。\n注意: これにより emacs などのアプリの描画が崩れます。"
          }
        },
        "ko" : {
