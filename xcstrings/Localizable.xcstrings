    "SuppressedAlerts.Explanation" : {
      "comment" : "Explanatory text at the top of the suppressed-alerts panel",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Warnungen werden automatisch beantwortet, da Sie sich entschieden haben, Ihre Antwort zu speichern. Wählen Sie eine aus und klicken Sie auf „Nicht mehr unterdrücken“, um wieder gefragt zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These alerts are being answered automatically because you chose to remember your response. Select one and click Un-suppress to be asked again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアラートは、応答を記憶させる設定にしたため自動的に応答されています。項目を選択して「抑制を解除」をクリックすると、再び確認されるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답을 기억하도록 선택했기 때문에 이 경고에는 자동으로 응답하고 있습니다. 다시 확인받으려면 항목을 선택하고 ‘숨김 해제’를 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes alertas estão sendo respondidos automaticamente porque você escolheu memorizar sua resposta. Selecione um e clique em Cancelar supressão para ser perguntado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На эти оповещения даются автоматические ответы, потому что вы решили запомнить свой выбор. Выберите одно из них и нажмите «Отменить подавление», чтобы снова получать запрос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些提醒会被自动应答，因为你选择了记住你的答复。请选择其中一个，然后点按“取消屏蔽”以再次询问。"
          }
        }
      }
    },
    "SuppressedAlerts.ExplanationWithAnnouncements" : {
      "comment" : "Explanatory text at the top of the suppressed-alerts panel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato upozornění a oznámení se zodpovídají automaticky nebo jsou skrytá, protože jste zvolili zapamatování odpovědi. Vyberte položku a kliknutím na Zrušit potlačení ji zobrazíte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse advarsler og meddelelser besvares automatisk eller skjules, fordi du valgte at huske dit svar. Vælg en, og klik på Vis igen for at se den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Warnungen und Hinweise werden automatisch beantwortet oder ausgeblendet, da Sie sich entschieden haben, Ihre Antwort zu speichern. Wählen Sie einen Eintrag aus und klicken Sie auf „Nicht mehr unterdrücken“, um ihn wieder zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These alerts and announcements are being answered automatically or hidden because you chose to remember your response. Select one and click Un-suppress to see it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas alertas y anuncios se responden automáticamente o se ocultan porque elegiste recordar tu respuesta. Selecciona uno y haz clic en Dejar de suprimir para volver a verlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä varoitukset ja ilmoitukset vastataan automaattisesti tai kätketään, koska valitsit muistaa vastauksesi. Valitse yksi ja klikkaa Poista vaimennus nähdäksesi sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces alertes et annonces reçoivent une réponse automatique ou sont masquées, car vous avez choisi de mémoriser votre réponse. Sélectionnez-en une et cliquez sur Réactiver pour la revoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi avvisi e annunci ricevono una risposta automatica o vengono nascosti perché hai scelto di ricordare la tua risposta. Selezionane uno e fai clic su Riattiva per vederlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアラートと通知は、応答を記憶させる設定にしたため、自動的に応答されているか非表示になっています。項目を選択して「抑制を解除」をクリックすると、再び表示されるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답을 기억하도록 선택했기 때문에 이 경고와 공지에는 자동으로 응답하거나 표시하지 않고 있습니다. 다시 보려면 항목을 선택하고 ‘숨김 해제’를 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse varslene og kunngjøringene besvares automatisk eller skjules fordi du valgte å huske svaret ditt. Velg ett og klikk på Vis igjen for å se det på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze waarschuwingen en aankondigingen worden automatisch beantwoord of verborgen omdat je ervoor hebt gekozen je antwoord te onthouden. Selecteer er een en klik op ‘Hef onderdrukking op’ om het weer te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te alerty i ogłoszenia są obsługiwane automatycznie lub ukrywane, ponieważ wybrano zapamiętanie odpowiedzi. Zaznacz jedno i kliknij „Przestań wyciszać”, aby zobaczyć je ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes alertas e avisos estão sendo respondidos automaticamente ou ocultados porque você escolheu memorizar sua resposta. Selecione um e clique em Cancelar supressão para vê-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На эти оповещения и уведомления даются автоматические ответы, или они скрыты, потому что вы решили запомнить свой выбор. Выберите одно из них и нажмите «Отменить подавление», чтобы снова его увидеть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto upozornenia a oznámenia sa vybavujú automaticky alebo sú skryté, pretože ste sa rozhodli zapamätať si svoju odpoveď. Vyberte jedno a kliknutím na Zrušiť potlačenie ho zobrazíte znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta opozorila in obvestila se samodejno odgovorijo ali skrijejo, ker ste izbrali, da se vaš odgovor zapomni. Izberite eno in kliknite »Prekliči utišanje«, da ga spet vidite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här varningarna och meddelandena besvaras automatiskt eller göms eftersom du valde att komma ihåg ditt svar. Markera en och klicka på Visa igen för att se den på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yanıtınızı hatırlamayı seçtiğiniz için bu uyarılar ve duyurular otomatik olarak yanıtlanıyor veya gizleniyor. Birini seçip yeniden görmek için Gizlemeyi Kaldır’a tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cảnh báo và thông báo này đang được trả lời tự động hoặc bị ẩn vì bạn đã chọn ghi nhớ phản hồi của mình. Chọn một mục và bấm Hiển thị lại để xem lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些提醒和提示会被自动应答或隐藏，因为你选择了记住你的答复。请选择其中一个，然后点按“取消屏蔽”以再次查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於你選擇了記住回應，這些警示和公告會自動回應或隱藏。請選取其中一項，然後按一下「恢復顯示」即可再次看到它。"
          }
        }
      }
    },
