    "SessionTitleView.LockedTooltip" : {
      "comment" : "Tooltip for the lock button on a locked pane",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich ist gesperrt. Er kann nicht verschoben, getauscht oder gezogen werden, und zum Schließen ist eine Bestätigung erforderlich. Klicken Sie mit der rechten Maustaste, um ihn zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This pane is locked. It cannot be moved, swapped, or dragged, and closing it requires confirmation. Right-click to unlock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este panel está bloqueado. No se puede mover, intercambiar ni arrastrar, y cerrarlo requiere confirmación. Haz clic con el botón derecho para desbloquearlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce volet est verrouillé. Il ne peut pas être déplacé, échangé ni glissé, et sa fermeture nécessite une confirmation. Cliquez avec le bouton droit pour le déverrouiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo riquadro è bloccato. Non può essere spostato, scambiato o trascinato e per chiuderlo è richiesta una conferma. Fai clic con il tasto destro per sbloccarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このペインはロックされています。移動、入れ替え、ドラッグはできず、閉じるには確認が必要です。ロックを解除するには右クリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패널은 잠겨 있습니다. 이동, 교체 또는 드래그할 수 없으며 닫으려면 확인이 필요합니다. 잠금을 해제하려면 오른쪽 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este painel está bloqueado. Ele não pode ser movido, trocado ou arrastado, e fechá-lo requer confirmação. Clique com o botão direito para desbloquear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта панель заблокирована. Её нельзя перемещать, менять местами или перетаскивать, а для закрытия требуется подтверждение. Щёлкните правой кнопкой мыши, чтобы разблокировать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölme kilitli. Taşınamaz, değiş tokuş edilemez veya sürüklenemez ve kapatmak onay gerektirir. Kilidini açmak için sağ tıklayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗格已锁定。它无法移动、交换或拖移，关闭时需要确认。右键点按可解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗格已鎖定。它無法移動、交換或拖移，且關閉時需要確認。按一下右鍵即可解鎖。"
          }
        }
      }
    },
