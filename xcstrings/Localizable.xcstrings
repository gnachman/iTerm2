    "Companion.InstallExplanation.CompanionOnly" : {
      "comment" : "Explanatory paragraph on the companion-only setup screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies installiert das Begleit-Plugin und aktiviert die Kopplung mit dem Begleitgerät. Danach kann iTerm2 Daten von diesem Mac senden, jedoch nur mit Ihrer ausdrücklichen Zustimmung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This installs the Companion plugin and turns on companion device pairing. Afterward, iTerm2 can send data off this Mac, but only with your explicit consent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりCompanionプラグインがインストールされ、コンパニオンデバイスのペアリングが有効になります。以降、iTerm2はこのMacからデータを送信できるようになりますが、それはあなたの明示的な同意がある場合に限られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언 플러그인을 설치하고 컴패니언 기기 페어링을 켭니다. 그 후 iTerm2는 이 Mac 밖으로 데이터를 보낼 수 있지만, 사용자가 명시적으로 동의한 경우에만 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto instala o plugin do Companion e ativa o pareamento com dispositivos companheiros. Depois disso, o iTerm2 pode enviar dados para fora deste Mac, mas somente com seu consentimento explícito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устанавливает плагин Компаньон и включает сопряжение с устройством-компаньоном. После этого iTerm2 сможет отправлять данные с этого Mac, но только с вашего явного согласия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将安装 Companion 插件并开启伴侣设备配对功能。之后，iTerm2 可以将数据发送到此 Mac 之外，但仅限在获得您明确同意的情况下。"
          }
        }
      }
    },
    "Companion.InstallExplanation.Full" : {
      "comment" : "Explanatory paragraph on the full setup screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies installiert die KI- und Begleit-Plugins und aktiviert beide Funktionen. Danach kann iTerm2 Daten von diesem Mac senden, jedoch nur mit Ihrer ausdrücklichen Zustimmung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This installs the AI and Companion plugins and turns on both features. Afterward, iTerm2 can send data off this Mac, but only with your explicit consent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これによりAIとCompanionの両プラグインがインストールされ、両方の機能が有効になります。以降、iTerm2はこのMacからデータを送信できるようになりますが、それはあなたの明示的な同意がある場合に限られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 및 컴패니언 플러그인을 설치하고 두 기능을 모두 켭니다. 이후 iTerm2는 이 Mac 외부로 데이터를 보낼 수 있지만, 사용자가 명시적으로 동의한 경우에만 보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto instala os plugins de IA e do Companion e ativa ambos os recursos. Depois disso, o iTerm2 pode enviar dados para fora deste Mac, mas somente com seu consentimento explícito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устанавливает плагины ИИ и Компаньон и включает обе функции. После этого iTerm2 сможет отправлять данные с этого Mac, но только с вашего явного согласия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将安装 AI 插件和 Companion 插件并开启这两项功能。之后，iTerm2 可以将数据发送到此 Mac 之外，但仅限在获得您明确同意的情况下。"
          }
        }
      }
    },
