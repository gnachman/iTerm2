    "APIHelper.RemoveNoAuthFailedMessage" : {
      "comment" : "Error message; first %@ is the file path, second %@ is the error description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor „%1$@“ se nepodařilo odstranit: %2$@\n\nOdstraňte tento soubor ručně, aby Python API vyžadovalo oprávnění Automatizace.\n\nPython API bylo z bezpečnostních důvodů vypnuto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke fjerne arkivet “%1$@”: %2$@\n\nFjern dette arkiv manuelt for at kræve tilladelsen Automatisering til Python API.\n\nPython API er slået fra af hensyn til din sikkerhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei „%1$@“ konnte nicht entfernt werden: %2$@\n\nBitte entfernen Sie diese Datei manuell, damit für die Python-API eine Automatisierungsberechtigung erforderlich ist.\n\nDie Python-API wurde zu Ihrer Sicherheit deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Failed to remove the file “%1$@”: %2$@\n\nPlease remove this file manually to require Automation permission for the Python API.\n\nThe Python API has been disabled for your security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo eliminar el archivo “%1$@”: %2$@\n\nElimina este archivo manualmente para exigir el permiso de Automatización para la API de Python.\n\nLa API de Python se ha desactivado por tu seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedoston ”%1$@” poistaminen epäonnistui: %2$@\n\nPoista tämä tiedosto itse, jotta Python API vaatii Automaatio-luvan.\n\nPython API on poistettu käytöstä turvallisuutesi vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la suppression du fichier « %1$@ » : %2$@\n\nSupprimez ce fichier manuellement pour exiger l’autorisation d’automatisation pour l’API Python.\n\nL’API Python a été désactivée pour votre sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile rimuovere il file “%1$@”: %2$@\n\nRimuovi manualmente questo file per richiedere l’autorizzazione di Automazione per l’API Python.\n\nL’API Python è stata disabilitata per la tua sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル「%1$@」の削除に失敗しました: %2$@\n\nPython APIにオートメーション権限を要求させるには、このファイルを手動で削除してください。\n\nセキュリティのため、Python APIは無効になりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 “%1$@”을(를) 제거하지 못했습니다: %2$@\n\nPython API에 자동화 권한을 요구하려면 이 파일을 직접 제거하십시오.\n\n보안을 위해 Python API가 비활성화되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke fjerne filen «%1$@»: %2$@\n\nFjern denne filen manuelt for å kreve Automatisering-tillatelse for Python-API-et.\n\nPython-API-et er deaktivert av hensyn til sikkerheten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderen van het bestand ‘%1$@’ is mislukt: %2$@\n\nVerwijder dit bestand handmatig om de toestemming Automatisering voor de Python-API te vereisen.\n\nDe Python-API is voor je veiligheid uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć pliku „%1$@”: %2$@\n\nUsuń ten plik ręcznie, aby wymagać uprawnienia Automatyzacja dla API Pythona.\n\nAPI Pythona zostało wyłączone ze względów bezpieczeństwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao remover o arquivo “%1$@”: %2$@\n\nRemova este arquivo manualmente para exigir a permissão de Automação para a API do Python.\n\nA API do Python foi desativada para sua segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить файл «%1$@»: %2$@\n\nУдалите этот файл вручную, чтобы для Python API снова требовалось разрешение Automation.\n\nВ целях безопасности Python API был отключён."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor „%1$@“ sa nepodarilo odstrániť: %2$@\n\nOdstráňte tento súbor ručne, aby sa pre Python API vyžadovalo povolenie Automatizácia.\n\nPython API bolo z bezpečnostných dôvodov vypnuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke »%1$@« ni bilo mogoče odstraniti: %2$@\n\nOdstranite to datoteko ročno, da bo za API Python spet zahtevano dovoljenje za avtomatizacijo.\n\nAPI Python je bil zaradi vaše varnosti onemogočen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte ta bort filen ”%1$@”: %2$@\n\nTa bort filen manuellt för att kräva behörigheten Automatisering för Python-API:et.\n\nPython-API:et har avaktiverats för din säkerhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” dosyası kaldırılamadı: %2$@\n\nPython API’si için Otomasyon izni gerekmesini sağlamak üzere bu dosyayı elle kaldırın.\n\nPython API’si güvenliğiniz için devre dışı bırakıldı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xóa tệp “%1$@”: %2$@\n\nHãy xóa tệp này theo cách thủ công để yêu cầu quyền Tự động hóa cho API Python.\n\nAPI Python đã bị tắt để bảo vệ bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法删除文件“%1$@”： %2$@\n\n请手动删除此文件，以便为Python API授予自动化权限。\n\n出于安全考虑，Python API已被禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法移除檔案「%1$@」：%2$@\n\n請手動移除此檔案，以便要求 Python API 取得「自動化」權限。\n\n為了你的安全，Python API 已被停用。"
          }
        }
      }
    },
