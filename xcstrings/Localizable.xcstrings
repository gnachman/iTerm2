            "value" : "V súbore dynamických profilov %@ nie je položka v „Profiles“ objektom (t. j. slovníkom), preto bola ignorovaná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V datoteki dinamičnih profilov %@ vnos v »Profiles« ni objekt (tj. slovar), zato je bil prezrt."
