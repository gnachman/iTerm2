            "state" : "translated",
            "value" : "Prihodnjič preskoči to pogovorno okno in takoj pošlji poziv."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa över den här dialogrutan i framtiden och skicka prompten direkt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iletişim kutusunu bundan sonra atla ve istemi hemen gönder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua hộp thoại này từ giờ và gửi lời nhắc ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以后跳过此对话框并立即发送提示。"
