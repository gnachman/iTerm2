    "PasswordArchive.AuthUnavailable" : {
      "comment" : "Shown when macOS can't authenticate the user before a password import or export. The placeholder is the system's reason.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemůže exportovat ani importovat hesla, protože macOS nemohl potvrdit vaši totožnost. %@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke eksportere eller importere adgangskoder, fordi macOS ikke kunne bekræfte din identitet. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann keine Passwörter exportieren oder importieren, weil macOS Ihre Identität nicht bestätigen konnte. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can’t export or import passwords because macOS couldn’t confirm your identity. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no puede exportar ni importar contraseñas porque macOS no pudo confirmar tu identidad. %@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei voi viedä tai tuoda salasanoja, koska macOS ei voinut vahvistaa henkilöllisyyttäsi. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne peut pas exporter ni importer de mots de passe, car macOS n’a pas pu confirmer votre identité. %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non può esportare né importare le password perché macOS non è riuscito a confermare la tua identità. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが本人確認を行えなかったため、iTerm2はパスワードをエクスポートまたはインポートできません。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 사용자 신원을 확인할 수 없어 iTerm2가 암호를 내보내거나 가져올 수 없습니다. %@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke eksportere eller importere passord fordi macOS ikke kunne bekrefte identiteten din. %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan geen wachtwoorden exporteren of importeren omdat macOS je identiteit niet kon bevestigen. %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie może eksportować ani importować haseł, ponieważ macOS nie mógł potwierdzić twojej tożsamości. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não pode exportar nem importar senhas porque o macOS não conseguiu confirmar sua identidade. %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может экспортировать или импортировать пароли, потому что macOS не удалось подтвердить вашу личность. %@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemôže exportovať ani importovať heslá, pretože macOS nedokázal potvrdiť vašu totožnosť. %@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne more izvoziti ali uvoziti gesel, ker macOS ni mogel potrditi vaše identitete. %@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan inte exportera eller importera lösenord eftersom macOS inte kunde bekräfta din identitet. %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kimliğinizi doğrulayamadığı için iTerm2 parolaları dışa veya içe aktaramıyor. %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 không thể xuất hoặc nhập mật khẩu vì macOS không xác nhận được danh tính của bạn. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法导出或导入密码，因为 macOS 无法确认你的身份。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法匯出或匯入密碼，因為 macOS 無法確認你的身分。%@"
          }
        }
      }
    },
    "PasswordArchive.Conflict" : {
      "comment" : "Asked when an imported password matches a saved one; the placeholders are the account name and the user name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené heslo pro účet „%1$@“ s uživatelským jménem „%2$@“ již existuje. Nahradit ho importovaným?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes allerede en gemt adgangskode til “%1$@” med brugernavnet “%2$@”. Vil du erstatte den med den importerede?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gespeichertes Passwort für „%1$@“ mit dem Benutzernamen „%2$@“ ist bereits vorhanden. Durch das importierte ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A saved password for “%1$@” with user name “%2$@” already exists. Replace it with the imported one?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe una contraseña guardada para “%1$@” con el nombre de usuario “%2$@”. ¿Reemplazarla por la importada?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilin ”%1$@” tallennettu salasana käyttäjätunnuksella ”%2$@” on jo olemassa. Korvataanko se tuodulla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot de passe enregistré pour « %1$@ » avec le nom d’utilisateur « %2$@ » existe déjà. Le remplacer par celui importé ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già una password salvata per “%1$@” con nome utente “%2$@”. Vuoi sostituirla con quella importata?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」のユーザー名「%2$@」の保存済みパスワードがすでに存在します。インポートしたパスワードで置き換えますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름이 “%2$@”인 “%1$@”의 저장된 암호가 이미 있습니다. 가져온 암호로 대치하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes allerede et lagret passord for «%1$@» med brukernavnet «%2$@». Vil du erstatte det med det importerte?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een bewaard wachtwoord voor ‘%1$@’ met gebruikersnaam ‘%2$@’. Wil je het vervangen door het geïmporteerde wachtwoord?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane hasło dla konta „%1$@” z nazwą użytkownika „%2$@” już istnieje. Zastąpić je importowanym?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe uma senha salva para “%1$@” com o nome de usuário “%2$@”. Substituí-la pela importada?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый пароль для «%1$@» с именем пользователя «%2$@» уже существует. Заменить его импортированным?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené heslo pre „%1$@“ s užívateľským menom „%2$@“ už existuje. Nahradiť ho importovaným?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjeno geslo za »%1$@« z uporabniškim imenom »%2$@« že obstaja. Ga želite zamenjati z uvoženim?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett sparat lösenord för ”%1$@” med användarnamnet ”%2$@” finns redan. Vill du ersätta det med det importerade?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” için “%2$@” kullanıcı adıyla kaydedilmiş bir parola zaten var. İçe aktarılanla değiştirilsin mi?"
          }
        },
        "vi" : {
