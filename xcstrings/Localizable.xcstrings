    "Tip.0079.Body" : {
      "comment" : "Tip of the day body, id 0079",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stisknutím ⇧⌘. otevřete editor příkazů. Poskytuje poznámkový blok pro úpravu příkazu před jeho odesláním do shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på ⇧⌘. for at åbne kommandoeditoren. Den giver dig en notesblok til at redigere en kommando, før den sendes til shellen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⇧⌘., um den Composer zu öffnen. Er bietet Ihnen einen Entwurfsbereich, um einen Befehl zu bearbeiten, bevor Sie ihn an die Shell senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⇧⌘. to open the Composer. It gives you a scratchpad to edit a command before sending it to the shell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⇧⌘. para abrir el compositor. Te ofrece un bloc de notas para editar un comando antes de enviarlo al shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa komentoeditori painamalla ⇧⌘. Se tarjoaa muistiotilan, jossa voit muokata komentoa ennen sen lähettämistä komentotulkille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⇧⌘. pour ouvrir le compositeur. Il offre un bloc-notes pour modifier une commande avant de l’envoyer au shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi ⇧⌘. per aprire il Compositore. Ti offre un blocco appunti per modificare un comando prima di inviarlo alla shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘.を押すとコンポーザーが開きます。シェルに送信する前にコマンドを編集できるスクラッチパッドです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌘.를 누르면 컴포저가 열립니다. 명령을 셸로 보내기 전에 편집할 수 있는 임시 작업 공간입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på ⇧⌘. for å åpne kommandoskriveren. Den gir deg en kladdeblokk for å redigere en kommando før den sendes til skallet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op ⇧⌘. om de Opsteller te openen. Die geeft je een kladblok om een commando te bewerken voordat je het naar de shell stuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij ⇧⌘., aby otworzyć Edytor poleceń. Daje ci brudnopis do edycji polecenia przed wysłaniem go do powłoki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⇧⌘. para abrir o Compositor. Ele oferece um rascunho para editar um comando antes de enviá-lo ao shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⇧⌘., чтобы открыть Композер. Он предоставляет черновик для редактирования команды перед отправкой её в оболочку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačením ⇧⌘. otvoríte Editor príkazov. Poskytuje pracovnú plochu na úpravu príkazu pred odoslaním do shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisnite ⇧⌘., da odprete urejevalnik ukazov. Ponuja vam območje za osnutke, kjer lahko ukaz uredite, preden ga pošljete lupini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ⇧⌘. för att öppna kommandoredigeraren. Den ger dig ett kladdblock för att redigera ett kommando innan det skickas till skalet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucu’yu açmak için ⇧⌘. tuşlarına basın. Bir komutu kabuğa göndermeden önce düzenlemeniz için bir karalama alanı sunar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn ⇧⌘. để mở Trình soạn lệnh. Nó cung cấp một bảng nháp để sửa lệnh trước khi gửi đến shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下 ⇧⌘ 可打开 Composer。它提供了一个编辑区域，用于在将命令发送到 shell之前进行修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ⇧⌘. 可打開編寫器。它提供一塊草稿區，讓你在將指令傳送給 shell 之前先編輯。"
          }
        }
      }
    },
