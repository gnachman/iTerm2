    "Tip.0049.Body" : {
      "comment" : "Tip of the day body, id 0049",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⇧⌥⌘ a přetáhněte relaci do jiné relace, čímž vytvoříte nebo změníte rozdělená podokna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold ⇧⌥⌘ nede, og træk en session ind i en anden session for at oprette eller ændre opdelte ruder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⇧⌥⌘ gedrückt und ziehen Sie eine Sitzung in eine andere, um geteilte Bereiche zu erstellen oder zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⇧⌥⌘ and drag a session into another session to create or change split panes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas ⇧⌥⌘ y arrastra una sesión sobre otra para crear o cambiar paneles divididos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ⇧⌥⌘ painettuna ja vedä istunto toisen istunnon päälle luodaksesi tai muuttaaksesi jaettuja paneeleja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⇧⌥⌘ et faites glisser une session sur une autre session pour créer ou modifier des volets scindés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⇧⌥⌘ e trascina una sessione su un’altra sessione per creare o modificare i riquadri divisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌥⌘を押しながらセッションを別のセッションにドラッグすると、分割ペインを作成したり変更したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌥⌘를 누른 채 세션을 다른 세션으로 드래그하여 분할 패널을 만들거나 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede ⇧⌥⌘ og dra en økt til en annen økt for å opprette eller endre delte ruter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ⇧⌥⌘ ingedrukt en sleep een sessie naar een andere sessie om gesplitste panelen te maken of te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ⇧⌥⌘ i przeciągnij sesję do innej sesji, aby utworzyć lub zmienić podział na panele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⇧⌥⌘ pressionado e arraste uma sessão para outra sessão para criar ou alterar painéis divididos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⇧⌥⌘ и перетащите одну сессию в другую, чтобы создать или изменить разделённые панели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte ⇧⌥⌘ a potiahnite reláciu do inej relácie, čím vytvoríte alebo zmeníte rozdelené panely."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite ⇧⌥⌘ in povlecite sejo v drugo sejo, da ustvarite ali spremenite razdeljena podokna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned ⇧⌥⌘ och dra en session till en annan session för att skapa eller ändra delade paneler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölme oluşturmak veya değiştirmek için ⇧⌥⌘ tuşlarını basılı tutup bir oturumu başka bir oturumun üzerine sürükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ ⇧⌥⌘ và kéo một phiên vào phiên khác để tạo hoặc thay đổi khung chia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⇧⌥⌘ 键并拖动一个会话到另一个会话中，可创建或更改分屏窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⇧⌥⌘ 並將一個工作階段拖移到另一個工作階段中，即可建立或變更分割窗格。"
          }
        }
      }
    },
