    "MenuTip.InstallPythonRuntime" : {
      "comment" : "Menu item help for the ‘Install Python Runtime’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běhové prostředí Pythonu pro iTerm2 je velký binární balíček (stovky MB), který zprovozní rozhraní Python API tím, že nainstaluje předpřipravené prostředí Pythonu, jež mohou skripty používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-kørselsmiljøet i iTerm2 er en stor binær pakke (hundredvis af MB), der slår Python API til ved at installere et færdigbygget Python-miljø, som instrukser kan bruge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2s Python-Runtime ist ein großes Binärpaket (mehrere hundert MB), das die Python-API aktiviert, indem es eine vorgefertigte Python-Umgebung installiert, die Skripte verwenden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2’s Python Runtime is a large binary package (hundreds of MBs) that enables the Python API by installing a pre-built Python environment that scripts can use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entorno de ejecución de Python de iTerm2 es un paquete binario grande (cientos de MB) que activa la API de Python instalando un entorno de Python precompilado que los scripts pueden usar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:n Python-suoritusympäristö on suuri binääripaketti (satoja Mt), joka mahdollistaa Python API:n asentamalla valmiiksi rakennetun Python-ympäristön, jota skriptit voivat käyttää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement d’exécution Python d’iTerm2 est un volumineux paquet binaire (des centaines de Mo) qui active l’API Python en installant un environnement Python préconstruit que les scripts peuvent utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente di esecuzione Python di iTerm2 è un grande pacchetto binario (centinaia di MB) che abilita l’API Python installando un ambiente Python precompilato utilizzabile dagli script."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2のPythonランタイムは、スクリプトが使用できるビルド済みのPython環境をインストールすることでPython APIを有効にする、大きなバイナリパッケージ（数百MB）です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2의 Python 런타임은 스크립트가 사용할 수 있는 미리 빌드된 Python 환경을 설치하여 Python API를 사용할 수 있게 하는 대용량 바이너리 패키지(수백 MB)입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2s Python-kjøremiljø er en stor binær pakke (hundrevis av MB) som aktiverer Python API ved å installere et ferdigbygd Python-miljø som skript kan bruke."
