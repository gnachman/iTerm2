    "AdvancedSetting.warnAboutSecureKeyboardInputWithOpenCommand" : {
      "comment" : "Advanced setting: warnAboutSecureKeyboardInputWithOpenCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
