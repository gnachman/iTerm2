      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je rozvržení okna zamknuté, nelze v něm přidávat, zavírat, přeuspořádávat, přetahovat ani přesouvat panely a podokna do jiného okna, takže ho náhodné kliknutí nebo tažení nemůže změnit. Změna velikosti podoken, otevírání nových oken a zavření okna fungují dál. Je to alternativa k volbě „Zamknout velikost“; zapnutí jedné volby vypne druhou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et vinduesarrangement er låst, kan dets faner og ruder ikke tilføjes, lukkes, omarrangeres, trækkes eller flyttes til et andet vindue, så et vildfarent klik eller træk ikke kan ændre det. Du kan stadig ændre størrelsen på ruder, åbne nye vinduer og lukke vinduet. Dette er et alternativ til Lås størrelse. Når du slår det ene til, slås det andet fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Layout eines Fensters gesperrt ist, können seine Tabs und Bereiche nicht hinzugefügt, geschlossen, neu angeordnet, gezogen oder in ein anderes Fenster verschoben werden, sodass ein versehentlicher Klick oder Ziehvorgang es nicht durcheinanderbringen kann. Die Größe von Bereichen zu ändern, neue Fenster zu öffnen und das Fenster zu schließen funktioniert weiterhin. Dies ist eine Alternative zu „Größe sperren“; wenn eine Option aktiviert wird, wird die andere deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When a window’s layout is locked, its tabs and panes can’t be added, closed, reordered, dragged, or moved to another window, so a stray click or drag can’t rearrange it. Resizing panes, opening new windows, and closing the window still work. This is an alternative to Lock Size; turning one on turns the other off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el diseño de una ventana está bloqueado, sus pestañas y paneles no se pueden añadir, cerrar, reordenar, arrastrar ni mover a otra ventana, de modo que un clic o arrastre accidental no pueda reorganizarla. Cambiar el tamaño de los paneles, abrir ventanas nuevas y cerrar la ventana siguen funcionando. Es una alternativa a Bloquear tamaño; activar una desactiva la otra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ikkunan asettelu on lukittu, sen välilehtiä ja paneeleita ei voi lisätä, sulkea, järjestää uudelleen, vetää tai siirtää toiseen ikkunaan, joten vahingossa tehty klikkaus tai veto ei voi järjestellä sitä uudelleen. Paneelien koon muuttaminen, uusien ikkunoiden avaaminen ja ikkunan sulkeminen toimivat edelleen. Tämä on vaihtoehto Lukitse koko -asetukselle; toisen ottaminen käyttöön poistaa toisen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la disposition d’une fenêtre est verrouillée, ses onglets et volets ne peuvent pas être ajoutés, fermés, réorganisés, glissés ni déplacés vers une autre fenêtre, de sorte qu’un clic ou un glissement accidentel ne puisse pas la modifier. Le redimensionnement des volets, l’ouverture de nouvelles fenêtres et la fermeture de la fenêtre restent possibles. C’est une alternative à Verrouiller la taille ; activer l’une désactive l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il layout di una finestra è bloccato, i suoi pannelli e riquadri non possono essere aggiunti, chiusi, riordinati, trascinati o spostati in un’altra finestra, così un clic o un trascinamento accidentale non può riorganizzarla. Ridimensionare i riquadri, aprire nuove finestre e chiudere la finestra continuano a funzionare. È un’alternativa a Blocca dimensione; attivarne una disattiva l’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのレイアウトがロックされている場合、そのタブとペインは追加、閉じる、並べ替え、ドラッグ、他のウインドウへの移動ができなくなるため、誤ったクリックやドラッグでレイアウトが崩れることはありません。ペインのサイズ変更、新しいウインドウを開く、ウインドウを閉じる操作は引き続き行えます。これは「サイズをロック」の代替機能であり、一方を有効にすると他方は無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 레이아웃이 잠겨 있으면 탭과 패널을 추가, 닫기, 순서 변경, 드래그하거나 다른 윈도우로 이동할 수 없으므로 실수로 클릭하거나 드래그해도 배열이 바뀌지 않습니다. 패널 크기 조절, 새로운 윈도우 열기, 윈도우 닫기는 계속 작동합니다. 크기 잠금의 대안이며, 하나를 켜면 다른 하나는 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et vindus oppsett er låst, kan faner og ruter ikke legges til, lukkes, omorganiseres, dras eller flyttes til et annet vindu, slik at et utilsiktet klikk eller en utilsiktet dra-handling ikke kan omorganisere det. Du kan fortsatt endre størrelse på ruter, åpne nye vinduer og lukke vinduet. Dette er et alternativ til Lås størrelse. Når du slår på det ene, slås det andre av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de lay-out van een venster is vergrendeld, kunnen de tabbladen en panelen niet worden toegevoegd, gesloten, opnieuw gerangschikt, gesleept of naar een ander venster verplaatst, zodat een verkeerde klik of sleepbeweging de lay-out niet kan wijzigen. Het formaat van panelen wijzigen, nieuwe vensters openen en het venster sluiten blijft wel mogelijk. Dit is een alternatief voor ‘Vergrendel grootte’; als je de ene inschakelt, wordt de andere uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy układ okna jest zablokowany, jego kart i paneli nie można dodawać, zamykać, zmieniać kolejności, przeciągać ani przenosić do innego okna, więc przypadkowe kliknięcie lub przeciągnięcie go nie zmieni. Zmiana rozmiaru paneli, otwieranie nowych okien i zamykanie okna nadal działają. To alternatywa dla opcji „Zablokuj rozmiar”; włączenie jednej wyłącza drugą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o layout de uma janela está bloqueado, suas abas e painéis não podem ser adicionados, fechados, reordenados, arrastados ou movidos para outra janela, de modo que um clique ou arrasto acidental não pode rearranjá-la. Redimensionar painéis, abrir novas janelas e fechar a janela ainda funcionam. Esta é uma alternativa a Bloquear tamanho; ativar uma desativa a outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда раскладка окна заблокирована, её вкладки и панели нельзя добавлять, закрывать, менять местами, перетаскивать или перемещать в другое окно, поэтому случайный щелчок или перетаскивание не могут её изменить. Изменение размера панелей, открытие новых окон и закрытие окна по-прежнему работают. Это альтернатива функции «Заблокировать размер»: включение одной функции отключает другую."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je rozloženie okna zamknuté, jeho taby a panely nemožno pridávať, zatvárať, meniť ich poradie, ťahať ani presúvať do iného okna, takže ho náhodné kliknutie alebo potiahnutie nemôže zmeniť. Zmena veľkosti panelov, otváranie nových okien a zatváranie okna naďalej fungujú. Je to alternatíva k funkcii Zamknúť veľkosť; zapnutím jednej sa druhá vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je postavitev okna zaklenjena, zavihkov in podoken ni mogoče dodajati, zapirati, prerazporejati, vleči ali premikati v drugo okno, zato je naključen klik ali vlečenje ne more spremeniti. Spreminjanje velikosti podoken, odpiranje novih oken in zapiranje okna še vedno delujejo. To je alternativa možnosti Zakleni velikost; vklop ene izklopi drugo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ett fönsters layout är låst kan dess flikar och paneler inte läggas till, stängas, ordnas om, dras eller flyttas till ett annat fönster, så att ett oavsiktligt klick eller drag inte kan ändra den. Det går fortfarande att ändra panelernas storlek, öppna nya fönster och stänga fönstret. Det här är ett alternativ till Lås storlek; när du slår på det ena stängs det andra av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencerenin düzeni kilitliyken sekmeleri ve bölmeleri eklenemez, kapatılamaz, yeniden sıralanamaz, sürüklenemez veya başka bir pencereye taşınamaz; böylece yanlışlıkla yapılan bir tıklama veya sürükleme düzeni bozamaz. Bölmeleri yeniden boyutlandırma, yeni pencere açma ve pencereyi kapatma yine çalışır. Bu, Boyutu Kilitle’ye bir alternatiftir; birini açmak diğerini kapatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bố cục của cửa sổ bị khóa, không thể thêm, đóng, sắp xếp lại, kéo các tab và khung của nó hoặc di chuyển chúng sang cửa sổ khác, nên một cú bấm hay kéo nhầm không thể làm xáo trộn bố cục. Vẫn có thể thay đổi kích thước khung, mở cửa sổ mới và đóng cửa sổ. Đây là lựa chọn thay thế cho Khóa kích thước; bật cái này sẽ tắt cái kia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当窗口的布局被锁定后，其标签页和窗格无法添加、关闭、重新排序、拖动或移动到其他窗口中，因此随意点击或拖拽也无法改变其排列。调整窗格大小、打开新窗口以及关闭窗口仍然有效。这是“锁定尺寸”的替代方案；开启其中一个会同时关闭另一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定視窗的版面配置後，其標籤頁與窗格無法被加入、關閉、重新排序、拖移或移至其他視窗，因此誤按或誤拖不會改動版面配置。調整窗格大小、打開新視窗和關閉視窗仍可使用。這是鎖定大小的替代方案；開啟其中一個會關閉另一個。"
          }
        }
      }
    },
    "MenuTip.LockLocation" : {
      "comment" : "Menu item help for the ‘Lock Location’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je poloha okna zamknutá, vrátí se okno na displej a pozici, které mělo při zamknutí, pokud ho něco přesune. Styly oken, které vyplňují obrazovku nebo se k ní připojují, například Maximalizované, Na střed a styly nahoře, dole, vlevo a vpravo, si zachovají obvyklý tvar a jsou vázány ke svému displeji. Pokud je tento displej odpojen, například když notebook přejde do režimu spánku, okno počká a vrátí se, jakmile se displej vrátí. Přetažením okna ho odemknete. Upozornění: macOS umístí vracející se okno na plochu, kterou jeho displej právě zobrazuje, a ta nemusí být stejná, na které okno začínalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et vindues placering er låst, vender det tilbage til den skærm og position, det havde, da du låste det, hvis noget flytter det. Vinduesstile, der fylder eller fæstner sig til skærmen, f.eks. Maksimeret, Centreret og stilene øverst, nederst, til venstre og til højre, beholder deres sædvanlige form og holdes i stedet på deres skærm. Hvis skærmen frakobles, som når en bærbar går i dvale, venter vinduet og vender tilbage, når skærmen kommer igen. Hvis du trækker i vinduet, låses det op. Bemærk, at macOS placerer et vindue, der vender tilbage, på det skrivebord, som skærmen aktuelt viser, og det er ikke nødvendigvis det, det startede på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Position eines Fensters gesperrt ist, kehrt es zu dem Display und der Position zurück, die es beim Sperren hatte, falls irgendetwas es verschiebt. Fensterstile, die den Bildschirm füllen oder sich an ihm ausrichten, etwa Maximiert, Zentriert sowie die Stile oben, unten, links und rechts, behalten ihre gewohnte Form und werden stattdessen an ihrem Display festgehalten. Ist dieses Display getrennt, wie es beim Ruhezustand eines Laptops vorkommt, wartet das Fenster und kehrt zurück, sobald das Display wieder verfügbar ist. Durch Ziehen des Fensters wird die Sperre aufgehoben. Beachten Sie, dass macOS ein zurückkehrendes Fenster auf demjenigen Space platziert, der auf seinem Display gerade angezeigt wird, und das muss nicht der Space sein, auf dem es ursprünglich war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When a window’s location is locked, it returns to the display and position it had when you locked it if anything moves it. Window styles that fill or attach to the screen, such as Maximized, Centered, and the top, bottom, left, and right styles, keep their usual shape and are held to their display instead. If that display is disconnected, as happens when a laptop sleeps, the window waits and goes back when the display returns. Dragging the window unlocks it. Note that macOS puts a returning window on whatever Space its display is currently showing, which may not be the Space it started on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la ubicación de una ventana está bloqueada, si algo la mueve, vuelve a la pantalla y la posición que tenía cuando la bloqueaste. Los estilos de ventana que llenan la pantalla o se acoplan a ella, como Maximizada, Centrada y los estilos superior, inferior, izquierdo y derecho, conservan su forma habitual y quedan sujetos a su pantalla. Si esa pantalla se desconecta, como ocurre cuando un portátil entra en reposo, la ventana espera y vuelve cuando la pantalla regresa. Al arrastrar la ventana se desbloquea. Ten en cuenta que macOS coloca una ventana que regresa en el espacio que su pantalla esté mostrando en ese momento, que puede no ser el espacio en el que empezó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ikkunan sijainti on lukittu, se palaa siihen näyttöön ja paikkaan, jossa se oli lukitessasi sen, jos jokin siirtää sitä. Ikkunatyylit, jotka täyttävät näytön tai kiinnittyvät siihen, kuten Suurennettu, Keskitetty sekä ylä-, ala-, vasen- ja oikeatyylit, säilyttävät tavallisen muotonsa ja pysyvät näytössään. Jos kyseinen näyttö irrotetaan, kuten kannettavan siirtyessä lepotilaan, ikkuna odottaa ja palaa, kun näyttö palaa. Ikkunan vetäminen avaa lukituksen. Huomaa, että macOS sijoittaa palaavan ikkunan sille työpöydälle, jota sen näyttö parhaillaan näyttää, ja se ei välttämättä ole työpöytä, jolla ikkuna alun perin oli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l’emplacement d’une fenêtre est verrouillé, elle retourne à l’écran et à la position qu’elle avait au moment du verrouillage si quelque chose la déplace. Les styles de fenêtre qui remplissent l’écran ou s’y fixent, comme Agrandie, Centré et les styles haut, bas, gauche et droite, conservent leur forme habituelle et restent liés à leur écran. Si cet écran est déconnecté, par exemple quand un portable se met en veille, la fenêtre attend et revient quand l’écran réapparaît. Faire glisser la fenêtre la déverrouille. Notez que macOS place une fenêtre qui revient sur l’espace actuellement affiché par son écran, qui peut ne pas être celui d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la posizione di una finestra è bloccata, se qualcosa la sposta, la finestra torna sul display e nella posizione che aveva al momento del blocco. Gli stili di finestra che riempiono lo schermo o vi si agganciano, come Ingrandita, Centrata e quelli in alto, in basso, a sinistra e a destra, mantengono la loro forma abituale e restano vincolati al proprio display. Se quel display viene scollegato, ad esempio quando un portatile entra in stop, la finestra attende e torna al ritorno del display. Trascinare la finestra la sblocca. Nota che macOS porta una finestra che ritorna sullo spazio attualmente mostrato dal suo display, che potrebbe non essere quello da cui era partita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの位置をロックすると、何かがウインドウを動かした場合でも、ロックした時点のディスプレイと位置に戻ります。画面全体を占めたり画面の端に固定されたりするウインドウスタイル（最大化、中央揃え、上、下、左、右のスタイルなど）は、通常の形状を保ったまま、代わりに元のディスプレイに固定されます。ノートブックがスリープしたときのようにそのディスプレイが切断されている場合、ウインドウは待機し、ディスプレイが戻ったときに元の位置に戻ります。ウインドウをドラッグするとロックは解除されます。なお、macOSは戻ってきたウインドウを、そのディスプレイが現在表示しているスペースに配置するため、元のスペースとは異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 위치가 잠겨 있으면, 무언가가 윈도우를 이동시켜도 잠갔을 때의 디스플레이와 위치로 되돌아갑니다. 최대화, 가운데, 위쪽, 아래쪽, 왼쪽, 오른쪽 스타일처럼 화면을 채우거나 화면에 붙는 윈도우 스타일은 평소 모양을 유지하면서 해당 디스플레이에 고정됩니다. 노트북이 잠자기에 들어갈 때처럼 해당 디스플레이의 연결이 끊어지면, 윈도우는 기다렸다가 디스플레이가 다시 연결되면 돌아갑니다. 윈도우를 드래그하면 잠금이 해제됩니다. macOS는 돌아오는 윈도우를 해당 디스플레이가 현재 보여 주는 Space에 배치하므로, 원래 있던 Space가 아닐 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et vindus plassering er låst, går det tilbake til skjermen og posisjonen det hadde da du låste det, hvis noe flytter det. Vindusstiler som fyller eller festes til skjermen, som Maksimert, Sentrert og stilene øverst, nederst, til venstre og til høyre, beholder sin vanlige form og holdes på skjermen sin i stedet. Hvis skjermen kobles fra, for eksempel når en bærbar datamaskin går i dvale, venter vinduet og går tilbake når skjermen kommer tilbake. Merk at macOS legger et vindu som kommer tilbake på det arbeidsområdet skjermen viser akkurat da, som ikke nødvendigvis er det vinduet startet på. Hvis du drar vinduet, låses det opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de locatie van een venster is vergrendeld, keert het venster terug naar het beeldscherm en de positie van het moment waarop je het vergrendelde, als iets het verplaatst. Vensterstijlen die het scherm vullen of eraan vastzitten, zoals ‘Gemaximaliseerd’, ‘Gecentreerd’ en de stijlen voor boven, onder, links en rechts, behouden hun gebruikelijke vorm en blijven op hun beeldscherm staan. Als dat beeldscherm is losgekoppeld, bijvoorbeeld wanneer een laptop in de sluimerstand gaat, wacht het venster en keert het terug zodra het beeldscherm weer beschikbaar is. Als je het venster sleept, wordt de vergrendeling opgeheven. Let op: macOS plaatst een terugkerend venster in de Space die op dat moment op het beeldscherm wordt getoond. Dat is mogelijk niet de Space waar het venster oorspronkelijk stond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy położenie okna jest zablokowane, jeśli cokolwiek je przesunie, wraca ono na ekran i w miejsce, w którym było w chwili zablokowania. Style okien wypełniających ekran lub dołączonych do niego, takie jak Zmaksymalizowane, Wyśrodkowane oraz style górne, dolne, lewe i prawe, zachowują zwykły kształt i są przypisane do swojego ekranu. Jeśli ten ekran zostanie odłączony, jak dzieje się po uśpieniu laptopa, okno czeka i wraca, gdy ekran się pojawi. Przeciągnięcie okna odblokowuje je. Pamiętaj, że macOS umieszcza wracające okno na biurku, które jest aktualnie wyświetlane na jego ekranie, a niekoniecznie na tym, na którym było na początku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a localização de uma janela está bloqueada, ela retorna à tela e à posição que tinha quando você a bloqueou, caso algo a mova. Estilos de janela que preenchem a tela ou se fixam a ela, como Maximizada, Centralizado e os estilos superior, inferior, esquerdo e direito, mantêm sua forma habitual e, em vez disso, ficam presos à sua tela. Se essa tela for desconectada, como acontece quando um laptop entra em repouso, a janela aguarda e volta quando a tela retornar. Arrastar a janela desbloqueia a localização. Observe que o macOS coloca uma janela que retorna no Espaço que a tela dela está exibindo naquele momento, que pode não ser o Espaço em que ela começou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда положение окна заблокировано, окно возвращается на тот дисплей и в то положение, которые были у него в момент блокировки, если что-либо его переместит. Стили окна, которые заполняют экран или привязаны к нему, например «Развёрнуто», «По центру», а также стили сверху, снизу, слева и справа, сохраняют свою обычную форму и вместо этого удерживаются на своём дисплее. Если этот дисплей отключён, как это происходит при переходе ноутбука в режим сна, окно ждёт и возвращается, когда дисплей снова появится. Перетаскивание окна снимает блокировку. Учтите, что macOS помещает возвращающееся окно в то пространство (Space), которое его дисплей показывает в данный момент, и это может быть не то пространство, в котором окно было изначально."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je poloha okna zamknutá, okno sa po akomkoľvek presunutí vráti na displej a do polohy, ktorú malo pri zamknutí. Štýly okien, ktoré vypĺňajú obrazovku alebo sa k nej pripájajú, ako Maximalizované, Vycentrované a štýly hore, dole, vľavo a vpravo, si zachovajú svoj obvyklý tvar a sú namiesto toho viazané na svoj displej. Ak je tento displej odpojený, napríklad keď prenosný počítač prejde do režimu spánku, okno počká a vráti sa, keď sa displej vráti. Potiahnutím okna sa odomkne. Upozorňujeme, že macOS vráti okno na plochu, ktorú jeho displej práve zobrazuje, čo nemusí byť plocha, na ktorej pôvodne bolo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je lokacija okna zaklenjena, se okno vrne na zaslon in položaj, ki ju je imelo ob zaklepanju, če ga kaj premakne. Slogi oken, ki zapolnijo zaslon ali se pripnejo nanj, kot so Maksimirano, Na sredini ter slogi zgoraj, spodaj, levo in desno, obdržijo običajno obliko in so vezani na svoj zaslon. Če je ta zaslon odklopljen, kar se zgodi, ko prenosnik preide v stanje spanja, okno počaka in se vrne, ko se zaslon vrne. Vedeti morate, da macOS vračajoče se okno postavi na namizje Space, ki ga njegov zaslon trenutno prikazuje, kar morda ni namizje, na katerem je bilo na začetku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ett fönsters plats är låst återgår det till den skärm och position det hade när du låste det, om något flyttar det. Fönsterstilar som fyller eller fästs vid skärmen, som Maximerad, Centrerad och stilarna överkant, nederkant, vänster och höger, behåller sin vanliga form och hålls kvar på sin skärm i stället. Om skärmen kopplas från, till exempel när en bärbar dator går i vila, väntar fönstret och återgår när skärmen kommer tillbaka. Om du drar i fönstret låses det upp. Observera att macOS placerar ett fönster som återvänder på det Space som skärmen visar just då, vilket kanske inte är det Space det startade på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir pencerenin konumu kilitliyken, bir şey pencereyi oynatırsa pencere kilitlediğiniz andaki ekrana ve konuma döner. Ekranı dolduran veya ekrana yapışan pencere stilleri (Büyütülmüş, Ortalanmış ve üst, alt, sol ve sağ stilleri gibi) olağan şeklini korur ve bunun yerine ekranına sabitlenir. Bu ekranın bağlantısı kesilirse (dizüstü bilgisayar uykuya geçtiğinde olduğu gibi) pencere bekler ve ekran geri geldiğinde döner. Pencereyi sürüklemek kilidi açar. macOS’un geri dönen pencereyi, ekranının o anda gösterdiği alana yerleştirdiğini, bunun başladığı alan olmayabileceğini unutmayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi vị trí của cửa sổ bị khóa, nếu có gì di chuyển nó thì nó sẽ quay về màn hình và vị trí khi bạn khóa. Các kiểu cửa sổ lấp đầy hoặc gắn vào màn hình, như Phóng to tối đa, Ở giữa, và các kiểu trên, dưới, trái, phải, giữ nguyên hình dạng thông thường và được giữ trên màn hình của chúng. Nếu màn hình đó bị ngắt kết nối, như khi máy tính xách tay ngủ, cửa sổ sẽ chờ và quay lại khi màn hình trở lại. Kéo cửa sổ sẽ mở khóa. Lưu ý rằng macOS đặt cửa sổ quay lại vào không gian mà màn hình của nó đang hiển thị, có thể không phải không gian ban đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定窗口位置后，如果有任何操作移动了它，它会回到您锁定时所在的显示器和位置。填满屏幕或吸附到屏幕的窗口样式，例如“最大化”、“居中”以及上、下、左、右等样式，会保持原有的形状，改为固定在各自的显示器上。如果该显示器已断开连接（例如笔记本电脑进入睡眠时），窗口会等待，并在显示器恢复后回到原处。拖动窗口即可解除锁定。请注意，macOS 会把返回的窗口放到其显示器当前显示的那个空间上，而这可能不是它最初所在的空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定視窗位置後，若有任何動作移動了它，它會回到鎖定時所在的顯示器與位置。填滿或附著於螢幕的視窗樣式（例如最大化、置中，以及頂部、底部、左側和右側樣式）會維持其一般形狀，並改為固定在其顯示器上。如果該顯示器已中斷連線（例如筆記型電腦進入睡眠），視窗會等待顯示器恢復後再返回。拖移視窗會將其解鎖。請注意，macOS 會將返回的視窗放在其顯示器目前顯示的空間上，這可能不是它原本所在的空間。"
          }
        }
      }
    },
    "MenuTip.LockSize" : {
      "comment" : "Menu item help for the ‘Lock Size’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknutá okna odolávají změně velikosti. To se může hodit, když macOS zpřeháže okna při připojování nebo odpojování displejů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låste vinduer modsætter sig størrelsesændring. Det kan være nyttigt, når macOS roder rundt med dine vinduer ved tilslutning eller frakobling af skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrte Fenster widersetzen sich einer Größenänderung. Das kann nützlich sein, wenn macOS beim Verbinden oder Trennen von Displays Ihre Fenster durcheinanderbringt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locked windows resist being resized. This can be useful when macOS screws up your windows when connecting or disconnecting displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas bloqueadas se resisten a que se cambie su tamaño. Puede ser útil cuando macOS desordena tus ventanas al conectar o desconectar pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitut ikkunat vastustavat koon muuttamista. Tämä voi olla hyödyllistä, kun macOS sotkee ikkunasi näyttöjä kytkettäessä tai irrotettaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres verrouillées résistent au redimensionnement. Cela peut être utile quand macOS dérègle vos fenêtres lors de la connexion ou de la déconnexion d’écrans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre bloccate resistono al ridimensionamento. Può essere utile quando macOS scompone le finestre al collegamento o allo scollegamento dei display."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされたウインドウはサイズ変更されにくくなります。これは、ディスプレイの接続や切断時にmacOSがウインドウを崩してしまう場合に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠긴 윈도우는 크기가 잘 조절되지 않습니다. 디스플레이를 연결하거나 분리할 때 macOS가 윈도우를 엉망으로 만드는 경우 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låste vinduer lar seg ikke endre i størrelse. Dette kan være nyttig når macOS ødelegger vinduene dine ved tilkobling eller frakobling av skjermer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendelde vensters weerstaan formaatwijzigingen. Dit kan handig zijn wanneer macOS je vensters door elkaar gooit bij het aansluiten of loskoppelen van beeldschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowane okna opierają się zmianie rozmiaru. Może to być przydatne, gdy macOS psuje układ okien przy podłączaniu lub odłączaniu ekranów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas bloqueadas resistem a serem redimensionadas. Isto pode ser útil quando o macOS bagunça suas janelas ao conectar ou desconectar telas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные окна сопротивляются изменению размера. Это может быть полезно, когда macOS портит расположение ваших окон при подключении или отключении дисплеев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknuté okná odolávajú zmene veľkosti. Môže to byť užitočné, keď macOS pokazí vaše okná pri pripájaní alebo odpájaní displejov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaklenjena okna se upirajo spreminjanju velikosti. To je lahko uporabno, kadar macOS pokvari razporeditev oken ob priklopu ali odklopu zaslonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låsta fönster motsätter sig storleksändring. Det kan vara användbart när macOS rör till fönstren när skärmar ansluts eller kopplas från."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli pencereler yeniden boyutlandırılmaya direnir. Bu, macOS ekranları bağlarken veya çıkarırken pencerelerinizi bozduğunda yararlı olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ bị khóa sẽ chống lại việc thay đổi kích thước. Điều này hữu ích khi macOS làm lộn xộn các cửa sổ của bạn lúc kết nối hoặc ngắt kết nối màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被锁定的窗口无法调整大小。在连接或断开显示器时，macOS 导致窗口异常时，此功能非常有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定的視窗不易被調整大小。當 macOS 在連接或中斷顯示器時弄亂你的視窗，這會很有用。"
          }
        }
      }
    },
    "MenuTip.ManageDependencies" : {
      "comment" : "Menu item help for the ‘Manage Dependencies’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře rozhraní, ve kterém můžete přidávat, aktualizovat nebo odebírat závislosti pip skriptu Python API."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner en brugerflade, hvor du kan tilføje, opdatere eller fjerne pip-afhængigheder for en Python API-instruks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet eine Oberfläche, in der Sie pip-Abhängigkeiten eines Python-API-Skripts hinzufügen, aktualisieren oder entfernen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
