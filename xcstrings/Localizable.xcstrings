    "AdvancedSetting.findURLsRespectsSoftBoundaries" : {
      "comment" : "Advanced setting: findURLsRespectsSoftBoundaries",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při použití „Najít URL“ rozšířit výsledky přes měkké hranice, například dělicí čáry podoken tmux."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når “Find URL’er” bruges, udvides resultaterne på tværs af bløde grænser som ruderdelere i tmux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Verwendung von „URLs suchen“ Ergebnisse über weiche Grenzen wie tmux-Bereichstrennlinien hinweg erweitern."
          }
        },
        "en" : {
