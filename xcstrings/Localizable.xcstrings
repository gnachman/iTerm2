        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) iTerm2가 시작될 때 자동으로 실행될 수 있습니다. 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» kan startes automatisk når iTerm2 starter. Vil du tillate det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
