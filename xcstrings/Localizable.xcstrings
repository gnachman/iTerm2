    "Tip.0029.Body" : {
      "comment" : "Tip of the day body, id 0029",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stisknutím ⌘/ najdete svůj kurzor. Je to zábava!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på ⌘/ for at finde din markør. Det er sjovt!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⌘/, um Ihren Cursor zu finden. Das macht Spaß!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⌘/ to locate your cursor. It’s fun!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⌘/ para localizar el cursor. ¡Es divertido!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina ⌘/ löytääksesi kohdistimesi. Se on hauskaa!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⌘/ pour repérer votre curseur. C’est amusant !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi ⌘/ per localizzare il cursore. È divertente!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘/を押すとカーソルの位置がわかります。楽しいですよ!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘/를 눌러 커서 위치를 찾아보십시오. 재미있습니다!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på ⌘/ for å finne markøren din. Det er morsomt!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op ⌘/ om je cursor te vinden. Leuk!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij ⌘/, aby zlokalizować kursor. To zabawne!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⌘/ para localizar seu cursor. É divertido!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⌘/, чтобы найти курсор. Это забавно!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačením ⌘/ nájdete svoj kurzor. Je to zábavné!"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisnite ⌘/, da poiščete kazalec. Zabavno je!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ⌘/ för att lokalisera markören. Det är roligt!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmlecinizi bulmak için ⌘/ tuşlarına basın. Eğlenceli!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn ⌘/ để xác định vị trí con trỏ. Rất vui đấy!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ⌘/ 键定位光标。很有趣！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ⌘/ 可找出游標位置。很好玩！"
          }
        }
      }
    },
