    "NaggingController.ControlSequenceChangeProfile" : {
      "comment" : "Prompt asking whether to allow a control sequence to change the current profile",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Steuersequenz hat versucht, das aktuelle Profil zu ändern. Dies zukünftig erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A control sequence attempted to change the current profile. Allow this in the future?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una secuencia de control intentó cambiar el perfil actual. ¿Permitirlo en el futuro?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une séquence de contrôle a tenté de changer le profil actuel. L’autoriser à l’avenir ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sequenza di controllo ha tentato di cambiare il profilo corrente. Consentirlo in futuro?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制御シーケンスが現在のプロファイルを変更しようとしました。今後もこれを許可しますか?"
