    "PTYSession.UploadInProgressBody" : {
      "comment" : "Alert body explaining that another upload is already in progress",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte warten Sie, bis der aktuelle Upload abgeschlossen ist, oder brechen Sie ihn ab, bevor Sie einen weiteren starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please wait for the current upload to complete or cancel it before starting another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que termine la subida actual o cancélala antes de iniciar otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin du téléversement en cours ou annulez-le avant d’en lancer un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi il completamento del caricamento in corso o annullalo prima di avviarne un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアップロードが完了するのを待つか、キャンセルしてから別のアップロードを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 업로드를 시작하기 전에 현재 업로드가 완료될 때까지 기다리거나 현재 업로드를 취소하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a conclusão do envio atual ou cancele-o antes de iniciar outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождитесь завершения текущей отправки или отмените её, прежде чем начинать новую."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir yüklemeyi başlatmadan önce lütfen mevcut yüklemenin bitmesini bekleyin veya iptal edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
