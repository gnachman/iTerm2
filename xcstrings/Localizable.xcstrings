        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, pri vkladaní jedného riadku textu končiaceho novým riadkom sa zobrazí výzva na potvrdenie odoslania nového riadku. Vyžaduje sa Integrácia shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je vklopljeno, boste pozvani, naj potrdite pošiljanje nove vrstice, ko prilepite eno vrstico besedila, ki se konča z novo vrstico. Zahtevana je integracija lupine."
