    "BrowserErrorHandler.CannotFindHostMessage" : {
      "comment" : "Error message: cannot find host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemůže najít server. Zkontrolujte, zda je webová adresa správná, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke finde serveren. Kontroller, at webadressen er korrekt, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann den Server nicht finden. Überprüfen Sie, ob die Webadresse korrekt ist, und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can’t find the server. Check that the web address is correct and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no encuentra el servidor. Comprueba que la dirección web sea correcta e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei löydä palvelinta. Tarkista, että verkko-osoite on oikein, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne trouve pas le serveur. Vérifiez que l’adresse web est correcte et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non riesce a trovare il server. Verifica che l’indirizzo web sia corretto e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はサーバーを見つけられません。Webアドレスが正しいか確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 서버를 찾을 수 없습니다. 웹 주소가 올바른지 확인하고 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 finner ikke tjeneren. Kontroller at nettadressen er riktig, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan de server niet vinden. Controleer of het webadres juist is en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie może znaleźć serwera. Sprawdź, czy adres internetowy jest prawidłowy, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não consegue encontrar o servidor. Verifique se o endereço da web está correto e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может найти сервер. Проверьте правильность веб-адреса и попробуйте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
