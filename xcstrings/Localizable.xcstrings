    "Tip.0052.Body" : {
      "comment" : "Tip of the day body, id 0052",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalerweise erscheinen neue Tabs am Ende der Tab-Leiste. Unter „Einstellungen > Erweitert“ gibt es eine Einstellung, mit der sie stattdessen neben dem aktuellen Tab platziert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally, new tabs appear at the end of the tab bar. There’s a setting in “Settings > Advanced” to place them next to your current tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常、新しいタブはタブバーの末尾に表示されます。「設定 > 詳細」の設定で、現在のタブの隣に配置することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적으로 새로운 탭은 탭 막대의 끝에 나타납니다. “설정 > 고급”에는 새로운 탭을 현재 탭 옆에 배치하는 설정이 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente, novas abas aparecem no fim da barra de abas. Há um ajuste em “Ajustes > Avançado” para colocá-las ao lado da aba atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно новые вкладки появляются в конце панели вкладок. В «Настройки > Дополнительные» есть параметр, позволяющий размещать их рядом с текущей вкладкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常，新标签页会出现在标签页栏的末尾。在“设置 > 高级”中有一个设置可以将它们放在当前标签页旁边。"
          }
        }
      }
    },
