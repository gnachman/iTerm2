    "AdvancedSetting.alternateMouseScroll" : {
      "comment" : "Advanced setting: alternateMouseScroll",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolečko myši odesílá šipky v režimu alternativní obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullehjulet sender piletaster i tilstanden alternativ skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mausrad sendet Pfeiltasten im alternativen Bildschirmmodus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel sends arrow keys when in alternate screen mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rueda de desplazamiento envía teclas de flecha en el modo de pantalla alternativa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierityspyörä lähettää nuolinäppäimiä vaihtoehtoisen näytön tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La molette de défilement envoie des touches fléchées en mode écran alternatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rotellina invia i tasti freccia in modalità schermo alternativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替スクリーンモード中、スクロールホイールが矢印キーを送信する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 화면 모드에서 스크롤 휠로 화살표 키 보내기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullehjulet sender piltaster i modusen for alternativ skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scrolwiel verstuurt pijltoetsen in de modus voor alternatief scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kółko przewijania wysyła klawisze strzałek w trybie ekranu alternatywnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem envia teclas de seta no modo de tela alternada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колесо прокрутки отправляет клавиши со стрелками в альтернативном режиме экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliesko myši posiela klávesy so šípkami v režime alternatívnej obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolesce za pomikanje pošilja puščične tipke v načinu nadomestnega zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullhjulet skickar piltangenter i läget alternativ skärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif ekran modundayken kaydırma tekerleği ok tuşlarını gönderir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con lăn chuột gửi phím mũi tên khi ở chế độ màn hình thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在交替屏幕模式下，滚动轮会发送箭头键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處於替代螢幕模式時，滾輪會傳送方向鍵。"
          }
        }
      }
    },
    "AdvancedSetting.alternateMouseScrollStringForDown" : {
      "comment" : "Advanced setting: alternateMouseScrollStringForDown",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunutí kolečka dolů odešle zadaný text v režimu alternativní obrazovky.\nHodnota by měla používat syntaxi Vimu, například \\e pro escape."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulning nedad med rullehjulet sender den angivne tekst i tilstanden alternativ skærm.\nVærdien skal bruge Vim-syntaks, f.eks. \\e for escape."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mausrad nach unten sendet den angegebenen Text im alternativen Bildschirmmodus.\nDer Wert sollte die Vim-Syntax verwenden, zum Beispiel \\e für Escape."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scroll wheel down sends the specified text when in alternate screen mode.\nThe value should use Vim syntax, such as \\e for escape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desplazar la rueda hacia abajo se envía el texto especificado en el modo de pantalla alternativa.\nEl valor debe usar la sintaxis de Vim, como \\e para escape."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierityspyörän vieritys alas lähettää määritetyn tekstin vaihtoehtoisen näytön tilassa.\nArvon tulee käyttää Vimin syntaksia, kuten \\e escapelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement vers le bas à la molette envoie le texte indiqué en mode écran alternatif.\nLa valeur doit utiliser la syntaxe de Vim, par exemple \\e pour Échap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorrendo la rotellina verso il basso in modalità schermo alternativo viene inviato il testo specificato.\nIl valore deve usare la sintassi di Vim, come \\e per escape."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替スクリーンモード中、スクロールホイールを下に回すと指定したテキストを送信する。\n値はVim構文（エスケープの場合は\\eなど）を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 화면 모드에서 스크롤 휠을 아래로 굴리면 지정한 텍스트를 보냅니다.\n값은 Vim 문법을 사용해야 합니다(예: Esc는 \\e)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulling nedover sender den angitte teksten i modusen for alternativ skjerm.\nVerdien bør bruke Vim-syntaks, som \\e for escape."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollen met het wiel omlaag verstuurt de opgegeven tekst in de modus voor alternatief scherm.\nDe waarde moet Vim-syntaxis gebruiken, zoals \\e voor escape."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewinięcie kółkiem w dół wysyła podany tekst w trybie ekranu alternatywnego.\nWartość powinna używać składni Vima, np. \\e dla Esc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem para baixo envia o texto especificado no modo de tela alternada.\nO valor deve usar a sintaxe do Vim, como \\e para escape."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутка колеса вниз отправляет указанный текст в альтернативном режиме экрана.\nЗначение должно использовать синтаксис Vim, например \\e для escape."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolovanie kolieska nadol posiela zadaný text v režime alternatívnej obrazovky.\nHodnota by mala používať syntax Vimu, napríklad \\e pre escape."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomik kolesca navzdol pošlje določeno besedilo v načinu nadomestnega zaslona.\nVrednost naj uporablja sintakso Vim, na primer \\e za Escape."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullning nedåt med rullhjulet skickar den angivna texten i läget alternativ skärm.\nVärdet ska använda Vim-syntax, till exempel \\e för escape."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif ekran modundayken kaydırma tekerleği aşağı çevrildiğinde belirtilen metin gönderilir.\nDeğer, kaçış için \\e gibi Vim sözdizimini kullanmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn con lăn xuống sẽ gửi văn bản đã chỉ định khi ở chế độ màn hình thay thế.\nGiá trị nên dùng cú pháp Vim, như \\e cho escape."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动滚轮向下在交替屏幕模式下发送指定文本。\n值应使用Vim语法，例如 \\e 表示转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處於替代螢幕模式時，滾輪向下會傳送指定的文字。\n值應使用 Vim 語法，例如 \\e 代表跳脫。"
          }
        }
      }
    },
    "AdvancedSetting.alternateMouseScrollStringForUp" : {
      "comment" : "Advanced setting: alternateMouseScrollStringForUp",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
