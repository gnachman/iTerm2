        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ es con lo que se inició %2$@, que se está ejecutando ahora en esta sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est la valeur avec laquelle %2$@, en cours d’exécution dans cette session, a été lancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è il valore con cui è stato avviato %2$@, ora in esecuzione in questa sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は、現在このセッションで実行中の%2$@が起動されたときの値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 현재 이 세션에서 실행 중인 %2$@이(가) 시작될 때 사용된 값입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ é o valor com que %2$@, em execução nesta sessão agora, foi iniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С %1$@ была запущена программа %2$@, работающая сейчас в этой сессии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, şu anda bu oturumda çalışan %2$@ programının başlatıldığı değerdir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 是当前在此会话中运行的 %2$@ 启动时使用的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 是目前在此工作階段中執行的 %2$@ 啟動時所使用的值。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.ConfigResolutionFailedBody" : {
      "comment" : "Body of the alert shown when iTerm2 could not read CLAUDE_CONFIG_DIR from the user’s shell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte CLAUDE_CONFIG_DIR nicht aus Ihrer Shell lesen und weiß daher nicht, wo Claude Code seine Einstellungen speichert. Erneut versuchen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t read CLAUDE_CONFIG_DIR from your shell, so it doesn’t know where Claude Code keeps its settings. Try again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no pudo leer CLAUDE_CONFIG_DIR desde tu shell, así que no sabe dónde guarda Claude Code sus ajustes. ¿Volver a intentarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’a pas pu lire CLAUDE_CONFIG_DIR depuis votre shell, il ne sait donc pas où Claude Code conserve ses réglages. Réessayer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non ha potuto leggere CLAUDE_CONFIG_DIR dalla tua shell, quindi non sa dove Claude Code conserva le sue impostazioni. Riprovare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はシェルからCLAUDE_CONFIG_DIRを読み取れなかったため、Claude Codeが設定を保存する場所がわかりません。もう一度試しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 셸에서 CLAUDE_CONFIG_DIR을 읽을 수 없어 Claude Code가 설정을 어디에 보관하는지 알 수 없습니다. 다시 시도하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não conseguiu ler CLAUDE_CONFIG_DIR do seu shell, portanto não sabe onde o Claude Code guarda as configurações. Tentar novamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не смог прочитать CLAUDE_CONFIG_DIR из вашей оболочки, поэтому не знает, где Claude Code хранит настройки. Попробовать снова?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kabuğunuzdan CLAUDE_CONFIG_DIR değerini okuyamadı; bu yüzden Claude Code’un ayarlarını nerede sakladığını bilmiyor. Yeniden denensin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法从你的 Shell 读取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 将设置保存在何处。要重试吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法從你的 shell 讀取 CLAUDE_CONFIG_DIR，因此不知道 Claude Code 將設定儲存在何處。要再試一次嗎？"
          }
        }
      }
    },
