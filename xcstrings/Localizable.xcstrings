    "BrowserSSHPage.NoConnectionMessage" : {
      "comment" : "Browser page shown when opening an ssh: URL for a host with no ssh integration connection. %@ is the host name, shown in bold.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebylo nalezeno žádné připojení k hostiteli %@ pomocí integrace SSH. Připojte se k němu v okně terminálu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet nogen forbindelse til %@ via SSH-integration. Opret forbindelse til den i et terminalvindue, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde keine Verbindung zu %@ über die SSH-Integration gefunden. Stellen Sie in einem Terminalfenster eine Verbindung her und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No connection to %@ using ssh integration could be found. Please connect to it in a terminal window and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ninguna conexión con %@ mediante la integración con SSH. Conéctate a él en una ventana de terminal e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimeen %@ ei löytynyt SSH-integraatiota käyttävää yhteyttä. Muodosta yhteys siihen päätteen ikkunassa ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune connexion à %@ utilisant l’intégration SSH n’a été trouvée. Connectez-vous-y dans une fenêtre de terminal, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stata trovata alcuna connessione a %@ tramite l’integrazione SSH. Connettiti a esso in una finestra di terminale e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合を使用した %@ への接続が見つかりませんでした。ターミナルウインドウで接続してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합을 사용하는 %@ 연결을 찾을 수 없습니다. 터미널 윈도우에서 연결한 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fant ingen tilkobling til %@ som bruker SSH-integrering. Koble til den i et terminalvindu og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen verbinding met %@ via SSH-integratie gevonden. Maak er verbinding mee in een terminalvenster en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono połączenia z hostem %@ przez integrację z SSH. Połącz się z nim w oknie terminala i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma conexão com %@ pela integração SSH foi encontrada. Conecte-se a ele em uma janela de terminal e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не найдено подключение к %@ через интеграцию SSH. Подключитесь к нему в окне терминала и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenašlo sa žiadne pripojenie k hostiteľovi %@ prostredníctvom integrácie SSH. Pripojte sa k nemu v okne terminálu a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezave z gostiteljem %@ prek integracije SSH ni bilo mogoče najti. Povežite se z njim v oknu terminala in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att hitta någon anslutning till %@ via SSH-integrering. Anslut till den i ett terminalfönster och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH entegrasyonu kullanılan ve %@ ana makinesine açık bir bağlantı bulunamadı. Lütfen bir terminal penceresinde bu makineye bağlanıp yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy kết nối nào đến %@ bằng tích hợp SSH. Hãy kết nối đến máy chủ đó trong cửa sổ terminal rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到通过 SSH 集成与 %@ 的连接。请在终端窗口中连接到它，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到使用 SSH 整合與 %@ 的連線。請在終端機視窗中連線到它，然後再試一次。"
          }
        }
      }
    },
