    "Tip.0094.Body" : {
      "comment" : "Tip of the day body, id 0094",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulujte vstup terminálu, jako by šlo o výstup běžící aplikace, pomocí spouštěče „Vložit data“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuler terminalinput, som om det var output fra et kørende program, med udløseren “Indsæt data”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulieren Sie mit dem Trigger „Inject“ Terminaleingaben, als kämen sie als Ausgabe von einer laufenden App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Simulate terminal input as if it were output from a running app with the “Inject” trigger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simula la entrada de la terminal como si fuera la salida de una app en ejecución con el disparador “Inyectar datos”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuloi päätteen syötettä ikään kuin se olisi käynnissä olevan sovelluksen tulostetta ”Syötä”-käynnistimellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulez une saisie dans le terminal comme s’il s’agissait de la sortie d’une app en cours d’exécution avec le déclencheur « Inject »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simula l’input del terminale come se fosse l’output di un’app in esecuzione con l’attivatore “Inietta”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Inject」トリガーを使うと、実行中のアプリからの出力であるかのようにターミナルへの入力をシミュレートできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“삽입” 트리거를 사용하면 터미널 입력을 실행 중인 앱의 출력인 것처럼 시뮬레이션할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuler terminalinndata som om de var utdata fra en app som kjører, med utløseren «Injiser»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simuleer terminalinvoer alsof het uitvoer is van een draaiende app met de trigger ‘Injecteer’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symuluj wejście terminala tak, jakby były to dane wyjściowe działającej aplikacji, za pomocą wyzwalacza „Wstrzyknij”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simule a entrada no terminal como se fosse a saída de um app em execução com o gatilho “Inject”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имитируйте ввод в терминал, как будто это вывод работающего приложения, с помощью триггера «Inject»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulujte vstup terminálu, akoby išlo o výstup bežiacej apky, pomocou spúšťača „Injektovať“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z dejanjem sprožilca »Vstavi podatke« simulirajte terminalski vhod, kot da bi bil izhod zagnane aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulera terminalindata som om det vore utdata från ett program som körs med utlösaren ”Injicera”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Enjekte Et” tetikleyicisiyle terminal girdisini çalışan bir uygulamanın çıktısıymış gibi simüle edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô phỏng đầu vào terminal như thể đó là đầu ra từ một ứng dụng đang chạy bằng trình kích hoạt “Chèn dữ liệu”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟终端输入，如同来自正在运行的应用程序的输出，使用“Inject”触发器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「注入」觸發器，模擬終端機輸入，就像是來自執行中 App 的輸出一樣。"
          }
        }
      }
    },
