    "AdvancedSetting.logTimestampFormat" : {
      "comment" : "Advanced setting: logTimestampFormat",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format für Zeitstempel im Protokoll. Die Syntax finden Sie in Unicode TR 35-31.\nSie müssen iTerm2 neu starten, damit Änderungen an dieser Einstellung wirksam werden."
          }
        },
        "en" : {
