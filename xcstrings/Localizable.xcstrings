          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может установить безопасное соединение с сервером. Возможно, сервер недоступен или не работает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 sunucuyla güvenli bir bağlantı kuramıyor. Sunucu çalışmıyor veya erişilemiyor olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
