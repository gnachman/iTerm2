          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопряжение подключает этот Mac к приложению iTerm2 Buddy на вашем iPhone. Установите его сейчас, а затем вернитесь и продолжите."
          }
        },
        "tr" : {
