    "Tip.0055.Body" : {
      "comment" : "Tip of the day body, id 0055",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen Sie nach URLs mit „Bearbeiten > Suchen > URLs suchen“. Navigieren Sie mit ⌘G und ⇧⌘G durch die Suchergebnisse. Öffnen Sie die aktuelle Auswahl mit ⌥⌘O."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Search for URLs using “Edit > Find > Find URLs.” Navigate search results with ⌘G and ⇧⌘G. Open the current selection with ⌥⌘O."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca URLs con “Edición > Buscar > Buscar URLs”. Navega por los resultados con ⌘G y ⇧⌘G. Abre la selección actual con ⌥⌘O."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez des URL avec « Édition > Rechercher > Rechercher des URL ». Parcourez les résultats avec ⌘G et ⇧⌘G. Ouvrez la sélection actuelle avec ⌥⌘O."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca gli URL con “Modifica > Trova > Trova URL”. Scorri i risultati con ⌘G e ⇧⌘G. Apri la selezione corrente con ⌥⌘O."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 検索 > URLを検索」を使ってURLを検索できます。⌘Gと⇧⌘Gで検索結果を移動し、⌥⌘Oで現在の選択範囲を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“편집 > 찾기 > URL 찾기”를 사용하여 URL을 검색하십시오. ⌘G 및 ⇧⌘G로 검색 결과 사이를 이동하고, ⌥⌘O로 현재 선택 항목을 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque URLs usando “Editar > Buscar > Buscar URLs”. Navegue pelos resultados da busca com ⌘G e ⇧⌘G. Abra a seleção atual com ⌥⌘O."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищите URL-адреса с помощью «Правка > Найти > Найти URL-адреса». Переходите между результатами поиска с помощью ⌘G и ⇧⌘G. Открывайте текущее выделение с помощью ⌥⌘O."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Düzen > Bul > URL’leri Bul” ile URL arayın. Arama sonuçları arasında ⌘G ve ⇧⌘G ile gezinin. Geçerli seçimi ⌥⌘O ile açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“编辑 > 查找 > 查找 URL”功能进行 URL 搜索。可通过 ⌘G 和 ⇧⌘G 浏览搜索结果，用 ⌥⌘O 打开当前选中项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「編輯 > 尋找 > 尋找 URL」搜尋 URL。用 ⌘G 和 ⇧⌘G 瀏覽搜尋結果，用 ⌥⌘O 打開目前的選取項目。"
          }
        }
      }
    },
