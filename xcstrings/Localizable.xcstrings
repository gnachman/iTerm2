    "AdvancedSetting.supportREPCode" : {
      "comment" : "Advanced setting: supportREPCode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützung für die Escape-Sequenz REP (vorheriges Zeichen wiederholen) aktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable support for REP (Repeat previous character) escape sequence?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar la compatibilidad con la secuencia de escape REP (repetir carácter anterior)?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer la prise en charge de la séquence d’échappement REP (répéter le caractère précédent) ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare il supporto per la sequenza di escape REP (ripeti carattere precedente)?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "REP（直前の文字を繰り返す）エスケープシーケンスのサポートを有効にするか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "REP(이전 문자 반복) 이스케이프 시퀀스 지원을 활성화하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar suporte para a sequência de escape REP (repetir caractere anterior)?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить поддержку управляющей последовательности REP (повтор предыдущего символа)?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "REP (önceki karakteri tekrarla) kaçış dizisi desteği etkinleştirilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否支持 REP（重复上一个字符）转义序列？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用對 REP（重複前一個字元）跳脫序列的支援？"
          }
        }
      }
    },
    "AdvancedSetting.suppressMultilinePasteWarningWhenNotAtShellPrompt" : {
      "comment" : "Advanced setting: suppressMultilinePasteWarningWhenNotAtShellPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über mehrzeiliges Einfügen unterdrücken, wenn nicht am Prompt.\nErfordert installierte Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line paste when not at prompt.\nRequires Shell Integration to be installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la advertencia sobre pegados de varias líneas cuando no estás en el prompt.\nRequiere que la integración con el shell esté instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’avertissement sur le collage de plusieurs lignes en dehors de l’invite.\nNécessite l’installation de l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso sull’incolla su più righe quando non sei al prompt.\nRichiede che l’integrazione shell sia installata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトにいないときの複数行の貼り付けに関する警告を表示しない。\nこれにはShell Integrationのインストールが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트가 아닐 때 여러 줄 붙여넣기 경고 숨기기\n셸 통합이 설치되어 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagem de várias linhas quando não estiver no prompt.\nRequer que o Shell Integration esteja instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение о многострочной вставке, когда вы не находитесь в приглашении.\nТребуется установленная Shell Integration."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstemde değilken çok satırlı yapıştırma uyarısını bir daha gösterme.\nKabuk Entegrasyonu’nun yüklü olmasını gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在提示符外时，是否应忽略多行粘贴警告？  \n需要安装 Shell Integration。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不在提示符號處時，不再顯示多行貼上的警告。\n需要安裝 Shell 整合。"
          }
        }
      }
    },
    "AdvancedSetting.suppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline" : {
      "comment" : "Advanced setting: suppressMultilinePasteWarningWhenPastingOneLineWithTerminalNewline",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über mehrzeiliges Einfügen unterdrücken, wenn eine einzelne Zeile eingefügt wird, die mit einem Zeilenumbruch endet.\nDies unterdrückt alle Warnungen über mehrzeiliges Einfügen, wenn eine einzelne Zeile eingefügt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line paste when pasting a single line ending with a newline.\nThis suppresses all multi-line paste warnings when a single line is being pasted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la advertencia sobre pegados de varias líneas al pegar una sola línea que termina en un salto de línea.\nSuprime todas las advertencias de pegado de varias líneas cuando se pega una sola línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’avertissement sur le collage de plusieurs lignes lors du collage d’une seule ligne se terminant par un saut de ligne.\nCela désactive tous les avertissements de collage de plusieurs lignes lorsqu’une seule ligne est collée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso sull’incolla su più righe quando si incolla una singola riga che termina con un a capo.\nDisattiva tutti gli avvisi di incolla su più righe quando viene incollata una singola riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改行で終わる1行を貼り付けるときの複数行の貼り付けに関する警告を表示しない。\nこれは1行のみが貼り付けられる場合に、すべての複数行貼り付け警告を抑制します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄바꿈으로 끝나는 한 줄을 붙여넣을 때 여러 줄 붙여넣기 경고 표시 안 함.\n한 줄을 붙여넣을 때는 모든 여러 줄 붙여넣기 경고를 표시하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagem de várias linhas ao colar uma única linha terminada com uma quebra de linha.\nIsso suprime todos os avisos de colagem de várias linhas quando uma única linha está sendo colada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение о многострочной вставке при вставке одной строки, заканчивающейся переносом строки.\nЭто отключает все предупреждения о многострочной вставке, когда вставляется одна строка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni satırla biten tek satır yapıştırılırken çok satırlı yapıştırma uyarısını bir daha gösterme.\nTek satır yapıştırılırken tüm çok satırlı yapıştırma uyarılarını gizler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在粘贴以换行符结尾的单行内容时，是否应忽略多行粘贴警告？  \n这会消除单行粘贴时的所有多行粘贴警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上以換行結尾的單行時，不再顯示多行貼上的警告。\n貼上單行時，這會隱藏所有多行貼上的警告。"
          }
        }
      }
    },
    "AdvancedSetting.suppressRestartAnnouncement" : {
      "comment" : "Advanced setting: suppressRestartAnnouncement",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angebot zum Neustart der Sitzung unterdrücken.\nWenn eine Sitzung endet, wird angeboten, sie neu zu starten. Aktivieren Sie dies, um das Angebot dauerhaft zu unterdrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress the Restart Session offer.\nWhen a session terminates, it will offer to restart itself. Turn this on to suppress the offer permanently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la oferta de reiniciar la sesión.\nCuando una sesión termina, ofrecerá reiniciarse. Actívalo para suprimir la oferta de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver la proposition de redémarrer la session.\nLorsqu’une session se termine, elle propose de se redémarrer. Activez cette option pour désactiver définitivement cette proposition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva la proposta di riavviare la sessione.\nQuando una sessione termina, propone di riavviarsi. Attiva questa opzione per disattivare la proposta in modo permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart Sessionの提案を表示しない。\nセッションが終了すると、再起動を提案します。これを有効にすると、その提案を永続的に抑制します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 재시작 제안 표시 안 함.\n세션이 종료되면 세션을 재시작할지 제안합니다. 이 제안을 영구적으로 표시하지 않으려면 이 설정을 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir a oferta de Reiniciar sessão.\nQuando uma sessão termina, ela oferecerá reiniciar a si mesma. Ative isto para suprimir a oferta permanentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предложение перезапустить сеанс.\nПри завершении сеанса будет предложено перезапустить его. Включите этот параметр, чтобы отключить это предложение навсегда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu Yeniden Başlat önerisini bir daha gösterme.\nBir oturum sonlandığında kendini yeniden başlatmayı önerir. Öneriyi kalıcı olarak gizlemek için bunu açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应隐藏“重启会话”选项？  \n当会话终止时，会提供重新启动的选项。开启此选项可永久隐藏该选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示「重新啟動工作階段」建議。\n工作階段結束時，會提示是否重新啟動。開啟此項可永久不再顯示該建議。"
          }
        }
      }
    },
    "AdvancedSetting.swapFindNextPrevious" : {
      "comment" : "Advanced setting: swapFindNextPrevious",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weitersuchen“ und „Vorherige suchen“ vertauschen.\nWenn aktiviert, sucht „Weitersuchen“ aufwärts und „Vorherige suchen“ abwärts (das traditionelle Verhalten von iTerm2, das vom macOS-Standard abweicht). Wenn deaktiviert, verhält sich die Suche wie in einer normalen macOS-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swap Find Next and Find Previous.\nIf enabled, Find Next will search up and Find Previous will search down (iTerm2's traditional behavior, which is a departure from macOS's standard). When disabled, search behaves like a normal macOS app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia Buscar siguiente y Buscar anterior.\nSi está activado, Buscar siguiente buscará hacia arriba y Buscar anterior hacia abajo (el comportamiento tradicional de iTerm2, que se aparta del estándar de macOS). Si está desactivado, la búsqueda se comporta como en una app normal de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverser Rechercher le suivant et Rechercher le précédent.\nSi activé, Rechercher le suivant cherche vers le haut et Rechercher le précédent vers le bas (comportement traditionnel d’iTerm2, qui s’écarte de la norme de macOS). Si désactivé, la recherche se comporte comme dans une app macOS normale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia Trova successivo e Trova precedente.\nSe attivo, Trova successivo cercherà verso l’alto e Trova precedente verso il basso (il comportamento tradizionale di iTerm2, che si discosta dallo standard di macOS). Se disattivato, la ricerca si comporta come in una normale app macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次を検索」と「前を検索」を入れ替える。\n有効にすると、「次を検索」は上方向、「前を検索」は下方向に検索します（macOSの標準とは異なる、iTerm2の従来の動作です）。無効にすると、検索は通常のmacOSアプリと同じように動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 찾기와 이전 찾기 바꾸기.\n켜져 있으면 다음 찾기는 위쪽으로, 이전 찾기는 아래쪽으로 검색합니다(macOS 표준과 다른 iTerm2의 전통적인 동작). 꺼져 있으면 일반적인 macOS 앱처럼 검색합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar Buscar próximo e Buscar anterior.\nSe ativado, Buscar próximo buscará para cima e Buscar anterior buscará para baixo (o comportamento tradicional do iTerm2, que se afasta do padrão do macOS). Quando desativado, a busca se comporta como em um app normal do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поменять местами «Найти следующее» и «Найти предыдущее».\nЕсли включено, «Найти следующее» будет искать вверх, а «Найти предыдущее» — вниз (традиционное поведение iTerm2, отличающееся от стандартного для macOS). Если выключено, поиск ведёт себя как в обычном приложении macOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonrakini Bul ile Öncekini Bul’u değiş tokuş et.\nEtkinse Sonrakini Bul yukarı, Öncekini Bul aşağı arar (iTerm2’nin geleneksel davranışı; macOS standardından bir sapmadır). Devre dışıyken arama normal bir macOS uygulaması gibi davranır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应交换“查找下一个”和“查找上一个”。  \n若启用，“查找下一个”会向上搜索，而“查找上一个”会向下搜索（这是 iTerm2 的传统行为，与 macOS 标准不同）。禁用后，搜索行为类似普通 macOS 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對調「尋找下一個」和「尋找上一個」。\n啟用後，「尋找下一個」會向上搜尋，「尋找上一個」會向下搜尋（這是 iTerm2 的傳統行為，與 macOS 的標準不同）。停用時，搜尋的行為與一般 macOS App 相同。"
          }
        }
      }
    },
    "AdvancedSetting.synchronizeQueryWithFindPasteboard" : {
      "comment" : "Advanced setting: synchronizeQueryWithFindPasteboard",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchanfragen zwischen Fenstern und Anwendungen synchronisieren.\nNormalerweise werden beim Eingeben einer Suchanfrage in ein Suchfeld alle Suchfelder in allen Anwendungen mit demselben Wert aktualisiert. Das ist völliger Unsinn und kann deaktiviert werden, indem diese Einstellung auf „Nein“ gesetzt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Synchronize search queries across windows and applications.\nNormally, when you enter a search query in a Find field all find fields in all applications get updated to hold the same value. This is utter nonsense, and can be disabled by setting this preference to No."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza las consultas de búsqueda entre ventanas y aplicaciones.\nNormalmente, al escribir una consulta en un campo de búsqueda, todos los campos de búsqueda de todas las aplicaciones se actualizan con el mismo valor. Es un disparate y se puede desactivar poniendo este ajuste en No."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniser les requêtes de recherche entre les fenêtres et les apps.\nNormalement, lorsque vous saisissez une requête dans un champ de recherche, tous les champs de recherche de toutes les apps sont mis à jour avec la même valeur. C’est absurde, et vous pouvez le désactiver en réglant cette préférence sur Non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza le query di ricerca tra finestre e applicazioni.\nNormalmente, quando inserisci una query in un campo di ricerca, tutti i campi di ricerca di tutte le applicazioni vengono aggiornati con lo stesso valore. È una totale assurdità e si può disabilitare impostando questa preferenza su No."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索クエリをウィンドウやアプリケーション間で同期する。\n通常、検索フィールドにクエリを入力すると、すべてのアプリケーションのすべての検索フィールドが同じ値で更新されます。これはまったくのナンセンスであり、この設定を「いいえ」にすることで無効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우와 앱 간에 검색어를 동기화합니다.\n일반적으로 찾기 필드에 검색어를 입력하면 모든 앱의 모든 찾기 필드가 같은 값으로 업데이트됩니다. 이는 전혀 말이 되지 않으므로 이 설정을 아니요로 지정하여 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar consultas de busca entre janelas e aplicativos.\nNormalmente, quando você digita uma consulta de busca em um campo de busca, todos os campos de busca em todos os aplicativos são atualizados para conter o mesmo valor. Isso é um completo absurdo e pode ser desativado definindo esta preferência como Não."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизировать поисковые запросы между окнами и приложениями.\nОбычно при вводе поискового запроса в поле поиска все поля поиска во всех приложениях обновляются, получая то же значение. Это полная бессмыслица, и её можно отключить, установив этот параметр в «Нет»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama sorgularını pencereler ve uygulamalar arasında eşzamanla.\nNormalde bir Bul alanına sorgu girdiğinizde tüm uygulamalardaki tüm bul alanları aynı değeri tutacak şekilde güncellenir. Bu tamamen saçmalıktır ve bu tercih Hayır yapılarak devre dışı bırakılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应在窗口和应用程序间同步搜索查询？  \n通常，在查找字段输入搜索词后，所有应用的查找字段会更新为相同值。此设置完全无用，可通过将此偏好设为“否”来禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在各視窗和 App 之間同步搜尋字串。\n一般而言，當你在尋找欄位中輸入搜尋字串時，所有 App 中的所有尋找欄位都會更新為相同的值。這完全是無稽之談，可將此偏好設定設為「否」來停用。"
          }
        }
      }
    },
    "AdvancedSetting.synergyModifierRemappingEnabled" : {
      "comment" : "Advanced setting: synergyModifierRemappingEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbelegung von Modifizierertasten für von Synergy stammende Tastenanschläge unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support modifier remapping for keystrokes originated by Synergy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admite la reasignación de modificadores para pulsaciones originadas por Synergy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre en charge le remappage des modificateurs pour les frappes provenant de Synergy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporta la rimappatura dei tasti modificatori per i tasti premuti provenienti da Synergy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synergyから発生したキー入力の修飾キー再マッピングをサポートする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synergy에서 발생한 키 입력에 대해 보조 키 재지정을 지원합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar remapeamento de modificadores para teclas originadas pelo Synergy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживать переназначение модификаторов для нажатий клавиш, поступающих от Synergy."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synergy kaynaklı tuş vuruşları için değiştirici tuş yeniden atamayı destekle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应支持由 Synergy 产生的按键修饰映射？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援由 Synergy 發出之按鍵的變更鍵重新對應。"
          }
        }
      }
    },
    "AdvancedSetting.tabAutoShowHoldTime" : {
      "comment" : "Advanced setting: tabAutoShowHoldTime",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange Tabs im Vollbildmodus angezeigt werden sollen, in Sekunden.\nDie Tab-Leiste erscheint im Vollbildmodus kurz, wenn sich die Anzahl der Tabs ändert oder Sie den Tab wechseln. Diese Einstellung legt fest, wie lange sie in Sekunden sichtbar bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long in seconds to show tabs in fullscreen.\nThe tab bar appears briefly in fullscreen when the number of tabs changes or you switch tabs. This setting gives the time in seconds for it to remain visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos segundos se muestran las pestañas en pantalla completa.\nLa barra de pestañas aparece brevemente en pantalla completa cuando cambia el número de pestañas o cambias de pestaña. Este ajuste indica el tiempo en segundos que permanece visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée en secondes d’affichage des onglets en plein écran.\nLa barre d’onglets apparaît brièvement en plein écran lorsque le nombre d’onglets change ou que vous changez d’onglet. Ce réglage indique combien de secondes elle reste visible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quanti secondi mostrare i pannelli a tutto schermo.\nLa barra dei pannelli compare brevemente a tutto schermo quando cambia il numero di pannelli o passi da un pannello a un altro. Questa impostazione indica il tempo in secondi per cui rimane visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーンでタブを表示する時間（秒）。\nフルスクリーン時、タブの数が変わったりタブを切り替えたりすると、タブバーが一時的に表示されます。この設定はそれが表示され続ける時間（秒）を指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면에서 탭을 표시할 시간(초).\n탭 개수가 바뀌거나 탭을 전환하면 전체 화면에서 탭 막대가 잠시 나타납니다. 이 설정은 탭 막대가 보이는 시간을 초 단위로 지정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por quanto tempo, em segundos, mostrar as abas em tela cheia.\nA barra de abas aparece brevemente em tela cheia quando o número de abas muda ou você troca de aba. Este ajuste define o tempo em segundos que ela permanece visível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько секунд показывать вкладки в полноэкранном режиме.\nПанель вкладок ненадолго появляется в полноэкранном режиме при изменении числа вкладок или переключении между ними. Этот параметр задаёт время в секундах, в течение которого она остаётся видимой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam ekranda sekmelerin kaç saniye gösterileceği.\nSekme sayısı değiştiğinde veya sekme değiştirdiğinizde sekme çubuğu tam ekranda kısaca görünür. Bu ayar, görünür kalma süresini saniye olarak belirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全屏显示标签页需要多少秒？  \n当标签页数量变化或切换标签页时，全屏状态下标签页会短暂出现。此设置指定其保持可见的时间（以秒为单位）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全螢幕下顯示標籤頁的秒數。\n當標籤頁數量改變或你切換標籤頁時，標籤頁列會在全螢幕下短暫出現。此設定指定它保持可見的秒數。"
          }
        }
      }
    },
    "AdvancedSetting.tabCloseButtonsAlwaysVisible" : {
      "comment" : "Advanced setting: tabCloseButtonsAlwaysVisible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollen die Schließen-Schaltflächen der Tabs immer sichtbar bleiben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should tab close buttons always remain visible?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Deben los botones de cierre de pestaña permanecer siempre visibles?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons de fermeture des onglets doivent-ils toujours rester visibles ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti di chiusura dei pannelli devono rimanere sempre visibili?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブの閉じるボタンを常に表示したままにするか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 닫기 버튼을 항상 표시하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões de fechar aba devem permanecer sempre visíveis?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должны ли кнопки закрытия вкладок всегда оставаться видимыми?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme kapatma düğmeleri her zaman görünür kalsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应始终让标签页关闭按钮可见？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁的關閉按鈕是否應一律保持可見？"
          }
        }
      }
    },
    "AdvancedSetting.tabColorMenuOptions" : {
      "comment" : "Advanced setting: tabColorMenuOptions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben für den Menüpunkt „Tab-Farbe“.\nDurch Leerzeichen getrennte Zeichenfolgen wie #rrggbb oder #rgb im sRGB-Farbraum. Wenn der P3-Farbraum verfügbar ist, können Sie Zeichenfolgen wie color(p3 1 0.5 0.25) verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Colors for tab color menu item.\nSpace delimited strings like #rrggbb or #rgb in sRGB color space. If the P3 color space is available, you can use strings like: color(p3 1 0.5 0.25)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores del ítem de menú de color de pestaña.\nCadenas separadas por espacios como #rrggbb o #rgb en el espacio de color sRGB. Si el espacio de color P3 está disponible, puedes usar cadenas como: color(p3 1 0.5 0.25)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleurs de l’élément de menu de couleur d’onglet.\nChaînes séparées par des espaces comme #rrggbb ou #rgb dans l’espace colorimétrique sRGB. Si l’espace colorimétrique P3 est disponible, vous pouvez utiliser des chaînes comme : color(p3 1 0.5 0.25)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colori per la voce di menu del colore del pannello.\nStringhe separate da spazi come #rrggbb o #rgb nello spazio colore sRGB. Se lo spazio colore P3 è disponibile, puoi usare stringhe come: color(p3 1 0.5 0.25)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブの色メニュー項目の色。\nsRGBカラースペースでの#rrggbbや#rgbのようなスペース区切りの文字列。P3カラースペースが利用可能な場合、color(p3 1 0.5 0.25)のような文字列も使用できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 색상 메뉴 항목에 사용할 색상입니다.\nsRGB 색 공간의 #rrggbb 또는 #rgb 같은 문자열을 공백으로 구분하여 입력합니다. P3 색 공간을 사용할 수 있으면 다음과 같은 문자열을 사용할 수 있습니다: color(p3 1 0.5 0.25)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores para o item de menu de cor de aba.\nStrings separadas por espaço, como #rrggbb ou #rgb no espaço de cores sRGB. Se o espaço de cores P3 estiver disponível, você pode usar strings como: color(p3 1 0.5 0.25)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвета для пункта меню цвета вкладки.\nСтроки, разделённые пробелами, вида #rrggbb или #rgb в цветовом пространстве sRGB. Если доступно цветовое пространство P3, можно использовать строки вида: color(p3 1 0.5 0.25)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme rengi menü öğesi için renkler.\nsRGB renk alanında #rrggbb veya #rgb gibi boşlukla ayrılmış dizeler. P3 renk alanı varsa şu gibi dizeler kullanabilirsiniz: color(p3 1 0.5 0.25)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页颜色菜单项的颜色。  \n如 sRGB 颜色空间中的空格分隔字符串，例如 #rrggbb 或 #rgb。若可用 P3 颜色空间，可使用类似格式：color(p3 1 0.5 0.25)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁顏色選單項目的顏色。\n以空格分隔的字串，例如 sRGB 色彩空間中的 #rrggbb 或 #rgb。如果可以使用 P3 色彩空間，則可使用像這樣的字串：color(p3 1 0.5 0.25)"
          }
        }
      }
    },
    "AdvancedSetting.tabFlashAnimationDuration" : {
      "comment" : "Advanced setting: tabFlashAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer der Ein-/Ausblendanimation von Tabs im Vollbildmodus, in Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animation duration for fade in/out animation of tabs in full screen, in seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración de la animación de aparición/desaparición gradual de las pestañas en pantalla completa, en segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée de l’animation d’apparition/disparition en fondu des onglets en plein écran, en secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata dell’animazione di comparsa/scomparsa graduale dei pannelli a tutto schermo, in secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーンでのタブのフェードイン／アウトアニメーションの長さ（秒）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면에서 탭이 페이드 인/아웃되는 애니메이션의 지속 시간(초)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração da animação de fade in/out das abas em tela cheia, em segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность анимации появления/исчезновения вкладок в полноэкранном режиме, в секундах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam ekranda sekmelerin belirme/kaybolma animasyonunun saniye cinsinden süresi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全屏标签页淡入淡出动画的持续时间（以秒为单位）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全螢幕下標籤頁淡入/淡出動畫的持續時間，以秒為單位。"
          }
        }
      }
    },
    "AdvancedSetting.tabTitlesUseSmartTruncation" : {
      "comment" : "Advanced setting: tabTitlesUseSmartTruncation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Intelligente Kürzung“ für Tab-Titel verwenden.\nWenn der Titel eines Tabs zu lang ist, um zu passen, wird der Anfang des Titels mit Auslassungspunkten gekürzt, sofern in einem Fenster mehr Tabs eindeutige Suffixe als Präfixe haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use “smart truncation” for tab titles.\nIf a tab‘s title is too long to fit, ellipsize the start of the title if more tabs have unique suffixes than prefixes in a given window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “truncamiento inteligente” en los títulos de pestaña.\nSi el título de una pestaña es demasiado largo, se abrevia el inicio del título si hay más pestañas con sufijos únicos que con prefijos únicos en una ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser la « troncature intelligente » pour les titres d’onglets.\nSi le titre d’un onglet est trop long pour tenir, le début du titre est abrégé avec des points de suspension si, dans une fenêtre donnée, davantage d’onglets ont des suffixes uniques que des préfixes uniques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il “troncamento intelligente” per i titoli dei pannelli.\nSe il titolo di un pannello è troppo lungo, abbrevia l’inizio del titolo se in una finestra più pannelli hanno suffissi univoci che prefissi univoci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブタイトルに「スマート短縮」を使用する。\nタブのタイトルが長すぎて収まらない場合、あるウィンドウ内で、接頭辞よりも一意な接尾辞を持つタブが多ければ、タイトルの先頭を省略記号にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 제목에 ‘스마트 줄임’ 사용.\n탭 제목이 너무 길어 다 들어가지 않을 때, 윈도우에서 접두사보다 접미사가 고유한 탭이 더 많으면 제목의 앞부분을 말줄임표로 줄입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar “truncamento inteligente” para os títulos das abas.\nSe o título de uma aba for longo demais para caber, abreviar o início do título se, em uma dada janela, mais abas tiverem sufixos únicos do que prefixos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать «умное усечение» для заголовков вкладок.\nЕсли заголовок вкладки слишком длинный, чтобы поместиться, усекать многоточием начало заголовка, если в данном окне у вкладок больше уникальных суффиксов, чем префиксов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme başlıkları için “akıllı kısaltma” kullan.\nBir sekmenin başlığı sığmayacak kadar uzunsa, belirli bir pencerede benzersiz sonekleri olan sekme sayısı benzersiz önekleri olandan fazlaysa başlığın başı üç nokta ile kısaltılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应使用“智能截断”处理标签页标题？  \n若某个标签页的标题过长无法显示，且特定窗口中唯一后缀多于前缀时，可对标题开头进行省略处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁標題使用「智慧型截斷」。\n如果標籤頁的標題太長而無法完整顯示，且在指定視窗中具有唯一後綴的標籤頁比具有唯一前綴的更多，則省略標題的開頭。"
          }
        }
      }
    },
    "AdvancedSetting.tabsWrapAround" : {
      "comment" : "Advanced setting: tabsWrapAround",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulatoren brechen in die nächste Zeile um.\nDies ist nützlich, um Tabulatoren für ein späteres Kopieren in die Zwischenablage zu erhalten. Es bricht die Abwärtskompatibilität und kann bei Programmen, die dieses Verhalten nicht erwarten, zu Layout-Problemen führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tabs wrap around to the next line.\nThis is useful for preserving tabs for later copying to the pasteboard. It breaks backward compatibility and may cause layout problems with programs that don’t expect this behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pestañas continúan en la línea siguiente.\nSirve para conservar las pestañas para copiarlas después al portapapeles. Rompe la compatibilidad con versiones anteriores y puede causar problemas de diseño con programas que no esperan este comportamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tabulations passent à la ligne suivante.\nUtile pour conserver les tabulations en vue d’une copie ultérieure dans le presse-papiers. Cela rompt la rétrocompatibilité et peut causer des problèmes de mise en page avec les programmes qui n’attendent pas ce comportement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tabulazioni vanno a capo sulla riga successiva.\nÈ utile per conservare le tabulazioni da copiare poi negli Appunti. Interrompe la compatibilità con le versioni precedenti e può causare problemi di layout con i programmi che non si aspettano questo comportamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを次の行に折り返す。\nこれはタブを後でクリップボードにコピーするために保持するのに便利です。後方互換性を損ない、この動作を想定していないプログラムでレイアウトの問題を引き起こす可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭이 다음 줄로 줄바꿈됩니다.\n나중에 클립보드로 복사할 수 있도록 탭을 보존할 때 유용합니다. 하위 호환성이 깨지며, 이 동작을 예상하지 않는 프로그램에서 레이아웃 문제가 생길 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tabulações passam para a próxima linha.\nIsso é útil para preservar tabulações para copiar posteriormente para a área de transferência. Isso quebra a compatibilidade retroativa e pode causar problemas de layout com programas que não esperam esse comportamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символы табуляции переносятся на следующую строку.\nЭто полезно для сохранения табуляций при последующем копировании в буфер обмена. Это нарушает обратную совместимость и может вызывать проблемы с раскладкой у программ, не рассчитанных на такое поведение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme karakterleri sonraki satıra taşar.\nBu, sekme karakterlerini daha sonra panoya kopyalamak üzere korumak için kullanışlıdır. Geriye dönük uyumluluğu bozar ve bu davranışı beklemeyen programlarda yerleşim sorunlarına yol açabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页会环绕到下一行。  \n此功能有助于保存标签页以便后续复制到粘贴区，但会破坏向后兼容性，并可能导致不期望的布局问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁換行到下一行。\n這有助於保留標籤頁，以便稍後拷貝到剪貼簿。這會破壞向下相容性，並可能導致不預期此行為的程式出現版面問題。"
          }
        }
      }
    },
    "AdvancedSetting.throttleMetalConcurrentFrames" : {
      "comment" : "Advanced setting: throttleMetalConcurrentFrames",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl gleichzeitig verarbeiteter Frames reduzieren, wenn die GPU nicht schnell genug Drawables erzeugen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reduce number of frames in flight when GPU can't produce drawables quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce el número de fotogramas en curso cuando la GPU no puede producir drawables con rapidez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire le nombre d’images en cours lorsque le GPU ne peut pas produire rapidement des drawables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci il numero di fotogrammi in corso quando la GPU non riesce a produrre rapidamente i drawable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPUがすばやくdrawableを生成できない場合、実行中のフレーム数を減らす。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU가 drawable을 빠르게 생성하지 못할 때 처리 중인 프레임 수를 줄입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir o número de quadros em processamento quando a GPU não conseguir produzir drawables rapidamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшать число одновременно обрабатываемых кадров, когда GPU не успевает быстро создавать drawable-объекты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU drawable’ları hızlı üretemediğinde uçuştaki kare sayısını azalt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减少GPU无法快速生成绘制内容时的飞行帧数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 GPU 無法快速產生可繪製物件時，減少處理中的影格數。"
          }
        }
      }
    },
    "AdvancedSetting.timeBetweenBlinks" : {
      "comment" : "Advanced setting: timeBetweenBlinks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
