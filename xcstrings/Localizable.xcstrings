    "AdvancedSetting.asyncPreconvertStrings" : {
      "comment" : "Advanced setting: asyncPreconvertStrings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange Nicht-ASCII-Zeichenfolgen in einer Hintergrundwarteschlange vorkonvertieren.\nDies entkoppelt die Vorkonvertierung vom Parser-Thread für einen besseren Durchsatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pre-convert long non-ASCII strings on a background queue.\nThis decouples preconversion from the parser thread for better throughput."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preconvertir las cadenas largas no ASCII en una cola en segundo plano.\nEsto desacopla la preconversión del hilo del analizador para lograr un mejor rendimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préconvertir les longues chaînes non ASCII dans une file d’arrière-plan.\nCela découple la préconversion du thread d’analyse pour un meilleur débit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre-converti le stringhe lunghe non ASCII in una coda in background.\nQuesto separa la pre-conversione dal thread del parser per un throughput migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い非 ASCII 文字列をバックグラウンドキューで事前変換します。\nこれにより、事前変換をパーサースレッドから分離し、スループットを向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 큐에서 긴 비ASCII 문자열을 미리 변환.\n처리량을 높이기 위해 사전 변환을 파서 스레드와 분리합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-converter strings longas não-ASCII em uma fila em segundo plano.\nIsso desacopla a pré-conversão da thread do analisador para melhor taxa de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительно преобразовывать длинные строки не из ASCII в фоновой очереди.\nЭто отделяет предварительное преобразование от потока разбора для повышения пропускной способности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun ASCII dışı dizeleri arka plan kuyruğunda ön dönüştür.\nBu, daha iyi verim için ön dönüştürmeyi ayrıştırıcı iş parçacığından ayırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台队列中对长非 ASCII 字符串进行预转换。\n此操作将预转换与解析线程分离，以提高吞吐量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景佇列中預先轉換較長的非 ASCII 字串。\n這會讓預先轉換與解析器執行緒分離，以提高傳輸量。"
          }
        }
      }
    },
