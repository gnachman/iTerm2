    "CorruptApplication.SignatureMismatch" : {
      "comment" : "Alert shown when a required resource is missing and the code signature does not match the official distribution",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požadovaný soubor chybí nebo je poškozen a podpis kódu aplikace iTerm2 neodpovídá oficiální distribuci. Stáhněte si novou kopii aplikace a nainstalujte ji znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et nødvendigt arkiv mangler eller er beskadiget, og kodesignaturen for iTerm2 svarede ikke til den officielle udgivelses. Du bør hente en ny kopi af appen og installere den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, und die Codesignatur von iTerm2 stimmte nicht mit der der offiziellen Distribution überein. Sie sollten eine neue Kopie der App herunterladen und sie neu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted and iTerm2’s code signature did not match that of the official distribution. You should download a fresh copy of the app and reinstall it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o que está dañado, y la firma de código de iTerm2 no coincide con la de la distribución oficial. Debes descargar una copia nueva de la app y reinstalarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvittava tiedosto näyttää puuttuvan tai olevan vioittunut, eikä iTerm2:n koodiallekirjoitus vastannut virallisen jakelun allekirjoitusta. Lataa sovelluksesta uusi kopio ja asenna se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu, et la signature de code d’iTerm2 ne correspond pas à celle de la distribution officielle. Vous devriez télécharger une nouvelle copie de l’app et la réinstaller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato e la firma del codice di iTerm2 non corrisponde a quella della distribuzione ufficiale. Scarica una nuova copia dell’app e reinstallala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようで、iTerm2のコード署名が公式配布版のものと一致しませんでした。アプリを新たにダウンロードして再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것 같으며, iTerm2의 코드 서명이 공식 배포판의 서명과 일치하지 않습니다. 앱을 새로 다운로드하여 다시 설치하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nødvendig fil ser ut til å mangle eller være skadet, og iTerm2s kodesignatur samsvarte ikke med den i den offisielle distribusjonen. Du bør laste ned en ny kopi av appen og installere den på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vereist bestand lijkt te ontbreken of beschadigd te zijn, en de codehandtekening van iTerm2 komt niet overeen met die van de officiële distributie. Download een nieuwe kopie van de app en installeer die opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje wymaganego pliku lub jest on uszkodzony, a podpis kodu iTerm2 nie zgadza się z podpisem oficjalnej dystrybucji. Pobierz nową kopię aplikacji i zainstaluj ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido e a assinatura de código do iTerm2 não correspondeu à da distribuição oficial. Você deve baixar uma cópia nova do app e reinstalá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, а цифровая подпись кода iTerm2 не совпадает с подписью официальной версии. Рекомендуется скачать новую копию приложения и переустановить его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že chýba potrebný súbor alebo je poškodený, a podpis kódu iTerm2 sa nezhoduje s oficiálnou distribúciou. Mali by ste stiahnuť novú kópiu apky a znovu ju nainštalovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdi se, da manjka zahtevana datoteka ali je poškodovana, podpis kode aplikacije iTerm2 pa se ne ujema s podpisom uradne distribucije. Prenesite novo kopijo aplikacije in jo znova namestite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nödvändig fil verkar saknas eller vara skadad, och iTerm2:s kodsignatur matchade inte den officiella distributionens. Du bör hämta en ny kopia av appen och installera om den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor ve iTerm2’nin kod imzası resmi dağıtımınkiyle eşleşmedi. Uygulamanın yeni bir kopyasını indirip yeniden yüklemelisiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ một tệp bắt buộc bị thiếu hoặc bị hỏng, và chữ ký mã của iTerm2 không khớp với bản phát hành chính thức. Bạn nên tải về bản mới của ứng dụng và cài đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，且 iTerm2 的代码签名与官方版本不符。您应该下载新的应用并重新安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少必要的檔案或檔案已損毀，且 iTerm2 的程式碼簽章與官方發行版本不符。你應該下載全新的 App 副本並重新安裝。"
          }
        }
      }
    },
