    "ClaudeCode.StopAllowingHostBody" : {
      "comment" : "Body of the question asked when uninstalling the Claude Code integration from an always-allowed host; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Verwendungen von it2 auf %@ sind möglicherweise darauf angewiesen. Sie können dies auch später unter Einstellungen > Allgemein > Magie > API-Zugriff über SSH ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Other uses of it2 on %@ may rely on it. You can also change this later in Settings > General > Magic > API access over ssh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que otros usos de it2 en %@ dependan de ello. También puedes cambiarlo más tarde en Ajustes > General > Magia > Acceso a la API por SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres utilisations de it2 sur %@ peuvent en dépendre. Vous pouvez aussi modifier cela plus tard dans Réglages > Général > Magie > Accès à l’API via SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri usi di it2 su %@ potrebbero dipenderne. Puoi anche modificarlo in seguito in Impostazioni > Generali > Magia > Accesso all’API tramite ssh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@上の他のit2の用途がこれに依存している可能性があります。これは後で「設定 > 一般 > Magic > SSH経由のAPIアクセス」で変更することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 it2를 사용하는 다른 기능이 이 허용에 의존할 수 있습니다. 나중에 설정 > 일반 > 매직 > SSH를 통한 API 접근에서 변경할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros usos do it2 em %@ podem depender disso. Você também pode alterar isso mais tarde em Ajustes > Geral > Magic > Acesso à API via SSH."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие способы использования it2 на %@ могут зависеть от этого разрешения. Это также можно изменить позже в разделе Настройки > Общие > Магия > Доступ к API через SSH."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ana makinesindeki it2’nin diğer kullanımları buna bağlı olabilir. Bunu daha sonra Ayarlar > Genel > Sihir > SSH üzerinden API erişimi bölümünden de değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上 it2 的其他用途可能依赖于此。你也可以稍后在“设置 > 通用 > Magic > 通过 SSH 访问 API”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上其他使用 it2 的地方可能依賴於此。你也可以稍後在「設定 > 一般 > 魔法 > 透過 ssh 存取 API」中變更。"
          }
        }
      }
    },
    "ClaudeCode.StopAllowingHostTitle" : {
      "comment" : "Title of the question asked when uninstalling the Claude Code integration from a host that is always allowed to use the API; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auch nicht mehr dauerhaft die Verwendung der iTerm2-API erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Also Stop Always Allowing %@ to Use the iTerm2 API?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dejar también de permitir siempre que %@ use la API de iTerm2?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne plus toujours autoriser %@ à utiliser l’API d’iTerm2 ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi anche smettere di consentire sempre a %@ di usare l’API di iTerm2?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にiTerm2 APIの使用を常に許可することも停止しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) iTerm2 API를 항상 사용하도록 허용하는 것도 중단하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também parar de sempre permitir que %@ use a API do iTerm2?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также перестать всегда разрешать %@ использовать API iTerm2?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
