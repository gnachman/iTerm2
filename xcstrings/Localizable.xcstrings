        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение альфа-канала для цвета вкладки для невыбранных цветных вкладок в теме Minimal.\nДолжно быть между 0 и 1."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal temada seçili olmayan renkli sekmelerin sekme rengi için alfa değeri.\n0 ile 1 arasında olmalıdır."
