    "NaggingController.ArrangementBadPWD" : {
      "comment" : "Announcement that a saved arrangement has an invalid initial directory; first placeholder is the arrangement name, second is the directory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené uspořádání „%1$@“ má pro tuto relaci neplatný počáteční adresář „%2$@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gemte opstilling “%1$@” har en ugyldig startmappe, “%2$@”, til denne session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Anordnung „%1$@“ hat für diese Sitzung ein ungültiges Startverzeichnis „%2$@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The saved arrangement “%1$@” has a bad initial directory of “%2$@” for this session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición guardada “%1$@” tiene un directorio inicial no válido, “%2$@”, para esta sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetun järjestelyn ”%1$@” tämän istunnon aloitushakemisto ”%2$@” on virheellinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition enregistrée « %1$@ » a un répertoire initial incorrect (« %2$@ ») pour cette session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposizione salvata “%1$@” ha una directory iniziale non valida, “%2$@”, per questa sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたアレンジメント「%1$@」には、このセッション用の不正な初期ディレクトリ「%2$@」が設定されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 윈도우 배치 “%1$@”에서 이 세션의 초기 디렉토리 “%2$@”이(가) 잘못되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lagrede oppsettet «%1$@» har en ugyldig startmappe, «%2$@», for denne økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bewaarde indeling ‘%1$@’ heeft een ongeldige beginmap ‘%2$@’ voor deze sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisany układ „%1$@” ma nieprawidłowy początkowy katalog „%2$@” dla tej sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A disposição salva “%1$@” tem um diretório inicial inválido “%2$@” para esta sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённая раскладка «%1$@» имеет неверный начальный каталог «%2$@» для этой сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené usporiadanie „%1$@“ má pre túto reláciu neplatný počiatočný adresár „%2$@“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shranjena razporeditev »%1$@« ima za to sejo neveljaven začetni imenik »%2$@«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sparade arrangemanget ”%1$@” har en felaktig ursprungskatalog, ”%2$@”, för den här sessionen."
          }
