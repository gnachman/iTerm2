    "HotKeyMigration.MigrateTitle" : {
      "comment" : "Message explaining that a hotkey window's dynamic profile must be migrated; %@ is the profile name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil Ihres Hotkey-Fensters ist ein dynamisches Profil namens „%@“. Es muss für diese Version von iTerm2 aktualisiert werden, da Hotkey-Einstellungen jetzt im Profil gespeichert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your hotkey window‘s profile is a dynamic profile named “%@.” It needs to be updated for this version of iTerm2 because hotkey settings are now stored in the profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil de tu ventana de tecla rápida es un perfil dinámico llamado “%@.” Hay que actualizarlo para esta versión de iTerm2 porque los ajustes de la tecla rápida ahora se guardan en el perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil de votre fenêtre à raccourci global est un profil dynamique nommé « %@ ». Il doit être mis à jour pour cette version d’iTerm2, car les réglages de raccourci global sont désormais stockés dans le profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo della tua finestra ad abbreviazione globale è un profilo dinamico chiamato “%@.” Deve essere aggiornato per questa versione di iTerm2 perché le impostazioni dell’abbreviazione globale ora sono salvate nel profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキーウインドウのプロファイルはダイナミックプロファイル「%@」です。ホットキー設定がプロファイルに保存されるようになったため、このバージョンの iTerm2 用に更新する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 윈도우의 프로파일은 “%@”(이)라는 동적 프로파일입니다. 이제 단축키 설정이 프로파일에 저장되므로 이 버전의 iTerm2에 맞게 업데이트해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil da sua janela de hotkey é um perfil dinâmico chamado “%@.” Ele precisa ser atualizado para esta versão do iTerm2 porque os ajustes de hotkey agora são armazenados no perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилем вашего окна по горячей клавише является динамический профиль с именем «%@». Его необходимо обновить для этой версии iTerm2, так как настройки горячих клавиш теперь хранятся в профиле."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşu penceresi profiliniz “%@” adlı bir dinamik profil. Kısayol tuşu ayarları artık profilde saklandığından, iTerm2’nin bu sürümü için güncellenmesi gerekiyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的热键窗口的配置文件是一个名为“%@.”的动态配置文件。由于热键设置现在存储在该配置文件中，因此需要针对此版本的iTerm2进行更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的全域快速鍵視窗描述檔是名為「%@」的動態描述檔。由於全域快速鍵設定現在儲存在描述檔中，需要針對此版本的 iTerm2 進行更新。"
          }
        }
      }
    },
