    "OnePassword.CannotFindMessage" : {
      "comment" : "Explanation shown when the 1Password CLI cannot be found automatically",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby mohl iTerm2 používat integraci s 1Password, musí vědět, kde najde aplikaci příkazového řádku „op“. Obvykle je v /usr/local/bin. Pokud jste ji nainstalovali jinam, klikněte na „Vyhledat“ a zadejte její umístění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at bruge 1Password-integrationen skal iTerm2 vide, hvor kommandolinjeprogrammet “op” findes. Det ligger normalt i /usr/local/bin. Hvis du har installeret det et andet sted, skal du klikke på Find for at angive placeringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die 1Password-Integration zu nutzen, muss iTerm2 wissen, wo sich die CLI-App namens „op“ befindet. Normalerweise befindet sie sich in /usr/local/bin. Wenn Sie sie an einem anderen Ort installiert haben, wählen Sie bitte „Suchen“, um den Speicherort anzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In order to use the 1Password integration, iTerm2 needs to know where to find the CLI app named “op”. It’s normally in /usr/local/bin. If you have installed it elsewhere, please select Locate to provide its location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar la integración con 1Password, iTerm2 necesita saber dónde encontrar la app de CLI llamada “op”. Normalmente está en /usr/local/bin. Si la instalaste en otro lugar, selecciona Localizar para indicar su ubicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password-integraatio edellyttää, että iTerm2 tietää, mistä komentorivisovellus ”op” löytyy. Se on yleensä hakemistossa /usr/local/bin. Jos olet asentanut sen muualle, valitse Paikanna ja anna sen sijainti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour utiliser l’intégration de 1Password, iTerm2 doit savoir où trouver l’app CLI nommée « op ». Elle se trouve normalement dans /usr/local/bin. Si vous l’avez installée ailleurs, cliquez sur Localiser pour indiquer son emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per usare l’integrazione con 1Password, iTerm2 deve sapere dove trovare l’app CLI chiamata “op”. Normalmente si trova in /usr/local/bin. Se l’hai installata altrove, seleziona Individua per indicarne la posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password連携機能を使用するには、iTerm2は「op」という名前のCLIアプリの場所を知る必要があります。通常は/usr/local/binにあります。別の場所にインストールしている場合は、「探す」を選択して場所を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password 통합을 사용하려면 iTerm2가 “op”라는 CLI 앱의 위치를 알아야 합니다. 일반적으로 /usr/local/bin에 있습니다. 다른 곳에 설치했다면 ‘위치 지정’을 선택하여 위치를 알려 주십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å bruke 1Password-integreringen må iTerm2 vite hvor CLI-appen «op» ligger. Den ligger vanligvis i /usr/local/bin. Hvis du har installert den et annet sted, velg Finn for å angi plasseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de 1Password-integratie te gebruiken, moet iTerm2 weten waar de CLI-app ‘op’ staat. Die staat normaal in /usr/local/bin. Als je de app ergens anders hebt geïnstalleerd, klik dan op ‘Geef locatie op’ om de locatie aan te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby korzystać z integracji z 1Password, iTerm2 musi wiedzieć, gdzie znaleźć aplikację wiersza poleceń „op”. Zwykle znajduje się w /usr/local/bin. Jeśli zainstalowano ją gdzie indziej, wybierz Wskaż, aby podać jej lokalizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar a integração com o 1Password, o iTerm2 precisa saber onde encontrar o app de CLI chamado “op”. Ele normalmente está em /usr/local/bin. Se você o instalou em outro lugar, selecione Localizar para fornecer sua localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать интеграцию с 1Password, iTerm2 должен знать, где найти CLI-приложение с именем «op». Обычно оно находится в /usr/local/bin. Если вы установили его в другое место, выберите «Найти», чтобы указать его расположение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na používanie integrácie s 1Password musí iTerm2 vedieť, kde nájsť aplikáciu CLI s názvom „op“. Zvyčajne je v /usr/local/bin. Ak ste ju nainštalovali inde, vyberte Nájsť a zadajte jej umiestnenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za uporabo integracije z 1Password mora iTerm2 vedeti, kje je aplikacija CLI z imenom »op«. Običajno je v /usr/local/bin. Če ste jo namestili drugam, izberite »Poišči«, da navedete njeno lokacijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att använda 1Password-integreringen måste iTerm2 veta var CLI-appen ”op” finns. Den finns vanligtvis i /usr/local/bin. Om du har installerat den någon annanstans väljer du Leta upp för att ange dess plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password entegrasyonunu kullanmak için iTerm2’nin “op” adlı CLI uygulamasının nerede olduğunu bilmesi gerekir. Normalde /usr/local/bin içindedir. Başka bir yere yüklediyseniz konumunu belirtmek için lütfen “Konumunu Belirt” seçeneğini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để dùng tích hợp 1Password, iTerm2 cần biết vị trí của ứng dụng CLI có tên “op”. Thông thường nó nằm trong /usr/local/bin. Nếu bạn đã cài đặt ở nơi khác, vui lòng chọn Định vị để cung cấp vị trí của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用 1Password 集成，iTerm2 需要知道名为“op”的 CLI 应用的位置。它通常在 /usr/local/bin。如果你安装在别处，请选择“定位”以提供其位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使用 1Password 整合功能，iTerm2 需要知道名為「op」的 CLI App 位於何處。它通常位於 /usr/local/bin。如果你將它安裝在其他位置，請選取「尋找位置」來指定其位置。"
          }
        }
      }
    },
