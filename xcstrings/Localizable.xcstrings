    "AdvancedSetting.noSyncVariablesToReport" : {
      "comment" : "Advanced setting: noSyncVariablesToReport",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proměnné hlášené pomocí řídicí sekvence\nJe to seznam proměnných oddělených čárkami, které lze hlásit řídicí sekvencí OSC 1337 ReportVariable=name. Každý název proměnné musí mít předponu „allow:“ nebo „deny:“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabler, der rapporteres via kontrolsekvens\nDette er en kommasepareret liste over variabler, der kan rapporteres med kontrolsekvensen OSC 1337 ReportVariable=name. Hvert variabelnavn skal have præfikset “allow:” eller “deny:”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Steuersequenz zu meldende Variablen\nDies ist eine durch Kommas getrennte Liste von Variablen, die mit der Steuersequenz OSC 1337 ReportVariable=name gemeldet werden können. Jedem Variablennamen muss „allow:“ oder „deny:“ vorangestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Variables to report via control sequence\nThis is a comma-delimited list of variables that can be reported with the OSC 1337 ReportVariable=name control sequence. Each variable name must be prefixed with “allow:” or “deny:”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variables de las que se informa mediante secuencia de control\nEs una lista de variables separadas por comas que sobre las que se puede informar con la secuencia de control OSC 1337 ReportVariable=name. Cada nombre de variable debe llevar el prefijo “allow:” o “deny:”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjaussarjalla raportoitavat muuttujat\nTämä on pilkuilla erotettu luettelo muuttujista, jotka voidaan raportoida OSC 1337 ReportVariable=name -ohjaussarjalla. Jokaisen muuttujan nimen edessä on oltava ”allow:” tai ”deny:”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variables à signaler via une séquence de contrôle\nListe de variables séparées par des virgules pouvant être signalées avec la séquence de contrôle OSC 1337 ReportVariable=nom. Le nom de chaque variable doit être préfixé par « allow: » ou « deny: »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabili da segnalare tramite sequenza di controllo\nÈ un elenco di variabili separate da virgole che possono essere segnalate con la sequenza di controllo OSC 1337 ReportVariable=name. Ogni nome di variabile deve avere il prefisso “allow:” o “deny:”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制御シーケンスで報告する変数\nOSC 1337 ReportVariable=name制御シーケンスで報告できる変数のカンマ区切りリストです。各変数名の先頭には「allow:」または「deny:」を付ける必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 시퀀스로 보고할 변수\nOSC 1337 ReportVariable=name 제어 시퀀스로 보고할 수 있는 변수를 쉼표로 구분한 목록입니다. 각 변수 이름 앞에는 “allow:” 또는 “deny:”를 붙여야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabler som rapporteres via kontrollsekvens\nDette er en kommadelt liste over variabler som kan rapporteres med kontrollsekvensen OSC 1337 ReportVariable=name. Hvert variabelnavn må ha prefikset «allow:» eller «deny:»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabelen die via een besturingsreeks worden gerapporteerd\nDit is een door komma’s gescheiden lijst met variabelen die kunnen worden gerapporteerd met de besturingsreeks OSC 1337 ReportVariable=name. Elke variabelenaam moet worden voorafgegaan door ‘allow:’ of ‘deny:’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienne raportowane przez sekwencję sterującą\nTo lista zmiennych oddzielonych przecinkami, które można raportować sekwencją sterującą OSC 1337 ReportVariable=name. Nazwa każdej zmiennej musi mieć prefiks „allow:” lub „deny:”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variáveis a relatar via sequência de controle\nEsta é uma lista de variáveis delimitada por vírgulas que podem ser relatadas com a sequência de controle OSC 1337 ReportVariable=name. Cada nome de variável deve ter o prefixo “allow:” ou “deny:”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переменные, передаваемые через управляющую последовательность\nЭто список переменных, разделённых запятыми, которые можно передать управляющей последовательностью OSC 1337 ReportVariable=name. Перед именем каждой переменной должен стоять префикс «allow:» или «deny:»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premenné na hlásenie cez riadiacu sekvenciu\nToto je zoznam premenných oddelených čiarkami, ktoré možno hlásiť riadiacou sekvenciou OSC 1337 ReportVariable=name. Pred názvom každej premennej musí byť „allow:“ alebo „deny:“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremenljivke za poročanje prek krmilnega zaporedja\nTo je z vejicami ločen seznam spremenljivk, o katerih se lahko poroča s krmilnim zaporedjem OSC 1337 ReportVariable=name. Imenu vsake spremenljivke mora biti dodana predpona »allow:« ali »deny:«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabler att rapportera via styrsekvens\nDet här är en kommaavgränsad lista med variabler som kan rapporteras med styrsekvensen OSC 1337 ReportVariable=namn. Varje variabelnamn måste ha prefixet ”allow:” eller ”deny:”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim dizisiyle raporlanacak değişkenler\nBu, OSC 1337 ReportVariable=name denetim dizisiyle raporlanabilecek değişkenlerin virgülle ayrılmış listesidir. Her değişken adının önüne “allow:” veya “deny:” eklenmelidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các biến cần báo cáo qua chuỗi điều khiển\nĐây là danh sách các biến phân cách bằng dấu phẩy có thể được báo cáo bằng chuỗi điều khiển OSC 1337 ReportVariable=name. Mỗi tên biến phải có tiền tố “allow:” hoặc “deny:”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过控制序列报告的变量  \n这是用逗号分隔的变量列表，可通过OSC 1337 ReportVariable=name控制序列报告。每个变量名必须以“allow:”或“deny:”开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過控制序列回報的變數\n這是以逗號分隔的變數清單，可透過 OSC 1337 ReportVariable=name 控制序列回報。每個變數名稱開頭必須加上「allow:」或「deny:」。"
          }
        }
      }
    },
    "AdvancedSetting.numberOfLinesForAccessibility" : {
      "comment" : "Advanced setting: numberOfLinesForAccessibility",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální počet řádků historie zpřístupněných funkci Zpřístupnění.\nRozhraní pro zpřístupnění mohou iTerm2 zpomalit. Abyste tento vliv omezili, můžete omezit počet řádků v každé relaci viditelných pro zpřístupnění. Zpřístupní se posledních řádků každé relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt antal linjer historik, der gøres tilgængelige for Tilgængelighed.\nTilgængeligheds-API’er kan gøre iTerm2 langsom. For at begrænse effekten kan du begrænse antallet af linjer i hver session, der er synlige for tilgængelighed. De sidste linjer i hver session gøres tilgængelige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Verlaufszeilen, die für die Bedienungshilfen sichtbar sind.\nAPIs für Bedienungshilfen können iTerm2 verlangsamen. Um diesen Effekt zu begrenzen, können Sie die Anzahl der pro Sitzung für Bedienungshilfen sichtbaren Zeilen einschränken. Die letzten Zeilen jeder Sitzung werden zugänglich gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of lines of history to expose to Accessibility.\nAccessibility APIs can make iTerm2 slow. In order to limit the effect, you can restrict the number of lines in each session that are visible to accessibility. The last lines of each session will be made accessible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de líneas de historial que se exponen a Accesibilidad.\nLas API de accesibilidad pueden ralentizar iTerm2. Para limitar el efecto, puedes restringir el número de líneas de cada sesión visibles para la accesibilidad. Se harán accesibles las últimas líneas de cada sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttöavulle paljastettavien historiarivien enimmäismäärä.\nKäyttöavun API:t voivat hidastaa iTerm2:ta. Rajoittaaksesi vaikutusta voit rajoittaa kunkin istunnon käyttöavulle näkyvien rivien määrää. Kunkin istunnon viimeiset rivit tehdään käytettäviksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal de lignes d’historique à exposer à l’accessibilité.\nLes API d’accessibilité peuvent ralentir iTerm2. Pour limiter cet effet, vous pouvez restreindre le nombre de lignes de chaque session visibles par l’accessibilité. Les dernières lignes de chaque session seront rendues accessibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di righe di cronologia da esporre ad Accessibilità.\nLe API di accessibilità possono rallentare iTerm2. Per limitarne l’effetto, puoi restringere il numero di righe di ogni sessione visibili all’accessibilità. Saranno rese accessibili le ultime righe di ogni sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilityに公開する履歴の最大行数。\nAccessibility APIはiTerm2を遅くすることがあります。その影響を抑えるため、各セッションでAccessibilityに公開する行数を制限できます。各セッションの最後の行がAccessibilityで利用可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용에 노출할 기록의 최대 줄 수.\n손쉬운 사용 API는 iTerm2를 느리게 만들 수 있습니다. 그 영향을 줄이기 위해 각 세션에서 손쉬운 사용에 보이는 줄 수를 제한할 수 있습니다. 각 세션의 마지막 줄들이 손쉬운 사용에 제공됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt antall historikklinjer som gjøres tilgjengelige for Tilgjengelighet.\nTilgjengelighets-API-er kan gjøre iTerm2 tregt. For å begrense effekten kan du begrense antall linjer i hver økt som er synlige for tilgjengelighet. De siste linjene i hver økt gjøres tilgjengelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaal aantal regels geschiedenis dat voor Toegankelijkheid beschikbaar wordt gesteld.\nToegankelijkheids-API’s kunnen iTerm2 traag maken. Om dit effect te beperken, kun je het aantal regels per sessie dat zichtbaar is voor toegankelijkheid beperken. De laatste regels van elke sessie worden toegankelijk gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna liczba wierszy historii udostępnianych funkcjom dostępności.\nAPI dostępności mogą spowalniać iTerm2. Aby ograniczyć ten efekt, możesz ograniczyć liczbę wierszy w każdej sesji widocznych dla funkcji dostępności. Dostępne będą ostatnie wiersze każdej sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de linhas de histórico a expor à Acessibilidade.\nAs APIs de acessibilidade podem deixar o iTerm2 lento. Para limitar o efeito, você pode restringir o número de linhas em cada sessão que ficam visíveis para a acessibilidade. As últimas linhas de cada sessão serão tornadas acessíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное число строк истории, доступных для Accessibility.\nAPI специальных возможностей (Accessibility) может замедлять работу iTerm2. Чтобы ограничить этот эффект, можно указать число строк в каждом сеансе, доступных для специальных возможностей. Доступными будут последние строки каждого сеанса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximálny počet riadkov histórie sprístupnených Prístupnosti.\nAPI prístupnosti môžu iTerm2 spomaliť. Na obmedzenie tohto vplyvu môžete obmedziť počet riadkov každej relácie, ktoré sú viditeľné pre prístupnosť. Sprístupnia sa posledné riadky každej relácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največje število vrstic zgodovine, izpostavljenih funkciji Dostopnost.\nAPI-ji za dostopnost lahko upočasnijo iTerm2. Za omejitev učinka lahko omejite število vrstic v vsaki seji, ki so vidne za dostopnost. Dostopne bodo zadnje vrstice vsake seje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högsta antal historikrader som görs tillgängliga för Hjälpmedel.\nHjälpmedels-API:er kan göra iTerm2 långsamt. För att begränsa effekten kan du begränsa antalet rader i varje session som är synliga för hjälpmedel. De sista raderna i varje session görs tillgängliga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik’e sunulacak azami geçmiş satırı sayısı.\nErişilebilirlik API’leri iTerm2’yi yavaşlatabilir. Etkisini sınırlamak için her oturumda erişilebilirliğe görünür olan satır sayısını kısıtlayabilirsiniz. Her oturumun son satırları erişilebilir kılınır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dòng lịch sử tối đa cung cấp cho Trợ năng.\nAPI Trợ năng có thể làm iTerm2 chậm. Để hạn chế ảnh hưởng, bạn có thể giới hạn số dòng của mỗi phiên hiển thị với trợ năng. Những dòng cuối cùng của mỗi phiên sẽ được cung cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可让辅助功能访问的历史记录最大行数。  \n辅助功能API可能导致iTerm2变慢。为限制影响，可限制每个会话中可见的辅助功能行数。每个会话的最后几行将可被访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向輔助使用公開的歷史記錄最大行數。\n輔助使用 API 可能使 iTerm2 變慢。為了限制影響，你可以限制每個工作階段中輔助使用可見的行數。每個工作階段的最後幾行將可供輔助使用取用。"
          }
        }
      }
    },
    "AdvancedSetting.ollamaKeepAlive" : {
      "comment" : "Advanced setting: ollamaKeepAlive",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive pro nativní požadavky na /api/chat.\nJak dlouho Ollama po požadavku udržuje model v paměti, např. 30m, 1h, nebo 0 pro okamžité uvolnění. Prázdná hodnota znamená vynechat pole a použít výchozí hodnotu Ollamy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive til native /api/chat-forespørgsler.\nHvor længe Ollama beholder modellen i hukommelsen efter en forespørgsel, f.eks. 30m, 1h eller 0 for at fjerne den med det samme. Tom betyder, at feltet udelades, og Ollamas egen standard bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive für native /api/chat-Anfragen.\nWie lange Ollama das Modell nach einer Anfrage geladen hält, z. B. 30m, 1h oder 0, um es sofort zu entladen. Leer bedeutet, das Feld weglassen und Ollamas eigenen Standardwert verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ollama keep_alive for native /api/chat requests.\nHow long Ollama keeps the model resident after a request, e.g. 30m, 1h, or 0 to unload immediately. Empty means omit the field and use Ollama’s own default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep_alive de Ollama para solicitudes nativas a /api/chat.\nCuánto tiempo mantiene Ollama el modelo residente tras una solicitud, p. ej., 30m, 1h, o 0 para descargarlo de inmediato. Vacío significa omitir el campo y usar el valor predeterminado de Ollama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollaman keep_alive natiiveille /api/chat-pyynnöille.\nKuinka kauan Ollama pitää mallin muistissa pyynnön jälkeen, esim. 30m, 1h tai 0 purkaaksesi heti. Tyhjä tarkoittaa, että kenttä jätetään pois ja käytetään Ollaman omaa oletusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep_alive d’Ollama pour les requêtes /api/chat natives.\nDurée pendant laquelle Ollama garde le modèle en mémoire après une requête, par exemple 30m, 1h, ou 0 pour le décharger immédiatement. Vide signifie omettre le champ et utiliser la valeur par défaut d’Ollama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep_alive di Ollama per le richieste native a /api/chat.\nPer quanto tempo Ollama mantiene il modello in memoria dopo una richiesta, ad esempio 30m, 1h, oppure 0 per scaricarlo subito. Vuoto significa omettere il campo e usare il valore predefinito di Ollama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネイティブの/api/chatリクエストに対するOllamaのkeep_alive。\nリクエスト後にOllamaがモデルをメモリ上に保持する時間を指定します。例：30m、1h。すぐにアンロードする場合は0を指定します。空欄の場合はこのフィールドを省略し、Ollama自体のデフォルト値を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 /api/chat 요청에 대한 Ollama keep_alive.\n요청 후 Ollama가 모델을 메모리에 유지하는 시간입니다(예: 30m, 1h, 즉시 내리려면 0). 비어 있으면 필드를 생략하고 Ollama 자체 기본값을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive for native /api/chat-forespørsler.\nHvor lenge Ollama beholder modellen i minnet etter en forespørsel, f.eks. 30m, 1h, eller 0 for å fjerne den umiddelbart. Tom betyr at feltet utelates og Ollamas egen standard brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive voor native /api/chat-verzoeken.\nHoe lang Ollama het model na een verzoek in het geheugen houdt, bijvoorbeeld 30m, 1h, of 0 om het meteen te verwijderen. Leeg betekent dat het veld wordt weggelaten en de eigen standaardwaarde van Ollama wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep_alive Ollama dla natywnych żądań /api/chat.\nJak długo Ollama przechowuje model w pamięci po żądaniu, np. 30m, 1h lub 0, aby zwolnić go natychmiast. Puste oznacza pominięcie pola i użycie własnej wartości domyślnej Ollama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep_alive do Ollama para requisições nativas de /api/chat.\nPor quanto tempo o Ollama mantém o modelo residente na memória após uma requisição, por exemplo 30m, 1h, ou 0 para descarregar imediatamente. Vazio significa omitir o campo e usar o padrão do próprio Ollama."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр keep_alive Ollama для встроенных запросов /api/chat.\nСколько времени Ollama держит модель в памяти после запроса, например 30m, 1h или 0 для немедленной выгрузки. Пустое значение означает, что поле не передаётся и используется значение по умолчанию из Ollama."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive pre natívne požiadavky /api/chat.\nAko dlho Ollama po požiadavke udržiava model v pamäti, napr. 30m, 1h alebo 0 na okamžité uvoľnenie. Prázdna hodnota znamená vynechať pole a použiť vlastnú predvolenú hodnotu Ollama."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive za izvorne zahteve /api/chat.\nKako dolgo Ollama obdrži model v pomnilniku po zahtevi, npr. 30m, 1h ali 0 za takojšnjo sprostitev. Prazno pomeni izpustitev polja in uporabo Ollaminega privzetka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama keep_alive för inbyggda /api/chat-förfrågningar.\nHur länge Ollama behåller modellen i minnet efter en förfrågan, t.ex. 30m, 1h eller 0 för att ta bort den direkt. Tomt betyder att fältet utelämnas och Ollamas eget förval används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel /api/chat istekleri için Ollama keep_alive değeri.\nOllama’nın bir istekten sonra modeli ne kadar süre bellekte tuttuğunu belirler; örn. 30m, 1h veya hemen boşaltmak için 0. Boş bırakılırsa alan atlanır ve Ollama’nın kendi varsayılanı kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep_alive của Ollama cho các yêu cầu /api/chat gốc.\nThời gian Ollama giữ mô hình trong bộ nhớ sau một yêu cầu, ví dụ 30m, 1h, hoặc 0 để gỡ ngay. Để trống nghĩa là bỏ qua trường này và dùng mặc định của Ollama."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于原生 /api/chat 请求的 Ollama keep_alive。\n请求结束后 Ollama 保持模型驻留的时长，例如 30m、1h，或 0 表示立即卸载。留空表示省略该字段，使用 Ollama 自身的默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生 /api/chat 請求的 Ollama keep_alive。\n請求之後 Ollama 讓模型常駐的時間，例如 30m、1h，或 0 表示立即卸載。留空表示省略此欄位並使用 Ollama 自己的預設值。"
          }
        }
      }
    },
    "AdvancedSetting.ollamaNumCtx" : {
      "comment" : "Advanced setting: ollamaNumCtx",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost kontextového okna Ollamy (num_ctx) pro nativní požadavky na /api/chat.\nOllama nastavuje num_ctx bez ohledu na model na malou hodnotu (kolem 4096), čímž tiše zkracuje dlouhé prompty. Hodnota 0 znamená určit velikost automaticky pro každý požadavek, omezenou kontextovým oknem modelu. Kladná hodnota to přepíše a odešle se beze změny (větší hodnoty využijí více paměti)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Størrelse på Ollamas kontekstvindue (num_ctx) til native /api/chat-forespørgsler.\nOllama sætter som standard num_ctx til en lille værdi (omkring 4096) uanset modellen, hvilket i stilhed afkorter lange prompter. 0 betyder, at størrelsen fastlægges automatisk for hver forespørgsel, begrænset til modellens kontekstvindue. En positiv værdi tilsidesætter det og sendes uændret (større værdier bruger mere hukommelse)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama-Kontextfenstergröße (num_ctx) für native /api/chat-Anfragen.\nOllama setzt num_ctx standardmäßig auf einen kleinen Wert (etwa 4096), unabhängig vom Modell, wodurch lange Prompts stillschweigend abgeschnitten werden. 0 bedeutet, die Größe pro Anfrage automatisch zu bestimmen, begrenzt auf das Kontextfenster des Modells. Ein positiver Wert überschreibt dies und wird unverändert gesendet (größere Werte verbrauchen mehr Arbeitsspeicher)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ollama context window size (num_ctx) for native /api/chat requests.\nOllama defaults num_ctx to a small value (around 4096) regardless of the model, silently truncating long prompts. 0 means size it automatically per request, capped at the model’s context window. A positive value overrides that and is sent verbatim (larger values use more memory)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño de la ventana de contexto de Ollama (num_ctx) para solicitudes nativas a /api/chat.\nOllama establece num_ctx por defecto en un valor pequeño (alrededor de 4096) sin importar el modelo, truncando en silencio los prompts largos. 0 significa dimensionarlo automáticamente por solicitud, limitado a la ventana de contexto del modelo. Un valor positivo lo anula y se envía tal cual (los valores mayores usan más memoria)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollaman kontekstin ikkunakoko (num_ctx) natiiveille /api/chat-pyynnöille.\nOllama asettaa num_ctx:n oletuksena pieneen arvoon (noin 4096) mallista riippumatta ja katkaisee pitkät kehotteet huomaamatta. 0 tarkoittaa, että koko määritetään automaattisesti pyyntökohtaisesti mallin kontekstin ikkunaan rajattuna. Positiivinen arvo ohittaa tämän ja lähetetään sellaisenaan (suuremmat arvot käyttävät enemmän muistia)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille de la fenêtre de contexte d’Ollama (num_ctx) pour les requêtes /api/chat natives.\nOllama définit num_ctx à une petite valeur (environ 4096) quel que soit le modèle, ce qui tronque silencieusement les longs prompts. 0 signifie un dimensionnement automatique par requête, plafonné à la fenêtre de contexte du modèle. Une valeur positive la remplace et est envoyée telle quelle (des valeurs plus grandes utilisent plus de mémoire)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensione della finestra di contesto di Ollama (num_ctx) per le richieste native a /api/chat.\nOllama imposta num_ctx per impostazione predefinita su un valore piccolo (circa 4096) indipendentemente dal modello, troncando in silenzio i prompt lunghi. 0 significa dimensionarla automaticamente per ogni richiesta, entro il limite della finestra di contesto del modello. Un valore positivo la sostituisce e viene inviato così com’è (valori maggiori usano più memoria)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネイティブの/api/chatリクエストに対するOllamaのコンテキストウィンドウサイズ（num_ctx）。\nOllamaはモデルに関係なくnum_ctxのデフォルトを小さい値（約4096）にするため、長いプロンプトが黙って切り捨てられます。0を指定するとリクエストごとに自動でサイズを決定し、モデルのコンテキストウィンドウを上限とします。正の値を指定するとこれを上書きし、そのままの値が送信されます（大きな値ほどメモリを多く使用します）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네이티브 /api/chat 요청에 대한 Ollama 컨텍스트 윈도우 크기(num_ctx)\nOllama는 모델과 관계없이 num_ctx 기본값을 작은 값(약 4096)으로 설정하여 긴 프롬프트를 아무 경고 없이 잘라냅니다. 0이면 요청마다 크기를 자동으로 정하며, 모델의 컨텍스트 윈도우를 넘지 않습니다. 양수 값을 지정하면 자동 크기 대신 그 값을 그대로 전송합니다(값이 클수록 메모리를 더 많이 사용합니다)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Størrelse på Ollamas kontekstvindu (num_ctx) for native /api/chat-forespørsler.\nOllama setter num_ctx til en liten verdi (rundt 4096) uansett modell, og kutter dermed stille lange prompter. 0 betyr at størrelsen settes automatisk per forespørsel, begrenset til modellens kontekstvindu. En positiv verdi overstyrer dette og sendes uendret (større verdier bruker mer minne)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grootte van het contextvenster van Ollama (num_ctx) voor native /api/chat-verzoeken.\nOllama zet num_ctx standaard op een kleine waarde (ongeveer 4096), ongeacht het model, waardoor lange prompts stilzwijgend worden afgekapt. 0 betekent dat de grootte automatisch per verzoek wordt bepaald, begrensd door het contextvenster van het model. Een positieve waarde overschrijft dat en wordt ongewijzigd verstuurd (grotere waarden gebruiken meer geheugen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmiar okna kontekstu Ollama (num_ctx) dla natywnych żądań /api/chat.\nOllama domyślnie ustawia num_ctx na małą wartość (około 4096) niezależnie od modelu, po cichu obcinając długie prompty. 0 oznacza automatyczne dobranie rozmiaru dla każdego żądania, ograniczone do okna kontekstu modelu. Wartość dodatnia zastępuje to i jest wysyłana bez zmian (większe wartości zużywają więcej pamięci)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho da janela de contexto do Ollama (num_ctx) para requisições nativas de /api/chat.\nO Ollama define num_ctx para um valor pequeno por padrão (cerca de 4096), independentemente do modelo, truncando silenciosamente prompts longos. 0 significa dimensionar automaticamente a cada requisição, limitado à janela de contexto do modelo. Um valor positivo substitui isso e é enviado literalmente (valores maiores usam mais memória)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер контекстного окна Ollama (num_ctx) для встроенных запросов /api/chat.\nПо умолчанию Ollama устанавливает num_ctx в небольшое значение (около 4096) независимо от модели, что приводит к незаметному обрезанию длинных запросов. 0 означает автоматический расчёт размера для каждого запроса с ограничением по контекстному окну модели. Положительное значение переопределяет это и передаётся без изменений (большие значения используют больше памяти)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veľkosť kontextového okna Ollama (num_ctx) pre natívne požiadavky /api/chat.\nOllama nastavuje num_ctx bez ohľadu na model na malú hodnotu (okolo 4096), čím ticho skracuje dlhé prompty. Hodnota 0 znamená automatickú veľkosť pre každú požiadavku, ohraničenú kontextovým oknom modelu. Kladná hodnota to prepíše a odošle sa bez zmeny (vyššie hodnoty používajú viac pamäte)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost kontekstnega okna Ollama (num_ctx) za izvorne zahteve /api/chat.\nOllama privzeto nastavi num_ctx na majhno vrednost (okoli 4096) ne glede na model, kar tiho skrajša dolge pozive. 0 pomeni samodejno velikost za vsako zahtevo, omejeno na kontekstno okno modela. Pozitivna vrednost to preglasi in se pošlje dobesedno (večje vrednosti porabijo več pomnilnika)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storlek på Ollamas kontextfönster (num_ctx) för inbyggda /api/chat-förfrågningar.\nOllama sätter num_ctx till ett litet värde (cirka 4096) oavsett modell, vilket i tysthet trunkerar långa promptar. 0 betyder att storleken väljs automatiskt per förfrågan, begränsad till modellens kontextfönster. Ett positivt värde åsidosätter det och skickas oförändrat (större värden använder mer minne)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel /api/chat istekleri için Ollama bağlam penceresi boyutu (num_ctx).\nOllama, modelden bağımsız olarak num_ctx değerini küçük bir değere (yaklaşık 4096) ayarlar ve uzun istemleri sessizce keser. 0, her istek için boyutu otomatik belirleme anlamına gelir; modelin bağlam penceresiyle sınırlanır. Pozitif bir değer bunu geçersiz kılar ve olduğu gibi gönderilir (daha büyük değerler daha fazla bellek kullanır)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích thước cửa sổ ngữ cảnh Ollama (num_ctx) cho các yêu cầu /api/chat gốc.\nOllama đặt num_ctx mặc định ở giá trị nhỏ (khoảng 4096) bất kể mô hình, âm thầm cắt bớt các lời nhắc dài. 0 nghĩa là tự động định cỡ theo từng yêu cầu, tối đa bằng cửa sổ ngữ cảnh của mô hình. Giá trị dương sẽ ghi đè và được gửi nguyên văn (giá trị lớn hơn dùng nhiều bộ nhớ hơn)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于原生 /api/chat 请求的 Ollama 上下文窗口大小（num_ctx）。\n无论使用何种模型，Ollama 默认将 num_ctx 设为一个较小的值（约 4096），这会悄悄截断较长的提示词。0 表示按请求自动确定大小，并以模型的上下文窗口为上限。正数会覆盖该行为，并按原样发送（数值越大占用的内存越多）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生 /api/chat 請求的 Ollama 上下文視窗大小（num_ctx）。\n無論使用哪個模型，Ollama 都會將 num_ctx 預設為較小的值（約 4096），而悄悄截斷較長的提示詞。0 表示依每個請求自動決定大小，上限為模型的上下文視窗。正數會覆寫此行為並原樣傳送（較大的值會使用較多記憶體）。"
          }
        }
      }
    },
    "AdvancedSetting.onePasswordAccount" : {
      "comment" : "Advanced setting: onePasswordAccount",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název účtu 1Password.\nPoužívá se, pokud jste ve správci hesel zapnuli integraci s 1Password. Seznam účtů získáte příkazem `op account list`. Může to být zkratka účtu, přihlašovací adresa, ID účtu nebo ID uživatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontonavn til 1Password.\nBruges, hvis du har slået 1Password-integrationen til i adgangskodeadministratoren. Brug `op account list` for at hente listen over konti. Det kan være en kontogenvej, en loginadresse, et konto-ID eller et bruger-ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password-Kontoname.\nDies wird verwendet, wenn Sie die 1Password-Integration im Passwort-Manager aktiviert haben. Verwenden Sie `op account list`, um die Liste der Konten abzurufen. Dies kann ein Kontokürzel, eine Anmeldeadresse, eine Konto-ID oder eine Benutzer-ID sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "1Password account name.\nThis is used if you’ve enabled the 1Password integration in the password manager. Use `op account list` to get the list of accounts. This can be an account shorthand, sign-in address, account ID, or user ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de la cuenta de 1Password.\nSe usa si has activado la integración con 1Password en el gestor de contraseñas. Usa `op account list` para obtener la lista de cuentas. Puede ser un alias de cuenta, una dirección de inicio de sesión, un ID de cuenta o un ID de usuario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password-tilin nimi.\nTätä käytetään, jos olet ottanut 1Password-integraation käyttöön salasanojen hallinnassa. Hae tililuettelo komennolla `op account list`. Arvo voi olla tilin lyhenne, kirjautumisosoite, tilin tunnus tai käyttäjätunnus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom du compte 1Password.\nUtilisé si vous avez activé l’intégration de 1Password dans le gestionnaire de mots de passe. Utilisez `op account list` pour obtenir la liste des comptes. Il peut s’agir d’un raccourci de compte, d’une adresse de connexion, d’un ID de compte ou d’un ID d’utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome dell’account 1Password.\nViene usato se hai abilitato l’integrazione con 1Password nel gestore password. Usa `op account list` per ottenere l’elenco degli account. Può essere un’abbreviazione dell’account, un indirizzo di accesso, un ID account o un ID utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Passwordのアカウント名。\nこれはパスワードマネージャーで1Password統合を有効にしている場合に使用されます。アカウントの一覧を取得するには`op account list`を使用してください。アカウントの短縮名、サインインアドレス、アカウントID、ユーザーIDのいずれかを指定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password 계정 이름.\n암호 관리자에서 1Password 통합을 켠 경우에 사용됩니다. 계정 목록을 확인하려면 `op account list`를 사용하십시오. 계정 약칭, 로그인 주소, 계정 ID 또는 사용자 ID를 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navn på 1Password-konto.\nBrukes hvis du har aktivert 1Password-integreringen i passordbehandleren. Bruk `op account list` for å hente listen over kontoer. Dette kan være en kontoalias, påloggingsadresse, konto-ID eller bruker-ID."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naam van het 1Password-account.\nDit wordt gebruikt als je de 1Password-integratie in de wachtwoordbeheerder hebt ingeschakeld. Gebruik `op account list` om de lijst met accounts op te vragen. Dit kan een accountafkorting, inlogadres, account-ID of gebruikers-ID zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa konta 1Password.\nUżywane, jeśli włączono integrację z 1Password w menedżerze haseł. Użyj `op account list`, aby uzyskać listę kont. Może to być skrót konta, adres logowania, identyfikator konta lub identyfikator użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome da conta do 1Password.\nIsto é usado se você ativou a integração do 1Password no cofre de senhas. Use `op account list` para obter a lista de contas. Pode ser uma abreviação de conta, endereço de login, ID da conta ou ID do usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя учётной записи 1Password.\nИспользуется, если в диспетчере паролей включена интеграция с 1Password. Чтобы получить список учётных записей, используйте `op account list`. Это может быть краткое имя учётной записи, адрес для входа, идентификатор учётной записи или идентификатор пользователя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názov účtu 1Password.\nPoužije sa, ak ste v správcovi hesiel zapli integráciu s 1Password. Zoznam účtov získate príkazom `op account list`. Môže to byť skrátený názov účtu, prihlasovacia adresa, ID účtu alebo ID užívateľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ime računa 1Password.\nUporablja se, če ste v upravitelju gesel omogočili integracijo 1Password. Seznam računov dobite z `op account list`. To je lahko okrajšava računa, naslov za prijavo, ID računa ali ID uporabnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontonamn för 1Password.\nDet används om du har aktiverat 1Password-integreringen i lösenordshanteraren. Använd `op account list` för att få listan över konton. Det kan vara en kontogenväg, inloggningsadress, konto-ID eller användar-ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password hesap adı.\nParola yöneticisinde 1Password entegrasyonunu etkinleştirdiyseniz kullanılır. Hesap listesini almak için `op account list` kullanın. Bu bir hesap kısaltması, oturum açma adresi, hesap kimliği veya kullanıcı kimliği olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên tài khoản 1Password.\nĐược dùng nếu bạn đã bật tích hợp 1Password trong trình quản lý mật khẩu. Dùng `op account list` để lấy danh sách tài khoản. Có thể là tên viết tắt tài khoản, địa chỉ đăng nhập, ID tài khoản hoặc ID người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password账户名称。  \n如果已在密码管理器中启用1Password集成，可使用`op account list`获取账户列表。这可以是账户简写、登录地址、账户ID或用户ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password 帳號名稱。\n如果你在密碼管理器中啟用了 1Password 整合，就會使用此設定。使用 `op account list` 取得帳號清單。這可以是帳號簡稱、登入位址、帳號 ID 或使用者 ID。"
          }
        }
      }
    },
    "AdvancedSetting.openFileInNewWindows" : {
      "comment" : "Advanced setting: openFileInNewWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZASTARALÉ: Použijte místo toho „Jak se mají otevírat nové instance“.\nOtevírat soubory v nových oknech, ne v nových panelech nebo rozdělených podoknech.\nTýká se to například shellových skriptů otevřených z Finderu. Viz také „Otevírat soubory v rozdělených podoknech“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDFASET: Brug i stedet “Hvordan skal nye instanser åbnes”.\nÅbn arkiver i nye vinduer, ikke nye faner eller opdelte ruder.\nDette påvirker f.eks. shell-instrukser, der åbnes fra Finder. Se også “Åbn arkiver i opdelte ruder”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VERALTET: Verwenden Sie stattdessen „Wie sollen neue Instanzen geöffnet werden“.\nDateien in neuen Fenstern öffnen, nicht in neuen Tabs oder Split-Bereichen.\nDies betrifft zum Beispiel Shell-Skripte, die vom Finder aus geöffnet werden. Siehe auch „Dateien in Split-Bereichen öffnen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DEPRECATED: Use “How should new instances be opened” instead.\nOpen files in new windows, not new tabs or split panes.\nThis affects shell scripts opened from Finder, for example. See also “Open files in split panes”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: usa en su lugar “¿Cómo deben abrirse las nuevas instancias?”.\nAbre los archivos en ventanas nuevas, no en pestañas nuevas ni paneles divididos.\nAfecta, por ejemplo, a los scripts de shell abiertos desde Finder. Consulta también “Abrir archivos en paneles divididos”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VANHENTUNUT: Käytä sen sijaan asetusta ”Miten uudet instanssit tulee avata”.\nAvaa tiedostot uusissa ikkunoissa, ei uusissa välilehdissä tai jaetuissa paneeleissa.\nTämä vaikuttaa esimerkiksi Finderista avattuihin komentotulkkiskripteihin. Katso myös ”Avaa tiedostot jaetuissa paneeleissa”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLÈTE : utilisez plutôt « Comment ouvrir les nouvelles instances ».\nOuvrir les fichiers dans de nouvelles fenêtres, et non de nouveaux onglets ou volets scindés.\nCela concerne par exemple les scripts shell ouverts depuis le Finder. Voir aussi « Ouvrir les fichiers dans des volets scindés »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: usa invece “Come devono essere aperte le nuove istanze”.\nApri i file in nuove finestre, non in nuovi pannelli o riquadri divisi.\nInfluisce, ad esempio, sugli script di shell aperti dal Finder. Vedi anche “Apri i file in riquadri divisi”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非推奨：代わりに「新しいインスタンスをどのように開くか」を使用してください。\n新しいタブや分割ペインではなく、新しいウィンドウでファイルを開く。\nこれはFinderから開かれたシェルスクリプトなどに影響します。「分割ペインでファイルを開く」も参照してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 사용되지 않음: 대신 “새로운 인스턴스를 여는 방법”을 사용하십시오.\n파일을 새로운 탭이나 분할 패널이 아닌 새로운 윈도우에서 엽니다.\n예를 들어 Finder에서 연 셸 스크립트에 적용됩니다. “분할 패널에서 파일 열기”도 참고하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTGÅTT: Bruk «Hvordan skal nye instanser åpnes» i stedet.\nÅpne filer i nye vinduer, ikke nye faner eller delte ruter.\nDette påvirker f.eks. skallskript som åpnes fra Finder. Se også «Åpne filer i delte ruter»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VEROUDERD: gebruik in plaats daarvan ‘Hoe moeten nieuwe instanties worden geopend’.\nOpen bestanden in nieuwe vensters, niet in nieuwe tabbladen of gesplitste panelen.\nDit geldt bijvoorbeeld voor shellscripts die vanuit Finder worden geopend. Zie ook ‘Open bestanden in gesplitste panelen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRZESTARZAŁE: zamiast tego użyj „Jak mają być otwierane nowe wystąpienia”.\nOtwieraj pliki w nowych oknach, a nie w nowych kartach ani panelach podzielonych.\nDotyczy to na przykład skryptów powłoki otwieranych z Findera. Zobacz też „Otwieraj pliki w panelach podzielonych”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: Use “Como as novas instâncias devem ser abertas” em vez disso.\nAbrir arquivos em novas janelas, não em novas abas ou painéis divididos.\nIsto afeta scripts de shell abertos a partir do Finder, por exemplo. Consulte também “Abrir arquivos em painéis divididos”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "УСТАРЕЛО: используйте вместо этого «Как открывать новые экземпляры».\nОткрывать файлы в новых окнах, а не в новых вкладках или разделённых панелях.\nЭто, например, влияет на сценарии оболочки, открываемые из Finder. См. также «Открывать файлы в разделённых панелях»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZASTARANÉ: Použite namiesto toho „Ako sa majú otvárať nové inštancie spustené skriptmi alebo externými aplikáciami“.\nOtvárať súbory v nových oknách, nie v nových taboch ani rozdelených paneloch.\nTýka sa to napríklad shellových skriptov otvorených z Findera. Pozrite si aj „Otvárať súbory v rozdelených paneloch“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZASTARELO: namesto tega uporabite »Kako naj se odprejo novi primerki«.\nOdpiraj datoteke v novih oknih, ne v novih zavihkih ali razdeljenih podoknih.\nTo vpliva na primer na skripte lupine, odprte iz aplikacije Finder. Glejte tudi »Odpiraj datoteke v razdeljenih podoknih«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FÖRÅLDRAT: Använd ”Hur ska nya instanser öppnas” i stället.\nÖppna filer i nya fönster, inte nya flikar eller delade paneler.\nDet påverkar t.ex. skalskript som öppnas från Finder. Se även ”Öppna filer i delade paneler”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KULLANIMDAN KALKTI: Bunun yerine “Yeni örnekler nasıl açılsın” seçeneğini kullanın.\nDosyaları yeni sekmelerde veya bölmelerde değil, yeni pencerelerde aç.\nBu, örneğin Finder’dan açılan kabuk betiklerini etkiler. Ayrıca bkz. “Dosyaları bölmelerde aç”."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ĐÃ LỖI THỜI: Hãy dùng “Các phiên bản mới nên được mở như thế nào” thay thế.\nMở tệp trong cửa sổ mới, không phải tab mới hay khung chia.\nĐiều này ảnh hưởng đến các tập lệnh shell được mở từ Finder, chẳng hạn. Xem thêm “Mở tệp trong khung chia”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已废弃：应使用“新实例应如何打开”替代。  \n在新窗口中打开文件，而非新标签页或分屏窗格。  \n这影响从Finder打开的shell脚本，参见“在分屏窗格中打开文件”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已淘汰：請改用「應如何打開新的實例」。\n在新視窗中打開檔案，而不是新標籤頁或分割窗格。\n例如，這會影響從 Finder 打開的 shell 腳本。另請參閱「在分割窗格中打開檔案」。"
          }
        }
      }
    },
    "AdvancedSetting.openFileInSplitPanes" : {
      "comment" : "Advanced setting: openFileInSplitPanes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZASTARALÉ: Použijte místo toho „Jak se mají otevírat nové instance“.\nOtevírat soubory v rozdělených podoknech.\nTýká se to například shellových skriptů otevřených z Finderu. Aby se to projevilo, musíte u „Otevírat soubory v nových oknech, ne v nových panelech“ nastavit „Ne“. Viz také „Má se při otevření souboru v rozděleném podokně rozdělit svisle?“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UDFASET: Brug i stedet “Hvordan skal nye instanser åbnes”.\nÅbn arkiver i opdelte ruder.\nDette påvirker f.eks. shell-instrukser, der åbnes fra Finder. Du skal sætte “Åbn arkiver i nye vinduer, ikke nye faner” til “Nej”, for at det træder i kraft. Se også “Skal en opdeling være lodret, når et arkiv åbnes i en opdelt rude?”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VERALTET: Verwenden Sie stattdessen „Wie sollen neue Instanzen geöffnet werden“.\nDateien in Split-Bereichen öffnen.\nDies betrifft zum Beispiel Shell-Skripte, die vom Finder aus geöffnet werden. Sie müssen „Dateien in neuen Fenstern öffnen, nicht in neuen Tabs“ auf „Nein“ setzen, damit dies wirksam wird. Siehe auch „Soll beim Öffnen einer Datei in einem Split-Bereich vertikal geteilt werden?“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DEPRECATED: Use “How should new instances be opened” instead.\nOpen files in split panes.\nThis affects shell scripts opened from Finder, for example. You must set “Open files in new windows, not new tabs” to “No” for this to take effect. See also “When opening a file in a split pane, should it be a vertical split?”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: usa en su lugar “¿Cómo deben abrirse las nuevas instancias?”.\nAbre los archivos en paneles divididos.\nAfecta, por ejemplo, a los scripts de shell abiertos desde Finder. Debes establecer “Abrir archivos en ventanas nuevas, no en pestañas nuevas” en “No” para que surta efecto. Consulta también “Al abrir un archivo en un panel dividido, ¿debe ser una división vertical?”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VANHENTUNUT: Käytä sen sijaan asetusta ”Miten uudet instanssit tulee avata”.\nAvaa tiedostot jaetuissa paneeleissa.\nTämä vaikuttaa esimerkiksi Finderista avattuihin komentotulkkiskripteihin. Aseta ”Avaa tiedostot uusissa ikkunoissa, ei uusissa välilehdissä” arvoon ”Ei”, jotta tämä tulee voimaan. Katso myös ”Kun tiedosto avataan jaetussa paneelissa, onko jako pystysuuntainen?”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLÈTE : utilisez plutôt « Comment ouvrir les nouvelles instances ».\nOuvrir les fichiers dans des volets scindés.\nCela concerne par exemple les scripts shell ouverts depuis le Finder. Vous devez définir « Ouvrir les fichiers dans de nouvelles fenêtres, et non de nouveaux onglets » sur « Non » pour que cela prenne effet. Voir aussi « Lors de l’ouverture d’un fichier dans un volet scindé, la scission doit-elle être verticale ? »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: usa invece “Come devono essere aperte le nuove istanze”.\nApri i file in riquadri divisi.\nInfluisce, ad esempio, sugli script di shell aperti dal Finder. Per renderla efficace, devi impostare “Apri i file in nuove finestre, non in nuovi pannelli” su “No”. Vedi anche “Quando si apre un file in un riquadro diviso, la divisione deve essere verticale?”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非推奨：代わりに「新しいインスタンスをどのように開くか」を使用してください。\n分割ペインでファイルを開く。\nこれはFinderから開かれたシェルスクリプトなどに影響します。これを有効にするには「新しいタブではなく新しいウィンドウでファイルを開く」を「いいえ」に設定する必要があります。「分割ペインでファイルを開く際、垂直分割にするか」も参照してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 사용되지 않음: 대신 “새로운 인스턴스를 어떻게 열겠습니까”를 사용하십시오.\n분할 패널에서 파일을 엽니다.\n예를 들어 Finder에서 연 셸 스크립트에 적용됩니다. 이 설정이 적용되려면 “새로운 탭이 아닌 새로운 윈도우에서 파일 열기”를 “아니요”로 설정해야 합니다. “분할 패널에서 파일을 열 때 세로로 분할하겠습니까?”도 참고하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTGÅTT: Bruk «Hvordan skal nye instanser åpnes» i stedet.\nÅpne filer i delte ruter.\nDette påvirker f.eks. skallskript som åpnes fra Finder. Du må sette «Åpne filer i nye vinduer, ikke nye faner» til «Nei» for at dette skal tre i kraft. Se også «Skal en fil som åpnes i en delt rute åpnes i en vertikal deling?»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VEROUDERD: gebruik in plaats daarvan ‘Hoe moeten nieuwe instanties worden geopend’.\nOpen bestanden in gesplitste panelen.\nDit geldt bijvoorbeeld voor shellscripts die vanuit Finder worden geopend. Je moet ‘Open bestanden in nieuwe vensters, niet in nieuwe tabbladen’ op ‘Nee’ zetten om dit te laten werken. Zie ook ‘Moet een bestand dat in een gesplitst paneel wordt geopend verticaal worden gesplitst?’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRZESTARZAŁE: zamiast tego użyj „Jak mają być otwierane nowe wystąpienia”.\nOtwieraj pliki w panelach podzielonych.\nDotyczy to na przykład skryptów powłoki otwieranych z Findera. Aby to działało, ustaw „Otwieraj pliki w nowych oknach, a nie w nowych kartach” na „Nie”. Zobacz też „Czy przy otwieraniu pliku w panelu podzielonym ma to być podział pionowy?”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OBSOLETO: Use “Como as novas instâncias devem ser abertas” em vez disso.\nAbrir arquivos em painéis divididos.\nIsto afeta scripts de shell abertos a partir do Finder, por exemplo. Você precisa definir “Abrir arquivos em novas janelas, não em novas abas” como “Não” para que isto tenha efeito. Consulte também “Ao abrir um arquivo em um painel dividido, ele deve ser uma divisão vertical?”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "УСТАРЕЛО: используйте вместо этого «Как открывать новые экземпляры».\nОткрывать файлы в разделённых панелях.\nЭто, например, влияет на сценарии оболочки, открываемые из Finder. Чтобы это работало, параметр «Открывать файлы в новых окнах, а не в новых вкладках» должен быть выключен. См. также «При открытии файла в разделённой панели, должно ли разделение быть вертикальным?»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZASTARANÉ: Použite namiesto toho „Ako sa majú otvárať nové inštancie spustené skriptmi alebo externými aplikáciami“.\nOtvárať súbory v rozdelených paneloch.\nTýka sa to napríklad shellových skriptov otvorených z Findera. Aby sa to prejavilo, musíte nastaviť „Otvárať súbory v nových oknách, nie v nových taboch“ na „Nie“. Pozrite si aj „Má sa pri otvorení súboru v rozdelenom paneli použiť zvislé rozdelenie?“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZASTARELO: namesto tega uporabite »Kako naj se odprejo novi primerki«.\nOdpiraj datoteke v razdeljenih podoknih.\nTo vpliva na primer na skripte lupine, odprte iz aplikacije Finder. Da bo to delovalo, morate nastavitev »Odpiraj datoteke v novih oknih, ne v novih zavihkih« nastaviti na »Ne«. Glejte tudi »Ali naj bo pri odpiranju datoteke v razdeljenem podoknu razdelitev navpična?«"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FÖRÅLDRAT: Använd ”Hur ska nya instanser öppnas” i stället.\nÖppna filer i delade paneler.\nDet påverkar t.ex. skalskript som öppnas från Finder. Du måste ställa in ”Öppna filer i nya fönster, inte nya flikar” på ”Nej” för att det ska gälla. Se även ”Ska en fil som öppnas i en delad panel öppnas i en vertikal delning?”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KULLANIMDAN KALKTI: Bunun yerine “Yeni örnekler nasıl açılsın” seçeneğini kullanın.\nDosyaları bölmelerde aç.\nBu, örneğin Finder’dan açılan kabuk betiklerini etkiler. Bunun etkili olması için “Dosyaları yeni sekmelerde veya bölmelerde değil, yeni pencerelerde aç” ayarını “Hayır” yapmalısınız. Ayrıca bkz. “Bir dosya bölmede açılırken dikey bölme mi olsun?”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ĐÃ LỖI THỜI: Hãy dùng “Các phiên bản mới nên được mở như thế nào” thay thế.\nMở tệp trong khung chia.\nĐiều này ảnh hưởng đến các tập lệnh shell được mở từ Finder, chẳng hạn. Bạn phải đặt “Mở tệp trong cửa sổ mới, không phải tab mới” thành “Không” để cài đặt này có hiệu lực. Xem thêm “Khi mở tệp trong khung chia, có nên chia theo chiều dọc không?”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已废弃：应使用“新实例应如何打开”替代。  \n在分屏窗格中打开文件。  \n这影响从Finder打开的shell脚本，例如。必须将“在新窗口中打开文件，而非新标签页”设置为“否”才能生效。另见“在分屏窗格中打开文件时应为垂直分屏吗？”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已淘汰：請改用「應如何打開新的實例」。\n在分割窗格中打開檔案。\n例如，這會影響從 Finder 打開的 shell 腳本。必須將「在新視窗中打開檔案，而不是新標籤頁」設為「否」才會生效。另請參閱「在分割窗格中打開檔案時，是否應為垂直分割？」"
          }
        }
      }
    },
