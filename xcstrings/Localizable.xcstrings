    "BackupUpdate.Message" : {
      "comment" : "Alert shown when the developer has flagged this version's automatic updates as broken; the placeholders are the available version and the installed version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ ist verfügbar, aber automatische Updates funktionieren in dieser Version (%2$@) möglicherweise nicht. Sie können die neue Version von iterm2.com laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 %1$@ is available, but automatic updates may not be working in this version (%2$@). You can download the new version from iterm2.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está disponible iTerm2 %1$@, pero es posible que las actualizaciones automáticas no funcionen en esta versión (%2$@). Puedes descargar la nueva versión desde iterm2.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ est disponible, mais les mises à jour automatiques peuvent ne pas fonctionner dans cette version (%2$@). Vous pouvez télécharger la nouvelle version sur iterm2.com."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ è disponibile, ma gli aggiornamenti automatici potrebbero non funzionare in questa versione (%2$@). Puoi scaricare la nuova versione da iterm2.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ が利用可能ですが、このバージョン (%2$@) では自動アップデートが機能していない可能性があります。新しいバージョンは iterm2.com からダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@을(를) 사용할 수 있지만, 이 버전(%2$@)에서는 자동 업데이트가 작동하지 않을 수 있습니다. iterm2.com에서 새 버전을 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 %1$@ está disponível, mas as atualizações automáticas podem não estar funcionando nesta versão (%2$@). Você pode baixar a nova versão em iterm2.com."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступна версия iTerm2 %1$@, но автоматическое обновление в этой версии (%2$@) может не работать. Новую версию можно загрузить с iterm2.com."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ kullanılabilir, ancak otomatik güncellemeler bu sürümde (%2$@) çalışmıyor olabilir. Yeni sürümü iterm2.com adresinden indirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ 已可用，但此版本 (%2$@) 的自动更新可能无法正常工作。您可以从 iterm2.com 下载新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 %1$@ 已推出，但此版本（%2$@）的自動更新可能無法正常運作。你可以從 iterm2.com 下載新版本。"
          }
        }
      }
    },
