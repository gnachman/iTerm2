        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger tekstbiter i Avansert innliming ved å holde nede ⌥-tasten, eller åpne dem i kommandoskriveren med ⇧."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig fragmenten in Geavanceerd plakken door de ⌥-toets ingedrukt te houden, of open ze in de opsteller met ⇧."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytuj fragmenty kodu w Zaawansowanym wklejaniu, przytrzymując klawisz ⌥, lub otwórz je w edytorze poleceń z ⇧."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite fragmentos no Advanced Paste mantendo pressionada a tecla ⌥, ou abra-os no compositor com ⇧."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактируйте сниппеты в расширенной вставке, удерживая клавишу ⌥, или открывайте их в Композере с помощью ⇧."
