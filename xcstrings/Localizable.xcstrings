    "LocalePrompt.Message" : {
      "comment" : "Explanation shown when no valid UNIX locale exists for the user’s language and country",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro aktuální jazyk a zemi vašeho počítače neexistuje platné národní prostředí UNIX. Aplikace příkazového řádku se proto mohou chovat nesprávně. Vyberte prosím jedno z níže uvedeného seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes ingen gyldig UNIX-landestandard for computerens nuværende sprog og land. Det kan få kommandolinjeprogrammer til at opføre sig forkert. Vælg en fra listen nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die aktuelle Sprache und das Land Ihres Computers existiert kein gültiges UNIX-Gebietsschema. Dies kann dazu führen, dass Kommandozeilen-Apps sich fehlerhaft verhalten. Bitte wählen Sie eines aus der folgenden Liste aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No valid UNIX locale exists for your computer’s current language and country. This may cause command-line apps to misbehave. Please select one from the list below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No existe ninguna configuración regional UNIX válida para el idioma y el país actuales de tu Mac. Esto puede hacer que las apps de línea de comandos se comporten mal. Selecciona uno de la lista siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietokoneesi nykyiselle kielelle ja maalle ei ole voimassa olevaa UNIX-alueasetusta. Tämä voi aiheuttaa komentorivisovellusten virheellistä toimintaa. Valitse alueasetus alla olevasta luettelosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe aucun paramètre régional UNIX valide pour la langue et le pays actuels de votre ordinateur. Cela peut perturber le fonctionnement des apps en ligne de commande. Veuillez en choisir un dans la liste ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esistono impostazioni locali UNIX valide per la lingua e il paese attuali del computer. Questo potrebbe causare malfunzionamenti nelle app da riga di comando. Selezionane una dall’elenco qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのコンピュータの現在の言語と国に対応する有効なUNIXロケールが存在しません。これによりコマンドラインアプリが正しく動作しないことがあります。以下のリストから1つ選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 현재 언어 및 국가에 해당하는 유효한 UNIX 로케일이 없습니다. 이로 인해 명령줄 앱이 오작동할 수 있습니다. 아래 목록에서 하나를 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ingen gyldig UNIX-språkinnstilling for datamaskinens gjeldende språk og land. Det kan føre til at kommandolinjeprogrammer oppfører seg feil. Velg en fra listen nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat geen geldige UNIX-taalversie voor de huidige taal en het huidige land van je computer. Hierdoor kunnen opdrachtregel-apps zich vreemd gedragen. Kies er een uit de onderstaande lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla bieżącego języka i kraju twojego komputera nie istnieją prawidłowe ustawienia regionalne UNIX. Aplikacje wiersza poleceń mogą przez to działać nieprawidłowo. Wybierz jedno z poniższej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe nenhum locale UNIX válido para o idioma e o país atuais do seu computador. Isso pode fazer com que apps de linha de comando se comportem mal. Selecione um na lista abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для текущего языка и страны вашего компьютера не существует допустимой локали UNIX. Это может привести к некорректной работе приложений командной строки. Выберите локаль из списка ниже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre aktuálny jazyk a krajinu vášho počítača neexistujú platné miestne nastavenia UNIX. To môže spôsobiť nesprávne správanie aplikácií príkazového riadka. Vyberte jedny zo zoznamu nižšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za trenutni jezik in državo vašega računalnika ne obstaja veljavna območna nastavitev UNIX. To lahko povzroči napačno delovanje aplikacij ukazne vrstice. Izberite eno s spodnjega seznama."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen giltig UNIX-språkinställning för datorns aktuella språk och land. Det kan göra att kommandoradsprogram beter sig fel. Välj en i listan nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızın geçerli dili ve ülkesi için geçerli bir UNIX yerel ayarı yok. Bu, komut satırı uygulamalarının hatalı çalışmasına neden olabilir. Lütfen aşağıdaki listeden birini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có thiết lập vùng UNIX hợp lệ cho ngôn ngữ và quốc gia hiện tại của máy tính bạn. Điều này có thể khiến các ứng dụng dòng lệnh hoạt động sai. Vui lòng chọn một thiết lập từ danh sách bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的电脑当前语言和国家/地区不存在有效的 UNIX locale。这可能导致命令行应用行为异常。请从下方列表中选择一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你電腦目前的語言與國家或地區沒有有效的 UNIX 語系。這可能導致命令列 App 運作異常。請從下方列表選擇一個。"
          }
        }
      }
    },
