        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このNightly Buildは30日以上前のものです。ひどいバグに気づかないまま使っている可能性があるので、早めの更新を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 나이틀리 빌드는 30일이 넘었습니다. 곧 업데이트하는 것이 좋습니다. 모르는 사이에 심각한 버그를 겪고 있을 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão nightly tem mais de 30 dias. Considere atualizar em breve: você pode estar sofrendo com bugs terríveis sem saber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой ночной сборке больше 30 дней. Рекомендуем обновиться в ближайшее время: возможно, вы уже страдаете от ужасных ошибок, даже не подозревая об этом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
