    "BrowserToolbar.DevNullInfo" : {
      "comment" : "Markdown popover explaining /dev/null private browsing mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Režim /dev/null\n\nVaše aktivita při prohlížení se neukládá. Nebude uložena žádná historie, záložky ani jiná data.\n\nTento režim se nastavuje v profilu prohlížeče v části „Nastavení > Profily > Web > Soukromí“.\n\n## 🙈 🙉 🙊"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Tilstanden /dev/null\n\nDin browseraktivitet gemmes ikke. Ingen historik, bogmærker eller andre data bliver gemt.\n\nDenne tilstand indstilles i browserens profil under **Indstillinger > Profiler > Web > Anonymitet**.\n\n## 🙈 🙉 🙊"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null-Modus\n\nIhre Browsing-Aktivität wird nicht gespeichert. Es werden weder Verlauf noch Lesezeichen noch andere Daten gespeichert.\n\nDieser Modus wird im Profil des Browsers unter **Einstellungen > Profil > Web > Datenschutz** festgelegt.\n\n## 🙈 🙉 🙊"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "## /dev/null Mode\n\nYour browsing activity is not being saved. No history, bookmarks, or other data will be stored.\n\nThis mode is set in the browser’s Profile under **Settings > Profile > Web > Privacy**.\n\n## 🙈 🙉 🙊"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Modo /dev/null\n\nTu actividad de navegación no se está guardando. No se almacenará ningún historial, marcador ni otros datos.\n\nEste modo se define en el perfil del navegador, en **Ajustes > Perfil > Web > Privacidad**.\n\n## 🙈 🙉 🙊"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null-tila\n\nSelaustoimintaasi ei tallenneta. Historiaa, kirjanmerkkejä tai muita tietoja ei tallenneta.\n\nTämä tila määritetään selaimen profiilissa kohdassa **Asetukset > Profiilit > Verkko > Tietosuoja**.\n\n## 🙈 🙉 🙊"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Mode /dev/null\n\nVotre activité de navigation n’est pas enregistrée. Aucun historique, signet ni autre donnée ne sera stocké.\n\nCe mode se règle dans le profil du navigateur, sous **Réglages > Profil > Web > Confidentialité**.\n\n## 🙈 🙉 🙊"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Modalità /dev/null\n\nLa tua attività di navigazione non viene salvata. Non verranno memorizzati cronologia, segnalibri o altri dati.\n\nQuesta modalità si imposta nel profilo del browser in **Impostazioni > Profili > Web > Privacy**.\n\n## 🙈 🙉 🙊"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null モード\n\nこのセッションでの閲覧内容は保存されません。履歴、ブックマーク、その他のデータは記録されません。\n\nこのモードはブラウザのプロファイルの **設定 > プロファイル > Web > プライバシー** で設定します。\n\n## 🙈 🙉 🙊"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null 모드\n\n탐색 활동이 저장되지 않습니다. 방문 기록, 책갈피 또는 기타 데이터가 저장되지 않습니다.\n\n이 모드는 브라우저 프로파일의 **설정 > 프로파일 > 웹 > 개인 정보 보호**에서 설정합니다.\n\n## 🙈 🙉 🙊"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null-modus\n\nSurfeaktiviteten din lagres ikke. Ingen historikk, bokmerker eller andre data blir lagret.\n\nDenne modusen angis i nettleserens profil under «Innstillinger > Profiler > Web > Personvern».\n\n## 🙈 🙉 🙊"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null-modus\n\nJe browse-activiteit wordt niet bewaard. Er worden geen geschiedenis, bladwijzers of andere gegevens opgeslagen.\n\nDeze modus stel je in bij het profiel van de browser onder **Instellingen > Profielen > Web > Privacy**.\n\n## 🙈 🙉 🙊"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Tryb /dev/null\n\nTwoja aktywność w przeglądarce nie jest zapisywana. Nie będzie przechowywana historia, zakładki ani inne dane.\n\nTen tryb ustawia się w profilu przeglądarki w sekcji **Ustawienia > Profile > Web > Prywatność**.\n\n## 🙈 🙉 🙊"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Modo /dev/null\n\nSua atividade de navegação não está sendo salva. Nenhum histórico, favorito ou outro dado será armazenado.\n\nEste modo é definido no perfil do navegador em **Ajustes > Perfil > Web > Privacidade**.\n\n## 🙈 🙉 🙊"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Режим /dev/null\n\nВаша активность в браузере не сохраняется. История, закладки и другие данные не будут сохранены.\n\nЭтот режим задаётся в профиле браузера в разделе **Настройки > Профиль > Веб > Конфиденциальность**.\n\n## 🙈 🙉 🙊"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Režim /dev/null\n\nVaša aktivita pri prehliadaní sa neukladá. Neuloží sa žiadna história, záložky ani iné údaje.\n\nTento režim sa nastavuje v profile prehliadača v časti **Nastavenia > Profily > Web > Súkromie**.\n\n## 🙈 🙉 🙊"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Način /dev/null\n\nVaša dejavnost brskanja se ne shranjuje. Zgodovina, zaznamki in drugi podatki ne bodo shranjeni.\n\nTa način se nastavi v profilu brskalnika v **Nastavitve > Profil > Splet > Zasebnost**.\n\n## 🙈 🙉 🙊"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null-läge\n\nDin webbaktivitet sparas inte. Ingen historik, inga bokmärken och inga andra data lagras.\n\nDet här läget anges i webbläsarens profil under **Inställningar > Profiler > Webb > Integritet**.\n\n## 🙈 🙉 🙊"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null Modu\n\nGezinti etkinliğiniz kaydedilmiyor. Geçmiş, yer işareti veya başka veri saklanmaz.\n\nBu mod, tarayıcının profilinde **Ayarlar > Profiller > Web > Gizlilik** altında belirlenir.\n\n## 🙈 🙉 🙊"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Chế độ /dev/null\n\nHoạt động duyệt web của bạn không được lưu. Không có lịch sử, dấu trang hay dữ liệu nào khác được lưu trữ.\n\nChế độ này được đặt trong hồ sơ của trình duyệt tại **Cài đặt > Hồ sơ > Web > Quyền riêng tư**.\n\n## 🙈 🙉 🙊"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null 模式\n\n您的浏览活动不会被保存。没有历史记录、书签或其他数据会被存储。\n\n此模式在浏览器的配置文件中的**设置 > 配置文件 > Web > 隐私**选项中设置。\n\n## 🙈 🙉 🙊"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## /dev/null 模式\n\n你的瀏覽活動不會被儲存。不會儲存任何歷史記錄、書籤或其他資料。\n\n此模式在瀏覽器的描述檔中設定，位於 **設定 > 描述檔 > Web > 隱私權**。\n\n## 🙈 🙉 🙊"
          }
        }
      }
    },
