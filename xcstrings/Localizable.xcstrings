    "Companion.ChooseMode.Body" : {
      "comment" : "Explanatory paragraph on the choose-mode screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete spárovat svůj iPhone, abyste mohli chatovat s AI o svých relacích, nebo jen pro vzdálené zobrazování a ovládání svých terminálů. AI můžete později zapnout, pokud si to rozmyslíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan sammenkoble din iPhone for at chatte med AI om dine sessioner, eller bare for at se og styre dine terminaler eksternt. Du kan slå AI til senere, hvis du ombestemmer dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihr iPhone koppeln, um mit einer KI über Ihre Sitzungen zu chatten, oder einfach nur, um Ihre Terminals aus der Ferne anzuzeigen und zu steuern. Sie können die KI später aktivieren, falls Sie Ihre Meinung ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can pair your iPhone to chat with AI about your sessions, or just to view and control your terminals remotely. You can turn on AI later if you change your mind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes emparejar tu iPhone para chatear con la IA sobre tus sesiones, o solo para ver y controlar tus terminales de forma remota. Puedes activar la IA más tarde si cambias de opinión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit yhdistää iPhonesi parilla keskustellaksesi AI:n kanssa istunnoistasi tai vain katsellaksesi ja ohjataksesi päätteitäsi etänä. Voit ottaa AI:n käyttöön myöhemmin, jos muutat mielesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez associer votre iPhone pour discuter avec l’IA de vos sessions, ou seulement pour voir et contrôler vos terminaux à distance. Vous pourrez activer l’IA plus tard si vous changez d’avis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi associare il tuo iPhone per chattare con l’IA sulle tue sessioni, oppure solo per vedere e controllare i tuoi terminali da remoto. Puoi attivare l’IA in seguito se cambi idea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneをペアリングして、セッションについてAIとチャットしたり、単に端末を遠隔で表示・操作したりできます。後で気が変わった場合は、AIを後から有効にすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 페어링하여 세션에 대해 AI와 채팅하거나, 터미널을 원격으로 보고 제어하기만 할 수도 있습니다. 마음이 바뀌면 나중에 AI를 켤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan pare iPhone for å chatte med KI om øktene dine, eller bare for å se og styre terminalene dine eksternt. Du kan slå på KI senere hvis du ombestemmer deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt je iPhone koppelen om met AI te chatten over je sessies, of alleen om je terminals op afstand te bekijken en te besturen. Je kunt AI later inschakelen als je van gedachten verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz sparować swój iPhone, aby rozmawiać z AI o swoich sesjach albo tylko po to, by zdalnie przeglądać terminale i sterować nimi. Jeśli zmienisz zdanie, AI możesz włączyć później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode emparelhar seu iPhone para conversar com a IA sobre suas sessões, ou apenas para visualizar e controlar seus terminais remotamente. Você pode ativar a IA mais tarde, se mudar de ideia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете подключить iPhone, чтобы общаться с ИИ о своих сессиях, или просто просматривать и удалённо управлять терминалами. Позже вы можете включить ИИ, если измените решение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svoj iPhone môžete spárovať na chatovanie s AI o vašich reláciách alebo len na vzdialené zobrazovanie a ovládanie terminálov. AI môžete zapnúť neskôr, ak si to rozmyslíte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svoj iPhone lahko seznanite za klepet z AI o vaših sejah ali samo za oddaljeni ogled in nadzor terminalov. AI lahko vklopite pozneje, če si premislite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan para ihop din iPhone för att chatta med AI om dina sessioner, eller bara för att visa och styra dina terminaler på distans. Du kan slå på AI senare om du ändrar dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzu eşleştirerek oturumlarınız hakkında YZ ile sohbet edebilir veya yalnızca terminallerinizi uzaktan görüntüleyip denetleyebilirsiniz. Fikrinizi değiştirirseniz YZ’yi daha sonra açabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể ghép nối iPhone để trò chuyện với AI về các phiên của bạn, hoặc chỉ để xem và điều khiển terminal từ xa. Bạn có thể bật AI sau nếu đổi ý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以将 iPhone 配对，以便与 AI 讨论您的会话，也可以仅用于远程查看和控制您的终端。如果之后改变想法，可以随时开启 AI 功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以配對 iPhone，以便與 AI 聊天討論你的工作階段，也可以只用於遠端檢視和控制你的終端機。如果之後改變心意，可以隨時開啟 AI。"
          }
        }
      }
    },
