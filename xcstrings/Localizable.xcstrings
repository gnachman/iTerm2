    "AdvancedSetting.simpleNotifications" : {
      "comment" : "Advanced setting: simpleNotifications",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechat z oznámení identifikátor relace.\nPokud je zapnuto, oznámení zobrazí jen zprávu bez předpony s názvem relace a číslem panelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelad sessionsidentifikatoren i notifikationer.\nNår det er slået til, viser notifikationer kun meddelelsen uden præfikset med sessionsnavn og fanenummer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungskennung aus Benachrichtigungen weglassen.\nWenn aktiviert, zeigen Benachrichtigungen nur die Nachricht ohne den Sitzungsnamen und das Tab-Nummer-Präfix an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Omit session identifier from notifications.\nWhen enabled, notifications will only show the message without the session name and tab number prefix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite el identificador de sesión en las notificaciones.\nCuando está activado, las notificaciones solo mostrarán el mensaje, sin el prefijo del nombre de sesión y el número de pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä istunnon tunniste pois ilmoituksista.\nKun käytössä, ilmoituksissa näkyy vain viesti ilman istunnon nimeä ja välilehden numeroa etuliitteenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omettre l’identifiant de session dans les notifications.\nSi activé, les notifications n’affichent que le message, sans le préfixe du nom de la session et du numéro d’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ometti l’identificatore della sessione dalle notifiche.\nSe attivo, le notifiche mostreranno solo il messaggio, senza il prefisso con nome della sessione e numero del pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知からセッション識別子を省略する。\n有効にすると、通知はセッション名とタブ番号の接頭辞を含まずメッセージのみを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림에서 세션 식별자 생략.\n활성화하면 알림에 세션 이름과 탭 번호 접두어 없이 메시지만 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelat øktidentifikator fra varsler.\nNår dette er aktivert, viser varsler bare meldingen uten prefikset med øktnavn og fanenummer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de sessie-ID weg uit meldingen.\nAls dit is ingeschakeld, tonen meldingen alleen het bericht, zonder het voorvoegsel met sessienaam en tabbladnummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomijaj identyfikator sesji w powiadomieniach.\nGdy włączone, powiadomienia będą pokazywać tylko komunikat, bez prefiksu z nazwą sesji i numerem karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitir o identificador da sessão nas notificações.\nQuando ativado, as notificações mostrarão apenas a mensagem, sem o prefixo com o nome da sessão e o número da aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не указывать идентификатор сеанса в уведомлениях.\nЕсли включено, в уведомлениях будет показано только сообщение, без имени сеанса и номера вкладки в начале."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechať z hlásení identifikátor relácie.\nKeď je zapnuté, hlásenia zobrazia iba správu bez predpony s názvom relácie a číslom tabu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izpusti identifikator seje iz obvestil.\nČe je omogočeno, obvestila prikažejo le sporočilo brez predpone z imenom seje in številko zavihka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelämna sessionsidentifierare från notiser.\nNär det är aktiverat visar notiser bara meddelandet utan prefixet med sessionsnamn och flikens nummer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimlerden oturum tanımlayıcısını çıkar.\nEtkinse bildirimler, oturum adı ve sekme numarası öneki olmadan yalnızca iletiyi gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ định danh phiên khỏi thông báo.\nKhi bật, thông báo chỉ hiển thị nội dung mà không có tiền tố tên phiên và số tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从通知中省略会话标识符。\n当启用时，通知将仅显示消息而不包含会话名称和标签页编号前缀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從通知中省略工作階段識別碼。\n啟用後，通知只會顯示訊息，而沒有工作階段名稱和標籤頁編號前綴。"
          }
        }
      }
    },
    "AdvancedSetting.slowFrameRate" : {
      "comment" : "Advanced setting: slowFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnutá adaptivní snímková frekvence, obnovuje se touto frekvencí (FPS) při vysoké propustnosti.\n Nevztahuje se na vykreslovací modul Metal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når adaptiv billedhastighed er slået til, opdateres der med denne hastighed ved højt gennemløb (FPS).\n Gælder ikke for Metal-gengivelsesmotoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die adaptive Bildwiederholrate aktiviert ist, bei hohem Durchsatz mit dieser Rate aktualisieren (FPS).\n Gilt nicht für den Metal-Renderer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When adaptive framerate is enabled, refresh at this rate during high throughput conditions (FPS).\n Does not apply to Metal renderer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la velocidad de fotogramas adaptativa está activada, se actualiza a esta velocidad (FPS) en condiciones de alto rendimiento.\n No se aplica al renderizador Metal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun mukautuva kuvataajuus on käytössä, päivitä tällä taajuudella (FPS) suuren läpimenon aikana.\n Ei koske Metal-renderöijää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la fréquence d’images adaptative est activée, actualiser à cette fréquence en cas de débit élevé (IPS).\n Ne s’applique pas au moteur de rendu Metal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la frequenza fotogrammi adattiva è attiva, aggiorna a questa frequenza (FPS) in condizioni di throughput elevato.\n Non si applica al motore di rendering Metal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートが有効な場合、高スループット時にこのレート（FPS）で再描画する。\nMetalレンダラーには適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임 속도가 켜져 있으면 처리량이 많을 때 이 속도(FPS)로 새로 고칩니다.\nMetal 렌더러에는 적용되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når adaptiv bildefrekvens er aktivert, oppdateres det med denne frekvensen ved høy gjennomstrømming (FPS).\n Gjelder ikke Metal-gjengiveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer adaptieve framerate is ingeschakeld, wordt met deze snelheid (FPS) vernieuwd bij hoge doorvoer.\nGeldt niet voor de Metal-weergavemodule."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączona jest adaptacyjna liczba klatek, odświeżaj z tą częstotliwością (FPS) przy dużej przepustowości.\n Nie dotyczy mechanizmu renderowania Metal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a taxa de quadros adaptável estiver ativada, atualizar nesta taxa durante condições de alta vazão (FPS).\n Não se aplica ao renderizador Metal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включена адаптивная частота кадров, обновлять экран с этой частотой (FPS) при высокой нагрузке.\n Не применяется к рендереру Metal."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnutá adaptívna snímková frekvencia, obnovovať touto frekvenciou (FPS) pri vysokej priepustnosti.\nNeplatí pre vykresľovací modul Metal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je vklopljena prilagodljiva hitrost sličic, osvežuj s to hitrostjo pri visoki prepustnosti (FPS).\n Ne velja za upodabljalnik Metal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När adaptiv bildfrekvens är aktiverad, uppdatera med den här frekvensen (FPS) vid högt dataflöde.\n Gäller inte Metal-renderaren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlamalı kare hızı etkinken, yüksek veri akışı koşullarında bu hızda yenile (FPS).\n Metal işleyici için geçerli değildir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật tốc độ khung hình thích ứng, làm mới với tốc độ này trong điều kiện thông lượng cao (FPS).\nKhông áp dụng cho trình kết xuất Metal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用自适应帧率时，在高吞吐量条件下以该速率刷新（FPS）。\n不适用于 Metal 渲染器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用自適應影格速率時，在高輸送量情況下以此速率（FPS）更新。\n不適用於 Metal 繪製器。"
          }
        }
      }
    },
