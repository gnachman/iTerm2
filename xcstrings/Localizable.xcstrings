    "Tip.0058.Body" : {
      "comment" : "Tip of the day body, id 0058",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie einmal dort, wo die Auswahl beginnen soll, und ⇧-klicken Sie dort, wo sie enden soll, um Text ohne Ziehen auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Single click where you want to start a selection and ⇧-click where you want it to end to select text without dragging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic donde quieras iniciar una selección y ⇧-clic donde quieras terminarla para seleccionar texto sin arrastrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez à l’endroit où la sélection doit commencer, puis cliquez avec ⇧ à l’endroit où elle doit se terminer pour sélectionner du texte sans le faire glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic dove vuoi iniziare una selezione e fai clic con ⇧ dove vuoi che finisca per selezionare il testo senza trascinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択を開始したい場所をクリックし、終了したい場所を⇧クリックすると、ドラッグせずにテキストを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택을 시작할 위치를 한 번 클릭하고 끝낼 위치를 ⇧-클릭하면 드래그하지 않고 텍스트를 선택할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique uma vez onde deseja iniciar uma seleção e ⇧-clique onde deseja terminá-la para selecionar texto sem arrastar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните один раз там, где нужно начать выделение, а затем ⇧-щёлкните там, где оно должно закончиться, чтобы выделить текст без перетаскивания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçime başlamak istediğiniz yere tek tıklayın, bitirmek istediğiniz yere ⇧ basılıyken tıklayın; böylece sürüklemeden metin seçersiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次点击即可选择开始位置，使用 ⇧- 点击指定结束位置可无拖拽选中文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選取起點按一下，再按住 ⇧ 在終點按一下，即可不用拖移就選取文字。"
          }
        }
      }
    },
