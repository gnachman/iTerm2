    "Tip.0028.Body" : {
      "comment" : "Tip of the day body, id 0028",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud nainstalujete integraci shellu na počítač, ke kterému se připojujete přes SSH, můžete kliknout pravým tlačítkem na název souboru (například ve výstupu příkazu „ls“) a zvolit „Stáhnout pomocí scp“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du installerer shell-integration på en maskine, du er forbundet til via ssh, kan du højreklikke på et arkivnavn (f.eks. i output fra “ls”) og vælge “Hent med scp” for at hente arkivet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Shell-Integration auf einem Rechner installieren, mit dem Sie sich per ssh verbinden, können Sie mit der rechten Maustaste auf einen Dateinamen klicken (zum Beispiel in der Ausgabe von „ls“) und „Mit scp herunterladen“ wählen, um die Datei herunterzuladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you install Shell Integration on a machine you ssh to, you can right click on a filename (for example, in the output of “ls”) and choose “Download with scp” to download the file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si instalas la integración con el shell en una máquina a la que te conectas por ssh, puedes hacer clic con el botón derecho en un nombre de archivo (por ejemplo, en la salida de “ls”) y elegir “Descargar con scp” para descargar el archivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos asennat komentotulkki-integraation koneelle, johon yhdistät ssh:lla, voit klikata tiedostonimeä oikealla painikkeella (esimerkiksi ”ls”-komennon tulosteessa) ja valita ”Lataa scp:llä” ladataksesi tiedoston."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous installez l’intégration du shell sur une machine à laquelle vous vous connectez en ssh, vous pouvez faire un clic droit sur un nom de fichier (par exemple, dans la sortie de « ls ») et choisir « Télécharger avec scp » pour télécharger le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se installi l’integrazione shell su una macchina a cui ti connetti in ssh, puoi fare clic con il tasto destro su un nome file (ad esempio, nell’output di “ls”) e scegliere “Scarica con scp” per scaricare il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sshで接続するマシンにシェル統合をインストールしておけば、(たとえば「ls」の出力の中で)ファイル名を右クリックして「scpでダウンロード」を選び、ファイルをダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH로 접속하는 컴퓨터에 셸 통합을 설치하면 파일 이름(예: “ls”의 출력)을 오른쪽 클릭하고 “scp로 다운로드”를 선택하여 파일을 다운로드할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du installerer skallintegrering på en maskin du kobler til via ssh, kan du høyreklikke på et filnavn (for eksempel i utdataene fra «ls») og velge «Last ned med scp» for å laste ned filen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je shell-integratie installeert op een machine waarmee je via ssh verbinding maakt, kun je met de rechtermuisknop op een bestandsnaam klikken (bijvoorbeeld in de uitvoer van ‘ls’) en ‘Download met scp’ kiezen om het bestand te downloaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zainstalujesz integrację z powłoką na komputerze, z którym łączysz się przez ssh, możesz kliknąć prawym przyciskiem nazwę pliku (na przykład w danych wyjściowych „ls”) i wybrać „Pobierz przez scp”, aby pobrać plik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você instalar a Shell Integration em uma máquina à qual se conecta por ssh, poderá clicar com o botão direito em um nome de arquivo (por exemplo, na saída do “ls”) e escolher “Transferir com scp” para transferir o arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы установите «Интеграцию с оболочкой» на компьютере, к которому подключаетесь по ssh, вы можете щёлкнуть правой кнопкой мыши по имени файла (например, в выводе команды «ls») и выбрать «Скачать по scp», чтобы загрузить файл."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak nainštalujete integráciu shellu na počítač, ku ktorému sa pripájate cez ssh, môžete kliknúť pravým tlačidlom na názov súboru (napríklad vo výstupe „ls“) a zvoliť „Stiahnuť cez scp“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če integracijo lupine namestite na računalnik, s katerim se povezujete prek ssh, lahko z desnim klikom na ime datoteke (na primer v izhodu ukaza »ls«) izberete »Prenesi z scp« za prenos datoteke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du installerar skalintegrering på en dator som du ansluter till med ssh kan du högerklicka på ett filnamn (till exempel i utdata från ”ls”) och välja ”Hämta med scp” för att hämta filen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh ile bağlandığınız bir makineye Kabuk Entegrasyonu’nu yüklerseniz bir dosya adına (örneğin “ls” çıktısında) sağ tıklayıp dosyayı indirmek için “scp ile İndir”i seçebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn cài đặt Tích hợp shell trên máy mà bạn ssh vào, bạn có thể bấm chuột phải vào một tên tệp (ví dụ, trong đầu ra của “ls”) và chọn “Tải về bằng scp” để tải tệp về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您在通过 SSH 连接的机器上安装 Shell Integration，可以右键点击文件名（例如“ls”的输出结果中的文件），选择“Download with scp”以下载该文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你在 ssh 連線的主機上安裝了 Shell 整合，就可以在檔名上（例如「ls」的輸出中）按一下右鍵，然後選擇「使用 scp 下載」來下載該檔案。"
          }
        }
      }
    },
