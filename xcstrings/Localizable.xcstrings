          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’uscita da iTerm2 richiesta dall’utente (⌘Q) terminerà tutti i processi in esecuzione.\nSi applica solo quando il ripristino delle sessioni è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーによる iTerm2 の終了 (⌘Q) は、実行中のすべてのジョブを終了させます。\nセッション復元がオンの場合にのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자가 iTerm2를 종료(⌘Q)하면 실행 중인 모든 작업이 강제 종료됩니다.\n세션 복원이 켜져 있을 때만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukerinitiert avslutning (⌘Q) av iTerm2 dreper alle kjørende prosesser.\nGjelder bare når øktgjenoppretting er aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door de gebruiker gestart stoppen (⌘Q) van iTerm2 beëindigt alle draaiende processen.\nGeldt alleen als sessieherstel is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończenie iTerm2 przez użytkownika (⌘Q) zabije wszystkie działające procesy.\nDotyczy tylko włączonego przywracania sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerrar o iTerm2 iniciado pelo usuário (⌘Q) encerrará todos os processos em execução.\nAplica-se somente quando a restauração de sessão está ativada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход из iTerm2 по инициативе пользователя (⌘Q) завершит все выполняющиеся задания.\nПрименяется только при включённом восстановлении сессий."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončenie iTerm2 užívateľom (⌘Q) ukončí všetky spustené procesy.\nPlatí iba pri zapnutej obnove relácií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabnikovo zapiranje (⌘Q) aplikacije iTerm2 bo ubilo vse procese v teku.\nVelja samo, ko je obnovitev sej vklopljena."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användarinitierat Avsluta (⌘Q) av iTerm2 avslutar alla körande processer.\nGäller bara när sessionsåterställning är på."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı tarafından başlatılan iTerm2’den Çık (⌘Q) tüm çalışan işlemleri sonlandırır.\nYalnızca oturum geri yükleme açıkken geçerlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người dùng chủ động Thoát (⌘Q) iTerm2 sẽ kill mọi tiến trình đang chạy.\nChỉ áp dụng khi bật khôi phục phiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的用户主动退出 (⌘Q) 会终止所有正在运行的作业。\n仅当会话恢复开启时适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用者主動結束 iTerm2（⌘Q）時，會終止所有執行中的程序。\n僅在開啟工作階段回復時適用。"
          }
        }
      }
    },
