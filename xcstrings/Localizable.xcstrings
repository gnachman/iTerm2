    "CodeReviewPromptUpdate.MigrateAction" : {
      "comment" : "What updating a customized code review system prompt does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Prompt aktualisieren“ nimmt nur die unten gezeigten Änderungen vor. Der Rest Ihres Prompts bleibt so, wie Sie ihn geschrieben haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Update Prompt makes only the changes shown below. The rest of your prompt stays as you wrote it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizar prompt solo realiza los cambios que se muestran abajo. El resto de tu prompt se queda como lo escribiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour le prompt n’applique que les modifications indiquées ci-dessous. Le reste de votre prompt reste tel que vous l’avez écrit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna prompt apporta solo le modifiche mostrate qui sotto. Il resto del prompt resta come l’hai scritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「プロンプトを更新」を選択すると、以下に示す変更のみが加えられます。プロンプトの残りの部分はあなたが書いたまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트 업데이트는 아래에 표시된 변경 사항만 적용합니다. 프롬프트의 나머지 부분은 작성한 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Atualizar prompt” faz apenas as alterações mostradas abaixo. O restante do seu prompt permanece como você o escreveu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Обновить промпт» вносит только изменения, показанные ниже. Остальная часть промпта останется такой, как вы её написали."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“İstemi Güncelle” yalnızca aşağıda gösterilen değişiklikleri yapar. İsteminizin geri kalanı yazdığınız gibi kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“更新提示”只会进行下方所示的更改。提示的其余部分将保持你编写的原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「更新提示詞」只會進行下方所示的變更。提示詞的其餘部分會維持你所撰寫的原樣。"
          }
        }
      }
    },
