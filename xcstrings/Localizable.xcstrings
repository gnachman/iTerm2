    "PythonRuntimeDownloader.DownloadOptionalMessage" : {
      "comment" : "Prompt to download the runtime; %@ is the download size",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Python-Laufzeitumgebung wird von Python-Skripten verwendet, die mit iTerm2 zusammenarbeiten. Der Download ist etwa %@ groß. Jetzt herunterladen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python Runtime is used by Python scripts that work with iTerm2. The download is about %@. OK to download it now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entorno de ejecución de Python lo usan los scripts de Python que funcionan con iTerm2. La descarga ocupa unos %@. ¿Quieres descargarlo ahora?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement d’exécution Python est utilisé par les scripts Python qui fonctionnent avec iTerm2. Le téléchargement représente environ %@. Le télécharger maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente di esecuzione Python è usato dagli script Python che funzionano con iTerm2. Il download è di circa %@. Vuoi scaricarlo ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python ランタイムは、iTerm2 と連携する Python スクリプトで使用されます。ダウンロードサイズは約 %@ です。今すぐダウンロードしてもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 런타임은 iTerm2와 연동되는 Python 스크립트에서 사용됩니다. 다운로드 크기는 약 %@입니다. 지금 다운로드하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Runtime do Python é usado por scripts Python que funcionam com o iTerm2. A transferência tem cerca de %@. Deseja transferi-lo agora?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среда выполнения Python используется скриптами Python, работающими с iTerm2. Размер загрузки составляет около %@. Загрузить её сейчас?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python çalışma zamanı, iTerm2 ile çalışan Python betikleri tarafından kullanılır. İndirme boyutu yaklaşık %@. Şimdi indirilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Python 脚本需要使用 Python 运行时。下载大小约为 %@。现在下载可以吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 iTerm2 搭配運作的 Python 腳本會使用 Python 執行環境。下載大小約為 %@。要現在下載嗎？"
          }
        }
      }
    },
