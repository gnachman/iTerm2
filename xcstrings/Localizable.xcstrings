          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 앞에 있지 않은 윈도우를 클릭할 때 마우스 리포트를 보내겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send musrapporter når du klikker i et vindu som ikke allerede er fremste vindu?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muisrapporten sturen wanneer je klikt in een venster dat nog niet op de voorgrond staat?"
          }
        },
        "pl" : {
          "stringUnit" : {
