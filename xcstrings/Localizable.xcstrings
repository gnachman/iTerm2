    "PTYSession.TmuxPausedNotification" : {
      "comment" : "Announcement that tmux paused a session due to excessive buffered output",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux tuto relaci pozastavil, protože bylo do vyrovnávací paměti uloženo příliš mnoho výstupu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
