    "SessionLauncher.IllegalUsernameMessage" : {
      "comment" : "Warning message when an SSH username contains a disallowed character. %@ is the username.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SSH-Benutzername „%@“ enthielt ein nicht erlaubtes Zeichen. Die Menge der erlaubten Zeichen ist aus Sicherheitsgründen eingeschränkt. Sie können sie unter Einstellungen > Erweitert > Gültige Zeichen in SSH-Benutzernamen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The SSH user name “%@” contained a disallowed character. The set of allowed characters is limited for security reasons. You can modify it in Settings > Advanced > Valid characters in SSH user names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario de SSH “%@” contenía un carácter no permitido. El conjunto de caracteres permitidos está limitado por motivos de seguridad. Puedes modificarlo en Ajustes > Avanzado > Caracteres válidos en nombres de usuario de SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d’utilisateur SSH « %@ » contenait un caractère non autorisé. L’ensemble des caractères autorisés est limité pour des raisons de sécurité. Vous pouvez le modifier dans Réglages > Avancé > Caractères valides dans les noms d’utilisateur SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome utente SSH “%@” conteneva un carattere non consentito. L’insieme dei caratteri consentiti è limitato per motivi di sicurezza. Puoi modificarlo in Impostazioni > Avanzate > Caratteri validi nei nomi utente SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHユーザー名「%@」に、許可されていない文字が含まれていました。セキュリティ上の理由により、使用できる文字の範囲は制限されています。設定 > 詳細 > 「SSHユーザー名で使用できる文字」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 사용자 이름 “%@”에 허용되지 않는 문자가 포함되어 있습니다. 보안상의 이유로 허용되는 문자가 제한되어 있습니다. 설정 > 고급 > SSH 사용자 이름에 유효한 문자에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuário SSH “%@” continha um caractere não permitido. O conjunto de caracteres permitidos é limitado por motivos de segurança. Você pode modificá-lo em Ajustes > Avançado > Caracteres válidos em nomes de usuário SSH."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя SSH «%@» содержит недопустимый символ. Набор разрешённых символов ограничен из соображений безопасности. Его можно изменить в разделе Settings > Advanced > Valid characters in SSH user names."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” SSH kullanıcı adı izin verilmeyen bir karakter içeriyordu. İzin verilen karakter kümesi güvenlik nedeniyle sınırlıdır. Bunu Ayarlar > Gelişmiş > SSH kullanıcı adlarında geçerli karakterler bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 用户名“%@”包含不允许的字符。出于安全原因，允许的字符集受到限制。你可以在 设置 > 高级 > SSH 用户名中的有效字符 中修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 使用者名稱「%@」含有不允許的字元。基於安全性考量，允許的字元集受到限制。你可以在「設定 > 進階 > SSH 使用者名稱中的有效字元」中修改。"
          }
        }
      }
    },
