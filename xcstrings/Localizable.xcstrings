    "OpenLink.FileTitle" : {
      "comment" : "Prompt asking whether to open a file in iTerm2 instead of the default app",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 umí takové soubory zobrazit ve svém vestavěném webovém prohlížeči! Chcete tento odkaz otevřít v iTerm2?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan vise arkiver som dette i sin indbyggede browser! Vil du åbne dette link i iTerm2?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann solche Dateien in seinem integrierten Webbrowser anzeigen! Möchten Sie diesen Link in iTerm2 öffnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can display files like this in its built-in web browser! Would you like to open this link in iTerm2?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡iTerm2 puede mostrar archivos como este en su navegador web integrado! ¿Quieres abrir este enlace en iTerm2?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 voi näyttää tällaisia tiedostoja sisäänrakennetussa verkkoselaimessaan! Haluatko avata tämän linkin iTerm2:ssa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut afficher des fichiers comme celui-ci dans son navigateur web intégré ! Voulez-vous ouvrir ce lien dans iTerm2 ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può mostrare file come questo nel suo browser integrato! Vuoi aprire questo link in iTerm2?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は内蔵のWebブラウザでこのようなファイルを表示できます!このリンクをiTerm2で開きますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 이런 파일을 내장 웹 브라우저에서 표시할 수 있습니다! 이 링크를 iTerm2에서 열겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan vise filer som denne i den innebygde nettleseren! Vil du åpne denne lenken i iTerm2?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan bestanden zoals dit weergeven in de ingebouwde browser! Wil je deze link in iTerm2 openen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 może wyświetlać takie pliki w swojej wbudowanej przeglądarce! Czy chcesz otworzyć to łącze w iTerm2?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode exibir arquivos como este em seu navegador web integrado! Deseja abrir este link no iTerm2?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может отображать подобные файлы во встроенном веб-браузере! Хотите открыть эту ссылку в iTerm2?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 dokáže takéto súbory zobraziť vo svojom vstavanom prehliadači! Chcete tento odkaz otvoriť v iTerm2?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 lahko take datoteke prikaže v svojem vgrajenem spletnem brskalniku! Želite to povezavo odpreti v aplikaciji iTerm2?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan visa filer som den här i sin inbyggda webbläsare! Vill du öppna länken i iTerm2?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 bunun gibi dosyaları yerleşik web tarayıcısında görüntüleyebilir! Bu bağlantıyı iTerm2’de açmak ister misiniz?"
          }
        },
        "vi" : {
          "stringUnit" : {
