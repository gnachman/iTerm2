    "AIModelEditor.ConfigurableThinkingTooltip" : {
      "comment" : "Tooltip for the configurable thinking checkbox",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte pro modely s uvažováním a režimem přemýšlení, například GPT-5, řadu o nebo modely DeepSeek, aby se v chatu zobrazil přepínač Přemýšlet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå til for ræsonnementsmodeller med en tænketilstand, såsom GPT-5, o-serien eller DeepSeek-modeller, så chattens Tænk-knap vises."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren für Reasoning-Modelle mit Denkmodus, wie GPT-5, die o-Serie oder DeepSeek-Modelle, damit im Chat der „Denken“-Schalter erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable for reasoning models with a thinking mode, such as GPT-5, o-series, or DeepSeek models, so the chat’s Think toggle appears."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo para modelos de razonamiento con modo de pensamiento, como GPT-5, la serie o o los modelos DeepSeek, para que aparezca el botón Pensar del chat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön päättelymalleille, joilla on päättelytila, kuten GPT-5-, o-sarjan tai DeepSeek-malleille, jotta keskustelun Päättely-kytkin tulee näkyviin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez pour les modèles de raisonnement dotés d’un mode de réflexion, comme GPT-5, la série o ou les modèles DeepSeek, afin que le bouton Réflexion du chat apparaisse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita per i modelli di ragionamento con modalità di ragionamento, come GPT-5, la serie o o i modelli DeepSeek, così che compaia l’interruttore Ragiona della chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPT-5、oシリーズ、DeepSeekモデルなど、思考モードを持つ推論モデルで有効にすると、チャットに「Think」トグルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPT-5, o 시리즈, DeepSeek 모델처럼 사고 모드가 있는 추론 모델에서 켜면 채팅에 ‘생각’ 토글이 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver for resonneringsmodeller med tenkemodus, som GPT-5, o-serien eller DeepSeek-modeller, slik at Tenk-bryteren i chatten vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel dit in voor redeneermodellen met een denkmodus, zoals GPT-5, o-serie of DeepSeek-modellen, zodat de schakelaar Denk in de chat verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz dla modeli rozumowania z trybem myślenia, takich jak GPT-5, seria o lub modele DeepSeek, aby pojawił się przełącznik Rozumowanie w czacie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative para modelos de raciocínio com um modo de pensamento, como GPT-5, série o ou modelos DeepSeek, para que o botão Pensar do chat apareça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите для моделей с режимом размышления, таких как GPT-5, серия o или модели DeepSeek, чтобы в чате появился переключатель «Думать»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite pre modely s uvažovaním a režimom premýšľania, ako sú modely GPT-5, rady o alebo DeepSeek, aby sa v chate zobrazil prepínač Premýšľať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogočite za modele z razmišljanjem, ki imajo način razmišljanja, kot so modeli GPT-5, serija o ali DeepSeek, da se v klepetu prikaže stikalo Razmišljaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera för resonemangsmodeller med ett tänkandeläge, till exempel GPT-5, o-serien eller DeepSeek-modeller, så att chattens Tänk-reglage visas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşünme moduna sahip GPT-5, o serisi veya DeepSeek modelleri gibi muhakeme modelleri için etkinleştirin; böylece sohbetteki Düşünme düğmesi görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật cho các mô hình suy luận có chế độ suy nghĩ, như GPT-5, dòng o hoặc các mô hình DeepSeek, để nút Suy nghĩ của cuộc trò chuyện xuất hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为具有思考模式的推理模型（如 GPT-5、o 系列或 DeepSeek 模型）启用，以便在聊天中显示“思考”开关。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為具有思考模式的推理模型（如 GPT-5、o 系列或 DeepSeek 模型）啟用，以便在聊天中顯示「思考」切換開關。"
          }
        }
      }
