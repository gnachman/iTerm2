          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchura predeterminada del tabulador para las nuevas sesiones.\nNota: esto romperá el dibujado en emacs y otras apps."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusien istuntojen sarkainkohdan oletusleveys.\nHuomaa: tämä rikkoo piirtämisen emacsissa ja muissa sovelluksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
