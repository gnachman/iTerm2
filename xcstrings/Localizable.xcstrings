    "ProfilesTerminal.UTF8MismatchWarning" : {
      "comment" : "Warning shown when a custom locale does not use UTF-8 but the profile does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozor! Tento profil používá vlastní národní prostředí, které jako kódování znaků nepoužívá UTF-8, ale váš profil UTF-8 *používá*. Může to způsobit, že se chybová hlášení a text mimo ASCII zobrazí nesprávně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel! Denne profil bruger en brugerdefineret landestandard, der ikke bruger UTF-8 som tegnkodning, men din profil bruger *faktisk* UTF-8. Det kan få fejlmeddelelser og tekst uden for ASCII til at se forkert ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung! Dieses Profil verwendet ein benutzerdefiniertes Gebietsschema, das nicht UTF-8 als Zeichenkodierung verwendet, Ihr Profil verwendet jedoch *tatsächlich* UTF-8. Dies kann dazu führen, dass Fehlermeldungen und Nicht-ASCII-Text falsch angezeigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning! This profile uses a custom locale that doesn't use UTF-8 as its character encoding, but your profile *is* using UTF-8. This can cause error messages and non-ASCII text to appear wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Advertencia! Este perfil usa una configuración regional personalizada que no usa UTF-8 como codificación de caracteres, pero tu perfil *sí* usa UTF-8. Esto puede hacer que los mensajes de error y el texto no ASCII se muestren de forma incorrecta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoitus! Tämä profiili käyttää mukautettua alueasetusta, joka ei käytä merkistökoodauksena UTF-8:aa, mutta profiilisi käyttää *UTF-8:aa*. Tämä voi aiheuttaa sen, että virheilmoitukset ja ei-ASCII-teksti näkyvät väärin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention ! Ce profil utilise des paramètres régionaux personnalisés qui n’utilisent pas UTF-8 comme encodage des caractères, alors que votre profil utilise *bien* UTF-8. Cela peut provoquer un affichage incorrect des messages d’erreur et du texte non ASCII."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione! Questo profilo usa impostazioni locali personalizzate che non usano UTF-8 come codifica dei caratteri, mentre il tuo profilo *usa* UTF-8. Questo può causare la visualizzazione errata di messaggi di errore e testo non ASCII."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告! このプロファイルは文字エンコーディングにUTF-8を使用しないカスタムロケールを使用していますが、プロファイル自体は*UTF-8を使用しています*。これにより、エラーメッセージや非ASCII文字が正しく表示されないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고! 이 프로파일은 문자 인코딩으로 UTF-8을 사용하지 않는 사용자 지정 로케일을 사용하지만, 프로파일 자체는 UTF-8을 *사용하고* 있습니다. 이로 인해 오류 메시지와 비ASCII 텍스트가 잘못 표시될 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel! Denne profilen bruker en egendefinert språkinnstilling som ikke bruker UTF-8 som tegnkoding, men profilen din bruker *faktisk* UTF-8. Dette kan føre til at feilmeldinger og tekst som ikke er ASCII, vises feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op! Dit profiel gebruikt een aangepaste taalversie die geen UTF-8 als tekencodering gebruikt, terwijl je profiel *wel* UTF-8 gebruikt. Hierdoor kunnen foutmeldingen en niet-ASCII-tekst er verkeerd uitzien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie! Ten profil używa niestandardowych ustawień regionalnych, które nie używają UTF-8 jako kodowania znaków, ale twój profil *używa* UTF-8. Może to powodować, że komunikaty o błędach i tekst spoza ASCII będą wyświetlane nieprawidłowo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso! Este perfil usa uma localidade personalizada que não usa UTF-8 como codificação de caracteres, mas seu perfil *está* usando UTF-8. Isso pode fazer com que mensagens de erro e texto não ASCII apareçam incorretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание! Этот профиль использует особую локаль, которая не использует UTF-8 в качестве кодировки символов, однако в самом профиле UTF-8 *действительно* используется. Это может привести к неверному отображению сообщений об ошибках и текста, отличного от ASCII."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozor! Tento profil používa vlastné miestne nastavenia, ktoré ako kódovanie znakov nepoužívajú UTF-8, ale váš profil UTF-8 *používa*. Môže to spôsobiť nesprávne zobrazenie chybových hlásení a textu mimo ASCII."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozorilo! Ta profil uporablja po meri določeno območno nastavitev, ki kot kodiranje znakov ne uporablja UTF-8, vaš profil pa *uporablja* UTF-8. To lahko povzroči, da so sporočila o napakah in besedilo, ki ni ASCII, videti napačno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning! Den här profilen använder en anpassad språkinställning som inte använder UTF-8 som teckenkodning, men din profil använder *just* UTF-8. Det kan göra att felmeddelanden och icke-ASCII-text visas felaktigt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı! Bu profil, karakter kodlaması olarak UTF-8 kullanmayan özel bir yerel ayar kullanıyor, ancak profiliniz UTF-8 kullanıyor. Bu, hata iletilerinin ve ASCII olmayan metinlerin yanlış görünmesine neden olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo! Hồ sơ này dùng thiết lập vùng tùy chỉnh không dùng UTF-8 làm mã hóa ký tự, nhưng hồ sơ của bạn *đang* dùng UTF-8. Điều này có thể khiến thông báo lỗi và văn bản không phải ASCII hiển thị sai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此配置文件使用的自定义语言环境不使用 UTF-8 作为字符编码，但你的配置文件*确实*使用 UTF-8。这可能导致错误消息和非 ASCII 文本显示异常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此描述檔使用的自訂語系並未使用 UTF-8 作為字元編碼，但你的描述檔*正在*使用 UTF-8。這可能導致錯誤訊息和非 ASCII 文字顯示異常。"
          }
        }
      }
    },
    "ProfilesTerminal.UnplayableBellSound" : {
      "comment" : "Tooltip on the bell sound the profile names when that sound is missing or is not audio that can be played",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento zvuk nelze přehrát, proto zvonek přehraje zvuk upozornění systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne lyd kan ikke afspilles, så klokken afspiller systemets advarselslyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ton kann nicht wiedergegeben werden, daher ertönt stattdessen der System-Warnton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sound can’t be played, so the bell plays the system alert sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sonido no se puede reproducir, así que la campana reproduce el sonido de alerta del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä ääntä ei voi toistaa, joten äänimerkki toistaa järjestelmän varoitusäänen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce son ne peut pas être lu, la sonnerie joue donc le son d’alerte du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo suono non può essere riprodotto, quindi il campanello riproduce il suono di avviso del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサウンドは再生できないため、ベルにはシステムの警告音が使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사운드를 재생할 수 없으므로 벨에서 시스템 경고음이 재생됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne lyden kan ikke spilles av, så bjellen spiller av systemets varsellyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit geluid kan niet worden afgespeeld, dus de bel speelt het systeemwaarschuwingsgeluid af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego dźwięku nie można odtworzyć, więc dzwonek odtwarza systemowy dźwięk alertu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este som não pode ser reproduzido, então a campainha toca o som de alerta do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот звук невозможно воспроизвести, поэтому для звонка используется системный звук предупреждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento zvuk sa nedá prehrať, preto zvonček prehráva systémový zvuk upozornenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tega zvoka ni mogoče predvajati, zato zvonec predvaja sistemski zvok opozorila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här ljudet kan inte spelas upp, så klockan spelar upp systemets varningsljud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ses çalınamıyor, bu nedenle zil sistem uyarı sesini çalar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể phát âm thanh này, nên chuông sẽ phát âm thanh cảnh báo hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
