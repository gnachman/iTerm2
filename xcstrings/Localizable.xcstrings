    "ProfilesTerminal.UTF8MismatchWarning" : {
      "comment" : "Warning shown when a custom locale does not use UTF-8 but the profile does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung! Dieses Profil verwendet ein benutzerdefiniertes Gebietsschema, das nicht UTF-8 als Zeichenkodierung verwendet, Ihr Profil verwendet jedoch *tatsächlich* UTF-8. Dies kann dazu führen, dass Fehlermeldungen und Nicht-ASCII-Text falsch angezeigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning! This profile uses a custom locale that doesn't use UTF-8 as its character encoding, but your profile *is* using UTF-8. This can cause error messages and non-ASCII text to appear wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Advertencia! Este perfil usa una configuración regional personalizada que no usa UTF-8 como codificación de caracteres, pero tu perfil *sí* usa UTF-8. Esto puede hacer que los mensajes de error y el texto no ASCII se muestren de forma incorrecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention ! Ce profil utilise des paramètres régionaux personnalisés qui n’utilisent pas UTF-8 comme encodage des caractères, alors que votre profil utilise *bien* UTF-8. Cela peut provoquer un affichage incorrect des messages d’erreur et du texte non ASCII."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione! Questo profilo usa impostazioni locali personalizzate che non usano UTF-8 come codifica dei caratteri, mentre il tuo profilo *usa* UTF-8. Questo può causare la visualizzazione errata di messaggi di errore e testo non ASCII."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告! このプロファイルは文字エンコーディングにUTF-8を使用しないカスタムロケールを使用していますが、プロファイル自体は*UTF-8を使用しています*。これにより、エラーメッセージや非ASCII文字が正しく表示されないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고! 이 프로파일은 문자 인코딩으로 UTF-8을 사용하지 않는 사용자 지정 로케일을 사용하지만, 프로파일 자체는 UTF-8을 *사용하고* 있습니다. 이로 인해 오류 메시지와 비ASCII 텍스트가 잘못 표시될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso! Este perfil usa uma localidade personalizada que não usa UTF-8 como codificação de caracteres, mas seu perfil *está* usando UTF-8. Isso pode fazer com que mensagens de erro e texto não ASCII apareçam incorretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание! Этот профиль использует особую локаль, которая не использует UTF-8 в качестве кодировки символов, однако в самом профиле UTF-8 *действительно* используется. Это может привести к неверному отображению сообщений об ошибках и текста, отличного от ASCII."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı! Bu profil, karakter kodlaması olarak UTF-8 kullanmayan özel bir yerel ayar kullanıyor, ancak profiliniz UTF-8 kullanıyor. Bu, hata iletilerinin ve ASCII olmayan metinlerin yanlış görünmesine neden olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此配置文件使用的自定义语言环境不使用 UTF-8 作为字符编码，但你的配置文件*确实*使用 UTF-8。这可能导致错误消息和非 ASCII 文本显示异常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此描述檔使用的自訂語系並未使用 UTF-8 作為字元編碼，但你的描述檔*正在*使用 UTF-8。這可能導致錯誤訊息和非 ASCII 文字顯示異常。"
          }
        }
      }
    },
    "ProfilesTerminal.UnplayableBellSound" : {
      "comment" : "Tooltip on the bell sound the profile names when that sound is missing or is not audio that can be played",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ton kann nicht wiedergegeben werden, daher ertönt stattdessen der System-Warnton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sound can’t be played, so the bell plays the system alert sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sonido no se puede reproducir, así que la campana reproduce el sonido de alerta del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce son ne peut pas être lu, la sonnerie joue donc le son d’alerte du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo suono non può essere riprodotto, quindi il campanello riproduce il suono di avviso del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサウンドは再生できないため、ベルにはシステムの警告音が使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사운드를 재생할 수 없으므로 벨에서 시스템 경고음이 재생됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este som não pode ser reproduzido, então a campainha toca o som de alerta do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот звук невозможно воспроизвести, поэтому для звонка используется системный звук предупреждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ses çalınamıyor, bu nedenle zil sistem uyarı sesini çalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
