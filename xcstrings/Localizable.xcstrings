    "ChatViewController.PermissionGrantedBody" : {
      "comment" : "Notice shown when the chat is granted permission to control a mentioned entity",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Diesem Chat wurde die Berechtigung erteilt, „%@“ zu steuern.**\n\nSie haben es mit @ erwähnt, daher kann der Agent dort ohne Rückfrage handeln. Widerrufen Sie die Berechtigung, um wieder eine Genehmigung zu verlangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Granted this chat permission to control “%@”.**\n\nYou @-mentioned it, so the agent can act there without asking. Revoke to require approval again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Se ha concedido a este chat permiso para controlar “%@”.**\n\nLo mencionaste con @, así que el agente puede actuar ahí sin preguntar. Revócalo para volver a exigir aprobación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Autorisation de contrôler « %@ » accordée à ce chat.**\n\nVous l’avez mentionné avec @, donc l’agent peut y agir sans demander. Révoquez pour exiger de nouveau une approbation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Hai concesso a questa chat l’autorizzazione a controllare “%@”.**\n\nL’hai menzionato con @, quindi l’agente può agire lì senza chiedere. Revoca per richiedere di nuovo l’approvazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**このチャットに「%@」を制御する権限を付与しました。**\n\n@メンションしたため、エージェントは確認なしでそこで操作できます。再度承認を必須にするには取り消してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**이 채팅에 “%@”을(를) 제어할 권한을 부여했습니다.**\n\n@멘션했으므로 에이전트가 묻지 않고 해당 대상에서 작업할 수 있습니다. 다시 승인을 요구하려면 권한을 취소하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Concedida a este chat a permissão para controlar “%@”.**\n\nVocê o mencionou com @, então o agente pode agir ali sem perguntar. Revogue para exigir aprovação novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Этому чату предоставлено разрешение управлять «%@».**\n\nВы упомянули его через @, поэтому агент может действовать там без запроса. Отзовите разрешение, чтобы снова требовать подтверждение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Bu sohbete “%@” öğesini denetleme izni verildi.**\n\n@ ile andınız, bu yüzden ajan orada sormadan işlem yapabilir. Yeniden onay gerekmesi için izni geri alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**已授予此聊天权限以控制“%@”。**\n\n您提到了这一点，因此代理可以在不询问的情况下执行操作。要撤销则需再次获得批准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**已授予此聊天控制「%@」的權限。**\n\n你已使用 @ 提及它，因此代理程式可以在不詢問的情況下在該處執行動作。撤銷後將需要再次核准。"
          }
        }
      }
    },
