        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roda de rolagem para cima envia o texto especificado no modo de tela alternada.\nO valor deve usar a sintaxe do Vim, como \\e para escape."
          }
        },
        "ru" : {
