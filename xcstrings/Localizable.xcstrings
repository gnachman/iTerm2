    "PythonRuntimeDownloader.DownloadRequiredMessage" : {
      "comment" : "Prompt to download the required runtime; %@ is the download size",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běhové prostředí Pythonu využívají skripty v Pythonu, které spolupracují s iTerm2. Pro dokončení požadované akce je nutné jej stáhnout. Stahování má přibližně %@. Chcete jej stáhnout hned?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-kørselsmiljøet bruges af Python-instrukser, der arbejder sammen med iTerm2. Det skal hentes for at udføre den ønskede handling. Hentningen er på ca. %@. Vil du hente det nu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Python-Laufzeitumgebung wird von Python-Skripten verwendet, die mit iTerm2 zusammenarbeiten. Sie muss heruntergeladen werden, um die gewünschte Aktion abzuschließen. Der Download ist etwa %@ groß. Jetzt herunterladen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python Runtime is used by Python scripts that work with iTerm2. It must be downloaded to complete the requested action. The download is about %@. OK to download it now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entorno de ejecución de Python lo usan los scripts de Python que funcionan con iTerm2. Debe descargarse para completar la acción solicitada. La descarga ocupa unos %@. ¿Quieres descargarlo ahora?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-suoritusympäristöä käyttävät iTerm2:n kanssa toimivat Python-skriptit. Se on ladattava, jotta pyydetty toiminto voidaan suorittaa. Lataus on noin %@. Ladataanko se nyt?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement d’exécution Python est utilisé par les scripts Python qui fonctionnent avec iTerm2. Il doit être téléchargé pour effectuer l’action demandée. Le téléchargement représente environ %@. Le télécharger maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ambiente di esecuzione Python è usato dagli script Python che funzionano con iTerm2. Deve essere scaricato per completare l’azione richiesta. Il download è di circa %@. Vuoi scaricarlo ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python ランタイムは、iTerm2 と連携する Python スクリプトで使用されます。要求された操作を完了するにはダウンロードが必要です。ダウンロードサイズは約 %@ です。今すぐダウンロードしてもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 런타임은 iTerm2와 연동되는 Python 스크립트에서 사용됩니다. 요청한 동작을 완료하려면 다운로드해야 합니다. 다운로드 크기는 약 %@입니다. 지금 다운로드하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-kjøremiljøet brukes av Python-skript som fungerer med iTerm2. Det må lastes ned for å fullføre den forespurte handlingen. Nedlastingen er på omtrent %@. Vil du laste det ned nå?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Python-runtime wordt gebruikt door Python-scripts die met iTerm2 werken. Deze moet worden gedownload om de gevraagde actie te voltooien. De download is ongeveer %@. Wil je deze nu downloaden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Środowisko uruchomieniowe Pythona jest używane przez skrypty Pythona współpracujące z iTerm2. Aby wykonać żądaną czynność, trzeba je pobrać. Rozmiar pobieranych danych to około %@. Czy pobrać je teraz?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Runtime do Python é usado por scripts Python que funcionam com o iTerm2. Ele precisa ser transferido para concluir a ação solicitada. A transferência tem cerca de %@. Deseja transferi-lo agora?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среда выполнения Python используется скриптами Python, работающими с iTerm2. Её необходимо загрузить, чтобы выполнить запрошенное действие. Размер загрузки составляет около %@. Загрузить её сейчас?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripty Python, ktoré spolupracujú s iTerm2, používajú behové prostredie Python. Na dokončenie požadovanej akcie je potrebné ho stiahnuť. Sťahovanie má približne %@. Chcete ho stiahnuť teraz?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvajalno okolje Python uporabljajo skripti Python, ki delujejo z aplikacijo iTerm2. Za dokončanje zahtevanega dejanja ga je treba prenesti. Prenos je velik približno %@. Ga želite prenesti zdaj?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-körmiljön används av Python-skript som arbetar med iTerm2. Den måste hämtas för att slutföra den begärda åtgärden. Hämtningen är cirka %@. Vill du hämta den nu?"
          }
        },
        "tr" : {
