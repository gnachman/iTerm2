    "ScriptLauncher.RefetchRuntimeMessage" : {
      "comment" : "Prompt to download the Apple Silicon runtime",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gemeinsam genutzte Python-Laufzeitumgebung ist reines Intel und kann auf dieser Version von macOS nicht ausgeführt werden. Jetzt die Apple-Silicon-Version herunterladen?"
          }
