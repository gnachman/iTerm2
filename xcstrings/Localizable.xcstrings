          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun ASCII dışı dizeleri arka plan kuyruğunda ön dönüştür.\nBu, daha iyi verim için ön dönüştürmeyi ayrıştırıcı iş parçacığından ayırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền chuyển đổi các chuỗi dài không phải ASCII trên hàng đợi nền.\nĐiều này tách việc tiền chuyển đổi khỏi luồng phân tích cú pháp để có thông lượng tốt hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台队列中对长非 ASCII 字符串进行预转换。\n此操作将预转换与解析线程分离，以提高吞吐量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背景佇列中預先轉換較長的非 ASCII 字串。\n這會讓預先轉換與解析器執行緒分離，以提高傳輸量。"
          }
        }
      }
    },
