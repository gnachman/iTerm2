          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie aplikacje mogą używać API, zgodnie z „Ustawienia > Ogólne > Magia > Pozwalaj na połączenia wszystkim aplikacjom”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
