        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar quais elementos aparecem nos títulos de sessão em “Ajustes > Perfis > Geral > Título”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить, какие элементы отображаются в заголовках сессий, в «Настройки > Профили > Общие > Заголовок»."
          }
