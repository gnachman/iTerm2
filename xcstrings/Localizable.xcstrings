    "LLMMetadata.OllamaModelUnavailable" : {
      "comment" : "Error shown in an AI chat pinned to a local Ollama model that Ollama no longer lists (for example, it was removed), instead of sending the message to a different AI provider. The placeholder is the model's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ollama-Modell „%@“ ist nicht verfügbar. Stellen Sie sicher, dass Ollama läuft und das Modell installiert ist, oder wählen Sie ein anderes Modell für diesen Chat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Ollama model “%@” is not available. Make sure Ollama is running and the model is installed, or choose a different model for this chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de Ollama “%@” no está disponible. Asegúrate de que Ollama se esté ejecutando y de que el modelo esté instalado, o elige otro modelo para este chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle Ollama « %@ » n’est pas disponible. Vérifiez qu’Ollama est en cours d’exécution et que le modèle est installé, ou choisissez un autre modèle pour ce chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello Ollama “%@” non è disponibile. Assicurati che Ollama sia in esecuzione e che il modello sia installato, oppure scegli un altro modello per questa chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollamaのモデル「%@」は利用できません。Ollamaが起動していてモデルがインストールされていることを確認するか、このチャットで別のモデルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama 모델 “%@”을(를) 사용할 수 없습니다. Ollama가 실행 중이고 모델이 설치되어 있는지 확인하거나 이 채팅에 다른 모델을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo do Ollama “%@” não está disponível. Verifique se o Ollama está em execução e se o modelo está instalado, ou escolha outro modelo para este chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель Ollama «%@» недоступна. Убедитесь, что Ollama запущена и модель установлена, или выберите для этого чата другую модель."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” Ollama modeli kullanılamıyor. Ollama’nın çalıştığından ve modelin yüklü olduğundan emin olun veya bu sohbet için farklı bir model seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama 模型“%@”不可用。请确保 Ollama 正在运行且已安装该模型，或为此聊天选择其他模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama 模型「%@」無法使用。請確認 Ollama 正在執行且已安裝該模型，或為此聊天選擇其他模型。"
          }
        }
      }
    },
