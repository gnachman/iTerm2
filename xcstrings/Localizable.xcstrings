    "AdvancedSetting.hideStuckTooltips" : {
      "comment" : "Advanced setting: hideStuckTooltips",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt zaseknuté nápovědy.\nKdyž skryjete iTerm2 horkou klávesou, zatímco nápověda mizí, zasekne se kvůli chybě systému. Zapnutím této funkce ji obejdete nepěkným trikem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul værktøjstip, der sidder fast.\nNår du skjuler iTerm2 med en genvejstast, mens et værktøjstip toner ud, sætter det sig fast på grund af en fejl i systemet. Omgå det med et grimt hack ved at slå denne funktion til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängende Tooltips ausblenden.\nWenn Sie iTerm2 mit einer Hotkey-Taste ausblenden, während ein Tooltip gerade ausgeblendet wird, bleibt er aufgrund eines Betriebssystemfehlers hängen. Umgehen Sie dies mit einem unschönen Hack, indem Sie diese Funktion aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide stuck tooltips.\nWhen you hide iTerm2 using a hotkey while a tooltip is fading out it gets stuck because of an OS bug. Work around it with a nasty hack by enabling this feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las descripciones emergentes atascadas.\nCuando ocultas iTerm2 con una tecla rápida mientras una descripción emergente se desvanece, se queda atascada por un error del sistema. Actívalo para evitarlo con un truco poco elegante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kätke jumiin jääneet työkaluvihjeet.\nKun kätket iTerm2:n pikanäppäimellä työkaluvihjeen häipyessä, se jää jumiin käyttöjärjestelmän virheen vuoksi. Kierrä tämä ikävällä kikalla ottamalla tämä ominaisuus käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les infobulles bloquées.\nQuand vous masquez iTerm2 avec un raccourci global pendant qu’une infobulle s’estompe, elle reste bloquée à cause d’un bug du système. Contournez-le avec un vilain hack en activant cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi i suggerimenti bloccati.\nQuando nascondi iTerm2 con un’abbreviazione globale mentre un suggerimento sta svanendo, questo si blocca a causa di un bug del sistema. Aggira il problema con un brutto trucco abilitando questa funzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固まったツールチップを非表示にします。\nツールチップがフェードアウト中にホットキーで iTerm2 を非表示にすると、OS のバグによりツールチップが固まってしまいます。この機能を有効にすると、強引なハックでこれを回避します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춘 도움말 풍선을 가립니다.\n도움말 풍선이 사라지는 동안 단축키로 iTerm2를 가리면 OS 버그 때문에 도움말 풍선이 화면에 멈춰 남습니다. 이 기능을 켜면 지저분한 편법으로 이 문제를 우회합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul fastlåste verktøytips.\nNår du skjuler iTerm2 med en hurtigtast mens et verktøytips tones ut, blir det sittende fast på grunn av en OS-feil. Omgå det med et stygt triks ved å aktivere denne funksjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg vastgelopen tooltips.\nAls je iTerm2 met een sneltoets verbergt terwijl een tooltip vervaagt, blijft die hangen door een bug in het besturingssysteem. Omzeil dit met een lelijke hack door deze functie in te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywaj zablokowane podpowiedzi.\nGdy ukrywasz iTerm2 klawiszem skrótu, podczas gdy podpowiedź zanika, zostaje ona zablokowana z powodu błędu systemu. Obejdź to brzydkim trikiem, włączając tę funkcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar dicas travadas.\nQuando você oculta o iTerm2 usando uma hotkey enquanto uma dica está desaparecendo, ela fica travada por causa de um bug do sistema. Contorne isso com um hack desagradável ativando este recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать зависшие подсказки.\nКогда вы скрываете iTerm2 горячей клавишей во время затухания подсказки, она зависает из-за ошибки ОС. Обойдите это неприятным хаком, включив эту функцию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skryť zaseknuté popisy.\nKeď skryjete iTerm2 aktivačnou skratkou, zatiaľ čo popis mizne, kvôli chybe systému sa zasekne. Zapnutím tejto funkcie to obídete škaredým trikom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrij zataknjene nasvete orodij.\nKo iTerm2 skrijete s hitro tipko, medtem ko nasvet orodja bledi, se zaradi napake v OS zatakne. Obidite jo z grdim trikom z omogočitvijo te funkcije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göm fastnade verktygstips.\nNär du gömmer iTerm2 med en snabbtangent medan ett verktygstips tonas ut fastnar det på grund av ett fel i operativsystemet. Kringgå det med ett fult hack genom att aktivera den här funktionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takılı kalan araç ipuçlarını gizle.\nBir araç ipucu kaybolurken iTerm2’yi kısayol tuşuyla gizlerseniz işletim sistemi hatası nedeniyle takılı kalır. Bu özelliği etkinleştirerek çirkin bir yöntemle bunu aşın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn chú giải bị kẹt.\nKhi bạn ẩn iTerm2 bằng phím nóng trong lúc một chú giải đang mờ dần, nó bị kẹt do lỗi của hệ điều hành. Bật tính năng này để khắc phục bằng một thủ thuật không đẹp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏卡住的工具提示。\n当工具提示正在消失时通过热键隐藏iTerm2，由于操作系统缺陷会导致工具提示卡住。可通过启用此功能来作为变通方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏卡住的工具提示。\n當工具提示正在淡出時，你以全域快速鍵隱藏 iTerm2，工具提示會因為系統錯誤而卡住。啟用此功能可用一個醜陋的方法繞過這個問題。"
          }
        }
      }
    },
    "AdvancedSetting.highVisibility" : {
      "comment" : "Advanced setting: highVisibility",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režimy vysokého kontrastu maximalizují viditelnost.\nPokud je zapnuto, tmavý motiv s vysokým kontrastem klade důraz na viditelnost před krásou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilstande med høj kontrast maksimerer synligheden.\nNår det er slået til, prioriterer det mørke højkontrasttema synlighed over skønhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High-Contrast-Modi maximieren die Sichtbarkeit.\nWenn aktiviert, legt das dunkle High-Contrast-Design mehr Wert auf Sichtbarkeit als auf Optik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High Contrast modes maximize visibility.\nWhen enabled, the dark high-contrast theme emphasizes visibility over beauty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modos de alto contraste maximizan la visibilidad.\nSi se activa, el tema oscuro de alto contraste da prioridad a la visibilidad sobre la estética."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korkean kontrastin tilat maksimoivat näkyvyyden.\nKun tämä on käytössä, tumma korkean kontrastin teema painottaa näkyvyyttä kauneuden sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modes Contraste élevé maximisent la visibilité.\nSi cette option est activée, le thème sombre à contraste élevé privilégie la visibilité sur l’esthétique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modalità ad alto contrasto massimizzano la visibilità.\nSe abilitato, il tema scuro ad alto contrasto privilegia la visibilità rispetto all’estetica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイコントラストモードで視認性を最大化します。\n有効にすると、ダークハイコントラストテーマは美しさよりも視認性を重視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고대비 모드로 가시성 극대화\n켜면 다크 고대비 테마가 미관보다 가시성을 우선합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høykontrastmoduser maksimerer synlighet.\nNår dette er aktivert, legger det mørke høykontrasttemaet vekt på synlighet framfor skjønnhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modi met hoog contrast maximaliseren de zichtbaarheid.\nAls dit is ingeschakeld, geeft het donkere thema met hoog contrast voorrang aan zichtbaarheid boven schoonheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryby wysokiego kontrastu maksymalizują widoczność.\nPo włączeniu ciemny motyw wysokiego kontrastu stawia widoczność ponad urodę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modos de Alto Contraste maximizam a visibilidade.\nQuando ativado, o tema escuro de alto contraste enfatiza a visibilidade em vez da beleza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режимы High Contrast максимизируют видимость.\nПри включении тёмная тема высокой контрастности делает упор на видимость, а не на красоту."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režimy vysokého kontrastu maximalizujú viditeľnosť.\nAk je zapnuté, tmavá téma s vysokým kontrastom uprednostňuje viditeľnosť pred krásou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načini visokega kontrasta povečajo vidnost.\nČe je omogočeno, temna tema visokega kontrasta daje prednost vidnosti pred lepoto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägena med hög kontrast maximerar synligheten.\nNär detta är aktiverat prioriterar det mörka temat med hög kontrast synlighet framför skönhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek Karşıtlık modları görünürlüğü en üst düzeye çıkarır.\nEtkinleştirildiğinde koyu yüksek karşıtlık teması güzellik yerine görünürlüğü vurgular."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chế độ Độ tương phản cao tối đa hóa khả năng nhìn thấy.\nKhi bật, chủ đề tối tương phản cao ưu tiên khả năng nhìn thấy hơn vẻ đẹp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高对比度模式可提升可见度。\n启用后，深色高对比度主题会更注重显示效果而非美观性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高對比模式將可見度最大化。\n啟用後，深色高對比主題會以可見度優先於美觀。"
          }
        }
      }
    },
    "AdvancedSetting.holdScreenDuringPromptRepaint" : {
      "comment" : "Advanced setting: holdScreenDuringPromptRepaint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadále zobrazovat obrazovku v původní podobě, zatímco shell překresluje svou výzvu?\nNěkteré řádkové editory, například ten v nushellu, překreslují výzvu a příkazový řádek při každém stisku klávesy. Pokud je zapnuto, iTerm2 do dokončení překreslení vykresluje obrazovku v původní podobě, aby příkaz neblikal."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bliv ved med at vise skærmen, som den var, mens shellen gentegner sin prompt?\nNogle linjeeditorer, f.eks. nushells, gentegner prompten og kommandolinjen ved hvert tastetryk. Når det er slået til, bliver iTerm2 ved med at tegne skærmen, som den var, indtil gentegningen er færdig, så kommandoen ikke blinker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Bildschirm unverändert anzeigen, während die Shell ihren Prompt neu zeichnet?\nManche Zeileneditoren, etwa der von nushell, zeichnen den Prompt und die Befehlszeile bei jedem Tastendruck neu. Wenn aktiviert, zeigt iTerm2 den Bildschirm im vorherigen Zustand an, bis das Neuzeichnen abgeschlossen ist, damit der Befehl nicht flackert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep showing the screen as it was while the shell redraws its prompt?\nSome line editors, such as nushell’s, redraw the prompt and command line on every keystroke. When enabled, iTerm2 keeps drawing the screen as it was until the redraw finishes so the command doesn’t blink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguir mostrando la pantalla tal como estaba mientras el shell redibuja su prompt?\nAlgunos editores de línea, como el de nushell, redibujan el prompt y la línea de comandos con cada pulsación de tecla. Si se activa, iTerm2 sigue dibujando la pantalla tal como estaba hasta que termina el redibujado, para que el comando no parpadee."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytetäänkö näyttö ennallaan, kun komentotulkki piirtää kehotteensa uudelleen?\nJotkin rivieditorit, kuten nushellin, piirtävät kehotteen ja komentorivin uudelleen jokaisella näppäinpainalluksella. Kun tämä on käytössä, iTerm2 jatkaa näytön piirtämistä ennallaan, kunnes uudelleenpiirto on valmis, jotta komento ei vilku."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer d’afficher l’écran tel qu’il était pendant que le shell redessine son invite ?\nCertains éditeurs de ligne, comme celui de nushell, redessinent l’invite et la ligne de commande à chaque frappe. Si cette option est activée, iTerm2 continue d’afficher l’écran tel qu’il était jusqu’à la fin du redessin, pour que la commande ne clignote pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuare a mostrare lo schermo com’era mentre la shell ridisegna il prompt?\nAlcuni editor di riga, come quello di nushell, ridisegnano il prompt e la riga di comando a ogni pressione di un tasto. Se abilitato, iTerm2 continua a disegnare lo schermo com’era finché il ridisegno non termina, così il comando non lampeggia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルがプロンプトを再描画している間、画面を以前のまま表示し続けますか？\nnushell のものなど、一部のラインエディタはキーを押すたびにプロンプトとコマンドラインを再描画します。有効にすると、再描画が終わるまで iTerm2 は以前の画面を表示し続けるため、コマンドがちらつきません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸이 프롬프트를 다시 그리는 동안 화면을 이전 상태로 계속 표시하겠습니까?\nnushell의 것과 같은 일부 줄 편집기는 키를 누를 때마다 프롬프트와 명령줄을 다시 그립니다. 켜면 다시 그리기가 끝날 때까지 iTerm2가 이전 화면을 계속 표시하므로 명령이 깜박이지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsette å vise skjermen som den var mens skallet tegner ledeteksten på nytt?\nNoen linjeredigerere, som den i nushell, tegner ledeteksten og kommandolinjen på nytt ved hvert tastetrykk. Når dette er aktivert, fortsetter iTerm2 å tegne skjermen som den var til omtegningen er ferdig, slik at kommandoen ikke blinker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scherm blijven tonen zoals het was terwijl de shell de prompt opnieuw tekent?\nSommige regeleditors, zoals die van nushell, tekenen de prompt en opdrachtregel bij elke toetsaanslag opnieuw. Als dit is ingeschakeld, blijft iTerm2 het scherm tekenen zoals het was totdat het opnieuw tekenen klaar is, zodat het commando niet knippert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal pokazywać ekran w dotychczasowej postaci, gdy powłoka przerysowuje znak zachęty?\nNiektóre edytory wiersza, np. w nushell, przerysowują znak zachęty i wiersz poleceń przy każdym naciśnięciu klawisza. Po włączeniu iTerm2 nadal rysuje ekran w dotychczasowej postaci do zakończenia przerysowania, aby polecenie nie migało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar mostrando a tela como estava enquanto o shell redesenha o prompt?\nAlguns editores de linha, como o do nushell, redesenham o prompt e a linha de comando a cada tecla. Quando ativado, o iTerm2 continua mostrando a tela como estava até o redesenho terminar, para que o comando não pisque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать экран в прежнем виде, пока оболочка перерисовывает приглашение?\nНекоторые редакторы строки, например в nushell, перерисовывают приглашение и командную строку при каждом нажатии клавиши. Если параметр включён, iTerm2 показывает прежнее содержимое экрана, пока перерисовка не закончится, чтобы команда не мигала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovať obrazovku v pôvodnom stave, kým shell prekresľuje výzvu?\nNiektoré riadkové editory, napríklad v nushell, prekresľujú výzvu a príkazový riadok pri každom stlačení klávesu. Ak je zapnuté, iTerm2 kreslí obrazovku v pôvodnom stave, kým sa prekreslenie nedokončí, aby príkaz neblikal."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še naprej prikazuj zaslon, kakršen je bil, medtem ko lupina ponovno riše svoj ukazni poziv?\nNekateri vrstični urejevalniki, kot je nushell, ob vsaki tipki ponovno narišejo ukazni poziv in ukazno vrstico. Če je omogočeno, iTerm2 riše zaslon, kakršen je bil, dokler se ponovno risanje ne konča, da ukaz ne utripa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt visa skärmen som den var medan skalet ritar om sin prompt?\nVissa radredigerare, som nushells, ritar om prompten och kommandoraden vid varje tangenttryckning. När detta är aktiverat fortsätter iTerm2 att rita skärmen som den var tills omritningen är klar så att kommandot inte blinkar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk istemini yeniden çizerken ekran eski haliyle gösterilmeye devam edilsin mi?\nnushell gibi bazı satır düzenleyiciler her tuş vuruşunda istemi ve komut satırını yeniden çizer. Etkinleştirildiğinde iTerm2, komutun yanıp sönmemesi için yeniden çizim bitene kadar ekranı eski haliyle çizmeyi sürdürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếp tục hiển thị màn hình như cũ trong lúc shell vẽ lại dấu nhắc?\nMột số trình soạn dòng, như của nushell, vẽ lại dấu nhắc và dòng lệnh mỗi lần gõ phím. Khi bật, iTerm2 tiếp tục vẽ màn hình như cũ cho đến khi việc vẽ lại hoàn tất để lệnh không nhấp nháy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 shell 重绘提示符时继续显示原来的屏幕内容？\n某些行编辑器（例如 nushell 的）会在每次按键时重绘提示符和命令行。启用后，iTerm2 会在重绘完成前继续显示原来的屏幕内容，使命令不会闪烁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 重繪提示符號時，持續顯示原本的螢幕？\n某些行編輯器（例如 nushell 的）會在每次按鍵時重繪提示符號和命令列。啟用後，iTerm2 會持續繪製原本的螢幕直到重繪完成，使指令不致閃爍。"
          }
        }
      }
    },
    "AdvancedSetting.honorBidiSupportModeEscapeSequence" : {
      "comment" : "Advanced setting: honorBidiSupportModeEscapeSequence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechat aplikace řídit řazení zprava doleva pomocí escape sekvencí BDSM a SCP?\nNěkteré aplikace na celou obrazovku rozvrhují vlastní text a přeřazení jej rozhází. Když je to zapnuto, text zapsaný po CSI 8 l (explicitní režim) zůstane beze změny a CSI 8 h (implicitní režim, výchozí) přeřazení zase zapne. CSI 1 SP k a CSI 2 SP k nastaví základní směr přeřazených řádků zleva doprava nebo zprava doleva a CSI 0 SP k obnoví výchozí hodnotu. Vyžaduje podporu textu zprava doleva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad apps styre omarrangering fra højre mod venstre med escapesekvenserne BDSM og SCP?\nNogle fuldskærmsapps opbygger selv deres tekst og bliver forvansket af omarrangering. Når dette er slået til, efterlades tekst skrevet efter CSI 8 l (eksplicit tilstand) uændret, og CSI 8 h (implicit tilstand, standard) slår omarrangering til igen. CSI 1 SP k og CSI 2 SP k sætter grundretningen for omarrangerede linjer til venstre mod højre eller højre mod venstre, og CSI 0 SP k gendanner standarden. Kræver understøttelse af tekst fra højre mod venstre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps die Steuerung der Rechts-nach-links-Neuanordnung über die Escape-Sequenzen BDSM und SCP erlauben?\nManche Vollbildanwendungen gestalten ihren Text selbst und werden durch die Neuanordnung durcheinandergebracht. Wenn diese Option aktiviert ist, bleibt Text, der nach CSI 8 l (expliziter Modus) geschrieben wird, unverändert, und CSI 8 h (impliziter Modus, die Standardeinstellung) schaltet die Neuanordnung wieder ein. CSI 1 SP k und CSI 2 SP k setzen die Grundrichtung neu angeordneter Zeilen auf links-nach-rechts bzw. rechts-nach-links, und CSI 0 SP k stellt die Standardeinstellung wieder her. Erfordert Unterstützung für Rechts-nach-links-Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Let apps control right-to-left reordering with the BDSM and SCP escape sequences?\nSome full-screen apps lay out their own text and are scrambled by reordering. When this is on, text written after CSI 8 l (explicit mode) is left as is, and CSI 8 h (implicit mode, the default) turns reordering back on. CSI 1 SP k and CSI 2 SP k set the base direction of reordered lines to left-to-right or right-to-left, and CSI 0 SP k restores the default. Requires right-to-left text support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que las apps controlen el reordenamiento de derecha a izquierda con las secuencias de escape BDSM y SCP?\nAlgunas apps a pantalla completa distribuyen su propio texto y el reordenamiento lo desordena. Si esto está activado, el texto escrito después de CSI 8 l (modo explícito) se deja tal cual, y CSI 8 h (modo implícito, el predeterminado) vuelve a activar el reordenamiento. CSI 1 SP k y CSI 2 SP k establecen la dirección base de las líneas reordenadas de izquierda a derecha o de derecha a izquierda, y CSI 0 SP k restablece el valor predeterminado. Requiere el soporte de texto de derecha a izquierda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annetaanko sovellusten ohjata oikealta vasemmalle -uudelleenjärjestystä BDSM- ja SCP-escape-sarjoilla?\nJotkin koko näytön sovellukset asettelevat tekstinsä itse, ja uudelleenjärjestys sotkee ne. Kun tämä on päällä, CSI 8 l:n (eksplisiittinen tila) jälkeen kirjoitettu teksti jätetään ennalleen, ja CSI 8 h (implisiittinen tila, oletus) ottaa uudelleenjärjestyksen takaisin käyttöön. CSI 1 SP k ja CSI 2 SP k asettavat uudelleenjärjestettyjen rivien perussuunnan vasemmalta oikealle tai oikealta vasemmalle, ja CSI 0 SP k palauttaa oletuksen. Vaatii oikealta vasemmalle -tekstin tuen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser les apps contrôler le réordonnancement de droite à gauche avec les séquences d’échappement BDSM et SCP ?\nCertaines apps en plein écran organisent leur propre texte et sont perturbées par le réordonnancement. Si cette option est activée, le texte écrit après CSI 8 l (mode explicite) est laissé tel quel, et CSI 8 h (mode implicite, par défaut) réactive le réordonnancement. CSI 1 SP k et CSI 2 SP k définissent le sens de base des lignes réordonnées de gauche à droite ou de droite à gauche, et CSI 0 SP k rétablit la valeur par défaut. Nécessite la prise en charge du texte de droite à gauche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire alle app di controllare il riordino da destra a sinistra con le sequenze di escape BDSM e SCP?\nAlcune app a tutto schermo dispongono da sole il proprio testo e il riordino le scompone. Se attivo, il testo scritto dopo CSI 8 l (modalità esplicita) viene lasciato così com’è, e CSI 8 h (modalità implicita, quella predefinita) riattiva il riordino. CSI 1 SP k e CSI 2 SP k impostano la direzione di base delle righe riordinate da sinistra a destra o da destra a sinistra, e CSI 0 SP k ripristina quella predefinita. Richiede il supporto per il testo da destra a sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BDSM および SCP エスケープシーケンスで、アプリが右から左への並べ替えを制御できるようにしますか?\n一部のフルスクリーンアプリは自身でテキストをレイアウトしており、並べ替えによって表示が崩れます。これをオンにすると、CSI 8 l (明示モード) の後に書き込まれたテキストはそのまま表示され、CSI 8 h (暗黙モード、デフォルト) で並べ替えが再び有効になります。CSI 1 SP k と CSI 2 SP k は並べ替えられる行の基本方向をそれぞれ左から右、右から左に設定し、CSI 0 SP k はデフォルトに戻します。右から左のテキストサポートが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 BDSM 및 SCP 이스케이프 시퀀스로 오른쪽에서 왼쪽 재정렬을 제어하도록 허용합니까?\n일부 전체 화면 앱은 텍스트를 직접 배치하므로 재정렬하면 텍스트가 뒤섞입니다. 이 설정이 켜져 있으면 CSI 8 l(명시적 모드) 이후에 쓰인 텍스트는 그대로 유지되고, CSI 8 h(암시적 모드, 기본값)는 재정렬을 다시 켭니다. CSI 1 SP k 및 CSI 2 SP k는 재정렬된 줄의 기본 방향을 각각 왼쪽에서 오른쪽 또는 오른쪽에서 왼쪽으로 설정하고, CSI 0 SP k는 기본값을 복원합니다. 오른쪽에서 왼쪽 텍스트 지원이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La apper styre omorganisering fra høyre mot venstre med escape-sekvensene BDSM og SCP?\nNoen fullskjermapper legger ut sin egen tekst og blir rotete av omorganisering. Når dette er aktivert, blir tekst skrevet etter CSI 8 l (eksplisitt modus) stående som den er, og CSI 8 h (implisitt modus, standard) slår omorganiseringen på igjen. CSI 1 SP k og CSI 2 SP k setter grunnretningen for omorganiserte linjer til venstre mot høyre eller høyre mot venstre, og CSI 0 SP k gjenoppretter standarden. Krever støtte for tekst fra høyre mot venstre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps het herschikken van rechts naar links laten besturen met de escapereeksen BDSM en SCP?\nSommige apps op het volledige scherm bepalen hun eigen tekstindeling en raken door herschikken in de war. Als dit is ingeschakeld, blijft tekst die na CSI 8 l (expliciete modus) wordt geschreven ongewijzigd, en schakelt CSI 8 h (impliciete modus, de standaard) het herschikken weer in. CSI 1 SP k en CSI 2 SP k stellen de basisrichting van herschikte regels in op links-naar-rechts of rechts-naar-links, en CSI 0 SP k herstelt de standaard. Vereist ondersteuning voor tekst van rechts naar links."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwolić aplikacjom sterować zmianą kolejności tekstu od prawej do lewej za pomocą sekwencji ucieczki BDSM i SCP?\nNiektóre aplikacje pełnoekranowe same układają swój tekst i zmiana kolejności je rozsypuje. Gdy włączone, tekst zapisany po CSI 8 l (tryb jawny) pozostaje bez zmian, a CSI 8 h (tryb niejawny, domyślny) ponownie włącza zmianę kolejności. CSI 1 SP k i CSI 2 SP k ustawiają bazowy kierunek wierszy po zmianie kolejności na od lewej do prawej lub od prawej do lewej, a CSI 0 SP k przywraca domyślny. Wymaga obsługi tekstu pisanego od prawej do lewej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que apps controlem a reordenação da direita para a esquerda com as sequências de escape BDSM e SCP?\nAlguns apps de tela cheia organizam o próprio texto e ficam embaralhados com a reordenação. Quando esta opção está ativada, o texto escrito após CSI 8 l (modo explícito) é mantido como está, e CSI 8 h (modo implícito, o padrão) reativa a reordenação. CSI 1 SP k e CSI 2 SP k definem a direção base das linhas reordenadas como da esquerda para a direita ou da direita para a esquerda, e CSI 0 SP k restaura o padrão. Requer suporte a texto da direita para a esquerda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить приложениям управлять переупорядочиванием текста справа налево с помощью escape-последовательностей BDSM и SCP?\nНекоторые полноэкранные приложения сами располагают свой текст, и переупорядочивание его искажает. Если этот параметр включён, текст, выведенный после CSI 8 l (явный режим), остаётся без изменений, а CSI 8 h (неявный режим, по умолчанию) снова включает переупорядочивание. CSI 1 SP k и CSI 2 SP k задают базовое направление переупорядочиваемых строк слева направо или справа налево, а CSI 0 SP k восстанавливает значение по умолчанию. Требуется поддержка текста справа налево."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechať apky ovládať zmenu poradia sprava doľava pomocou escape sekvencií BDSM a SCP?\nNiektoré apky na celej obrazovke rozmiestňujú vlastný text a zmena poradia ho pomieša. Keď je zapnuté, text zapísaný po CSI 8 l (explicitný režim) zostane nezmenený a CSI 8 h (implicitný režim, predvolený) zmenu poradia opäť zapne. CSI 1 SP k a CSI 2 SP k nastavia základný smer riadkov so zmeneným poradím zľava doprava alebo sprava doľava a CSI 0 SP k obnoví predvolený. Vyžaduje podporu textu sprava doľava."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naj aplikacije z ubežnima zaporedjema BDSM in SCP nadzirajo preurejanje od desne proti levi?\nNekatere celozaslonske aplikacije same postavijo svoje besedilo in jih preurejanje pomeša. Ko je to vklopljeno, je besedilo, zapisano po CSI 8 l (eksplicitni način), pustjeno takšno, kot je, CSI 8 h (implicitni način, privzeto) pa preurejanje spet vklopi. CSI 1 SP k in CSI 2 SP k nastavita osnovno smer preurejenih vrstic na levo proti desni oziroma desno proti levi, CSI 0 SP k pa obnovi privzeto. Zahteva podporo za besedilo od desne proti levi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låta appar styra omordning av höger-till-vänster med escapesekvenserna BDSM och SCP?\nVissa helskärmsappar lägger ut sin egen text och blir rörigare av omordning. När detta är på lämnas text som skrivs efter CSI 8 l (explicit läge) som den är, och CSI 8 h (implicit läge, förval) slår på omordning igen. CSI 1 SP k och CSI 2 SP k anger grundriktningen för omordnade rader till vänster-till-höger eller höger-till-vänster, och CSI 0 SP k återställer förvalet. Kräver stöd för höger-till-vänster-text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar sağdan sola yeniden sıralamayı BDSM ve SCP kaçış dizileriyle denetleyebilsin mi?\nBazı tam ekran uygulamalar kendi metnini yerleştirir ve yeniden sıralamayla bozulur. Bu açıkken CSI 8 l (açık mod) sonrasında yazılan metin olduğu gibi bırakılır, CSI 8 h (örtük mod, varsayılan) yeniden sıralamayı tekrar açar. CSI 1 SP k ve CSI 2 SP k, yeniden sıralanan satırların temel yönünü soldan sağa veya sağdan sola ayarlar; CSI 0 SP k varsayılanı geri yükler. Sağdan sola metin desteği gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép ứng dụng điều khiển việc sắp xếp lại từ phải sang trái bằng chuỗi thoát BDSM và SCP?\nMột số ứng dụng toàn màn hình tự bố trí văn bản của chúng và bị xáo trộn khi sắp xếp lại. Khi bật, văn bản được ghi sau CSI 8 l (chế độ tường minh) được giữ nguyên, và CSI 8 h (chế độ ngầm định, mặc định) bật lại việc sắp xếp. CSI 1 SP k và CSI 2 SP k đặt hướng cơ sở của các dòng được sắp xếp lại thành trái sang phải hoặc phải sang trái, và CSI 0 SP k khôi phục mặc định. Yêu cầu hỗ trợ văn bản từ phải sang trái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许应用通过 BDSM 和 SCP 转义序列控制从右到左的重新排序吗？\n某些全屏应用会自行排列文本，重新排序会使其显示错乱。开启此选项后，在 CSI 8 l（显式模式）之后写入的文本将保持原样，而 CSI 8 h（隐式模式，默认）会重新开启重新排序。CSI 1 SP k 和 CSI 2 SP k 分别将重新排序行的基本方向设为从左到右或从右到左，CSI 0 SP k 则恢复默认值。需要支持从右到左的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 App 使用 BDSM 和 SCP 跳脫序列控制由右至左的重新排列？\n某些全螢幕 App 會自行安排文字，重新排列會使其錯亂。開啟後，CSI 8 l（明確模式）之後寫入的文字會維持原樣，而 CSI 8 h（隱含模式，預設）會重新開啟重新排列。CSI 1 SP k 和 CSI 2 SP k 會將重新排列之行的基準方向設為由左至右或由右至左，CSI 0 SP k 則會回復預設值。需要由右至左文字支援。"
          }
        }
      }
    },
    "AdvancedSetting.horizontalScrollingSensitivity" : {
      "comment" : "Advanced setting: horizontalScrollingSensitivity",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
