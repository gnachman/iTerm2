    "AIConnectionTester.ReviewPlaceholder" : {
      "comment" : "Result of the AI connection test when the App Review placeholder key is configured",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se zástupný klíč: odpovědi AI jsou simulovány pro kontrolu App Review a nekontaktuje se žádná externí služba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pladsholdernøgle i brug: AI-svar simuleres til App Review, og der kontaktes ingen ekstern tjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzhalterschlüssel in Verwendung: KI-Antworten werden für die App-Überprüfung simuliert, es wird kein externer Dienst kontaktiert."
          }
        },
        "en" : {
