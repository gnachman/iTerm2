    "Tip.0008.Body" : {
      "comment" : "Tip of the day body, id 0008",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Profilumschaltung wechselt das aktuelle Profil, wenn sich Benutzername, Hostname oder Verzeichnis ändert. Richten Sie sie unter „Einstellungen > Profile > Erweitert“ ein. Dafür muss die Shell-Integration installiert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatic Profile Switching changes the current profile when the username, hostname, or directory changes. Set it up in “Settings > Profiles > Advanced.” It requires Shell Integration to be installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio automático de perfil cambia el perfil actual cuando cambia el nombre de usuario, el nombre de host o el directorio. Configúralo en “Ajustes > Perfiles > Avanzado”. Requiere tener instalada la integración con el shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement automatique de profil modifie le profil actuel lorsque le nom d’utilisateur, le nom d’hôte ou le répertoire change. Configurez-le dans « Réglages > Profils > Avancé ». L’intégration du shell doit être installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cambio automatico del profilo cambia il profilo corrente quando cambiano il nome utente, il nome host o la directory. Configuralo in “Impostazioni > Profili > Avanzate”. Richiede che l’integrazione shell sia installata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動プロファイル切り替えは、ユーザー名、ホスト名、ディレクトリが変わると現在のプロファイルを切り替えます。「設定 > プロファイル > 詳細」で設定してください。シェル統合がインストールされている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 프로파일 전환은 사용자 이름, 호스트 이름 또는 디렉토리가 바뀌면 현재 프로파일을 변경합니다. “설정 > 프로파일 > 고급”에서 설정하십시오. 셸 통합이 설치되어 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Troca automática de perfil altera o perfil atual quando o nome de usuário, o nome de host ou o diretório mudam. Configure em “Ajustes > Perfis > Avançado”. Requer a instalação da Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматическое переключение профилей меняет текущий профиль при изменении имени пользователя, имени узла или каталога. Настройте это в «Настройки > Профили > Дополнительно». Для этого требуется установленный Shell Integration."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik Profil Değiştirme, kullanıcı adı, ana makine adı veya dizin değiştiğinde geçerli profili değiştirir. “Ayarlar > Profiller > Gelişmiş” bölümünde ayarlayın. Kabuk Entegrasyonu’nun yüklü olması gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动配置文件切换会在用户名、主机名或目录发生变化时更改当前配置文件。可在“设置 > 配置文件 > 高级”中配置此功能，需安装Shell集成组件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動切換描述檔」會在使用者名稱、主機名稱或目錄改變時，切換目前的描述檔。你可以在「設定 > 描述檔 > 進階」中設定。需要安裝 Shell 整合。"
          }
        }
      }
    },
