            "value" : "Akıllı seçime dahil edilecek, tıklama konumundan önceki ve sonraki azami satır sayısı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dòng tối đa trước và sau vị trí bấm để đưa vào chọn thông minh."
