    "AdvancedSetting.darkThemeHasBlackTitlebar" : {
      "comment" : "Advanced setting: darkThemeHasBlackTitlebar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkle Designs geben Terminalfenstern standardmäßig schwarze Titelleisten."
          }
        },
        "en" : {
          "stringUnit" : {
