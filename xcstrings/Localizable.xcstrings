    "AdvancedSetting.pinEditSession" : {
      "comment" : "Advanced setting: pinEditSession",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenster „Sitzung bearbeiten“ an die ursprünglich bearbeitete Sitzung anheften.\nWenn nicht gesetzt, wirkt es sich auf die zuletzt aktive Sitzung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin Edit Session window to the session it originally edited.\nIf not set, it will affect the most recently active session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija la ventana Editar sesión a la sesión que editó originalmente.\nSi no se activa, afectará a la sesión activa más recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épingler la fenêtre Modifier la session à la session qu’elle a modifiée à l’origine.\nSi ce réglage est désactivé, elle affectera la session la plus récemment active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa la finestra Modifica sessione alla sessione che aveva modificato in origine.\nSe non è attivo, interesserà la sessione attiva più di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit Sessionウィンドウを、それが元々編集していたセッションに固定する。\n設定しない場合、最後にアクティブだったセッションに影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 편집 윈도우를 원래 편집하던 세션에 고정합니다.\n설정하지 않으면 가장 최근에 활성화된 세션에 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixar a janela Editar sessão na sessão que ela editou originalmente.\nSe não estiver definido, afetará a sessão ativa mais recente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закреплять окно редактирования сеанса за тем сеансом, для которого оно было открыто изначально.\nЕсли параметр выключен, окно будет применяться к последнему активному сеансу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumu Düzenle penceresini, başlangıçta düzenlediği oturuma sabitle.\nAyarlanmazsa en son etkin olan oturumu etkiler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将“编辑会话”窗口重新定位到其原始编辑的会话。\n如果未设置，则影响最近活动的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將「編輯工作階段」視窗釘選到它最初編輯的工作階段。\n如果未設定，則會影響最近活躍的工作階段。"
          }
        }
      }
    },
