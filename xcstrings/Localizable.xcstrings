    "AdvancedSetting.oscColorReport16Bits" : {
      "comment" : "Advanced setting: oscColorReport16Bits",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16-Bit-Farbwerte für OSC 4 und 10 bis 19 melden.\nUmgeht einen Fehler in älteren Versionen von vim, bei denen 8-Bit-Werte nicht korrekt verarbeitet werden konnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Report 16-bit color values to OSC 4 and 10 through 19.\nWorks around a bug in older vim where they could not properly parse 8-bit values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa de valores de color de 16 bits para OSC 4 y 10 a 19.\nEvita un error de versiones antiguas de vim que no podían analizar correctamente valores de 8 bits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler des valeurs de couleur 16 bits pour OSC 4 et 10 à 19.\nContourne un bogue des anciennes versions de vim qui ne savaient pas analyser correctement les valeurs 8 bits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala valori di colore a 16 bit per OSC 4 e da 10 a 19.\nAggira un bug delle versioni meno recenti di vim che non riuscivano ad analizzare correttamente i valori a 8 bit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4および10〜19に対して16ビットのカラー値を報告する。\n古いvimが8ビット値を正しく解析できないバグの回避策です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4 및 10~19에 16비트 색상 값을 리포팅.\n8비트 값을 제대로 파싱하지 못하는 이전 vim의 버그를 우회합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar valores de cor de 16 bits para OSC 4 e 10 a 19.\nContorna um bug em versões antigas do vim onde não conseguiam analisar corretamente valores de 8 bits."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщать 16-битные значения цвета в ответ на OSC 4 и с 10 по 19.\nОбходит ошибку в старых версиях vim, которые не могли корректно разбирать 8-битные значения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4 ve 10 ile 19 için 16 bit renk değerleri raporla.\nEski vim sürümlerindeki 8 bit değerleri doğru ayrıştıramama hatasına geçici çözümdür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 16 位颜色值报告给 OSC 4 和 10-19。\n解决了旧版 vim 中的一个问题，因为该版本无法正确解析 8 位值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 OSC 4 和 10 到 19 回報 16 位元顏色值。\n用於解決舊版 vim 無法正確解析 8 位元值的錯誤。"
          }
        }
      }
    },
    "AdvancedSetting.p3" : {
      "comment" : "Advanced setting: p3",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3 als Standardfarbraum verwenden? Bei „Nein“ wird sRGB verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use P3 as default color space? If No, sRGB will be used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar P3 como espacio de color predeterminado? Si es No, se usará sRGB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser P3 comme espace colorimétrique par défaut ? Si Non, sRGB sera utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usare P3 come spazio colore predefinito? Se No, verrà usato sRGB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのカラースペースとしてP3を使用するか？「いいえ」の場合はsRGBが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3를 기본 색 공간으로 사용하겠습니까? 아니요인 경우 sRGB가 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar P3 como espaço de cor padrão? Se Não, será usado o sRGB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать P3 как цветовое пространство по умолчанию? Если нет, будет использоваться sRGB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan renk alanı olarak P3 kullanılsın mı? Hayır ise sRGB kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 P3 作为默认颜色空间？如果否，则使用 sRGB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 P3 作為預設色彩空間？如果為否，則使用 sRGB。"
          }
        }
      }
    },
    "AdvancedSetting.paneTitleBarBackgroundColor" : {
      "comment" : "Advanced setting: paneTitleBarBackgroundColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Hintergrundfarbe für Bereichstitelleisten. Leer lassen, um die Standardfarbe zu verwenden.\nDies sollte eine Farbe im HTML-Stil sein, zum Beispiel #aabbcc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom background color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color de fondo personalizado para las barras de título de los paneles. Déjalo vacío para usar el color predeterminado.\nDebe ser un color de estilo HTML, como #aabbcc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur d’arrière-plan personnalisée pour les barres de titre des volets. Laissez vide pour utiliser la couleur par défaut.\nIl doit s’agir d’une couleur de style HTML, comme #aabbcc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore di sfondo personalizzato per le barre del titolo dei riquadri. Lascia vuoto per usare il colore predefinito.\nDeve essere un colore in stile HTML, come #aabbcc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペインのタイトルバーのカスタム背景色。デフォルトの色を使用するには空欄のままにしてください。\n#aabbccのようなHTML形式の色を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널 제목 막대의 사용자 지정 배경색. 기본 색상을 사용하려면 비워 두십시오.\nHTML 스타일 색상(예: #aabbcc)이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de fundo personalizada para as barras de título dos painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский цвет фона для заголовков панелей. Оставьте пустым, чтобы использовать цвет по умолчанию.\nЦвет должен быть в HTML-формате, например #aabbcc."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölme başlık çubukları için özel arka plan rengi. Varsayılan rengi kullanmak için boş bırakın.\nBu, #aabbcc gibi HTML tarzı bir renk olmalıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗格标题栏的自定义背景颜色。留空则使用默认颜色。\n应为 HTML 风格的颜色，如 #aabbcc。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗格標題列的自訂背景顏色。留空則使用預設顏色。\n應為 HTML 風格的顏色，例如 #aabbcc。"
          }
        }
      }
    },
