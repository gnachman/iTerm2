    "SecureKeyboardEntry.WarningBody" : {
      "comment" : "Body of warning shown when secure keyboard entry is enabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die sichere Tastatureingabe ist aktiviert.\n\nUnter macOS 12 und neuer verhindert die aktivierte sichere Tastatureingabe, dass andere Programme aktiviert werden können. Dies betrifft den Befehl `open` sowie das Panel, das bei Verwendung von Touch ID für sudo angezeigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Secure keyboard entry is enabled.\n\nIn macOS 12 and later, enabling Secure Keyboard Entry prevents other programs from being activated. This affects the `open` command as well as the panel shown when using Touch ID for sudo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada segura del teclado está activada.\n\nEn macOS 12 y posteriores, activar la entrada segura del teclado impide que se activen otros programas. Esto afecta al comando `open` y al panel que se muestra al usar Touch ID para sudo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entrée clavier sécurisée est activée.\n\nDans macOS 12 et versions ultérieures, l’activation de l’entrée clavier sécurisée empêche l’activation d’autres programmes. Cela affecte la commande `open` ainsi que le panneau affiché lors de l’utilisation de Touch ID pour sudo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’inserimento sicuro da tastiera è abilitato.\n\nIn macOS 12 e versioni successive, l’abilitazione dell’inserimento sicuro da tastiera impedisce l’attivazione di altri programmi. Questo riguarda il comando `open` e la finestra mostrata quando si usa Touch ID per sudo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュアキーボード入力が有効になっています。\n\nmacOS 12以降では、セキュアキーボード入力を有効にすると、他のプログラムをアクティブにできなくなります。これは`open`コマンドや、sudoでTouch IDを使用する際に表示されるパネルにも影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 키보드 입력이 활성화되어 있습니다.\n\nmacOS 12 이상에서 보안 키보드 입력을 활성화하면 다른 프로그램이 활성화되지 않습니다. 이는 `open` 명령과 sudo에 Touch ID를 사용할 때 표시되는 패널에도 영향을 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada segura de teclado está ativada.\n\nNo macOS 12 e posterior, ativar a entrada segura de teclado impede que outros programas sejam ativados. Isso afeta o comando `open`, bem como o painel exibido ao usar o Touch ID para o sudo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безопасный ввод с клавиатуры включён.\n\nВ macOS 12 и более поздних версиях включение безопасного ввода с клавиатуры препятствует активации других программ. Это влияет на команду `open`, а также на панель, отображаемую при использовании Touch ID для sudo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli klavye girişi etkin.\n\nmacOS 12 ve sonrasında Güvenli Klavye Girişi’ni etkinleştirmek diğer programların etkinleştirilmesini engeller. Bu durum `open` komutunu ve sudo için Touch ID kullanılırken gösterilen paneli etkiler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已启用安全键盘输入。\n\n在 macOS 12 及更高版本中，启用安全键盘输入会阻止其他程序被激活。这会影响 `open` 命令以及使用 Touch ID 进行 sudo 时显示的面板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全鍵盤輸入已啟用。\n\n在 macOS 12 及更新版本中，啟用安全鍵盤輸入會使其他程式無法被啟用。這會影響 `open` 指令，以及為 sudo 使用 Touch ID 時顯示的面板。"
          }
        }
      }
    },
