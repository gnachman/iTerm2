    "ScriptsMenu.ScriptsDisabledBody" : {
      "comment" : "Warning shown when script enumeration is disabled due to slowness",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
