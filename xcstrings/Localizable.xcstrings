    "KeyMappingRepair.RepairIntro" : {
      "comment" : "Repair explanation; %lld is the number of corrupted key bindings",
      "localizations" : {
        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Budou opravena %lld přiřazení kláves poškozená chybou v dřívější verzi iTerm2. Dotčená přiřazení se nyní zobrazují nesprávně, ale fungují správně. Po opravě se budou zobrazovat správně.\n\nDotčená přiřazení kláves:"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Bude opraveno %lld přiřazení kláves poškozených chybou v dřívější verzi iTerm2. Dotčená přiřazení se nyní zobrazují nesprávně, ale fungují správně. Po opravě se budou zobrazovat správně.\n\nDotčená přiřazení kláves:"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Bude opraveno %lld přiřazení klávesy poškozené chybou v dřívější verzi iTerm2. Dotčené přiřazení se nyní zobrazuje nesprávně, ale funguje správně. Po opravě se bude zobrazovat správně.\n\nDotčené přiřazení klávesy:"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Bude opraveno %lld přiřazení kláves poškozených chybou v dřívější verzi iTerm2. Dotčená přiřazení se nyní zobrazují nesprávně, ale fungují správně. Po opravě se budou zobrazovat správně.\n\nDotčená přiřazení kláves:"
                }
              }
            }
          }
        },
        "da" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dette reparerer %lld tastetildeling, der blev beskadiget af en fejl i en tidligere version af iTerm2. Den berørte tastetildeling vises i øjeblikket forkert, men fungerer korrekt. Efter reparationen vises den korrekt.\n\nBerørt tastetildeling:"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dette reparerer %lld tastetildelinger, der blev beskadiget af en fejl i en tidligere version af iTerm2. De berørte tastetildelinger vises i øjeblikket forkert, men fungerer korrekt. Efter reparationen vises de korrekt.\n\nBerørte tastetildelinger:"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dies repariert %lld Tastenzuordnung, die durch einen Fehler in einer früheren Version von iTerm2 beschädigt wurde. Die betroffene Zuordnung wird derzeit falsch angezeigt, funktioniert aber ordnungsgemäß. Nach der Reparatur wird sie korrekt angezeigt.\n\nBetroffene Tastenzuordnung:"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dies repariert %lld Tastenzuordnungen, die durch einen Fehler in einer früheren Version von iTerm2 beschädigt wurden. Die betroffenen Zuordnungen werden derzeit falsch angezeigt, funktionieren aber ordnungsgemäß. Nach der Reparatur werden sie korrekt angezeigt.\n\nBetroffene Tastenzuordnungen:"
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "This will repair %lld key binding that was corrupted by a bug in an earlier version of iTerm2. The affected binding currently displays incorrectly but functions properly. After repair, it will display correctly.\n\nAffected key binding:"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "This will repair %lld key bindings that were corrupted by a bug in an earlier version of iTerm2. The affected bindings currently display incorrectly but function properly. After repair, they will display correctly.\n\nAffected key bindings:"
                }
              }
            }
