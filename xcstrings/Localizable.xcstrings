    "StatusBarRPC.ScriptNotRunningFormat" : {
      "comment" : "Appended to the error message when a status bar script is not running; placeholder is the existing error message",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Es sieht so aus, als würde das Skript nicht laufen. Es zu starten könnte das Problem beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@It looks like the script is not running. Launching it might fix the problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Parece que el script no se está ejecutando. Iniciarlo podría solucionar el problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Il semble que le script ne soit pas en cours d’exécution. Le lancer pourrait résoudre le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Sembra che lo script non sia in esecuzione. Avviarlo potrebbe risolvere il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@スクリプトが実行されていないようです。起動すると問題が解決する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@스크립트가 실행 중이 아닌 것 같습니다. 스크립트를 실행하면 문제가 해결될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Parece que o script não está em execução. Iniciá-lo pode resolver o problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Похоже, скрипт не запущен. Его запуск может решить проблему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@Betik çalışmıyor gibi görünüyor. Başlatmak sorunu çözebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@脚本似乎没有在运行。启动它或许可以解决问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@看起來腳本並未執行。啟動它或許能解決問題。"
          }
        }
      }
    },
