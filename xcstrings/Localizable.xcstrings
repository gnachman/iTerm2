    "OnePassword.NotFoundMessage" : {
      "comment" : "Explanation shown when the 1Password CLI is missing or too old; placeholder is the minimum required version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die 1Password-CLI konnte nicht gefunden werden oder ist älter als die erforderliche Version %@. Stellen Sie sicher, dass eine aktuelle Version von op installiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The 1Password CLI could not be found, or is older than the required version %@. Check that a current op is installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo encontrar la CLI de 1Password o es anterior a la versión requerida %@. Comprueba que esté instalada una versión actual de op."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le CLI de 1Password est introuvable ou plus ancien que la version requise %@. Vérifiez qu’une version à jour de op est installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare la CLI di 1Password, oppure è più vecchia della versione richiesta %@. Verifica che sia installata una versione recente di op."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password CLIが見つからないか、必要なバージョン%@より古いバージョンです。最新のopがインストールされていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password CLI를 찾을 수 없거나 필요한 버전 %@보다 오래되었습니다. 최신 op가 설치되어 있는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar o CLI do 1Password, ou ele é mais antigo que a versão %@ exigida. Verifique se um op atual está instalado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти CLI 1Password, либо установленная версия старше требуемой %@. Убедитесь, что установлена актуальная версия op."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password CLI bulunamadı veya gerekli %@ sürümünden eski. Güncel bir op’un yüklü olduğunu kontrol edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Password CLI 未找到，或版本低于要求%@。请检查是否安装了当前版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
