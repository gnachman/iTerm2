        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 유휴 상태이므로 현재 세션에서 GPU 렌더링이 꺼져 있습니다. 설정 > 고급에서 유휴 상태일 때도 Metal을 사용하도록 켤 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renderização por GPU está desativada na sessão atual porque a sessão está ociosa. Você pode ativar o Metal durante a ociosidade em Ajustes > Avançado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг на GPU отключён в текущем сеансе, потому что сеанс неактивен. Вы можете включить Metal в неактивном состоянии в Настройках > Дополнительно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli oturumda GPU ile işleme kapalı, çünkü oturum boşta. Metal’i boştayken “Ayarlar > Gelişmiş” bölümünden etkinleştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前会话中的 GPU 渲染已关闭，因为会话处于空闲状态。你可以在“设置 > 高级”中启用空闲时使用 Metal。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的工作階段已關閉 GPU 繪製，因為工作階段處於閒置狀態。你可以在「設定 > 進階」中啟用閒置時使用 Metal。"
          }
        }
      }
    },
