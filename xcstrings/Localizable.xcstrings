    "AdvancedSetting.placeTabsInTitlebarAccessoryInFullScreen" : {
      "comment" : "Advanced setting: placeTabsInTitlebarAccessoryInFullScreen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umístit řádek panelů do záhlaví okna v režimu celé obrazovky (pouze macOS 13+)?\nTo lze vypnout jako obejití chyby v systému macOS, kdy panely nemusí být v režimu celé obrazovky viditelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placér fanelinjen i vinduets titellinje i fuld skærm (kun macOS 13+)?\nDet kan slås fra for at omgå en fejl i macOS, hvor faner muligvis ikke er synlige i fuld skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tableiste im Vollbildmodus in der Titelleiste des Fensters platzieren (nur macOS 13+)?\nDies kann deaktiviert werden, um einen Fehler in macOS zu umgehen, bei dem Tabs im Vollbildmodus möglicherweise nicht sichtbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Place the tabbar in the window's titlebar in full screen mode (macOS 13+ only)?\nThis can be disabled to work around a bug in macOS where tabs may not be visible in full screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Colocar la barra de pestañas en la barra de título de la ventana en pantalla completa (solo macOS 13+)?\nSe puede desactivar para evitar un error de macOS por el que las pestañas pueden no verse en pantalla completa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijoitetaanko välilehtipalkki ikkunan otsikkopalkkiin koko näytön tilassa (vain macOS 13+)?\nTämän voi poistaa käytöstä, jotta kierretään macOS:n virhe, jossa välilehdet eivät välttämättä näy koko näytön tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer la barre d’onglets dans la barre de titre de la fenêtre en mode plein écran (macOS 13+ uniquement) ?\nVous pouvez le désactiver pour contourner un bogue de macOS où les onglets peuvent ne pas être visibles en plein écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizionare la barra dei pannelli nella barra del titolo della finestra a tutto schermo (solo macOS 13+)?\nPuò essere disattivato per aggirare un bug di macOS per cui i pannelli potrebbero non essere visibili a tutto schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーンモードでタブバーをウィンドウのタイトルバーに配置するか（macOS 13以降のみ）？\nmacOSにはフルスクリーン時にタブが表示されないことがあるバグがあり、この設定を無効にすることでその回避策になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면 모드에서 탭 막대를 윈도우의 제목 막대에 배치하겠습니까(macOS 13 이상 전용)?\n전체 화면에서 탭이 보이지 않을 수 있는 macOS 버그를 피하려면 이 기능을 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasser fanelinjen i vinduets tittellinje i fullskjermmodus (bare macOS 13+)?\nDette kan deaktiveres for å omgå en feil i macOS der faner kanskje ikke er synlige i fullskjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tabbladbalk in de titelbalk van het venster plaatsen in schermvullende weergave (alleen macOS 13+)?\nDit kan worden uitgeschakeld om een bug in macOS te omzeilen waarbij tabbladen in schermvullende weergave mogelijk niet zichtbaar zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy umieszczać pasek kart w pasku tytułu okna w trybie pełnoekranowym (tylko macOS 13+)?\nMożna to wyłączyć, aby obejść błąd w macOS, w którym karty mogą nie być widoczne w trybie pełnoekranowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar a barra de abas na barra de título da janela no modo de tela cheia (somente macOS 13+)?\nIsto pode ser desativado para contornar um bug no macOS onde as abas podem não ficar visíveis em tela cheia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размещать панель вкладок в строке заголовка окна в полноэкранном режиме (только macOS 13 и новее)?\nЭто можно отключить, чтобы обойти ошибку macOS, из-за которой вкладки могут быть не видны в полноэкранном режиме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umiestniť lištu s tabmi do lišty s názvom okna v režime celej obrazovky (iba macOS 13+)?\nMôžete to vypnúť ako obchádzku chyby v macOS, pri ktorej taby na celej obrazovke nemusia byť viditeľné."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se vrstica z zavihki v celozaslonskem načinu postavi v naslovno vrstico okna (samo macOS 13+)?\nTo lahko onemogočite kot zaobid napake v sistemu macOS, zaradi katere zavihki v celozaslonskem načinu morda niso vidni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera flikfältet i fönstrets titelfält i helskärmsläge (endast macOS 13+)?\nDet kan avaktiveras för att kringgå ett fel i macOS där flikar kanske inte syns i helskärmsläge."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam ekran modunda sekme çubuğu pencerenin başlık çubuğuna yerleştirilsin mi (yalnızca macOS 13+)?\nBu, macOS’taki sekmelerin tam ekranda görünmeyebildiği bir hataya geçici çözüm olarak devre dışı bırakılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt thanh tab vào thanh tiêu đề của cửa sổ ở chế độ toàn màn hình (chỉ macOS 13+)?\nCó thể tắt để khắc phục lỗi macOS khiến tab có thể không hiển thị ở chế độ toàn màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在全屏模式下将标签页栏放在窗口标题栏的位置（仅适用于 macOS 13+ 版本）？\n此功能可禁用，以解决 macOS 中标签页在全屏模式下不可见的bug。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在全螢幕模式下，將標籤頁列放在視窗標題列中（僅限 macOS 13+）？\n可停用此設定，以解決 macOS 中標籤頁在全螢幕下可能不可見的錯誤。"
          }
        }
      }
    },
    "AdvancedSetting.pollForTmuxForegroundJob" : {
      "comment" : "Advanced setting: pollForTmuxForegroundJob",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjišťovat název procesu v popředí v integraci tmux s tmux < 3.2?\nUmožňuje ikony panelů, ale může způsobit hodně provozu na pozadí. V tmux 3.2 a novějším to nemá žádný vliv, protože zjišťování není potřeba."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forespørg løbende om navnet på forgrundsprocessen i tmux-integration med tmux < 3.2?\nDet gør faneikoner mulige, men kan give meget baggrundstrafik. Det har ingen virkning i tmux 3.2 og nyere, hvor løbende forespørgsler er unødvendige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der tmux-Integration mit tmux < 3.2 den Namen des Vordergrundjobs abfragen?\nDies aktiviert Tab-Symbole, kann jedoch zu viel Hintergrundverkehr führen. Bei tmux 3.2 und höher hat dies keine Wirkung, da das Abfragen dort nicht nötig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Poll for foreground job name in tmux integration with tmux < 3.2?\nThis enables tab icons but can cause a lot of background traffic. This has no effect in tmux 3.2 and later, where polling is unnecessary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Consultar periódicamente el nombre del proceso en primer plano en la integración con tmux con tmux < 3.2?\nActiva los iconos de pestaña pero puede causar mucho tráfico en segundo plano. No tiene efecto en tmux 3.2 y posteriores, donde la consulta periódica es innecesaria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kyselläänkö etualan prosessin nimeä tmux-integraatiossa, kun tmux < 3.2?\nTämä ottaa välilehtien kuvakkeet käyttöön, mutta voi aiheuttaa paljon taustaliikennettä. Ei vaikutusta tmux 3.2:ssa ja uudemmissa, joissa kyselyä ei tarvita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interroger périodiquement le nom du processus au premier plan dans l’intégration tmux avec tmux < 3.2 ?\nCela active les icônes d’onglet mais peut générer beaucoup de trafic en arrière-plan. Sans effet avec tmux 3.2 et versions ultérieures, où l’interrogation est inutile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllare periodicamente il nome del processo in primo piano nell’integrazione tmux con tmux < 3.2?\nAttiva le icone dei pannelli ma può causare molto traffico in background. Non ha effetto in tmux 3.2 e versioni successive, dove il controllo periodico non è necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 3.2未満とのtmux統合でフォアグラウンドジョブ名をポーリングするか？\nこれによりタブアイコンが有効になりますが、バックグラウンドの通信量が多くなる場合があります。ポーリングが不要なtmux 3.2以降では効果がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 3.2 미만의 tmux 통합에서 포그라운드 작업 이름을 폴링하겠습니까?\n탭 아이콘을 사용할 수 있게 되지만 백그라운드 트래픽이 많이 발생할 수 있습니다. 폴링이 필요 없는 tmux 3.2 이상에서는 효과가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør jevnlig etter navnet på forgrunnsprosessen i tmux-integrering med tmux < 3.2?\nDette aktiverer fanesymboler, men kan gi mye bakgrunnstrafikk. Har ingen effekt i tmux 3.2 og nyere, der spørring er unødvendig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naar de naam van het voorgrondproces peilen in de tmux-integratie met tmux < 3.2?\nDit maakt tabbladsymbolen mogelijk maar kan veel achtergrondverkeer veroorzaken. Dit heeft geen effect in tmux 3.2 en later, waar peilen niet nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy odpytywać o nazwę procesu pierwszoplanowego w integracji z tmux dla tmux < 3.2?\nWłącza ikony kart, ale może powodować duży ruch w tle. Nie ma efektu w tmux 3.2 i nowszych, gdzie odpytywanie jest zbędne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultar periodicamente o nome do processo em primeiro plano na integração do tmux com tmux < 3.2?\nIsto ativa os ícones das abas, mas pode causar muito tráfego em segundo plano. Isto não tem efeito no tmux 3.2 e posterior, onde a consulta periódica é desnecessária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опрашивать имя активной задачи при интеграции с tmux версии ниже 3.2?\nЭто включает значки на вкладках, но может создавать значительный фоновый трафик. Не действует в tmux 3.2 и новее, где опрос не требуется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zisťovať názov procesu na popredí v integrácii tmux s tmux < 3.2?\nTým sa zapnú ikony tabov, ale môže to spôsobiť veľa prevádzky na pozadí. V tmux 3.2 a novšom, kde zisťovanie nie je potrebné, to nemá žiadny účinok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se pri integraciji tmux s tmux < 3.2 poizveduje o imenu procesa v ospredju?\nTo omogoči ikone zavihkov, a lahko povzroči veliko prometa v ozadju. V tmux 3.2 in novejših ni učinka, ker poizvedovanje ni potrebno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avfråga namnet på förgrundsprocessen i tmux-integrering med tmux < 3.2?\nDet aktiverar fliksymboler men kan orsaka mycket bakgrundstrafik. Det har ingen effekt i tmux 3.2 och senare, där avfrågning är onödig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux < 3.2 ile tmux entegrasyonunda ön plan işlemi adı yoklansın mı?\nBu, sekme simgelerini etkinleştirir ancak çok fazla arka plan trafiğine yol açabilir. Yoklamanın gereksiz olduğu tmux 3.2 ve sonrasında etkisi yoktur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thăm dò tên tiến trình tiền cảnh trong tích hợp tmux với tmux < 3.2?\nĐiều này bật biểu tượng tab nhưng có thể gây nhiều lưu lượng nền. Không có tác dụng với tmux 3.2 trở lên, nơi không cần thăm dò."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 与 tmux 的集成中，对前台作业名称进行轮询（<3.2版本）？\n此功能会显示标签页图标，但可能导致大量后台流量。在 tmux 3.2及更高版本中，此功能无效，因为轮询已不再必要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 3.2 以前的版本使用 tmux 整合時，輪詢前景程序名稱？\n這會啟用標籤頁圖像，但可能造成大量背景流量。在 tmux 3.2 及更新版本中不需要輪詢，因此此設定沒有作用。"
          }
        }
      }
    },
    "AdvancedSetting.postFakeFlagsChangedEvents" : {
      "comment" : "Advanced setting: postFakeFlagsChangedEvents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesílat falešné události změny modifikačních kláves při přemapování modifikačních kláves pomocí event tap.\nJe to pokus o obejití nekompatibilit s AltTab v problému 10220."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send falske flags-changed-hændelser, når kombitaster omtildeles med en event tap.\nDet er et forsøg på at omgå uforeneligheder med AltTab i issue 10220."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Umbelegen von Modifizierertasten über einen Event-Tap fingierte Flags-Changed-Ereignisse senden.\nDies ist ein Versuch, Inkompatibilitäten mit AltTab in Issue 10220 zu umgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Post fake flags-changed events when remapping modifiers with an event tap.\nThis is an attempt to work around incompatibilities with AltTab in issue 10220."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publica eventos falsos de cambio de indicadores al reasignar modificadores con un event tap.\nEs un intento de evitar incompatibilidades con AltTab en el issue 10220."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä väärennettyjä flags-changed-tapahtumia, kun muuntonäppäimiä määritetään uudelleen event tapilla.\nYritys kiertää yhteensopivuusongelmat AltTabin kanssa (issue 10220)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publier de faux événements de changement de modificateurs lors du remappage des modificateurs avec un event tap.\nTentative de contournement des incompatibilités avec AltTab (ticket 10220)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia falsi eventi di modifica dei flag quando si rimappano i tasti modificatori con un event tap.\nÈ un tentativo di aggirare le incompatibilità con AltTab nell’issue 10220."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントタップで修飾キーを再マッピングする際、疑似的なフラグ変更イベントを送信する。\nこれはissue 10220にあるAltTabとの非互換性の回避策です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트 탭으로 보조 키를 재지정할 때 가짜 flags-changed 이벤트를 게시.\n이슈 10220의 AltTab 호환성 문제를 해결하기 위한 시도입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send falske flags-changed-hendelser når spesialtaster omtilordnes med en hendelsesavlytting.\nDette er et forsøk på å omgå inkompatibilitet med AltTab i issue 10220."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats nepgebeurtenissen voor gewijzigde vlaggen bij het opnieuw toewijzen van speciale toetsen met een event tap.\nDit is een poging om incompatibiliteit met AltTab te omzeilen (issue 10220)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj fałszywe zdarzenia zmiany flag przy zmianie przypisania klawiszy modyfikujących za pomocą event tap.\nTo próba obejścia niezgodności z AltTab opisanej w zgłoszeniu 10220."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicar eventos falsos de alteração de flags ao remapear modificadores com um event tap.\nEsta é uma tentativa de contornar incompatibilidades com o AltTab no problema 10220."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлять поддельные события flags-changed при переназначении модификаторов через event tap.\nЭто попытка обойти несовместимость с AltTab, описанную в issue 10220."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odosielať falošné udalosti zmeny modifikátorov pri premapovaní modifikačných klávesov cez event tap.\nJe to pokus o obídenie nekompatibility s AltTab v issue 10220."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objavljaj lažne dogodke flags-changed pri preslikavi modifikatorjev z event tap.\nTo je poskus zaobida nezdružljivosti z AltTab v težavi 10220."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka falska flags-changed-händelser när modifierartangenter mappas om med en händelsefälla.\nDet är ett försök att kringgå inkompatibiliteter med AltTab i ärende 10220."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değiştirici tuşları bir olay kancasıyla yeniden atarken sahte flags-changed olayları gönder.\nBu, 10220 numaralı sorundaki AltTab uyumsuzluklarına geçici çözüm girişimidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi các sự kiện flags-changed giả khi gán lại phím bổ trợ bằng event tap.\nĐây là nỗ lực khắc phục sự không tương thích với AltTab trong issue 10220."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在通过事件点击重新映射修饰键时，发布虚假的“flags-changed”事件？\n这是针对 issue 10220中 AltTab不兼容问题的解决方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用事件監聽重新對應變更鍵時，發出虛假的 flags-changed 事件。\n這是為了解決與 AltTab 不相容的問題（issue 10220）。"
          }
        }
      }
    },
    "AdvancedSetting.preconvertStringsOnParserThread" : {
      "comment" : "Advanced setting: preconvertStringsOnParserThread",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předem převádět řetězce mimo ASCII na znaky obrazovky ve vlákně parseru.\nVyužívá paralelismu mezi parsováním a změnami obrazovky pro lepší výkon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forkonverter ikke-ASCII-strenge til skærmtegn på parsertråden.\nDet udnytter parallelitet mellem fortolkning og skærmændring for bedre ydeevne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht-ASCII-Strings im Parser-Thread vorab in Bildschirmzeichen umwandeln.\nDies nutzt die Parallelität zwischen Parsen und Bildschirmänderung für bessere Leistung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pre-convert non-ASCII strings to screen characters on the parser thread.\nThis exploits parallelism between parsing and screen mutation for better performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preconvierte cadenas no ASCII en caracteres de pantalla en el hilo del analizador.\nAprovecha el paralelismo entre el análisis y la mutación de la pantalla para mejorar el rendimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muunna ei-ASCII-merkkijonot näyttömerkeiksi etukäteen jäsentimen säikeessä.\nHyödyntää jäsennyksen ja näytön muutosten rinnakkaisuutta paremman suorituskyvyn saamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préconvertir les chaînes non ASCII en caractères d’écran sur le thread d’analyse.\nCela exploite le parallélisme entre l’analyse et la modification de l’écran pour de meilleures performances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preconverti le stringhe non ASCII in caratteri dello schermo sul thread del parser.\nSfrutta il parallelismo tra analisi e modifica dello schermo per prestazioni migliori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーサースレッド上で非ASCII文字列を事前に画面文字へ変換する。\nこれは解析と画面の変更の間の並列性を利用してパフォーマンスを向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파서 스레드에서 비ASCII 문자열을 화면 문자로 미리 변환\n파싱과 화면 변경 사이의 병렬성을 활용하여 성능을 향상합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndskonverter ikke-ASCII-strenger til skjermtegn i parsertråden.\nDette utnytter parallellitet mellom parsing og skjermendring for bedre ytelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet niet-ASCII-tekenreeksen vooraf om naar schermtekens op de parserthread.\nDit benut parallelle uitvoering van parsen en schermwijzigingen voor betere prestaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstępnie konwertuj ciągi spoza ASCII na znaki ekranu w wątku parsera.\nWykorzystuje równoległość między parsowaniem a modyfikacją ekranu, aby zwiększyć wydajność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-converter strings não ASCII em caracteres de tela na thread do analisador.\nIsto aproveita o paralelismo entre a análise e a mutação da tela para melhor desempenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заранее преобразовывать не-ASCII строки в экранные символы в потоке синтаксического анализа.\nЭто использует параллелизм между разбором и изменением экрана для повышения производительности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vopred konvertovať reťazce mimo ASCII na znaky obrazovky vo vlákne parsera.\nVyužíva sa tým paralelizmus medzi parsovaním a zmenami obrazovky pre lepší výkon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnaprej pretvori nize, ki niso ASCII, v znake zaslona v niti razčlenjevalnika.\nTo izkorišča vzporednost med razčlenjevanjem in spreminjanjem zaslona za boljšo zmogljivost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förkonvertera icke-ASCII-strängar till skärmtecken i parsertråden.\nDet utnyttjar parallellitet mellan tolkning och skärmändring för bättre prestanda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASCII olmayan dizeleri ayrıştırıcı iş parçacığında ekran karakterlerine önceden dönüştür.\nBu, daha iyi performans için ayrıştırma ile ekran değişimi arasındaki paralelliği kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển đổi trước các chuỗi không phải ASCII thành ký tự màn hình trên luồng phân tích.\nTận dụng tính song song giữa phân tích và thay đổi màn hình để có hiệu năng tốt hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在解析线程上，在转换非ASCII字符串为屏幕字符之前进行预处理？\n此功能利用解析和屏幕修改的并行性以提高性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在解析器執行緒上，預先將非 ASCII 字串轉換為螢幕字元。\n這利用了解析與螢幕變更之間的平行處理，以獲得更好的效能。"
          }
        }
      }
    },
    "AdvancedSetting.preferSpeedToFullLigatureSupport" : {
      "comment" : "Advanced setting: preferSpeedToFullLigatureSupport",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlepšuje výkon kreslení za cenu toho, že alfanumerické znaky nemohou být součástí ligatur."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedrer tegneydeevnen på bekostning af, at alfanumeriske tegn ikke kan indgå i ligaturer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessert die Zeichenleistung, verhindert dabei jedoch, dass alphanumerische Zeichen Teil von Ligaturen sein können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improves drawing performance at the expense of disallowing alphanumeric characters to belong to ligatures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora el rendimiento del dibujo a costa de no permitir que los caracteres alfanuméricos formen parte de ligaduras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parantaa piirtosuorituskykyä sillä hinnalla, että aakkosnumeeriset merkit eivät voi kuulua ligatuureihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliore les performances de dessin au prix de l’interdiction, pour les caractères alphanumériques, de faire partie de ligatures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliora le prestazioni di disegno a scapito del divieto ai caratteri alfanumerici di far parte delle legature."
