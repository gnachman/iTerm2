        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange beim Start gewartet werden soll, um sich beim Wiederherstellen von Fenstern mit einem iTerm-Daemon zu verbinden (in Sekunden)?"
          }
        },
        "en" : {
          "stringUnit" : {
