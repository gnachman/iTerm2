    "DiffWaitingPrompt.ReloadBody" : {
      "comment" : "Body text explaining that a queued reload in diff mode is waiting for git changes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato relace je nastavena na režim Diff, takže Znovu načíst spustí příkaz znovu až poté, co git ohlásí připravené nebo nepřipravené změny. Předchozí výstup je stále na obrazovce za tímto panelem. Zrušením ponecháte tento výstup a opustíte opětovné načtení, nebo můžete příkaz přesto spustit hned."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne session er indstillet til Diff-tilstand, så Indlæs igen kører kun kommandoen igen, når git rapporterer trinvise eller ikke-trinvise ændringer. Det tidligere output er stadig på skærmen bag dette panel. Annuller for at beholde outputtet og droppe den nye indlæsning, eller kør kommandoen nu alligevel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung ist auf den Diff-Modus eingestellt, daher führt „Neu laden“ den Befehl erst erneut aus, wenn Git vorgemerkte oder nicht vorgemerkte Änderungen meldet. Die vorherige Ausgabe ist weiterhin hinter diesem Fenster zu sehen. Klicken Sie auf Abbrechen, um diese Ausgabe zu behalten und das erneute Laden abzubrechen, oder führen Sie den Befehl jetzt trotzdem aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This session is set to Diff mode, so Reload will re-run the command only after git reports staged or unstaged changes. The previous output is still on screen behind this panel. Cancel to keep that output and abandon the reload, or run the command now anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión está en modo Diff, así que Recargar volverá a ejecutar el comando solo cuando git informe de cambios preparados o sin preparar. La salida anterior sigue en pantalla detrás de este panel. Cancela para conservar esa salida y abandonar la recarga, o ejecuta el comando ahora de todos modos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä istunto on Diff-tilassa, joten Lataa uudelleen suorittaa komennon uudelleen vasta, kun git ilmoittaa vaiheistetuista tai vaiheistamattomista muutoksista. Edellinen tuloste on yhä näytöllä tämän paneelin takana. Kumoa säilyttääksesi tulosteen ja hylätäksesi uudelleenlatauksen tai suorita komento nyt joka tapauksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session est en mode Diff : le rechargement ne réexécutera donc la commande qu’une fois que git aura signalé des modifications indexées ou non indexées. La sortie précédente est toujours à l’écran derrière ce panneau. Annulez pour conserver cette sortie et abandonner le rechargement, ou exécutez quand même la commande maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione è impostata in modalità Diff, quindi Ricarica eseguirà di nuovo il comando solo dopo che git avrà rilevato modifiche in stage o non in stage. L’output precedente è ancora sullo schermo dietro a questo pannello. Annulla per mantenere quell’output e rinunciare alla ricarica, oppure esegui comunque il comando adesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションはDiffモードに設定されているため、再読み込みはgitがステージ済みまたは未ステージの変更を報告した後にのみコマンドを再実行します。以前の出力はこのパネルの背後にまだ表示されています。キャンセルするとその出力を保持して再読み込みを中止します。今すぐコマンドを実行することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션은 Diff 모드로 설정되어 있으므로, 새로고침은 git이 스테이징되었거나 스테이징되지 않은 변경 사항을 보고한 후에만 명령을 다시 실행합니다. 이전 출력은 이 패널 뒤의 화면에 그대로 남아 있습니다. 취소하여 해당 출력을 유지하고 새로고침을 포기하거나, 지금 바로 명령을 실행할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne økten er satt til Diff-modus, så Last inn på nytt kjører kommandoen igjen først når git melder om klargjorte eller uklargjorte endringer. Forrige utdata ligger fortsatt på skjermen bak dette panelet. Avbryt for å beholde utdataene og droppe ny lasting, eller kjør kommandoen nå likevel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze sessie staat in diff-modus, dus ‘Laad opnieuw’ voert het commando pas opnieuw uit nadat git gestagede of niet-gestagede wijzigingen meldt. De vorige uitvoer staat nog op het scherm achter dit paneel. Annuleer om die uitvoer te behouden en het opnieuw laden af te breken, of voer het commando toch nu uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta sesja jest w trybie Diff, więc „Wczytaj ponownie” uruchomi polecenie jeszcze raz dopiero, gdy git zgłosi zmiany w poczekalni lub poza nią. Poprzednie dane wyjściowe nadal są na ekranie za tym panelem. Anuluj, aby zachować te dane i porzucić ponowne wczytanie, albo mimo to uruchom polecenie teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão está no modo Diff, então o Recarregar executará o comando novamente somente depois que o git relatar alterações preparadas ou não preparadas. A saída anterior ainda está na tela, atrás deste painel. Cancele para manter essa saída e abandonar o recarregamento, ou execute o comando agora mesmo assim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого сеанса включён режим Diff, поэтому команда «Обновить» перезапустит команду только после того, как git сообщит о проиндексированных или непроиндексированных изменениях. Предыдущий вывод по-прежнему отображается на экране за этой панелью. Нажмите «Отмена», чтобы сохранить этот вывод и отменить обновление, либо всё равно запустите команду сейчас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto relácia je v režime Diff, takže Znovu načítať spustí príkaz znova, až keď git nahlási zmeny v indexe alebo mimo neho. Predošlý výstup je stále na obrazovke za týmto panelom. Zrušením ponecháte tento výstup a opustíte opätovné načítanie, alebo príkaz spustite hneď."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta seja je nastavljena na način Diff, zato bo Znova naloži ukaz znova zagnal šele, ko git sporoči pripravljene ali nepripravljene spremembe. Prejšnji izhod je še vedno na zaslonu za to ploščo. Kliknite Prekliči, da ohranite ta izhod in opustite ponovno nalaganje, ali pa ukaz kljub temu zaženite zdaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här sessionen är inställd på Diff-läge, så Läs in igen kör kommandot på nytt först när git rapporterar köade eller ej köade ändringar. Den tidigare utdatan ligger kvar på skärmen bakom den här panelen. Avbryt för att behålla den utdatan och överge omladdningen, eller kör kommandot ändå nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum Diff moduna ayarlı, bu nedenle Yeniden Yükle komutu yeniden çalıştırmayı yalnızca git hazırlanmış veya hazırlanmamış değişiklikler bildirdikten sonra yapar. Önceki çıktı bu panelin arkasında hâlâ ekranda. Bu çıktıyı koruyup yeniden yüklemeden vazgeçmek için Vazgeç’e tıklayın veya komutu yine de şimdi çalıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên này được đặt ở chế độ Diff, nên Tải lại sẽ chỉ chạy lại lệnh sau khi git báo có thay đổi đã staged hoặc chưa staged. Đầu ra trước đó vẫn nằm phía sau bảng này. Hãy Hủy để giữ đầu ra đó và bỏ việc tải lại, hoặc chạy lệnh ngay bây giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话设置为 Diff 模式，因此 Reload 命令仅在 git 报告有已暂存或未暂存的更改后才会重新运行。此面板背后的先前输出仍显示在屏幕上。取消即可保留该输出并放弃重新加载，或现在就运行命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作階段設定為 Diff 模式，因此「重新載入」只會在 git 回報有已暫存或未暫存的變更後，才重新執行指令。先前的輸出仍顯示在此面板後方的螢幕上。取消可保留該輸出並放棄重新載入，或立即執行指令。"
          }
        }
      }
    },
