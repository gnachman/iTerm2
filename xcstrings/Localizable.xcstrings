    "SSHFilePanel.FileExistsMessage" : {
      "comment" : "Alert asking whether to replace an existing file with the given name on the given host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor s názvem „%1$@“ už na hostiteli %2$@ v tomto umístění existuje. Chcete jej nahradit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes allerede et arkiv med navnet “%1$@” på %2$@ på dette sted. Vil du erstatte det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei mit dem Namen „%1$@“ existiert an diesem Ort auf %2$@ bereits. Möchten Sie sie ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A file with the name “%1$@” on %2$@ already exists in this location. Do you want to replace it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe en este lugar un archivo llamado “%1$@” en %2$@. ¿Quieres reemplazarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedosto nimeltä ”%1$@” on jo olemassa tässä sijainnissa palvelimella %2$@. Haluatko korvata sen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier nommé « %1$@ » existe déjà à cet emplacement sur %2$@. Voulez-vous le remplacer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiste già un file chiamato “%1$@” su %2$@ in questa posizione. Vuoi sostituirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」という名前のファイルが %2$@ 上のこの場所に既に存在します。置き換えますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 이 위치에 이름이 “%1$@”인 파일이 이미 존재합니다. 대치하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil med navnet «%1$@» finnes allerede på %2$@ på dette stedet. Vil du erstatte den?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bestaat al een bestand met de naam ‘%1$@’ op %2$@ op deze locatie. Wil je het vervangen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik o nazwie „%1$@” już istnieje w tej lokalizacji na hoście %2$@. Czy chcesz go zastąpić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um arquivo com o nome “%1$@” em %2$@ neste local. Deseja substituí-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл с именем «%1$@» на %2$@ уже существует в этом расположении. Заменить его?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor s názvom „%1$@“ na hostiteľovi %2$@ už na tomto mieste existuje. Chcete ho nahradiť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteka z imenom »%1$@« na gostitelju %2$@ na tem mestu že obstaja. Jo želite zamenjati?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns redan en fil med namnet ”%1$@” på %2$@ på den här platsen. Vill du ersätta den?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konumda %2$@ üzerinde “%1$@” adlı bir dosya zaten var. Değiştirmek istiyor musunuz?"
