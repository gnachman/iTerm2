    "ScriptFunctionCall.TimeoutEvaluatingArgs" : {
      "comment" : "Error when a function invocation times out while evaluating arguments; placeholders are the timeout, invocation, function name, and argument list",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časový limit (%1$@ s) vypršel při vyhodnocování vyvolání „%2$@“. K vypršení došlo při vyhodnocování těchto argumentů pro %3$@: %4$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (%1$@ sek.) under evaluering af kaldet “%2$@”. Timeout opstod under evaluering af følgende argumenter til %3$@: %4$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung (%1$@ Sek.) bei der Auswertung des Aufrufs „%2$@“. Die Zeitüberschreitung trat bei der Auswertung der folgenden Argumente für %3$@ auf: %4$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout (%1$@ sec) while evaluating invocation “%2$@”. The timeout occurred while evaluating the following arguments to %3$@: %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera agotado (%1$@ s) al evaluar la invocación “%2$@”. El tiempo se agotó al evaluar los siguientes argumentos de %3$@: %4$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikakatkaisu (%1$@ s) kutsun ”%2$@” arvioinnissa. Aikakatkaisu tapahtui, kun arvioitiin funktion %3$@ seuraavia argumentteja: %4$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé (%1$@ s) lors de l’évaluation de l’invocation « %2$@ ». Le délai a été dépassé lors de l’évaluation des arguments suivants de %3$@ : %4$@"
          }
