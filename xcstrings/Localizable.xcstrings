    "ProfilesSession.ProgressBarHeightTooTall" : {
      "comment" : "Message shown when the progress bar height is clamped to the top margin height",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Höhe der Fortschrittsanzeige darf die Höhe des oberen Rands nicht überschreiten. Sie können dies unter **Einstellungen > Erscheinungsbild > Bereiche > Oberer und unterer Rand** anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The progress bar height cannot exceed the top margin’s height. You can adjust it in **Settings > Appearance > Panes > Top & Bottom Margins**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La altura de la barra de progreso no puede superar la altura del margen superior. Puedes ajustarla en **Ajustes > Apariencia > Paneles > Márgenes superior e inferior**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hauteur de la barre de progression ne peut pas dépasser celle de la marge supérieure. Vous pouvez l’ajuster dans **Réglages > Apparence > Volets > Marges haute et basse**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’altezza della barra di avanzamento non può superare quella del margine superiore. Puoi regolarla in **Impostazioni > Aspetto > Riquadri > Margini superiore e inferiore**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プログレスバーの高さは、上部マージンの高さを超えることはできません。**設定 > 外観 > ペイン > 上下マージン** で調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행률 막대 높이는 위쪽 여백 높이를 초과할 수 없습니다. **설정 > 모양 > 패널 > 위쪽 및 아래쪽 여백**에서 조정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A altura da barra de progresso não pode exceder a altura da margem superior. Você pode ajustá-la em **Ajustes > Aparência > Painéis > Margens superior e inferior**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота индикатора выполнения не может превышать высоту верхнего поля. Это можно настроить в разделе **Настройки > Внешний вид > Панели > Верхнее и нижнее поля**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme çubuğu yüksekliği üst kenar boşluğunun yüksekliğini aşamaz. Bunu **Ayarlar > Görünüm > Bölmeler > Üst ve alt kenar boşlukları** bölümünden ayarlayabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条的高度不能超过顶部边缘的高度。你可以在**设置 > 外观 > 窗格 > 顶部和底部边缘**中调整它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度列的高度不能超過頂部邊界的高度。你可以在**設定 > 外觀 > 窗格 > 上下邊界**中調整。"
          }
        }
      }
    },
