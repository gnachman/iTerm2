    "PTYSession.JSONSelectionChanged" : {
      "comment" : "Warning that the selection is no longer valid JSON",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že se výběr změnil a už nejde o platný objekt JSON.\nTuto funkci najdete v nabídce „Úpravy > Nahradit výběr > Nahradit formátovaným JSON“, pokud to budete chtít zkusit znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at markeringen er ændret og ikke længere er et gyldigt JSON-objekt.\nDu kan finde denne funktion under Rediger > Erstat markering > Erstat med formateret JSON, hvis du vil prøve igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anscheinend hat sich die Auswahl geändert und ist kein gültiges JSON-Objekt mehr.\nSie finden diese Funktion unter Bearbeiten > Auswahl ersetzen > Durch formatiertes JSON ersetzen, wenn Sie es erneut versuchen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like the selection changed and is no longer a valid JSON object.\nYou can find this feature under Edit > Replace Selection > Replace with Pretty-Printed JSON if you want to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que la selección cambió y ya no es un objeto JSON válido.\nPuedes encontrar esta función en Edición > Reemplazar selección > Reemplazar por JSON con formato legible si quieres volver a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinta näyttää muuttuneen, eikä se ole enää kelvollinen JSON-objekti.\nLöydät tämän ominaisuuden kohdasta Muokkaa > Korvaa valinta > Korvaa muotoillulla JSON:lla, jos haluat yrittää uudelleen."
