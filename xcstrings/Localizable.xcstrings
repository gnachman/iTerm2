    "APIHelper.AllowConnectionMessage" : {
      "comment" : "Prompt asking whether to allow an unknown process to use the API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Prozess versucht, die iTerm2-API zu verwenden. Die API ermöglicht es einem Skript, iTerm2 zu steuern sowie dessen Inhalte anzuzeigen und zu ändern. Verbindung zulassen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another process is trying to use the iTerm2 API. The API allows a script to control iTerm2 and view and modify its contents. Allow the connection?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のプロセスがiTerm2 APIを使用しようとしています。このAPIを使うと、スクリプトがiTerm2を制御し、その内容を表示・変更できます。接続を許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 프로세스가 iTerm2 API를 사용하려고 합니다. API를 사용하면 스크립트가 iTerm2를 제어하고 그 내용을 보고 수정할 수 있습니다. 연결을 허용하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro processo está tentando usar a API do iTerm2. A API permite que um script controle o iTerm2 e visualize e modifique seu conteúdo. Permitir a conexão?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другой процесс пытается использовать API iTerm2. API позволяет скрипту управлять iTerm2, а также просматривать и изменять его содержимое. Разрешить подключение?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个进程正在尝试使用 iTerm2 API。API 允许脚本控制 iTerm2 并查看和修改其内容。允许此连接吗？"
          }
        }
      }
    },
