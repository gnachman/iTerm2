    "SemanticHistory.OpenURLCaveat" : {
      "comment" : "Explanation of the open-URL semantic history action",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když aktivujete sémantickou historii na názvu souboru, prohlížeč otevře URL.\nPomocí \\1 zadáte název souboru, na který jste klikli, a pomocí \\2 číslo řádku. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du aktiverer Semantisk historik på et arkivnavn, åbner browseren en URL.\nBrug \\1 til arkivnavnet, du klikkede på, og \\2 til linjenummeret. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Semantic History auf einem Dateinamen aktivieren, öffnet der Browser eine URL.\nVerwenden Sie \\1 für den angeklickten Dateinamen und \\2 für die Zeilennummer. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you activate Semantic History on a filename, the browser opens a URL.\nUse \\1 for the filename you clicked on and \\2 for the line number. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando activas el historial semántico en un nombre de archivo, el navegador abre una URL.\nUsa \\1 para el nombre del archivo en el que hiciste clic y \\2 para el número de línea. "
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun aktivoit semanttisen historian tiedostonimessä, selain avaa URL-osoitteen.\nKäytä \\1 klikatulle tiedostonimelle ja \\2 rivinumerolle. "
