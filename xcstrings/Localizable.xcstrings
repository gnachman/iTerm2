    "Tip.0051.Body" : {
      "comment" : "Tip of the day body, id 0051",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie „Mindestkontrast“ unter „Einstellungen > Profile > Farben“ an, damit Text unabhängig von der Kombination aus Text- und Hintergrundfarbe immer lesbar bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust “Minimum Contrast” in “Settings > Profiles > Colors” to ensure text is always legible regardless of text/background color combination."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」で「最小コントラスト」を調整すると、文字色と背景色の組み合わせにかかわらず、常にテキストを読みやすくできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상”에서 “최소 대비”를 조절하면 텍스트/배경 색상 조합에 관계없이 항상 텍스트를 읽을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste “Contraste mínimo” em “Ajustes > Perfis > Cores” para garantir que o texto seja sempre legível, independentemente da combinação de cores de texto e fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте «Минимальный контраст» в «Настройки > Профили > Цвета», чтобы текст всегда оставался читаемым независимо от сочетания цветов текста и фона."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 颜色”中调整“最小对比度”，以确保无论文本与背景颜色如何组合，文本始终清晰可辨。"
          }
        }
      }
    },
