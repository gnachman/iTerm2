    "ScriptsMenu.EnvMissingLaunch" : {
      "comment" : "Script Console message shown when a script's Python environment is missing at auto-launch",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Python-Umgebung für „%@“ fehlt (möglicherweise wurde die gemeinsam genutzte Laufzeitumgebung gelöscht). Starten Sie es über das Menü „Scripts“, um es neu zu erstellen.\n"
          }
        },
        "en" : {
