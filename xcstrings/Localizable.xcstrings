    "Tip.0063.Body" : {
      "comment" : "Tip of the day body, id 0063",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online galerie barev nabízí více než sto krásných barevných schémat ke stažení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det online farvegalleri har over hundrede smukke farveskemaer, du kan hente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Online-Farbgalerie bietet über hundert wunderschöne Farbschemata zum Herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The online color gallery features over one hundred beautiful color schemes you can download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galería de colores en línea ofrece más de cien hermosos esquemas de colores que puedes descargar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkossa oleva värigalleria sisältää yli sata kaunista väriteemaa, jotka voit ladata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galerie de couleurs en ligne propose plus d’une centaine de magnifiques jeux de couleurs à télécharger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galleria di colori online offre oltre cento splendide combinazioni di colori che puoi scaricare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインカラーギャラリーには、ダウンロードできる100種類以上の美しいカラースキームが用意されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 색상 갤러리에는 다운로드할 수 있는 아름다운 색상 구성표가 100개 넘게 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det nettbaserte fargegalleriet har over hundre vakre fargeskjemaer du kan laste ned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De online kleurengalerij bevat meer dan honderd mooie kleurenschema’s die je kunt downloaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internetowa galeria kolorów zawiera ponad sto pięknych schematów kolorów do pobrania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A galeria de cores on-line oferece mais de cem belos esquemas de cores que você pode transferir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В онлайн-галерее цветов представлено более ста прекрасных цветовых схем, которые можно загрузить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online galéria farieb ponúka vyše sto krásnych farebných schém, ktoré si môžete stiahnuť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spletna galerija barv ponuja več kot sto čudovitih barvnih shem, ki jih lahko prenesete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det webbaserade färggalleriet har över hundra vackra färgscheman som du kan hämta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimiçi renk galerisi, indirebileceğiniz yüzden fazla güzel renk şeması sunar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư viện màu trực tuyến có hơn một trăm bảng màu đẹp mà bạn có thể tải về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该在线颜色图库提供超过一百种精美的颜色方案，可供下载使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線上配色圖庫提供超過一百種精美的配色供你下載。"
          }
        }
      }
    },
