    "ClaudeCode.UninstallDisconnectedHosts" : {
      "comment" : "Line of the uninstall confirmation explaining that hosts not currently connected through SSH Integration are not changed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts, die nicht verbunden sind, behalten ihren Hook. Verbinden Sie sich mit der SSH-Integration mit einem solchen Host und deinstallieren Sie erneut, um ihn dort zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hosts that aren’t connected keep their hook. Connect to one with SSH Integration and uninstall again to remove it there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hosts que no están conectados conservan su hook. Conéctate a uno con la integración con SSH y vuelve a desinstalar para eliminarlo allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hôtes non connectés conservent leur hook. Connectez-vous-y avec l’intégration SSH et désinstallez de nouveau pour l’y supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli host non connessi mantengono il proprio hook. Connettiti a uno con l’integrazione SSH e disinstalla di nuovo per rimuoverlo lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されていないホストのフックはそのまま残ります。SSH統合でそのホストに接続し、もう一度アンインストールすると、そこからも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되어 있지 않은 호스트의 훅은 그대로 남습니다. 해당 호스트에서 제거하려면 SSH 통합으로 연결한 후 다시 제거하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts que não estão conectados mantêm o hook. Conecte-se a um deles com a Integração SSH e desinstale novamente para removê-lo lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На неподключённых хостах хук останется. Чтобы удалить его там, подключитесь к хосту через интеграцию с SSH и снова выполните удаление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı olmayan ana makineler kancalarını korur. Kaldırmak için SSH Entegrasyonu ile bir ana makineye bağlanıp yeniden kaldırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接的主机会保留其钩子。要从某台主机上移除，请通过 SSH 集成连接到该主机，然后再次卸载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未連線的主機會保留其 hook。請使用 SSH 整合連線到該主機，然後再次解除安裝，即可從該處移除。"
          }
        }
      }
    },
