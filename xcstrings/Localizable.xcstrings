    "RemotePreferences.CannotCopyToURLDetail" : {
      "comment" : "Alert detail explaining that settings must be copied manually when the destination is a URL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sie verfügbar zu machen, beenden Sie zuerst iTerm2 und kopieren Sie dann ~/Library/Preferences/com.googlecode.iterm2.plist manuell zu Ihrem Hosting-Anbieter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To make it available, first quit iTerm2 and then manually copy ~/Library/Preferences/com.googlecode.iterm2.plist to your hosting provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ponerlos a disposición, primero sal de iTerm2 y luego copia manualmente ~/Library/Preferences/com.googlecode.iterm2.plist a tu proveedor de alojamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les rendre disponibles, quittez d’abord iTerm2, puis copiez manuellement ~/Library/Preferences/com.googlecode.iterm2.plist chez votre hébergeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per renderle disponibili, esci prima da iTerm2 e poi copia manualmente ~/Library/Preferences/com.googlecode.iterm2.plist sul tuo provider di hosting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能にするには、まず iTerm2 を終了してから、~/Library/Preferences/com.googlecode.iterm2.plist を手動でホスティングプロバイダーにコピーしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용할 수 있게 하려면 먼저 iTerm2를 종료한 다음 ~/Library/Preferences/com.googlecode.iterm2.plist를 호스팅 제공업체에 직접 복사하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para torná-lo disponível, primeiro encerre o iTerm2 e depois copie manualmente ~/Library/Preferences/com.googlecode.iterm2.plist para o seu provedor de hospedagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сделать их доступными, сначала завершите работу iTerm2, а затем вручную скопируйте файл ~/Library/Preferences/com.googlecode.iterm2.plist на ваш хостинг."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıma sunmak için önce iTerm2’den çıkın, ardından ~/Library/Preferences/com.googlecode.iterm2.plist dosyasını barındırma sağlayıcınıza elle kopyalayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使其可用，请先退出 iTerm2，然后手动将 ~/Library/Preferences/com.googlecode.iterm2.plist 拷贝到你的托管服务提供者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使其可供使用，請先結束 iTerm2，然後手動將 ~/Library/Preferences/com.googlecode.iterm2.plist 拷貝到你的代管服務供應商。"
          }
        }
      }
    },
    "RemotePreferences.CopyDataFilesToFolderPrompt" : {
      "comment" : "Prompt asking whether to copy data files to the settings folder; %@ is the folder path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Schnipsel, Notizen oder Symbolanpassungen haben sich geändert. Sollen sie nach %@ kopiert werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your snippets, notes, or icon customizations changed. Copy them to %@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fragmentos, notas o personalizaciones de iconos han cambiado. ¿Copiarlos en %@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos extraits, notes ou personnalisations d’icônes ont changé. Les copier vers %@ ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi frammenti, le note o le personalizzazioni delle icone sono cambiati. Copiarli in %@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペット、メモ、アイコンのカスタマイズが変更されました。%@ にコピーしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스니펫, 메모 또는 아이콘 사용자화가 변경되었습니다. %@에 복사하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus Fragmentos, notas ou personalizações de ícone foram alterados. Copiá-los para %@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши сниппеты, заметки или настройки значков изменились. Скопировать их в %@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçacıklarınız, notlarınız veya simge özelleştirmeleriniz değişti. %@ konumuna kopyalansın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的代码片段、笔记或图标自定义项已更改。将其拷贝到 %@？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的片段、備註或圖像自訂內容已變更。要將它們拷貝到 %@ 嗎？"
          }
        }
      }
    },
    "RemotePreferences.DataFileConflictPrompt" : {
      "comment" : "Prompt shown when data files conflict between the local Mac and the settings folder; %@ is the folder path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnipsel, Notizen oder Symbolanpassungen haben sich sowohl auf diesem Mac als auch im Einstellungsordner „%@“ geändert, seit sie zuletzt synchronisiert wurden. Welche Kopie möchten Sie behalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Snippets, notes, or icon customizations changed both on this Mac and in the settings folder “%@” since they were last in sync. Which copy would you like to keep?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fragmentos, notas o personalizaciones de iconos han cambiado tanto en este Mac como en la carpeta de ajustes “%@” desde la última sincronización. ¿Qué copia quieres conservar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extraits, notes ou personnalisations d’icônes ont changé à la fois sur ce Mac et dans le dossier de réglages « %@ » depuis leur dernière synchronisation. Quelle copie voulez-vous conserver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frammenti, note o personalizzazioni delle icone sono cambiati sia su questo Mac sia nella cartella delle impostazioni “%@” dall’ultima sincronizzazione. Quale copia vuoi mantenere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペット、メモ、アイコンのカスタマイズが、前回の同期以降にこの Mac と設定フォルダ「%@」の両方で変更されました。どちらのコピーを残しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 동기화 이후 이 Mac과 설정 폴더 “%@” 양쪽에서 스니펫, 메모 또는 아이콘 사용자화가 변경되었습니다. 어느 사본을 유지하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragmentos, notas ou personalizações de ícone foram alterados tanto neste Mac quanto na pasta de ajustes “%@” desde a última sincronização. Qual cópia você quer manter?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сниппеты, заметки или настройки значков были изменены как на этом Mac, так и в папке настроек «%@» с момента последней синхронизации. Какую копию вы хотите оставить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçacıklar, notlar veya simge özelleştirmeleri, son eşitlemeden bu yana hem bu Mac’te hem de “%@” ayar klasöründe değişti. Hangi kopyayı korumak istersiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自上次同步以来，代码片段、笔记或图标自定义项在这台 Mac 和设置文件夹“%@”中都发生了更改。你想保留哪个副本？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自上次同步以來，片段、備註或圖像自訂內容在這部 Mac 和設定檔案夾「%@」中都已變更。你想保留哪一份？"
          }
        }
      }
    },
