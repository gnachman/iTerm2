    "GPURenderer.Off.Ligatures" : {
      "comment" : "Shown in Help > GPU Renderer Availability: why GPU rendering is off in the current session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslování pomocí GPU je v aktuální relaci vypnuto, protože jsou zapnuty ligatury. Můžete je vypnout v nabídce „Nastavení > Profily > Text > Používat ligatury“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-gengivelse er slået fra i den aktuelle session, fordi ligaturer er slået til. Du kan slå dem fra i Indstillinger > Profiler > Tekst > Brug ligaturer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das GPU-Rendering ist in der aktuellen Sitzung deaktiviert, weil Ligaturen aktiviert sind. Sie können sie in Einstellungen > Profile > Text > „Ligaturen verwenden“ deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "GPU rendering is off in the current session because ligatures are enabled. You can disable them in Settings > Profiles > Text > Use ligatures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El renderizado por GPU está desactivado en la sesión actual porque las ligaduras están activadas. Puedes desactivarlas en Ajustes > Perfiles > Texto > Usar ligaduras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-renderöinti on pois päältä nykyisessä istunnossa, koska ligatuurit ovat käytössä. Voit poistaa ne käytöstä kohdassa Asetukset > Profiilit > Teksti > Käytä ligatuureja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu GPU est désactivé dans la session actuelle, car les ligatures sont activées. Vous pouvez les désactiver dans Réglages > Profils > Texte > Utiliser les ligatures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendering GPU è disattivato nella sessione corrente perché le legature sono attive. Puoi disattivarle in Impostazioni > Profili > Testo > Usa legature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合字が有効になっているため、現在のセッションではGPUレンダリングがオフになっています。「設定 > プロファイル > テキスト > 合字を使用」で無効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합자가 켜져 있으므로 현재 세션에서 GPU 렌더링이 꺼져 있습니다. 설정 > 프로파일 > 텍스트 > 합자 사용에서 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-gjengivelse er av i gjeldende økt fordi ligaturer er aktivert. Du kan deaktivere dem i «Innstillinger > Profiler > Tekst > Bruk ligaturer»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-weergave is uitgeschakeld in de huidige sessie omdat ligaturen zijn ingeschakeld. Je kunt ze uitschakelen via Instellingen > Profielen > Tekst > Gebruik ligaturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderowanie GPU jest wyłączone w bieżącej sesji, ponieważ ligatury są włączone. Możesz je wyłączyć w Ustawienia > Profile > Tekst > Używaj ligatur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renderização por GPU está desativada na sessão atual porque as ligaduras estão ativadas. Você pode desativá-las em Ajustes > Perfis > Texto > Usar ligaduras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рендеринг на GPU отключён в текущем сеансе, потому что включены лигатуры. Их можно отключить в Настройках > Профили > Текст > Использовать лигатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykresľovanie pomocou GPU je v aktuálnej relácii vypnuté, pretože sú zapnuté ligatúry. Môžete ich vypnúť v časti „Nastavenia > Profily > Text > Použiť ligatúry“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upodabljanje z GPU je v trenutni seji izklopljeno, ker so ligature omogočene. Onemogočite jih lahko v »Nastavitve > Profili > Besedilo > Uporabi ligature«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPU-rendering är av i den aktuella sessionen eftersom ligaturer är aktiverade. Du kan avaktivera dem i ”Inställningar > Profiler > Text > Använd ligaturer”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli oturumda GPU ile işleme kapalı, çünkü bitişik harfler etkin. Bunları “Ayarlar > Profiller > Metin > Bitişik harfleri kullan” bölümünden devre dışı bırakabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết xuất GPU đang tắt trong phiên hiện tại vì chữ ghép đang bật. Bạn có thể tắt chúng trong Cài đặt > Hồ sơ > Văn bản > Dùng chữ ghép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前会话中的 GPU 渲染已关闭，因为已启用连字。你可以在“设置 > 配置文件 > 文本 > 使用连字”中将其停用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前的工作階段已關閉 GPU 繪製，因為已啟用連字。你可以在「設定 > 描述檔 > 文字 > 使用連字」中停用。"
          }
        }
      }
    },
