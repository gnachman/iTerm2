    "ChatAgent.AutoProvideBody" : {
      "comment" : "Body text of the dialog asking whether to automatically share terminal contents with AI chats",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann den sichtbaren Bildschirminhalt und Terminalstatus dieser Sitzung bei jeder Nachricht mitsenden, die Sie in KI-Chats senden, in denen Sie dies erlaubt haben, damit der Assistent sieht, was Sie sehen. Sie können dies jederzeit in den Berechtigungseinstellungen eines Chats deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can include this session’s visible screen and terminal state with every message you send in AI chats where you’ve allowed it, so the assistant sees what you see. You can turn this off any time from a chat’s permission settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 puede incluir la pantalla visible y el estado de la terminal de esta sesión en cada mensaje que envíes en los chats de IA donde lo hayas permitido, para que el asistente vea lo mismo que tú. Puedes desactivarlo en cualquier momento desde los ajustes de permisos de un chat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut inclure l’écran visible et l’état du terminal de cette session dans chaque message que vous envoyez dans les chats IA où vous l’avez autorisé, afin que l’assistant voie ce que vous voyez. Vous pouvez le désactiver à tout moment dans les réglages d’autorisation d’un chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può includere la schermata visibile e lo stato del terminale di questa sessione in ogni messaggio che invii nelle chat IA in cui lo hai consentito, così l’assistente vede ciò che vedi tu. Puoi disattivarlo in qualsiasi momento dalle impostazioni di autorizzazione di una chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 では、許可した AI チャットで送信するすべてのメッセージに、このセッションの表示中の画面とターミナルの状態を含めることができます。これにより、アシスタントはあなたが見ているものを把握できます。この設定はいつでもチャットの権限設定からオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 허용된 AI 채팅에서 보내는 모든 메시지에 이 세션의 보이는 화면과 터미널 상태를 포함하여, 어시스턴트가 사용자가 보는 것을 함께 볼 수 있게 할 수 있습니다. 언제든지 채팅의 권한 설정에서 이 기능을 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode incluir a tela visível e o estado do terminal desta sessão em cada mensagem que você envia nos chats de IA onde você permitiu, para que o assistente veja o que você vê. Você pode desativar isso a qualquer momento nos ajustes de permissão de um chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может включать видимый экран и состояние терминала этой сессии в каждое сообщение, которое вы отправляете в чатах с ИИ, где вы это разрешили, чтобы ассистент видел то же, что и вы. Вы можете отключить это в любой момент в настройках разрешений чата."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, izin verdiğiniz YZ sohbetlerinde gönderdiğiniz her iletiye bu oturumun görünen ekranını ve terminal durumunu ekleyebilir; böylece asistan sizin gördüğünüzü görür. Bunu istediğiniz zaman bir sohbetin izin ayarlarından kapatabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以在你允许的 AI 聊天中，将每条消息附带该会话的可见屏幕和终端状态，以便助手看到你所看到的内容。你可以随时在聊天的权限设置中关闭此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以在你允許的 AI 聊天中，於每則傳送的訊息附上此工作階段的可見螢幕與終端機狀態，讓助理看到你所看到的內容。你可以隨時在聊天的權限設定中關閉此功能。"
          }
        }
      }
    },
