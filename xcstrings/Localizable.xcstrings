            "value" : "Gạch dưới các mục có thể chọn bằng Lịch sử ngữ nghĩa dưới con trỏ khi giữ ⌘?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌘ 时在光标下为语义历史记录中的可选项目添加下划线？"
