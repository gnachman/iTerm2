    "AdvancedSetting.alwaysUseStatusBarComposer" : {
      "comment" : "Advanced setting: alwaysUseStatusBarComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorübergehend einen Composer zur Statusleiste hinzufügen, anstatt die große Composer-Ansicht zu öffnen, wenn eine Statusleiste vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily add a composer to the status bar instead of opening the large composer view when a status bar is present."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir temporalmente un compositor a la barra de estado en lugar de abrir la vista grande del compositor cuando hay una barra de estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter temporairement un compositeur à la barre d’état au lieu d’ouvrir la grande vue du compositeur lorsqu’une barre d’état est présente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi temporaneamente un compositore alla barra di stato invece di aprire la grande vista del compositore quando è presente una barra di stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーが存在する場合、大きなコンポーザビューを開く代わりに、ステータスバーに一時的にコンポーザーを追加する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대가 있을 때 큰 컴포저 보기를 여는 대신 상태 막대에 컴포저를 임시로 추가합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar temporariamente um compositor à barra de status em vez de abrir a visualização grande do compositor quando houver uma barra de status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временно добавлять композитор в строку состояния вместо открытия большого окна композитора, если строка состояния присутствует."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum çubuğu varsa büyük oluşturucu görünümünü açmak yerine durum çubuğuna geçici olarak bir oluşturucu ekle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在状态栏存在时，临时添加一个 composer，而不是打开大的 composer视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在狀態列時，暫時在狀態列中加入編寫器，而不是打開大型編寫器檢視。"
          }
        }
      }
    },
    "AdvancedSetting.alwaysWarnBeforePastingOverSize" : {
      "comment" : "Advanced setting: alwaysWarnBeforePastingOverSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einfügen von mehr als dieser Anzahl an Zeichen eine Bestätigung verlangen.\nAuf -1 setzen, um die Warnung zu deaktivieren.\nZeichen werden in UTF-16 gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When pasting more than this many characters, require confirmation.\nSet to -1 to disable warning.\nCharacters are counted in UTF-16."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pegar más de esta cantidad de caracteres, exigir confirmación.\nUsa -1 para desactivar el aviso.\nLos caracteres se cuentan en UTF-16."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiger une confirmation lors du collage de plus de ce nombre de caractères.\nDéfinissez -1 pour désactiver l’avertissement.\nLes caractères sont comptés en UTF-16."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si incollano più di questo numero di caratteri, richiedi conferma.\nImposta -1 per disabilitare l’avviso.\nI caratteri sono contati in UTF-16."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この文字数を超える貼り付けを行う際に確認を必須にする。\n警告を無効にするには-1に設定してください。\n文字数はUTF-16でカウントされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣는 문자 수가 이 값을 넘으면 확인 요구\n경고를 끄려면 -1로 설정하십시오.\n문자 수는 UTF-16 기준으로 셉니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar mais que esta quantidade de caracteres, exigir confirmação.\nDefina como -1 para desativar o aviso.\nOs caracteres são contados em UTF-16."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требовать подтверждение при вставке более указанного числа символов.\nУстановите -1, чтобы отключить предупреждение.\nСимволы подсчитываются в кодировке UTF-16."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sayıdan fazla karakter yapıştırılırken onay iste.\nUyarıyı devre dışı bırakmak için -1 yapın.\nKarakterler UTF-16 olarak sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当粘贴的字符数超过此数量时，需要确认。\n将值设为 -1 可禁用警告提示。\n字符按 UTF-16 计数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上超過此字元數時，需要確認。\n設為 -1 可停用警告。\n字元以 UTF-16 計算。"
          }
        }
      }
    },
    "AdvancedSetting.animateGraphStatusBarComponents" : {
      "comment" : "Advanced setting: animateGraphStatusBarComponents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graphbasierte Statusleisten-Komponenten animieren?\nSchalten Sie dies aus, um die CPU-/GPU-Auslastung in WindowServer zu reduzieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animate graph-based status bar components?\nTurn this off to reduce CPU/GPU usage in WindowServer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Animar los componentes de la barra de estado basados en gráficos?\nDesactívalo para reducir el uso de CPU/GPU en WindowServer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animer les composants graphiques de la barre d’état ?\nDésactivez cette option pour réduire l’utilisation du CPU/GPU dans WindowServer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animare i componenti grafici della barra di stato?\nDisattivalo per ridurre l’uso di CPU/GPU in WindowServer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフベースのステータスバーコンポーネントをアニメーション表示しますか？\nWindowServerのCPU/GPU使用率を減らすには、これをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래프 기반 상태 막대 구성 요소에 애니메이션을 적용하겠습니까?\nWindowServer의 CPU/GPU 사용량을 줄이려면 이 옵션을 끄십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animar componentes da barra de status baseados em gráfico?\nDesative isso para reduzir o uso de CPU/GPU no WindowServer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимировать компоненты строки состояния на основе графиков?\nОтключите этот параметр, чтобы снизить нагрузку на ЦП/ГП в WindowServer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafik tabanlı durum çubuğu bileşenleri canlandırılsın mı?\nWindowServer’daki CPU/GPU kullanımını azaltmak için bunu kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否对基于图表的状态栏组件进行动画处理？\n关闭此选项以降低 WindowServer 中的 CPU/GPU 使用率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為圖表式狀態列元件加上動畫？\n關閉此項可降低 WindowServer 的 CPU／GPU 使用量。"
          }
        }
      }
    },
