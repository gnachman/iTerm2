    "AdvancedSetting.simpleNotifications" : {
      "comment" : "Advanced setting: simpleNotifications",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungskennung aus Benachrichtigungen weglassen.\nWenn aktiviert, zeigen Benachrichtigungen nur die Nachricht ohne den Sitzungsnamen und das Tab-Nummer-Präfix an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Omit session identifier from notifications.\nWhen enabled, notifications will only show the message without the session name and tab number prefix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite el identificador de sesión en las notificaciones.\nCuando está activado, las notificaciones solo mostrarán el mensaje, sin el prefijo del nombre de sesión y el número de pestaña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omettre l’identifiant de session dans les notifications.\nSi activé, les notifications n’affichent que le message, sans le préfixe du nom de la session et du numéro d’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ometti l’identificatore della sessione dalle notifiche.\nSe attivo, le notifiche mostreranno solo il messaggio, senza il prefisso con nome della sessione e numero del pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知からセッション識別子を省略する。\n有効にすると、通知はセッション名とタブ番号の接頭辞を含まずメッセージのみを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림에서 세션 식별자 생략.\n활성화하면 알림에 세션 이름과 탭 번호 접두어 없이 메시지만 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitir o identificador da sessão nas notificações.\nQuando ativado, as notificações mostrarão apenas a mensagem, sem o prefixo com o nome da sessão e o número da aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не указывать идентификатор сеанса в уведомлениях.\nЕсли включено, в уведомлениях будет показано только сообщение, без имени сеанса и номера вкладки в начале."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimlerden oturum tanımlayıcısını çıkar.\nEtkinse bildirimler, oturum adı ve sekme numarası öneki olmadan yalnızca iletiyi gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从通知中省略会话标识符。\n当启用时，通知将仅显示消息而不包含会话名称和标签页编号前缀。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從通知中省略工作階段識別碼。\n啟用後，通知只會顯示訊息，而沒有工作階段名稱和標籤頁編號前綴。"
          }
        }
      }
    },
    "AdvancedSetting.slowFrameRate" : {
      "comment" : "Advanced setting: slowFrameRate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die adaptive Bildwiederholrate aktiviert ist, bei hohem Durchsatz mit dieser Rate aktualisieren (FPS).\n Gilt nicht für den Metal-Renderer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When adaptive framerate is enabled, refresh at this rate during high throughput conditions (FPS).\n Does not apply to Metal renderer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la velocidad de fotogramas adaptativa está activada, se actualiza a esta velocidad (FPS) en condiciones de alto rendimiento.\n No se aplica al renderizador Metal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la fréquence d’images adaptative est activée, actualiser à cette fréquence en cas de débit élevé (IPS).\n Ne s’applique pas au moteur de rendu Metal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la frequenza fotogrammi adattiva è attiva, aggiorna a questa frequenza (FPS) in condizioni di throughput elevato.\n Non si applica al motore di rendering Metal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートが有効な場合、高スループット時にこのレート（FPS）で再描画する。\nMetalレンダラーには適用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 프레임 속도가 켜져 있으면 처리량이 많을 때 이 속도(FPS)로 새로 고칩니다.\nMetal 렌더러에는 적용되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a taxa de quadros adaptável estiver ativada, atualizar nesta taxa durante condições de alta vazão (FPS).\n Não se aplica ao renderizador Metal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включена адаптивная частота кадров, обновлять экран с этой частотой (FPS) при высокой нагрузке.\n Не применяется к рендереру Metal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarlamalı kare hızı etkinken, yüksek veri akışı koşullarında bu hızda yenile (FPS).\n Metal işleyici için geçerli değildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用自适应帧率时，在高吞吐量条件下以该速率刷新（FPS）。\n不适用于 Metal 渲染器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用自適應影格速率時，在高輸送量情況下以此速率（FPS）更新。\n不適用於 Metal 繪製器。"
          }
        }
      }
    },
