    "Tip.0092.Body" : {
      "comment" : "Tip of the day body, id 0092",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern oder übertragen Sie Ihre iTerm2-Einstellungen ganz einfach mit der Export-/Import-Funktion unter „Einstellungen > Allgemein > Einstellungen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Easily backup or transfer your iTerm2 settings using the Export/Import feature in “Settings > General > Settings”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > 一般 > 設定」のエクスポート/インポート機能を使うと、iTerm2の設定を簡単にバックアップしたり移行したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 일반 > 설정”의 내보내기/가져오기 기능을 사용하여 iTerm2 설정을 손쉽게 백업하거나 옮길 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça backup ou transfira facilmente seus ajustes do iTerm2 usando o recurso Exportar/Importar em “Settings > General > Settings”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легко создавайте резервную копию или переносите настройки iTerm2 с помощью функции экспорта/импорта в «Настройки > Общие > Настройки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可通过“设置 > 通用 > 设置”中的导出/导入功能轻松备份或传输 iTerm2 设置。"
          }
        }
      }
    },
