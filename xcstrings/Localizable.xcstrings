          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O script “%1$@” foi escrito para o Python %2$@, que não está mais disponível, então agora ele usa o Python %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрипт «%1$@» был написан для Python %2$@, который больше недоступен, поэтому теперь он использует Python %3$@."
          }
        },
        "zh-Hans" : {
