          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à jour le prompt le remplace par le prompt par défaut actuel, qui restera ensuite à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
