    "AdvancedSetting.autodetectMouseReportingStuck" : {
      "comment" : "Advanced setting: autodetectMouseReportingStuck",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky zjišťovat, kdy se hlášení myši zaseklo v zapnutém stavu?\nSleduje se, zda se na obrazovku nevypisují části řídicích sekvencí hlášení myši"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer automatisk, når musrapportering sidder fast i tændt tilstand?\nDette holder øje med, om dele af kontrolsekvenser til musrapportering bliver udskrevet på skærmen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch erkennen, wenn die Maus-Berichterstattung hängen geblieben ist?\nDies überwacht, ob Teile von Steuersequenzen der Maus-Berichterstattung auf dem Bildschirm ausgegeben werden"
          }
        },
        "en" : {
          "stringUnit" : {
