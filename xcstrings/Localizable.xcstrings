          "stringUnit" : {
            "state" : "translated",
            "value" : "Vo vašom domovskom priečinku už existuje súbor alebo priečinok s rovnakým názvom. Nahradením sa prepíše jeho aktuálny obsah."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteka ali mapa z istim imenom že obstaja v vašem domačem imeniku. Z zamenjavo bo njena trenutna vsebina prepisana."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil eller mapp med samma namn finns redan i din hemmapp. Om du ersätter den skrivs dess nuvarande innehåll över."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana dizininizde aynı ada sahip bir dosya veya klasör zaten var. Değiştirirseniz mevcut içeriğinin üzerine yazılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có tệp hoặc thư mục cùng tên trong thư mục chính của bạn. Thay thế sẽ ghi đè nội dung hiện tại của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家目录中已存在同名文件或文件夹。替换它会覆盖其当前内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的個人專屬目錄中已有同名的檔案或檔案夾。取代後將覆寫其目前的內容。"
          }
        }
      }
    },
    "SavePanel.ExistsBodyOther" : {
      "comment" : "Body of the overwrite confirmation when the file is in an unspecified location",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor nebo složka se stejným názvem už existuje. Nahrazením přepíšete jeho aktuální obsah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
