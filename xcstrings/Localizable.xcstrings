    "Tip.0021.Body" : {
      "comment" : "Tip of the day body, id 0021",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cursor-Führungslinie ist eine horizontale Linie, die Ihrem Cursor folgt. Sie können sie unter „Einstellungen > Profile > Farben“ aktivieren oder mit der Tastenkombination ⌥⌘; umschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The cursor guide is a horizontal line that follows your cursor. You can turn it on in “Settings > Profiles > Colors” or toggle it with the ⌥⌘; shortcut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルガイドは、カーソルに追従する水平線です。「設定 > プロファイル > カラー」でオンにするか、⌥⌘;のショートカットで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 가이드는 커서를 따라다니는 가로선입니다. “설정 > 프로파일 > 색상”에서 켜거나 ⌥⌘; 단축키로 켜고 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A guia do cursor é uma linha horizontal que acompanha o seu cursor. Você pode ativá-la em “Ajustes > Perfis > Cores” ou alterná-la com o atalho ⌥⌘;."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Направляющая курсора представляет собой горизонтальную линию, которая следует за курсором. Её можно включить в «Настройки > Профили > Цвета» или переключить сочетанием клавиш ⌥⌘;."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标引导线是一个跟随 cursor 的水平线。你可以在“设置 > 配置文件 > 颜色”中开启它，或使用 ⌥⌘ 快捷键切换。"
          }
        }
      }
    },
