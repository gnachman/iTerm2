    "SavePanel.ExtensionUseBothMessage" : {
      "comment" : "Message offering to keep both filename extensions; first placeholder is the typed extension, second is the required extension",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können auch beide verwenden, sodass Ihr Dateiname auf „.%1$@.%2$@“ endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can choose to use both, so that your file name ends in “.%1$@.%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes optar por usar ambas, de modo que el nombre del archivo termine en “.%1$@.%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez choisir d’utiliser les deux, de sorte que le nom de votre fichier se termine par « .%1$@.%2$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi scegliere di usarle entrambe, in modo che il nome del file termini con “.%1$@.%2$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を使用することもできます。その場合、ファイル名の末尾は「.%1$@.%2$@」になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘 다 사용하여 파일 이름이 “.%1$@.%2$@”(으)로 끝나도록 할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode optar por usar ambas, de modo que o nome do arquivo termine em “.%1$@.%2$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно использовать оба варианта, чтобы имя файла заканчивалось на «.%1$@.%2$@»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkisini de kullanmayı seçebilirsiniz; böylece dosya adınız “.%1$@.%2$@” ile biter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以同时使用两者，使文件名以“.%1$@.%2$@”结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以選擇兩者都使用，讓檔案名稱以「.%1$@.%2$@」結尾。"
          }
        }
      }
    },
