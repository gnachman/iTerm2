          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantic Historyの一致箇所にcmdキーでホバーした際、URLプレビューを表示する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시맨틱 히스토리 일치 항목 위에서 cmd를 누른 채 포인터를 올리면 URL 미리보기 표시."
          }
        },
