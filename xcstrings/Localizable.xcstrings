      "comment" : "Prompt asking whether to open a web link in iTerm2 instead of the default browser",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 umí zobrazovat webové stránky! Chcete tento odkaz otevřít v iTerm2?"
