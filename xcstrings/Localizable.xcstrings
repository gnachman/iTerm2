    "Tip.0032.Body" : {
      "comment" : "Tip of the day body, id 0032",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete, aby vizuální zvonek blikal přes celou obrazovku místo zobrazení ikony zvonku, můžete to zapnout v „Nastavení > Pokročilé“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil have, at den visuelle klokke blinker på hele skærmen i stedet for at vise et klokkesymbol, kan du slå det til i “Indstillinger > Avanceret”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der visuelle Signalton den gesamten Bildschirm aufblitzen lassen soll, anstatt ein Glockensymbol anzuzeigen, können Sie das unter „Einstellungen > Erweitert“ aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you want the visual bell to flash the whole screen instead of show a bell icon, you can turn that on in “Settings > Advanced.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres que la campana visual haga parpadear toda la pantalla en lugar de mostrar un icono de campana, puedes activarlo en “Ajustes > Avanzado”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos haluat visuaalisen äänimerkin välähdyttävän koko näyttöä äänimerkkikuvakkeen näyttämisen sijaan, voit ottaa sen käyttöön kohdassa ”Asetukset > Lisävalinnat”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous souhaitez que la sonnerie visuelle fasse clignoter tout l’écran au lieu d’afficher une icône de sonnerie, vous pouvez l’activer dans « Réglages > Avancé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuoi che il campanello visivo faccia lampeggiare l’intero schermo invece di mostrare un’icona di campanello, puoi attivarlo in “Impostazioni > Avanzate”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアルベルでベルのアイコンを表示する代わりに画面全体を点滅させたい場合は、「設定 > 詳細」でオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시각적 벨이 벨 아이콘을 보이는 대신 화면 전체를 깜박이게 하려면 “설정 > 고급”에서 켤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil at den visuelle bjellen skal blinke over hele skjermen i stedet for å vise et bjellesymbol, kan du slå det på i «Innstillinger > Avansert»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je wilt dat de visuele bel het hele scherm laat flitsen in plaats van een belsymbool te tonen, kun je dat inschakelen in ‘Instellingen > Geavanceerd’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli chcesz, aby dzwonek wizualny migał całym ekranem zamiast pokazywać ikonę dzwonka, możesz to włączyć w „Ustawienia > Zaawansowane”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você quiser que a campainha visual pisque a tela inteira em vez de mostrar um ícone de campainha, pode ativar isso em “Ajustes > Avançado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы хотите, чтобы визуальный сигнал вспышкой заполнял весь экран вместо показа значка колокольчика, включите это в «Настройки > Дополнительные»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete, aby vizuálny zvonček blikal na celej obrazovke namiesto zobrazenia ikony zvončeka, zapnite to v časti „Nastavenia > Rozšírené“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite, da vizualni zvonec zabliska po celotnem zaslonu namesto da prikaže ikono zvonca, to vklopite v »Nastavitve > Napredno«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill att den visuella ljudsignalen ska blinka över hela skärmen i stället för att visa en klocksymbol kan du slå på det i ”Inställningar > Avancerat”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel zilin zil simgesi göstermek yerine tüm ekranı yakıp söndürmesini istiyorsanız bunu “Ayarlar > Gelişmiş” bölümünden açabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn muốn chuông trực quan nhấp nháy toàn màn hình thay vì hiển thị biểu tượng chuông, bạn có thể bật trong “Cài đặt > Nâng cao.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您希望视觉角标在整个屏幕上闪烁，而不是显示角标图标，可以在“设置 > 高级”中开启此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你希望視覺響鈴讓整個螢幕閃爍，而不是顯示響鈴圖像，可以在「設定 > 進階」中開啟。"
          }
        }
      }
    },
