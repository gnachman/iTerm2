    "AdvancedSetting.asyncPreconvertMaxOutstandingBytes" : {
      "comment" : "Advanced setting: asyncPreconvertMaxOutstandingBytes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Bytes für ausstehende asynchrone Vorkonvertierungen.\nWird dieses Limit erreicht, werden neue Zeichenfolgen synchron im Mutation-Thread konvertiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum bytes of outstanding async pre-conversions.\nWhen this limit is reached, new strings are converted synchronously on the mutation thread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de bytes de preconversiones asíncronas pendientes.\nCuando se alcanza este límite, las nuevas cadenas se convierten de forma síncrona en el hilo de mutación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal d’octets de préconversions asynchrones en attente.\nLorsque cette limite est atteinte, les nouvelles chaînes sont converties de façon synchrone sur le thread de mutation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di byte di pre-conversioni asincrone in sospeso.\nQuando si raggiunge questo limite, le nuove stringhe vengono convertite in modo sincrono sul thread di mutazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非同期の事前変換で未処理のまま保持できる最大バイト数。\nこの上限に達すると、新しい文字列は mutation スレッド上で同期的に変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리 대기 중인 비동기 사전 변환의 최대 바이트 수.\n이 한도에 도달하면 새 문자열은 변경(mutation) 스레드에서 동기적으로 변환됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de bytes de pré-conversões assíncronas pendentes.\nQuando este limite é atingido, novas strings são convertidas de forma síncrona na thread de mutação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество байт незавершённых асинхронных преобразований.\nПри достижении этого предела новые строки преобразуются синхронно в потоке мутации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekleyen eşzamansız ön dönüştürmelerin en yüksek bayt sayısı.\nBu sınıra ulaşıldığında yeni dizeler mutasyon iş parçacığında eşzamanlı olarak dönüştürülür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
