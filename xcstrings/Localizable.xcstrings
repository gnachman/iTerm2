          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете добавить настраиваемую строку состояния в окна терминала."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal pencerelerinize yapılandırılabilir bir durum çubuğu ekleyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
