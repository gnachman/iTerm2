            "value" : "빠르게 열기(⇧⌘O)가 이제 명령 팔레트가 되었습니다! 메뉴 항목의 이름을 입력하기만 하면 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne hurtig (⇧⌘O) er nå en kommandopalett! Bare skriv navnet på et menyobjekt for å aktivere det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open snel (⇧⌘O) is nu een commandopalet! Typ gewoon de naam van een menuonderdeel om het te activeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkie otwieranie (⇧⌘O) jest teraz paletą poleceń! Wystarczy wpisać nazwę elementu menu, aby go aktywować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
