          "stringUnit" : {
            "state" : "new",
            "value" : "The bell is ringing a lot. Silence it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana suena mucho. ¿Silenciarla?"
          }
        },
