    "PasswordManager.RenameCouldNotReadPassword" : {
      "comment" : "Error shown when a rename is aborted because the current password could not be read",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální heslo se nepodařilo přečíst, proto nebyl účet přejmenován. Přejmenováním tohoto účtu se vytvoří znovu, čímž by se heslo ztratilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke læse den aktuelle adgangskode, så kontoen blev ikke omdøbt. Når kontoen omdøbes, oprettes den igen, og så ville adgangskoden gå tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Passwort konnte nicht gelesen werden, daher wurde das Konto nicht umbenannt. Das Umbenennen dieses Kontos würde es neu erstellen, wodurch das Passwort verloren ginge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read the current password, so the account was not renamed. Renaming this account recreates it, which would lose the password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la contraseña actual, así que la cuenta no se renombró. Al renombrar esta cuenta se vuelve a crear, lo que haría perder la contraseña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyistä salasanaa ei voitu lukea, joten tiliä ei nimetty uudelleen. Tilin uudelleennimeäminen luo sen uudelleen, jolloin salasana menetettäisiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le mot de passe actuel, le compte n’a donc pas été renommé. Renommer ce compte le recrée, ce qui ferait perdre le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere la password attuale, quindi l’account non è stato rinominato. Rinominare questo account lo ricrea, e la password andrebbe persa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のパスワードを読み取れなかったため、アカウント名は変更されませんでした。このアカウント名を変更するとアカウントが再作成され、パスワードが失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 암호를 읽을 수 없어 계정 이름을 변경하지 않았습니다. 이 계정의 이름을 변경하면 계정이 다시 생성되므로 암호가 손실됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese det gjeldende passordet, så kontoen fikk ikke nytt navn. Når kontoen får nytt navn, opprettes den på nytt, og passordet ville gått tapt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan het huidige wachtwoord niet lezen, dus de naam van het account is niet gewijzigd. Bij het wijzigen van de naam van dit account wordt het opnieuw aangemaakt, waardoor het wachtwoord verloren zou gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać bieżącego hasła, więc nie zmieniono nazwy konta. Zmiana nazwy tego konta tworzy je od nowa, co spowodowałoby utratę hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a senha atual, então a conta não foi renomeada. Renomear esta conta a recria, o que faria perder a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать текущий пароль, поэтому учётная запись не была переименована. Переименование этой учётной записи приводит к её пересозданию, что привело бы к потере пароля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuálne heslo sa nepodarilo prečítať, preto sa účet nepremenoval. Premenovaním tohto účtu sa účet vytvorí znova, čím by sa heslo stratilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutnega gesla ni bilo mogoče prebrati, zato račun ni bil preimenovan. Pri preimenovanju se račun znova ustvari, s tem pa bi geslo izgubili."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att läsa det aktuella lösenordet, så kontot bytte inte namn. När kontot byter namn skapas det på nytt, vilket skulle göra att lösenordet går förlorat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli parola okunamadığı için hesap yeniden adlandırılmadı. Bu hesabı yeniden adlandırmak hesabı yeniden oluşturur ve bu da parolanın kaybolmasına yol açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc mật khẩu hiện tại nên tài khoản chưa được đổi tên. Đổi tên tài khoản này sẽ tạo lại nó, điều đó sẽ làm mất mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取当前密码，因此账户未被重命名。重命名该账户会重新创建它，从而丢失密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取目前的密碼，因此帳號未重新命名。重新命名此帳號會將其重新建立，因而遺失密碼。"
          }
        }
      }
    },
    "PasswordManager.RequiredPlaceholder" : {
      "comment" : "Placeholder indicating the account name field is required",
      "extractionState" : "extracted_with_value",
      "localizations" : {
