    },
    "AdvancedSetting.smartCursorColorBgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorBgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert der intelligenten Cursorfarbe für die Hintergrundfarbe (0 bis 1).\n0 bedeutet, dass die Hintergrundfarbe des Cursors immer die Textfarbe der Zelle ist, während 1 bedeutet, dass sie immer Schwarz oder Weiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for background color (0 to 1).\n0 means the cursor’s background color will always be the cell’s text color, while 1 means it will always be black or white."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Cursor Colorの背景色のしきい値（0から1）。\n0はカーソルの背景色が常にセルのテキスト色になり、1は常に黒または白になることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경 색상에 대한 스마트 커서 색상의 임계값(0~1)입니다.\n0이면 커서의 배경 색상이 항상 셀의 텍스트 색상이 되고, 1이면 항상 검은색 또는 흰색이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor de plano de fundo (0 a 1).\n0 significa que a cor de plano de fundo do cursor será sempre a cor do texto da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог для функции «умный цвет курсора» (Smart Cursor Color) для цвета фона (от 0 до 1).\n0 означает, что цвет фона курсора всегда будет совпадать с цветом текста ячейки, а 1 — что он всегда будет чёрным или белым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景颜色智能光标颜色的阈值（0到1）。\n0表示光标背景颜色始终为单元格文本颜色，1则表示始终为黑色或白色。"
          }
        }
      }
    },
    "AdvancedSetting.smartCursorColorFgThreshold" : {
      "comment" : "Advanced setting: smartCursorColorFgThreshold",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellenwert der intelligenten Cursorfarbe für die Textfarbe (0 bis 1).\n0 bedeutet, dass die Textfarbe des Cursors immer die Hintergrundfarbe der Zelle ist, während 1 bedeutet, dass sie immer Schwarz oder Weiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold for Smart Cursor Color for text color (0 to 1).\n0 means the cursor’s text color will always be the cell’s background color, while 1 means it will always be black or white."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Cursor Colorのテキスト色のしきい値（0から1）。\n0はカーソルのテキスト色が常にセルの背景色になり、1は常に黒または白になることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 색상에 대한 스마트 커서 색상 임계값(0~1)\n0이면 커서의 텍스트 색상이 항상 셀의 배경색이 되고, 1이면 항상 검은색 또는 흰색이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor do texto (0 a 1).\n0 significa que a cor do texto do cursor será sempre a cor de plano de fundo da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог для функции «умный цвет курсора» (Smart Cursor Color) для цвета текста (от 0 до 1).\n0 означает, что цвет текста курсора всегда будет совпадать с цветом фона ячейки, а 1 — что он всегда будет чёрным или белым."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本颜色智能光标颜色的阈值（0到1）。\n0表示光标文本颜色始终为单元格背景颜色，1则表示始终为黑色或白色。"
          }
        }
      }
    },
    "AdvancedSetting.smartLoggingWithAutoComposer" : {
      "comment" : "Advanced setting: smartLoggingWithAutoComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompakteres Protokollieren bei Verwendung des Auto-Composers aktivieren?\nDadurch wird vermieden, dass Rohdaten Ihres Prompts und Ihrer Interaktionen damit protokolliert werden. Stattdessen wird der Prompt einmal als Klartext protokolliert und der Befehl beim Senden protokolliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable more compact logging when using auto composer?\nThis will avoid logging raw data in your prompt and your interactions with it. Instead, the prompt is logged once in plain text and the command is logged when sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Composer使用時、よりコンパクトなログ記録を有効にするか？\nこれによりプロンプトやそのやり取りの生データをログに残すことを避けられます。代わりに、プロンプトは一度だけプレーンテキストで記録され、コマンドは送信時に記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 컴포저를 사용할 때 더 간결한 로깅을 켜겠습니까?\n프롬프트의 원시 데이터와 프롬프트에서의 상호 작용을 로깅하지 않습니다. 대신 프롬프트는 일반 텍스트로 한 번 로깅되고 명령은 보낼 때 로깅됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar registro mais compacto ao usar o auto composer?\nIsso evitará registrar dados brutos no seu prompt e suas interações com ele. Em vez disso, o prompt é registrado uma vez em texto simples e o comando é registrado quando enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить более компактное журналирование при использовании Автокомпозера?\nЭто позволит избежать журналирования необработанных данных приглашения и взаимодействия с ним. Вместо этого приглашение записывается один раз в виде обычного текста, а команда — при отправке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自动生成器时是否启用更紧凑的日志？\n这将避免在提示词和您的交互中记录原始数据。相反，提示词以纯文本形式记录一次，命令在发送时记录。"
          }
        }
      }
    },
    "AdvancedSetting.smartSelectionRadius" : {
      "comment" : "Advanced setting: smartSelectionRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Zeilen vor und nach der Klickposition, die in die intelligente Auswahl einbezogen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of lines before and after the click location to include in smart selection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Selectionに含めるクリック位置の前後の最大行数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 선택에 포함할 클릭 위치 앞뒤의 최대 줄 수."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de linhas antes e depois do local do clique a incluir na seleção inteligente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное число строк до и после места щелчка, включаемых в умное выделение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击位置前后应包含的智能选取的最大行数。"
          }
        }
      }
    },
    "AdvancedSetting.solidUnderlines" : {
      "comment" : "Advanced setting: solidUnderlines",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchgehende Unterstreichungen verwenden?\nWenn deaktiviert, werden Unterstreichungen in der Nähe von Text unterbrochen, den sie sonst schneiden würden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use solid underlines?\nWhen disabled, underlines break near text that would intersect them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実線の下線を使用するか？\n無効にすると、下線と交差するテキストの近くで下線が途切れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실선 밑줄을 사용하겠습니까?\n비활성화하면 밑줄이 겹치는 텍스트 근처에서 밑줄이 끊깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar sublinhados contínuos?\nQuando desativado, os sublinhados são interrompidos perto de texto que os cruzaria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать сплошные подчёркивания?\nЕсли отключено, подчёркивания прерываются рядом с текстом, который они пересекали бы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用实线下划线？\n如果禁用，下划线会在与它们相交的文本附近中断。"
          }
        }
      }
    },
    "AdvancedSetting.splitPaneColor" : {
      "comment" : "Advanced setting: splitPaneColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Farbe für Trennlinien zwischen geteilten Bereichen. Leer lassen, um die Standardfarbe zu verwenden.\nDies sollte eine Farbe im HTML-Format sein, wie #aabbcc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom color for split pane dividers. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割ペインの区切り線のカスタム色。デフォルトの色を使用するには空欄のままにしてください。\n#aabbccのようなHTML形式の色を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분할 패널 구분선의 사용자 지정 색상. 기본 색상을 사용하려면 비워 두십시오.\n#aabbcc 같은 HTML 형식의 색상이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor personalizada para os divisores de painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский цвет разделителей панелей. Оставьте пустым, чтобы использовать цвет по умолчанию.\nЦвет должен быть в HTML-формате, например #aabbcc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分屏窗格分隔线的自定义颜色。留空则使用默认颜色。\n应为HTML风格的颜色，如#aabbcc。"
          }
        }
      }
    },
    "AdvancedSetting.splitPaneDividerWidth" : {
      "comment" : "Advanced setting: splitPaneDividerWidth",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Breite für Trennlinien zwischen geteilten Bereichen in Punkten (1–5). Auf 0 setzen, um die Standardbreite zu verwenden."
          }
        },
        "en" : {
