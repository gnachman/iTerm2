        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podkreślać elementy możliwe do wybrania w historii semantycznej pod kursorem podczas przytrzymywania ⌘?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
