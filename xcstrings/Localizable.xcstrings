    "AdvancedSetting.hotkeyTermAnimationDuration" : {
      "comment" : "Advanced setting: hotkeyTermAnimationDuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doba animace okna horké klávesy v sekundách.\nVarování: snížení této hodnoty může způsobit potíže, pokud máte více displejů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varighed i sekunder af animationen for genvejstastvinduet.\nAdvarsel: Hvis du nedsætter værdien, kan det give problemer, hvis du har flere skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer der Hotkey-Fenster-Animation in Sekunden.\nWarnung: Das Verringern dieses Werts kann bei mehreren Bildschirmen zu Problemen führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Duration in seconds of the hotkey window animation.\nWarning: reducing this value may cause problems if you have multiple displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración en segundos de la animación de la ventana de tecla rápida.\nAdvertencia: reducir este valor puede causar problemas si tienes varias pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikanäppäinikkunan animaation kesto sekunteina.\nVaroitus: tämän arvon pienentäminen voi aiheuttaa ongelmia, jos käytössäsi on useita näyttöjä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée en secondes de l’animation de la fenêtre à raccourci global.\nAttention : réduire cette valeur peut causer des problèmes si vous avez plusieurs écrans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata in secondi dell’animazione della finestra ad abbreviazione globale.\nAttenzione: ridurre questo valore può causare problemi se hai più display."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキーウィンドウのアニメーションの継続時間 (秒単位)。\n警告: この値を小さくすると、複数のディスプレイを使用している場合に問題が発生することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 윈도우 애니메이션 지속 시간(초).\n경고: 디스플레이가 여러 대인 경우 이 값을 줄이면 문제가 발생할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varighet i sekunder for animasjonen av hurtigtastvinduet.\nAdvarsel: Å redusere denne verdien kan skape problemer hvis du har flere skjermer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duur in seconden van de animatie van het sneltoetsvenster.\nWaarschuwing: het verlagen van deze waarde kan problemen veroorzaken als je meerdere beeldschermen hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas trwania animacji okna klawisza skrótu w sekundach.\nOstrzeżenie: zmniejszenie tej wartości może powodować problemy, jeśli masz wiele wyświetlaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duração em segundos da animação da janela Hotkey.\nAviso: reduzir este valor pode causar problemas se você tiver várias telas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длительность в секундах анимации окна горячей клавиши.\nПредупреждение: уменьшение этого значения может вызвать проблемы при нескольких дисплеях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvanie animácie okna aktivačnej skratky v sekundách.\nUpozornenie: zníženie tejto hodnoty môže spôsobiť problémy, ak máte viac displejov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajanje animacije okna hitre tipke v sekundah.\nOpozorilo: zmanjšanje te vrednosti lahko povzroči težave, če imate več zaslonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varaktighet i sekunder för animationen av snabbtangentsfönstret.\nVarning: att minska värdet kan orsaka problem om du har flera skärmar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşu penceresi animasyonunun saniye cinsinden süresi.\nUyarı: Birden çok ekranınız varsa bu değeri azaltmak sorunlara yol açabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời lượng tính bằng giây của hoạt ảnh cửa sổ phím nóng.\nCảnh báo: giảm giá trị này có thể gây sự cố nếu bạn có nhiều màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热键窗口动画的持续时间（以秒为单位）。\n警告：如果使用多显示器，降低此值可能会导致问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全域快速鍵視窗動畫的持續時間，以秒為單位。\n警告：如果你有多個顯示器，降低此值可能造成問題。"
          }
        }
      }
    },
    "AdvancedSetting.hotkeyWindowFloatsAboveOtherWindows" : {
      "comment" : "Advanced setting: hotkeyWindowFloatsAboveOtherWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno horké klávesy se vznáší nad ostatními okny, i když je aktivní jiná aplikace.\nAby bylo toto nastavení účinné, musíte vypnout „Nastavení > Klávesy > Okno horké klávesy se skryje při ztrátě fokusu“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genvejstastvinduet svæver over andre vinduer, også når et andet program er aktivt.\nDu skal slå “Indstillinger > Taster > Genvejstastvindue skjules, når fokus mistes” fra, for at denne indstilling virker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hotkey-Fenster schwebt auch dann über anderen Fenstern, wenn eine andere Anwendung aktiv ist.\nSie müssen „Einstellungen > Tasten > Hotkey-Fenster wird ausgeblendet, wenn der Fokus verloren geht“ deaktivieren, damit diese Einstellung wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The hotkey window floats above other windows even when another application is active.\nYou must disable “Settings > Keys > Hotkey window hides when focus is lost” for this setting to be effective."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana de tecla rápida flota sobre otras ventanas incluso cuando otra aplicación está activa.\nDebes desactivar “Ajustes > Teclas > La ventana de tecla rápida se oculta al perder el foco” para que este ajuste sea efectivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikanäppäinikkuna leijuu muiden ikkunoiden päällä, vaikka toinen sovellus olisi aktiivinen.\nAsetus ”Asetukset > Näppäimet > Pikanäppäinikkuna kätkeytyy, kun kohdistus menetetään” on poistettava käytöstä, jotta tämä asetus toimii."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre à raccourci global flotte au-dessus des autres fenêtres même quand une autre application est active.\nVous devez désactiver « Réglages > Touches > La fenêtre à raccourci global se masque quand elle perd le focus » pour que ce réglage soit effectif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra ad abbreviazione globale resta sopra le altre finestre anche quando un’altra applicazione è attiva.\nDevi disabilitare “Impostazioni > Tasti > La finestra ad abbreviazione globale si nasconde quando perde il focus” affinché questa impostazione sia efficace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキーウィンドウは、別のアプリケーションがアクティブな場合でも他のウィンドウの上に表示されます。\nこの設定を有効にするには、「設定 > キー > フォーカスを失うとホットキーウィンドウを隠す」を無効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 응용 프로그램이 활성화된 경우에도 단축키 윈도우가 다른 윈도우 위에 떠 있습니다.\n이 설정이 적용되려면 “설정 > 키 > 포커스를 잃으면 단축키 윈도우 가리기”를 꺼야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtigtastvinduet flyter over andre vinduer selv når en annen app er aktivt.\nDu må deaktivere «Innstillinger > Taster > Hurtigtastvinduet skjules når det mister fokus» for at denne innstillingen skal virke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sneltoetsvenster zweeft boven andere vensters, ook wanneer een andere app actief is.\nJe moet ‘Instellingen > Toetsen > Sneltoetsvenster wordt verborgen als de focus verloren gaat’ uitschakelen om deze instelling effectief te laten zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno klawisza skrótu unosi się nad innymi oknami, nawet gdy aktywna jest inna aplikacja.\nAby to ustawienie działało, musisz wyłączyć „Ustawienia > Klawisze > Okno klawisza skrótu ukrywa się po utracie fokusu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela Hotkey fica acima das outras janelas mesmo quando outro aplicativo está ativo.\nVocê precisa desativar “Ajustes > Teclas > A janela Hotkey se oculta ao perder o foco” para que este ajuste tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окно горячей клавиши плавает над другими окнами, даже когда активно другое приложение.\nЧтобы эта настройка подействовала, нужно отключить «Настройки → Клавиши → Окно горячей клавиши скрывается при потере фокуса»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno aktivačnej skratky sa vznáša nad ostatnými oknami, aj keď je aktívna iná apka.\nAby bolo toto nastavenie účinné, musíte vypnúť nastavenie „Nastavenia > Klávesy > Okno aktivačnej skratky sa skryje po strate fokusu“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno hitre tipke lebdi nad drugimi okni, tudi ko je aktivna druga aplikacija.\nDa ta nastavitev učinkuje, morate onemogočiti »Nastavitve > Tipke > Okno hitre tipke se skrije ob izgubi fokusa«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbtangentsfönstret flyter ovanför andra fönster även när ett annat program är aktivt.\nDu måste avaktivera ”Inställningar > Tangenter > Snabbtangentsfönstret göms när fokus förloras” för att den här inställningen ska ha effekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşu penceresi, başka bir uygulama etkinken bile diğer pencerelerin üstünde yüzer.\nBu ayarın etkili olması için “Ayarlar > Tuşlar > Odak kaybedildiğinde kısayol tuşu penceresini gizle” seçeneğini devre dışı bırakmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ phím nóng nổi trên các cửa sổ khác ngay cả khi ứng dụng khác đang hoạt động.\nBạn phải tắt “Cài đặt > Phím > Cửa sổ phím nóng ẩn khi mất tiêu điểm” để cài đặt này có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使有其他应用程序处于活动状态，热键窗口也会显示在其他窗口之上。\n要使此设置生效，必须先关闭“设置 > 键盘 > 失去焦点时隐藏热键窗口”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使另一個 App 在使用中，全域快速鍵視窗也浮在其他視窗上方。\n你必須停用「設定 > 按鍵 > 失去焦點時隱藏全域快速鍵視窗」，此設定才會有效。"
          }
        }
      }
    },
    "AdvancedSetting.hotkeyWindowsExcludedFromCycling" : {
      "comment" : "Advanced setting: hotkeyWindowsExcludedFromCycling",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okna horké klávesy jsou vyloučena z položky „Procházet okny“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genvejstastvinduer udelades fra Skift mellem vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotkey-Fenster werden bei „Durch Fenster wechseln“ ausgeschlossen."
          }
        },
        "en" : {
