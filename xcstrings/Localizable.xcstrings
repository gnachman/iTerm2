    "ChatViewController.NoLinkedSessionUserNoticeBrowser" : {
      "comment" : "Notice shown when AI tries to act but no web browser session is linked",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI se pokusila provést akci, ale s tímto chatem není propojena žádná relace webového prohlížeče, takže akce selhala."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI forsøgte at udføre en handling, men der er ikke knyttet nogen webbrowsersession til denne chat, så det mislykkedes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI hat versucht, eine Aktion auszuführen, aber diesem Chat ist keine Webbrowser-Sitzung verknüpft, daher ist sie fehlgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI attempted to perform an action, but no web browser session is linked to this chat so it failed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA intentó realizar una acción, pero no hay ninguna sesión de navegador web vinculada a este chat, por lo que falló."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI yritti suorittaa toiminnon, mutta tähän keskusteluun ei ole linkitetty verkkoselainistuntoa, joten se epäonnistui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA a tenté d’effectuer une action, mais aucune session de navigateur web n’est liée à ce chat, donc l’action a échoué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA ha tentato di eseguire un’azione, ma nessuna sessione del browser web è collegata a questa chat, quindi l’azione non è riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIが操作を実行しようとしましたが、このチャットにはWebブラウザセッションがリンクされていないため失敗しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 동작을 수행하려고 했지만 이 채팅에 연결된 웹 브라우저 세션이 없어 실패했습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI forsøkte å utføre en handling, men ingen nettleserøkt er koblet til denne chatten, så det mislyktes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AI probeerde een actie uit te voeren, maar er is geen webbrowsersessie aan deze chat gekoppeld, dus dit is mislukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI próbowało wykonać akcję, ale z tym czatem nie jest powiązana żadna sesja przeglądarki internetowej, więc się nie udało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA tentou realizar uma ação, mas nenhuma sessão de navegador da web está vinculada a este chat, então falhou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ попытался выполнить действие, но к этому чату не привязана сессия веб-браузера, поэтому попытка не удалась."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI sa pokúsila vykonať akciu, ale k tomuto chatu nie je prepojená žiadna relácia webového prehliadača, preto zlyhala."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI je poskusil izvesti dejanje, vendar s tem klepetom ni povezana nobena seja spletnega brskalnika, zato ni uspelo."
