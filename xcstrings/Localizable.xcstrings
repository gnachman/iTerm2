    "NaggingController.ReportVariableDenied" : {
      "comment" : "Prompt asking whether to allow reporting a variable in the future; placeholder is the variable name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požadavek na hlášení proměnné „%@“ byl zamítnut. Povolit to i v budoucnu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anmodning om at rapportere variablen “%@” blev afvist. Vil du tillade det fremover?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anfrage zum Melden der Variable „%@“ wurde abgelehnt. Dies zukünftig erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A request to report variable “%@” was denied. Allow it in the future?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó una solicitud para informar de la variable “%@”. ¿Permitirla en el futuro?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuttujan ”%@” raportointipyyntö evättiin. Sallitaanko se jatkossa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de signalement de la variable « %@ » a été refusée. L’autoriser à l’avenir ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una richiesta di segnalare la variabile “%@” è stata rifiutata. Consentirla in futuro?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変数「%@」を報告するリクエストが拒否されました。今後は許可しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변수 “%@”을(를) 보고하라는 요청이 거부되었습니다. 앞으로는 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En forespørsel om å rapportere variabelen «%@» ble avslått. Vil du tillate det i framtiden?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verzoek om variabele ‘%@’ te rapporteren is geweigerd. Wil je dit in de toekomst toestaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie raportowania zmiennej „%@” zostało odrzucone. Pozwalać na to w przyszłości?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma solicitação para relatar a variável “%@” foi recusada. Permitir no futuro?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос на отправку переменной «%@» был отклонён. Разрешить это в дальнейшем?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadosť o hlásenie premennej „%@“ bola zamietnutá. Povoliť ju v budúcnosti?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahteva za poročanje spremenljivke »%@« je bila zavrnjena. Želite to dovoliti v prihodnje?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En begäran om att rapportera variabeln ”%@” nekades. Vill du tillåta den i framtiden?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” değişkenini raporlama isteği reddedildi. Gelecekte buna izin verilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu báo cáo biến “%@” đã bị từ chối. Cho phép trong tương lai?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
