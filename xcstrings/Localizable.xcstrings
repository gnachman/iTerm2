    "RemotePreferences.SyncDataFilesPrompt" : {
      "comment" : "Prompt asking whether to also sync data files to the settings folder; %@ is the folder path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann außerdem Ihre Schnipsel, globalen Notizen und Sitzungssymbol-Anpassungen im Einstellungsordner „%@“ aufbewahren, damit sie zwischen Rechnern synchronisiert werden. Notizen und Schnipsel können vertrauliche Texte wie Passwörter oder Tokens enthalten. Sollen auch diese synchronisiert werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can also keep your snippets, global notes, and session icon customizations in the settings folder “%@” so they sync across machines. Notes and snippets can contain sensitive text such as passwords or tokens. Sync them too?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 también puede guardar tus fragmentos, notas globales y personalizaciones de iconos de sesión en la carpeta de ajustes “%@” para que se sincronicen entre equipos. Las notas y los fragmentos pueden contener texto sensible, como contraseñas o tokens. ¿Sincronizarlos también?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut aussi conserver vos extraits, notes globales et personnalisations d’icônes de session dans le dossier de réglages « %@ » pour les synchroniser entre vos machines. Les notes et extraits peuvent contenir du texte sensible, comme des mots de passe ou des jetons. Les synchroniser aussi ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può anche conservare i tuoi frammenti, le note globali e le personalizzazioni delle icone delle sessioni nella cartella delle impostazioni “%@”, così da sincronizzarli tra computer. Note e frammenti possono contenere testo sensibile come password o token. Sincronizzare anche questi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 では、スニペット、グローバルメモ、セッションアイコンのカスタマイズも設定フォルダ「%@」に保存し、複数のマシン間で同期することができます。メモやスニペットにはパスワードやトークンなどの機密情報が含まれる場合があります。これらも同期しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 스니펫, 전역 메모, 세션 아이콘 사용자화도 설정 폴더 “%@”에 보관하여 여러 컴퓨터 간에 동기화할 수 있습니다. 메모와 스니펫에는 암호나 토큰 같은 민감한 텍스트가 포함될 수 있습니다. 이것들도 동기화하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 também pode manter seus Fragmentos, notas globais e personalizações de ícone de sessão na pasta de ajustes “%@” para que sejam sincronizados entre máquinas. Notas e Fragmentos podem conter texto sensível, como senhas ou tokens. Sincronizá-los também?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 также может хранить ваши сниппеты, глобальные заметки и настройки значков сеансов в папке настроек «%@», чтобы синхронизировать их между компьютерами. Заметки и сниппеты могут содержать конфиденциальные данные, такие как пароли или токены. Синхронизировать их тоже?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, parçacıklarınızı, genel notlarınızı ve oturum simgesi özelleştirmelerinizi makineler arasında eşitlenmeleri için “%@” ayar klasöründe de tutabilir. Notlar ve parçacıklar parola veya token gibi hassas metinler içerebilir. Bunlar da eşitlensin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 还可以将你的代码片段、全局笔记和会话图标自定义项保存在设置文件夹“%@”中，以便在机器之间同步。笔记和代码片段可能包含密码或令牌等敏感文本。也同步它们？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 也可以將你的片段、全域備註和工作階段圖像自訂內容保存在設定檔案夾「%@」中，以便在多部電腦之間同步。備註和片段可能含有密碼或權杖等敏感文字。要一併同步嗎？"
          }
        }
      }
    },
