    "AdvancedSetting.useShortcutAccessoryViewController" : {
      "comment" : "Advanced setting: useShortcutAccessoryViewController",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit číslo okna v příslušenství záhlaví?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis vinduesnummeret i titellinjens tilbehør?"
