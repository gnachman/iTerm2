          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro iTerm2 conectado a esta sessão do tmux está configurando um grupo de trabalho. Este está aguardando que ele termine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другой экземпляр iTerm2, подключённый к этой сессии tmux, настраивает рабочую группу. Этот экземпляр ждёт завершения."
