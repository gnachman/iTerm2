    "AdvancedSetting.restoreWindowContents" : {
      "comment" : "Advanced setting: restoreWindowContents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fensterinhalte beim Start wiederherstellen.\nDies erfordert, dass „Systemeinstellungen > Schreibtisch & Dock > Fenster beim Beenden einer App schließen“ deaktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Restore window contents at startup.\nThis requires “System Settings > Desktop & Dock > Close windows when quitting an app” to be off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にウィンドウの内容を復元する。\nこれには「システム設定 > デスクトップとDock > アプリケーション終了時にウィンドウを閉じる」がオフになっている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시동 시 윈도우 내용 복원\n“시스템 설정 > 데스크탑 및 Dock > 앱 종료 시 윈도우 닫기”가 꺼져 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar o conteúdo das janelas na inicialização.\nIsto requer que “Ajustes do Sistema > Mesa e Dock > Fechar janelas ao encerrar um app” esteja desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливать содержимое окон при запуске.\nДля этого параметр «Системные настройки > Рабочий стол и Dock > Закрывать окна при выходе из приложения» должен быть выключен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时是否恢复窗口内容。\n这要求“系统设置 > 桌面与 Dock > 关闭应用时窗口”选项被禁用。"
          }
        }
      }
    },
    "AdvancedSetting.restoreWindowsWithinScreens" : {
      "comment" : "Advanced setting: restoreWindowsWithinScreens",
      "extractionState" : "extracted_with_value",
      "localizations" : {
