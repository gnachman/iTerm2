        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trackpad rola rápido?\nDefina como Não para a velocidade de rolagem legada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая прокрутка трекпадом?\nУстановите «Нет» для прежней скорости прокрутки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rýchle rolovanie trackpadom?\nNastavte Nie pre pôvodnú rýchlosť rolovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledilna ploščica se pomika hitro?\nNastavite na Ne za podedovano hitrost pomikanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullar styrplattan snabbt?\nAnge Nej för äldre rullningshastighet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme dörtgeni hızlı kaydırsın mı?\nEski kaydırma hızı için Hayır yapın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bàn di chuột cuộn nhanh?\nĐặt là Không để dùng tốc độ cuộn cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触控板滚动速度过快？\n如需恢复旧版滚动速度，请设置为“否”。"
