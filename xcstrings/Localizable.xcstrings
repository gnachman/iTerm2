    "JobTerminationMonitor.CannotWatchJob" : {
      "comment" : "Alert body when a process cannot be watched because it already exited",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann den Prozess %1$@ mit der Prozess-ID %2$@ nicht überwachen, da er bereits beendet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 cannot watch the job %1$@ with process ID %2$@ because it has already terminated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no puede vigilar el proceso %1$@ con ID de proceso %2$@ porque ya ha terminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne peut pas surveiller le processus %1$@ (ID de processus %2$@), car il est déjà terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non può monitorare il processo %1$@ con ID processo %2$@ perché è già terminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブ %1$@（プロセス ID %2$@）はすでに終了しているため、iTerm2 は監視できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 %1$@(프로세스 ID %2$@)이(가) 이미 종료되어 iTerm2가 감시할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não pode monitorar o processo %1$@ com ID de processo %2$@ porque ele já foi encerrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может отслеживать задачу %1$@ с ID процесса %2$@, так как она уже завершилась."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, işlem kimliği %2$@ olan %1$@ işlemini izleyemiyor çünkü işlem zaten sonlandı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 无法监视进程 ID %2$@ 的作业 %1$@，因为该作业已终止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 無法監看程序 ID 為 %2$@ 的程序 %1$@，因為它已終止。"
          }
        }
      }
    },
