          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir a notificação que pergunta se você deseja desativar o relato de redimensionamento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить уведомление с вопросом, хотите ли вы отключить сообщение об изменении размера"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden boyutlandırma raporlamasını devre dışı bırakmak isteyip istemediğinizi soran bildirimi bir daha gösterme"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制询问是否禁用调整大小报告的提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示詢問是否停用調整大小回報的通知"
          }
        }
      }
    },
    "AdvancedSetting.noSyncNeverAskAboutMouseReportingFrustration" : {
      "comment" : "Advanced setting: noSyncNeverAskAboutMouseReportingFrustration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Benachrichtigung unterdrücken, die nach einem Ziehen gefolgt von Cmd-C bei aktivierter Mausmeldung angezeigt wird und fragt, ob Sie die Mausmeldung deaktivieren möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress the notification asking if you want to disable mouse reporting that is shown after a drag followed by Cmd-C when mouse reporting is on?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Suprimir la notificación que pregunta si quieres desactivar el informe del ratón, que se muestra tras un arrastre seguido de Cmd-C cuando el informe del ratón está activado?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver la notification demandant si vous voulez désactiver le signalement de la souris, affichée après un glissement suivi de Cmd-C lorsque le signalement de la souris est activé ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivare la notifica che chiede se vuoi disabilitare la segnalazione del mouse, mostrata dopo un trascinamento seguito da Cmd-C quando la segnalazione del mouse è attiva?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウス報告が有効な状態でドラッグの後にCmd-Cを行った際に表示される、マウス報告を無効にするかどうかを尋ねる通知を表示しない？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅이 켜져 있을 때 드래그 후 Cmd-C를 누르면 표시되는, 마우스 리포팅을 끌지 묻는 알림을 숨기겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir a notificação que pergunta se você deseja desativar o relato de mouse, exibida após um arrasto seguido de Cmd-C quando o relato de mouse está ativado?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить уведомление с вопросом, хотите ли вы отключить сообщения о мыши, которое показывается после перетаскивания и последующего Cmd-C, если сообщения о мыши включены?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare raporlaması açıkken bir sürüklemenin ardından Cmd-C yapıldığında görünen, fare raporlamasını devre dışı bırakmak isteyip istemediğinizi soran bildirim bir daha gösterilmesin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制在鼠标报告开启后，拖拽后按Cmd-C显示的鼠标报告禁用提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示詢問是否停用滑鼠回報的通知（滑鼠回報開啟時，拖移後按 Cmd-C 會顯示此通知）？"
          }
        }
      }
    },
