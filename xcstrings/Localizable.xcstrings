    "SuppressedAlerts.ShowRememberedTooltip" : {
      "comment" : "Tooltip explaining the always-show-remembered-alerts checkbox",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie in einer Warnung „Meine Auswahl merken“ oder „Diese Meldung dauerhaft unterdrücken“ aktivieren, zeigt iTerm2 sie nicht mehr an und verwendet stattdessen Ihre gespeicherte Antwort. Aktivieren Sie diese Option, um solche Warnungen wieder anzuzeigen, damit Sie sie sehen oder anders entscheiden können. Die Option bleibt aktiviert, bis Sie sie wieder deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you check “Remember my choice” or “Suppress this message permanently” in an alert, iTerm2 stops showing it and reuses your saved response. Turn this on to show those alerts again so you can see them or choose differently. It stays on until you turn it off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラートで「この選択を記憶する」または「このメッセージを今後表示しない」にチェックを入れると、iTerm2 はそのアラートを表示しなくなり、保存された応答を再利用します。これをオンにすると、それらのアラートを再び表示できるようになり、確認したり選択し直したりできます。オフにするまでオンのままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고에서 “내 선택 기억하기” 또는 “이 메시지를 영구적으로 표시 안 함”을 선택하면 iTerm2는 해당 경고를 더 이상 표시하지 않고 저장된 응답을 재사용합니다. 이 경고를 다시 보거나 다르게 선택하려면 이 옵션을 켜십시오. 끌 때까지 계속 켜져 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você marca “Memorizar minha escolha” ou “Suprimir esta mensagem permanentemente” em um alerta, o iTerm2 para de mostrá-lo e reutiliza sua resposta salva. Ative isto para mostrar esses alertas novamente, de modo que você possa vê-los ou escolher de forma diferente. Permanece ativado até que você o desative."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы отмечаете «Запомнить мой выбор» или «Больше не показывать это сообщение» в оповещении, iTerm2 перестаёт его показывать и использует сохранённый ответ. Включите этот параметр, чтобы снова видеть такие оповещения и при желании выбирать другой ответ. Он остаётся включённым, пока вы его не отключите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在提醒中勾选“记住我的选择”或“永久抑制此消息”时，iTerm2 将不再显示它，并复用你保存的答复。开启此选项可再次显示这些提醒，以便你查看或做出不同选择。此选项会一直保持开启，直到你将其关闭。"
          }
        }
      }
    },
    "SuppressedAlerts.ShowRememberedTooltipWithAnnouncements" : {
      "comment" : "Tooltip explaining the always-show-remembered-alerts checkbox",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie in einer Warnung „Meine Auswahl merken“ oder „Diese Meldung dauerhaft unterdrücken“ aktivieren oder in einem Hinweis eine Option wie „Immer“ oder „Nicht erneut fragen“ wählen, zeigt iTerm2 sie nicht mehr an und verwendet stattdessen Ihre gespeicherte Antwort. Aktivieren Sie diese Option, um solche Warnungen und Hinweise wieder anzuzeigen, damit Sie sie sehen oder anders entscheiden können. Die Option bleibt aktiviert, bis Sie sie wieder deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you check “Remember my choice” or “Suppress this message permanently” in an alert, or choose an option like “Always” or “Don’t Ask Again” in an announcement, iTerm2 stops showing it and reuses your saved response. Turn this on to show those alerts and announcements again so you can see them or choose differently. It stays on until you turn it off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando marcas “Recordar mi elección” o “Suprimir este mensaje permanentemente” en una alerta, o eliges una opción como “Siempre” o “No volver a preguntar” en un anuncio, iTerm2 deja de mostrarlo y reutiliza tu respuesta guardada. Activa esto para volver a mostrar esas alertas y anuncios, de modo que puedas verlos o elegir de otra manera. Permanece activado hasta que lo desactives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous cochez « Mémoriser mon choix » ou « Ne plus afficher ce message » dans une alerte, ou choisissez une option comme « Toujours » ou « Ne plus demander » dans une annonce, iTerm2 cesse de l’afficher et réutilise votre réponse enregistrée. Activez cette option pour afficher de nouveau ces alertes et annonces afin de les voir ou de choisir autrement. Elle reste activée jusqu’à ce que vous la désactiviez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selezioni “Ricorda la mia scelta” o “Disattiva questo messaggio in modo permanente” in un avviso, oppure scegli un’opzione come “Sempre” o “Non chiedere più” in un annuncio, iTerm2 smette di mostrarlo e riutilizza la risposta salvata. Attiva questa opzione per mostrare di nuovo tali avvisi e annunci, così potrai vederli o scegliere diversamente. Resta attiva finché non la disattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラートで「この選択を記憶する」または「このメッセージを今後表示しない」にチェックを入れるか、通知で「常に」や「今後確認しない」などのオプションを選択すると、iTerm2 はそれを表示しなくなり、保存された応答を再利用します。これをオンにすると、それらのアラートと通知を再び表示できるようになり、確認したり選択し直したりできます。オフにするまでオンのままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고에서 “내 선택 기억하기” 또는 “이 메시지를 영구적으로 표시 안 함”을 선택하거나 공지에서 “항상”이나 “다시 묻지 않음” 같은 옵션을 선택하면 iTerm2는 해당 항목을 더 이상 표시하지 않고 저장된 응답을 재사용합니다. 이 경고와 공지를 다시 보거나 다르게 선택하려면 이 옵션을 켜십시오. 끌 때까지 계속 켜져 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você marca “Memorizar minha escolha” ou “Suprimir esta mensagem permanentemente” em um alerta, ou escolhe uma opção como “Sempre” ou “Não perguntar novamente” em um aviso, o iTerm2 para de mostrá-lo e reutiliza sua resposta salva. Ative isto para mostrar esses alertas e avisos novamente, de modo que você possa vê-los ou escolher de forma diferente. Permanece ativado até que você o desative."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы отмечаете «Запомнить мой выбор» или «Больше не показывать это сообщение» в оповещении или выбираете вариант вроде «Всегда» или «Больше не спрашивать» в уведомлении, iTerm2 перестаёт его показывать и использует сохранённый ответ. Включите этот параметр, чтобы снова видеть такие оповещения и уведомления и при желании выбирать другой ответ. Он остаётся включённым, пока вы его не отключите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uyarıda “Seçimimi hatırla” veya “Bu mesajı kalıcı olarak gizle” seçeneğini işaretlediğinizde ya da bir duyuruda “Her Zaman” veya “Bir Daha Sorma” gibi bir seçenek belirlediğinizde iTerm2 bunu göstermeyi bırakır ve kayıtlı yanıtınızı kullanır. Bu uyarıları ve duyuruları yeniden görmek veya farklı bir seçim yapmak için bunu açın. Siz kapatana kadar açık kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在提醒中勾选“记住我的选择”或“永久抑制此消息”，或在提示中选择“始终”或“不再询问”等选项时，iTerm2 将不再显示它，并复用你保存的答复。开启此选项可再次显示这些提醒和提示，以便你查看或做出不同选择。此选项会一直保持开启，直到你将其关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你在警示中勾選「記住我的選擇」或「永久不再顯示此訊息」，或在公告中選擇「一律」或「不要再詢問」等選項時，iTerm2 就不會再顯示它，並會重複使用你儲存的回應。開啟此選項可再次顯示這些警示和公告，讓你能查看或改選其他選項。此選項會保持開啟，直到你將它關閉。"
          }
        }
      }
    },
