    "PTYSession.ForceDetachPending" : {
      "comment" : "Alert body explaining a detach request is pending and asking whether to force detach",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předchozí požadavek na odpojení dosud nebyl vyřízen. Vynutit odpojení?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidligere anmodning om frakobling er endnu ikke blevet efterkommet. Vil du gennemtvinge frakoblingen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vorherige Trennungsanfrage wurde noch nicht ausgeführt. Trennung erzwingen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A previous detach request has not yet been honored. Force detach?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una solicitud de desconexión anterior aún no se ha atendido. ¿Forzar la desconexión?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiempaa irrotuspyyntöä ei ole vielä käsitelty. Pakotetaanko irrotus?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de détachement précédente n’a pas encore été honorée. Forcer le détachement ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una precedente richiesta di scollegamento non è ancora stata soddisfatta. Vuoi forzare lo scollegamento?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のデタッチ要求がまだ処理されていません。強制的にデタッチしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 분리 요청이 아직 처리되지 않았습니다. 강제로 분리하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tidligere frakoblingsforespørsel er ennå ikke utført. Vil du tvinge frakobling?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
