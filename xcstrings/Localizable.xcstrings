    "Tip.0068.Body" : {
      "comment" : "Tip of the day body, id 0068",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novinka ve verzi 3.1: Okno horké klávesy můžete nastavit tak, aby se zobrazilo nad okny jiných aplikací v režimu celé obrazovky. Zapněte „Plovoucí okno“ v „Nastavení > Profily > Klávesy > Nastavit okno horké klávesy“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyt i 3.1: Du kan indstille dit genvejstastvindue til at vises over andre apps’ fuldskærmsvinduer. Slå “Flydende vindue” til i “Indstillinger > Profiler > Taster > Tilpas genvejstastvindue”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in 3.1: Sie können Ihr Hotkey-Fenster so konfigurieren, dass es über den Vollbildfenstern anderer Apps erscheint. Aktivieren Sie „Schwebendes Fenster“ unter „Einstellungen > Profile > Tasten > Hotkey-Fenster anpassen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can configure your hotkey window to appear over other apps’ full screen windows. Turn on “Floating Window” in “Settings > Profiles > Keys > Customize Hotkey Window.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novedad en la 3.1: puedes configurar tu ventana de tecla rápida para que aparezca sobre las ventanas a pantalla completa de otras apps. Activa “Ventana flotante” en “Ajustes > Perfiles > Teclas > Personalizar ventana de tecla rápida”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uutta versiossa 3.1: voit määrittää pikanäppäinikkunasi näkymään muiden sovellusten koko näytön ikkunoiden päällä. Ota käyttöön ”Kelluva ikkuna” kohdassa ”Asetukset > Profiilit > Näppäimet > Mukauta pikanäppäinikkunaa”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau dans la version 3.1 : vous pouvez configurer votre fenêtre à raccourci global pour qu’elle apparaisse au-dessus des fenêtres en plein écran d’autres apps. Activez « Fenêtre flottante » dans « Réglages > Profils > Touches > Configurer la fenêtre à raccourci global »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novità della 3.1: puoi configurare la finestra ad abbreviazione globale in modo che compaia sopra le finestre a tutto schermo di altre app. Attiva “Finestra mobile” in “Impostazioni > Profili > Tasti > Configura finestra ad abbreviazione globale”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1の新機能: ホットキーウィンドウを他のアプリのフルスクリーンウィンドウの上に表示するよう設定できます。「設定 > プロファイル > キー > ホットキーウィンドウをカスタマイズ」で「フローティングウィンドウ」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1의 새로운 기능: 단축키 윈도우가 다른 앱의 전체 화면 윈도우 위에 나타나도록 구성할 수 있습니다. “설정 > 프로파일 > 키 > 단축키 윈도우 사용자화”에서 “플로팅 윈도우”를 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nytt i 3.1: Du kan konfigurere hurtigtastvinduet til å vises over fullskjermvinduer i andre apper. Slå på «Flytende vindu» i «Innstillinger > Profiler > Taster > Tilpass hurtigtastvindu»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuw in 3.1: je kunt je sneltoetsvenster laten verschijnen boven schermvullende vensters van andere apps. Schakel ‘Zwevend venster’ in via ‘Instellingen > Profielen > Toetsen > Pas sneltoetsvenster aan’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowość w 3.1: możesz skonfigurować okno klawisza skrótu tak, aby pojawiało się nad pełnoekranowymi oknami innych aplikacji. Włącz „Okno pływające” w „Ustawienia > Profile > Klawisze > Dostosuj okno klawisza skrótu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode configurar sua janela de atalho para aparecer sobre as janelas de tela cheia de outros apps. Ative “Janela flutuante” em “Ajustes > Perfis > Teclas > Personalizar janela de atalho”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое в 3.1: вы можете настроить окно горячих клавиш так, чтобы оно появлялось поверх полноэкранных окон других приложений. Включите «Плавающее окно» в «Настройки > Профили > Клавиши > Настроить окно горячих клавиш»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novinka v 3.1: Okno aktivačnej skratky môžete nastaviť tak, aby sa zobrazovalo nad oknami iných apiek na celej obrazovke. Zapnite „Plávajúce okno“ v časti „Nastavenia > Profily > Klávesy > Prispôsobiť okno aktivačnej skratky“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novo v 3.1: okno hitre tipke lahko nastavite tako, da se prikaže prek celozaslonskih oken drugih aplikacij. Vklopite »Plavajoče okno« v »Nastavitve > Profili > Tipke > Prilagodi okno hitre tipke«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nytt i 3.1: Du kan ställa in att ditt snabbtangentsfönster ska visas över andra apparnas helskärmsfönster. Slå på ”Flytande fönster” i ”Inställningar > Profiler > Tangenter > Konfigurera snabbtangentsfönster”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1’de yeni: Kısayol tuşu pencerenizi diğer uygulamaların tam ekran pencerelerinin üzerinde görünecek şekilde yapılandırabilirsiniz. “Ayarlar > Profiller > Tuşlar > Kısayol Tuşu Penceresini Özelleştir” bölümünde “Yüzen pencere”yi açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mới trong 3.1: Bạn có thể cấu hình cửa sổ phím nóng để hiện trên các cửa sổ toàn màn hình của ứng dụng khác. Bật “Cửa sổ nổi” trong “Cài đặt > Hồ sơ > Phím > Tùy chỉnh cửa sổ phím nóng.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1新功能：你可以将热键窗口配置为在其他应用程序全屏窗口上方显示。在“设置 > 配置文件 > 按键 > 自定义热键窗口”中开启“浮动窗口”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1 新功能：你可以設定讓全域快速鍵視窗顯示在其他 App 的全螢幕視窗上方。在「設定 > 描述檔 > 按鍵 > 自訂全域快速鍵視窗」中開啟「浮動視窗」。"
          }
        }
      }
    },
