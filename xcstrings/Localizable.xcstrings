    "GeneralPrefs.PromptEngageExplanation" : {
      "comment" : "Explanation of the ai.prompt variable in the AI prompt editor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při komunikaci s AI jej nahradí zadaný dotaz. Například: „Napiš příkaz unixu, který \\(ai.prompt).“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forespørgsel, du skriver, erstatter den, når der tales med AI. Eksempel: “Skriv en unix-kommando til at \\(ai.prompt).”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die von Ihnen eingegebene Abfrage ersetzt diesen Wert, wenn mit der KI gesprochen wird. Zum Beispiel: „Schreibe einen Unix-Befehl für \\(ai.prompt).“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\(ai.prompt).”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La consulta que introduzcas lo sustituirá al hablar con la IA. Por ejemplo: “Escribe un comando de unix para \\(ai.prompt).”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoittamasi kysely korvaa sen puhuttaessa AI:lle. Esimerkki: ”Kirjoita unix-komento tehtävään: \\(ai.prompt).”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête que vous saisissez le remplacera lors de l’échange avec l’IA. Par exemple : « Écrivez une commande unix pour \\(ai.prompt). »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta che inserisci lo sostituirà quando si parla con l’IA. Ad esempio: “Scrivi un comando unix per \\(ai.prompt).”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI との対話時に、入力したクエリがこれに置き換わります。例:「Write a unix command to \\(ai.prompt).」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI와 대화할 때 입력한 질의가 이 자리에 들어갑니다. 예: “\\(ai.prompt) 작업을 수행하는 unix 명령을 작성하십시오.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørringen du skriver inn, erstatter den når det snakkes med KI-en. Eksempel: «Skriv en unix-kommando for å \\(ai.prompt).»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De zoekopdracht die je invoert vervangt dit bij het praten met de AI. Bijvoorbeeld: ‘Schrijf een unix-commando om \\(ai.prompt).’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisane zapytanie zastąpi go podczas rozmowy z AI. Na przykład: „Napisz polecenie unix, które \\(ai.prompt).”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consulta que você digitar irá substituí-lo ao falar com a IA. Por exemplo: “Escreva um comando unix para \\(ai.prompt).”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введенный вами запрос заменит это значение при обращении к ИИ. Например: «Напишите команду unix для \\(ai.prompt).»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri komunikácii s AI ho nahradí zadaný dotaz. Napríklad: „Napíš príkaz unixu, ktorý \\(ai.prompt).“"
          }
        },
        "sl" : {
          "stringUnit" : {
