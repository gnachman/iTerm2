    "AddTrigger.LeaderOnlyTooltip" : {
      "comment" : "Tooltip explaining the leader-only trigger option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, löst der Trigger nur beim Leiter der Arbeitsgruppe aus (der Sitzung, die die Arbeitsgruppe ursprünglich betreten hat). Peers wie die Sitzungen für Code-Review und Diff lösen nicht aus, sodass das Neuladen oder Beenden einer solchen Sitzung die Arbeitsgruppe geöffnet lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When set, the trigger fires only for the workgroup leader (the session that originally entered the workgroup). Peers such as the Code Review and Diff sessions do not, so reloading or quitting one keeps the workgroup open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定すると、トリガーはワークグループリーダー（最初にワークグループに参加したセッション）に対してのみ発動します。コードレビューやDiffセッションなどのピアは対象外なので、それらを再読み込みまたは終了してもワークグループは開いたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정하면 트리거가 워크그룹 리더(처음 워크그룹에 진입한 세션)에서만 실행됩니다. 코드 리뷰 및 Diff 세션 같은 피어에서는 실행되지 않으므로 그중 하나를 다시 로드하거나 종료해도 워크그룹이 열린 상태로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando definido, o gatilho é acionado apenas para o líder do grupo de trabalho (a sessão que originalmente entrou no grupo de trabalho). Sessões pares, como as de Revisão de código e Diff, não são acionadas, portanto recarregar ou encerrar uma delas mantém o grupo de trabalho aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр установлен, триггер срабатывает только для лидера рабочей группы (сессии, которая изначально вошла в рабочую группу). Для равноправных участников, таких как сессии Code Review и Diff, он не срабатывает, поэтому перезагрузка или завершение одной из них не закрывает рабочую группу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置后，触发器仅在工作组主导者（最初进入工作组的会话）上触发。代码审查和差异等对等会话不会触发，因此重新载入或退出其中一个会话不会关闭工作组。"
          }
        }
      }
    },
