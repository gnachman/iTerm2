    "ClaudeCode.HookCommandsKeptBody" : {
      "comment" : "Body shown after uninstalling when some Claude Code hook commands were not removed. The first interpolated value is the absolute path to settings.json; the second is the list of hook commands, one per line, shown verbatim",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé příkazy hooků v souboru %1$@ odkazují na stavový hook iTerm2, ale spouštějí i jiné programy, proto je odinstalace neodstranila. Pokud je už nechcete, upravte soubor ručně:\n\n%2$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle hook-kommandoer i %1$@ henviser til statushooket for iTerm2, men kører også andre programmer, så afinstallationen fjernede dem ikke. Hvis du ikke vil have dem mere, kan du redigere arkivet manuelt:\n\n%2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Hook-Befehle in %1$@ verweisen auf den Status-Hook von iTerm2, führen aber auch andere Programme aus, daher hat „Deinstallieren“ sie nicht entfernt. Wenn Sie sie nicht mehr benötigen, bearbeiten Sie die Datei von Hand:\n\n%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some hook commands in %1$@ refer to iTerm2’s status hook but also run other programs, so Uninstall didn’t remove them. If you don’t want them anymore, edit the file by hand:\n\n%2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos comandos de hook de %1$@ hacen referencia al hook de estado de iTerm2, pero también ejecutan otros programas, por lo que la desinstalación no los eliminó. Si ya no los quieres, edita el archivo a mano:\n\n%2$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin tiedoston %1$@ koukkukomennot viittaavat iTerm2:n tilakoukkuun mutta suorittavat myös muita ohjelmia, joten asennuksen poisto ei poistanut niitä. Jos et enää halua niitä, muokkaa tiedostoa käsin:\n\n%2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines commandes de hook dans %1$@ font référence au hook d’état d’iTerm2 mais exécutent aussi d’autres programmes, donc la désinstallation ne les a pas supprimées. Si vous n’en voulez plus, modifiez le fichier à la main :\n\n%2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni comandi hook in %1$@ fanno riferimento all’hook di stato di iTerm2 ma eseguono anche altri programmi, quindi la disinstallazione non li ha rimossi. Se non li vuoi più, modifica il file a mano:\n\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 内の一部のフックコマンドはiTerm2のステータスフックを参照していますが、他のプログラムも実行するため、アンインストールでは削除されませんでした。不要な場合は、ファイルを手動で編集してください:\n\n%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 일부 훅 명령은 iTerm2의 상태 훅을 참조하지만 다른 프로그램도 실행하므로 제거 과정에서 삭제되지 않았습니다. 더 이상 필요하지 않다면 파일을 직접 편집하십시오:\n\n%2$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen hook-kommandoer i %1$@ viser til iTerm2s statushook, men kjører også andre programmer, så avinstalleringen fjernet dem ikke. Hvis du ikke vil ha dem lenger, redigerer du filen manuelt:\n\n%2$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige hookcommando’s in %1$@ verwijzen naar de statushook van iTerm2 maar voeren ook andere programma’s uit, dus ‘Verwijder installatie’ heeft ze niet verwijderd. Als je ze niet meer wilt, wijzig je het bestand met de hand:\n\n%2$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre polecenia haków w %1$@ odwołują się do haka stanu iTerm2, ale uruchamiają też inne programy, więc odinstalowanie ich nie usunęło. Jeśli już ich nie chcesz, edytuj plik ręcznie:\n\n%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns comandos de hook em %1$@ fazem referência ao hook de status do iTerm2, mas também executam outros programas, por isso a desinstalação não os removeu. Se você não os quiser mais, edite o arquivo manualmente:\n\n%2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые команды хуков в %1$@ ссылаются на хук статуса iTerm2, но также запускают другие программы, поэтому при удалении они не были удалены. Если они вам больше не нужны, отредактируйте файл вручную:\n\n%2$@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré príkazy hooku v %1$@ odkazujú na stavový hook iTerm2, ale spúšťajú aj iné programy, preto ich odinštalovanie neodstránilo. Ak ich už nechcete, upravte súbor ručne:\n\n%2$@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekateri ukazi kavlja v datoteki %1$@ se sklicujejo na kavelj stanja iTerm2, vendar zaženejo tudi druge programe, zato jih odstranitev ni odstranila. Če jih ne želite več, datoteko uredite ročno:\n\n%2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa hook-kommandon i %1$@ avser iTerm2:s statushook men kör även andra program, så avinstallationen tog inte bort dem. Om du inte vill ha dem kvar redigerar du filen för hand:\n\n%2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dosyasındaki bazı kanca komutları iTerm2’nin durum kancasına başvuruyor ancak başka programlar da çalıştırıyor; bu yüzden Kaldır bunları silmedi. Artık istemiyorsanız dosyayı elle düzenleyin:\n\n%2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số lệnh hook trong %1$@ tham chiếu đến hook trạng thái của iTerm2 nhưng cũng chạy các chương trình khác, nên việc gỡ cài đặt không xóa chúng. Nếu không cần nữa, hãy sửa tệp bằng tay:\n\n%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的部分钩子命令引用了 iTerm2 的状态钩子，但也会运行其他程序，因此卸载时未将其移除。如果不再需要，请手动编辑该文件：\n\n%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 中的部分 hook 指令參照了 iTerm2 的狀態 hook，但也會執行其他程式，因此解除安裝時並未移除。如果不再需要，請手動編輯該檔案：\n\n%2$@"
          }
        }
      }
    },
