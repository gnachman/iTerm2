          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horisontell rullning vänds när ”Naturlig rullning” är aktiverat i Systeminställningar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları’nda “Doğal kaydırma” etkinken yatay kaydırma ters çevrilir"
          }
