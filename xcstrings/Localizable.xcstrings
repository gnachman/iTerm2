    "Tip.0081.Body" : {
      "comment" : "Tip of the day body, id 0081",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor příkazů podporuje více kurzorů. Umí také odeslat jen jeden příkaz ze seznamu, takže procházení seznamu příkazů jeden po druhém je snadné. Podrobnosti zjistíte kliknutím na tlačítko nápovědy v editoru příkazů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandoeditoren understøtter flere markører. Den kan også sende blot én kommando fra en liste, så det er nemt at gennemgå en liste af kommandoer én ad gangen. Klik på hjælpeknappen i kommandoeditoren for at se detaljer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Composer unterstützt mehrere Cursor. Außerdem können Sie nur einen einzelnen Befehl aus einer Liste senden, wodurch Sie eine Befehlsliste bequem Schritt für Schritt durchgehen können. Klicken Sie auf die Hilfe-Schaltfläche im Composer, um mehr zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The composer supports multiple cursors. It also has the ability to send just one command out of a list, making it easy to walk through a list of commands one-by-one. Click the help button in the composer for details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El compositor admite varios cursores. También puede enviar solo un comando de una lista, lo que facilita recorrer una lista de comandos uno por uno. Haz clic en el botón de ayuda del compositor para ver los detalles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentoeditori tukee useita kohdistimia. Sillä voi myös lähettää vain yhden komennon luettelosta, mikä helpottaa komentoluettelon läpikäyntiä yksi kerrallaan. Saat lisätietoja klikkaamalla komentoeditorin ohjepainiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compositeur prend en charge les curseurs multiples. Il peut aussi envoyer une seule commande d’une liste, ce qui permet de parcourir facilement une liste de commandes une par une. Cliquez sur le bouton d’aide du compositeur pour plus de détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il compositore supporta più cursori. Può anche inviare un solo comando di un elenco, rendendo facile scorrere un elenco di comandi uno alla volta. Fai clic sul pulsante di aiuto nel compositore per i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンポーザーは複数カーソルに対応しています。また、リストの中から1つのコマンドだけを送信する機能もあり、コマンドのリストを1つずつ順に実行するのが簡単になります。詳細はコンポーザーのヘルプボタンをクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴포저는 다중 커서를 지원합니다. 또한 목록에서 명령 하나만 보낼 수 있어 명령 목록을 하나씩 차례로 실행하기 쉽습니다. 자세한 내용은 컴포저의 도움말 버튼을 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandoskriveren støtter flere markører. Den kan også sende bare én kommando fra en liste, noe som gjør det enkelt å gå gjennom en liste med kommandoer én om gangen. Klikk på hjelpeknappen i kommandoskriveren for detaljer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opsteller ondersteunt meerdere cursors. Hij kan ook één commando uit een lijst versturen, zodat je eenvoudig een lijst commando’s een voor een doorloopt. Klik op de helpknop in de opsteller voor details."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytor poleceń obsługuje wiele kursorów. Może też wysłać tylko jedno polecenie z listy, co ułatwia przechodzenie przez listę poleceń jedno po drugim. Kliknij przycisk pomocy w edytorze poleceń, aby poznać szczegóły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Compositor suporta múltiplos cursores. Ele também é capaz de enviar apenas um comando de uma lista, facilitando percorrer uma lista de comandos um a um. Clique no botão de ajuda no Compositor para mais detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Композер поддерживает несколько курсоров. Он также умеет отправлять только одну команду из списка, что упрощает пошаговое выполнение списка команд. Нажмите кнопку справки в Композере, чтобы узнать подробности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor príkazov podporuje viac kurzorov. Dokáže tiež odoslať iba jeden príkaz zo zoznamu, takže zoznamom príkazov možno ľahko prechádzať po jednom. Podrobnosti nájdete po kliknutí na tlačidlo pomocníka v editore príkazov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urejevalnik ukazov podpira več kazalcev. Omogoča tudi pošiljanje samo enega ukaza s seznama, kar olajša izvajanje seznama ukazov enega za drugim. Podrobnosti najdete z gumbom za pomoč v urejevalniku ukazov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandoredigeraren stöder flera markörer. Den kan också skicka bara ett kommando ur en lista, vilket gör det enkelt att gå igenom en lista med kommandon ett i taget. Klicka på hjälpknappen i kommandoredigeraren för detaljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucu birden çok imleci destekler. Ayrıca bir listeden yalnızca tek bir komut gönderebilir; bu da komut listesinde tek tek ilerlemeyi kolaylaştırır. Ayrıntılar için Oluşturucu’daki yardım düğmesine tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình soạn lệnh hỗ trợ nhiều con trỏ. Nó cũng có thể chỉ gửi một lệnh trong danh sách, giúp dễ dàng đi qua từng lệnh một. Bấm nút trợ giúp trong trình soạn lệnh để biết chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composer 支持多个光标，还能从列表中选择单个命令发送，便于逐一处理命令列表。如需了解详情，请点击 Composer 中的帮助按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編寫器支援多重游標，也能只傳送列表中的某一個指令，讓你輕鬆逐一執行一串指令。按一下編寫器中的輔助說明按鈕可了解詳情。"
          }
        }
      }
    },
