            "value" : "Také odstraní hook z nastavení Claude Code na hostiteli %@, pokud tam je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fjerner også hooket fra Claude Codes indstillinger på %@, hvis det findes der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerdem wird der Hook aus den Einstellungen von Claude Code auf %@ entfernt, sofern er dort vorhanden ist."
          }
        },
        "en" : {
