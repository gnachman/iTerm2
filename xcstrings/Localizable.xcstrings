    "AdvancedSetting.validCharactersInSSHUserNames" : {
      "comment" : "Advanced setting: validCharactersInSSHUserNames",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gültige Zeichen in SSH-Benutzernamen\nAlphanumerische Zeichen sind immer gültig. Dies legt weitere gültige Zeichen fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Valid characters in SSH user names\nAlphanumerics are always valid. This specifies other valid characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres válidos en nombres de usuario de SSH\nLos alfanuméricos siempre son válidos. Esto especifica otros caracteres válidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractères valides dans les noms d’utilisateur SSH\nLes caractères alphanumériques sont toujours valides. Ce réglage indique les autres caractères valides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caratteri validi nei nomi utente SSH\nI caratteri alfanumerici sono sempre validi. Qui si specificano gli altri caratteri validi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHユーザー名で有効な文字\n英数字は常に有効です。これは、それ以外に有効な文字を指定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 사용자 이름에 유효한 문자\n영숫자는 항상 유효합니다. 이 설정으로 그 밖의 유효한 문자를 지정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres válidos em nomes de usuário SSH\nCaracteres alfanuméricos são sempre válidos. Isto especifica outros caracteres válidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допустимые символы в именах пользователей SSH\nБуквы и цифры всегда допустимы. Здесь указываются остальные допустимые символы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH kullanıcı adlarında geçerli karakterler\nAlfasayısal karakterler her zaman geçerlidir. Bu, diğer geçerli karakterleri belirtir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 用户名中有效的字符。\n字母数字始终有效。此处指定了其他有效字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 使用者名稱中的有效字元\n英數字元一律有效。此設定指定其他有效字元。"
          }
        }
      }
    },
