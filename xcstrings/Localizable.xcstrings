        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この既に実行中のセッションは復元されましたが、その内容は保存されていませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 실행 중이던 이 세션은 복원되었지만 내용은 저장되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão já em execução foi restaurada, mas seu conteúdo não foi salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта уже запущенная сессия была восстановлена, но её содержимое не было сохранено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
