    "AdvancedSetting.oscColorReport16Bits" : {
      "comment" : "Advanced setting: oscColorReport16Bits",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlásit 16bitové hodnoty barev pro OSC 4 a 10 až 19.\nObchází chybu ve starším vimu, který neuměl správně zpracovat 8bitové hodnoty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporter 16-bit farveværdier til OSC 4 og 10 til 19.\nOmgår en fejl i ældre vim, som ikke kunne fortolke 8-bit værdier korrekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16-Bit-Farbwerte für OSC 4 und 10 bis 19 melden.\nUmgeht einen Fehler in älteren Versionen von vim, bei denen 8-Bit-Werte nicht korrekt verarbeitet werden konnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Report 16-bit color values to OSC 4 and 10 through 19.\nWorks around a bug in older vim where they could not properly parse 8-bit values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa de valores de color de 16 bits para OSC 4 y 10 a 19.\nEvita un error de versiones antiguas de vim que no podían analizar correctamente valores de 8 bits."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportoi 16-bittiset väriarvot OSC 4:lle ja OSC 10–19:lle.\nKiertää vanhemman vimin virheen, jossa se ei osannut jäsentää 8-bittisiä arvoja oikein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler des valeurs de couleur 16 bits pour OSC 4 et 10 à 19.\nContourne un bogue des anciennes versions de vim qui ne savaient pas analyser correctement les valeurs 8 bits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala valori di colore a 16 bit per OSC 4 e da 10 a 19.\nAggira un bug delle versioni meno recenti di vim che non riuscivano ad analizzare correttamente i valori a 8 bit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4および10〜19に対して16ビットのカラー値を報告する。\n古いvimが8ビット値を正しく解析できないバグの回避策です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4 및 10~19에 16비트 색상 값을 리포팅.\n8비트 값을 제대로 파싱하지 못하는 이전 vim의 버그를 우회합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporter 16-bits fargeverdier til OSC 4 og 10 til og med 19.\nOmgår en feil i eldre vim som ikke kunne tolke 8-bits verdier riktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporteer 16-bits kleurwaarden voor OSC 4 en 10 tot en met 19.\nOmzeilt een bug in oudere versies van vim die 8-bits waarden niet goed kon verwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportuj 16-bitowe wartości kolorów dla OSC 4 i 10 do 19.\nObchodzi błąd w starszych wersjach vima, które nie potrafiły poprawnie analizować wartości 8-bitowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar valores de cor de 16 bits para OSC 4 e 10 a 19.\nContorna um bug em versões antigas do vim onde não conseguiam analisar corretamente valores de 8 bits."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщать 16-битные значения цвета в ответ на OSC 4 и с 10 по 19.\nОбходит ошибку в старых версиях vim, которые не могли корректно разбирать 8-битные значения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlásiť 16-bitové hodnoty farieb pre OSC 4 a 10 až 19.\nObchádza chybu v starších verziách vim, ktoré nevedeli správne spracovať 8-bitové hodnoty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poročaj 16-bitne vrednosti barv za OSC 4 in 10 do 19.\nZaobide napako v starejšem vimu, ki ni znal pravilno razčleniti 8-bitnih vrednosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapportera 16-bitars färgvärden till OSC 4 och 10 till 19.\nLöser ett fel i äldre vim där 8-bitarsvärden inte kunde tolkas korrekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4 ve 10 ile 19 için 16 bit renk değerleri raporla.\nEski vim sürümlerindeki 8 bit değerleri doğru ayrıştıramama hatasına geçici çözümdür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo giá trị màu 16 bit cho OSC 4 và 10 đến 19.\nKhắc phục lỗi ở vim cũ không phân tích đúng giá trị 8 bit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 16 位颜色值报告给 OSC 4 和 10-19。\n解决了旧版 vim 中的一个问题，因为该版本无法正确解析 8 位值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 OSC 4 和 10 到 19 回報 16 位元顏色值。\n用於解決舊版 vim 無法正確解析 8 位元值的錯誤。"
          }
        }
      }
    },
    "AdvancedSetting.p3" : {
      "comment" : "Advanced setting: p3",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít P3 jako výchozí barevný prostor? Pokud Ne, použije se sRGB."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug P3 som standardfarverum? Hvis Nej, bruges sRGB."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3 als Standardfarbraum verwenden? Bei „Nein“ wird sRGB verwendet."
          }
        },
        "en" : {
