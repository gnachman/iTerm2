        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresy URL muszą zawierać schemat?\nWłącz, aby zmniejszyć liczbę fałszywych trafień, które historia semantyczna uznaje za adres URL"
          }
