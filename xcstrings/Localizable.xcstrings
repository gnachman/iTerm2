    "AdvancedSetting.naturalScrollingAffectsHorizontalMouseReporting" : {
      "comment" : "Advanced setting: naturalScrollingAffectsHorizontalMouseReporting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodorovné posouvání se obrátí, když je v Nastavení systému zapnuto „Přirozené posouvání“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandret rulning vendes om, når “Naturlig rulning” er slået til i Systemindstillinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horizontales Scrollen wird umgekehrt, wenn „Natürliches Scrollen“ in den Systemeinstellungen aktiviert ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Horizontal scrolling is reversed when “Natural scrolling” is enabled in System Settings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento horizontal se invierte cuando “Desplazamiento natural” está activado en Ajustes del Sistema"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaakavieritys käännetään, kun ”Luonnollinen vieritys” on käytössä Järjestelmäasetuksissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement horizontal est inversé lorsque « Défilement naturel » est activé dans Réglages Système"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scorrimento orizzontale viene invertito quando “Scorrimento naturale” è attivo in Impostazioni di Sistema"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で「ナチュラルスクロール」が有効な場合、水平スクロールが反転します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정에서 “자연스러운 스크롤”이 켜져 있으면 가로 스크롤 방향을 반대로 합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horisontal rulling reverseres når «Naturlig rulling» er aktivert i Systeminnstillinger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horizontaal scrollen wordt omgekeerd wanneer ‘Natuurlijk scrollen’ is ingeschakeld in Systeeminstellingen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewijanie poziome jest odwrócone, gdy w Ustawieniach systemowych włączone jest „Naturalne przewijanie”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem horizontal é invertida quando “Rolagem natural” está ativada nos Ajustes do Sistema"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Горизонтальная прокрутка инвертируется, если в Системных настройках включена функция «Естественная прокрутка»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
