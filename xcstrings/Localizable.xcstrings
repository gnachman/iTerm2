    "ScriptsMenu.TakingTooLong" : {
      "comment" : "Warning shown when enumerating the scripts folder takes too long",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Suchen aller Skripte unter %@ dauert sehr lange. Vermeiden Sie es, viele Dateien zu speichern oder Netzwerklaufwerke für den Skripte-Ordner zu verwenden.\n\nFortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is taking a long time to locate all scripts under %@. Avoid storing many files or using network mounts for the scripts folder.\n\nContinue?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以下のすべてのスクリプトを検出するのに時間がかかっています。スクリプトフォルダに多数のファイルを保存したり、ネットワークマウントを使用したりしないでください。\n\n続行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 아래의 모든 스크립트를 찾는 데 오래 걸리고 있습니다. 스크립트 폴더에 많은 파일을 저장하거나 네트워크 마운트를 사용하지 마십시오.\n\n계속하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está demorando muito para localizar todos os scripts em %@. Evite armazenar muitos arquivos ou usar montagens de rede na pasta de scripts.\n\nContinuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск всех скриптов в %@ занимает много времени. Избегайте хранения большого числа файлов или использования сетевых дисков для папки скриптов.\n\nПродолжить?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位 %@ 下的所有脚本耗时较长。避免在脚本文件夹中存储大量文件或使用网络挂载。\n\n继续？"
          }
        }
