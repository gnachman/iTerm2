    },
    "AdvancedSetting.fastTriggerRegexes" : {
      "comment" : "Advanced setting: fastTriggerRegexes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelle Auswertung regulärer Ausdrücke für Trigger.\nDies ist experimentell, da es die Interpretation regulärer Ausdrücke möglicherweise verändert."
          }
        },
        "en" : {
