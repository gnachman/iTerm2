        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelo de URL para sugestões de busca antecipada.\nO iTerm substitui a string “%@” pelo texto a buscar. É usado o escape de porcentagem para parâmetros de consulta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаблон URL-адреса для подсказок поиска при вводе.\niTerm2 заменяет строку «%@» на текст для поиска. Используется процентное экранирование параметра запроса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazarken arama önerileri için URL şablonu.\niTerm, “%@” dizesini aranacak metinle değiştirir. Sorgu parametresi yüzde kaçışı kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "类型提示搜索建议的URL模板。  \niTerm将字符串“%@”替换为搜索文本，使用查询参数百分比转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預先輸入搜尋建議的 URL 範本。\niTerm 會將字串「%@」取代為要搜尋的文字。使用查詢參數百分比跳脫。"
          }
        }
      }
    },
    "AdvancedSetting.selectsTabsOnMouseDown" : {
      "comment" : "Advanced setting: selectsTabsOnMouseDown",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs bei Mausklick (Mouse-Down) auswählen?\nDas Ändern dieser Einstellung wirkt sich nicht auf bestehende Fenster aus."
          }
        },
        "en" : {
          "stringUnit" : {
