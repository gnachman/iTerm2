    "StatusPriority.InstructionsLabel" : {
      "comment" : "Instructional label at the top of the status priority settings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status werden nach Priorität sortiert. Einträge weiter oben haben eine höhere Priorität. Ziehen zum Umordnen, Klicken zum Bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Statuses are sorted by priority. Items near the top have higher priority. Drag to reorder. Click to edit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスは優先度順に並んでいます。上にある項目ほど優先度が高くなります。ドラッグして並べ替え、クリックして編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태는 우선순위에 따라 정렬됩니다. 위쪽에 있는 항목일수록 우선순위가 높습니다. 드래그하여 순서를 변경하고, 클릭하여 편집하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os status são ordenados por prioridade. Os itens próximos ao topo têm prioridade mais alta. Arraste para reordenar. Clique para editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Статусы отсортированы по приоритету. Элементы вверху списка имеют более высокий приоритет. Перетаскивайте, чтобы изменить порядок. Нажмите, чтобы изменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态按优先级排序。靠近顶部的项目优先级更高。拖移以重新排序。点按以编辑。"
          }
        }
      }
    },
