    "Tip.0011.Body" : {
      "comment" : "Tip of the day body, id 0011",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Dynamischen Profilen können Sie Ihre Profile als eine oder mehrere JSON-Dateien speichern. Das eignet sich hervorragend, um Profile im großen Stil zu erstellen und zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamic Profiles let you store your profiles as one or more JSON files. It’s great for batch creating and editing profiles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミックプロファイルを使うと、プロファイルを1つ以上のJSONファイルとして保存できます。プロファイルの一括作成や編集に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일을 사용하면 프로파일을 하나 이상의 JSON 파일로 저장할 수 있습니다. 프로파일을 일괄 생성하고 편집할 때 매우 유용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Perfis dinâmicos permitem armazenar seus perfis como um ou mais arquivos JSON. É ótimo para criar e editar perfis em lote."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамические профили позволяют хранить ваши профили в виде одного или нескольких файлов JSON. Это отлично подходит для пакетного создания и редактирования профилей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态配置文件允许你将配置文件存储为一个或多个JSON文件。非常适合批量创建和编辑配置文件。"
          }
        }
      }
    },
