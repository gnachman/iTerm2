    "ProfilesColors.ThemeForcesDarkMode" : {
      "comment" : "Warning shown in profile color settings when the app theme is set to a dark theme, which overrides the system appearance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Thema verwendet immer den dunklen Modus, daher werden die Farben für den hellen Modus nicht verwendet, solange Sie das Thema nicht ändern. Sie können es unter Einstellungen > Erscheinungsbild > Allgemein > Thema ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your theme always uses dark mode, so the light mode colors won’t be used unless you change the theme. You can change it in Settings > Appearance > General > Theme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tema siempre usa el modo oscuro, así que los colores del modo claro no se usarán a menos que cambies el tema. Puedes cambiarlo en Ajustes > Apariencia > General > Tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre thème utilise toujours le mode sombre, les couleurs du mode clair ne seront donc pas utilisées tant que vous ne changerez pas de thème. Vous pouvez le faire dans Réglages > Apparence > Général > Thème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo tema usa sempre la modalità scura, quindi i colori della modalità chiara non verranno usati a meno che tu non cambi il tema. Puoi cambiarlo in Impostazioni > Aspetto > Generali > Tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のテーマは常にダークモードを使用するため、テーマを変更しない限りライトモードの色は使用されません。「設定 > 外観 > 一般 > テーマ」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 테마는 항상 다크 모드를 사용하므로, 테마를 변경하지 않는 한 라이트 모드 색상은 사용되지 않습니다. 설정 > 모양 > 일반 > 테마에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu tema sempre usa o modo escuro, portanto as cores do modo claro não serão usadas a menos que você altere o tema. Você pode alterá-lo em Ajustes > Aparência > Geral > Tema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая тема всегда использует тёмный режим, поэтому цвета светлого режима не будут использоваться, пока вы не смените тему. Это можно изменить в разделе Настройки > Внешний вид > Общие > Тема."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temanız her zaman koyu mod kullanıyor, bu nedenle temayı değiştirmediğiniz sürece açık mod renkleri kullanılmaz. Bunu Ayarlar > Görünüm > Genel > Tema bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前主题始终使用深色模式，因此除非更改主题，否则不会使用浅色模式的颜色。可在“设置”>“外观”>“通用”>“主题”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的主題一律使用深色模式，因此除非變更主題，否則不會使用淺色模式的顏色。你可以在「設定 > 外觀 > 一般 > 主題」中變更。"
          }
        }
      }
    },
    "ProfilesColors.ThemeForcesLightMode" : {
      "comment" : "Warning shown in profile color settings when the app theme is set to a light theme, which overrides the system appearance",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Thema verwendet immer den hellen Modus, daher werden die Farben für den dunklen Modus nicht verwendet, solange Sie das Thema nicht ändern. Sie können es unter Einstellungen > Erscheinungsbild > Allgemein > Thema ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your theme always uses light mode, so the dark mode colors won’t be used unless you change the theme. You can change it in Settings > Appearance > General > Theme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tema siempre usa el modo claro, así que los colores del modo oscuro no se usarán a menos que cambies el tema. Puedes cambiarlo en Ajustes > Apariencia > General > Tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre thème utilise toujours le mode clair, les couleurs du mode sombre ne seront donc pas utilisées tant que vous ne changerez pas de thème. Vous pouvez le faire dans Réglages > Apparence > Général > Thème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo tema usa sempre la modalità chiara, quindi i colori della modalità scura non verranno usati a meno che tu non cambi il tema. Puoi cambiarlo in Impostazioni > Aspetto > Generali > Tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のテーマは常にライトモードを使用するため、テーマを変更しない限りダークモードの色は使用されません。「設定 > 外観 > 一般 > テーマ」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 테마는 항상 라이트 모드를 사용하므로, 테마를 변경하지 않는 한 다크 모드 색상은 사용되지 않습니다. 설정 > 모양 > 일반 > 테마에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu tema sempre usa o modo claro, portanto as cores do modo escuro não serão usadas a menos que você altere o tema. Você pode alterá-lo em Ajustes > Aparência > Geral > Tema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая тема всегда использует светлый режим, поэтому цвета тёмного режима не будут использоваться, пока вы не смените тему. Это можно изменить в разделе Настройки > Внешний вид > Общие > Тема."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temanız her zaman açık mod kullanıyor, bu nedenle temayı değiştirmediğiniz sürece koyu mod renkleri kullanılmaz. Bunu Ayarlar > Görünüm > Genel > Tema bölümünden değiştirebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前主题始终使用浅色模式，因此除非更改主题，否则不会使用深色模式的颜色。可在“设置”>“外观”>“通用”>“主题”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的主題一律使用淺色模式，因此除非變更主題，否則不會使用深色模式的顏色。你可以在「設定 > 外觀 > 一般 > 主題」中變更。"
          }
        }
      }
