        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Schriftgröße für Tab-Beschriftungen\nDamit dies wirksam wird, aktivieren Sie „Benutzerdefinierte Schriftgröße für Tab-Beschriftungen verwenden?“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom tab label font size\nFor this to take effect, turn on “Use custom font size for tab labels?”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムタブラベルのフォントサイズ\nこれを反映するには、「タブラベルにカスタムフォントサイズを使用しますか?」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
