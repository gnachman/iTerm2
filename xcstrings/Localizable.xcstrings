    "AdvancedSetting.lastpassGroups" : {
      "comment" : "Advanced setting: lastpassGroups",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam skupin LastPass oddělených čárkami, ve kterých správce hesel hledá hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommasepareret liste over LastPass-grupper, som adgangskodeadministratoren skal søge i efter adgangskoder."
          }
        },
        "de" : {
