    "AdvancedSetting.enableZoomMenu" : {
      "comment" : "Advanced setting: enableZoomMenu",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit otevření standardní systémové nabídky na tlačítkách zvětšení oken?\nmacOS má chybu, kvůli které aplikace zamrzne. Protože je to málo používaná nabídka, je ve výchozím stavu vypnuta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad, at systemets standardmenu på vinduernes zoomknapper åbnes?\nmacOS har en fejl, der får appen til at hænge. Da menuen sjældent bruges, er den slået fra som standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Öffnen des Standard-Systemmenüs bei den Zoom-Schaltflächen des Fensters erlauben?\nmacOS hat einen Fehler, der die App hängen lässt. Da dieses Menü selten verwendet wird, ist es standardmäßig deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow the standard system menu on window Zoom buttons to open?\nmacOS has a bug that makes the app hang. Since this is a rarely used menu, it is disabled by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que se abra el menú estándar del sistema en los botones de zoom de las ventanas?\nmacOS tiene un error que hace que la app se bloquee. Como es un menú que se usa poco, está desactivado de forma predeterminada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallitaanko ikkunan Zoomaa-painikkeiden tavallisen järjestelmävalikon avautuminen?\nmacOS:ssä on virhe, joka jumittaa sovelluksen. Koska tätä valikkoa käytetään harvoin, se on oletuksena poissa käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’ouverture du menu système standard sur les boutons Réduire/agrandir des fenêtres ?\nmacOS a un bug qui bloque l’app. Comme ce menu est rarement utilisé, il est désactivé par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire l’apertura del menu di sistema standard sui pulsanti Zoom della finestra?\nmacOS ha un bug che blocca l’app. Poiché è un menu usato di rado, è disabilitato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウの Zoom ボタンで標準のシステムメニューを開けるようにしますか?\nmacOS にはアプリをハングさせるバグがあります。このメニューはめったに使われないため、デフォルトでは無効になっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 확대/축소 버튼에서 표준 시스템 메뉴가 열리도록 허용하겠습니까?\nmacOS에 앱이 멈추는 버그가 있습니다. 거의 사용하지 않는 메뉴이므로 기본적으로 꺼져 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillate at standard systemmeny på Zoom-knappene i vinduer åpnes?\nmacOS har en feil som får appen til å henge. Siden dette er en sjelden brukt meny, er den deaktivert som standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestaan dat het standaard systeemmenu op de zoomknoppen van vensters opent?\nmacOS heeft een bug waardoor de app vastloopt. Omdat dit menu zelden wordt gebruikt, is het standaard uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwolić na otwieranie standardowego menu systemowego na przyciskach Zmień rozmiar okna?\nmacOS ma błąd, który powoduje zawieszanie aplikacji. Ponieważ to menu jest rzadko używane, jest domyślnie wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que o menu padrão do sistema nos botões de Zoom da janela abra?\nO macOS tem um bug que faz o app travar. Como este é um menu raramente usado, ele fica desativado por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить открытие стандартного системного меню на кнопках Zoom окна?\nВ macOS есть ошибка, вызывающая зависание приложения. Поскольку это редко используемое меню, оно отключено по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť otvorenie štandardného systémového menu na tlačidlách okna Zmeniť veľkosť?\nmacOS má chybu, ktorá spôsobuje zamrznutie apky. Keďže ide o zriedka používané menu, predvolene je vypnuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovoli odpiranje standardnega sistemskega menija na gumbih za povečavo okna?\nmacOS ima napako, zaradi katere se aplikacija zamrzne. Ker se ta meni redko uporablja, je privzeto onemogočen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt att systemets standardmeny på fönstrens zoomknappar öppnas?\nmacOS har ett fel som får appen att hänga sig. Eftersom menyn sällan används är den avaktiverad som förval."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere Büyüt düğmelerindeki standart sistem menüsünün açılmasına izin verilsin mi?\nmacOS’ta uygulamanın donmasına yol açan bir hata var. Nadiren kullanılan bir menü olduğundan varsayılan olarak devre dışıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép mở menu hệ thống chuẩn trên các nút Thu/Phóng của cửa sổ?\nmacOS có lỗi khiến ứng dụng bị treo. Vì đây là menu ít dùng nên mặc định bị tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许使用窗口缩放按钮上的标准系统菜单？\nmacOS 存在一个会导致应用程序卡住的漏洞。由于该菜单很少被使用，因此默认处于禁用状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許打開視窗縮放按鈕上的標準系統選單？\nmacOS 有個錯誤會導致 App 當機。由於這是很少使用的選單，因此預設為停用。"
          }
        }
      }
    },
    "AdvancedSetting.engageLayoutEngineInTerminalWindows" : {
      "comment" : "Advanced setting: engageLayoutEngineInTerminalWindows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojit Auto Layout v nových oknech terminálu.\nPřidá do každého nového okna terminálu skryté zobrazení s efektem skla (před macOS 26 zobrazení s omezeními), což zapne rozvržení AppKit pro celé okno. Použijte ke kontrole, že se okna při zapnutém modulu stále správně rozvrhují a mění velikost. Pouze vývojová sestavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Auto Layout til i nye terminalvinduer.\nTilføjer en skjult glaseffektvisning (før macOS 26 en visning med begrænsninger) til hvert nyt terminalvindue, hvilket slår AppKits layoutmotor til for hele vinduet. Brug den til at kontrollere, at vinduer stadig får korrekt layout og størrelse med motoren slået til. Kun i udviklingsbuilds."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Layout in neuen Terminalfenstern aktivieren.\nFügt jedem neuen Terminalfenster eine verborgene Glaseffekt-Ansicht hinzu (vor macOS 26 eine Ansicht mit Constraints), wodurch die Layout-Engine von AppKit für das gesamte Fenster eingeschaltet wird. Damit lässt sich prüfen, ob Fenster bei eingeschalteter Engine weiterhin korrekt angeordnet und in der Größe geändert werden. Nur in Entwicklungs-Builds."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Engage Auto Layout in new terminal windows.\nAdds a hidden glass effect view (before macOS 26, a view with constraints) to each new terminal window, which turns on AppKit’s layout engine for the whole window. Use it to check that windows still lay out and resize correctly with the engine on. Development builds only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar Auto Layout en las nuevas ventanas de terminal.\nAñade una vista oculta con efecto de cristal (antes de macOS 26, una vista con restricciones) a cada nueva ventana de terminal, lo que activa el motor de diseño de AppKit para toda la ventana. Úsalo para comprobar que las ventanas siguen distribuyéndose y cambiando de tamaño correctamente con el motor activado. Solo en compilaciones de desarrollo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota Auto Layout käyttöön uusissa päätteen ikkunoissa.\nLisää jokaiseen uuteen päätteen ikkunaan piilotetun lasitehostenäkymän (ennen macOS 26:ta näkymän rajoitteineen), mikä ottaa AppKitin asettelumoottorin käyttöön koko ikkunassa. Käytä tätä tarkistaaksesi, että ikkunoiden asettelu ja koon muuttaminen toimivat edelleen moottorin ollessa päällä. Vain kehitysversioissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer Auto Layout dans les nouvelles fenêtres de terminal.\nAjoute à chaque nouvelle fenêtre de terminal une vue à effet de verre masquée (avant macOS 26, une vue avec contraintes), ce qui active le moteur de mise en page d’AppKit pour toute la fenêtre. Utilisez-le pour vérifier que les fenêtres se disposent et se redimensionnent toujours correctement avec le moteur activé. Versions de développement uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Auto Layout nelle nuove finestre del terminale.\nAggiunge a ogni nuova finestra del terminale una vista nascosta con effetto vetro (prima di macOS 26, una vista con vincoli), che attiva il motore di layout di AppKit per l’intera finestra. Usalo per verificare che le finestre si dispongano e si ridimensionino ancora correttamente con il motore attivo. Solo build di sviluppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいターミナルウインドウで Auto Layout を有効にします。\n新しい各ターミナルウインドウに非表示のガラス効果ビュー (macOS 26 より前では制約付きのビュー) を追加し、ウインドウ全体で AppKit のレイアウトエンジンをオンにします。エンジンがオンの状態でもウインドウのレイアウトとサイズ変更が正しく行われるかを確認するのに使用します。開発ビルドのみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 터미널 윈도우에서 Auto Layout을 사용합니다.\n새 터미널 윈도우마다 숨겨진 글래스 효과 보기(macOS 26 이전에는 제약 조건이 있는 보기)를 추가하여 윈도우 전체에 AppKit의 레이아웃 엔진을 켭니다. 엔진이 켜진 상태에서도 윈도우가 올바르게 배치되고 크기가 조정되는지 확인할 때 사용하십시오. 개발 빌드 전용입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver Auto Layout i nye terminalvinduer.\nLegger til en skjult glasseffektvisning (før macOS 26, en visning med begrensninger) i hvert nye terminalvindu, noe som slår på AppKits layoutmotor for hele vinduet. Bruk den til å kontrollere at vinduer fortsatt legges ut og endrer størrelse riktig med motoren på. Bare utviklingsbygg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activeer Auto Layout in nieuwe terminalvensters.\nVoegt aan elk nieuw terminalvenster een verborgen weergave met glaseffect toe (vóór macOS 26 een weergave met beperkingen), waardoor de lay-outengine van AppKit voor het hele venster wordt ingeschakeld. Gebruik dit om te controleren of vensters nog correct worden ingedeeld en van formaat veranderen met de engine ingeschakeld. Alleen in ontwikkelbuilds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Auto Layout w nowych oknach terminala.\nDodaje do każdego nowego okna terminala ukryty widok efektu szkła (przed macOS 26 widok z ograniczeniami), co włącza mechanizm układu AppKit dla całego okna. Użyj, aby sprawdzić, czy okna nadal poprawnie się układają i zmieniają rozmiar przy włączonym mechanizmie. Tylko kompilacje deweloperskie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar o Auto Layout em novas janelas de terminal.\nAdiciona uma visualização oculta de efeito de vidro (antes do macOS 26, uma visualização com restrições) a cada nova janela de terminal, o que ativa o mecanismo de layout do AppKit para a janela inteira. Use isto para verificar se as janelas continuam sendo dispostas e redimensionadas corretamente com o mecanismo ativado. Apenas em builds de desenvolvimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включать Auto Layout в новых окнах терминала.\nДобавляет в каждое новое окно терминала скрытое представление с эффектом стекла (до macOS 26 это представление с ограничениями), что включает механизм компоновки AppKit для всего окна. Используйте, чтобы проверить, что окна по-прежнему правильно компонуются и меняют размер при включённом механизме. Только для сборок разработки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť Auto Layout v nových oknách terminálu.\nPridá do každého nového okna terminálu skryté zobrazenie s efektom skla (pred macOS 26 zobrazenie s obmedzeniami), čím sa pre celé okno zapne rozloženie AppKit. Použite na overenie, že sa okná stále správne rozmiestňujú a menia veľkosť so zapnutým modulom. Iba vývojárske zostavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vključi samodejno postavitev v novih oknih terminala.\nVsakemu novemu oknu terminala doda skrit pogled s steklenim učinkom (pred macOS 26 pogled z omejitvami), ki za celotno okno vklopi postavitveni mehanizem AppKit. Uporabite za preverjanje, ali se okna s tem mehanizmom še vedno pravilno postavijo in spreminjajo velikost. Samo razvojne zgradbe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera Auto Layout i nya terminalfönster.\nLägger till en dold glaseffektvy (före macOS 26, en vy med begränsningar) i varje nytt terminalfönster, vilket aktiverar AppKits layoutmotor för hela fönstret. Använd det för att kontrollera att fönster fortfarande läggs ut och ändrar storlek korrekt med motorn på. Endast utvecklingsbyggen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni terminal pencerelerinde Otomatik Düzeni devreye sok.\nHer yeni terminal penceresine gizli bir cam efekti görünümü (macOS 26 öncesinde kısıtlamalı bir görünüm) ekler; bu, tüm pencere için AppKit’in yerleşim motorunu açar. Motor açıkken pencerelerin hâlâ doğru yerleşip yeniden boyutlandığını denetlemek için kullanın. Yalnızca geliştirme yapıları."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích hoạt Auto Layout trong cửa sổ terminal mới.\nThêm một chế độ xem hiệu ứng kính ẩn (trước macOS 26 là chế độ xem có ràng buộc) vào mỗi cửa sổ terminal mới, bật công cụ bố cục của AppKit cho toàn bộ cửa sổ. Dùng để kiểm tra rằng cửa sổ vẫn bố trí và đổi kích thước đúng khi bật công cụ này. Chỉ dành cho bản dựng phát triển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新终端窗口中启用 Auto Layout。\n向每个新终端窗口添加一个隐藏的玻璃效果视图（macOS 26 之前为一个带约束的视图），从而为整个窗口开启 AppKit 的布局引擎。可用来检查在启用该引擎时窗口是否仍能正确布局和调整大小。仅限开发版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新的終端機視窗中啟用自動版面配置。\n為每個新的終端機視窗加入一個隱藏的玻璃效果檢視（macOS 26 之前則為帶有限制條件的檢視），這會為整個視窗開啟 AppKit 的版面配置引擎。用於檢查啟用引擎後，視窗是否仍能正確配置和調整大小。僅限開發版本。"
          }
        }
      }
    },
    "AdvancedSetting.errorSound" : {
      "comment" : "Advanced setting: errorSound",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je „Upozornit na další značku“ nastaveno na přehrání zvuku, použít soubor s tímto názvem pro chybné dokončení předchozího příkazu.\nMůžete zadat název systémového zvuku nebo soubor ve ~/Library/Sounds."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Advar ved næste mærke er sat til at afspille en lyd, bruges et arkiv med dette navn ved fejlbehæftet afslutning af den forrige kommando.\nDu kan angive en systemlyd eller et arkiv i ~/Library/Sounds."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Benachrichtigung bei nächster Marke“ so konfiguriert ist, dass ein Ton abgespielt wird, eine Datei mit diesem Namen für den fehlerhaften Abschluss des vorherigen Befehls verwenden.\nSie können einen Systemton oder eine Datei in ~/Library/Sounds angeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Alert on Next Mark is configured to play a sound, use a file with this name for erroneous completion of the previous command.\nYou can name a system sound or a file in ~/Library/Sounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando Alertar en la siguiente marca está configurado para reproducir un sonido, usa un archivo con este nombre para la finalización errónea del comando anterior.\nPuedes indicar un sonido del sistema o un archivo de ~/Library/Sounds."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Varoita seuraavasta merkistä on määritetty soittamaan ääni, käytä tämännimistä tiedostoa edellisen komennon virheelliseen päättymiseen.\nVoit nimetä järjestelmän äänen tai tiedoston kansiossa ~/Library/Sounds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Alerter à la prochaine marque » est configurée pour jouer un son, utiliser un fichier portant ce nom pour la fin erronée de la commande précédente.\nVous pouvez indiquer un son système ou un fichier dans ~/Library/Sounds."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Avvisa al contrassegno successivo” è configurato per riprodurre un suono, usa un file con questo nome per il completamento errato del comando precedente.\nPuoi indicare un suono di sistema o un file in ~/Library/Sounds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次のマークで通知」がサウンドを再生するよう設定されている場合、直前のコマンドがエラーで終了したときにこの名前のファイルを使用します。\nシステムサウンド名、または ~/Library/Sounds 内のファイル名を指定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 마크에서 경고가 사운드를 재생하도록 구성된 경우, 이전 명령이 오류로 끝났을 때 이 이름의 파일을 사용합니다.\n시스템 사운드 이름이나 ~/Library/Sounds에 있는 파일 이름을 지정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når «Varsle ved neste merke» er konfigurert til å spille av en lyd, bruk en fil med dette navnet for feilaktig fullføring av forrige kommando.\nDu kan angi en systemlyd eller en fil i ~/Library/Sounds."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer Waarschuw bij volgende markering is ingesteld om een geluid af te spelen, gebruik dan een bestand met deze naam voor een foutieve afronding van het vorige commando.\nJe kunt een systeemgeluid of een bestand in ~/Library/Sounds opgeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy „Alert przy następnym znaczniku” jest skonfigurowany do odtwarzania dźwięku, użyj pliku o tej nazwie dla błędnego zakończenia poprzedniego polecenia.\nMożesz podać nazwę dźwięku systemowego lub pliku w ~/Library/Sounds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Alerta na próxima marca está configurado para tocar um som, usar um arquivo com este nome para a conclusão errônea do comando anterior.\nVocê pode nomear um som do sistema ou um arquivo em ~/Library/Sounds."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда «Оповещение при следующей метке» настроено на воспроизведение звука, использовать файл с этим именем для случаев ошибочного завершения предыдущей команды.\nМожно указать системный звук или файл в ~/Library/Sounds."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je „Upozorniť pri ďalšej značke“ nastavené na prehranie zvuku, použiť súbor s týmto názvom pre chybné dokončenie predošlého príkazu.\nMôžete uviesť názov systémového zvuku alebo súboru v ~/Library/Sounds."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je »Opozori pri naslednji označbi« nastavljeno na predvajanje zvoka, za napačen zaključek prejšnjega ukaza uporabi datoteko s tem imenom.\nNavedete lahko sistemski zvok ali datoteko v ~/Library/Sounds."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När Varning vid nästa märke är konfigurerat att spela ett ljud används en fil med det här namnet för att markera att föregående kommando slutfördes med fel.\nDu kan ange ett systemljud eller en fil i ~/Library/Sounds."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonraki İşarette Uyar bir ses çalacak şekilde yapılandırıldığında, önceki komutun hatalı tamamlanması için bu ada sahip bir dosya kullan.\nBir sistem sesinin veya ~/Library/Sounds içindeki bir dosyanın adını verebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi Cảnh báo ở dấu tiếp theo được cấu hình để phát âm thanh, dùng tệp có tên này khi lệnh trước hoàn tất có lỗi.\nBạn có thể đặt tên một âm thanh hệ thống hoặc một tệp trong ~/Library/Sounds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当“在下一个标记处触发警告”被设置为播放声音时，可使用此命名的文件来处理上一个命令的错误完成情况。\n您可以使用系统内置音效或位于~/Library/Sounds中的文件作为名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「在下一個標記處警示」設定為播放聲音時，上一個指令異常完成所使用的檔案名稱。\n你可以指定系統聲音或 ~/Library/Sounds 中的檔案。"
          }
        }
      }
    },
    "AdvancedSetting.escapeWithQuotes" : {
      "comment" : "Advanced setting: escapeWithQuotes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapovat názvy souborů jednoduchými uvozovkami místo zpětných lomítek.\nJe určeno pro uživatele xonsh, který escapování zpětným lomítkem nepřijímá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape arkivnavne med enkelte anførselstegn i stedet for omvendte skråstreger.\nDette er beregnet til brugere af xonsh, som ikke accepterer escape med omvendt skråstreg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateinamen mit einfachen Anführungszeichen statt mit Backslashes maskieren.\nDies ist für Benutzer von xonsh gedacht, das kein Maskieren mit Backslash akzeptiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Escape file names with single quotes instead of backslashes.\nThis is intended for users of xonsh, which does not accept backslash escaping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapar los nombres de archivo con comillas simples en lugar de barras invertidas.\nEstá pensado para usuarios de xonsh, que no acepta el escape con barra invertida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapea tiedostonimet yksittäisillä lainausmerkeillä kenoviivojen sijaan.\nTarkoitettu xonsh-käyttäjille, sillä xonsh ei hyväksy kenoviivaescapea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échapper les noms de fichiers avec des apostrophes simples plutôt que des barres obliques inverses.\nDestiné aux utilisateurs de xonsh, qui n’accepte pas l’échappement par barre oblique inverse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui l’escape dei nomi dei file con apici singoli invece che con barre rovesciate.\nPensato per gli utenti di xonsh, che non accetta l’escape con barra rovesciata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名をバックスラッシュではなく単一引用符でエスケープします。\nこれは、バックスラッシュによるエスケープを受け付けない xonsh のユーザー向けです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 이름을 백슬래시 대신 작은따옴표로 이스케이프.\n백슬래시 이스케이프를 받아들이지 않는 xonsh 사용자를 위한 설정입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape filnavn med enkle anførselstegn i stedet for omvendte skråstreker.\nDette er beregnet på brukere av xonsh, som ikke godtar escaping med omvendt skråstrek."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape bestandsnamen met enkele aanhalingstekens in plaats van backslashes.\nDit is bedoeld voor gebruikers van xonsh, dat escapen met een backslash niet accepteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabezpieczaj nazwy plików pojedynczymi cudzysłowami zamiast ukośników odwrotnych.\nPrzeznaczone dla użytkowników xonsh, który nie akceptuje zabezpieczania ukośnikiem odwrotnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapar nomes de arquivo com aspas simples em vez de barras invertidas.\nIsto é destinado a usuários do xonsh, que não aceita escape com barra invertida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экранировать имена файлов одинарными кавычками вместо обратной косой черты.\nПредназначено для пользователей xonsh, который не принимает экранирование обратной косой чертой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapovať názvy súborov jednoduchými úvodzovkami namiesto spätných lomiek.\nJe určené pre užívateľov xonsh, ktorý neprijíma escapovanie spätnou lomkou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imena datotek ubeži z enojnimi narekovaji namesto z poševnicami nazaj.\nNamenjeno uporabnikom xonsh, ki ne sprejema ubežnih poševnic nazaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapa filnamn med enkla citattecken i stället för omvända snedstreck.\nAvsett för användare av xonsh, som inte accepterar escapning med omvänt snedstreck."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya adlarındaki kaçışlar için ters eğik çizgi yerine tek tırnak kullan.\nBu, ters eğik çizgiyle kaçışı kabul etmeyen xonsh kullanıcıları içindir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát tên tệp bằng dấu nháy đơn thay vì dấu gạch chéo ngược.\nDành cho người dùng xonsh, vốn không chấp nhận thoát bằng gạch chéo ngược."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请用单引号而非反斜杠来转义文件名。\n这是为不支持反斜杠转义的xonsh用户设计的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以單引號而非反斜線跳脫檔名。\n這是為不接受反斜線跳脫的 xonsh 使用者設計的。"
          }
        }
      }
    },
    "AdvancedSetting.excludeBackgroundColorsFromCopiedStyle" : {
      "comment" : "Advanced setting: excludeBackgroundColorsFromCopiedStyle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechat všechny barvy pozadí při kopírování textu s barvou a stylem písma?\nZahrnuje výchozí barvu pozadí i nevýchozí barvy pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelad alle baggrundsfarver, når tekst kopieres med farve og skriftstil?\nDette omfatter både standardbaggrundsfarven og baggrundsfarver, der ikke er standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Hintergrundfarben ausschließen, wenn Text mit Farbe und Schriftstil kopiert wird?\nDies umfasst sowohl die Standardhintergrundfarbe als auch abweichende Hintergrundfarben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude all background colors when text is copied with color and font style?\nThis includes both the default background color and non-default background colors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Excluir todos los colores de fondo al copiar texto con color y estilo de letra?\nIncluye tanto el color de fondo predeterminado como los colores de fondo no predeterminados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätetäänkö kaikki taustavärit pois, kun teksti kopioidaan värin ja fonttityylin kanssa?\nTämä sisältää sekä oletustaustavärin että muut kuin oletustaustavärit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclure toutes les couleurs d’arrière-plan lors de la copie de texte avec couleur et style de police ?\nCela inclut la couleur d’arrière-plan par défaut et les couleurs d’arrière-plan non par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludere tutti i colori di sfondo quando il testo viene copiato con colore e stile del font?\nInclude sia il colore di sfondo predefinito sia i colori di sfondo non predefiniti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色とフォントスタイル付きでテキストをコピーする際、すべての背景色を除外しますか?\nこれには、デフォルトの背景色とデフォルト以外の背景色の両方が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상 및 서체 스타일과 함께 텍스트를 복사할 때 모든 배경색을 제외하겠습니까?\n기본 배경색과 기본값이 아닌 배경색이 모두 포함됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelate alle bakgrunnsfarger når tekst kopieres med farge og fontstil?\nDette omfatter både standard bakgrunnsfarge og bakgrunnsfarger som ikke er standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle achtergrondkleuren uitsluiten wanneer tekst met kleur en lettertypestijl wordt gekopieerd?\nDit omvat zowel de standaardachtergrondkleur als niet-standaard achtergrondkleuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomijać wszystkie kolory tła przy kopiowaniu tekstu z kolorem i stylem czcionki?\nObejmuje to zarówno domyślny kolor tła, jak i niedomyślne kolory tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir todas as cores de plano de fundo quando o texto é copiado com cor e estilo de fonte?\nIsto inclui tanto a cor de plano de fundo padrão quanto as cores de plano de fundo não padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключать все цвета фона при копировании текста с цветом и стилем шрифта?\nЭто включает как цвет фона по умолчанию, так и нестандартные цвета фона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechať všetky farby pozadia, keď sa text kopíruje s farbou a štýlom písma?\nZahŕňa predvolenú farbu pozadia aj nepredvolené farby pozadia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izključi vse barve ozadja, ko je besedilo kopirano z barvo in slogom pisave?\nTo vključuje privzeto barvo ozadja in neprivzete barve ozadja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undanta alla bakgrundsfärger när text kopieras med färg och typsnittsstil?\nDet gäller både den förvalda bakgrundsfärgen och bakgrundsfärger som inte är förvalda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin renk ve font stiliyle kopyalanırken tüm arka plan renkleri hariç tutulsun mu?\nBu, hem varsayılan arka plan rengini hem de varsayılan olmayan arka plan renklerini içerir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loại trừ mọi màu nền khi sao chép văn bản kèm màu và kiểu phông chữ?\nBao gồm cả màu nền mặc định và màu nền không mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在复制带颜色和字体样式的文本时排除所有背景颜色？\n这包括默认背景颜色以及非默认背景颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以顏色和字體樣式拷貝文字時，排除所有背景顏色？\n這包含預設背景顏色和非預設背景顏色。"
          }
        }
      }
    },
    "AdvancedSetting.excludeUtunFromNetworkUtilization" : {
      "comment" : "Advanced setting: excludeUtunFromNetworkUtilization",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechat rozhraní utun z využití sítě?\nUžitečné, pokud používáte VPN a chcete vidět pouze provoz přes Wi-Fi nebo Ethernet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udelad utun-grænseflader fra netværksforbrug?\nDet er nyttigt, hvis du bruger en VPN og kun vil se trafikken over Wi-Fi eller Ethernet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "utun-Schnittstellen von der Netzwerkauslastung ausschließen?\nDies ist nützlich, wenn Sie ein VPN verwenden und nur den Datenverkehr über WLAN oder Ethernet sehen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exclude utun interfaces from network utilization?\nThis is useful if you use a VPN and only want to see the traffic that goes over Wi-Fi or Ethernet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Excluir las interfaces utun de la utilización de red?\nEs útil si usas una VPN y solo quieres ver el tráfico que pasa por Wi-Fi o Ethernet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätetäänkö utun-liitännät pois verkonkäytöstä?\nTämä on hyödyllistä, jos käytät VPN:ää ja haluat nähdä vain Wi-Fin tai Ethernetin kautta kulkevan liikenteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclure les interfaces utun de l’utilisation du réseau ?\nUtile si vous utilisez un VPN et ne voulez voir que le trafic passant par le Wi-Fi ou l’Ethernet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludere le interfacce utun dall’utilizzo di rete?\nÈ utile se usi una VPN e vuoi vedere solo il traffico che passa da Wi-Fi o Ethernet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク使用率から utun インターフェースを除外しますか?\nVPN を使用していて、Wi-Fi または Ethernet 経由のトラフィックのみを確認したい場合に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 사용량에서 utun 인터페이스를 제외하겠습니까?\nVPN을 사용하면서 Wi-Fi 또는 이더넷을 통한 트래픽만 보고 싶을 때 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utelate utun-grensesnitt fra nettverksutnyttelsen?\nDette er nyttig hvis du bruker VPN og bare vil se trafikken som går over Wi-Fi eller Ethernet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "utun-interfaces uitsluiten van het netwerkgebruik?\nDit is handig als je een VPN gebruikt en alleen het verkeer via wifi of Ethernet wilt zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykluczyć interfejsy utun z użycia sieci?\nPrzydatne, jeśli używasz VPN i chcesz widzieć tylko ruch przez Wi-Fi lub Ethernet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir interfaces utun da utilização de rede?\nIsto é útil se você usa uma VPN e só quer ver o tráfego que passa por Wi-Fi ou Ethernet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключать интерфейсы utun из использования сети?\nЭто полезно, если вы используете VPN и хотите видеть только трафик, идущий через Wi-Fi или Ethernet."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynechať rozhrania utun z využitia siete?\nUžitočné, ak používate VPN a chcete vidieť iba prevádzku cez Wi-Fi alebo Ethernet."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izključi vmesnike utun iz izkoriščenosti omrežja?\nUporabno, če uporabljate VPN in želite videti samo promet prek Wi-Fi ali etherneta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undanta utun-gränssnitt från nätverksanvändningen?\nDetta är användbart om du använder ett VPN och bara vill se trafiken över Wi-Fi eller Ethernet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "utun arayüzleri ağ kullanımından hariç tutulsun mu?\nBir VPN kullanıyor ve yalnızca Wi-Fi veya Ethernet üzerinden geçen trafiği görmek istiyorsanız yararlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loại trừ các giao diện utun khỏi mức sử dụng mạng?\nHữu ích nếu bạn dùng VPN và chỉ muốn xem lưu lượng đi qua Wi-Fi hoặc Ethernet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在显示网络使用情况时排除utun接口？\n如果您使用了VPN，只想查看通过Wi-Fi或以太网传输的流量，此功能非常有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網路使用量排除 utun 介面？\n如果你使用 VPN，並且只想看到經由 Wi-Fi 或乙太網路傳送的流量，這會很有用。"
          }
        }
      }
    },
