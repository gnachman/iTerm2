        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랙패드 스크롤을 빠르게 하겠습니까?\n이전 스크롤 속도를 사용하려면 아니요로 설정하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruller pekefeltet raskt?\nSett til Nei for gammel rullehastighet."
