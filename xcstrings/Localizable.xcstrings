    "Tip.0110.Body" : {
      "comment" : "Tip of the day body, id 0110",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieben Sie Inhalte mit ⌥⌘V vom Eingabefenster in das Fenster „Erweitertes Einfügen“, um weitere Bearbeitungsoptionen zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move content from the Composer to the Advanced Paste window with ⌥⌘V for additional editing options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve contenido del compositor a la ventana de Pegado avanzado con ⌥⌘V para disponer de más opciones de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez le contenu du compositeur vers la fenêtre Collage avancé avec ⌥⌘V pour disposer d’options de modification supplémentaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il contenuto dal Compositore alla finestra Incolla avanzato con ⌥⌘V per avere altre opzioni di modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘Vを使うと、コンポーザーの内容を高度なペーストウィンドウに移動して、さらに編集オプションを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘V를 사용하여 컴포저의 내용을 고급 붙여넣기 윈도우로 옮기면 추가 편집 옵션을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova conteúdo do Compositor para a janela do Advanced Paste com ⌥⌘V para opções de edição adicionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещайте содержимое из Композера в окно расширенной вставки с помощью ⌥⌘V для дополнительных параметров редактирования."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek düzenleme seçenekleri için içeriği ⌥⌘V ile Oluşturucu’dan Gelişmiş Yapıştırma penceresine taşıyın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘V 将 Composer 中的内容移动到高级粘贴窗口，以获得更多编辑选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘V 將編寫器中的內容移至進階貼上視窗，取得更多編輯選項。"
          }
        }
      }
    },
