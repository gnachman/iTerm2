        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer clic, abre un menú de disparadores. Puedes usarlo para activar o desactivar disparadores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikattaessa avaa käynnistinvalikon. Sillä voit ottaa käynnistimiä käyttöön tai poistaa niitä käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au clic, ouvre un menu de déclencheurs. Vous pouvez l’utiliser pour activer ou désactiver des déclencheurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si fa clic, apre un menu di attivatori. Puoi usarlo per abilitare o disabilitare gli attivatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックするとトリガーのメニューが開きます。トリガーの有効/無効を切り替えるのに使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭하면 트리거 메뉴가 열립니다. 이 메뉴에서 트리거를 켜거나 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du klikker, åpnes en meny med utløsere. Du kan bruke den til å aktivere eller deaktivere utløsere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent bij klikken een menu met triggers. Hiermee kun je triggers in- of uitschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknięciu otwiera menu wyzwalaczy. Możesz go użyć do włączania i wyłączania wyzwalaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando clicado, abre um menu de gatilhos. Você pode usá-lo para ativar ou desativar gatilhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При нажатии открывает меню триггеров. С его помощью можно включать и отключать триггеры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknutí otvorí menu spúšťačov. Môžete ho použiť na zapnutie alebo vypnutie spúšťačov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob kliku odpre meni sprožilcev. Z njim lahko omogočite ali onemogočite sprožilce."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar en meny med utlösare när du klickar. Du kan använda den för att aktivera eller avaktivera utlösare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıklandığında bir tetikleyici menüsü açar. Tetikleyicileri etkinleştirmek veya devre dışı bırakmak için kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bấm, mở một menu trình kích hoạt. Bạn có thể dùng nó để bật hoặc tắt trình kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按后打开触发器菜单，可用于启用或停用触发器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下時會打開觸發器選單，可用來啟用或停用觸發器。"
          }
        }
      }
    },
