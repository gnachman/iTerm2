    "Tip.0052.Body" : {
      "comment" : "Tip of the day body, id 0052",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové panely se obvykle objeví na konci řádku panelů. V „Nastavení > Pokročilé“ je volba, která je umístí vedle aktuálního panelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt vises nye faner i slutningen af fanelinjen. Der er en indstilling i “Indstillinger > Avanceret”, så de placeres ved siden af din aktuelle fane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalerweise erscheinen neue Tabs am Ende der Tab-Leiste. Unter „Einstellungen > Erweitert“ gibt es eine Einstellung, mit der sie stattdessen neben dem aktuellen Tab platziert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally, new tabs appear at the end of the tab bar. There’s a setting in “Settings > Advanced” to place them next to your current tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente, las pestañas nuevas aparecen al final de la barra de pestañas. Hay un ajuste en “Ajustes > Avanzado” para colocarlas junto a la pestaña actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaalisti uudet välilehdet tulevat välilehtipalkin loppuun. Kohdassa ”Asetukset > Lisävalinnat” on asetus, jolla ne sijoitetaan nykyisen välilehden viereen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalement, les nouveaux onglets apparaissent à la fin de la barre d’onglets. Un réglage dans « Réglages > Avancé » permet de les placer à côté de l’onglet actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di solito i nuovi pannelli compaiono alla fine della barra dei pannelli. In “Impostazioni > Avanzate” c’è un’impostazione per collocarli accanto al pannello corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常、新しいタブはタブバーの末尾に表示されます。「設定 > 詳細」の設定で、現在のタブの隣に配置することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적으로 새로운 탭은 탭 막대의 끝에 나타납니다. “설정 > 고급”에는 새로운 탭을 현재 탭 옆에 배치하는 설정이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanligvis vises nye faner på slutten av fanelinjen. Det finnes en innstilling i «Innstillinger > Avansert» for å plassere dem ved siden av gjeldende fane."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaal verschijnen nieuwe tabbladen aan het einde van de tabbladbalk. Er is een instelling in ‘Instellingen > Geavanceerd’ om ze naast je huidige tabblad te plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalnie nowe karty pojawiają się na końcu paska kart. W „Ustawienia > Zaawansowane” jest ustawienie, które umieszcza je obok bieżącej karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente, novas abas aparecem no fim da barra de abas. Há um ajuste em “Ajustes > Avançado” para colocá-las ao lado da aba atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно новые вкладки появляются в конце панели вкладок. В «Настройки > Дополнительные» есть параметр, позволяющий размещать их рядом с текущей вкладкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové taby sa normálne zobrazujú na konci lišty s tabmi. V časti „Nastavenia > Rozšírené“ je nastavenie, ktoré ich umiestni vedľa aktuálneho tabu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi zavihki se običajno pojavijo na koncu vrstice z zavihki. V »Nastavitve > Napredno« je nastavitev, s katero jih postavite ob trenutni zavihek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt visas nya flikar i slutet av flikfältet. Det finns en inställning i ”Inställningar > Avancerat” för att placera dem bredvid den aktuella fliken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalde yeni sekmeler sekme çubuğunun sonunda görünür. “Ayarlar > Gelişmiş” bölümünde bunları geçerli sekmenizin yanına yerleştiren bir ayar var."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông thường, tab mới xuất hiện ở cuối thanh tab. Có một cài đặt trong “Cài đặt > Nâng cao” để đặt chúng cạnh tab hiện tại của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常，新标签页会出现在标签页栏的末尾。在“设置 > 高级”中有一个设置可以将它们放在当前标签页旁边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般來說，新的標籤頁會出現在標籤頁列的最後面。你可以在「設定 > 進階」中設定，讓它們出現在目前標籤頁的旁邊。"
          }
        }
      }
    },
