    "Tip.0093.Body" : {
      "comment" : "Tip of the day body, id 0093",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenden Sie Tastenzuordnungen einheitlich über mehrere Sitzungen hinweg an, um eine konsistente Steuerung in verschiedenen Tabs oder Fenstern zu gewährleisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apply key bindings uniformly across multiple sessions for consistent control in different tabs or windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica asignaciones de teclas de manera uniforme en varias sesiones para un control coherente en distintas pestañas o ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez des associations de touches de manière uniforme à plusieurs sessions pour un contrôle cohérent dans différents onglets ou fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica le associazioni tasti in modo uniforme a più sessioni per un controllo coerente in pannelli o finestre diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のセッションに一律にキーバインディングを適用することで、異なるタブやウィンドウでも一貫した操作ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 세션에 키 바인딩을 일괄 적용하여 서로 다른 탭이나 윈도우에서도 일관되게 제어할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique atalhos de teclado de maneira uniforme em várias sessões para um controle consistente em diferentes abas ou janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте привязки клавиш единообразно к нескольким сессиям для согласованного управления в разных вкладках или окнах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı sekmelerde veya pencerelerde tutarlı denetim için tuş atamalarını birden çok oturumda aynı şekilde uygulayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多个标签页或窗口中统一应用按键绑定，以实现一致控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多個工作階段中統一套用按鍵對應，讓不同標籤頁或視窗中的操作保持一致。"
          }
        }
      }
    },
