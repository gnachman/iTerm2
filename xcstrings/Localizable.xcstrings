    "APIHelper.AppSupportMovedMessage" : {
      "comment" : "Warning shown when the Application Support directory has moved",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherort Ihres Application-Support-Verzeichnisses scheint sich verschoben zu haben oder dessen Inhalt hat sich unerwartet geändert. Als Vorsichtsmaßnahme wurde der Authentifizierungsmechanismus für Python-API-Skripte von iTerm2 zurückgesetzt, sodass immer die Automatisierungsberechtigung erforderlich ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The location of your Application Support directory appears to have moved or its contents have changed unexpectedly. As a precaution, the authentication mechanism for Python API scripts for iTerm2 has been reverted to always require Automation permission."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application Supportディレクトリの場所が移動したか、その内容が予期せず変更されたようです。予防措置として、iTerm2のPython APIスクリプトの認証の仕組みは、常にオートメーション権限を要求するように戻されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application Support 디렉토리의 위치가 이동되었거나 내용이 예기치 않게 변경된 것 같습니다. 예방 차원에서 iTerm2 Python API 스크립트의 인증 방식이 항상 자동화 권한을 요구하도록 되돌려졌습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização da sua pasta Application Support parece ter mudado ou seu conteúdo foi alterado de forma inesperada. Como precaução, o mecanismo de autenticação para scripts da API do Python do iTerm2 foi revertido para sempre exigir a permissão de Automação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что расположение папки Application Support изменилось или её содержимое было неожиданно изменено. В целях безопасности механизм аутентификации скриптов Python API для iTerm2 возвращён к режиму, при котором всегда требуется разрешение Automation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Application Support 目录位置似乎已移动或其内容发生意外更改。为以防万一，iTerm2 的 Python API 脚本认证机制已恢复为始终要求“自动化”权限。"
          }
        }
      }
    },
    "APIHelper.AuthReasonAllAppsAllowed" : {
      "comment" : "API authorization reason logged when access is granted because the user enabled the allow-all-apps setting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps dürfen die API verwenden, gemäß „Einstellungen > Allgemein > Magie > Verbindung für alle Apps erlauben“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All apps are allowed to use the API, per “Settings > General > Magic > Allow all apps to connect”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > 一般 > Magic > すべてのアプリの接続を許可」の設定により、すべてのアプリがAPIの使用を許可されています。"
          }
        },
        "ko" : {
