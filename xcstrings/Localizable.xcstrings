    "Tip.0083.Body" : {
      "comment" : "Tip of the day body, id 0083",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportieren Sie Umgebungsvariablen und kopieren Sie Dateien mit der SSH-Integration nahtlos auf entfernte Hosts. Konfigurieren Sie entweder ein Profil für die Verwendung von ssh, oder nutzen Sie it2ssh anstelle von ssh."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Export environment variables and copy files to remote hosts seamlessly with SSH integration. Either configure a profile to use ssh or use it2ssh in place of ssh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta variables de entorno y copia archivos a hosts remotos sin complicaciones con la integración con SSH. Configura un perfil para usar ssh o usa it2ssh en lugar de ssh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez des variables d’environnement et copiez des fichiers vers des hôtes distants en toute fluidité avec l’intégration SSH. Configurez un profil pour utiliser ssh ou utilisez it2ssh à la place de ssh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta variabili d’ambiente e copia file sugli host remoti senza difficoltà con l’integrazione SSH. Configura un profilo per usare ssh oppure usa it2ssh al posto di ssh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合を使うと、環境変数のエクスポートやファイルのコピーをリモートホストへシームレスに行えます。プロファイルでsshを使うよう設定するか、sshの代わりにit2sshを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합을 사용하면 환경 변수를 내보내고 파일을 원격 호스트로 매끄럽게 복사할 수 있습니다. 프로파일에서 ssh를 사용하도록 구성하거나 ssh 대신 it2ssh를 사용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte variáveis de ambiente e copie arquivos para hosts remotos de forma integrada com o SSH Integration. Configure um perfil para usar ssh ou use it2ssh no lugar de ssh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортируйте переменные окружения и копируйте файлы на удалённые хосты без лишних усилий с помощью интеграции с SSH. Настройте профиль на использование ssh или используйте it2ssh вместо ssh."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH entegrasyonuyla ortam değişkenlerini dışa aktarın ve dosyaları uzak ana makinelere sorunsuzca kopyalayın. Bir profili ssh kullanacak şekilde yapılandırın veya ssh yerine it2ssh kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 SSH 集成，可以无缝导出环境变量并将文件复制到远程主机。既可以配置配置文件以使用 ssh，也可以使用 it2ssh 替代 ssh。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 SSH 整合，可以無縫匯出環境變數並將檔案拷貝到遠端主機。你可以將描述檔設定為使用 ssh，或是用 it2ssh 取代 ssh。"
          }
        }
      }
    },
