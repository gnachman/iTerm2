          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een besturingsreeks probeerde een sessie te activeren. Wil je dit toestaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekwencja sterująca próbowała aktywować sesję. Pozwolić na to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sequência de controle tentou ativar uma sessão. Permitir?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляющая последовательность попыталась активировать сессию. Разрешить это?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riadiaca sekvencia sa pokúsila aktivovať reláciu. Povoliť to?"
          }
        },
        "sl" : {
