      }
    },
    "AdvancedSetting.sessionEndMessageDividerCharacter" : {
      "comment" : "Advanced setting: sessionEndMessageDividerCharacter",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen für Trennlinien in Meldungen zum Sitzungsende. Leer lassen, um den sicheren Standard (BrokenPipeDivider-Bild) zu verwenden. Beispiele: ━ ─ ═ ╌ ┄"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Character to use for divider lines in session end messages. Leave empty to use secure default (BrokenPipeDivider image). Examples: ━ ─ ═ ╌ ┄"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carácter para las líneas divisorias en los mensajes de fin de sesión. Déjalo vacío para usar el valor seguro predeterminado (imagen BrokenPipeDivider). Ejemplos: ━ ─ ═ ╌ ┄"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractère à utiliser pour les lignes de séparation dans les messages de fin de session. Laissez vide pour utiliser la valeur par défaut sécurisée (image BrokenPipeDivider). Exemples : ━ ─ ═ ╌ ┄"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carattere da usare per le righe divisorie nei messaggi di fine sessione. Lascia vuoto per usare il valore predefinito sicuro (immagine BrokenPipeDivider). Esempi: ━ ─ ═ ╌ ┄"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション終了メッセージの区切り線に使用する文字。空欄の場合は安全なデフォルト（BrokenPipeDivider画像）を使用します。例：━ ─ ═ ╌ ┄"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 종료 메시지의 구분선에 사용할 문자. 안전한 기본값(BrokenPipeDivider 이미지)을 사용하려면 비워 두십시오. 예: ━ ─ ═ ╌ ┄"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractere a usar nas linhas divisórias das mensagens de fim de sessão. Deixe vazio para usar o padrão seguro (imagem BrokenPipeDivider). Exemplos: ━ ─ ═ ╌ ┄"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символ для линий-разделителей в сообщениях о завершении сеанса. Оставьте пустым, чтобы использовать безопасное значение по умолчанию (изображение BrokenPipeDivider). Примеры: ━ ─ ═ ╌ ┄"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum sonu iletilerinde ayırıcı çizgiler için kullanılacak karakter. Güvenli varsayılanı (BrokenPipeDivider görüntüsü) kullanmak için boş bırakın. Örnekler: ━ ─ ═ ╌ ┄"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话结束消息中用于分隔线的字符。留空则使用默认安全分隔符（BrokenPipeDivider图像）。示例： ━ ─ ═ ╌ ┄"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段結束訊息中用於分隔線的字元。留空則使用安全的預設值（BrokenPipeDivider 圖像）。範例：━ ─ ═ ╌ ┄"
          }
        }
      }
    },
