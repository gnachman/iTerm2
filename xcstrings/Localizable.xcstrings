    "Tip.0006.Body" : {
      "comment" : "Tip of the day body, id 0006",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkopírujte výběr pomocí ⌥⌘C, aby se zachovaly styly, například barvy a písma. Tuto akci můžete nastavit jako výchozí pro Zkopírovat v „Nastavení > Pokročilé“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier en markering med ⌥⌘C for at medtage typografier som farver og skrifter. Du kan gøre dette til standardhandlingen for Kopier i “Indstillinger > Avanceret”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie eine Auswahl mit ⌥⌘C, um Stile wie Farben und Schriftarten einzuschließen. Sie können dies unter „Einstellungen > Erweitert“ zur Standardaktion für „Kopieren“ machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy a selection with ⌥⌘C to include styles such as colors and fonts. You can make this the default action for Copy in “Settings > Advanced.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia una selección con ⌥⌘C para incluir estilos como colores y tipos de letra. Puedes hacer que esta sea la acción predeterminada de Copiar en “Ajustes > Avanzado”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopioi valinta painamalla ⌥⌘C, jolloin tyylit, kuten värit ja fontit, otetaan mukaan. Voit tehdä tästä Kopioi-toiminnon oletuksen kohdassa ”Asetukset > Lisävalinnat”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez une sélection avec ⌥⌘C pour inclure les styles, comme les couleurs et les polices. Vous pouvez en faire l’action par défaut de Copier dans « Réglages > Avancé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia una selezione con ⌥⌘C per includere stili come colori e font. Puoi rendere questa l’azione predefinita di Copia in “Impostazioni > Avanzate”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘C で選択範囲をコピーすると、色やフォントなどのスタイルも含められます。「設定 > 詳細」でこれをコピーのデフォルト動作にすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘C로 선택 영역을 복사하면 색상 및 서체와 같은 스타일이 포함됩니다. “설정 > 고급”에서 이 동작을 복사의 기본 동작으로 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier en markering med ⌥⌘C for å ta med stiler som farger og fonter. Du kan gjøre dette til standardhandlingen for Kopier i «Innstillinger > Avansert»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer een selectie met ⌥⌘C om stijlen zoals kleuren en lettertypen mee te nemen. Je kunt dit de standaardactie voor Kopieer maken in ‘Instellingen > Geavanceerd’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj zaznaczenie skrótem ⌥⌘C, aby zachować style, takie jak kolory i czcionki. Możesz ustawić to jako domyślną akcję Kopiuj w „Ustawienia > Zaawansowane”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie uma seleção com ⌥⌘C para incluir estilos como cores e fontes. Você pode tornar esta a ação padrão para Copiar em “Ajustes > Avançado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте выделение с помощью ⌥⌘C, чтобы сохранить стили, такие как цвета и шрифты. Вы можете сделать это действием по умолчанию для команды «Копировать» в «Настройки > Дополнительно»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výber skopírujete pomocou ⌥⌘C vrátane štýlov, ako sú farby a písma. Môžete to nastaviť ako predvolenú akciu pre Kopírovať v časti „Nastavenia > Rozšírené“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbor kopirajte z ⌥⌘C, da vključite sloge, kot so barve in pisave. To lahko nastavite kot privzeto dejanje za Kopiraj v »Nastavitve > Napredno«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiera en markering med ⌥⌘C för att ta med stilar som färger och typsnitt. Du kan göra det till förvald åtgärd för Kopiera i ”Inställningar > Avancerat”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renkler ve fontlar gibi stilleri dahil etmek için bir seçimi ⌥⌘C ile kopyalayın. Bunu “Ayarlar > Gelişmiş” bölümünde Kopyala için varsayılan eylem yapabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép vùng chọn bằng ⌥⌘C để bao gồm các kiểu như màu và phông chữ. Bạn có thể đặt đây làm tác vụ mặc định cho Sao chép trong “Cài đặt > Nâng cao.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘C 复制选中的内容，可包含颜色、字体等样式。你可以在“设置 > 高级”中将此设为复制的默认操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘C 拷貝選取範圍，可以包含顏色和字體等樣式。你可以在「設定 > 進階」中將此設為「拷貝」的預設動作。"
          }
        }
      }
    },
