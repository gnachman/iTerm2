    "AdvancedSetting.noSyncNewTabFromTmuxOpensTmux" : {
      "comment" : "Advanced setting: noSyncNewTabFromTmuxOpensTmux",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnhinweis unterdrücken, der fragt, welche Art von Tab bei der tmux-Integration geöffnet werden soll.\nHINWEIS: Dies wird nur wirksam, wenn die inzwischen veraltete Einstellung „Warnhinweis unterdrücken, der fragt, welche Art von Tab/Fenster bei der tmux-Integration geöffnet werden soll“ deaktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress alert asking what kind of tab to open in tmux integration.\nNOTE: This only takes effect if the now-deprecated “Suppress alert asking what kind of tab/window to open in tmux integration” setting is off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合でどの種類のタブを開くかを尋ねるアラートを表示しない。\n注：これは、非推奨となった「tmux統合でどの種類のタブ／ウィンドウを開くかを尋ねるアラートを表示しない」設定がオフの場合にのみ有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합에서 열 탭의 종류를 묻는 경고 표시 안 함.\n참고: 이제 더 이상 사용되지 않는 “tmux 통합에서 열 탭/윈도우의 종류를 묻는 경고 표시 안 함” 설정이 꺼져 있을 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o alerta que pergunta que tipo de aba abrir na integração do tmux.\nNOTA: Isto só tem efeito se o ajuste agora obsoleto “Suprimir o alerta que pergunta que tipo de aba/janela abrir na integração do tmux” estiver desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить запрос о том, какую вкладку открыть при интеграции с tmux.\nПРИМЕЧАНИЕ. Это действует только в том случае, если устаревший параметр «Отключить запрос о том, какую вкладку/окно открыть при интеграции с tmux» выключен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制tmux集成中打开标签页的提示。\n注意：仅当已废弃的“抑制tmux集成中打开标签页/窗口的提示”设置关闭时，此功能才生效。"
          }
        }
      }
    },
    "AdvancedSetting.noSyncNewWindowFromTmuxOpensTmux" : {
      "comment" : "Advanced setting: noSyncNewWindowFromTmuxOpensTmux",
      "extractionState" : "extracted_with_value",
      "localizations" : {
