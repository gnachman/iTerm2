    "ScriptArchive.ExplicitAutoLaunchMessage" : {
      "comment" : "Prompt asking whether to allow a script to auto-launch; %@ is the script name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript „%@“ se může automaticky spustit při spuštění iTerm2. Chcete to povolit?"
          }
        },
        "da" : {
          "stringUnit" : {
