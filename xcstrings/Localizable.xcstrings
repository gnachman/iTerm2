    "AdvancedSetting.dockIconTogglesWindow" : {
      "comment" : "Advanced setting: dockIconTogglesWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je jediným oknem okno horké klávesy, kliknutí na ikonu v Docku jej zobrazí nebo skryje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det eneste vindue er et genvejstastvindue, viser eller skjuler et klik på symbolet i Dock det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das einzige Fenster ein Hotkey-Fenster ist, zeigt oder verbirgt ein Klick auf das Dock-Symbol es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If the only window is a hotkey window, then clicking the dock icon shows or hides it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la única ventana es una ventana de tecla rápida, al hacer clic en el icono del Dock se muestra u oculta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos ainoa ikkuna on pikanäppäinikkuna, Dock-kuvakkeen klikkaaminen näyttää tai kätkee sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la seule fenêtre est une fenêtre à raccourci global, un clic sur l’icône du Dock l’affiche ou la masque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’unica finestra è una finestra ad abbreviazione globale, fare clic sull’icona del Dock la mostra o la nasconde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唯一のウィンドウがホットキーウィンドウである場合、Dock アイコンをクリックするとそれを表示または非表示にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유일한 윈도우가 단축키 윈도우이면 Dock 아이콘을 클릭할 때 해당 윈도우를 보이거나 가립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det eneste vinduet er et hurtigtastvindu, viser eller skjuler et klikk på Dock-symbolet det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het enige venster een sneltoetsvenster is, toont of verbergt een klik op het Dock-symbool het venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli jedynym oknem jest okno klawisza skrótu, kliknięcie ikony w Docku pokazuje je lub ukrywa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a única janela for uma janela de hotkey, clicar no ícone do dock a mostra ou oculta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если единственное окно — это окно по горячей клавише, то щелчок по значку в Dock показывает или скрывает его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je jediným oknom okno aktivačnej skratky, kliknutie na ikonu v Docku ho zobrazí alebo skryje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je edino okno okno hitre tipke, klik na ikono Dock to okno prikaže ali skrije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det enda fönstret är ett snabbtangentsfönster visar eller gömmer ett klick på Dock-symbolen det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek pencere bir kısayol tuşu penceresiyse Dock simgesini tıklamak onu gösterir veya gizler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu cửa sổ duy nhất là cửa sổ phím nóng, bấm biểu tượng Dock sẽ hiển thị hoặc ẩn nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果唯一的窗口是热键窗口，那么点击 Dock 图标即可显示或隐藏它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果唯一的視窗是全域快速鍵視窗，按一下 Dock 圖像會顯示或隱藏它。"
          }
        }
      }
    },
