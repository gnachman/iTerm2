    "DebugLogging.LoggingEnabledMessage" : {
      "comment" : "Alert message instructing the user to reproduce the bug while debug logging is on",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodukujte chybu. Poté ladicí protokolování znovu vypněte, aby se protokol uložil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genskab fejlen. Slå derefter fejlfindingslog til/fra igen for at gemme loggen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte reproduzieren Sie den Fehler. Schalten Sie dann die Debug-Protokollierung erneut um, um das Protokoll zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please reproduce the bug. Then toggle debug logging again to save the log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el error. Después, activa o desactiva de nuevo el registro de depuración para guardar el registro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista virhe. Laita sitten vianmääritysloki uudelleen päälle/pois tallentaaksesi lokin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduisez le bogue. Activez/désactivez ensuite à nouveau la journalisation de débogage pour enregistrer le journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci il bug. Poi attiva/disattiva di nuovo il log di debug per salvare il log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグを再現させてください。その後、デバッグログを再度切り替えるとログが保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버그를 재현하십시오. 그런 다음 디버그 로깅을 다시 전환하면 로그가 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenskap feilen. Slå deretter feilsøkingslogging av/på igjen for å lagre loggen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduceer de bug. Schakel daarna de debuglogging opnieuw in of uit om het log te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwórz błąd. Następnie ponownie włącz/wyłącz dziennik debugowania, aby zachować dziennik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza o problema. Depois alterne o log de depuração novamente para salvar o log."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, воспроизведите ошибку. Затем снова переключите отладочное журналирование, чтобы сохранить журнал."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zopakujte chybu. Potom ladiace zaznamenávanie znova prepnite, aby sa záznam uložil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovite napako. Nato znova preklopite beleženje za iskanje napak, da shranite dnevnik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återskapa felet. Slå sedan på/av felsökningsloggning igen för att spara loggen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen hatayı yeniden oluşturun. Ardından günlüğü kaydetmek için hata ayıklama günlüğünü yeniden aç/kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tái hiện lỗi. Sau đó bật/tắt lại nhật ký gỡ lỗi để lưu nhật ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请复现该问题，然后再次切换调试日志以保存日志。"
