    "Tip.0021.Body" : {
      "comment" : "Tip of the day body, id 0021",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodítko kurzoru je vodorovná čára, která sleduje kurzor. Můžete ho zapnout v „Nastavení > Profily > Barvy“ nebo přepínat zkratkou ⌥⌘;."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markørlinjalen er en vandret linje, der følger din markør. Du kan slå den til i “Indstillinger > Profiler > Farver” eller slå den til/fra med genvejen ⌥⌘;."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cursor-Führungslinie ist eine horizontale Linie, die Ihrem Cursor folgt. Sie können sie unter „Einstellungen > Profile > Farben“ aktivieren oder mit der Tastenkombination ⌥⌘; umschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The cursor guide is a horizontal line that follows your cursor. You can turn it on in “Settings > Profiles > Colors” or toggle it with the ⌥⌘; shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guía del cursor es una línea horizontal que sigue al cursor. Puedes activarla en “Ajustes > Perfiles > Colores” o alternarla con el atajo ⌥⌘;."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdistinviiva on vaakaviiva, joka seuraa kohdistintasi. Voit ottaa sen käyttöön kohdassa ”Asetukset > Profiilit > Värit” tai kytkeä sen päälle/pois oikotiellä ⌥⌘;."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le repère du curseur est une ligne horizontale qui suit votre curseur. Vous pouvez l’activer dans « Réglages > Profils > Couleurs » ou l’activer/désactiver avec le raccourci ⌥⌘;."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guida cursore è una linea orizzontale che segue il cursore. Puoi attivarla in “Impostazioni > Profili > Colori” oppure attivarla/disattivarla con l’abbreviazione ⌥⌘;."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルガイドは、カーソルに追従する水平線です。「設定 > プロファイル > カラー」でオンにするか、⌥⌘;のショートカットで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서 가이드는 커서를 따라다니는 가로선입니다. “설정 > 프로파일 > 색상”에서 켜거나 ⌥⌘; 단축키로 켜고 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markørlinjalen er en horisontal linje som følger markøren din. Du kan slå den på i «Innstillinger > Profiler > Farger» eller slå den av/på med snarveien ⌥⌘;."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cursorhulplijn is een horizontale lijn die je cursor volgt. Je kunt die inschakelen in ‘Instellingen > Profielen > Kleuren’ of in/uitschakelen met de toetscombinatie ⌥⌘;."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prowadnica kursora to pozioma linia podążająca za kursorem. Możesz ją włączyć w „Ustawienia > Profile > Kolory” lub przełączać skrótem ⌥⌘;."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A guia do cursor é uma linha horizontal que acompanha o seu cursor. Você pode ativá-la em “Ajustes > Perfis > Cores” ou alterná-la com o atalho ⌥⌘;."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Направляющая курсора представляет собой горизонтальную линию, которая следует за курсором. Её можно включить в «Настройки > Профили > Цвета» или переключить сочетанием клавиш ⌥⌘;."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodiaca čiara kurzora je vodorovná čiara, ktorá sleduje váš kurzor. Zapnete ju v časti „Nastavenia > Profily > Farby“ alebo ju prepnete skratkou ⌥⌘;."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodilo kazalca je vodoravna črta, ki sledi kazalcu. Vklopite ga lahko v »Nastavitve > Profili > Barve« ali preklapljate z bližnjico ⌥⌘;."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markörlinjalen är en horisontell linje som följer markören. Du kan slå på den i ”Inställningar > Profiler > Färger” eller växla den med kortkommandot ⌥⌘;."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç kılavuzu, imlecinizi izleyen yatay bir çizgidir. “Ayarlar > Profiller > Renkler” bölümünden açabilir veya ⌥⌘; kısayoluyla açıp kapatabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vạch dẫn con trỏ là một đường ngang đi theo con trỏ của bạn. Bạn có thể bật nó trong “Cài đặt > Hồ sơ > Màu” hoặc bật/tắt bằng phím tắt ⌥⌘;."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标引导线是一个跟随 cursor 的水平线。你可以在“设置 > 配置文件 > 颜色”中开启它，或使用 ⌥⌘ 快捷键切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標輔助線是一條跟隨游標的水平線。你可以在「設定 > 描述檔 > 顏色」中開啟，或使用 ⌥⌘; 快速鍵切換。"
          }
        }
      }
    },
