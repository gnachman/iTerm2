          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка загрузок.\nЕсли задана, скачанные файлы попадают в это расположение вместо папки $HOME/Downloads пользователя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priečinok Stiahnuté súbory.\nAk je nastavený, stiahnuté súbory sa ukladajú sem namiesto užívateľovho priečinka $HOME/Downloads."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa prenosov.\nČe je nastavljena, gredo prenesene datoteke na to lokacijo namesto v uporabnikovo mapo $HOME/Downloads."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapp för hämtade filer.\nOm den är angiven hamnar hämtade filer här i stället för i användarens mapp $HOME/Downloads."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilenler klasörü.\nAyarlanırsa indirilen dosyalar kullanıcının $HOME/Downloads klasörü yerine bu konuma gider."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư mục tải về.\nNếu được đặt, các tệp tải về sẽ vào vị trí này thay vì thư mục $HOME/Downloads của người dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载文件夹。\n若已设置，下载的文件将存放在该位置，而非用户的 $HOME/Downloads 文件夹中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載項目檔案夾。\n設定後，下載的檔案會存放在此位置，而不是使用者的 $HOME/Downloads 檔案夾。"
          }
        }
      }
    },
