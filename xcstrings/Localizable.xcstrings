        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie beim Ziehen ⌥⌘ gedrückt, um eine rechteckige Auswahl zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
