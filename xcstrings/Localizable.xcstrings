    "Tip.0046.Body" : {
      "comment" : "Tip of the day body, id 0046",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Tabs Farben zuweisen, entweder unter „Einstellungen > Profile > Farben“ oder im Menü „Ansicht“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can assign colors to tabs in “Settings > Profiles > Colors,” or in the View menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes asignar colores a las pestañas en “Ajustes > Perfiles > Colores” o en el menú Visualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
