    "AdvancedSetting.webKitAdblockEnabled" : {
      "comment" : "Advanced setting: webKitAdblockEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbeblockierung im Webbrowser aktivieren?\nWenn aktiviert, werden Werbeblockierregeln von der konfigurierten URL heruntergeladen und angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable ad blocking in the web browser?\nWhen enabled, downloads and applies ad blocking rules from the configured URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar el bloqueo de anuncios en el navegador web?\nCuando está activado, descarga y aplica reglas de bloqueo de anuncios desde la URL configurada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le blocage des publicités dans le navigateur web ?\nSi activé, télécharge et applique les règles de blocage des publicités depuis l’URL configurée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare il blocco delle pubblicità nel browser web?\nSe attivo, scarica e applica le regole di blocco delle pubblicità dall’URL configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webブラウザで広告ブロックを有効にしますか？\n有効にすると、設定されたURLから広告ブロックルールをダウンロードして適用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 브라우저에서 광고 차단을 켜겠습니까?\n켜면 구성된 URL에서 광고 차단 규칙을 다운로드하여 적용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar bloqueio de anúncios no navegador web?\nQuando ativado, baixa e aplica regras de bloqueio de anúncios da URL configurada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить блокировку рекламы в веб-браузере?\nЕсли включено, загружает и применяет правила блокировки рекламы с настроенного URL."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web tarayıcısında reklam engelleme etkinleştirilsin mi?\nEtkinse yapılandırılan URL’den reklam engelleme kurallarını indirir ve uygular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在网页浏览器中启用广告拦截？\n当启用时，会下载并应用来自配置 URL 的广告拦截规则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在瀏覽器中啟用廣告封鎖？\n啟用後，會從設定的 URL 下載並套用廣告封鎖規則。"
          }
