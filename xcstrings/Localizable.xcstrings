        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "执行修饰键双击操作时，两次按下修饰键之间允许的最大时间间隔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行變更鍵連按兩下時，兩次按下變更鍵之間允許的最長時間。"
          }
        }
      }
    },
