      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positionieren Sie das Fenster „Tipp des Tages“ bequem auf Ihrem Bildschirm, denn es lässt sich jetzt per Ziehen verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
