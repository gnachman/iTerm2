    "AdvancedSetting.defaultWideMode" : {
      "comment" : "Advanced setting: defaultWideMode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má se při nativním vykreslování ve výchozím stavu používat široký režim?"
          }
        },
        "da" : {
          "stringUnit" : {
