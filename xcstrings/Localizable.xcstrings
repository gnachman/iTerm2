    "Tip.0002.Body" : {
      "comment" : "Tip of the day body, id 0002",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Věděli jste, že iTerm2 má správce hesel? Otevřete ho přes „Okno > Správce hesel“. Můžete definovat spouštěč, který ho otevře za vás u výzvy k zadání hesla, v „Nastavení > Profily > Pokročilé > Spouštěče“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidste du, at iTerm2 har en adgangskodeadministrator? Åbn den med “Vindue > Adgangskodeadministrator”. Du kan definere en udløser, der åbner den for dig ved en adgangskodeprompt, i “Indstillinger > Profiler > Avanceret > Udløsere”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wussten Sie, dass iTerm2 einen Passwort-Manager hat? Öffnen Sie ihn über „Fenster > Passwort-Manager“. Sie können einen Trigger definieren, der ihn bei einer Passwortabfrage automatisch öffnet, unter „Einstellungen > Profile > Erweitert > Trigger“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Did you know iTerm2 has a password manager? Open it with “Window > Password Manager.” You can define a Trigger to open it for you at a password prompt in “Settings > Profiles > Advanced > Triggers.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sabías que iTerm2 tiene un gestor de contraseñas? Ábrelo con “Ventana > Gestor de contraseñas”. Puedes definir un disparador que lo abra por ti cuando aparezca un prompt de contraseña en “Ajustes > Perfiles > Avanzado > Disparadores”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiesitkö, että iTerm2:ssa on salasanojen hallinta? Avaa se komennolla ”Ikkuna > Salasanojen hallinta”. Voit määrittää käynnistimen, joka avaa sen puolestasi salasanakehotteessa kohdassa ”Asetukset > Profiilit > Lisävalinnat > Käynnistimet”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saviez-vous qu’iTerm2 dispose d’un gestionnaire de mots de passe ? Ouvrez-le avec « Fenêtre > Gestionnaire de mots de passe ». Vous pouvez définir un déclencheur pour l’ouvrir à votre place lors d’une invite de mot de passe dans « Réglages > Profils > Avancé > Déclencheurs »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapevi che iTerm2 ha un gestore password? Aprilo con “Finestra > Gestore password”. Puoi definire un attivatore che lo apra per te quando compare un prompt della password in “Impostazioni > Profili > Avanzate > Attivatori”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 にパスワードマネージャーがあるのをご存知ですか? 「ウインドウ > パスワードマネージャー」から開けます。「設定 > プロファイル > 詳細 > トリガー」でトリガーを定義すれば、パスワードプロンプトで自動的に開かせることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2에 암호 관리자가 있다는 것을 알고 있었습니까? “윈도우 > 암호 관리자”로 열 수 있습니다. “설정 > 프로파일 > 고급 > 트리거”에서 암호 프롬프트가 나타날 때 암호 관리자를 열어 주는 트리거를 정의할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visste du at iTerm2 har en passordbehandler? Åpne den med «Vindu > Passordbehandler». Du kan definere en utløser som åpner den for deg ved en ledetekst for passord i «Innstillinger > Profiler > Avansert > Utløsere»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist je dat iTerm2 een wachtwoordbeheerder heeft? Open die met ‘Venster > Wachtwoordbeheerder’. Je kunt een trigger instellen die de wachtwoordbeheerder voor je opent bij een wachtwoordprompt, in ‘Instellingen > Profielen > Geavanceerd > Triggers’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy wiesz, że iTerm2 ma menedżera haseł? Otwórz go przez „Okno > Menedżer haseł”. Możesz zdefiniować wyzwalacz, który otworzy go za ciebie przy znaku zachęty hasła, w „Ustawienia > Profile > Zaawansowane > Wyzwalacze”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sabia que o iTerm2 tem um cofre de senhas? Abra-o em “Janela > Cofre de senhas”. Você pode definir um gatilho para abri-lo automaticamente em um prompt de senha em “Ajustes > Perfis > Avançado > Gatilhos”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаете ли вы, что в iTerm2 есть менеджер паролей? Откройте его через «Окно > Менеджер паролей». Вы можете настроить триггер, который будет открывать его автоматически при появлении запроса пароля, в «Настройки > Профили > Дополнительно > Триггеры»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedeli ste, že iTerm2 má správcu hesiel? Otvoríte ho cez menu „Okno > Správca hesiel“. V časti „Nastavenia > Profily > Rozšírené > Spúšťače“ môžete definovať spúšťač, ktorý ho otvorí pri výzve na zadanie hesla."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali ste vedeli, da ima iTerm2 upravitelja gesel? Odprete ga z »Okno > Upravitelj gesel«. Določite lahko sprožilec, ki ga odpre namesto vas ob pozivu za geslo, v »Nastavitve > Profili > Napredno > Sprožilci«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visste du att iTerm2 har en lösenordshanterare? Öppna den med ”Fönster > Lösenordshanterare”. Du kan definiera en utlösare som öppnar den åt dig vid en lösenordsprompt i ”Inställningar > Profiler > Avancerat > Utlösare”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin bir parola yöneticisi olduğunu biliyor muydunuz? “Pencere > Parola Yöneticisi” ile açabilirsiniz. Bir parola isteminde sizin için açılmasını sağlayan bir Tetikleyici’yi “Ayarlar > Profiller > Gelişmiş > Tetikleyiciler” bölümünde tanımlayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có biết iTerm2 có trình quản lý mật khẩu không? Mở nó bằng “Cửa sổ > Trình quản lý mật khẩu.” Bạn có thể định nghĩa một trình kích hoạt để tự mở nó khi có dấu nhắc mật khẩu trong “Cài đặt > Hồ sơ > Nâng cao > Trình kích hoạt.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道 iTerm2 有密码管理器吗？通过“Window > Password Manager”打开它。你可以在“Settings > Profiles > Advanced > Triggers”中定义触发器，在密码输入提示时自动打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道 iTerm2 有密碼管理器嗎？使用「視窗 > 密碼管理器」即可打開。你可以在「設定 > 描述檔 > 進階 > 觸發器」中定義觸發器，在出現密碼提示時自動為你打開。"
          }
        }
      }
    },
