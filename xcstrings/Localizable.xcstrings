    "ClaudeHealthMonitor.RemoteNotInstalledTitle" : {
      "comment" : "Body of the prompt offering to install the Claude Code hook on a remote host where claude is running; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code läuft auf %@, aber der Hook von iTerm2 ist dort nicht installiert, daher erscheint sein Status nicht im Werkzeug „Sitzungsstatus“. Jetzt installieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Claude Code is running on %@, but iTerm2’s hook isn’t installed there, so its status won’t appear in the Session Status tool. Install it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code se está ejecutando en %@, pero el hook de iTerm2 no está instalado allí, por lo que su estado no aparecerá en la herramienta Estado de la sesión. ¿Instalarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code s’exécute sur %@, mais le hook d’iTerm2 n’y est pas installé, son état n’apparaîtra donc pas dans l’outil État des sessions. L’installer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code è in esecuzione su %@, ma l’hook di iTerm2 non è installato lì, quindi il suo stato non apparirà nello strumento Stato sessione. Installarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でClaude Codeが実行されていますが、iTerm2のフックがそこにインストールされていないため、そのステータスはSession Statusツールに表示されません。インストールしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Claude Code가 실행 중이지만 그곳에 iTerm2 훅이 설치되어 있지 않아 세션 상태 도구에 상태가 표시되지 않습니다. 설치하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code está em execução em %@, mas o hook do iTerm2 não está instalado lá, então seu status não aparecerá na ferramenta Status da sessão. Instalá-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code работает на %@, но хук iTerm2 там не установлен, поэтому его статус не будет отображаться в инструменте «Статус сессии». Установить его?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code %@ ana makinesinde çalışıyor, ancak iTerm2’nin kancası orada yüklü değil; bu yüzden durumu Oturum Durumu aracında görünmeyecek. Yüklensin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 正在 %@ 上运行，但那里未安装 iTerm2 的钩子，因此其状态不会显示在“会话状态”工具中。要安装吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 正在 %@ 上執行，但該處未安裝 iTerm2 的 hook，因此其狀態不會顯示在「工作階段狀態」工具中。要安裝嗎？"
          }
        }
      }
    },
