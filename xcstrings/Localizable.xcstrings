          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CTYPE 環境変数を設定しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CTYPE 환경 변수를 설정하지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca definir a variável de ambiente CTYPE."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не устанавливать переменную окружения CTYPE."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切勿设置 CTYPE 环境变量。"
          }
        }
      }
    },
    "AdvancedSetting.dockIconTogglesWindow" : {
      "comment" : "Advanced setting: dockIconTogglesWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
