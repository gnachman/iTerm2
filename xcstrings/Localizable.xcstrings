    "SessionLauncher.IllegalManPageMessage" : {
      "comment" : "Warning message shown when an x-man-page URL contains disallowed characters.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Man-Page-URL enthielt ein unzulässiges Zeichen. Die zulässigen Zeichen sind aus Sicherheitsgründen eingeschränkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The man page URL contained a disallowed character. The set of allowed characters is limited for security reasons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL de la página man contenía un carácter no permitido. El conjunto de caracteres permitidos está limitado por motivos de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL de la page man contenait un caractère non autorisé. L’ensemble des caractères autorisés est limité pour des raisons de sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL della pagina man conteneva un carattere non consentito. L’insieme dei caratteri consentiti è limitato per motivi di sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "man ページの URL に使用できない文字が含まれていました。セキュリティ上の理由から、使用できる文字は制限されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "man 페이지 URL에 허용되지 않는 문자가 포함되어 있습니다. 보안상의 이유로 허용되는 문자가 제한되어 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A URL de man page continha um caractere não permitido. O conjunto de caracteres permitidos é limitado por motivos de segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL man-страницы содержит недопустимый символ. Набор разрешённых символов ограничен из соображений безопасности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "man sayfası URL’si izin verilmeyen bir karakter içeriyordu. İzin verilen karakter kümesi güvenlik nedeniyle sınırlıdır."
          }
        },
        "zh-Hans" : {
