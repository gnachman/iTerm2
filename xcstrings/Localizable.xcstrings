    "BrowserScriptingPermissions.Explanation" : {
      "comment" : "Explanation at the top of the panel listing websites that scripts may control in a browser session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než skript načte URL nebo spustí JavaScript na webové stránce v relaci prohlížeče, iTerm2 se vás zeptá. Zapamatované odpovědi jsou uvedeny zde a platí pro všechny skripty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før en instruks indlæser URL’er eller kører JavaScript på et websted i en browsersession, spørger iTerm2 dig. Huskede svar vises her og gælder for alle instrukser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor ein Skript URLs lädt oder JavaScript auf einer Website in einer Browser-Sitzung ausführt, fragt iTerm2 Sie. Gespeicherte Antworten werden hier aufgeführt und gelten für alle Skripte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before a script loads URLs or runs JavaScript on a website in a browser session, iTerm2 asks you. Remembered answers are listed here and apply to all scripts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de que un script cargue URLs o ejecute JavaScript en un sitio web en una sesión del navegador, iTerm2 te pregunta. Las respuestas recordadas se muestran aquí y se aplican a todos los scripts."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen kuin skripti lataa URL-osoitteita tai suorittaa JavaScriptiä verkkosivustolla selainistunnossa, iTerm2 kysyy sinulta. Muistetut vastaukset näkyvät tässä ja koskevat kaikkia skriptejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant qu’un script charge des URL ou exécute du JavaScript sur un site web dans une session de navigateur, iTerm2 vous le demande. Les réponses mémorisées sont listées ici et s’appliquent à tous les scripts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima che uno script carichi URL o esegua JavaScript su un sito web in una sessione browser, iTerm2 te lo chiede. Le risposte memorizzate sono elencate qui e valgono per tutti gli script."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリプトがブラウザセッションでWebサイトのURLを読み込んだりJavaScriptを実行したりする前に、iTerm2は確認を求めます。記憶された回答はここに一覧表示され、すべてのスクリプトに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 세션에서 스크립트가 웹 사이트의 URL을 로드하거나 JavaScript를 실행하기 전에 iTerm2가 사용자에게 묻습니다. 기억된 응답은 여기에 나열되며 모든 스크립트에 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før et skript laster URLs eller kjører JavaScript på et nettsted i en nettleserøkt, spør iTerm2 deg. Svar som er husket, vises her og gjelder alle skript."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voordat een script URL’s laadt of JavaScript uitvoert op een website in een browsersessie, vraagt iTerm2 het je. Onthouden antwoorden staan hier en gelden voor alle scripts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim skrypt załaduje adresy URL lub uruchomi JavaScript na stronie internetowej w sesji przeglądarki, iTerm2 zapyta cię o zgodę. Zapamiętane odpowiedzi są wymienione tutaj i dotyczą wszystkich skryptów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de um script carregar URLs ou executar JavaScript em um site em uma sessão do navegador, o iTerm2 pergunta a você. As respostas lembradas aparecem aqui e valem para todos os scripts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем скрипт загрузит URL или выполнит JavaScript на веб-сайте в сессии браузера, iTerm2 спрашивает вас. Запомненные ответы перечислены здесь и действуют для всех скриптов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predtým, než skript v relácii prehliadača načíta URL alebo spustí JavaScript na webovej stránke, iTerm2 sa vás opýta. Zapamätané odpovede sú uvedené tu a platia pre všetky skripty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preden skript v seji brskalnika naloži URL-je ali izvede JavaScript na spletnem mestu, iTerm2 vpraša vas. Zapomnjeni odgovori so navedeni tukaj in veljajo za vse skripte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan ett skript läser in URL:er eller kör JavaScript på en webbplats i en webbsession frågar iTerm2 dig. Sparade svar visas här och gäller för alla skript."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir betik tarayıcı oturumundaki bir web sitesinde URL yüklemeden veya JavaScript çalıştırmadan önce iTerm2 size sorar. Hatırlanan yanıtlar burada listelenir ve tüm betikler için geçerlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi một tập lệnh tải URL hoặc chạy JavaScript trên một trang web trong phiên trình duyệt, iTerm2 sẽ hỏi bạn. Các câu trả lời đã ghi nhớ được liệt kê ở đây và áp dụng cho mọi tập lệnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在脚本于浏览器会话中载入网站的 URL 或在网站上运行 JavaScript 之前，iTerm2 会先询问你。记住的回答会列在这里，并适用于所有脚本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在腳本於瀏覽器工作階段中載入網站的 URL 或執行 JavaScript 之前，iTerm2 會先詢問你。記住的答覆會列在這裡，並適用於所有腳本。"
          }
        }
      }
    },
