    "Tip.0005.Body" : {
      "comment" : "Tip of the day body, id 0005",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete si označit něco v historii posouvání? Klikněte pravým tlačítkem na výběr a zvolte „Anotovat výběr“, abyste k němu přidali osobní poznámku. Pomocí „Zobrazení > Zobrazit anotace“ je zobrazíte nebo skryjete a v „Úpravy > Značky a anotace“ najdete další možnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du markere noget i din rullebufferhistorik? Højreklik på en markering, og vælg “Annoter markering” for at tilføje en personlig note. Brug “Oversigt > Vis annoteringer” til at vise eller skjule dem, og se i “Rediger > Mærker og annoteringer” for flere ting, du kan gøre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie Ihren Scrollback-Verlauf markieren? Klicken Sie mit der rechten Maustaste auf eine Auswahl und wählen Sie „Auswahl kommentieren“, um eine persönliche Notiz hinzuzufügen. Verwenden Sie „Ansicht > Anmerkungen anzeigen“, um sie ein- oder auszublenden, und schauen Sie unter „Bearbeiten > Marken und Anmerkungen“ nach weiteren Möglichkeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want to mark up your scrollback history? Right click on a selection and choose “Annotate Selection” to add a personal note to it. Use “View > Show Annotations” to show or hide them, and look in “Edit > Marks and Annotations” for more things you can do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres marcar tu historial de desplazamiento? Haz clic con el botón derecho en una selección y elige “Anotar selección” para añadirle una nota personal. Usa “Visualización > Mostrar anotaciones” para mostrarlas u ocultarlas, y consulta “Edición > Marcas y anotaciones” para ver más cosas que puedes hacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko merkitä vierityshistoriaasi? Klikkaa valintaa oikealla painikkeella ja valitse ”Lisää huomautus valintaan” lisätäksesi siihen henkilökohtaisen muistiinpanon. Näytä tai kätke huomautukset komennolla ”Näytä > Näytä huomautukset”, ja katso lisää mahdollisuuksia kohdasta ”Muokkaa > Merkit ja huomautukset”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie d’annoter votre historique de défilement ? Faites un clic droit sur une sélection et choisissez « Annoter la sélection » pour y ajouter une note personnelle. Utilisez « Présentation > Afficher les annotations » pour les afficher ou les masquer, et consultez « Édition > Marques et annotations » pour d’autres possibilités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi annotare la cronologia di scorrimento? Fai clic con il tasto destro su una selezione e scegli “Annota selezione” per aggiungere una nota personale. Usa “Vista > Mostra annotazioni” per mostrarle o nasconderle e guarda in “Modifica > Contrassegni e annotazioni” per scoprire cos’altro puoi fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロールバックの履歴にマークを付けたいですか? 選択範囲を右クリックして「選択範囲に注釈を付ける」を選ぶと、個人的なメモを追加できます。「表示 > 注釈を表示」で表示・非表示を切り替えられます。また、「編集 > マークと注釈」には他にもできることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤백 기록에 표시를 하고 싶습니까? 선택 영역을 오른쪽 클릭하고 “선택 영역에 주석 달기”를 선택하여 개인 메모를 추가하십시오. “보기 > 주석 보기”로 주석을 보거나 가리고, “편집 > 마크 및 주석”에서 할 수 있는 다른 작업을 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du markere ting i tilbakerullingen din? Høyreklikk på en markering og velg «Legg til merknad på markering» for å legge til et personlig notat. Bruk «Vis > Vis merknader» for å vise eller skjule dem, og se i «Rediger > Merker og merknader» for flere ting du kan gjøre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je aantekeningen maken in je scrollbackgeschiedenis? Klik met de rechtermuisknop op een selectie en kies ‘Annoteer selectie’ om er een persoonlijke notitie aan toe te voegen. Gebruik ‘Weergave > Toon annotaties’ om ze te tonen of te verbergen, en kijk in ‘Wijzig > Markeringen en annotaties’ voor meer mogelijkheden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcesz oznaczyć coś w buforze przewijania? Kliknij zaznaczenie prawym przyciskiem i wybierz „Dodaj adnotację do zaznaczenia”, aby dodać do niego osobistą notatkę. Użyj „Widok > Pokaż adnotacje”, aby je pokazać lub ukryć, a w „Edycja > Znaczniki i adnotacje” znajdziesz więcej możliwości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer marcar seu histórico de rolagem? Clique com o botão direito em uma seleção e escolha “Anotar seleção” para adicionar uma nota pessoal a ela. Use “Visualizar > Mostrar anotações” para mostrá-las ou ocultá-las e veja em “Editar > Marcas e anotações” mais coisas que você pode fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите делать пометки в истории прокрутки? Щёлкните правой кнопкой мыши по выделению и выберите «Аннотировать выделение», чтобы добавить к нему личную заметку. Используйте «Вид > Показать аннотации», чтобы показать или скрыть их, а в «Правка > Метки и аннотации» вы найдёте другие возможности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete si označiť históriu rolovania? Kliknite pravým tlačidlom na výber a zvoľte „Anotovať výber“, čím k nemu pridáte osobnú poznámku. Anotácie zobrazíte alebo skryjete cez menu „Zobraziť > Zobraziť anotácie“ a ďalšie možnosti nájdete v menu „Upraviť > Značky a anotácie“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želite označiti zgodovino pomikanja? Z desnim klikom na izbor izberite »Dodaj opombo izboru«, da mu dodate osebno opombo. Z »Prikaz > Prikaži opombe« jih prikažete ali skrijete, v »Uredi > Označbe in opombe« pa najdete še več možnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du göra anteckningar i rullningshistoriken? Högerklicka på en markering och välj ”Anteckna markering” för att lägga till en personlig anteckning. Använd ”Innehåll > Visa anteckningar” för att visa eller gömma dem, och titta i ”Redigera > Märken och anteckningar” för fler saker du kan göra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri kaydırma geçmişinizi işaretlemek mi istiyorsunuz? Bir seçime sağ tıklayıp kişisel bir not eklemek için “Seçime Ek Açıklama Ekle”yi seçin. Bunları göstermek veya gizlemek için “Görüntü > Ek Açıklamaları Göster”i kullanın; yapabileceğiniz diğer işlemler için “Düzen > İşaretler ve Ek Açıklamalar”a bakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muốn đánh dấu bộ đệm cuộn ngược của bạn? Bấm chuột phải vào vùng chọn và chọn “Chú thích vùng chọn” để thêm ghi chú cá nhân. Dùng “Xem > Hiển thị chú thích” để hiện hoặc ẩn chúng, và xem “Sửa > Dấu và chú thích” để biết thêm những việc bạn có thể làm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要标记滚动回退历史记录吗？右键点击选择项，然后选择“Annotate Selection”为它添加个人注释。使用“View > Show Annotations”可以显示或隐藏这些注释，更多操作可参考“Edit > Marks and Annotations”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想在捲動記錄上做標記嗎？在選取範圍上按一下右鍵，然後選擇「註解選取範圍」，即可為它加入個人備註。使用「顯示方式 > 顯示註解」可顯示或隱藏註解，也可以到「編輯 > 標記與註解」查看更多功能。"
          }
        }
      }
    },
