    "AdvancedSetting.asyncPreconvertMaxOutstandingBytes" : {
      "comment" : "Advanced setting: asyncPreconvertMaxOutstandingBytes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální počet bajtů nevyřízených asynchronních předkonverzí.\nPo dosažení tohoto limitu se nové řetězce převádějí synchronně ve vlákně mutací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt antal byte i udestående asynkrone forkonverteringer.\nNår denne grænse nås, konverteres nye strenge synkront på mutationstråden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Bytes für ausstehende asynchrone Vorkonvertierungen.\nWird dieses Limit erreicht, werden neue Zeichenfolgen synchron im Mutation-Thread konvertiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum bytes of outstanding async pre-conversions.\nWhen this limit is reached, new strings are converted synchronously on the mutation thread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de bytes de preconversiones asíncronas pendientes.\nCuando se alcanza este límite, las nuevas cadenas se convierten de forma síncrona en el hilo de mutación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odottavien asynkronisten esimuunnosten tavujen enimmäismäärä.\nKun raja saavutetaan, uudet merkkijonot muunnetaan synkronisesti mutaatiosäikeessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal d’octets de préconversions asynchrones en attente.\nLorsque cette limite est atteinte, les nouvelles chaînes sont converties de façon synchrone sur le thread de mutation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di byte di pre-conversioni asincrone in sospeso.\nQuando si raggiunge questo limite, le nuove stringhe vengono convertite in modo sincrono sul thread di mutazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非同期の事前変換で未処理のまま保持できる最大バイト数。\nこの上限に達すると、新しい文字列は mutation スレッド上で同期的に変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리 대기 중인 비동기 사전 변환의 최대 바이트 수.\n이 한도에 도달하면 새 문자열은 변경(mutation) 스레드에서 동기적으로 변환됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt antall byte i ventende asynkrone forhåndskonverteringer.\nNår denne grensen nås, konverteres nye strenger synkront på mutasjonstråden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaal aantal bytes aan openstaande asynchrone voorconversies.\nWanneer deze limiet is bereikt, worden nieuwe tekenreeksen synchroon omgezet op de mutatiethread."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna liczba bajtów oczekujących asynchronicznych wstępnych konwersji.\nPo osiągnięciu tego limitu nowe ciągi są konwertowane synchronicznie w wątku mutacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de bytes de pré-conversões assíncronas pendentes.\nQuando este limite é atingido, novas strings são convertidas de forma síncrona na thread de mutação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество байт незавершённых асинхронных преобразований.\nПри достижении этого предела новые строки преобразуются синхронно в потоке мутации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximálny počet bajtov nevybavených asynchrónnych predkonverzií.\nPo dosiahnutí tohto limitu sa nové reťazce konvertujú synchrónne vo vlákne mutácií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največje število bajtov neopravljenih asinhronih predpretvorb.\nKo je ta meja dosežena, se novi nizi pretvorijo sinhrono v niti za mutacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximalt antal byte i väntande asynkrona förkonverteringar.\nNär gränsen nås konverteras nya strängar synkront i mutationstråden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekleyen eşzamansız ön dönüştürmelerin en yüksek bayt sayısı.\nBu sınıra ulaşıldığında yeni dizeler mutasyon iş parçacığında eşzamanlı olarak dönüştürülür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số byte tối đa của các tiền chuyển đổi bất đồng bộ đang chờ.\nKhi đạt giới hạn này, các chuỗi mới được chuyển đổi đồng bộ trên luồng thay đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完成的异步预转换的最大字节数。\n当达到此限制时，新的字符串将在 mutation 线程上同步转换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未完成的非同步預先轉換的最大位元組數。\n達到此限制時，新字串會在變更執行緒上同步轉換。"
          }
        }
      }
    },
