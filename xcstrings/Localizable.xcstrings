            "value" : "Janela de atalho flutuante"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавающее окно горячих клавиш"
          }
        },
        "tr" : {
          "stringUnit" : {
