    "AdvancedSetting.paneTitleBarBackgroundColor" : {
      "comment" : "Advanced setting: paneTitleBarBackgroundColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastní barva pozadí záhlaví podoken. Ponechte prázdné pro výchozí barvu.\nMělo by to být barva ve stylu HTML, např. #aabbcc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brugerdefineret baggrundsfarve til titellinjer på ruder. Lad feltet være tomt for at bruge standardfarven.\nDet skal være en farve i HTML-stil, f.eks. #aabbcc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Hintergrundfarbe für Bereichstitelleisten. Leer lassen, um die Standardfarbe zu verwenden.\nDies sollte eine Farbe im HTML-Stil sein, zum Beispiel #aabbcc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom background color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color de fondo personalizado para las barras de título de los paneles. Déjalo vacío para usar el color predeterminado.\nDebe ser un color de estilo HTML, como #aabbcc."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paneelien otsikkopalkkien mukautettu taustaväri. Jätä tyhjäksi käyttääksesi oletusväriä.\nTämän tulee olla HTML-tyylinen väri, kuten #aabbcc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleur d’arrière-plan personnalisée pour les barres de titre des volets. Laissez vide pour utiliser la couleur par défaut.\nIl doit s’agir d’une couleur de style HTML, comme #aabbcc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore di sfondo personalizzato per le barre del titolo dei riquadri. Lascia vuoto per usare il colore predefinito.\nDeve essere un colore in stile HTML, come #aabbcc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペインのタイトルバーのカスタム背景色。デフォルトの色を使用するには空欄のままにしてください。\n#aabbccのようなHTML形式の色を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널 제목 막대의 사용자 지정 배경색. 기본 색상을 사용하려면 비워 두십시오.\nHTML 스타일 색상(예: #aabbcc)이어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egendefinert bakgrunnsfarge for rutenes tittellinjer. La stå tom for å bruke standardfargen.\nDette skal være en HTML-farge, som #aabbcc."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangepaste achtergrondkleur voor paneeltitelbalken. Laat leeg om de standaardkleur te gebruiken.\nDit moet een kleur in HTML-stijl zijn, zoals #aabbcc."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niestandardowy kolor tła pasków tytułu paneli. Pozostaw puste, aby użyć koloru domyślnego.\nPowinien to być kolor w stylu HTML, np. #aabbcc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de fundo personalizada para as barras de título dos painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский цвет фона для заголовков панелей. Оставьте пустым, чтобы использовать цвет по умолчанию.\nЦвет должен быть в HTML-формате, например #aabbcc."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastná farba pozadia líšt s názvom panelov. Ak ju chcete ponechať predvolenú, nechajte pole prázdne.\nMala by to byť farba v štýle HTML, napríklad #aabbcc."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barva ozadja naslovnih vrstic podoken po meri. Pustite prazno za uporabo privzete barve.\nTo mora biti barva v slogu HTML, na primer #aabbcc."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassad bakgrundsfärg för panelers titelfält. Lämna tomt för att använda förvald färg.\nDen ska vara en HTML-färg, som #aabbcc."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölme başlık çubukları için özel arka plan rengi. Varsayılan rengi kullanmak için boş bırakın.\nBu, #aabbcc gibi HTML tarzı bir renk olmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu nền tùy chỉnh cho thanh tiêu đề khung. Để trống để dùng màu mặc định.\nĐây nên là màu kiểu HTML, như #aabbcc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗格标题栏的自定义背景颜色。留空则使用默认颜色。\n应为 HTML 风格的颜色，如 #aabbcc。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗格標題列的自訂背景顏色。留空則使用預設顏色。\n應為 HTML 風格的顏色，例如 #aabbcc。"
          }
        }
      }
    },
