    "ProfilesAdvanced.TriggersHelpBrowser" : {
      "comment" : "Help text describing triggers in a browser session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger sind Aktionen, die Sie so konfigurieren, dass sie ausgeführt werden, wenn bestimmte URLs besucht werden oder Text auf einer Webseite gefunden wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers are actions you configure to run when certain URLs are visited or text on a web page is found."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーとは、特定のURLにアクセスしたときやWebページ上でテキストが見つかったときに実行するよう設定できるアクションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 특정 URL을 방문하거나 웹 페이지에서 특정 텍스트를 발견했을 때 실행되도록 구성하는 동작입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gatilhos são ações que você configura para executar quando certos URLs são visitados ou um texto é encontrado em uma página web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггеры представляют собой действия, которые запускаются при посещении определённых URL-адресов или при обнаружении текста на веб-странице."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器是你配置的操作，当访问特定 URL 或在网页上找到文本时运行。"
          }
        }
      }
    },
    "ProfilesAdvanced.TriggersHelpTerminal" : {
      "comment" : "Help text describing triggers in a terminal session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger überwachen eine Terminal-Sitzung auf Text, der einem regulären Ausdruck entspricht, und führen dann als Reaktion eine Aktion aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers watch for text matching a regular expression to arrive in a terminal session and then perform an action in response."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーは、正規表現に一致するテキストがターミナルセッションに届くのを監視し、それに応じてアクションを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 정규 표현식과 일치하는 텍스트가 터미널 세션에 도착하는지 감시하다가 그에 대한 응답으로 동작을 수행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gatilhos aguardam a chegada, em uma sessão de terminal, de um texto que corresponda a uma expressão regular e então executam uma ação em resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггеры отслеживают появление в сессии терминала текста, соответствующего регулярному выражению, и в ответ выполняют действие."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器监视与正则表达式匹配的文本到达终端会话，然后执行相应的操作。"
          }
        }
      }
    },
