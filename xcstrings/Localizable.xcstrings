    "Tip.0018.Body" : {
      "comment" : "Tip of the day body, id 0018",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stisknutím ⌥⌘B se v okně terminálu vrátíte v čase. Šipkami procházíte snímek po snímku. Podržením ⇧ a stisknutím šipek se pohybujete rychleji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på ⌥⌘B for at gå tilbage i tiden i et terminalvindue. Brug piletasterne til at gå billede for billede. Hold ⇧ nede, og tryk på piletasterne for at gå hurtigere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie ⌥⌘B, um in einem Terminalfenster in der Zeit zurückzugehen. Verwenden Sie die Pfeiltasten, um Bild für Bild vorzugehen. Halten Sie ⇧ gedrückt und drücken Sie die Pfeiltasten, um schneller voranzukommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press ⌥⌘B to step back in time in a terminal window. Use arrow keys to go frame by frame. Hold ⇧ and press arrow keys to go faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⌥⌘B para retroceder en el tiempo en una ventana de terminal. Usa las teclas de flecha para avanzar fotograma a fotograma. Mantén pulsada ⇧ y usa las teclas de flecha para ir más rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaa ajassa taaksepäin päätteen ikkunassa painamalla ⌥⌘B. Siirry ruutu kerrallaan nuolinäppäimillä. Pidä ⇧ painettuna ja paina nuolinäppäimiä edetäksesi nopeammin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⌥⌘B pour remonter dans le temps dans une fenêtre de terminal. Utilisez les touches fléchées pour avancer image par image. Maintenez ⇧ et appuyez sur les touches fléchées pour aller plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi ⌥⌘B per tornare indietro nel tempo in una finestra del terminale. Usa i tasti freccia per procedere fotogramma per fotogramma. Tieni premuto ⇧ e premi i tasti freccia per andare più veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘Bを押すと、ターミナルウィンドウの時間をさかのぼれます。矢印キーでフレームごとに移動できます。⇧を押しながら矢印キーを押すと、より速く移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 윈도우에서 시간을 거슬러 올라가려면 ⌥⌘B를 누르십시오. 화살표 키를 사용하여 프레임 단위로 이동할 수 있습니다. ⇧를 누른 채로 화살표 키를 누르면 더 빠르게 이동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på ⌥⌘B for å gå tilbake i tid i et terminalvindu. Bruk piltastene for å gå bilde for bilde. Hold nede ⇧ og trykk på piltastene for å gå raskere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op ⌥⌘B om in een terminalvenster terug in de tijd te gaan. Gebruik de pijltjestoetsen om beeld voor beeld te gaan. Houd ⇧ ingedrukt en druk op de pijltjestoetsen om sneller te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij ⌥⌘B, aby cofnąć się w czasie w oknie terminala. Strzałkami przechodzisz klatka po klatce. Przytrzymaj ⇧ i naciskaj strzałki, aby przewijać szybciej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⌥⌘B para voltar no tempo em uma janela de terminal. Use as teclas de seta para avançar quadro a quadro. Mantenha ⇧ pressionada e use as teclas de seta para ir mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⌥⌘B, чтобы вернуться назад во времени в окне терминала. Используйте клавиши со стрелками для перехода по кадрам. Удерживайте ⇧ и нажимайте стрелки, чтобы двигаться быстрее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačením ⌥⌘B sa v okne terminálu vrátite v čase. Šípkami sa posúvate po snímkoch. Podržte ⇧ a stlačte šípky pre rýchlejší posun."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisnite ⌥⌘B, da se v terminalskem oknu vrnete v preteklost. S puščičnimi tipkami se pomikate sličico za sličico. Držite ⇧ in pritiskajte puščične tipke za hitrejše pomikanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ⌥⌘B för att gå bakåt i tiden i ett terminalfönster. Använd piltangenterna för att gå bildruta för bildruta. Håll ned ⇧ och tryck på piltangenterna för att gå snabbare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir terminal penceresinde zamanda geri gitmek için ⌥⌘B’ye basın. Kare kare ilerlemek için ok tuşlarını kullanın. Daha hızlı gitmek için ⇧ tuşunu basılı tutup ok tuşlarına basın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn ⌥⌘B để quay ngược thời gian trong cửa sổ terminal. Dùng phím mũi tên để đi từng khung hình. Giữ ⇧ và nhấn phím mũi tên để đi nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按⌥⌘B可在终端窗口中倒带回到过去。使用箭头键逐帧移动。按住⇧并按箭头键可加快速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ⌥⌘B 可在終端機視窗中回到過去。使用方向鍵可逐影格移動，按住 ⇧ 再按方向鍵可加快速度。"
          }
        }
      }
    },
