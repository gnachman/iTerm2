    "Cockpit.NotifyTooltip" : {
      "comment" : "Tooltip for the notify button when it is not armed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornit, když se změní stav vybraného okna nebo vybrané relace."
          }
        },
        "da" : {
          "stringUnit" : {
