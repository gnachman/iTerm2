    "AdvancedSetting.focusNewSplitPaneWithFocusFollowsMouse" : {
      "comment" : "Advanced setting: focusNewSplitPaneWithFocusFollowsMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mají se při zapnuté volbě „Fokus následuje myš“ nová rozdělená podokna automaticky zaměřit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fokus følger mus er slået til, skal nye opdelte ruder så automatisk få fokus?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollen neue geteilte Bereiche automatisch fokussiert werden, wenn „Fokus folgt der Maus“ aktiviert ist?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When focus follows mouse is enabled, should new split panes automatically be focused?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando “El foco sigue al ratón” está activado, ¿deben recibir el foco automáticamente los nuevos paneles divididos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kohdistus seuraa hiirtä on käytössä, kohdistetaanko uudet jaetut paneelit automaattisesti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le focus suit la souris, les nouveaux volets scindés doivent-ils recevoir automatiquement le focus ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il focus segue il mouse è abilitato, i nuovi riquadri divisi devono ricevere automaticamente il focus?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスがマウスに追従する設定が有効な場合、新しい分割ペインに自動的にフォーカスしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포커스가 마우스를 따라가도록 설정된 경우 새로운 분할 패널에 자동으로 포커스를 맞춥니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fokus følger musen er aktivert, skal nye delte ruter fokuseres automatisk?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moeten nieuwe gesplitste panelen automatisch de focus krijgen wanneer ‘Focus volgt muis’ is ingeschakeld?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy fokus podąża za myszą, czy nowe podzielone panele mają automatycznie otrzymywać fokus?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o foco segue o mouse está ativado, novos painéis divididos devem ser focados automaticamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено «фокус следует за мышью», должны ли новые разделённые панели автоматически получать фокус?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté „Fokus nasleduje myš“, majú sa nové rozdelené panely automaticky zamerať?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je omogočeno, da fokus sledi miški, ali naj se nova razdeljena podokna samodejno fokusirajo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När fokus följer musen är aktiverat, ska nya delade paneler fokuseras automatiskt?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Odak fareyi izlesin” etkinken yeni bölmelere otomatik odaklanılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật tiêu điểm theo chuột, khung chia mới có nên tự động nhận tiêu điểm không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用“焦点跟随鼠标”功能时，新创建的分屏窗格是否应自动获得焦点？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「焦點跟隨滑鼠」時，新的分割窗格是否應自動取得焦點？"
          }
        }
      }
    },
    "AdvancedSetting.focusReportingEnabled" : {
      "comment" : "Advanced setting: focusReportingEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace mohou zapnout hlášení fokusu.\nHlášení fokusu způsobí, že iTerm2 odešle escape sekvenci, když relace získá nebo ztratí fokus. Může způsobit potíže, když relace ssh neočekávaně skončí, protože zůstane zapnuto, takže někteří uživatelé ho raději vypínají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps må slå fokusrapportering til.\nFokusrapportering får iTerm2 til at sende en escapesekvens, når en session får eller mister fokus. Det kan give problemer, når en ssh-session dør uventet, fordi den bliver stående som tændt, så nogle brugere foretrækker at slå det fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwendungen dürfen die Fokus-Berichterstattung aktivieren.\nDie Fokus-Berichterstattung veranlasst iTerm2, eine Escape-Sequenz zu senden, wenn eine Sitzung den Fokus erhält oder verliert. Sie kann Probleme verursachen, wenn eine SSH-Sitzung unerwartet endet, da sie dann aktiviert bleibt. Manche Benutzer deaktivieren sie deshalb lieber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps may turn on Focus Reporting.\nFocus reporting causes iTerm2 to send an escape sequence when a session gains or loses focus. It can cause problems when an ssh session dies unexpectedly because it gets left on, so some users prefer to disable it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps pueden activar el informe de foco.\nEl informe de foco hace que iTerm2 envíe una secuencia de escape cuando una sesión gana o pierde el foco. Puede causar problemas cuando una sesión ssh termina inesperadamente porque se queda activado, por lo que algunos usuarios prefieren desactivarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellukset voivat ottaa kohdistuksen raportoinnin käyttöön.\nKohdistuksen raportointi saa iTerm2:n lähettämään escape-sarjan, kun istunto saa tai menettää kohdistuksen. Se voi aiheuttaa ongelmia, kun ssh-istunto kuolee odottamatta, koska se jää päälle, joten jotkut käyttäjät haluavat poistaa sen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps peuvent activer le signalement du focus.\nLe signalement du focus fait envoyer une séquence d’échappement par iTerm2 quand une session gagne ou perd le focus. Il peut poser problème quand une session ssh meurt brutalement, car il reste activé ; certains utilisateurs préfèrent donc le désactiver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app possono attivare la segnalazione del focus.\nLa segnalazione del focus fa sì che iTerm2 invii una sequenza di escape quando una sessione ottiene o perde il focus. Può causare problemi quando una sessione ssh termina inaspettatamente perché resta attiva, quindi alcuni utenti preferiscono disabilitarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがフォーカスレポートをオンにできるようにします。\nフォーカスレポートが有効な場合、セッションがフォーカスを得たり失ったりしたときに iTerm2 はエスケープシーケンスを送信します。SSH セッションが予期せず切断された際にオンのままになってしまい問題を引き起こすことがあるため、これを無効にしたいユーザーもいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 포커스 리포팅을 켤 수 있습니다.\n포커스 리포팅을 사용하면 세션이 포커스를 얻거나 잃을 때 iTerm2가 이스케이프 시퀀스를 보냅니다. SSH 세션이 예기치 않게 종료되면 켜진 채로 남아 문제가 생길 수 있으므로 일부 사용자는 끄는 것을 선호합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apper kan slå på rapportering av fokus.\nRapportering av fokus får iTerm2 til å sende en escape-sekvens når en økt får eller mister fokus. Det kan skape problemer når en ssh-økt dør uventet fordi den blir stående på, så noen brukere foretrekker å deaktivere det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps mogen focusrapportage inschakelen.\nMet focusrapportage verstuurt iTerm2 een escapereeks wanneer een sessie de focus krijgt of verliest. Dit kan problemen veroorzaken wanneer een ssh-sessie onverwacht eindigt, omdat de rapportage dan aan blijft staan, dus sommige gebruikers schakelen het liever uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje mogą włączać raportowanie fokusu.\nRaportowanie fokusu powoduje, że iTerm2 wysyła sekwencję ucieczki, gdy sesja zyskuje lub traci fokus. Może powodować problemy, gdy sesja ssh nieoczekiwanie się kończy, bo pozostaje włączone, więc niektórzy użytkownicy wolą je wyłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps podem ativar o Relatório de foco.\nO relatório de foco faz o iTerm2 enviar uma sequência de escape quando uma sessão ganha ou perde o foco. Pode causar problemas quando uma sessão ssh morre inesperadamente porque fica ativado, então alguns usuários preferem desativá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения могут включать отчёт о фокусе.\nОтчёт о фокусе заставляет iTerm2 отправлять управляющую последовательность при получении или потере фокуса сессией. Это может вызывать проблемы, когда сессия ssh неожиданно завершается, а функция остаётся включённой, поэтому некоторые пользователи предпочитают отключать её."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apky môžu zapnúť hlásenie fokusu.\nHlásenie fokusu spôsobí, že iTerm2 odošle escape sekvenciu, keď relácia získa alebo stratí fokus. Môže spôsobovať problémy, keď relácia ssh neočakávane zanikne, pretože zostane zapnuté, preto ho niektorí užívatelia radšej vypínajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacije lahko vklopijo poročanje fokusa.\nPoročanje fokusa povzroči, da iTerm2 pošlje ubežno zaporedje, ko seja pridobi ali izgubi fokus. Lahko povzroči težave, ko seja ssh nepričakovano umre, ker ostane vklopljeno, zato ga nekateri uporabniki raje onemogočijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appar får aktivera fokusrapportering.\nFokusrapportering gör att iTerm2 skickar en escapesekvens när en session får eller förlorar fokus. Det kan orsaka problem när en ssh-session dör oväntat eftersom den lämnas på, så vissa användare föredrar att avaktivera det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar Odak Raporlamayı açabilir.\nOdak raporlama, bir oturum odak kazandığında veya kaybettiğinde iTerm2’nin bir kaçış dizisi göndermesine neden olur. Açık kaldığı için bir ssh oturumu beklenmedik şekilde öldüğünde sorun çıkarabilir; bu nedenle bazı kullanıcılar devre dışı bırakmayı tercih eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng có thể bật Báo cáo tiêu điểm.\nBáo cáo tiêu điểm khiến iTerm2 gửi một chuỗi thoát khi một phiên nhận hoặc mất tiêu điểm. Nó có thể gây sự cố khi một phiên ssh chết bất ngờ vì tùy chọn bị để bật, nên một số người dùng thích tắt nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序可能会开启焦点报告功能。\n焦点报告功能会在会话获得或失去焦点时让iTerm2发送转义序列。当SSH会话意外终止而该功能仍处于开启状态时，可能会引发问题，因此有些用户更倾向于关闭它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 可以開啟焦點回報。\n焦點回報會讓 iTerm2 在工作階段取得或失去焦點時傳送跳脫序列。當 ssh 工作階段意外中斷時，它可能因為被留在開啟狀態而造成問題，所以有些使用者偏好停用。"
          }
        }
      }
    },
    "AdvancedSetting.fontChangeAffectsBroadcastingSessions" : {
      "comment" : "Advanced setting: fontChangeAffectsBroadcastingSessions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má zvětšení nebo zmenšení písma v relaci, která vysílá vstup, ovlivnit všechny relace, které vysílají vstup?\nPlatí pouze při změně velikosti písma pomocí „Zvětšit text“, „Nastavit normální velikost textu“ a „Zmenšit text“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal en ændring af skriftstørrelsen i en session, der udsender input, påvirke alle sessioner, der udsender input?\nDette gælder kun, når skriftstørrelsen ændres med Gør tekst større, Gør tekst normal størrelse og Gør tekst mindre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll das Vergrößern oder Verkleinern der Schrift in einer Sitzung, die Eingaben überträgt, alle Sitzungen betreffen, die Eingaben übertragen?\nDies gilt nur für die Änderung der Schriftgröße mit „Text vergrößern“, „Normale Textgröße“ und „Text verkleinern“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should growing or shrinking the font in a session that's broadcasting input affect all session that broadcast input?\nThis only applies to changing the font size with Make Text Bigger, Make Text Normal Size, and Make Text Smaller"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe agrandar o reducir el tipo de letra en una sesión que transmite entrada afectar a todas las sesiones que transmiten entrada?\nSolo se aplica al cambiar el tamaño del tipo de letra con Hacer el texto más grande, Tamaño de texto normal y Hacer el texto más pequeño"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikuttaako fontin suurentaminen tai pienentäminen syötettä monilähettävässä istunnossa kaikkiin syötettä monilähettäviin istuntoihin?\nTämä koskee vain fonttikoon muuttamista komennoilla Suurenna tekstiä, Tekstin normaalikoko ja Pienennä tekstiä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandir ou réduire la police d’une session qui diffuse la saisie doit-il affecter toutes les sessions qui diffusent la saisie ?\nCela ne concerne que la modification de la taille de police avec Agrandir le texte, Rétablir la taille normale du texte et Réduire le texte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandire o ridurre il font in una sessione che trasmette input deve influire su tutte le sessioni che trasmettono input?\nSi applica solo alla modifica della dimensione del font con Ingrandisci testo, Dimensione normale del testo e Riduci testo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力をブロードキャスト中のセッションでフォントを拡大・縮小したとき、入力をブロードキャストしているすべてのセッションに影響させますか?\nこれは、「テキストを大きくする」「テキストを標準サイズにする」「テキストを小さくする」でフォントサイズを変更する場合にのみ適用されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력을 브로드캐스트하는 세션에서 서체를 키우거나 줄이면 입력을 브로드캐스트하는 모든 세션에 적용하겠습니까?\n텍스트 크게, 텍스트 기본 크기, 텍스트 작게로 서체 크기를 변경할 때만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal det å forstørre eller forminske fonten i en økt som kringkaster inndata, påvirke alle økter som kringkaster inndata?\nDette gjelder bare når fontstørrelsen endres med «Gjør teksten større», «Normal tekststørrelse» og «Gjør teksten mindre»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet het vergroten of verkleinen van het lettertype in een sessie die invoer uitzendt, van invloed zijn op alle sessies die invoer uitzenden?\nDit geldt alleen voor het wijzigen van de lettergrootte met Maak tekst groter, Normale tekstgrootte en Maak tekst kleiner"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy powiększenie lub zmniejszenie czcionki w sesji rozgłaszającej wejście ma dotyczyć wszystkich sesji rozgłaszających wejście?\nDotyczy to tylko zmiany rozmiaru czcionki poleceniami Powiększ tekst, Normalny rozmiar tekstu i Zmniejsz tekst"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar ou diminuir a fonte em uma sessão que está transmitindo entrada deve afetar todas as sessões que transmitem entrada?\nIsto só se aplica a alterar o tamanho da fonte com Aumentar o texto, Tamanho normal do texto e Diminuir o texto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должно ли увеличение или уменьшение шрифта в сессии, транслирующей ввод, влиять на все сессии, транслирующие ввод?\nЭто применяется только при изменении размера шрифта командами «Увеличить текст», «Обычный размер текста» и «Уменьшить текст»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má zväčšenie alebo zmenšenie písma v relácii, ktorá vysiela vstup, ovplyvniť všetky relácie, ktoré vysielajú vstup?\nPlatí iba pri zmene veľkosti písma cez Zväčšiť text, Normálna veľkosť textu a Zmenšiť text"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj povečanje ali pomanjšanje pisave v seji, ki oddaja vnos, vpliva na vse seje, ki oddajajo vnos?\nVelja samo za spreminjanje velikosti pisave z ukazi Povečaj besedilo, Normalna velikost besedila in Pomanjšaj besedilo"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ska en ökning eller minskning av typsnittet i en session som sänder indata påverka alla sessioner som sänder indata?\nDetta gäller bara när typsnittsstorleken ändras med Öka textstorleken, Normal textstorlek och Minska textstorleken"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girdi yayınlayan bir oturumda fontu büyütmek veya küçültmek, girdi yayınlayan tüm oturumları etkilesin mi?\nBu yalnızca Metni Büyüt, Metni Normal Boyut Yap ve Metni Küçült ile font boyutunu değiştirmek için geçerlidir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phóng to hoặc thu nhỏ phông chữ trong một phiên đang phát đầu vào có nên ảnh hưởng đến mọi phiên phát đầu vào không?\nChỉ áp dụng khi đổi cỡ phông chữ bằng “Phóng to văn bản”, “Đặt văn bản về cỡ bình thường” và “Thu nhỏ văn bản”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在正在传输输入的会话中调整字体大小，是否会影响所有也在传输输入的会话？\n此规则仅适用于通过“放大文本”、“恢复文本正常大小”和“缩小文本”来调整字体大小的情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在廣播輸入的工作階段中放大或縮小字體，是否應影響所有廣播輸入的工作階段？\n這只適用於使用「放大文字」、「恢復一般文字大小」和「縮小文字」變更字體大小的情況"
          }
        }
      }
    },
    "AdvancedSetting.fontsForGenerousRounding" : {
      "comment" : "Advanced setting: fontsForGenerousRounding",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam písem, u nichž se pro výpočet výšky řádku použije alternativní algoritmus zaokrouhlování.\nTo opravuje consolas a napodobuje chování Terminal.app v macOS 10.15. Je to seznam podřetězců názvů rodin písem oddělených čárkami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste over skrifter, der bruger en alternativ afrundingsalgoritme til beregning af linjehøjde.\nDet retter consolas og efterligner Terminal.apps adfærd i macOS 10.15. Det er en kommasepareret liste over delstrenge af skriftfamilier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste von Schriftarten, für die ein alternativer Rundungsalgorithmus zur Berechnung der Zeilenhöhe verwendet wird.\nDies behebt Probleme mit Consolas und ahmt das Verhalten von Terminal.app unter macOS 10.15 nach. Dies ist eine durch Kommas getrennte Liste von Teilzeichenfolgen für Schriftfamilien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List of fonts to use alternate rounding algorithm for line height calculation.\nThis fixes consolas and emulates Terminal.app’s behavior on macOS 10.15. This is a comma-delimited list of font family substrings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista de tipos de letra para los que usar un algoritmo de redondeo alternativo en el cálculo de la altura de línea.\nEsto corrige consolas y emula el comportamiento de Terminal.app en macOS 10.15. Es una lista de subcadenas de familias de tipos de letra separadas por comas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettelo fonteista, joille rivinkorkeuden laskennassa käytetään vaihtoehtoista pyöristysalgoritmia.\nTämä korjaa consolasin ja jäljittelee Terminal.appin toimintaa macOS 10.15:ssä. Pilkuin erotettu luettelo fonttiperheen osamerkkijonoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste de polices pour lesquelles utiliser un autre algorithme d’arrondi dans le calcul de la hauteur de ligne.\nCela corrige consolas et émule le comportement de Terminal.app sous macOS 10.15. Il s’agit d’une liste de sous-chaînes de familles de polices séparées par des virgules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenco di font per cui usare un algoritmo di arrotondamento alternativo nel calcolo dell’altezza delle righe.\nCorregge consolas ed emula il comportamento di Terminal.app su macOS 10.15. È un elenco separato da virgole di sottostringhe del nome della famiglia di font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行の高さの計算に別の丸めアルゴリズムを使用するフォントのリスト。\nこれにより Consolas の問題が修正され、macOS 10.15 での Terminal.app の動作をエミュレートします。フォントファミリー名の部分文字列をカンマ区切りで指定するリストです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄 높이 계산에 대체 반올림 알고리즘을 사용할 서체 목록입니다.\n이 옵션은 Consolas 문제를 해결하고 macOS 10.15에서 Terminal.app의 동작을 흉내 냅니다. 서체 패밀리 이름의 일부 문자열을 쉼표로 구분한 목록입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste over fonter som skal bruke en alternativ avrundingsalgoritme for beregning av linjehøyde.\nDette fikser consolas og etterligner oppførselen til Terminal.app i macOS 10.15. Dette er en kommaseparert liste over delstrenger av fontfamilier."
          }
