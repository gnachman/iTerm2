    "IT2HostGrants.Empty" : {
      "comment" : "Shown in place of the list when no remote hosts are always allowed to use the iTerm2 API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný vzdálený hostitel nemá trvalé povolení. Zvolte „Vždy povolit tomuto hostiteli“, když vzdálený hostitel požádá o ovládání iTerm2."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen eksterne værter er altid tilladt. Vælg Tillad altid denne vært, når en ekstern vært beder om at styre iTerm2."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind keine Remote-Hosts dauerhaft erlaubt. Wählen Sie „Diesen Host immer erlauben“, wenn ein Remote-Host anfragt, iTerm2 zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No remote hosts are always allowed. Choose Always Allow This Host when a remote host asks to control iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún host remoto tiene permiso permanente. Elige “Permitir siempre este host” cuando un host remoto pida controlar iTerm2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Millekään etäpalvelimelle ei ole myönnetty pysyvää lupaa. Valitse ”Salli aina tämä palvelin”, kun etäpalvelin pyytää iTerm2:n ohjausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun hôte distant n’est toujours autorisé. Choisissez Toujours autoriser cet hôte lorsqu’un hôte distant demande à contrôler iTerm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun host remoto è sempre consentito. Scegli “Consenti sempre questo host” quando un host remoto chiede di controllare iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に許可されているリモートホストはありません。リモートホストがiTerm2の制御を求めてきたときに「このホストを常に許可」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 허용된 원격 호스트가 없습니다. 원격 호스트가 iTerm2 제어를 요청할 때 “이 호스트를 항상 허용”을 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen eksterne verter er alltid tillatt. Velg «Tillat alltid denne verten» når en ekstern vert ber om å styre iTerm2."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn geen externe hosts die altijd zijn toegestaan. Kies ‘Sta deze host altijd toe’ wanneer een externe host vraagt om iTerm2 te besturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden zdalny host nie ma stałego pozwolenia. Wybierz „Zawsze pozwalaj temu hostowi”, gdy zdalny host poprosi o sterowanie iTerm2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum host remoto tem permissão permanente. Escolha “Sempre permitir este host” quando um host remoto pedir para controlar o iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет удалённых хостов, которым всегда разрешён доступ. Выберите «Всегда разрешать этому хосту», когда удалённый хост запросит управление iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadny vzdialený hostiteľ nie je trvalo povolený. Keď vzdialený hostiteľ požiada o ovládanie iTerm2, vyberte „Vždy povoliť tohto hostiteľa“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noben oddaljeni gostitelj nima stalnega dovoljenja. Izberite »Vedno dovoli tega gostitelja«, ko oddaljeni gostitelj zaprosi za nadzor nad aplikacijo iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga fjärrvärdar är alltid tillåtna. Välj ”Tillåt alltid den här värden” när en fjärrvärd ber om att få styra iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir uzak ana makineye kalıcı olarak izin verilmiyor. Bir uzak ana makine iTerm2’yi denetlemek istediğinde “Bu Ana Makineye Her Zaman İzin Ver” seçeneğini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có máy chủ từ xa nào được luôn cho phép. Hãy chọn “Luôn cho phép máy chủ này” khi một máy chủ từ xa yêu cầu điều khiển iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有始终允许的远程主机。当远程主机请求控制 iTerm2 时，请选择“始终允许此主机”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有一律允許的遠端主機。當遠端主機要求控制 iTerm2 時，請選擇「一律允許此主機」。"
          }
        }
      }
    },
    "IT2HostGrants.Explanation" : {
      "comment" : "Explanation at the top of the list of remote hosts always allowed to use the iTerm2 API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tito hostitelé mohou používat API iTerm2 přes integraci SSH, aniž by se předem ptali. Po odebrání hostitele se při jeho dalším připojení znovu zeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse værter kan bruge iTerm2 API via SSH-integration uden først at spørge. Hvis du fjerner en vært, spørger den igen, næste gang den opretter forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Hosts können die iTerm2-API über die SSH-Integration verwenden, ohne vorher zu fragen. Wenn Sie einen Host entfernen, fragt er bei der nächsten Verbindung wieder nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These hosts can use the iTerm2 API over SSH integration without asking first. Removing a host makes it ask again the next time it connects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos hosts pueden usar la API de iTerm2 mediante la integración con SSH sin preguntar antes. Si eliminas un host, volverá a preguntar la próxima vez que se conecte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä palvelimet voivat käyttää iTerm2:n APIa SSH-integraation kautta kysymättä ensin. Palvelimen poistaminen saa sen kysymään uudelleen seuraavalla yhteydenotolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces hôtes peuvent utiliser l’API d’iTerm2 via l’intégration SSH sans demander au préalable. La suppression d’un hôte lui fera redemander l’autorisation à sa prochaine connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi host possono usare l’API di iTerm2 tramite l’integrazione SSH senza chiedere prima. Rimuovendo un host, la volta successiva che si connette chiederà di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのホストは、確認なしでSSH統合経由のiTerm2 APIを使用できます。ホストを削除すると、次回接続時に再び確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트들은 묻지 않고 SSH 통합을 통해 iTerm2 API를 사용할 수 있습니다. 호스트를 제거하면 다음에 연결할 때 다시 묻습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse vertene kan bruke iTerm2-API-et via SSH-integrering uten å spørre først. Hvis du fjerner en vert, spør den igjen neste gang den kobler til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze hosts kunnen de iTerm2 API via SSH-integratie gebruiken zonder eerst te vragen. Als je een host verwijdert, vraagt die opnieuw de volgende keer dat er verbinding wordt gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te hosty mogą używać API iTerm2 przez integrację z SSH bez wcześniejszego pytania. Usunięcie hosta sprawi, że zapyta ponownie przy następnym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes hosts podem usar a API do iTerm2 pela integração de SSH sem perguntar antes. Ao remover um host, ele voltará a perguntar na próxima vez que se conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти хосты могут использовать API iTerm2 через интеграцию по SSH без предварительного запроса. Если убрать хост, он снова запросит разрешение при следующем подключении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Títo hostitelia môžu používať iTerm2 API cez integráciu SSH bez predchádzajúceho pýtania. Po odstránení hostiteľa sa opýta znova pri jeho ďalšom pripojení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti gostitelji lahko uporabljajo API iTerm2 prek integracije SSH, ne da bi prej vprašali. Če gostitelja odstranite, bo ob naslednji povezavi znova vprašal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här värdarna kan använda iTerm2-API:t via SSH-integrering utan att fråga först. Om du tar bort en värd frågar den igen nästa gång den ansluter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ana makineler, önce sormadan SSH Entegrasyonu üzerinden iTerm2 API’sini kullanabilir. Bir ana makineyi kaldırırsanız bir sonraki bağlanışında yeniden sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các máy chủ này có thể dùng iTerm2 API qua Tích hợp SSH mà không cần hỏi trước. Xóa một máy chủ sẽ khiến nó hỏi lại vào lần kết nối tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些主机无需事先询问即可通过 SSH 集成使用 iTerm2 API。移除某个主机后，它下次连接时会再次询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些主機可透過 SSH 整合使用 iTerm2 API，無須事先詢問。移除主機後，它下次連線時會再次詢問。"
          }
        }
      }
    },
