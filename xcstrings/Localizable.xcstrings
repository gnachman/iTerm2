    "Tip.0101.Body" : {
      "comment" : "Tip of the day body, id 0101",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se správcem hesel můžete používat LastPass nebo 1Password. Nastavíte je v nabídce vedle vyhledávacího pole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug LastPass eller 1Password med adgangskodeadministratoren ved at konfigurere det i menuen ved siden af søgefeltet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie LastPass oder 1Password mit dem Passwort-Manager, indem Sie ihn über das Menü neben dem Suchfeld konfigurieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Utilize LastPass or 1Password with the password manager by configuring it in the menu next to the search field."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa LastPass o 1Password con el gestor de contraseñas configurándolo en el menú junto al campo de búsqueda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä LastPassia tai 1Passwordia salasanojen hallinnan kanssa määrittämällä se hakukentän vieressä olevassa valikossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez LastPass ou 1Password avec le gestionnaire de mots de passe en le configurant dans le menu à côté du champ de recherche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa LastPass o 1Password con il gestore password configurandolo nel menu accanto al campo di ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドの横にあるメニューで設定すると、パスワードマネージャーでLastPassや1Passwordを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색 필드 옆의 메뉴에서 구성하면 암호 관리자에서 LastPass나 1Password를 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk LastPass eller 1Password med passordbehandleren ved å konfigurere det i menyen ved siden av søkefeltet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik LastPass of 1Password met de wachtwoordbeheerder door dit in te stellen in het menu naast het zoekveld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj LastPass lub 1Password z menedżerem haseł, konfigurując je w menu obok pola wyszukiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize o LastPass ou o 1Password com o cofre de senhas configurando-o no menu ao lado do campo de busca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте LastPass или 1Password вместе с менеджером паролей, настроив это в меню рядом с полем поиска."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používajte LastPass alebo 1Password so správcom hesiel ich nastavením v menu vedľa vyhľadávacieho poľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LastPass ali 1Password uporabite z upraviteljem gesel tako, da ga nastavite v meniju ob iskalnem polju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd LastPass eller 1Password med lösenordshanteraren genom att konfigurera det i menyn bredvid sökfältet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama alanının yanındaki menüden yapılandırarak parola yöneticisiyle LastPass veya 1Password kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng LastPass hoặc 1Password với trình quản lý mật khẩu bằng cách cấu hình trong menu cạnh trường tìm kiếm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过在搜索字段旁边的菜单中配置密码管理器 LastPass 或 1Password，即可使用该工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜尋欄位旁的選單中進行設定，即可將 LastPass 或 1Password 與密碼管理器搭配使用。"
          }
        }
      }
    },
