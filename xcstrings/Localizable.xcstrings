          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên có tên “%@” có vẻ không ở dấu nhắc mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
