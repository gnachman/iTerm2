    "StatusBarGit.TimeoutWarningTitleFormat" : {
      "comment" : "Warning shown when git times out; placeholders are the directory, the current timeout, and the proposed timeout",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausführung von Git in %1$@ wurde nicht innerhalb von %2$@ Sekunden abgeschlossen, daher kann die Statusleistenkomponente den Branch nicht anzeigen. Dies kommt häufig bei sehr großen Repositorys vor oder wenn sich der Arbeitsbaum auf einem langsamen Dateisystem befindet.\n\nMöchten Sie das Zeitlimit auf %3$@ Sekunden erhöhen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running git in %1$@ didn’t finish within %2$@ seconds, so the status bar component can’t show the branch. This often happens in very large repositories or when the working tree is on a slow filesystem.\n\nWould you like to increase the timeout to %3$@ seconds?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ で git を実行しましたが、%2$@ 秒以内に終了しなかったため、ステータスバーのコンポーネントはブランチを表示できません。これは非常に大きなリポジトリや、作業ツリーが低速なファイルシステム上にある場合によく発生します。\n\nタイムアウトを %3$@ 秒に増やしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 git 실행이 %2$@초 안에 끝나지 않아 상태 막대 구성 요소에 브랜치를 표시할 수 없습니다. 매우 큰 저장소이거나 작업 트리가 느린 파일 시스템에 있을 때 자주 발생합니다.\n\n시간 제한을 %3$@초로 늘리겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A execução do git em %1$@ não terminou em %2$@ segundos, então o componente da barra de status não pode mostrar o branch. Isto costuma acontecer em repositórios muito grandes ou quando a árvore de trabalho está em um sistema de arquivos lento.\n\nDeseja aumentar o tempo limite para %3$@ segundos?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнение git в %1$@ не завершилось за %2$@ секунд, поэтому компонент строки состояния не может показать ветку. Это часто случается в очень больших репозиториях или если рабочее дерево находится на медленной файловой системе.\n\nУвеличить время ожидания до %3$@ секунд?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@ 中运行 git 未在 %2$@ 秒内完成，因此状态栏组件无法显示分支。这种情况常见于非常大的仓库或工作树位于慢速文件系统中时。\n\n您希望将超时时间延长至 %3$@ 秒吗？"
          }
        }
      }
    },
