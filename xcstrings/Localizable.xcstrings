    "AdvancedSetting.pathsToIgnore" : {
      "comment" : "Advanced setting: pathsToIgnore",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesty ignorované sémantickou historií.\nOddělte cesty čárkou. Žádný soubor pod těmito cestami nepůjde otevřít pomocí sémantické historie. Je rozumné přidat do tohoto seznamu síťové souborové systémy, protože mohou být velmi pomalé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stier, der ignoreres af Semantisk historik.\nSeparer stier med et komma. Ingen arkiver under en af disse stier kan åbnes med Semantisk historik. Det er en god idé at føje netværksarkivsystemer til listen, da de kan være meget langsomme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Semantic History zu ignorierende Pfade.\nTrennen Sie die Pfade durch Kommas. Dateien unter einem dieser Pfade können nicht mit Semantic History geöffnet werden. Es ist ratsam, Netzwerkdateisysteme in diese Liste aufzunehmen, da sie sehr langsam sein können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paths to ignore for Semantic History.\nSeparate paths with a comma. Any file under one of these paths will not be openable with Semantic History. It is wise to add network file systems to this list, since they can be very slow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutas que se ignoran en el historial semántico.\nSepara las rutas con una coma. Ningún archivo bajo una de estas rutas se podrá abrir con el historial semántico. Conviene añadir a esta lista los sistemas de archivos de red, ya que pueden ser muy lentos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semanttisessa historiassa ohitettavat polut.\nErota polut pilkulla. Mitään näiden polkujen alla olevaa tiedostoa ei voi avata semanttisella historialla. Verkkotiedostojärjestelmät kannattaa lisätä tähän luetteloon, koska ne voivat olla hyvin hitaita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chemins à ignorer pour l’historique sémantique.\nSéparez les chemins par une virgule. Aucun fichier situé sous l’un de ces chemins ne pourra être ouvert avec l’historique sémantique. Il est prudent d’y ajouter les systèmes de fichiers réseau, car ils peuvent être très lents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorsi da ignorare per la Cronologia semantica.\nSepara i percorsi con una virgola. Nessun file all’interno di questi percorsi potrà essere aperto con la Cronologia semantica. È consigliabile aggiungere a questo elenco i file system di rete, perché possono essere molto lenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantic Historyで無視するパス。\nパスはカンマで区切ってください。これらのパスの下にあるファイルはSemantic Historyで開けなくなります。ネットワークファイルシステムは非常に遅くなることがあるため、このリストに追加することをお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시맨틱 히스토리에서 무시할 경로.\n경로는 쉼표로 구분합니다. 이 경로 아래에 있는 파일은 시맨틱 히스토리로 열 수 없습니다. 네트워크 파일 시스템은 매우 느릴 수 있으므로 이 목록에 추가하는 것이 좋습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baner som ignoreres av semantisk historikk.\nSkill baner med komma. Ingen fil under en av disse banene kan åpnes med semantisk historikk. Det er lurt å legge til nettverksfilsystemer i denne listen, siden de kan være veldig trege."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paden die voor Semantische geschiedenis worden genegeerd.\nScheid paden met een komma. Bestanden onder een van deze paden kunnen niet met Semantische geschiedenis worden geopend. Het is verstandig netwerkbestandssystemen aan deze lijst toe te voegen, omdat ze erg traag kunnen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścieżki ignorowane przez Historię semantyczną.\nOddziel ścieżki przecinkami. Żaden plik w jednej z tych ścieżek nie będzie mógł zostać otwarty przez Historię semantyczną. Warto dodać do tej listy sieciowe systemy plików, ponieważ mogą być bardzo wolne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhos a ignorar no Semantic History.\nSepare os caminhos com uma vírgula. Qualquer arquivo sob um destes caminhos não poderá ser aberto com o Semantic History. É recomendável adicionar sistemas de arquivos em rede a esta lista, pois eles podem ser muito lentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пути, которые нужно игнорировать для функции «Семантическая история».\nРазделяйте пути запятыми. Любой файл в одном из этих путей нельзя будет открыть с помощью «Семантической истории». Рекомендуется добавить в этот список сетевые файловые системы, так как они могут быть очень медленными."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesty ignorované Sémantickou históriou.\nCesty oddeľte čiarkou. Žiadny súbor v týchto cestách nebude možné otvoriť pomocou Sémantickej histórie. Je rozumné pridať do tohto zoznamu sieťové súborové systémy, pretože môžu byť veľmi pomalé."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poti, ki jih Semantična zgodovina prezre.\nPoti ločite z vejico. Nobene datoteke pod eno od teh poti ne bo mogoče odpreti s Semantično zgodovino. Priporočljivo je dodati omrežne datotečne sisteme, ker so lahko zelo počasni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sökvägar som ignoreras av semantisk historik.\nSeparera sökvägar med kommatecken. Ingen fil under någon av dessa sökvägar kan öppnas med semantisk historik. Det är klokt att lägga till nätverksfilsystem i listan, eftersom de kan vara mycket långsamma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamsal Geçmiş için yok sayılacak yollar.\nYolları virgülle ayırın. Bu yolların altındaki hiçbir dosya Anlamsal Geçmiş ile açılamaz. Ağ dosya sistemleri çok yavaş olabileceğinden bunları bu listeye eklemek akıllıca olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các đường dẫn bỏ qua đối với Lịch sử ngữ nghĩa.\nPhân tách các đường dẫn bằng dấu phẩy. Mọi tệp nằm dưới một trong các đường dẫn này sẽ không mở được bằng Lịch sử ngữ nghĩa. Nên thêm các hệ thống tệp mạng vào danh sách này vì chúng có thể rất chậm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语义历史中忽略的路径。\n用逗号分隔路径。这些路径下的任何文件将无法使用语义历史打开，建议将网络文件系统加入此列表，因为它们可能非常慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語意歷史記錄要忽略的路徑。\n以逗號分隔路徑。這些路徑下的任何檔案都無法透過語意歷史記錄打開。建議將網路檔案系統加入此清單，因為它們可能非常慢。"
          }
        }
      }
    },
    "AdvancedSetting.performDictionaryLookupOnQuickLook" : {
      "comment" : "Advanced setting: performDictionaryLookupOnQuickLook",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhledávat ve slovníku při silném stisku.\nPokud je zde NO, silný stisk bude i nadále zobrazovat náhled akce sémantické historie; vypnout lze jen vyhledávání ve slovníku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udfør ordbogsopslag ved kraftigt tryk.\nHvis dette er NO, viser kraftigt tryk stadig et eksempel på handlingen fra Semantisk historik. Kun ordbogsopslag kan slås fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörterbuchnachschlagen bei Force Press durchführen.\nWenn dies auf NEIN gesetzt ist, zeigt Force Press weiterhin eine Vorschau der Semantic-History-Aktion; nur das Wörterbuchnachschlagen kann deaktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Perform dictionary lookups on force press.\nIf this is NO, force press will still preview the Semantic History action; only dictionary lookups can be disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realiza búsquedas en el diccionario con la pulsación fuerte.\nSi es NO, la pulsación fuerte seguirá mostrando una vista previa de la acción del historial semántico; solo se pueden desactivar las búsquedas en el diccionario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee sanakirjahakuja voimapainalluksella.\nJos tämä on NO, voimapainallus näyttää silti semanttisen historian toiminnon esikatselun; vain sanakirjahaut voi poistaa käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuer des recherches dans le dictionnaire lors d’un appui forcé.\nSi cette option est désactivée, un appui forcé affichera quand même l’aperçu de l’action de l’historique sémantique ; seules les recherches dans le dictionnaire peuvent être désactivées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui le ricerche nel dizionario con il clic forzato.\nSe è NO, il clic forzato mostrerà comunque l’anteprima dell’azione della Cronologia semantica; si possono disabilitare solo le ricerche nel dizionario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強めのプレス（Force Press）で辞書検索を実行する。\nこれが「いいえ」の場合でも、強めのプレスはSemantic Historyアクションのプレビューを表示します。無効にできるのは辞書検索のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강한 클릭 시 사전에서 찾아보기를 수행합니다.\n이 값이 NO이면 강한 클릭은 여전히 시맨틱 히스토리 동작을 미리 보여 주며, 사전 찾아보기만 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå opp i ordbok ved kraftig trykk.\nHvis dette er NO, vil kraftig trykk fortsatt vise forhåndsvisning av handlingen for semantisk historikk; bare ordboksoppslag kan deaktiveres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek woorden op in het woordenboek bij kracht-drukken.\nAls dit NEE is, toont kracht-drukken nog steeds een voorvertoning van de actie van Semantische geschiedenis; alleen het opzoeken in het woordenboek kan worden uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukuj w słowniku po mocnym naciśnięciu.\nJeśli ustawiono NIE, mocne naciśnięcie nadal będzie pokazywać podgląd akcji Historii semantycznej; wyłączyć można tylko wyszukiwanie w słowniku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realizar consultas de dicionário ao pressionar com força.\nSe for NÃO, o pressionar com força ainda mostrará a pré-visualização da ação do Semantic History; apenas as consultas de dicionário podem ser desativadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполнять поиск в словаре при сильном нажатии (force press).\nЕсли этот параметр выключен, при сильном нажатии всё равно будет показываться предпросмотр действия «Семантической истории»; отключается только поиск в словаре."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhľadávať v slovníku pri silnom stlačení.\nAk je to NO, silné stlačenie stále zobrazí náhľad akcie Sémantickej histórie; vypnúť sa dá iba vyhľadávanie v slovníku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išči v slovarju ob močnem pritisku.\nČe je NE, bo močan pritisk še vedno prikazal predogled dejanja Semantične zgodovine; onemogočiti je mogoče le iskanje v slovarju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå upp i ordbok vid kraftigt tryck.\nOm det här är NO förhandsvisar kraftigt tryck fortfarande åtgärden för semantisk historik; bara ordboksuppslag kan avaktiveras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güçlü basışta sözlük araması yap.\nBu NO ise güçlü basış yine de Anlamsal Geçmiş eyleminin önizlemesini gösterir; yalnızca sözlük aramaları devre dışı bırakılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra từ điển khi nhấn mạnh.\nNếu là NO, nhấn mạnh vẫn sẽ xem trước tác vụ Lịch sử ngữ nghĩa; chỉ có thể tắt tra từ điển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制按键时执行字典查找。\n如果为否，强制按键仍会预览语义历史操作；只能禁用字典查找。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在重壓時執行字典查詢。\n如果為否，重壓仍會預覽語意歷史記錄動作；只有字典查詢會被停用。"
          }
        }
      }
    },
    "AdvancedSetting.performSQLiteIntegrityCheck" : {
      "comment" : "Advanced setting: performSQLiteIntegrityCheck",
