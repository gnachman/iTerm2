            "value" : "iTerm2起動時に自動的にデバッグログを開始する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 실행될 때 자동으로 디버그 로깅을 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
