    "ClaudeCode.UninstallBody" : {
      "comment" : "Explanation of what uninstalling the Claude Code integration does; the interpolated value is the absolute path to settings.json",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies entfernt den Status-Hook von iTerm2 aus %@, die Claude-Code-Arbeitsgruppe aus Ihren Einstellungen und die Trigger zum Betreten/Verlassen der Arbeitsgruppe aus jedem Profil. Sie können die Integration jederzeit über das iTerm2-Menü erneut einrichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This removes iTerm2’s status hook from %@, the Claude Code workgroup from your settings, and the Enter/Exit Workgroup triggers from every profile. You can set up the integration again any time from the iTerm2 menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、%@からiTerm2のステータスフックが削除され、設定からClaude Codeワークグループが削除され、すべてのプロファイルからワークグループ参加/退出トリガーが削除されます。iTerm2メニューからいつでも連携を再設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 iTerm2의 상태 훅을, 설정에서 Claude Code 워크그룹을, 모든 프로파일에서 워크그룹 진입/종료 트리거를 제거합니다. iTerm2 메뉴에서 언제든지 통합을 다시 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove o hook de status do iTerm2 de %@, o workgroup do Claude Code dos seus ajustes e os gatilhos de entrar/sair do workgroup de todos os perfis. Você pode configurar a integração novamente a qualquer momento pelo menu iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит хук статуса iTerm2 из %@, рабочую группу Claude Code из ваших настроек и триггеры Enter/Exit Workgroup из всех профилей. Снова настроить интеграцию можно в любой момент через меню iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从 %@ 中移除 iTerm2 的状态钩子，从你的设置中移除 Claude Code 工作组，并从每个配置文件中移除“进入/退出工作组”触发器。你可以随时通过 iTerm2 菜单重新设置该集成。"
          }
        }
      }
    },
    "ClaudeCode.UninstallConnectedHost" : {
      "comment" : "Line of the uninstall confirmation for a host connected through SSH Integration, whose settings will be checked and cleaned up; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It also removes the hook from Claude Code’s settings on %@, if it’s there."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerdem wird der Hook aus den Einstellungen von Claude Code auf %@ entfernt, sofern er dort vorhanden ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "また、%@のClaude Codeの設定にフックがあれば、それも削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 Claude Code 설정에 훅이 있으면 그것도 제거합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também remove o hook dos ajustes do Claude Code em %@, se estiver lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также будет удалён хук из настроек Claude Code на %@, если он там есть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 %@ 上 Claude Code 的设置中有该钩子，也会将其移除。"
          }
        }
      }
    },
    "ClaudeCode.UninstallDisconnectedHosts" : {
      "comment" : "Line of the uninstall confirmation explaining that hosts not currently connected through SSH Integration are not changed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hosts that aren’t connected keep their hook. Connect to one with SSH Integration and uninstall again to remove it there."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts, die nicht verbunden sind, behalten ihren Hook. Verbinden Sie sich mit der SSH-Integration mit einem solchen Host und deinstallieren Sie erneut, um ihn dort zu entfernen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されていないホストのフックはそのまま残ります。SSH統合でそのホストに接続し、もう一度アンインストールすると、そこからも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되어 있지 않은 호스트의 훅은 그대로 남습니다. 해당 호스트에서 제거하려면 SSH 통합으로 연결한 후 다시 제거하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts que não estão conectados mantêm o hook. Conecte-se a um deles com a Integração SSH e desinstale novamente para removê-lo lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На неподключённых хостах хук останется. Чтобы удалить его там, подключитесь к хосту через интеграцию с SSH и снова выполните удаление."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接的主机会保留其钩子。要从某台主机上移除，请通过 SSH 集成连接到该主机，然后再次卸载。"
          }
        }
      }
    },
