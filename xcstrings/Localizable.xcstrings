    "Companion.SetupFailed.AIModelCannotAuthenticate" : {
      "comment" : "Error shown when the companion setup wizard installed its plugins but the AI model still cannot authenticate with the entered API key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plug-iny AI a doprovodný plug-in byly nainstalovány, ale model AI není nastaven tak, aby používal zadaný API klíč. Zkontrolujte poskytovatele a model AI v části „Nastavení > Obecné > AI“ a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-pluginet og ledsagerpluginet blev installeret, men AI-modellen er ikke konfigureret til at bruge den API-nøgle, du angav. Kontroller udbyderen og AI-modellen i Indstillinger > Generelt > AI, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI- und Begleit-Plugins wurden installiert, aber das KI-Modell ist nicht für die Verwendung des eingegebenen API-Schlüssels konfiguriert. Überprüfen Sie den Anbieter und das KI-Modell unter Einstellungen > Allgemein > KI und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI and companion plugins were installed, but the AI model is not configured to use the API key you entered. Check the provider and the AI model in Settings > General > AI, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los plugins de IA y complementario se instalaron, pero el modelo de IA no está configurado para usar la clave de API que introdujiste. Comprueba el proveedor y el modelo de IA en Ajustes > General > IA y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI- ja kumppaniliitännäiset asennettiin, mutta AI-mallia ei ole määritetty käyttämään antamaasi API-avainta. Tarkista palveluntarjoaja ja AI-malli kohdassa Asetukset > Yleiset > AI ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modules IA et compagnon ont été installés, mais le modèle d’IA n’est pas configuré pour utiliser la clé d’API que vous avez saisie. Vérifiez le fournisseur et le modèle d’IA dans Réglages > Général > IA, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I plug-in IA e associato sono stati installati, ma il modello IA non è configurato per usare la chiave API che hai inserito. Controlla il provider e il modello IA in Impostazioni > Generali > IA, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプラグインとコンパニオンプラグインはインストールされましたが、AIモデルが入力したAPIキーを使用するように設定されていません。設定 > 一般 > AIでプロバイダーとAIモデルを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 및 컴패니언 플러그인은 설치되었지만 AI 모델이 입력한 API 키를 사용하도록 구성되지 않았습니다. 설정 > 일반 > AI에서 제공업체와 AI 모델을 확인한 다음 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-tillegget og tillegget for følgeenheter ble installert, men KI-modellen er ikke konfigurert til å bruke API-nøkkelen du skrev inn. Kontroller leverandøren og KI-modellen i «Innstillinger > Generelt > KI», og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AI-plug-in en de begeleidende plug-in zijn geïnstalleerd, maar het AI-model is niet geconfigureerd om de API-sleutel te gebruiken die je hebt ingevoerd. Controleer de aanbieder en het AI-model in Instellingen > Algemeen > AI en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki AI i urządzenia towarzyszącego zostały zainstalowane, ale model AI nie jest skonfigurowany do używania wpisanego klucza API. Sprawdź dostawcę i model AI w: Ustawienia > Ogólne > AI, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os plugins de IA e do Companion foram instalados, mas o modelo de IA não está configurado para usar a chave de API que você digitou. Verifique o provedor e o modelo de IA em Ajustes > Geral > IA e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины ИИ и Компаньон установлены, но модель ИИ не настроена на использование введённого вами ключа API. Проверьте поставщика и модель ИИ в Настройки > Общие > ИИ, затем повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluginy AI a sprievodného zariadenia boli nainštalované, ale model AI nie je nastavený na použitie zadaného API kľúča. Skontrolujte poskytovateľa a model AI v časti „Nastavenia > Všeobecné > AI“ a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vtičnika AI in Companion sta nameščena, vendar model AI ni nastavljen za uporabo ključa API, ki ste ga vnesli. Preverite ponudnika in model AI v »Nastavitve > Splošno > AI« ter poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI- och följeslagarpluginerna installerades, men AI-modellen är inte konfigurerad att använda API-nyckeln du angav. Kontrollera leverantören och AI-modellen under Inställningar > Allmänt > AI och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ ve eşlik eden eklentiler yüklendi, ancak YZ modeli girdiğiniz API anahtarını kullanacak şekilde yapılandırılmamış. Ayarlar > Genel > YZ bölümünde sağlayıcıyı ve YZ modelini denetleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các trình cắm AI và đồng hành đã được cài đặt, nhưng mô hình AI chưa được cấu hình để dùng khóa API bạn đã nhập. Hãy kiểm tra nhà cung cấp và mô hình AI trong Cài đặt > Chung > AI, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 插件和 Companion 插件已安装，但 AI 模型未配置为使用您输入的 API 密钥。请在“设置 > 通用 > AI”中检查提供商和 AI 模型，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 與搭配外掛程式已安裝，但 AI 模型未設定為使用你輸入的 API 金鑰。請在「設定 > 一般 > AI」中檢查供應商與 AI 模型，然後再試一次。"
          }
        }
      }
    },
    "Companion.SetupFailed.Suffix" : {
      "comment" : "Text appended after the error message in the setup-failed alert",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNastavení můžete dokončit v Nastavení doprovodného zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nDu kan gøre konfigurationen færdig i Indstillinger for ledsagerenhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nSie können die Einrichtung in den Begleitgerät-Einstellungen abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nYou can finish setting up in Companion Device Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nPuedes terminar la configuración en Ajustes del dispositivo complementario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nVoit viimeistellä asennuksen kumppanilaitteen asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nVous pouvez terminer la configuration dans les réglages de l’appareil compagnon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nPuoi terminare la configurazione in Impostazioni del dispositivo associato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n「コンパニオンデバイスの設定」からセットアップを完了できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n컴패니언 기기 설정에서 설정을 마칠 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nDu kan fullføre oppsettet i innstillingene for følgeenhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nJe kunt de installatie voltooien in de instellingen voor begeleidend apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nKonfigurację możesz dokończyć w ustawieniach urządzenia towarzyszącego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nVocê pode concluir a configuração nos Ajustes do Dispositivo Companheiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nВы можете завершить настройку в разделе «Настройки устройства-компаньона»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNastavenie môžete dokončiť v Nastaveniach sprievodného zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNastavitev lahko dokončate v Nastavitvah spremljevalne naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nDu kan slutföra konfigureringen i Inställningar för följeslagarenhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nKurulumu Eşlik Eden Aygıt Ayarları’nda tamamlayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nBạn có thể hoàn tất thiết lập trong Cài đặt thiết bị đồng hành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n你可以在配套设备设置中完成设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n你可以在搭配裝置設定中完成設定。"
          }
        }
      }
    },
