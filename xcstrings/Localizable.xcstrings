    "ChatViewController.OutputTruncatedNote" : {
      "comment" : "Note appended when command output was truncated",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Poznámka: Výstup příkazu byl zkrácen, protože překročil maximální počet řádků podporovaný chatem s AI*"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n*Bemærk: Kommandoens output blev afkortet, fordi det oversteg det maksimale antal linjer, som AI-chat understøtter*"
          }
        },
        "de" : {
          "stringUnit" : {
