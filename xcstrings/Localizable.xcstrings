    "AdvancedSetting.showSessionRestoredBanner" : {
      "comment" : "Advanced setting: showSessionRestoredBanner",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen einer Sitzung ohne einen laufenden Job ein Banner mit dem Text „Sitzungsinhalt wiederhergestellt“ unter dem wiederhergestellten Inhalt anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When restoring a session without restoring a running job, draw a banner saying “Session Contents Restored” below the restored contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restaurar una sesión sin restaurar un proceso en ejecución, dibuja un banner que dice “Contenido de la sesión restaurado” bajo el contenido restaurado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la restauration d’une session sans restaurer un processus en cours, dessiner une bannière « Contenu de la session restauré » sous le contenu restauré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si ripristina una sessione senza ripristinare un processo in esecuzione, disegna un banner con la scritta “Contenuto della sessione ripristinato” sotto il contenuto ripristinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のジョブを復元せずにセッションを復元する場合、復元された内容の下に「セッションの内容を復元しました」というバナーを表示する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 작업을 복원하지 않고 세션을 복원할 때, 복원된 내용 아래에 “세션 내용 복원됨” 배너를 그립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao restaurar uma sessão sem restaurar um processo em execução, desenhar um banner dizendo “Conteúdo da sessão restaurado” abaixo do conteúdo restaurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При восстановлении сеанса без восстановления работающей задачи показывать под восстановленным содержимым баннер с надписью «Содержимое сеанса восстановлено»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan bir işlem geri yüklenmeden oturum geri yüklenirken, geri yüklenen içeriğin altına “Oturum İçeriği Geri Yüklendi” yazan bir başlık çiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在恢复会话而不恢复正在运行的作业时，在恢复的内容下方显示“会话内容已恢复”的横幅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復工作階段但未回復執行中的工作時，在回復的內容下方繪製寫著「工作階段內容已回復」的橫幅。"
          }
        }
      }
    },
    "AdvancedSetting.showSuiteNameInDockIcon" : {
      "comment" : "Advanced setting: showSuiteNameInDockIcon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Suite-Namen beim Start mit -suite über dem Dock-Symbol einblenden.\nWenn Sie eine isolierte Instanz mit dem Argument -suite ausführen, wird ihr Name über das untere Drittel des Dock-Symbols gezeichnet, damit Sie die Instanzen unterscheiden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Overlay the suite name on the dock icon when launched with -suite.\nWhen you run an isolated instance with the -suite argument, its name is drawn across the lower third of the dock icon so you can tell instances apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superpone el nombre del suite en el icono del Dock cuando se inicia con -suite.\nAl ejecutar una instancia aislada con el argumento -suite, su nombre se dibuja en el tercio inferior del icono del Dock para distinguir las instancias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superposer le nom de la suite sur l’icône du Dock lorsque l’app est lancée avec -suite.\nLorsque vous exécutez une instance isolée avec l’argument -suite, son nom est dessiné sur le tiers inférieur de l’icône du Dock pour distinguer les instances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovrapponi il nome della suite all’icona nel Dock quando si avvia con -suite.\nQuando esegui un’istanza isolata con l’argomento -suite, il suo nome viene disegnato sul terzo inferiore dell’icona nel Dock per distinguere le istanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-suiteで起動したとき、Dockアイコンにスイート名を重ねて表示する。\n-suite引数で独立したインスタンスを実行すると、その名前がDockアイコンの下3分の1に描画され、インスタンスを区別できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-suite로 실행했을 때 Dock 아이콘에 스위트 이름 겹쳐 표시.\n-suite 인수로 격리된 인스턴스를 실행하면 Dock 아이콘의 아래쪽 3분의 1에 이름이 표시되어 인스턴스를 구별할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepor o nome do suite no ícone do dock ao iniciar com -suite.\nQuando você executa uma instância isolada com o argumento -suite, o nome dela é desenhado no terço inferior do ícone do dock para que você possa distinguir as instâncias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Накладывать имя набора (suite) на значок в Dock при запуске с параметром -suite.\nПри запуске изолированного экземпляра с аргументом -suite его имя отображается в нижней трети значка в Dock, чтобы можно было отличать экземпляры друг от друга."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-suite ile başlatıldığında suite adını Dock simgesinin üzerine bindir.\n-suite bağımsız değişkeniyle yalıtılmış bir örnek çalıştırdığınızda, örnekleri ayırt edebilmeniz için adı Dock simgesinin alt üçte birine çizilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 -suite 参数启动时，在窗口栏图标上显示套件名称。\n当使用 -suite 参数运行独立实例时，其名称会显示在窗口栏图标的下三分之一位置，以便区分不同实例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 -suite 啟動時，在 Dock 圖像上疊加 suite 名稱。\n當你以 -suite 引數執行獨立的實例時，其名稱會繪製在 Dock 圖像下方三分之一處，方便區分不同的實例。"
          }
        }
      }
    },
    "AdvancedSetting.showURLPreviewForSemanticHistory" : {
      "comment" : "Advanced setting: showURLPreviewForSemanticHistory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-Vorschau beim Bewegen der Maus bei gedrückter cmd-Taste über Treffer der Semantic History anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show URL preview on cmd-hover for semantic history matches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una vista previa de la URL al pasar el cursor con cmd sobre coincidencias del historial semántico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher l’aperçu de l’URL au survol avec ⌘ pour les correspondances de l’historique sémantique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l’anteprima dell’URL al passaggio con cmd sulle corrispondenze della Cronologia semantica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantic Historyの一致箇所にcmdキーでホバーした際、URLプレビューを表示する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시맨틱 히스토리 일치 항목 위에서 cmd를 누른 채 포인터를 올리면 URL 미리보기 표시."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar pré-visualização de URL ao passar o cursor com cmd para correspondências do Semantic History."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать предпросмотр URL-адреса при наведении с Cmd для совпадений «Семантической истории»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamsal geçmiş eşleşmeleri için cmd ile üzerine gelindiğinde URL önizlemesi göster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 cmd-hover 时显示 URL 预览，用于语义历史匹配。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於語意歷史記錄的符合項目，按住 Command 並移過時顯示 URL 預覽。"
          }
        }
      }
    },
    "AdvancedSetting.showWindowNameBesideTabs" : {
      "comment" : "Advanced setting: showWindowNameBesideTabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fensternamen neben den Tabs in den Themen „Kompakt“ und „Minimal“ anzeigen?\nDiese Themen haben keine Titelleiste, daher ist der Fenstername sonst nur sichtbar, wenn die Tab-Leiste ausgeblendet ist. „Wenn ein benutzerdefinierter Name festgelegt ist“ (Standard) zeigt ihn erst an, nachdem Sie das Fenster über Fenster > Fenstertitel bearbeiten benannt haben; unbenannte Fenster bleiben unverändert. „Immer“ zeigt zusätzlich den automatischen Titel an. Im Modus „Wenn ein benutzerdefinierter Name festgelegt ist“ wird der automatische Titel außerdem über einer linken Tab-Leiste angezeigt und über einer rechten, sobald dort die Fensternummer oder das Proxy-Symbol angezeigt wird, da er dort den Tabs keinen Platz wegnimmt. Dies hat keine Auswirkung in Themen mit Titelleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the window name beside the tabs in the Compact and Minimal themes?\nThose themes have no title bar, so the window name is otherwise only visible when the tab bar is hidden. “When a custom name is set” (the default) shows it only after you name the window with Window > Edit Window Title, leaving windows you have not named unchanged. “Always” also shows the automatic title. In “When a custom name is set” mode, the automatic title is also shown atop a left tab bar, and atop a right one whenever the window number or proxy icon is, since it takes no room from the tabs there. This has no effect in themes that have a title bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mostrar el nombre de la ventana junto a las pestañas en los temas Compacto y Minimalista?\nEsos temas no tienen barra de título, así que el nombre de la ventana solo es visible cuando la barra de pestañas está oculta. “Cuando se establece un nombre personalizado” (el valor predeterminado) lo muestra solo después de nombrar la ventana con Ventana > Editar título de la ventana, sin cambiar las ventanas a las que no has puesto nombre. “Siempre” también muestra el título automático. En el modo “Cuando se establece un nombre personalizado”, el título automático también se muestra sobre una barra de pestañas a la izquierda, y sobre una a la derecha siempre que se muestre el número de ventana o el icono de proxy, ya que ahí no quita espacio a las pestañas. No tiene efecto en temas con barra de título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le nom de la fenêtre à côté des onglets dans les thèmes Compact et Minimal ?\nCes thèmes n’ont pas de barre de titre, donc le nom de la fenêtre n’est sinon visible que lorsque la barre d’onglets est masquée. « Quand un nom personnalisé est défini » (par défaut) ne l’affiche qu’après avoir nommé la fenêtre avec Fenêtre > Modifier le titre de la fenêtre, sans changer les fenêtres que vous n’avez pas nommées. « Toujours » affiche aussi le titre automatique. En mode « Quand un nom personnalisé est défini », le titre automatique est aussi affiché au-dessus d’une barre d’onglets à gauche, et au-dessus d’une barre à droite chaque fois que le numéro de fenêtre ou l’icône de proxy l’est, car il ne prend alors pas de place aux onglets. Sans effet dans les thèmes ayant une barre de titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrare il nome della finestra accanto ai pannelli nei temi Compatto e Minimale?\nQuesti temi non hanno la barra del titolo, quindi altrimenti il nome della finestra è visibile solo quando la barra dei pannelli è nascosta. “Quando è impostato un nome personalizzato” (il valore predefinito) lo mostra solo dopo aver dato un nome alla finestra con Finestra > Modifica titolo finestra, lasciando invariate le finestre a cui non hai dato un nome. “Sempre” mostra anche il titolo automatico. Nella modalità “Quando è impostato un nome personalizzato”, il titolo automatico viene mostrato anche sopra una barra dei pannelli a sinistra, e sopra una a destra ogni volta che sono mostrati il numero della finestra o l’icona proxy, perché lì non sottrae spazio ai pannelli. Non ha effetto nei temi con barra del titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CompactテーマおよびMinimalテーマで、タブの横にウィンドウ名を表示するか？\nこれらのテーマにはタイトルバーがないため、通常タブバーが非表示のときにしかウィンドウ名は見えません。「カスタム名が設定されている場合」（デフォルト）は、Window > Edit Window Titleでウィンドウに名前を付けた後にのみ表示され、名前を付けていないウィンドウはそのままです。「常に」は自動タイトルも表示します。「カスタム名が設定されている場合」モードでは、自動タイトルは左側のタブバーの上部にも表示されます。右側のタブバーでも、ウィンドウ番号またはプロキシアイコンが表示されている場合は上部に表示されます。そこではタブの領域を使わないためです。タイトルバーがあるテーマには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴팩트 및 미니멀 테마에서 탭 옆에 윈도우 이름을 표시하겠습니까?\n이 테마들에는 제목 막대가 없으므로, 이 설정이 없으면 윈도우 이름은 탭 막대가 가려져 있을 때만 보입니다. “사용자 지정 이름이 설정된 경우”(기본값)는 윈도우 > 윈도우 제목 편집으로 윈도우 이름을 지정한 후에만 표시하며, 이름을 지정하지 않은 윈도우는 그대로 둡니다. “항상”은 자동 제목도 표시합니다. “사용자 지정 이름이 설정된 경우” 모드에서는 자동 제목이 왼쪽 탭 막대 위에도 표시되며, 오른쪽 탭 막대에서는 윈도우 번호나 프록시 아이콘이 표시될 때 그 위에 표시됩니다. 그곳에서는 탭의 공간을 차지하지 않기 때문입니다. 제목 막대가 있는 테마에서는 효과가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o nome da janela ao lado das abas nos temas Compact e Minimal?\nEsses temas não têm barra de título, então o nome da janela só fica visível quando a barra de abas está oculta. “Quando um nome personalizado é definido” (o padrão) o mostra apenas depois que você nomeia a janela em Janela > Editar título da janela, deixando inalteradas as janelas que você não nomeou. “Sempre” também mostra o título automático. No modo “Quando um nome personalizado é definido”, o título automático também é mostrado acima de uma barra de abas à esquerda, e acima de uma à direita sempre que o número da janela ou o ícone de proxy for mostrado, já que ali ele não ocupa espaço das abas. Isto não tem efeito em temas que têm barra de título."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать имя окна рядом с вкладками в темах Compact и Minimal?\nВ этих темах нет строки заголовка, поэтому иначе имя окна видно только тогда, когда панель вкладок скрыта. Значение «Если задано пользовательское имя» (по умолчанию) показывает его только после того, как вы назовёте окно через Window > Edit Window Title, не затрагивая окна, которым вы не давали имя. Значение «Всегда» также показывает автоматический заголовок. В режиме «Если задано пользовательское имя» автоматический заголовок также показывается над левой панелью вкладок, а над правой, когда там показывается номер окна или значок прокси, поскольку там он не занимает место вкладок. Это не действует в темах со строкой заголовка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompakt ve Minimal temalarda pencere adı sekmelerin yanında gösterilsin mi?\nBu temalarda başlık çubuğu yoktur; bu nedenle pencere adı aksi halde yalnızca sekme çubuğu gizliyken görünür. “Özel Ad Ayarlandığında” (varsayılan) seçeneği, adı yalnızca pencereyi Pencere > Pencere Başlığını Düzenle ile adlandırdıktan sonra gösterir ve adlandırmadığınız pencerelere dokunmaz. “Her Zaman” otomatik başlığı da gösterir. “Özel Ad Ayarlandığında” modunda otomatik başlık, sol sekme çubuğunun üstünde, sağ sekme çubuğunun üstünde ise pencere numarası veya vekil simgesi görünüyorsa gösterilir; çünkü orada sekmelerden yer almaz. Başlık çubuğu olan temalarda etkisi yoktur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在紧凑和极简主题中显示标签页旁边的窗口名称？\n这些主题没有标题栏，因此仅当隐藏标签页栏时才能看到窗口名称。“自定义名称设置时”（默认）仅在通过 Window > 编辑窗口标题为窗口命名后才会显示，未命名的窗口保持不变。“始终”也会显示自动标题。在“自定义名称设置时”模式下，自动标题也会显示在左侧标签页栏的顶部；当显示窗口编号或代理图标时，也会显示在右侧标签页栏的顶部，因为在那里它不会占用标签页的空间。对于带有标题栏的主题无影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 精簡和極簡主題中，於標籤頁旁顯示視窗名稱？\n這些主題沒有標題列，因此視窗名稱只有在標籤頁列隱藏時才看得到。「設定自訂名稱時」（預設）只會在你透過「視窗 > 編輯視窗標題」為視窗命名後才顯示，未命名的視窗維持不變。「一律」也會顯示自動標題。在「設定自訂名稱時」模式下，自動標題也會顯示在左側標籤頁列的上方；在右側標籤頁列上，只要顯示視窗編號或代理圖像，也會顯示在其上方，因為在那裡它不會佔用標籤頁的空間。這對有標題列的主題沒有作用。"
          }
        }
      }
    },
