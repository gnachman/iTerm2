    "Tip.0115.Body" : {
      "comment" : "Tip of the day body, id 0115",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocí ⌥-Enter zařaďte příkaz v editoru příkazů do fronty, aby se odeslal po dokončení aktuálního příkazu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt en kommando i kø i kommandoeditoren, så den sendes, når den aktuelle kommando er færdig, med ⌥-retur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihen Sie mit ⌥-Eingabe einen Befehl im Eingabefenster ein, der gesendet wird, sobald der aktuelle Befehl abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Queue up a command in the Composer to be sent after the current command finishes with ⌥-Enter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon en cola un comando en el compositor para que se envíe cuando termine el comando actual, con ⌥-Intro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jonota komento komentoeditorissa lähetettäväksi nykyisen komennon päätyttyä näppäimillä ⌥-rivinvaihto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez une commande en file d’attente dans le compositeur pour qu’elle soit envoyée à la fin de la commande en cours avec ⌥-retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in coda un comando nel Compositore da inviare al termine del comando corrente con ⌥-Invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥-Enterを使うと、現在のコマンドが終了した後に送信されるコマンドをコンポーザーにキューイングできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥-Enter로 현재 명령이 끝난 후에 보낼 명령을 컴포저에서 대기열에 추가할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett en kommando i kø i kommandoskriveren slik at den sendes når den gjeldende kommandoen er ferdig, med ⌥-retur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een commando in de wachtrij in de Opsteller zodat het wordt verstuurd nadat het huidige commando klaar is, met ⌥-Return."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw polecenie w kolejce w edytorze poleceń, aby zostało wysłane po zakończeniu bieżącego polecenia, skrótem ⌥-Enter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque um comando na fila no Compositor para ser enviado depois que o comando atual terminar, com ⌥-Enter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте команду в очередь в Composer, чтобы она была отправлена после завершения текущей команды, с помощью ⌥-Enter."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocou ⌥-Enter zaraďte príkaz v editore príkazov do fronty, aby sa odoslal po dokončení aktuálneho príkazu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukaz v urejevalniku ukazov postavite v čakalno vrsto, da se pošlje po koncu trenutnega ukaza, z ⌥-Enter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köa ett kommando i kommandoredigeraren som skickas när det aktuella kommandot är klart, med ⌥-retur."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucu’da bir komutu, geçerli komut bittikten sonra gönderilmek üzere ⌥-Enter ile sıraya alın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xếp hàng một lệnh trong Trình soạn lệnh để gửi sau khi lệnh hiện tại kết thúc bằng ⌥-Return."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥-Enter 可将 Composer 中的命令排队，在当前命令执行完成后发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥-Return 可將編寫器中的指令排入佇列，在目前的指令完成後傳送。"
          }
        }
      }
    },
