        }
      }
    },
    "ProfilesAdvanced.TriggersHelpTerminal" : {
      "comment" : "Help text describing triggers in a terminal session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger überwachen eine Terminal-Sitzung auf Text, der einem regulären Ausdruck entspricht, und führen dann als Reaktion eine Aktion aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers watch for text matching a regular expression to arrive in a terminal session and then perform an action in response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los disparadores esperan a que llegue a una sesión de terminal un texto que coincida con una expresión regular y entonces realizan una acción en respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclencheurs surveillent l’arrivée dans une session de terminal d’un texte correspondant à une expression régulière, puis exécutent une action en réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli attivatori attendono che in una sessione del terminale arrivi un testo che corrisponde a un’espressione regolare e quindi eseguono un’azione in risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーは、正規表現に一致するテキストがターミナルセッションに届くのを監視し、それに応じてアクションを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 정규 표현식과 일치하는 텍스트가 터미널 세션에 도착하는지 감시하다가 그에 대한 응답으로 동작을 수행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gatilhos aguardam a chegada, em uma sessão de terminal, de um texto que corresponda a uma expressão regular e então executam uma ação em resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггеры отслеживают появление в сессии терминала текста, соответствующего регулярному выражению, и в ответ выполняют действие."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyiciler, bir terminal oturumuna düzenli ifadeyle eşleşen bir metnin gelmesini bekler ve buna karşılık bir eylem gerçekleştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器监视与正则表达式匹配的文本到达终端会话，然后执行相应的操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發器會監看符合正規表示式的文字何時出現在終端機工作階段中，然後執行對應的動作。"
          }
        }
      }
    },
