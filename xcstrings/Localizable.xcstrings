    "LaunchExperience.PasteBehaviorChangeMessage" : {
      "comment" : "Message explaining that iTerm2 no longer warns before multi-line pastes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
