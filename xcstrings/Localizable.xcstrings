          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto attendere (in secondi) quando si tenta di collegarsi a un daemon di iTerm all’avvio durante il ripristino delle finestre?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にウィンドウを復元する際、iTermデーモンへの接続を試みる待機時間は何秒ですか？"
