    "PTYSession.StealFocusPrompt" : {
      "comment" : "Prompt asking whether to allow a control sequence to activate the session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řídicí sekvence se pokusila aktivovat relaci. Povolit to?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontrolsekvens forsøgte at aktivere en session. Vil du tillade det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Steuersequenz hat versucht, eine Sitzung zu aktivieren. Erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A control sequence attempted to activate a session. Allow it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una secuencia de control intentó activar una sesión. ¿Permitirlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjaussarja yritti aktivoida istunnon. Sallitaanko se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une séquence de contrôle a tenté d’activer une session. L’autoriser ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sequenza di controllo ha tentato di attivare una sessione. Vuoi consentirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制御シーケンスがセッションをアクティブにしようとしました。許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 시퀀스가 세션을 활성화하려고 했습니다. 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
