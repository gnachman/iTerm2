    "Tip.0109.Body" : {
      "comment" : "Tip of the day body, id 0109",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessern Sie Ihre Bearbeitung im Composer mit mehreren Cursor, die Sie mit ^⇧-nach oben/unten oder ⌥-Ziehen erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enhance your editing in the Composer with multiple cursors, created using ^⇧-up/down or ⌥-drag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧上/下または⌥ドラッグで作成できる複数カーソルを使うと、コンポーザーでの編集がさらに快適になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⇧-위/아래 화살표 또는 ⌥-드래그로 만드는 다중 커서를 사용하여 컴포저에서 더 효율적으로 편집해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua edição no Compositor com múltiplos cursores, criados usando ^⇧-cima/baixo ou ⌥-arrastar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшите редактирование в Композере с помощью нескольких курсоров, создаваемых с помощью ^⇧-вверх/вниз или ⌥-перетаскивания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Composer 中，使用 ^⇧-上/下或 ⌥-拖拽功能添加多个光标，以改进编辑体验。"
          }
        }
      }
    },
