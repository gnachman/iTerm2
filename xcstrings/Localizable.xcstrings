    "AdvancedSetting.autodetectMouseReportingStuck" : {
      "comment" : "Advanced setting: autodetectMouseReportingStuck",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch erkennen, wenn die Maus-Berichterstattung hängen geblieben ist?\nDies überwacht, ob Teile von Steuersequenzen der Maus-Berichterstattung auf dem Bildschirm ausgegeben werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically detect when mouse reporting got stuck on?\nThis watches for parts of mouse reporting control sequences being printed to the screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Detectar automáticamente cuando el informe del ratón se ha quedado activado?\nEsto vigila si se imprimen en pantalla partes de las secuencias de control del informe del ratón"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecter automatiquement le blocage du signalement de la souris ?\nCela surveille l’affichage à l’écran de fragments de séquences de contrôle du signalement de la souris"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevare automaticamente quando la segnalazione del mouse resta bloccata attiva?\nControlla se parti delle sequenze di controllo della segnalazione del mouse vengono stampate sullo schermo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスレポートが有効のまま固まった状態を自動検出しますか?\nこれは、マウスレポート制御シーケンスの一部が画面に表示されていないかを監視します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅이 켜진 채로 멈춘 것을 자동으로 감지합니까?\n마우스 리포팅 제어 시퀀스의 일부가 화면에 출력되는지 감시합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar automaticamente quando o relatório de mouse ficou travado ativado?\nIsso observa partes de sequências de controle de relatório de mouse sendo impressas na tela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически определять, когда отчёт о мыши застрял во включённом состоянии?\nЭто отслеживает случаи, когда части управляющих последовательностей отчёта о мыши выводятся на экран"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare raporlamanın takılı kaldığı otomatik algılansın mı?\nBu, fare raporlama denetim dizilerinin parçalarının ekrana yazdırılmasını izler"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否自动检测鼠标报告卡在某一位置？\n此选项用于监视鼠标报告控制序列中的部分内容被打印到屏幕上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動偵測滑鼠回報卡住的情況？\n這會監看滑鼠回報控制序列的一部分是否被印到螢幕上。"
          }
        }
      }
    },
    "AdvancedSetting.autologAppends" : {
      "comment" : "Advanced setting: autologAppends",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Sitzungsprotokollierung hängt an vorhandene Dateien an.\nWenn auf „Nein“ gesetzt, wird die Datei stattdessen überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatic session logging appends to existing files.\nWhen set to No, the file will be overwritten instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro automático de sesiones se añade a los archivos existentes.\nSi se establece en No, el archivo se sobrescribirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La journalisation automatique des sessions ajoute à la fin des fichiers existants.\nSi cette option est désactivée, le fichier est écrasé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il log automatico delle sessioni aggiunge ai file esistenti.\nSe impostato su No, il file verrà invece sovrascritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動セッションログは既存のファイルに追記します。\n「いいえ」に設定すると、代わりにファイルが上書きされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 세션 로깅 시 기존 파일에 추가합니다.\n아니요로 설정하면 대신 파일을 덮어씁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro automático de sessão acrescenta a arquivos existentes.\nQuando definido como Não, o arquivo será substituído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматическое журналирование сессии дописывает данные в существующие файлы.\nЕсли выключено, файл будет перезаписан."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik oturum günlüğü mevcut dosyalara eklenir.\nHayır olarak ayarlanırsa dosyanın üzerine yazılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动会话日志追加到现有文件。\n若设置为“否”，则文件将被覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動工作階段記錄會附加到現有檔案。\n設為「否」時，則會覆寫檔案。"
          }
        }
      }
    },
