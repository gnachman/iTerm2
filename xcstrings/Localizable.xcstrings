    "Tip.0014.Body" : {
      "comment" : "Tip of the day body, id 0014",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkce „Sémantická historie“ umožňuje otevřít soubor nebo URL kliknutím se stisknutým ⌘."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktionen “Semantisk historik” lader dig ⌘-klikke på et arkiv eller en URL for at åbne det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Funktion „Semantischer Verlauf“ können Sie bei gedrückter ⌘-Taste auf eine Datei oder URL klicken, um sie zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “Semantic History” feature allows you to ⌘-click on a file or URL to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La función “Historial semántico” te permite hacer clic con ⌘ en un archivo o una URL para abrirlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Semanttinen historia” -ominaisuuden avulla voit avata tiedoston tai URL-osoitteen ⌘-klikkaamalla sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fonctionnalité « Historique sémantique » vous permet de cliquer avec ⌘ sur un fichier ou une URL pour l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La funzione “Cronologia semantica” ti permette di fare clic con ⌘ su un file o un URL per aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「セマンティックヒストリー」機能を使うと、ファイルやURLを⌘クリックして開くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“시맨틱 히스토리” 기능을 사용하면 파일이나 URL을 ⌘-클릭하여 열 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funksjonen «Semantisk historikk» lar deg ⌘-klikke på en fil eller URL for å åpne den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de functie ‘Semantische geschiedenis’ kun je met ⌘-klik een bestand of URL openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcja „Historia semantyczna” pozwala kliknąć plik lub URL z klawiszem ⌘, aby go otworzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso “Semantic History” permite clicar com ⌘ em um arquivo ou URL para abri-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция «Семантическая история» позволяет открыть файл или URL-адрес щелчком с ⌘."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcia „Sémantická história“ umožňuje otvoriť súbor alebo URL kliknutím so stlačeným ⌘."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcija »Semantična zgodovina« omogoča, da z ⌘-klikom na datoteko ali URL to odprete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med funktionen ”Semantisk historik” kan du kommando-klicka på en fil eller URL för att öppna den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Anlamsal Geçmiş” özelliği, bir dosyayı veya URL’yi açmak için ⌘ basılıyken tıklamanıza olanak tanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng “Lịch sử ngữ nghĩa” cho phép bạn bấm kèm ⌘ vào một tệp hoặc URL để mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“语义历史”功能允许您使用⌘-点击文件或URL来打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「語意歷史記錄」功能可讓你按住 ⌘ 並按一下檔案或 URL 來打開它。"
          }
        }
      }
    },
