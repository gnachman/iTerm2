    "AdvancedSetting.extraSpaceBeforeCompactTopTabBar" : {
      "comment" : "Advanced setting: extraSpaceBeforeCompactTopTabBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Množství místa navíc (v bodech) mezi tlačítky okna a vloženým řádkem panelů.\nProjeví se pouze u kompaktního a minimalistického motivu, když je řádek panelů viditelný a nachází se v horní části okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mængde ekstra plads (i punkter) mellem vinduesknapperne og den indlejrede fanelinje.\nDette træder kun i kraft for temaerne Kompakt og Minimal, når fanelinjen er synlig og placeret øverst i vinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzlicher Abstand (in Punkten) zwischen den Ampel-Schaltflächen und der eingebetteten Tableiste.\nDies wirkt sich nur auf die Designs „Kompakt“ und „Minimal“ aus, wenn die Tableiste sichtbar ist und sich oben im Fenster befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Amount of extra space (in points) between stoplight buttons and inline tab bar.\nThis only takes effect for the Compact and Minimal themes when the tab bar is visible and located at the top of the window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidad de espacio adicional (en puntos) entre los botones de semáforo y la barra de pestañas en línea.\nSolo surte efecto en los temas compacto y minimalista cuando la barra de pestañas es visible y está en la parte superior de la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisätilan määrä (pisteinä) ikkunapainikkeiden ja tekstin mukana kulkevan välilehtipalkin välillä.\nTämä vaikuttaa vain Kompakti- ja Minimaalinen-teemoihin, kun välilehtipalkki on näkyvissä ikkunan yläreunassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace supplémentaire (en points) entre les boutons de la fenêtre et la barre d’onglets intégrée.\nCela ne prend effet que pour les thèmes Compact et Minimal lorsque la barre d’onglets est visible et située en haut de la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantità di spazio extra (in punti) tra i pulsanti semaforo e la barra dei pannelli in linea.\nHa effetto solo per i temi Compatto e Minimale quando la barra dei pannelli è visibile e posizionata in alto nella finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信号機ボタンとインラインタブバーの間に追加する余白の量 (ポイント単位)。\nこれは、タブバーが表示されていてウィンドウの上部にある場合の、コンパクトテーマとミニマルテーマにのみ適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신호등 버튼과 인라인 탭 막대 사이의 추가 공간(포인트).\n탭 막대가 보이고 윈도우 상단에 있을 때 컴팩트 및 미니멀 테마에만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengde ekstra plass (i punkter) mellom vindusknappene og den innebygde fanelinjen.\nDette har bare effekt for temaene Kompakt og Minimal når fanelinjen er synlig og plassert øverst i vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveelheid extra ruimte (in punten) tussen de stoplichtknoppen en de inline tabbladbalk.\nDit werkt alleen voor de thema’s Compact en Minimaal wanneer de tabbladbalk zichtbaar is en bovenaan het venster staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilość dodatkowego miejsca (w punktach) między przyciskami okna a wbudowanym paskiem kart.\nDziała tylko w motywach Kompaktowy i Minimalny, gdy pasek kart jest widoczny i znajduje się u góry okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantidade de espaço extra (em pontos) entre os botões do semáforo e a barra de abas em linha.\nIsto só tem efeito para os temas Compact e Minimal quando a barra de abas está visível e localizada no topo da janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дополнительное расстояние (в пунктах) между кнопками управления окном и встроенной панелью вкладок.\nЭто действует только для тем Compact и Minimal, когда панель вкладок видна и расположена в верхней части окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Množstvo dodatočného miesta (v bodoch) medzi tlačidlami okna a vloženou lištou s tabmi.\nPrejaví sa iba pri témach Kompaktný a Minimalistický, keď je lišta s tabmi viditeľná a nachádza sa v hornej časti okna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Količina dodatnega prostora (v točkah) med gumbi okna in vrstico z zavihki v isti vrstici.\nVelja samo za temi Kompaktna in Minimalna, ko je vrstica z zavihki vidna in na vrhu okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mängd extra utrymme (i punkter) mellan fönsterknapparna och det infogade flikfältet.\nDetta gäller bara för temana Kompakt och Minimal när flikfältet är synligt och placerat överst i fönstret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere düğmeleri ile satır içi sekme çubuğu arasındaki ek boşluk miktarı (punto).\nBu yalnızca sekme çubuğu görünürken ve pencerenin üstündeyken Kompakt ve Minimal temalarda etkilidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng trống thêm (tính bằng điểm) giữa các nút cửa sổ và thanh tab nội tuyến.\nChỉ có hiệu lực với chủ đề Gọn và Tối giản khi thanh tab hiển thị và nằm ở đầu cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信号灯按钮与内联标签栏之间的额外间距（以点为单位）。\n仅当标签栏可见且位于窗口顶部时，此设置对紧凑主题和极简主题生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紅綠燈按鈕與內嵌標籤頁列之間的額外空間量（點）。\n此設定僅在標籤頁列可見且位於視窗頂端時，對精簡和極簡主題生效。"
          }
        }
      }
    },
    "AdvancedSetting.fakeBootSessionUUID" : {
      "comment" : "Advanced setting: fakeBootSessionUUID",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepsat identitu tohoto počítače používanou pro zjišťování localhostu podle machineID z OSC 7.\nPokud je neprázdné, aplikace se chová, jako by kern.bootsessionuuid vracelo tuto hodnotu. Umožňuje bez restartu otestovat, jak reaguje zjišťování localhostu podle identity počítače. Ovlivní hostitele nahlášené po změně; pro použití skutečné hodnoty ponechte prázdné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilsidesæt maskinens identitet, der bruges til OSC 7 machineID-registrering af localhost.\nNår feltet ikke er tomt, opfører appen sig, som om kern.bootsessionuuid returnerer denne værdi. Lader dig teste, hvordan registrering af localhost via maskinidentitet reagerer, uden at genstarte. Påvirker værter, der rapporteres, efter du har ændret den; lad feltet stå tomt for at bruge den rigtige værdi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die für die OSC-7-machineID-Localhost-Erkennung verwendete Identität dieses Computers überschreiben.\nWenn nicht leer, verhält sich die App so, als würde kern.bootsessionuuid diesen Wert zurückgeben. So können Sie testen, wie die Localhost-Erkennung per Maschinenidentität reagiert, ohne neu zu starten. Wirkt sich auf Hosts aus, die nach der Änderung gemeldet werden; leer lassen, um den echten Wert zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Override this machine’s identity used for OSC 7 machineID localhost detection.\nWhen non-empty, the app behaves as though kern.bootsessionuuid returns this value. Lets you test how machine-identity localhost detection reacts without rebooting. Affects hosts reported after you change it; leave empty to use the real value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anular la identidad de este equipo usada para la detección de localhost por machineID de OSC 7.\nSi no está vacío, la app se comporta como si kern.bootsessionuuid devolviera este valor. Permite probar cómo reacciona la detección de localhost por identidad de máquina sin reiniciar. Afecta a los hosts notificados después de cambiarlo; déjalo vacío para usar el valor real."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita tämän koneen identiteetti, jota käytetään OSC 7:n machineID-localhost-tunnistukseen.\nKun tämä ei ole tyhjä, sovellus toimii kuin kern.bootsessionuuid palauttaisi tämän arvon. Antaa testata, miten koneidentiteettiin perustuva localhost-tunnistus reagoi, ilman uudelleenkäynnistystä. Vaikuttaa muutoksen jälkeen raportoituihin palvelimiin; jätä tyhjäksi käyttääksesi oikeaa arvoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer l’identité de cette machine utilisée pour la détection de localhost par machineID OSC 7.\nSi non vide, l’app se comporte comme si kern.bootsessionuuid renvoyait cette valeur. Permet de tester la réaction de la détection de localhost par identité de machine sans redémarrer. Concerne les hôtes signalés après la modification ; laissez vide pour utiliser la vraie valeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci l’identità di questo computer usata per il rilevamento di localhost tramite machineID di OSC 7.\nSe non vuoto, l’app si comporta come se kern.bootsessionuuid restituisse questo valore. Ti permette di provare come reagisce il rilevamento di localhost basato sull’identità del computer senza riavviare. Influisce sugli host segnalati dopo la modifica; lascia vuoto per usare il valore reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7 の machineID による localhost 検出に使用するこのマシンの識別情報を上書きします。\n空でない場合、アプリは kern.bootsessionuuid がこの値を返すかのように動作します。再起動することなく、マシン識別による localhost 検出がどう反応するかをテストできます。変更後に報告されるホストに影響します。実際の値を使用するには空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7 machineID localhost 감지에 사용되는 이 기기의 식별 정보 덮어쓰기\n비어 있지 않으면 앱은 kern.bootsessionuuid가 이 값을 반환하는 것처럼 동작합니다. 재시작하지 않고도 기기 식별 기반 localhost 감지가 어떻게 반응하는지 테스트할 수 있습니다. 변경한 후에 보고되는 호스트에 적용되며, 실제 값을 사용하려면 비워 두십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overstyr maskinidentiteten som brukes til OSC 7 machineID-oppdagelse av localhost.\nNår den ikke er tom, oppfører appen seg som om kern.bootsessionuuid returnerer denne verdien. Lar deg teste hvordan oppdagelse av localhost via maskinidentitet reagerer uten å starte på nytt. Påvirker verter som rapporteres etter at du har endret den. La stå tomt for å bruke den virkelige verdien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overschrijf de identiteit van deze machine die wordt gebruikt voor de localhost-detectie via machineID van OSC 7.\nAls dit niet leeg is, gedraagt de app zich alsof kern.bootsessionuuid deze waarde teruggeeft. Hiermee test je hoe de localhost-detectie op basis van machine-identiteit reageert zonder te herstarten. Heeft invloed op hosts die worden gemeld nadat je dit hebt gewijzigd; laat leeg om de echte waarde te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastąp tożsamość tego komputera używaną do wykrywania localhost przez OSC 7 machineID.\nGdy niepuste, aplikacja zachowuje się tak, jakby kern.bootsessionuuid zwracało tę wartość. Pozwala testować, jak wykrywanie localhost na podstawie tożsamości komputera reaguje bez ponownego uruchamiania. Dotyczy hostów zgłoszonych po zmianie; pozostaw puste, aby użyć prawdziwej wartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir a identidade desta máquina usada para detecção de localhost por machineID do OSC 7.\nQuando não vazio, o app se comporta como se kern.bootsessionuuid retornasse este valor. Permite testar como a detecção de localhost por identidade de máquina reage sem reiniciar. Afeta hosts relatados depois que você o altera; deixe vazio para usar o valor real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переопределить идентичность этой машины, используемую для определения localhost по machineID OSC 7.\nЕсли не пусто, приложение ведёт себя так, будто kern.bootsessionuuid возвращает это значение. Позволяет проверить, как определение localhost по идентичности машины реагирует без перезагрузки. Влияет на хосты, сообщаемые после изменения; оставьте пустым, чтобы использовать настоящее значение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepísať identitu tohto počítača používanú na zisťovanie localhost pomocou machineID z OSC 7.\nAk nie je prázdne, apka sa správa, ako keby kern.bootsessionuuid vracal túto hodnotu. Umožňuje otestovať, ako zisťovanie localhost podľa identity počítača reaguje, bez reštartu. Ovplyvní hostiteľov hlásených po zmene; ponechajte prázdne pre skutočnú hodnotu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preglasi identiteto tega računalnika, uporabljeno za zaznavanje localhost prek OSC 7 machineID.\nČe ni prazno, se aplikacija obnaša, kot da kern.bootsessionuuid vrne to vrednost. Omogoča preizkus odziva zaznavanja localhost na podlagi identitete računalnika brez ponovnega zagona. Vpliva na gostitelje, sporočene po spremembi; pustite prazno za uporabo prave vrednosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åsidosätt maskinens identitet som används för att identifiera localhost via OSC 7 machineID.\nNär detta inte är tomt beter sig appen som om kern.bootsessionuuid returnerar det här värdet. Låter dig testa hur identifiering av localhost via maskinidentitet reagerar utan att starta om. Påverkar värdar som rapporteras efter att du ändrat det; lämna tomt för att använda det verkliga värdet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 7 machineID localhost algılaması için kullanılan bu makinenin kimliğini geçersiz kıl.\nBoş değilse uygulama, kern.bootsessionuuid bu değeri döndürüyormuş gibi davranır. Yeniden başlatmadan makine kimliğiyle localhost algılamasının nasıl tepki verdiğini test etmenizi sağlar. Değiştirdikten sonra bildirilen ana makineleri etkiler; gerçek değeri kullanmak için boş bırakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi đè danh tính của máy này dùng cho phát hiện localhost machineID theo OSC 7.\nKhi không để trống, ứng dụng hoạt động như thể kern.bootsessionuuid trả về giá trị này. Cho phép bạn kiểm thử phản ứng của việc phát hiện localhost theo danh tính máy mà không cần khởi động lại. Ảnh hưởng đến các máy chủ được báo cáo sau khi bạn thay đổi; để trống để dùng giá trị thật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖用于 OSC 7 machineID localhost 检测的本机身份。\n若填写了该值，应用程序将表现得好像 kern.bootsessionuuid 返回了这个值。这样无需重新启动，即可测试基于机器身份的 localhost 检测的反应。更改后会影响后续报告的主机；保持空白则使用真实值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆寫用於 OSC 7 machineID 本機偵測的這部電腦的身分。\n不為空時，App 的行為會如同 kern.bootsessionuuid 傳回此值。讓你不必重新開機就能測試機器身分本機偵測的反應。影響變更後回報的主機；留空則使用真實值。"
          }
        }
      }
    },
    "AdvancedSetting.fakeFullyQualifiedDomainName" : {
      "comment" : "Advanced setting: fakeFullyQualifiedDomainName",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přepsat místní název hostitele používaný pro zjišťování localhostu.\nPokud je neprázdné, aplikace se chová, jako by [NSHost fullyQualifiedDomainName] vracelo tuto hodnotu. Umožňuje otestovat, jak zjišťování localhostu reaguje na změnu názvu hostitele, aniž byste skutečně přejmenovali počítač. Ovlivní hostitele nahlášené po změně; pro použití skutečného názvu hostitele ponechte prázdné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilsidesæt det lokale værtsnavn, der bruges til registrering af localhost.\nNår feltet ikke er tomt, opfører appen sig, som om [NSHost fullyQualifiedDomainName] returnerer denne værdi. Lader dig teste, hvordan registrering af localhost reagerer på en ændring af værtsnavn, uden rent faktisk at omdøbe din computer. Påvirker værter, der rapporteres, efter du har ændret den; lad feltet stå tomt for at bruge det rigtige værtsnavn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokalen Hostnamen überschreiben, der für die Localhost-Erkennung verwendet wird.\nWenn nicht leer, verhält sich die App so, als würde [NSHost fullyQualifiedDomainName] diesen Wert zurückgeben. So können Sie testen, wie die Localhost-Erkennung auf eine Änderung des Hostnamens reagiert, ohne Ihren Computer tatsächlich umzubenennen. Wirkt sich auf Hosts aus, die nach der Änderung gemeldet werden; leer lassen, um den echten Hostnamen zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Override the local hostname used for localhost detection.\nWhen non-empty, the app behaves as though [NSHost fullyQualifiedDomainName] returns this value. Lets you test how localhost detection reacts to a hostname change without actually renaming your computer. Affects hosts reported after you change it; leave empty to use the real hostname."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anular el nombre de host local usado para la detección de localhost.\nSi no está vacío, la app se comporta como si [NSHost fullyQualifiedDomainName] devolviera este valor. Permite probar cómo reacciona la detección de localhost a un cambio de nombre de host sin renombrar realmente tu Mac. Afecta a los hosts notificados después de cambiarlo; déjalo vacío para usar el nombre de host real."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita paikallinen palvelinnimi, jota käytetään localhost-tunnistukseen.\nKun tämä ei ole tyhjä, sovellus toimii kuin [NSHost fullyQualifiedDomainName] palauttaisi tämän arvon. Antaa testata, miten localhost-tunnistus reagoi palvelinnimen muutokseen nimeämättä tietokonettasi oikeasti uudelleen. Vaikuttaa muutoksen jälkeen raportoituihin palvelimiin; jätä tyhjäksi käyttääksesi oikeaa palvelinnimeä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer le nom d’hôte local utilisé pour la détection de localhost.\nSi non vide, l’app se comporte comme si [NSHost fullyQualifiedDomainName] renvoyait cette valeur. Permet de tester la réaction de la détection de localhost à un changement de nom d’hôte sans renommer réellement votre ordinateur. Concerne les hôtes signalés après la modification ; laissez vide pour utiliser le vrai nom d’hôte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci il nome host locale usato per il rilevamento di localhost.\nSe non vuoto, l’app si comporta come se [NSHost fullyQualifiedDomainName] restituisse questo valore. Ti permette di provare come reagisce il rilevamento di localhost a un cambio di nome host senza rinominare davvero il computer. Influisce sugli host segnalati dopo la modifica; lascia vuoto per usare il nome host reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "localhost の検出に使用するローカルホスト名を上書きします。\n空でない場合、アプリは [NSHost fullyQualifiedDomainName] がこの値を返すかのように動作します。実際にコンピューターの名前を変更することなく、ホスト名の変更に対して localhost の検出がどう反応するかをテストできます。変更後に報告されるホストに影響します。実際のホスト名を使用するには空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "localhost 감지에 사용할 로컬 호스트 이름을 재정의합니다.\n비어 있지 않으면 앱은 [NSHost fullyQualifiedDomainName]이 이 값을 반환하는 것처럼 동작합니다. 실제로 컴퓨터 이름을 바꾸지 않고도 호스트 이름 변경에 localhost 감지가 어떻게 반응하는지 테스트할 수 있습니다. 변경 후 보고되는 호스트에 적용됩니다. 실제 호스트 이름을 사용하려면 비워 두십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overstyr det lokale vertsnavnet som brukes til oppdagelse av localhost.\nNår det ikke er tomt, oppfører appen seg som om [NSHost fullyQualifiedDomainName] returnerer denne verdien. Lar deg teste hvordan oppdagelse av localhost reagerer på en endring av vertsnavn uten å faktisk gi datamaskinen nytt navn. Påvirker verter som rapporteres etter at du har endret det. La stå tomt for å bruke det virkelige vertsnavnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overschrijf de lokale hostnaam die wordt gebruikt voor localhost-detectie.\nAls dit niet leeg is, gedraagt de app zich alsof [NSHost fullyQualifiedDomainName] deze waarde teruggeeft. Hiermee test je hoe de localhost-detectie reageert op een wijziging van de hostnaam zonder je computer daadwerkelijk te hernoemen. Heeft invloed op hosts die worden gemeld nadat je dit hebt gewijzigd; laat leeg om de echte hostnaam te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastąp lokalną nazwę hosta używaną do wykrywania localhost.\nGdy niepuste, aplikacja zachowuje się tak, jakby [NSHost fullyQualifiedDomainName] zwracało tę wartość. Pozwala testować, jak wykrywanie localhost reaguje na zmianę nazwy hosta bez faktycznej zmiany nazwy komputera. Dotyczy hostów zgłoszonych po zmianie; pozostaw puste, aby użyć prawdziwej nazwy hosta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir o nome de host local usado para detecção de localhost.\nQuando não vazio, o app se comporta como se [NSHost fullyQualifiedDomainName] retornasse este valor. Permite testar como a detecção de localhost reage a uma alteração de nome de host sem realmente renomear seu computador. Afeta hosts relatados depois que você o altera; deixe vazio para usar o nome de host real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переопределить локальное имя хоста, используемое для определения localhost.\nЕсли не пусто, приложение ведёт себя так, будто [NSHost fullyQualifiedDomainName] возвращает это значение. Позволяет проверить, как определение localhost реагирует на смену имени хоста, не переименовывая при этом сам компьютер. Влияет на хосты, сообщаемые после изменения; оставьте пустым, чтобы использовать настоящее имя хоста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepísať lokálny názov hostiteľa používaný na zisťovanie localhost.\nAk nie je prázdne, apka sa správa, ako keby [NSHost fullyQualifiedDomainName] vracal túto hodnotu. Umožňuje otestovať, ako zisťovanie localhost reaguje na zmenu názvu hostiteľa bez skutočného premenovania počítača. Ovplyvní hostiteľov hlásených po zmene; ponechajte prázdne pre skutočný názov hostiteľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preglasi lokalno ime gostitelja, uporabljeno za zaznavanje localhost.\nČe ni prazno, se aplikacija obnaša, kot da [NSHost fullyQualifiedDomainName] vrne to vrednost. Omogoča preizkus odziva zaznavanja localhost na spremembo imena gostitelja brez dejanskega preimenovanja računalnika. Vpliva na gostitelje, sporočene po spremembi; pustite prazno za uporabo pravega imena gostitelja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åsidosätt det lokala värdnamnet som används för att identifiera localhost.\nNär detta inte är tomt beter sig appen som om [NSHost fullyQualifiedDomainName] returnerar det här värdet. Låter dig testa hur identifiering av localhost reagerar på en ändring av värdnamnet utan att faktiskt byta namn på datorn. Påverkar värdar som rapporteras efter att du ändrat det; lämna tomt för att använda det verkliga värdnamnet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "localhost algılaması için kullanılan yerel ana makine adını geçersiz kıl.\nBoş değilse uygulama, [NSHost fullyQualifiedDomainName] bu değeri döndürüyormuş gibi davranır. Bilgisayarınızı gerçekten yeniden adlandırmadan localhost algılamasının ana makine adı değişikliğine nasıl tepki verdiğini test etmenizi sağlar. Değiştirdikten sonra bildirilen ana makineleri etkiler; gerçek ana makine adını kullanmak için boş bırakın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi đè tên máy chủ cục bộ dùng cho phát hiện localhost.\nKhi không để trống, ứng dụng hoạt động như thể [NSHost fullyQualifiedDomainName] trả về giá trị này. Cho phép bạn kiểm thử phản ứng của việc phát hiện localhost khi đổi tên máy chủ mà không thực sự đổi tên máy tính. Ảnh hưởng đến các máy chủ được báo cáo sau khi bạn thay đổi; để trống để dùng tên máy chủ thật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖用于检测localhost的本地主机名。\n若填写了该值，应用程序将表现得好像[NSHost fullyQualifiedDomainName]返回了这个值。这样无需实际重命名电脑，即可测试主机名变化对localhost检测的影响。更改后会影响后续报告的主机名；保持空白则使用真实主机名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆寫用於本機偵測的本機主機名稱。\n不為空時，App 的行為會如同 [NSHost fullyQualifiedDomainName] 傳回此值。讓你不必真的重新命名電腦，就能測試本機偵測對主機名稱變更的反應。影響變更後回報的主機；留空則使用真實的主機名稱。"
          }
        }
      }
    },
