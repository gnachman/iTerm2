      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale horizontale Distanz in Zellen für die sanfte Cursor-Gleitanimation.\nCursorbewegungen, die größer als dieser Wert sind, werden nicht animiert."
          }
        },
        "en" : {
          "stringUnit" : {
