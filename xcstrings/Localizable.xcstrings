    "TransferrableFile.CouldNotQuarantine" : {
      "comment" : "Warning shown when a downloaded file could not be quarantined or removed; %@ is the file path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei unter „%@“ konnte nicht unter Quarantäne gestellt oder gelöscht werden! Sie ist gefährlich und sollte entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file at “%@” could not be quarantined or deleted! It is dangerous and should be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido poner en cuarentena ni eliminar el archivo en “%@”. Es peligroso y debería eliminarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier à l’emplacement « %@ » n’a pas pu être mis en quarantaine ni supprimé ! Il est dangereux et doit être supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile mettere in quarantena o eliminare il file in “%@”. È pericoloso e andrebbe rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にあるファイルを隔離または削除できませんでした！このファイルは危険なため、削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 있는 파일을 격리하거나 삭제할 수 없습니다! 위험한 파일이므로 제거해야 합니다."
