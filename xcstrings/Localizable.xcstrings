    "AdvancedSetting.noSyncDoNotWarnBeforeMultilinePaste" : {
      "comment" : "Advanced setting: noSyncDoNotWarnBeforeMultilinePaste",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über mehrzeiliges Einfügen (oder eine einzelne Zeile, die mit einem Zeilenumbruch endet) unterdrücken.\nDies gilt unabhängig davon, ob Sie sich an der Shell-Eingabeaufforderung befinden, sofern zwei oder mehr Zeilen eingefügt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line pastes (or a single line ending in a newline).\nThis applies whether you are at the shell prompt or not, provided two or more lines are being pasted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数行の貼り付け（または改行で終わる1行）に関する警告を表示しない。\nこれはシェルプロンプトにいるかどうかに関わらず、2行以上が貼り付けられる場合に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 줄 붙여넣기(또는 줄바꿈으로 끝나는 한 줄)에 대한 경고를 표시하지 않습니다.\n두 줄 이상을 붙여넣는 경우 셸 프롬프트에 있는지 여부와 관계없이 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagens de várias linhas (ou de uma única linha que termina em quebra de linha).\nIsto se aplica esteja você no prompt do shell ou não, desde que duas ou mais linhas estejam sendo coladas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение о вставке многострочного текста (или одной строки, заканчивающейся переносом строки).\nЭто применяется независимо от того, находитесь ли вы в командной строке оболочки, если вставляется две и более строк."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制多行粘贴（或单行以换行结尾）的警告。\n无论是否处于shell提示符下，只要粘贴了两行或更多行，此规则均适用。"
          }
        }
      }
    },
    "AdvancedSetting.noSyncDoNotWarnBeforePastingOneLineEndingInNewlineAtShellPrompt" : {
      "comment" : "Advanced setting: noSyncDoNotWarnBeforePastingOneLineEndingInNewlineAtShellPrompt",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über das Einfügen einer einzelnen Zeile, die mit einem Zeilenumbruch endet, an der Shell-Eingabeaufforderung unterdrücken.\nDies erfordert, dass Shell Integration installiert ist."
