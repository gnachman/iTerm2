          "stringUnit" : {
            "state" : "translated",
            "value" : "在此模式下，即使你按一下的不是現有的檔案，任何按一下操作都會啟用語意歷史記錄。\n"
          }
        }
      }
    },
    "SemanticHistory.DetailExistingFileOnly" : {
      "comment" : "Detail text explaining semantic history activates only on existing file names",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto režimu se sémantická historie aktivuje, jen když kliknete na název existujícího souboru.\n"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I denne tilstand aktiveres semantisk historik kun, når du klikker på et eksisterende arkivnavn.\n"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Modus wird Semantic History nur aktiviert, wenn Sie auf einen vorhandenen Dateinamen klicken.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In this mode semantic history will only be activated when you click on an existing file name.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este modo, el historial semántico solo se activará cuando hagas clic en el nombre de un archivo existente.\n"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
