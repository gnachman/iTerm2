    "Tip.0024.Body" : {
      "comment" : "Tip of the day body, id 0024",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Shell-Integration können Sie mit ⇧⌘↑ und ⇧⌘↓ zwischen den Shell-Eingabeaufforderungen navigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Shell Integration feature lets you navigate among shell prompts with ⇧⌘↑ and ⇧⌘↓."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con el shell te permite navegar entre los prompts del shell con ⇧⌘↑ y ⇧⌘↓."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration du shell vous permet de naviguer entre les invites du shell avec ⇧⌘↑ et ⇧⌘↓."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione shell ti permette di spostarti tra i prompt della shell con ⇧⌘↑ e ⇧⌘↓."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合機能を使うと、⇧⌘↑と⇧⌘↓でシェルプロンプト間を移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합 기능을 사용하면 ⇧⌘↑ 및 ⇧⌘↓로 셸 프롬프트 사이를 탐색할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso Shell Integration permite navegar entre os prompts do shell com ⇧⌘↑ e ⇧⌘↓."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция «Интеграция с оболочкой» позволяет перемещаться между приглашениями оболочки с помощью ⇧⌘↑ и ⇧⌘↓."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu özelliği, kabuk istemleri arasında ⇧⌘↑ ve ⇧⌘↓ ile gezinmenizi sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell集成功能允许您使用 ⇧⌘↑ 和 ⇧⌘↓ 在shell提示符之间导航。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 整合功能可讓你使用 ⇧⌘↑ 和 ⇧⌘↓ 在 shell 提示符號之間瀏覽。"
          }
        }
      }
    },
