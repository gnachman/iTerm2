            "value" : "Sisällytä lokeihin aikaleimat paremman seurannan ja tapahtumien yhdistämisen vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluez des horodatages dans vos journaux pour un meilleur suivi et une meilleure corrélation des événements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includi i timestamp nei log per un migliore tracciamento e una migliore correlazione degli eventi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログにタイムスタンプを含めると、追跡やイベントの相関がわかりやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그에 타임스탬프를 포함하면 추적과 이벤트 상관관계 파악이 쉬워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta med tidsstempler i loggene dine for bedre sporing og sammenstilling av hendelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem tijdstempels op in je logs voor beter bijhouden en correleren van gebeurtenissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj znaczniki czasu do dzienników, aby lepiej śledzić zdarzenia i znajdować między nimi korelacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua marcações de tempo nos seus logs para melhor rastreamento e correlação de eventos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте отметки времени в журналы для лучшего отслеживания и сопоставления событий."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrňte do záznamov časové pečiatky pre lepšie sledovanie a koreláciu udalostí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V dnevnike vključite časovne žige za boljše sledenje in povezovanje dogodkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta med tidsstämplar i dina loggar för bättre spårning och korrelation av händelser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha iyi izleme ve olay ilişkilendirme için günlüklerinize zaman damgaları ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa dấu thời gian vào nhật ký để theo dõi tốt hơn và đối chiếu sự kiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日志中添加时间戳，以便更好地跟踪和关联事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在記錄中加入時間戳記，以便更妥善地追蹤並關聯事件。"
          }
        }
      }
    },
