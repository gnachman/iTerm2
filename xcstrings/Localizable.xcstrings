    "GeneralPrefs.AlwaysOpenAutoLaunch" : {
      "comment" : "Explains why opening a window at startup is disabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přítomnost skriptů spouštěných automaticky vypíná otevření okna při spuštění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instrukser, der startes automatisk, forhindrer, at der åbnes et vindue ved start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Vorhandensein von Autostart-Skripten deaktiviert das Öffnen eines Fensters beim Start."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The presence of auto-launch scripts disables opening a window at startup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presencia de scripts de inicio automático desactiva la apertura de una ventana al iniciar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattisesti käynnistyvät skriptit estävät ikkunan avaamisen käynnistyksen yhteydessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La présence de scripts de lancement automatique désactive l’ouverture d’une fenêtre au démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presenza di script a lancio automatico disattiva l’apertura di una finestra all’avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動起動スクリプトが存在するため、起動時にウインドウを開く設定は無効になっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 실행 스크립트가 있으면 시동 시 윈도우 열기가 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det finnes skript som starter automatisk, åpnes det ikke noe vindu ved oppstart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door de aanwezigheid van auto-launchscripts wordt er bij het opstarten geen venster geopend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecność skryptów uruchamianych automatycznie wyłącza otwieranie okna przy uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A presença de scripts de execução automática desativa a abertura de uma janela na inicialização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наличие скриптов автозапуска отключает открытие окна при запуске."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prítomnosť skriptov automatického spustenia vypína otváranie okna pri spustení."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaradi skriptov za samodejni zagon odpiranje okna ob zagonu ni na voljo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript som startas automatiskt gör att inget fönster öppnas vid start."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik başlatma betiklerinin bulunması, başlangıçta pencere açılmasını devre dışı bırakır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự hiện diện của các tập lệnh tự khởi chạy làm tắt việc mở cửa sổ khi khởi động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动启动脚本的存在会阻止启动时打开窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於存在自動啟動腳本，啟動時不會打開視窗。"
          }
        }
      }
    },
