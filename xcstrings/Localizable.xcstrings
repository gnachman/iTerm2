      }
    },
    "AdvancedSetting.screenshotMaxPixelHeight" : {
      "comment" : "Advanced setting: screenshotMaxPixelHeight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Pixelhöhe für eine einzelne Screenshot-Datei.\nScreenshots, die höher sind, werden auf mehrere Dateien aufgeteilt. Beeinflusst auch die maximale Gesamtpixelzahl (dieser Wert zum Quadrat / 5)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum pixel height for a single screenshot file.\nScreenshots taller than this will be split into multiple files. Also affects the maximum total pixels (this value squared / 5)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima en píxeles de un único archivo de captura de pantalla.\nLas capturas más altas se dividirán en varios archivos. También afecta al total máximo de píxeles (este valor al cuadrado / 5)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauteur maximale en pixels d’un fichier de capture d’écran.\nLes captures plus hautes seront scindées en plusieurs fichiers. Affecte aussi le nombre total maximal de pixels (cette valeur au carré / 5)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altezza massima in pixel di un singolo file di istantanea.\nLe istantanee più alte verranno divise in più file. Influisce anche sul totale massimo di pixel (questo valore al quadrato / 5)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショット1ファイルあたりの最大ピクセル高。\nこれより高いスクリーンショットは複数のファイルに分割されます。最大合計ピクセル数（この値の2乗を5で割った値）にも影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단일 스크린샷 파일의 최대 픽셀 높이.\n이보다 높은 스크린샷은 여러 파일로 분할됩니다. 최대 총 픽셀 수(이 값의 제곱 / 5)에도 영향을 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima em pixels para um único arquivo de captura de tela.\nCapturas de tela mais altas que isto serão divididas em múltiplos arquivos. Também afeta o total máximo de pixels (este valor ao quadrado / 5)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная высота в пикселях для одного файла скриншота.\nСкриншоты выше этого значения будут разделены на несколько файлов. Также влияет на максимальное общее число пикселей (это значение в квадрате, делённое на 5)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir ekran görüntüsü dosyası için azami piksel yüksekliği.\nBundan yüksek ekran görüntüleri birden çok dosyaya bölünür. Ayrıca azami toplam pikseli de etkiler (bu değerin karesi / 5)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单个截图文件的最大像素高度。  \n高于此高度的截图将拆分为多个文件。也影响最大总像素数（该值的平方除以5）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單一螢幕截圖檔案的最大像素高度。\n高度超過此值的螢幕截圖會被分割成多個檔案。這也會影響總像素數上限（此值的平方除以 5）。"
          }
        }
      }
    },
    "AdvancedSetting.screenshotSaveLocation" : {
      "comment" : "Advanced setting: screenshotSaveLocation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner, in den die Schaltfläche „Sichern“ im Screenshot-Fenster Dateien schreibt.\nLeer lassen, um auf dem Schreibtisch zu sichern. Die Schaltfläche „Sichern unter…“ ignoriert dies und fragt immer nach einem Speicherort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Folder where the “Save” button in the screenshot window writes files.\nLeave empty to save to the Desktop. The “Save As…” button ignores this and always prompts for a location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta donde escribe los archivos el botón “Guardar” de la ventana de captura de pantalla.\nDéjala vacía para guardar en el Escritorio. El botón “Guardar como…” la ignora y siempre pide una ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier où le bouton « Enregistrer » de la fenêtre de capture d’écran écrit les fichiers.\nLaissez vide pour enregistrer sur le bureau. Le bouton « Enregistrer sous… » l’ignore et demande toujours un emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella in cui il pulsante “Salva” della finestra dell’istantanea scrive i file.\nLascia vuoto per salvare sulla scrivania. Il pulsante “Salva come…” la ignora e chiede sempre una posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットウィンドウの「保存」ボタンがファイルを書き込むフォルダ。\n空欄の場合はデスクトップに保存されます。「名前を付けて保存…」ボタンはこの設定を無視し、常に保存場所を尋ねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷 윈도우의 “저장” 버튼이 파일을 저장하는 폴더\n비워 두면 데스크탑에 저장됩니다. “다른 이름으로 저장…” 버튼은 이 설정을 무시하고 항상 위치를 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta onde o botão “Salvar” na janela de captura de tela grava os arquivos.\nDeixe vazio para salvar na Mesa. O botão “Salvar como…” ignora isto e sempre solicita um local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, в которую кнопка «Сохранить» в окне скриншота записывает файлы.\nОставьте пустым, чтобы сохранять на рабочий стол. Кнопка «Сохранить как…» игнорирует этот параметр и всегда запрашивает расположение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran görüntüsü penceresindeki “Kaydet” düğmesinin dosyaları yazdığı klasör.\nMasaüstü’ne kaydetmek için boş bırakın. “Farklı Kaydet…” düğmesi bunu yok sayar ve her zaman konum sorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图窗口中“保存”按钮写入文件的文件夹。  \n留空则保存到桌面。“另存为…”按钮忽略此设置，始终会提示位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕截圖視窗中「儲存」按鈕寫入檔案的檔案夾。\n留空則儲存到桌面。「儲存為…」按鈕會忽略此設定，並一律詢問位置。"
          }
        }
      }
    },
