    "PasteView.KeystrokeToolTip" : {
      "comment" : "Tooltip for the button that sends keystrokes directly to the terminal during a paste",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt in das Terminal tippen (zum Beispiel, um eine Passwortabfrage zu beantworten), anstatt Ihre Tastatureingaben bis zum Ende des Einfügevorgangs in eine Warteschlange zu stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type directly to the terminal (for example to answer a password prompt) instead of queueing your keystrokes until the paste finishes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キー入力をペーストが終わるまでキューに入れる代わりに、ターミナルへ直接入力します（たとえばパスワードプロンプトに答える場合など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣기가 끝날 때까지 키 입력을 대기열에 두지 않고 터미널에 직접 입력합니다(예: 암호 프롬프트에 응답할 때)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite diretamente no terminal (por exemplo, para responder a um prompt de senha) em vez de enfileirar suas teclas até a colagem terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводить текст непосредственно в терминал (например, чтобы ответить на запрос пароля) вместо постановки нажатий клавиш в очередь до завершения вставки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接输入到终端（例如回答密码提示），而不是将按键排入队列直到粘贴完成。"
          }
        }
      }
    },
    "PasteView.QueuedHint" : {
      "comment" : "Hint shown while pasting explaining that keystrokes are queued",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Einfügens werden Tastatureingaben in eine Warteschlange gestellt. Klicken Sie auf die Tastatur, um die Warteschlange ein- oder auszuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Typing is queued while pasting. Click the keyboard to toggle queueing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペースト中はキー入力がキューに入れられます。キーボードをクリックするとキュー機能の有効/無効を切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣는 동안에는 입력이 대기열에 쌓입니다. 키보드를 클릭하면 대기열 사용을 켜거나 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A digitação é enfileirada durante a colagem. Clique no teclado para alternar o enfileiramento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время вставки ввод ставится в очередь. Нажмите на значок клавиатуры, чтобы включить или выключить очередь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴期间输入会排队。点按键盘图标可切换排队。"
          }
        }
      }
    },
