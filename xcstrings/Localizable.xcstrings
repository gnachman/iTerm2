    "TmuxController.NotUTF8Message" : {
      "comment" : "Error explaining that tmux must be run in UTF-8 mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux befindet sich nicht im UTF-8-Modus. Bitte übergeben Sie das Kommandozeilenargument -u an tmux oder ändern Sie Ihre Umgebungsvariable LANG so, dass sie mit „.UTF-8“ endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "tmux is not in UTF-8 mode. Please pass the -u command line argument to tmux or change your LANG environment variable to end with “.UTF-8”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux no está en modo UTF-8. Pasa el argumento de línea de comandos -u a tmux o cambia tu variable de entorno LANG para que termine en “.UTF-8”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux n’est pas en mode UTF-8. Passez l’argument de ligne de commande -u à tmux ou modifiez votre variable d’environnement LANG pour qu’elle se termine par « .UTF-8 »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux non è in modalità UTF-8. Passa a tmux l’argomento da riga di comando -u oppure modifica la variabile d’ambiente LANG in modo che termini con “.UTF-8”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxがUTF-8モードになっていません。tmuxに-uコマンドライン引数を渡すか、LANG環境変数の末尾を「.UTF-8」に変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux가 UTF-8 모드가 아닙니다. tmux에 -u 명령줄 인수를 전달하거나 LANG 환경 변수가 “.UTF-8”로 끝나도록 변경하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tmux não está no modo UTF-8. Passe o argumento de linha de comando -u para o tmux ou altere sua variável de ambiente LANG para terminar com “.UTF-8”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux работает не в режиме UTF-8. Передайте tmux аргумент командной строки -u или измените переменную окружения LANG так, чтобы она заканчивалась на «.UTF-8»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux UTF-8 modunda değil. Lütfen tmux’a -u komut satırı bağımsız değişkenini iletin veya LANG ortam değişkeninizi “.UTF-8” ile bitecek şekilde değiştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 未处于 UTF-8 模式。请向 tmux 传递 -u 命令行参数，或将你的 LANG 环境变量改为以“.UTF-8”结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 不在 UTF-8 模式。請將 -u 命令列引數傳給 tmux，或將 LANG 環境變數改為以「.UTF-8」結尾。"
          }
        }
      }
    },
