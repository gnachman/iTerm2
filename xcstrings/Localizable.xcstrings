      }
    },
    "AdvancedSetting.silentUserNotifications" : {
      "comment" : "Advanced setting: silentUserNotifications",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systembenachrichtigungen sollen stumm sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "System notifications should be silent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム通知を無音にする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
