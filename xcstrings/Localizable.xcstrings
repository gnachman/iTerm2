    "GeneralPrefs.PromptChatIconExplanation" : {
      "comment" : "Explanation of the ai.subject variable in the chat-icon prompt editor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Titel des Chats ersetzt diesen Wert, wenn mit der KI gesprochen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The chat’s title will replace it when speaking to the AI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El título del chat lo sustituirá al hablar con la IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titre du chat le remplacera lors de l’échange avec l’IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il titolo della chat lo sostituirà quando si parla con l’IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI との対話時に、チャットのタイトルがこれに置き換わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI와 대화할 때는 채팅 제목으로 대치됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O título do chat irá substituí-lo ao falar com a IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название чата заменит это значение при обращении к ИИ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ ile konuşurken bunun yerine sohbetin başlığı kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与AI对话时，聊天标题将替代此内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 AI 對話時，將以聊天標題取代此內容。"
          }
        }
      }
    },
    "GeneralPrefs.PromptEngageExplanation" : {
      "comment" : "Explanation of the ai.prompt variable in the AI prompt editor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die von Ihnen eingegebene Abfrage ersetzt diesen Wert, wenn mit der KI gesprochen wird. Zum Beispiel: „Schreibe einen Unix-Befehl für \\(ai.prompt).“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\(ai.prompt).”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La consulta que introduzcas lo sustituirá al hablar con la IA. Por ejemplo: “Escribe un comando de unix para \\(ai.prompt).”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête que vous saisissez le remplacera lors de l’échange avec l’IA. Par exemple : « Écrivez une commande unix pour \\(ai.prompt). »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta che inserisci lo sostituirà quando si parla con l’IA. Ad esempio: “Scrivi un comando unix per \\(ai.prompt).”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI との対話時に、入力したクエリがこれに置き換わります。例:「Write a unix command to \\(ai.prompt).」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI와 대화할 때 입력한 질의가 이 자리에 들어갑니다. 예: “\\(ai.prompt) 작업을 수행하는 unix 명령을 작성하십시오.”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consulta que você digitar irá substituí-lo ao falar com a IA. Por exemplo: “Escreva um comando unix para \\(ai.prompt).”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введенный вами запрос заменит это значение при обращении к ИИ. Например: «Напишите команду unix для \\(ai.prompt).»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ ile konuşurken bunun yerine girdiğiniz sorgu kullanılır. Örneğin: “Şunun için bir unix komutu yaz: \\(ai.prompt).”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入查询内容将替代此内容，例如：“为 \\(ai.prompt) 编写一条Unix命令。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與 AI 對話時，將以你輸入的查詢取代此內容。例如：「Write a unix command to \\(ai.prompt).」"
          }
        }
      }
    },
    "GeneralPrefs.PromptMustContain" : {
      "comment" : "Tooltip warning that a prompt is missing a required variable; first %@ is the variable, second is an explanation",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Prompt muss die Zeichenfolge %1$@ enthalten. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The prompt must contain the substring %1$@. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El prompt debe contener la subcadena %1$@. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prompt doit contenir la sous-chaîne %1$@. %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prompt deve contenere la sottostringa %1$@. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトには文字列 %1$@ を含める必要があります。%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트에 부분 문자열 %1$@이(가) 포함되어야 합니다. %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prompt deve conter a substring %1$@. %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос должен содержать подстроку %1$@. %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstem, şu alt dizeyi içermelidir: %1$@. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示词必须包含子字符串 %1$@. %2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示詞必須包含子字串 %1$@。%2$@"
          }
        }
      }
    },
