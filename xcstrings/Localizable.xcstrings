    "Profiles.Window.FolderNoImagesMessage" : {
      "comment" : "Warning body when a chosen background-image folder has no images. %@ is the folder name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složka „%@“ neobsahuje žádné obrázky, proto se nezobrazí žádný obrázek na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen “%@” indeholder ingen billeder, så der vises intet baggrundsbillede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „%@“ enthält keine Bilder, daher wird kein Hintergrundbild angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The folder “%@” contains no images, so no background image will be shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta “%@” no contiene imágenes, así que no se mostrará ninguna imagen de fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kansio ”%@” ei sisällä kuvia, joten taustakuvaa ei näytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier « %@ » ne contient aucune image, aucune image d’arrière-plan ne sera donc affichée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella “%@” non contiene immagini, quindi non verrà mostrata alcuna immagine di sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ「%@」には画像が含まれていないため、背景画像は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 폴더에 이미지가 없으므로 배경 이미지가 표시되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen «%@» inneholder ingen bilder, så ingen bakgrunnsbilder vises."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map ‘%@’ bevat geen afbeeldingen, dus er wordt geen achtergrondafbeelding getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder „%@” nie zawiera obrazów, więc obraz tła nie będzie wyświetlany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta “%@” não contém imagens, portanto nenhuma imagem de plano de fundo será exibida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка «%@» не содержит изображений, поэтому фоновое изображение не будет показано."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
