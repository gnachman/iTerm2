        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 활성화되면 벨 아이콘을 지웁니다.\n꺼져 있으면 세션에 입력해야 벨 아이콘이 지워집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar o ícone de campainha quando uma sessão se tornar ativa.\nQuando desativado, você deve digitar na sessão para limpar o ícone de campainha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирать значок колокольчика, когда сессия становится активной.\nЕсли выключено, для сброса значка колокольчика нужно набирать текст в сессии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话激活时清除角标图标\n关闭此选项后，需手动输入会话名称以清除角标图标。"
          }
        }
      }
    },
    "AdvancedSetting.clippingSeparator" : {
      "comment" : "Advanced setting: clippingSeparator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennzeichen, das beim Senden oder Kopieren mehrerer Ausschnitte zwischen ihnen eingefügt wird.\nDer Wert sollte die Vim-Syntax verwenden, zum Beispiel \\n für Zeilenumbruch und \\e für Escape."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Separator inserted between multiple clippings when sending or copying them.\nThe value should use Vim syntax, such as \\n for newline and \\e for escape."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のクリッピングを送信またはコピーする際に、それらの間に挿入するセパレーター。\n値は Vim の構文を使用してください。例えば改行には \\n、エスケープには \\e を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 클리핑을 보내거나 복사할 때 그 사이에 삽입되는 구분자.\n값에는 줄바꿈은 \\n, 이스케이프는 \\e처럼 Vim 구문을 사용해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separador inserido entre múltiplos recortes ao enviá-los ou copiá-los.\nO valor deve usar a sintaxe do Vim, como \\n para nova linha e \\e para escape."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разделитель, вставляемый между несколькими фрагментами при их отправке или копировании.\nЗначение должно использовать синтаксис Vim, например \\n для новой строки и \\e для escape."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送或复制多个剪裁内容时插入的分隔符\n值应使用Vim语法，例如\\n表示换行，\\e表示转义。"
          }
        }
      }
    },
