            "state" : "translated",
            "value" : "Bản xuất này bao gồm mật khẩu đã lưu. Hãy nhập cụm mật khẩu đã dùng để xuất chúng, hoặc hủy để nhập mọi thứ khác mà không có chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此导出包含已保存的密码。请输入导出时使用的口令，或取消以导入除密码之外的所有其他内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
