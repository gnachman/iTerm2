    "ProfilesColors.NoDeletablePresetsDetail" : {
      "comment" : "Detail text when there are no color presets that can be deleted",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vestavěné předvolby nelze smazat a nebyly importovány žádné vlastní předvolby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke slette de indbyggede forindstillinger, og der er ikke importeret nogen tilpassede forindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die integrierten Voreinstellungen können nicht gelöscht werden, und es wurden keine benutzerdefinierten Voreinstellungen importiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You cannot erase the built-in presets and no custom presets have been imported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes borrar los preajustes integrados y no se ha importado ningún preajuste personalizado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisäänrakennettuja esiasetuksia ei voi poistaa, eikä mukautettuja esiasetuksia ole tuotu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas supprimer les préréglages intégrés et aucun préréglage personnalisé n’a été importé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi cancellare le preimpostazioni integrate e non è stata importata alcuna preimpostazione personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みのプリセットは削除できません。また、カスタムプリセットも読み込まれていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 제공 사전 설정은 지울 수 없으며 가져온 사용자 지정 사전 설정이 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke slette de innebygde forhåndsinnstillingene, og ingen egendefinerte forhåndsinnstillinger er importert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de ingebouwde voorinstellingen niet wissen en er zijn geen aangepaste voorinstellingen geïmporteerd."
          }
