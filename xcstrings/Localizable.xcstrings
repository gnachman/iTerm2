    "Tip.0119.Body" : {
      "comment" : "Tip of the day body, id 0119",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časová razítka lze nyní zobrazit vedle obsahu terminálu místo překrývání. Nastavíte to v „Nastavení > Profily > Relace > Časová razítka“. Kliknutím pravým tlačítkem na libovolný řádek a výběrem „Nastavit základ pro relativní časová razítka“ zobrazíte čas uplynulý mezi řádky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsstempler kan nu vises ved siden af terminalindholdet i stedet for at overlappe det. Konfigurer det i “Indstillinger > Profiler > Session > Tidsstempler”. Højreklik på en vilkårlig linje, og vælg “Angiv referencepunkt for relative tidsstempler” for at se den tid, der er gået mellem linjer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitstempel können jetzt neben dem Terminalinhalt angezeigt werden, statt sich zu überlappen. Konfigurieren Sie dies unter „Einstellungen > Profile > Sitzung > Zeitstempel“. Klicken Sie mit der rechten Maustaste auf eine beliebige Zeile und wählen Sie „Basislinie für relative Zeitstempel festlegen“, um die verstrichene Zeit zwischen Zeilen zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timestamps can now be shown next to terminal content instead of overlapping. Configure it in “Settings > Profiles > Session > Timestamps”. Right-click on any line and select “Set Baseline for Relative Timestamps” to see time elapsed between lines."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora las marcas de tiempo pueden mostrarse junto al contenido de la terminal en lugar de superponerse. Configúralo en “Ajustes > Perfiles > Sesión > Marcas de tiempo”. Haz clic con el botón derecho en cualquier línea y selecciona “Definir referencia para marcas de tiempo relativas” para ver el tiempo transcurrido entre líneas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aikaleimat voi nyt näyttää päätteen sisällön vieressä päällekkäisyyden sijaan. Määritä se kohdassa ”Asetukset > Profiilit > Istunto > Aikaleimat”. Klikkaa mitä tahansa riviä oikealla painikkeella ja valitse ”Aseta suhteellisten aikaleimojen lähtökohta” nähdäksesi rivien välillä kuluneen ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les horodatages peuvent désormais s’afficher à côté du contenu du terminal au lieu de le recouvrir. Configurez-les dans « Réglages > Profils > Session > Horodatages ». Faites un clic droit sur une ligne et choisissez « Définir la base des horodatages relatifs » pour voir le temps écoulé entre les lignes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora i timestamp possono essere mostrati accanto al contenuto del terminale invece di sovrapporsi. Configurali in “Impostazioni > Profili > Sessione > Timestamp”. Fai clic con il tasto destro su una riga qualsiasi e seleziona “Imposta riferimento per timestamp relativi” per vedere il tempo trascorso tra le righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムスタンプをターミナルの内容に重ねずに、横に並べて表示できるようになりました。「設定 > プロファイル > セッション > タイムスタンプ」で設定してください。任意の行を右クリックし、「相対タイムスタンプの基準点を設定」を選択すると、行間の経過時間を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 타임스탬프를 터미널 내용 위에 겹치지 않고 옆에 표시할 수 있습니다. “설정 > 프로파일 > 세션 > 타임스탬프”에서 구성하십시오. 아무 줄이나 오른쪽 클릭하고 “상대 타임스탬프의 기준 설정”을 선택하면 줄 사이의 경과 시간을 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsstempler kan nå vises ved siden av terminalinnholdet i stedet for å overlappe. Konfigurer det i «Innstillinger > Profiler > Økt > Tidsstempler». Høyreklikk på en linje og velg «Angi referanse for relative tidsstempler» for å se tiden som har gått mellom linjer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdstempels kunnen nu naast de terminalinhoud worden getoond in plaats van eroverheen. Stel dit in via ‘Instellingen > Profielen > Sessie > Tijdstempels’. Klik met de rechtermuisknop op een regel en kies ‘Stel basislijn in voor relatieve tijdstempels’ om de verstreken tijd tussen regels te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaczniki czasu można teraz pokazywać obok zawartości terminala zamiast nakładać je na nią. Skonfiguruj to w „Ustawienia > Profile > Sesja > Znaczniki czasu”. Kliknij dowolny wiersz prawym przyciskiem i wybierz „Ustaw punkt odniesienia dla względnych znaczników czasu”, aby zobaczyć czas, który upłynął między wierszami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As marcações de tempo agora podem ser exibidas ao lado do conteúdo do terminal em vez de sobrepostas. Configure isso em “Settings > Profiles > Session > Timestamps”. Clique com o botão direito em qualquer linha e selecione “Set Baseline for Relative Timestamps” para ver o tempo decorrido entre as linhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь отметки времени можно отображать рядом с содержимым терминала, а не поверх него. Настройте это в разделе «Настройки > Профили > Сеанс > Отметки времени». Щёлкните правой кнопкой мыши на любой строке и выберите «Задать точку отсчёта для относительных отметок времени», чтобы увидеть время, прошедшее между строками."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časové pečiatky sa teraz môžu zobrazovať vedľa obsahu terminálu namiesto prekrývania. Nastavíte ich v časti „Nastavenia > Profily > Relácia > Časové pečiatky“. Kliknite pravým tlačidlom na ľubovoľný riadok a zvoľte „Nastaviť základ pre relatívne časové pečiatky“, aby sa zobrazil čas medzi riadkami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovni žigi so zdaj lahko prikazani ob vsebini terminala, namesto da se prekrivajo. Nastavite jih v »Nastavitve > Profili > Seja > Časovni žigi«. Z desnim klikom na poljubno vrstico in izbiro »Nastavi izhodišče za relativne časovne žige« si ogledate čas, ki je pretekel med vrsticami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsstämplar kan nu visas bredvid terminalinnehållet i stället för att överlappa. Konfigurera det i ”Inställningar > Profiler > Session > Tidsstämplar”. Högerklicka på en rad och välj ”Ange referens för relativa tidsstämplar” för att se tiden som förflutit mellan rader."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaman damgaları artık üst üste binmek yerine terminal içeriğinin yanında gösterilebilir. “Ayarlar > Profiller > Oturum > Zaman Damgaları” bölümünden yapılandırın. Satırlar arasında geçen süreyi görmek için herhangi bir satıra sağ tıklayıp “Göreli Zaman Damgaları İçin Başlangıç Belirle”yi seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ đây dấu thời gian có thể hiển thị cạnh nội dung terminal thay vì chồng lên. Cấu hình trong “Cài đặt > Hồ sơ > Phiên > Dấu thời gian”. Bấm chuột phải vào một dòng bất kỳ và chọn “Đặt mốc cho dấu thời gian tương đối” để xem thời gian trôi qua giữa các dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间戳现在可以显示在终端内容旁边，不会重叠。在“设置 > 配置文件 > 会话 > 时间戳”中进行配置。点击任意行右键，选择“为相对时间戳设置基准”，即可查看各行之间的时间间隔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間戳記現在可以顯示在終端機內容旁邊，而不會互相重疊。在「設定 > 描述檔 > 工作階段 > 時間戳記」中設定。在任一行上按一下右鍵並選取「設定相對時間戳記的基準」，即可查看各行之間經過的時間。"
          }
        }
      }
    },
