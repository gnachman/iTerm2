    },
    "AdvancedSetting.defaultWideMode" : {
      "comment" : "Advanced setting: defaultWideMode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim nativen Rendern standardmäßig den Breitmodus verwenden?"
