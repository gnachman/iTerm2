    "CorruptApplication.SignatureValidUnexpected" : {
      "comment" : "Alert shown when a required resource is missing but the code signature is unexpectedly valid",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, doch wider Erwarten ist die Codesignatur von iTerm2 gültig. Bitte melden Sie einen Fehler unter https://iterm2.com/bugs"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted, yet against all odds the code signature for iTerm2 is valid. Please file a bug at https://iterm2.com/bugs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o que está dañado, pero, contra todo pronóstico, la firma de código de iTerm2 es válida. Informa del error en https://iterm2.com/bugs"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu, pourtant, contre toute attente, la signature de code d’iTerm2 est valide. Signalez un bogue sur https://iterm2.com/bugs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato, eppure, contro ogni previsione, la firma del codice di iTerm2 è valida. Segnala il problema su https://iterm2.com/bugs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようですが、意外なことにiTerm2のコード署名は有効です。https://iterm2.com/bugs でバグを報告してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이지만, 의외로 iTerm2의 코드 서명은 유효합니다. https://iterm2.com/bugs 에서 버그를 보고하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido, mas contra todas as probabilidades a assinatura de código do iTerm2 é válida. Registre um bug em https://iterm2.com/bugs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, однако вопреки всему цифровая подпись кода iTerm2 действительна. Пожалуйста, сообщите об ошибке на странице https://iterm2.com/bugs"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor, ancak tüm olasılıklara rağmen iTerm2’nin kod imzası geçerli. Lütfen https://iterm2.com/bugs adresinden bir hata bildirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，但出乎意料的是 iTerm2 的代码签名是有效的。请向 https://iterm2.com/bugs 提交错误报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少必要的檔案或檔案已損毀，但出乎意料的是 iTerm2 的程式碼簽章是有效的。請前往 https://iterm2.com/bugs 回報錯誤。"
          }
        }
      }
    },
