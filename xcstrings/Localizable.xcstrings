          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлять сообщения о мыши при щелчке в окне, которое ещё не находится на переднем плане?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
