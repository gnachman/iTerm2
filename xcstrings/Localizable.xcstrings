    "Tip.0074.Body" : {
      "comment" : "Tip of the day body, id 0074",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzkoušejte motivy „Minimalistický“ a „Kompaktní“, které omezují vizuální nepořádek. Nastavíte je v „Nastavení > Vzhled > Obecné“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv temaerne “Minimal” og “Kompakt” for at reducere visuel rodet. Du kan indstille det i “Indstillinger > Udseende > Generelt”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probieren Sie die Designs „Minimal“ und „Kompakt“ aus, um optische Unordnung zu reduzieren. Sie können dies unter „Einstellungen > Erscheinungsbild > Allgemein“ einstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try the “Minimal” and “Compact” themes to reduce visual clutter. You can set it in “Settings > Appearance > General.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba los temas “Minimalista” y “Compacto” para reducir el desorden visual. Puedes definirlo en “Ajustes > Apariencia > General”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeile teemoja ”Minimaalinen” ja ”Kompakti” vähentääksesi visuaalista sekavuutta. Voit määrittää sen kohdassa ”Asetukset > Ulkoasu > Yleiset”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez les thèmes « Minimal » et « Compact » pour réduire l’encombrement visuel. Vous pouvez les définir dans « Réglages > Apparence > Général »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova i temi “Minimale” e “Compatto” per ridurre il disordine visivo. Puoi impostarlo in “Impostazioni > Aspetto > Generali”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覚的な煩雑さを減らすには、「ミニマル」や「コンパクト」テーマを試してみてください。「設定 > 外観 > 一般」で設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시각적 혼잡을 줄이려면 “미니멀” 및 “컴팩트” 테마를 사용해 보십시오. “설정 > 모양 > 일반”에서 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv temaene «Minimal» og «Kompakt» for å redusere visuell rot. Du kan angi det i «Innstillinger > Utseende > Generelt»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer de thema’s ‘Minimaal’ en ‘Compact’ om visuele rommel te verminderen. Je kunt dit instellen via ‘Instellingen > Weergave > Algemeen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wypróbuj motywy „Minimalny” i „Kompaktowy”, aby zmniejszyć wizualny bałagan. Możesz je ustawić w „Ustawienia > Wygląd > Ogólne”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente os temas “Minimalista” e “Compacto” para reduzir a poluição visual. Você pode defini-los em “Ajustes > Aparência > Geral”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте темы «Минимальная» и «Компактная», чтобы уменьшить визуальный беспорядок. Настроить это можно в «Настройки > Внешний вид > Общие»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyskúšajte témy „Minimalistický“ a „Kompaktný“, ktoré znižujú vizuálny neporiadok. Nastavíte ich v časti „Nastavenia > Vzhľad > Všeobecné“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za manj vizualne zmede poskusite temi »Minimalna« in »Kompaktna«. Nastavite ju v »Nastavitve > Videz > Splošno«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova temana ”Minimal” och ”Kompakt” för att minska det visuella bruset. Du kan ställa in det i ”Inställningar > Utseende > Allmänt”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel karmaşayı azaltmak için “Minimal” ve “Kompakt” temaları deneyin. Bunu “Ayarlar > Görünüm > Genel” bölümünden ayarlayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử các chủ đề “Tối giản” và “Gọn” để giảm bớt sự lộn xộn về mặt hình ảnh. Bạn có thể đặt trong “Cài đặt > Giao diện > Chung.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试使用“极简”和“紧凑”主题以减少视觉干扰。您可以在“设置 > 外观 > 通用”中进行配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試試「極簡」和「精簡」主題，減少視覺雜亂。你可以在「設定 > 外觀 > 一般」中設定。"
          }
        }
      }
    },
