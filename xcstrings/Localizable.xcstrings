    "PreviousState.CantSwitchDescription" : {
      "comment" : "Notification body explaining why the app can't be brought back to the front; %@ is the app name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze se vrátit do aplikace %@, protože jiná aplikace zapnula zabezpečené zadávání z klávesnice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke skifte tilbage til %@, fordi et andet program har slået sikker tastaturindtastning til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann nicht zu %@ zurückwechseln, da eine andere App die sichere Tastatureingabe aktiviert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Can’t switch back to %@ because another app has enabled secure keyboard entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede volver a %@ porque otra app ha activado la entrada segura de teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellukseen %@ ei voi palata, koska toinen sovellus on ottanut suojatun näppäimistösyötön käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de revenir à %@, car une autre app a activé l’entrée clavier sécurisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile tornare a %@ perché un’altra app ha attivato l’inserimento sicuro da tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリがセキュアキーボード入力を有効にしているため、%@に切り替えることができません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 보안 키보드 입력을 활성화했기 때문에 %@(으)로 다시 전환할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke bytte tilbake til %@ fordi en annen app har slått på sikker tastaturinntasting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan niet terugschakelen naar %@ omdat een andere app beveiligde toetsenbordinvoer heeft ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można wrócić do aplikacji %@, ponieważ inna aplikacja włączyła bezpieczne wprowadzanie z klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível voltar para %@ porque outro app ativou a entrada segura de teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся переключиться обратно на %@, так как другое приложение включило безопасный ввод с клавиатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie je možné prepnúť späť na %@, pretože iná aplikácia zapla zabezpečené zadávanie z klávesnice."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preklop nazaj na %@ ni mogoč, ker je druga aplikacija omogočila varen vnos s tipkovnico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte byta tillbaka till %@ eftersom ett annat program har aktiverat säker tangentbordsinmatning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama güvenli klavye girişini etkinleştirdiği için %@ uygulamasına geri dönülemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể chuyển lại %@ vì một ứng dụng khác đã bật Nhập bằng bàn phím an toàn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换回 %@，因为其他应用已启用安全键盘输入功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法切換回 %@，因為另一個 App 已啟用安全鍵盤輸入。"
          }
        }
      }
    },
