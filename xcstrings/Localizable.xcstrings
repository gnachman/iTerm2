        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許將標籤頁拖放到任何現有標籤頁列之外，以建立新視窗。"
          }
        }
      }
    },
    "AdvancedSetting.allowDragOnAddTabButton" : {
