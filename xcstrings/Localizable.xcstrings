    },
    "AdvancedSetting.convertItalicsToReverseVideoForTmux" : {
      "comment" : "Advanced setting: convertItalicsToReverseVideoForTmux",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Převádět kurzívu na inverzní video v integraci tmux?\nÚčinné, když výchozí TERM hlášený tmux odpovídá *screen*."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konvertér kursiv til omvendt video i tmux-integration?\nDette gælder, når standard-TERM, som tmux rapporterer, matcher *screen*."
