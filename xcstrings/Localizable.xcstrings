            "value" : "Uneven tab widths allowed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブの幅が不均一になることを許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
