    "Tip.000.Body" : {
      "comment" : "Tip of the day body, id 000",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Fenster zeigt den iTerm2-Tipp des Tages. Es erscheint alle 24 Stunden, um Sie über neue Funktionen und versteckte Geheimnisse zu informieren. Klicken Sie auf „Weitere Optionen“, um weitere Tipps anzuzeigen oder sie ganz zu deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This window shows the iTerm2 tip of the day. It’ll appear every 24 hours to let you know about new features and hidden secrets. Hit “More Options” to view more tips or to stop getting them altogether."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウには iTerm2 の今日のヒントが表示されます。新機能や隠された秘密を知らせるために、24 時間ごとに表示されます。「その他のオプション」をクリックすると、他のヒントを見たり、表示を完全に停止したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 윈도우에는 iTerm2 오늘의 팁이 표시됩니다. 24시간마다 나타나 새로운 기능과 숨겨진 비밀을 알려 줍니다. 더 많은 팁을 보거나 팁을 아예 받지 않으려면 “옵션 더 보기”를 누르십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta janela mostra a dica do dia do iTerm2. Ela aparece a cada 24 horas para informar sobre novos recursos e segredos ocultos. Clique em “Mais opções” para ver mais dicas ou para parar de recebê-las de vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это окно показывает совет дня iTerm2. Оно появляется каждые 24 часа, чтобы рассказать о новых функциях и скрытых возможностях. Нажмите «Дополнительные параметры», чтобы просмотреть другие советы или полностью отключить их показ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗口显示 iTerm2 每日提示。每24小时出现一次，用于告知您新功能和隐藏功能。点击“更多选项”可查看更多提示或完全停止接收。"
          }
        }
      }
    },
