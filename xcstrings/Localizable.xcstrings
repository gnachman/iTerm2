    "Companion.InstallAIManualModelNeedsConfiguration" : {
      "comment" : "Shown on the full setup screen instead of the API key field when the user’s manually chosen AI model cannot authenticate",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model AI vybraný v části „Nastavení > Obecné > AI“ potřebuje API klíč nebo platnou konfiguraci, aby funkce AI fungovaly. Můžete nainstalovat hned a nastavení modelu dokončit později."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den AI-model, der er valgt i Indstillinger > Generelt > AI, har brug for en API-nøgle eller en gyldig konfiguration, før AI-funktioner virker. Du kan installere nu og gøre modellen færdig senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das unter Einstellungen > Allgemein > KI ausgewählte KI-Modell benötigt einen API-Schlüssel oder eine gültige Konfiguration, bevor KI-Funktionen funktionieren. Sie können jetzt installieren und die Einrichtung des Modells später abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI model selected in Settings > General > AI needs an API key or a valid configuration before AI features will work. You can install now and finish setting up the model later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de IA seleccionado en Ajustes > General > IA necesita una clave de API o una configuración válida para que las funciones de IA funcionen. Puedes instalar ahora y terminar de configurar el modelo más tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdassa Asetukset > Yleiset > AI valittu AI-malli tarvitsee API-avaimen tai kelvollisen määrityksen, ennen kuin AI-ominaisuudet toimivat. Voit asentaa nyt ja viimeistellä mallin määrityksen myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle d’IA sélectionné dans Réglages > Général > IA nécessite une clé d’API ou une configuration valide pour que les fonctions d’IA fonctionnent. Vous pouvez installer maintenant et terminer la configuration du modèle plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello IA selezionato in Impostazioni > Generali > IA richiede una chiave API o una configurazione valida perché le funzioni IA funzionino. Puoi installare ora e terminare la configurazione del modello in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI機能を使用するには、設定 > 一般 > AIで選択したAIモデルにAPIキーまたは有効な設定が必要です。今すぐインストールして、モデルの設定は後で完了することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 기능을 사용하려면 설정 > 일반 > AI에서 선택한 AI 모델에 API 키 또는 유효한 구성이 필요합니다. 지금 설치하고 나중에 모델 설정을 완료할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-modellen som er valgt i «Innstillinger > Generelt > KI», trenger en API-nøkkel eller en gyldig konfigurasjon før KI-funksjoner fungerer. Du kan installere nå og fullføre oppsettet av modellen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het AI-model dat is gekozen in Instellingen > Algemeen > AI heeft een API-sleutel of een geldige configuratie nodig voordat AI-functies werken. Je kunt nu installeren en het model later verder instellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model AI wybrany w: Ustawienia > Ogólne > AI wymaga klucza API lub prawidłowej konfiguracji, aby funkcje AI działały. Możesz zainstalować teraz i dokończyć konfigurację modelu później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo de IA selecionado em Ajustes > Geral > IA precisa de uma chave de API ou de uma configuração válida para que os recursos de IA funcionem. Você pode instalar agora e concluir a configuração do modelo mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модели ИИ, выбранной в Настройки > Общие > ИИ, нужен ключ API или корректная конфигурация, чтобы функции ИИ заработали. Вы можете установить сейчас и завершить настройку модели позже."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model AI vybraný v časti „Nastavenia > Všeobecné > AI“ potrebuje API kľúč alebo platnú konfiguráciu, aby funkcie AI fungovali. Môžete inštalovať teraz a nastavenie modelu dokončiť neskôr."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model AI, izbran v »Nastavitve > Splošno > AI«, potrebuje ključ API ali veljavno konfiguracijo, preden bodo funkcije AI delovale. Zdaj lahko namestite in nastavitev modela dokončate pozneje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-modellen som valts under Inställningar > Allmänt > AI behöver en API-nyckel eller en giltig konfiguration innan AI-funktionerna fungerar. Du kan installera nu och slutföra konfigureringen av modellen senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ özelliklerinin çalışması için Ayarlar > Genel > YZ bölümünde seçili YZ modelinin bir API anahtarına veya geçerli bir yapılandırmaya ihtiyacı var. Şimdi yükleyip modelin kurulumunu daha sonra tamamlayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình AI được chọn trong Cài đặt > Chung > AI cần có khóa API hoặc cấu hình hợp lệ thì các tính năng AI mới hoạt động. Bạn có thể cài đặt ngay bây giờ và hoàn tất thiết lập mô hình sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 通用 > AI”中选择的 AI 模型需要 API 密钥或有效配置，AI 功能才能正常工作。您可以现在安装，稍后再完成模型设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 一般 > AI」中選擇的 AI 模型需要 API 金鑰或有效的設定，AI 功能才能運作。你可以現在安裝，稍後再完成模型設定。"
          }
        }
      }
    },
