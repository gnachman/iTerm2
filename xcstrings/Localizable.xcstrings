    "ScriptLauncher.Arm64DownloadFailedRecovery" : {
      "comment" : "Recovery suggestion when the Apple Silicon runtime download failed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běhové prostředí pro Apple Silicon se nepodařilo stáhnout. Zkontrolujte připojení k síti a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kørselsmiljøet til Apple Silicon kunne ikke hentes. Kontroller din netværksforbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Apple-Silicon-Laufzeitumgebung konnte nicht heruntergeladen werden. Überprüfen Sie Ihre Netzwerkverbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Apple Silicon runtime could not be downloaded. Check your network connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo descargar el entorno de ejecución para Apple Silicon. Comprueba tu conexión de red y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon -suoritusympäristöä ei voitu ladata. Tarkista verkkoyhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement d’exécution pour Apple Silicon n’a pas pu être téléchargé. Vérifiez votre connexion réseau et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scaricare l’ambiente di esecuzione per Apple Silicon. Controlla la connessione di rete e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Siliconランタイムをダウンロードできませんでした。ネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon 런타임을 다운로드할 수 없습니다. 네트워크 연결을 확인하고 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøremiljøet for Apple Silicon kunne ikke lastes ned. Kontroller nettverkstilkoblingen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Apple Silicon-runtime kan niet worden gedownload. Controleer je netwerkverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można pobrać środowiska uruchomieniowego dla Apple Silicon. Sprawdź połączenie sieciowe i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível baixar o runtime para Apple Silicon. Verifique sua conexão de rede e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить среду выполнения для Apple Silicon. Проверьте подключение к сети и повторите попытку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behové prostredie pre Apple Silicon sa nepodarilo stiahnuť. Skontrolujte sieťové pripojenie a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvajalnega okolja za Apple Silicon ni bilo mogoče prenesti. Preverite omrežno povezavo in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körmiljön för Apple Silicon kunde inte hämtas. Kontrollera nätverksanslutningen och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Silicon çalışma zamanı indirilemedi. Ağ bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tải về môi trường chạy dành cho Apple Silicon. Hãy kiểm tra kết nối mạng và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法下载 Apple Silicon 运行时。请检查您的网络连接后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法下載 Apple Silicon 執行環境。請檢查網路連線後再試一次。"
          }
        }
      }
