    "ScriptLauncher.UpgradeRuntimeMessage" : {
      "comment" : "Prompt to upgrade a script's runtime; %@ is the script name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Python-API-Skript „%@“ benötigt aus Sicherheitsgründen eine neuere Version der Laufzeitumgebung. Sie müssen es aktualisieren, bevor diese Version von iTerm2 das Skript starten kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python API script “%@” needs a newer version of the runtime environment for security reasons. You must upgrade it before this version of iTerm2 can launch the script."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python APIスクリプト「%@」は、セキュリティ上の理由からランタイム環境の新しいバージョンを必要としています。このバージョンのiTerm2でスクリプトを起動する前に、アップグレードする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API 스크립트 “%@”은(는) 보안상의 이유로 더 새로운 버전의 런타임 환경이 필요합니다. 이 버전의 iTerm2에서 스크립트를 실행하려면 먼저 업그레이드해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O script da API do Python “%@” precisa de uma versão mais recente do ambiente de runtime por motivos de segurança. Você precisa atualizá-lo antes que esta versão do iTerm2 possa iniciar o script."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрипту Python API «%@» по соображениям безопасности требуется более новая версия среды выполнения. Его необходимо обновить, прежде чем эта версия iTerm2 сможет запустить скрипт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于安全原因，Python API 脚本“%@”需要更新版本的运行时环境。必须先升级它，此版本的 iTerm2 才能启动该脚本。"
          }
        }
      }
    },
