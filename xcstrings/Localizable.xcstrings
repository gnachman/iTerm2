    "Tip.0054.Body" : {
      "comment" : "Tip of the day body, id 0054",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „Einstellungen > Tasten“ können Sie mit der Aktion „Regulären Ausdruck suchen…“ einem Tastendruck eine Suche nach einem regulären Ausdruck zuweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In “Settings > Keys” you can assign a keystroke to a search for a regular expression with the “Find Regular Expression…” action."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > キー」では、「正規表現を検索…」アクションを使って、正規表現の検索にキー操作を割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 키”에서 “정규 표현식 찾기…” 동작으로 정규 표현식 검색에 키 입력을 지정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em “Ajustes > Teclas” você pode atribuir um atalho de teclado a uma busca por expressão regular com a ação “Buscar expressão regular…”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «Настройки > Клавиши» можно назначить сочетание клавиш для поиска по регулярному выражению с помощью действия «Найти регулярное выражение…»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 按键”中，可以通过“查找正则表达式…”功能将按键与正则表达式搜索关联起来。"
          }
        }
      }
    },
