    "Tip.0012.Body" : {
      "comment" : "Tip of the day body, id 0012",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Úpravy > Vložit jinak > Pokročilé vkládání“ umožňuje zobrazit náhled a upravit text před vložením. Můžete upravit volby, například jak zacházet s řídicími kódy, nebo před vložením text dokonce zakódovat do Base64."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Rediger > Sæt ind specielt > Avanceret indsætning” lader dig se et eksempel og redigere teksten, før du sætter den ind. Du kan justere indstillinger, f.eks. hvordan kontrolkoder håndteres, eller endda base64-kode før indsætning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Bearbeiten > Spezielles Einfügen > Erweitertes Einfügen“ können Sie Text vor dem Einfügen in der Vorschau ansehen und bearbeiten. Sie können Optionen anpassen, etwa wie mit Steuercodes umgegangen wird, oder den Text vor dem Einfügen sogar Base64-codieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Edit > Paste Special > Advanced Paste” lets you preview and edit text before you paste. You get to tweak options, like how to handle control codes, or even to base-64 encode before pasting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Edición > Pegado especial > Pegado avanzado” te permite previsualizar y editar el texto antes de pegarlo. Puedes ajustar opciones, como el tratamiento de los códigos de control, o incluso codificar en base64 antes de pegar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Muokkaa > Erikoissijoitus > Edistynyt sijoitus” antaa esikatsella ja muokata tekstiä ennen sijoitusta. Voit säätää asetuksia, kuten ohjauskoodien käsittelyä, tai jopa base64-koodata ennen sijoitusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Édition > Collage spécial > Collage avancé » vous permet de prévisualiser et de modifier le texte avant de le coller. Vous pouvez ajuster des options, comme le traitement des codes de contrôle, ou même encoder en base64 avant de coller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Modifica > Incolla speciale > Incolla avanzato” ti permette di vedere l’anteprima e modificare il testo prima di incollarlo. Puoi regolare opzioni, come la gestione dei codici di controllo, o persino codificare in base64 prima di incollare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 特殊なペースト > 高度なペースト」を使うと、ペーストする前にテキストをプレビューして編集できます。制御コードの扱い方や、ペースト前にBase64エンコードするかどうかなど、オプションを細かく調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“편집 > 특수 붙여넣기 > 고급 붙여넣기”를 사용하면 붙여넣기 전에 텍스트를 미리 보고 편집할 수 있습니다. 제어 코드 처리 방법 같은 옵션을 조정하거나, 붙여넣기 전에 base-64로 인코딩할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Rediger > Lim inn spesielt > Avansert innliming» lar deg forhåndsvise og redigere tekst før du limer den inn. Du kan justere valg, som hvordan kontrollkoder håndteres, eller til og med base64-kode teksten før innliming."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met ‘Wijzig > Plak speciaal > Geavanceerd plakken’ kun je tekst vooraf bekijken en wijzigen voordat je plakt. Je kunt opties aanpassen, zoals hoe besturingscodes worden verwerkt, of zelfs base64-codering toepassen voor het plakken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Edycja > Wklej specjalnie > Zaawansowane wklejanie” pozwala wyświetlić podgląd i edytować tekst przed wklejeniem. Możesz dostosować opcje, na przykład sposób obsługi kodów sterujących, a nawet zakodować tekst w base64 przed wklejeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Editar > Colar especial > Colagem avançada” permite visualizar e editar o texto antes de colar. Você pode ajustar opções, como lidar com códigos de controle ou até codificar em base-64 antes de colar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Правка > Специальная вставка > Расширенная вставка» позволяет просмотреть и отредактировать текст перед вставкой. Вы можете настроить параметры, например способ обработки управляющих кодов, или даже закодировать текст в base-64 перед вставкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položka „Upraviť > Vložiť špeciálne > Rozšírené vkladanie…“ umožňuje zobraziť náhľad a upraviť text pred vložením. Môžete nastaviť možnosti, napríklad spracovanie riadiacich kódov, alebo text pred vložením dokonca zakódovať do base64."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Uredi > Posebno lepljenje > Napredno lepljenje« omogoča predogled in urejanje besedila pred lepljenjem. Prilagodite lahko možnosti, na primer obravnavo krmilnih kod, ali pa besedilo pred lepljenjem celo kodirate v base64."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med ”Redigera > Klistra in special > Avancerad inklistring” kan du förhandsvisa och redigera text innan du klistrar in den. Du kan justera alternativ, till exempel hur styrtecken hanteras, eller till och med base64-koda innan inklistring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Düzen > Özel Yapıştır > Gelişmiş Yapıştırma”, yapıştırmadan önce metni önizlemenizi ve düzenlemenizi sağlar. Denetim kodlarının nasıl işleneceği gibi seçenekleri ayarlayabilir, hatta yapıştırmadan önce base64 olarak kodlayabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sửa > Dán đặc biệt > Dán nâng cao” cho phép bạn xem trước và sửa văn bản trước khi dán. Bạn có thể tinh chỉnh các tùy chọn, như cách xử lý mã điều khiển, hoặc thậm chí mã hóa base64 trước khi dán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“编辑 > 特殊粘贴 > 高级粘贴”功能可让你在粘贴前预览和编辑文本。你可以调整选项，例如如何处理控制码，甚至可以在粘贴前进行Base64编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編輯 > 特殊貼上 > 進階貼上」可讓你在貼上前預覽並編輯文字。你可以調整選項，例如如何處理控制碼，甚至可在貼上前先進行 base-64 編碼。"
          }
        }
      }
    },
