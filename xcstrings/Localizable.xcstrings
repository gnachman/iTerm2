        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Installation der Python-Laufzeitumgebung ist ein Fehler aufgetreten. Entfernen Sie ~/Library/Application Support/iTerm2/iterm2env und versuchen Sie es erneut. Der Fehler lautete: %@"
