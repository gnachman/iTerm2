            "state" : "translated",
            "value" : "Kabuk Entegrasyonu Geçmişi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 集成历史记录"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
