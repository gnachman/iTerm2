    "AdvancedSetting.minimalDeslectedColoredTabAlpha" : {
      "comment" : "Advanced setting: minimalDeslectedColoredTabAlpha",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alphawert für die Tab-Farbe bei nicht ausgewählten farbigen Tabs im Design „Minimal“.\nMuss zwischen 0 und 1 liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
