    "Tip.0069.Body" : {
      "comment" : "Tip of the day body, id 0069",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in 3.1: Sie können mehrere Hotkey-Fenster verwenden. Jedes Profil kann einen oder mehrere Hotkeys besitzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can have multiple hotkey windows. Each profile can have one or more hotkeys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novedad en la 3.1: puedes tener varias ventanas de tecla rápida. Cada perfil puede tener una o más teclas rápidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau dans la version 3.1 : vous pouvez avoir plusieurs fenêtres à raccourci global. Chaque profil peut avoir un ou plusieurs raccourcis globaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novità della 3.1: puoi avere più finestre ad abbreviazione globale. Ogni profilo può avere una o più abbreviazioni globali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1の新機能: 複数のホットキーウィンドウを持てるようになりました。各プロファイルは1つ以上のホットキーを持てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1의 새로운 기능: 여러 개의 단축키 윈도우를 사용할 수 있습니다. 각 프로파일에 하나 이상의 단축키를 지정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode ter várias janelas de atalho. Cada perfil pode ter uma ou mais teclas de atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое в 3.1: у вас может быть несколько окон горячих клавиш. У каждого профиля может быть одна или несколько горячих клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1’de yeni: Birden çok kısayol tuşu penceresine sahip olabilirsiniz. Her profilin bir veya daha fazla kısayol tuşu olabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1新功能：你可以拥有多个热键窗口。每个配置文件可以包含一个或多个热键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1 新功能：你可以擁有多個全域快速鍵視窗。每個描述檔可以有一個或多個全域快速鍵。"
          }
        }
      }
    },
