    "PTYSession.UploadInProgressBody" : {
      "comment" : "Alert body explaining that another upload is already in progress",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počkejte, až aktuální nahrávání skončí, nebo ho zrušte, než zahájíte další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent, til den aktuelle overførsel er færdig, eller annuller den, før du starter en ny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte warten Sie, bis der aktuelle Upload abgeschlossen ist, oder brechen Sie ihn ab, bevor Sie einen weiteren starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Please wait for the current upload to complete or cancel it before starting another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que termine la subida actual o cancélala antes de iniciar otra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odota, että nykyinen lähetys valmistuu, tai kumoa se ennen uuden aloittamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin du téléversement en cours ou annulez-le avant d’en lancer un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi il completamento del caricamento in corso o annullalo prima di avviarne un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアップロードが完了するのを待つか、キャンセルしてから別のアップロードを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 업로드를 시작하기 전에 현재 업로드가 완료될 때까지 기다리거나 현재 업로드를 취소하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent til den pågående opplastingen er ferdig, eller avbryt den, før du starter en ny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot de huidige upload is voltooid of annuleer deze voordat je een andere start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczekaj na zakończenie bieżącego wysyłania lub anuluj je, zanim rozpoczniesz kolejne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a conclusão do envio atual ou cancele-o antes de iniciar outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождитесь завершения текущей отправки или отмените её, прежде чем начинать новую."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počkajte, kým sa aktuálne odosielanie dokončí, alebo ho zrušte, a až potom spustite ďalšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počakajte, da se trenutno nalaganje konča, ali ga prekličite, preden začnete novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänta tills den pågående överföringen är klar eller avbryt den innan du startar en ny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir yüklemeyi başlatmadan önce lütfen mevcut yüklemenin bitmesini bekleyin veya iptal edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vui lòng chờ lần tải lên hiện tại hoàn tất hoặc hủy nó trước khi bắt đầu lần khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待当前上传完成或将其取消，然后再开始另一项上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請等待目前的上傳完成或將其取消，然後再開始另一項上傳。"
          }
        }
      }
    },
