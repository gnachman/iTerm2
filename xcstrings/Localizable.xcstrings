          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile sekund czekać na podłączenie do demona iTerm przy uruchamianiu podczas przywracania okien?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo esperar ao tentar se conectar a um daemon do iTerm na inicialização ao restaurar janelas (em segundos)?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько секунд ждать при попытке подключиться к демону iTerm при запуске во время восстановления окон?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako dlho čakať (v sekundách) pri pokuse o pripojenie k démonu iTerm pri spustení a obnove okien?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko sekund čakati pri poskusu priklopa na pritajeni program iTerm ob zagonu pri obnovi oken?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge ska vi vänta när vi försöker koppla till en iTerm-daemon vid start när fönster återställs (i sekunder)?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereler geri yüklenirken açılışta bir iTerm arka plan hizmetine bağlanmak için kaç saniye beklenecek?"
          }
        },
        "vi" : {
          "stringUnit" : {
