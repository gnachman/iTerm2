    "SessionLauncher.FontNotFoundMessage" : {
      "comment" : "Warning shown when the profile’s font and the fallback font cannot be loaded. %@ is the font name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die angegebene Schriftart „%@“ oder die Standard-Ausweichschriftart mit fester Zeichenbreite, Menlo, konnte nicht gefunden werden. Bitte stellen Sie sicher, dass mindestens eine davon installiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn’t find the specified font “%@” or the fallback standard fixed-pitch font, Menlo. Please ensure at least one of these is installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el tipo de letra especificado “%@” ni el tipo de letra estándar de ancho fijo de reserva, Menlo. Asegúrate de que al menos uno de ellos esté instalado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver la police spécifiée « %@ » ni la police à chasse fixe de secours, Menlo. Assurez-vous qu’au moins l’une d’elles est installée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare il font specificato “%@” né il font a larghezza fissa standard di riserva, Menlo. Assicurati che almeno uno dei due sia installato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定されたフォント「%@」も、代替の標準等幅フォントであるMenloも見つかりませんでした。これらのいずれかがインストールされていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지정한 서체 “%@” 또는 대체 표준 고정폭 서체인 Menlo를 찾을 수 없습니다. 이 중 하나 이상이 설치되어 있는지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível encontrar a fonte especificada “%@” nem a fonte padrão de largura fixa alternativa, Menlo. Certifique-se de que pelo menos uma delas esteja instalada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти указанный шрифт «%@» или резервный стандартный моноширинный шрифт Menlo. Убедитесь, что хотя бы один из них установлен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belirtilen “%@” fontu veya yedek standart sabit aralıklı font Menlo bulunamadı. Lütfen bunlardan en az birinin yüklü olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到指定的字体“%@”或回退的标准等宽字体 Menlo。请确保至少安装了其中一种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到指定的字體「%@」或備用的標準等寬字體 Menlo。請確認至少已安裝其中一種。"
          }
        }
      }
    },
