    "ScriptsMenu.TakingTooLong" : {
      "comment" : "Warning shown when enumerating the scripts folder takes too long",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Suchen aller Skripte unter %@ dauert sehr lange. Vermeiden Sie es, viele Dateien zu speichern oder Netzwerklaufwerke für den Skripte-Ordner zu verwenden.\n\nFortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is taking a long time to locate all scripts under %@. Avoid storing many files or using network mounts for the scripts folder.\n\nContinue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está tardando mucho en localizar todos los scripts en %@. Evita almacenar muchos archivos o usar volúmenes de red para la carpeta de scripts.\n\n¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche de tous les scripts dans %@ prend beaucoup de temps. Évitez de stocker de nombreux fichiers ou d’utiliser des montages réseau pour le dossier des scripts.\n\nContinuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci vuole molto tempo per individuare tutti gli script in %@. Evita di salvare molti file o di usare volumi di rete per la cartella degli script.\n\nContinuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以下のすべてのスクリプトを検出するのに時間がかかっています。スクリプトフォルダに多数のファイルを保存したり、ネットワークマウントを使用したりしないでください。\n\n続行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 아래의 모든 스크립트를 찾는 데 오래 걸리고 있습니다. 스크립트 폴더에 많은 파일을 저장하거나 네트워크 마운트를 사용하지 마십시오.\n\n계속하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está demorando muito para localizar todos os scripts em %@. Evite armazenar muitos arquivos ou usar montagens de rede na pasta de scripts.\n\nContinuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск всех скриптов в %@ занимает много времени. Избегайте хранения большого числа файлов или использования сетевых дисков для папки скриптов.\n\nПродолжить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ altındaki tüm betikleri bulmak uzun sürüyor. Betik klasörü için çok sayıda dosya saklamaktan veya ağ bağlama noktaları kullanmaktan kaçının.\n\nDevam edilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位 %@ 下的所有脚本耗时较长。避免在脚本文件夹中存储大量文件或使用网络挂载。\n\n继续？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋找 %@ 下的所有腳本花費了很長的時間。請避免在腳本檔案夾中存放大量檔案或使用網路掛載。\n\n要繼續嗎？"
          }
        }
      }
    },
