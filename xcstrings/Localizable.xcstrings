    "AdvancedSetting.showSSHFlowControlMonitor" : {
      "comment" : "Advanced setting: showSSHFlowControlMonitor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit okno se stavem řízení toku integrace SSH.\nPro připojení aktuální relace a každé v ní vnořené připojení: nevyřízený kredit, naměřená zpoždění a rychlosti a grafy poslední minuty. Zavřením okna se toto vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis et vindue med flowkontroltilstanden for SSH-integration.\nFor den nuværende sessions forbindelse og alle forbindelser indlejret i den: den udestående kredit, de målte forsinkelser og hastigheder samt diagrammer for det sidste minut. Når vinduet lukkes, slås dette fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fenster mit dem Flusssteuerungsstatus der SSH-Integration anzeigen.\nFür die Verbindung der aktuellen Sitzung und jede darin verschachtelte Verbindung: das ausstehende Guthaben, die gemessenen Verzögerungen und Raten sowie Diagramme der letzten Minute. Durch Schließen des Fensters wird dies ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show a window with SSH Integration’s flow control state.\nFor the current session’s connection and every connection nested in it: the credit outstanding, the measured delays and rates, and charts of the last minute. Closing the window turns this off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una ventana con el estado del control de flujo de la integración con SSH.\nPara la conexión de la sesión actual y todas las conexiones anidadas en ella: el crédito pendiente, los retrasos y velocidades medidos y gráficas del último minuto. Al cerrar la ventana se desactiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä ikkuna SSH-integraation vuonhallinnan tilasta.\nNykyisen istunnon yhteydelle ja kaikille siihen sisäkkäisille yhteyksille: avoin luotto, mitatut viiveet ja nopeudet sekä viimeisen minuutin kaaviot. Ikkunan sulkeminen laittaa tämän pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher une fenêtre avec l’état du contrôle de flux de l’intégration SSH.\nPour la connexion de la session actuelle et chaque connexion imbriquée : le crédit en attente, les délais et débits mesurés, et des graphiques de la dernière minute. La fermeture de la fenêtre désactive ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una finestra con lo stato del controllo di flusso dell’integrazione SSH.\nPer la connessione della sessione corrente e per ogni connessione annidata al suo interno: il credito in sospeso, i ritardi e le velocità misurati e i grafici dell’ultimo minuto. La chiusura della finestra lo disattiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合のフロー制御の状態を表示するウインドウを表示します。\n現在のセッションの接続と、その中にネストされたすべての接続について、未消化のクレジット、計測された遅延とレート、直近 1 分間のグラフを表示します。ウインドウを閉じるとこの設定はオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합의 흐름 제어 상태를 보여 주는 윈도우를 표시합니다.\n현재 세션의 연결과 그 안에 중첩된 모든 연결에 대해 미사용 크레딧, 측정된 지연 및 속도, 최근 1분간의 차트를 보여 줍니다. 윈도우를 닫으면 이 설정이 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis et vindu med flytkontrolltilstanden til SSH-integrering.\nFor gjeldende økts tilkobling og alle tilkoblinger nestet i den: utestående kreditt, målte forsinkelser og hastigheter, og diagrammer for det siste minuttet. Når vinduet lukkes, slås dette av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon een venster met de status van de flowcontrol van SSH-integratie.\nVoor de verbinding van de huidige sessie en elke daarin geneste verbinding: het openstaande krediet, de gemeten vertragingen en snelheden en grafieken van de laatste minuut. Het sluiten van het venster schakelt dit uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż okno ze stanem kontroli przepływu Integracji z SSH.\nDla połączenia bieżącej sesji i każdego połączenia zagnieżdżonego w niej: oczekujący kredyt, zmierzone opóźnienia i szybkości oraz wykresy z ostatniej minuty. Zamknięcie okna wyłącza tę opcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar uma janela com o estado do controle de fluxo da Integração SSH.\nPara a conexão da sessão atual e cada conexão aninhada nela: o crédito pendente, os atrasos e taxas medidos e gráficos do último minuto. Fechar a janela desativa este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показать окно с состоянием управления потоком интеграции с SSH.\nДля подключения текущего сеанса и каждого вложенного в него подключения: неизрасходованный кредит, измеренные задержки и скорости, а также графики за последнюю минуту. Закрытие окна отключает этот параметр."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť okno so stavom riadenia toku integrácie SSH.\nPre pripojenie aktuálnej relácie a každé pripojenie vnorené do nej: nevyužitý kredit, namerané oneskorenia a rýchlosti a grafy poslednej minúty. Zatvorením okna sa to vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži okno s stanjem nadzora pretoka integracije SSH.\nZa povezavo trenutne seje in vsako povezavo, vgnezdeno vanjo: neporavnani kredit, izmerjene zakasnitve in hitrosti ter grafe zadnje minute. Zaprtje okna to izklopi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa ett fönster med SSH-integreringens flödeskontrolltillstånd.\nFör den aktuella sessionens anslutning och varje anslutning nästlad i den: utestående kredit, uppmätta fördröjningar och hastigheter samt diagram över den senaste minuten. Om du stänger fönstret stängs det här av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH Entegrasyonu’nun akış denetimi durumunu gösteren bir pencere göster.\nGeçerli oturumun bağlantısı ve içindeki tüm iç içe bağlantılar için: bekleyen kredi, ölçülen gecikmeler ve hızlar ile son dakikanın grafikleri. Pencereyi kapatmak bunu kapatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị cửa sổ chứa trạng thái điều khiển luồng của Tích hợp SSH.\nCho kết nối của phiên hiện tại và mọi kết nối lồng trong nó: tín dụng chưa dùng, độ trễ và tốc độ đo được, và biểu đồ của phút vừa qua. Đóng cửa sổ sẽ tắt tùy chọn này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示一个窗口，展示 SSH 集成的流量控制状态。\n针对当前会话的连接以及嵌套在其中的每个连接：显示未用完的额度、测得的延迟和速率，以及最近一分钟的图表。关闭该窗口会关闭此项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示 SSH 整合流量控制狀態的視窗。\n針對目前工作階段的連線以及其中巢狀的每個連線：顯示未結清的額度、測得的延遲和速率，以及最近一分鐘的圖表。關閉視窗會關閉此設定。"
          }
        }
      }
    },
