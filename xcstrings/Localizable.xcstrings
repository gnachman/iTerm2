        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at markeringen er endret og ikke lenger er et gyldig JSON-objekt.\nDu finner denne funksjonen under «Rediger > Erstatt markering > Erstatt med formatert JSON» hvis du vil prøve igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat de selectie is gewijzigd en geen geldig JSON-object meer is.\nJe vindt deze functie onder Wijzig > Vervang selectie > Vervang door opgemaakte JSON als je het opnieuw wilt proberen."
          }
