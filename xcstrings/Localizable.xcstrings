    "AISettings.CouldNotReachOllamaBody" : {
      "comment" : "Alert body shown when the local Ollama server can't be reached; %@ is the server endpoint URL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
