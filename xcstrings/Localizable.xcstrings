    "AdvancedSetting.pathToFTP" : {
      "comment" : "Advanced setting: pathToFTP",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfad zu ftp zum Öffnen von ftp:-URLs.\nSie können dies auf /usr/local/bin/ftp setzen, um die Homebrew-Installation zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Path to ftp for opening ftp: URLs.\nYou may want to set this to /usr/local/bin/ftp to use the Homebrew install."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta de ftp para abrir URLs ftp:.\nPuede que quieras establecerla en /usr/local/bin/ftp para usar la instalación de Homebrew."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chemin de ftp pour l’ouverture des URL ftp:.\nVous pouvez le définir sur /usr/local/bin/ftp pour utiliser l’installation Homebrew."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percorso di ftp per aprire gli URL ftp:.\nPotresti volerlo impostare su /usr/local/bin/ftp per usare l’installazione di Homebrew."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ftp: URLを開くためのftpへのパス。\nHomebrewでインストールしたものを使用するには /usr/local/bin/ftp に設定するとよいでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ftp: URL을 열 때 사용할 ftp의 경로.\nHomebrew로 설치한 버전을 사용하려면 /usr/local/bin/ftp로 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminho para o ftp para abrir URLs ftp:.\nVocê pode querer definir isto como /usr/local/bin/ftp para usar a instalação do Homebrew."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путь к ftp для открытия ссылок ftp:.\nВозможно, вы захотите указать /usr/local/bin/ftp, чтобы использовать версию, установленную через Homebrew."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ftp: URL’lerini açmak için ftp yolu.\nHomebrew kurulumunu kullanmak için bunu /usr/local/bin/ftp olarak ayarlamak isteyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 ftp: URL 的 ftp 路径。\n您可以将其设置为 /usr/local/bin/ftp 以使用 Homebrew 安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
