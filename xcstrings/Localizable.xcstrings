        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は既に存在します。置き換えますか、それとも追加しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 이미 존재합니다. 대치하겠습니까, 아니면 뒤에 추가하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
