    "TransferrableFile.CouldNotQuarantine" : {
      "comment" : "Warning shown when a downloaded file could not be quarantined or removed; %@ is the file path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei unter „%@“ konnte nicht unter Quarantäne gestellt oder gelöscht werden! Sie ist gefährlich und sollte entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file at “%@” could not be quarantined or deleted! It is dangerous and should be removed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にあるファイルを隔離または削除できませんでした！このファイルは危険なため、削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 있는 파일을 격리하거나 삭제할 수 없습니다! 위험한 파일이므로 제거해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo em “%@” não pôde ser posto em quarentena nem apagado! Ele é perigoso e deve ser removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» не удалось поместить в карантин или удалить! Он опасен, и его следует удалить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”处的文件无法隔离或删除！它很危险，应将其移除。"
          }
        }
      }
    },
