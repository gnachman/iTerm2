        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 세션이 예기치 않게 종료되었거나 앱이 오작동하여 브래킷 붙여넣기가 켜진 채로 남아 있는 것 같습니다. 끄겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que o modo de colagem entre colchetes ficou ativado quando uma sessão ssh terminou inesperadamente ou um app se comportou mal. Desativá-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, режим скобок вставки остался включённым после неожиданного завершения SSH-сессии или сбоя приложения. Отключить его?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
