    "SessionPicker.StopIconHint" : {
      "comment" : "Help text shown in the session picker explaining the stop icon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na ikonu zastavení ukončíte režim výběru bez provedení výběru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på stopsymbolet for at afslutte vælgertilstanden uden at foretage et valg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf das Stopp-Symbol, um den Auswahlmodus zu verlassen, ohne eine Auswahl zu treffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Click the stop icon exit picker mode without making a selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el icono de detener para salir del modo de selección sin elegir nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistu valintatilasta valitsematta mitään klikkaamalla pysäytyskuvaketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur l’icône d’arrêt pour quitter le mode de sélection sans rien choisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sull’icona di stop per uscire dalla modalità di selezione senza scegliere nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止アイコンをクリックすると、選択せずにピッカーモードを終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택하지 않고 선택기 모드를 종료하려면 중단 아이콘을 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på stoppsymbolet for å avslutte velgermodus uten å gjøre et valg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op het stopsymbool om de kiesmodus te verlaten zonder een selectie te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij ikonę zatrzymania, aby wyjść z trybu wybierania bez dokonywania wyboru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique no ícone de parar para sair do modo de seleção sem fazer uma escolha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните значок остановки, чтобы выйти из режима выбора без выбора элемента."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na ikonu zastavenia ukončíte režim výberu bez vybratia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite ikono za ustavitev, da zapustite način izbiranja brez izbora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på stoppsymbolen för att lämna väljarläget utan att göra en markering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçim yapmadan seçici modundan çıkmak için durdur simgesine tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm biểu tượng dừng để thoát chế độ chọn mà không chọn gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按停止图标可退出选取器模式，不进行任何选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下停止圖像即可結束選取模式，不做任何選取。"
          }
        }
      }
    },
