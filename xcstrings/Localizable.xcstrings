    "Tip.0073.Body" : {
      "comment" : "Tip of the day body, id 0073",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K oknům terminálu můžete přidat konfigurovatelný stavový řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan tilføje en konfigurerbar statuslinje til dine terminalvinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihren Terminalfenstern eine konfigurierbare Statusleiste hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can add a configurable status bar to your terminal windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir una barra de estado configurable a tus ventanas de terminal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit lisätä päätteen ikkunoihin määritettävän tilapalkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ajouter une barre d’état configurable à vos fenêtres de terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere una barra di stato configurabile alle finestre del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルウィンドウに設定可能なステータスバーを追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 윈도우에 구성 가능한 상태 막대를 추가할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan legge til en konfigurerbar statuslinje i terminalvinduene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een configureerbare statusbalk aan je terminalvensters toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do okien terminala możesz dodać konfigurowalny pasek stanu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode adicionar uma barra de status configurável às suas janelas de terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете добавить настраиваемую строку состояния в окна терминала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do okien terminálu môžete pridať nastaviteľnú stavovú lištu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalskim oknom lahko dodate nastavljivo vrstico stanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan lägga till ett konfigurerbart statusfält i dina terminalfönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal pencerelerinize yapılandırılabilir bir durum çubuğu ekleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể thêm thanh trạng thái có thể cấu hình vào các cửa sổ terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
