    "ChatClient.RevealAnnotationHint" : {
      "comment" : "Hint appended to a chat message explaining how to reveal terminal annotations",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSie können auf einen Link in dieser Nachricht oder auf eine gelbe Unterstreichung im Terminal klicken, um eine Kommentierung anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nYou can click on a link in this message or on a yellow underline in the terminal to reveal an annotation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPuedes hacer clic en un enlace de este mensaje o en un subrayado amarillo de la terminal para mostrar una anotación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVous pouvez cliquer sur un lien dans ce message ou sur un soulignement jaune dans le terminal pour afficher une annotation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPuoi fare clic su un link in questo messaggio o su una sottolineatura gialla nel terminale per mostrare un’annotazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nこのメッセージ内のリンク、またはターミナル内の黄色い下線をクリックすると、注釈が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n이 메시지의 링크나 터미널의 노란색 밑줄을 클릭하면 주석을 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVocê pode clicar em um link nesta mensagem ou em um sublinhado amarelo no terminal para revelar uma anotação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nВы можете щёлкнуть по ссылке в этом сообщении или по жёлтому подчёркиванию в терминале, чтобы показать аннотацию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBir ek açıklamayı göstermek için bu iletideki bir bağlantıya veya terminaldeki sarı bir alt çizgiye tıklayabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n你可以点击这条消息中的链接，或点击终端中的黄色下划线来显示注释。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n你可以按一下此訊息中的連結，或按一下終端機中的黃色底線來顯示註解。"
          }
        }
      }
    },
