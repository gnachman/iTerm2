    "AdvancedSetting.fallbackLCCType" : {
      "comment" : "Advanced setting: fallbackLCCType",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota, na kterou nastavit LC_CTYPE, pokud kombinace země a jazyka počítače není podporována.\nPokud není nastaveno, použije se kódování (např. UTF-8)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdi, LC_CTYPE sættes til, hvis maskinens kombination af land og sprog ikke understøttes.\nHvis den ikke er angivet, bruges tegnkodningen (f.eks. UTF-8)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wert, auf den LC_CTYPE gesetzt wird, wenn die Kombination aus Land und Sprache des Rechners nicht unterstützt wird.\nWenn nicht gesetzt, wird die Kodierung (z. B. UTF-8) verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Value to set LC_CTYPE to if the machine‘s combination of country and language are not supported.\nIf unset, the encoding (e.g., UTF-8) will be used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor al que definir LC_CTYPE si no se admite la combinación de país e idioma del equipo.\nSi no se define, se usará la codificación (p. ej., UTF-8)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvo, johon LC_CTYPE asetetaan, jos koneen maan ja kielen yhdistelmää ei tueta.\nJos tätä ei ole asetettu, käytetään merkistökoodausta (esim. UTF-8)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur à donner à LC_CTYPE si la combinaison pays/langue de la machine n’est pas prise en charge.\nSi non défini, l’encodage (par ex. UTF-8) est utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valore a cui impostare LC_CTYPE se la combinazione di paese e lingua del computer non è supportata.\nSe non impostato, verrà usata la codifica (ad es. UTF-8)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マシンの国と言語の組み合わせがサポートされていない場合に LC_CTYPE に設定する値。\n未設定の場合、エンコーディング (UTF-8 など) が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 국가 및 언어 조합이 지원되지 않을 때 LC_CTYPE에 설정할 값.\n설정하지 않으면 인코딩(예: UTF-8)이 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdi som LC_CTYPE settes til hvis maskinens kombinasjon av land og språk ikke støttes.\nHvis den ikke er angitt, brukes tekstkodingen (f.eks. UTF-8)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarde waarop LC_CTYPE wordt ingesteld als de combinatie van land en taal van de machine niet wordt ondersteund.\nAls dit niet is ingesteld, wordt de codering (bijv. UTF-8) gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartość, na którą ustawić LC_CTYPE, jeśli kombinacja kraju i języka komputera nie jest obsługiwana.\nJeśli nieustawione, zostanie użyte kodowanie (np. UTF-8)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor para definir LC_CTYPE se a combinação de país e idioma da máquina não for suportada.\nSe não definido, a codificação (p. ex., UTF-8) será usada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение для LC_CTYPE, если сочетание страны и языка компьютера не поддерживается.\nЕсли не задано, будет использована кодировка (например, UTF-8)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnota, na ktorú sa nastaví LC_CTYPE, ak kombinácia krajiny a jazyka počítača nie je podporovaná.\nAk nie je nastavená, použije sa kódovanie (napr. UTF-8)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednost, na katero nastaviti LC_CTYPE, če kombinacija države in jezika računalnika ni podprta.\nČe ni nastavljena, bo uporabljeno kodiranje (npr. UTF-8)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värde att ange för LC_CTYPE om maskinens kombination av land och språk inte stöds.\nOm det inte är angivet används kodningen (t.ex. UTF-8)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makinenin ülke ve dil birleşimi desteklenmiyorsa LC_CTYPE için ayarlanacak değer.\nAyarlanmazsa kodlama (örn. UTF-8) kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị đặt cho LC_CTYPE nếu tổ hợp quốc gia và ngôn ngữ của máy không được hỗ trợ.\nNếu không đặt, mã hóa (ví dụ UTF-8) sẽ được dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当机器的国家/地区与语言组合不受支持时，应设置的LC_CTYPE值。\n如果未设置该值，则会使用默认编码（例如UTF-8）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果電腦的國家與語言組合不受支援，要設定給 LC_CTYPE 的值。\n未設定時，將使用編碼（例如 UTF-8）。"
          }
        }
      }
    },
