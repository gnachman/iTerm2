    "NaggingController.ArrangementProfileCorrupted" : {
      "comment" : "Announcement that a saved arrangement’s profile is missing due to a known bug",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil tohoto uspořádání chybí. Může to být způsobeno chybou v iTerm2 verze 3.5.7, která poškozovala profily v uložených uspořádáních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne opstillings profil mangler. Det kan skyldes en fejl i iTerm2 version 3.5.7, som beskadigede profiler i gemte opstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil dieser Anordnung fehlt. Dies könnte an einem Fehler in iTerm2 Version 3.5.7 liegen, der dazu führte, dass Profile in gespeicherten Anordnungen beschädigt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This arrangement’s profile is missing. This could be due to a bug in iTerm2 version 3.5.7, which caused profiles to be corrupted in saved arrangements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el perfil de esta disposición. Esto podría deberse a un error en la versión 3.5.7 de iTerm2, que provocaba que los perfiles se dañaran en las disposiciones guardadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän järjestelyn profiili puuttuu. Syynä voi olla iTerm2-version 3.5.7 virhe, joka vioitti profiileja tallennetuissa järjestelyissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil de cette disposition est manquant. Cela peut être dû à un bug de la version 3.5.7 d’iTerm2, qui corrompait les profils dans les dispositions enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo di questa disposizione non esiste. Potrebbe dipendere da un bug di iTerm2 versione 3.5.7 che causava il danneggiamento dei profili nelle disposizioni salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアレンジメントのプロファイルが見つかりません。これはiTerm2バージョン3.5.7のバグが原因で、保存されたアレンジメント内のプロファイルが破損した可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 윈도우 배치의 프로파일이 없습니다. iTerm2 버전 3.5.7의 버그로 인해 저장된 윈도우 배치의 프로파일이 손상되었기 때문일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilen til dette oppsettet mangler. Det kan skyldes en feil i iTerm2 versjon 3.5.7, som førte til at profiler ble skadet i lagrede oppsett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het profiel van deze indeling ontbreekt. Dit kan komen door een bug in iTerm2 versie 3.5.7, waardoor profielen in bewaarde indelingen beschadigd raakten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje profilu tego układu. Może to być spowodowane błędem w iTerm2 w wersji 3.5.7, który uszkadzał profile w zapisanych układach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil desta disposição está ausente. Isso pode ser devido a um bug na versão 3.5.7 do iTerm2, que fazia com que os perfis ficassem corrompidos em disposições salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль этой раскладки отсутствует. Это может быть связано с ошибкой в iTerm2 версии 3.5.7, из-за которой профили в сохранённых раскладках повреждались."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil tohto usporiadania chýba. Môže to byť spôsobené chybou vo verzii iTerm2 3.5.7, ktorá poškodzovala profily v uložených usporiadaniach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil te razporeditve manjka. To je lahko posledica napake v različici 3.5.7 aplikacije iTerm2, zaradi katere so bili profili v shranjenih razporeditvah poškodovani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här arrangemangets profil saknas. Det kan bero på ett fel i iTerm2 version 3.5.7 som gjorde att profiler skadades i sparade arrangemang."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu düzenin profili eksik. Bunun nedeni, kayıtlı düzenlerde profillerin bozulmasına yol açan iTerm2 3.5.7 sürümündeki bir hata olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ của bố cục này bị thiếu. Có thể do lỗi trong iTerm2 phiên bản 3.5.7 khiến hồ sơ bị hỏng trong các bố cục đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗口布局对应的配置文件缺失。这可能是 iTerm2 3.5.7 版的一个 bug 所致，该版本会导致已保存布局中的配置文件损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此排列的描述檔遺失。這可能是 iTerm2 3.5.7 版的錯誤所致，該錯誤會導致已儲存排列中的描述檔損毀。"
          }
        }
      }
    },
