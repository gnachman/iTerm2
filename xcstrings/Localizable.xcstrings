    "Tip.0084.Body" : {
      "comment" : "Tip of the day body, id 0084",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vylepšete svůj příkazový řádek pomocí „automatického editoru příkazů“, který příkazový řádek nahradí nativním ovládacím prvkem pro snazší používání. Vyžaduje integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedr din kommandolinje med den “automatiske kommandoeditor”, som erstatter kommandolinjen med et native kontrolelement, der er nemt at bruge. Kræver shell-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessern Sie Ihre Befehlszeile mit dem „Auto-Composer“, der die Befehlszeile durch ein natives Steuerelement zur einfacheren Nutzung ersetzt. Erfordert Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improve your command line with the “auto composer”, which replaces the command line with a native control for ease of use. Requires shell integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora tu línea de comandos con el “compositor automático”, que reemplaza la línea de comandos por un control nativo para mayor comodidad. Requiere la integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paranna komentoriviäsi ”automaattisella komentoeditorilla”, joka korvaa komentorivin natiivilla säätimellä käytön helpottamiseksi. Vaatii komentotulkki-integraation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliorez votre ligne de commande avec le « compositeur automatique », qui remplace la ligne de commande par un contrôle natif plus pratique. Nécessite l’intégration du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliora la tua riga di comando con il “compositore automatico”, che sostituisce la riga di comando con un controllo nativo per maggiore comodità. Richiede l’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オートコンポーザー」でコマンドラインを改善しましょう。コマンドラインをネイティブのコントロールに置き換え、使いやすくします。シェル統合が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령행을 사용하기 쉬운 기본 컨트롤로 대체하는 “자동 컴포저”로 명령행을 개선해 보십시오. 셸 통합이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedre kommandolinjen din med «Automatisk kommandoskriver», som erstatter kommandolinjen med en innebygd kontroll som er enklere å bruke. Krever skallintegrering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbeter je opdrachtregel met de ‘automatische opsteller’, die de opdrachtregel vervangt door een native besturingselement voor gebruiksgemak. Vereist shell-integratie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulepsz swój wiersz poleceń dzięki „automatycznemu edytorowi poleceń”, który zastępuje wiersz poleceń natywną kontrolką dla większej wygody. Wymaga integracji z powłoką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua linha de comando com o “auto compositor”, que substitui a linha de comando por um controle nativo para facilitar o uso. Requer o Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшите работу с командной строкой с помощью «автокомпозера», который заменяет командную строку нативным элементом управления для удобства использования. Требует интеграции с оболочкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vylepšite svoj príkazový riadok pomocou „automatického editora príkazov“, ktorý nahradí príkazový riadok natívnym ovládacím prvkom pre jednoduchšie použitie. Vyžaduje integráciu shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izboljšajte svojo ukazno vrstico s »samodejnim urejevalnikom ukazov«, ki ukazno vrstico nadomesti z izvornim kontrolnikom za lažjo uporabo. Zahteva integracijo lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förbättra din kommandorad med den ”automatiska kommandoredigeraren”, som ersätter kommandoraden med en inbyggd kontroll för enklare användning. Kräver skalintegrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut satırını kolay kullanım için yerel bir denetimle değiştiren “otomatik oluşturucu” ile komut satırınızı geliştirin. Kabuk entegrasyonu gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cải thiện dòng lệnh của bạn với “trình soạn lệnh tự động”, thay dòng lệnh bằng một điều khiển gốc để dễ sử dụng. Yêu cầu tích hợp shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“自动 composer”改进你的命令行，该工具用原生控件替代命令行，便于使用。需要shell集成功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「自動編寫器」改善你的命令列，它會以原生控制項取代命令列，使用起來更輕鬆。需要 Shell 整合。"
          }
        }
      }
    },
