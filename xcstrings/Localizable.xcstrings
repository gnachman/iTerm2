    "ExpressionParser.ReferenceToUndefinedVariable" : {
      "comment" : "Error when referencing an undefined variable; both placeholders are the variable path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkaz na nedefinovanou proměnnou „%1$@“. Změňte jej na „%2$@?“, aby se nedefinovaná hodnota považovala za null."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
