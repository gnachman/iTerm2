    "Tip.0091.Body" : {
      "comment" : "Tip of the day body, id 0091",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provádějte řadu akcí v pořadí jednou zkratkou pomocí přiřazení kláves typu „sekvence“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udfør en række handlinger i rækkefølge med én genvej ved hjælp af tastetildelinger af typen “sekvens”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie mit „Sequenz“-Tastenzuordnungen eine Reihe von Aktionen der Reihe nach mit einer einzigen Tastenkombination aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Execute a series of actions in order with a single shortcut using “sequence” key bindings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta una serie de acciones en orden con un solo atajo usando asignaciones de teclas de “secuencia”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorita sarja toimintoja järjestyksessä yhdellä oikotiellä ”sequence”-näppäinmäärityksillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez une série d’actions dans l’ordre avec un seul raccourci grâce aux associations de touches de type « séquence »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui una serie di azioni in ordine con una sola abbreviazione usando le associazioni tasti di “sequenza”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「シーケンス」キーバインディングを使うと、1つのショートカットで一連のアクションを順番に実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“sequence” 키 바인딩을 사용하면 하나의 단축키로 일련의 동작을 순서대로 실행할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utfør en serie handlinger i rekkefølge med én enkelt snarvei ved hjelp av «sekvens»-tastetilordninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een reeks acties op volgorde uit met één toetscombinatie met toetstoewijzingen van het type ‘reeks’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykonuj serię akcji po kolei jednym skrótem za pomocą przypisań klawiszy typu „sekwencja”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Execute uma série de ações em ordem com um único atalho usando atalhos de teclado de “sequência”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняйте серию действий по порядку одним сочетанием клавиш с помощью «последовательных» привязок клавиш."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykonajte sériu akcií v poradí jednou skratkou pomocou priradení klávesov typu „sekvencia“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z dodelitvami tipk »zaporedje« izvedite vrsto dejanj po vrstnem redu z eno bližnjico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör en serie åtgärder i ordning med ett enda kortkommando med hjälp av tangentkopplingar av typen ”sekvens”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sıralı” tuş atamalarını kullanarak tek bir kısayolla bir dizi eylemi sırayla yürütün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thực thi một loạt tác vụ theo thứ tự chỉ bằng một phím tắt, dùng gán phím “chuỗi”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“sequence”按键绑定，通过单一快捷键按顺序执行一系列操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「序列」按鍵對應，以單一快速鍵依序執行一連串動作。"
          }
        }
      }
    },
