    "Tip.0000.Body" : {
      "comment" : "Tip of the day body, id 0000",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die große neue Funktion von iTerm2 Version 3 ist die Shell-Integration. Klicken Sie auf „Mehr erfahren“ für alle Details."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The big new feature of iTerm2 version 3 is Shell Integration. Click “Learn More” for all the details."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 バージョン 3 の大きな新機能はシェル統合です。詳細については「詳しく見る」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 버전 3의 가장 큰 새 기능은 셸 통합입니다. 자세한 내용은 “더 알아보기”를 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O grande novo recurso da versão 3 do iTerm2 é a Shell Integration. Clique em “Saiba mais” para todos os detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главной новой функцией iTerm2 версии 3 является Shell Integration. Нажмите «Подробнее», чтобы узнать больше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 版本3的全新重要功能是Shell集成。点击“了解更多”可获取所有细节。"
          }
        }
      }
    },
