        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopea säännöllisten lausekkeiden arviointi käynnistimille.\nTämä on kokeellinen, koska se voi muuttaa säännöllisten lausekkeiden tulkintaa."
