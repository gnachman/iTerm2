        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить выполнение действия первого подходящего правила Smart Selection по cmd-щелчку?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command-tıklamada eşleşen ilk Akıllı Seçim eylemini gerçekleştirme devre dışı bırakılsın mı?"
          }
