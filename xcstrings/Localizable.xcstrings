    },
    "AIModelList.HTTPError" : {
      "comment" : "Error shown by Fetch Models in the AI model editor when the server answers with an HTTP error; first placeholder is the model-listing URL, second is the numeric HTTP status code",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat den HTTP-Status %2$lld zurückgegeben. Der Server unterstützt das Auflisten von Modellen möglicherweise nicht oder erfordert eine Authentifizierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ returned HTTP status %2$lld. The server may not support listing models, or may need authentication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ devolvió el estado HTTP %2$lld. Puede que el servidor no admita listar modelos o que requiera autenticación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a renvoyé l’état HTTP %2$lld. Le serveur ne prend peut-être pas en charge la liste des modèles, ou exige une authentification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha restituito lo stato HTTP %2$lld. Il server potrebbe non supportare l’elenco dei modelli o richiedere l’autenticazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ がHTTPステータス %2$lld を返しました。サーバーがモデルの一覧表示に対応していないか、認証が必要な可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 HTTP 상태 %2$lld을(를) 반환했습니다. 서버가 모델 목록 조회를 지원하지 않거나 인증이 필요할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ retornou o status HTTP %2$lld. O servidor pode não oferecer suporte à listagem de modelos ou pode exigir autenticação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ вернул HTTP-статус %2$lld. Возможно, сервер не поддерживает получение списка моделей или требует аутентификации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ HTTP %2$lld durumunu döndürdü. Sunucu modelleri listelemeyi desteklemiyor olabilir veya kimlik doğrulaması gerekebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 返回了 HTTP 状态 %2$lld。服务器可能不支持列出模型，或者需要身份验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 回傳了 HTTP 狀態 %2$lld。伺服器可能不支援列出模型，或者需要驗證。"
          }
        }
      }
    },
    "AIModelList.NoModels" : {
      "comment" : "Error shown by Fetch Models in the AI model editor when the server's model list is empty or unreadable; %@ is the model-listing URL",
      "extractionState" : "extracted_with_value",
