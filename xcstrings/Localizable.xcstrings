    "LaunchServices.NotDefaultHandlerTitle" : {
      "comment" : "Alert title asking whether to make iTerm the default handler; %@ is the URL scheme",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm není výchozí aplikací pro %@. Chcete iTerm nastavit jako výchozí?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm er ikke standardprogrammet til %@. Vil du angive iTerm som standardprogram?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm ist nicht der Standard-Handler für %@. Möchten Sie iTerm als Standard-Handler festlegen?"
