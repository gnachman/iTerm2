          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačidlá v modálnych upozorneniach zobrazujú klávesové skratky.\nChýba vám Windows 95? Mne áno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumbi v modalnih opozorilih označujejo bližnjice na tipkovnici.\nVam manjka Windows 95? Meni ja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knappar i modala varningar visar kortkommandon.\nSaknar du Windows 95? Det gör jag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalıcı uyarılardaki düğmeler klavye kısayollarını gösterir.\nWindows 95’i özlüyor musunuz? Ben özlüyorum."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nút trong cảnh báo phương thức hiển thị phím tắt.\nBạn có nhớ Windows 95 không? Tôi thì có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模态警告中的按钮表示键盘快捷键。\n怀念Windows 95吗？我确实如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制回應警示中的按鈕會標示鍵盤快速鍵。\n你懷念 Windows 95 嗎？我很懷念。"
          }
        }
      }
    },
    "AdvancedSetting.allowDragOfTabIntoNewWindow" : {
      "comment" : "Advanced setting: allowDragOfTabIntoNewWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit přetažení panelu mimo jakýkoli existující řádek panelů a vytvořit tak nové okno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad, at en fane kan trækkes og slippes uden for enhver eksisterende fanelinje for at oprette et nyt vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass ein Tab außerhalb einer vorhandenen Tableiste abgelegt wird, um ein neues Fenster zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow a tab to be dragged and dropped outside any existing tab bar to create a new window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir arrastrar y soltar una pestaña fuera de cualquier barra de pestañas existente para crear una nueva ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli välilehden vetäminen ja pudottaminen minkä tahansa olemassa olevan välilehtipalkin ulkopuolelle uuden ikkunan luomiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettre de faire glisser un onglet hors de toute barre d’onglets existante pour créer une nouvelle fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti di trascinare e rilasciare un pannello fuori da qualsiasi barra dei pannelli esistente per creare una nuova finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを既存のタブバーの外にドラッグ＆ドロップして新しいウィンドウを作成できるようにする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 기존 탭 막대 밖으로 드래그 앤 드롭하여 새로운 윈도우를 만들 수 있도록 허용."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat at en fane dras og slippes utenfor alle eksisterende fanelinjer for å opprette et nytt vindu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta toe dat een tabblad buiten een bestaande tabbladbalk wordt neergezet om een nieuw venster te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól przeciągnąć kartę poza dowolny istniejący pasek kart i upuścić ją, aby utworzyć nowe okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que uma aba seja arrastada e solta fora de qualquer barra de abas existente para criar uma nova janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить перетаскивание вкладки за пределы существующей панели вкладок для создания нового окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť potiahnutie tabu mimo ľubovoľnej existujúcej lišty s tabmi a jeho pustenie na vytvorenie nového okna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovoli, da se zavihek povleče in spusti zunaj vseh obstoječih vrstic z zavihki, da se ustvari novo okno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt att en flik dras och släpps utanför alla befintliga flikfält för att skapa ett nytt fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sekmenin, mevcut herhangi bir sekme çubuğunun dışına sürüklenip bırakılarak yeni pencere oluşturmasına izin ver."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép kéo và thả một tab ra ngoài mọi thanh tab hiện có để tạo cửa sổ mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许将标签页拖到任何现有标签页栏之外以创建新窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許將標籤頁拖放到任何現有標籤頁列之外，以建立新視窗。"
          }
        }
      }
    },
