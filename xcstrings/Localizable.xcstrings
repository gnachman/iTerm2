      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiný proces se pokouší použít API iTerm2. API umožňuje skriptu ovládat iTerm2 a zobrazovat a měnit jeho obsah. Chcete připojení povolit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden proces forsøger at bruge iTerm2-API’en. API’en lader en instruks styre iTerm2 og se og ændre dens indhold. Vil du tillade forbindelsen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Prozess versucht, die iTerm2-API zu verwenden. Die API ermöglicht es einem Skript, iTerm2 zu steuern sowie dessen Inhalte anzuzeigen und zu ändern. Verbindung zulassen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another process is trying to use the iTerm2 API. The API allows a script to control iTerm2 and view and modify its contents. Allow the connection?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro proceso está intentando usar la API de iTerm2. La API permite que un script controle iTerm2 y vea y modifique su contenido. ¿Quieres permitir la conexión?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen prosessi yrittää käyttää iTerm2:n API:a. API sallii skriptin ohjata iTerm2:ta sekä katsella ja muokata sen sisältöä. Sallitaanko yhteys?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre processus tente d’utiliser l’API d’iTerm2. L’API permet à un script de contrôler iTerm2 et d’afficher et modifier son contenu. Autoriser la connexion ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro processo sta tentando di usare l’API di iTerm2. L’API consente a uno script di controllare iTerm2 e di visualizzarne e modificarne i contenuti. Consentire la connessione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のプロセスがiTerm2 APIを使用しようとしています。このAPIを使うと、スクリプトがiTerm2を制御し、その内容を表示・変更できます。接続を許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 프로세스가 iTerm2 API를 사용하려고 합니다. API를 사용하면 스크립트가 iTerm2를 제어하고 그 내용을 보고 수정할 수 있습니다. 연결을 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen prosess prøver å bruke iTerm2-API-et. API-et lar et skript styre iTerm2 og se og endre innholdet. Vil du tillate tilkoblingen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander proces probeert de iTerm2-API te gebruiken. Met de API kan een script iTerm2 bedienen en de inhoud ervan bekijken en wijzigen. Wil je de verbinding toestaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inny proces próbuje użyć API iTerm2. API pozwala skryptowi sterować iTerm2 oraz przeglądać i modyfikować jego zawartość. Pozwolić na połączenie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro processo está tentando usar a API do iTerm2. A API permite que um script controle o iTerm2 e visualize e modifique seu conteúdo. Permitir a conexão?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другой процесс пытается использовать API iTerm2. API позволяет скрипту управлять iTerm2, а также просматривать и изменять его содержимое. Разрешить подключение?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iný proces sa pokúša použiť API iTerm2. API umožňuje skriptu ovládať iTerm2 a zobrazovať a upravovať jeho obsah. Povoliť pripojenie?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drug proces poskuša uporabiti API iTerm2. API omogoča skriptu nadzor nad aplikacijo iTerm2 ter ogled in spreminjanje njene vsebine. Ali dovolite povezavo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan process försöker använda iTerm2:s API. API:et låter ett skript styra iTerm2 samt visa och ändra dess innehåll. Vill du tillåta anslutningen?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir işlem iTerm2 API’sini kullanmaya çalışıyor. API, bir betiğin iTerm2’yi denetlemesine ve içeriğini görüntüleyip değiştirmesine olanak tanır. Bağlantıya izin verilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tiến trình khác đang cố dùng API của iTerm2. API cho phép tập lệnh điều khiển iTerm2 và xem, sửa nội dung của nó. Cho phép kết nối?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个进程正在尝试使用 iTerm2 API。API 允许脚本控制 iTerm2 并查看和修改其内容。允许此连接吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個程序正在嘗試使用 iTerm2 API。API 允許腳本控制 iTerm2 並檢視和修改其內容。要允許此連線嗎？"
          }
        }
      }
    },
