    "NightlyBuild.OldWarning" : {
      "comment" : "Warning that the nightly build is over 30 days old",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Nightly Build ist über 30 Tage alt. Erwägen Sie ein baldiges Update: Möglicherweise leiden Sie gerade in seliger Unwissenheit unter schlimmen Fehlern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This nightly build is over 30 days old. Consider updating soon: you may be suffering from awful bugs in blissful ignorance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión nightly tiene más de 30 días. Considera actualizar pronto: puede que estés sufriendo errores terribles sin saberlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version nocturne date de plus de 30 jours. Pensez à la mettre à jour bientôt : vous souffrez peut-être de bugs terribles sans le savoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa build nightly ha più di 30 giorni. Valuta di aggiornare presto: potresti soffrire di bug terribili senza saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このNightly Buildは30日以上前のものです。ひどいバグに気づかないまま使っている可能性があるので、早めの更新を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 나이틀리 빌드는 30일이 넘었습니다. 곧 업데이트하는 것이 좋습니다. 모르는 사이에 심각한 버그를 겪고 있을 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão nightly tem mais de 30 dias. Considere atualizar em breve: você pode estar sofrendo com bugs terríveis sem saber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой ночной сборке больше 30 дней. Рекомендуем обновиться в ближайшее время: возможно, вы уже страдаете от ужасных ошибок, даже не подозревая об этом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gecelik sürüm 30 günden eski. Yakında güncellemeyi düşünün: bilmeden mutlu mutlu korkunç hatalarla uğraşıyor olabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 nightly 构建已超过 30 天。建议尽快更新：你可能在不知不觉中深受严重 bug 之苦。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 nightly 版本已超過 30 天。建議儘快更新：你可能正在不知不覺中受到嚴重錯誤的影響。"
          }
        }
      }
    },
