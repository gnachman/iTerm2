    "AdvancedSetting.idempotentTriggerModeRateLimit" : {
      "comment" : "Advanced setting: idempotentTriggerModeRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při vyhodnocování idempotentních spouštěčů v interaktivních aplikacích čekat mezi aktualizacemi tuto dobu (v sekundách).\nTím se omezuje dopad vyhodnocování spouštěčů na výkon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når idempotente udløsere evalueres i interaktive apps, ventes så længe (i sekunder) mellem opdateringer.\nDet begrænser ydelsespåvirkningen fra evaluering af udløsere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Auswertung idempotenter Trigger in interaktiven Anwendungen so lange (in Sekunden) zwischen Aktualisierungen warten.\nDies begrenzt die Auswirkung der Trigger-Auswertung auf die Leistung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When evaluating idempotent triggers in interactive apps, wait this long (in seconds) between updates.\nThis limits the performance impact of trigger evaluation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al evaluar disparadores idempotentes en apps interactivas, esperar este tiempo (en segundos) entre actualizaciones.\nEsto limita el impacto en el rendimiento de la evaluación de disparadores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun idempotentteja käynnistimiä arvioidaan interaktiivisissa sovelluksissa, odota näin kauan (sekunteina) päivitysten välillä.\nTämä rajoittaa käynnistinten arvioinnin suorituskykyvaikutusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de l’évaluation des déclencheurs idempotents dans les apps interactives, attendre cette durée (en secondes) entre les mises à jour.\nCela limite l’impact de l’évaluation des déclencheurs sur les performances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si valutano gli attivatori idempotenti nelle app interattive, attendi questo tempo (in secondi) tra un aggiornamento e l’altro.\nQuesto limita l’impatto sulle prestazioni della valutazione degli attivatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対話型アプリで冪等なトリガーを評価する際、更新の間にこの時間 (秒単位) だけ待機します。\nこれにより、トリガー評価によるパフォーマンスへの影響を制限します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화형 앱에서 멱등 트리거를 평가할 때 업데이트 사이에 이 시간(초)만큼 기다립니다.\n트리거 평가가 성능에 미치는 영향을 제한합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når idempotente utløsere evalueres i interaktive apper, vent så lenge (i sekunder) mellom oppdateringer.\nDette begrenser ytelsespåvirkningen av evaluering av utløsere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht bij het evalueren van idempotente triggers in interactieve apps zo lang (in seconden) tussen updates.\nDit beperkt de invloed van het evalueren van triggers op de prestaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy ocenie idempotentnych wyzwalaczy w aplikacjach interaktywnych czekaj tyle (w sekundach) między aktualizacjami.\nOgranicza to wpływ oceny wyzwalaczy na wydajność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao avaliar gatilhos idempotentes em apps interativos, aguarde este tempo (em segundos) entre atualizações.\nIsto limita o impacto de desempenho da avaliação de gatilhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При вычислении идемпотентных триггеров в интерактивных приложениях ждать это время (в секундах) между обновлениями.\nЭто ограничивает влияние вычисления триггеров на производительность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vyhodnocovaní idempotentných spúšťačov v interaktívnych apkách počkať medzi aktualizáciami toľko (v sekundách).\nTým sa obmedzí vplyv vyhodnocovania spúšťačov na výkon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vrednotenju idempotentnih sprožilcev v interaktivnih aplikacijah počakaj toliko časa (v sekundah) med posodobitvami.\nTo omeji vpliv vrednotenja sprožilcev na zmogljivost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid utvärdering av idempotenta utlösare i interaktiva appar, vänta så här länge (i sekunder) mellan uppdateringar.\nDetta begränsar prestandapåverkan av utlösarutvärderingen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkileşimli uygulamalarda eş güçlü tetikleyiciler değerlendirilirken güncellemeler arasında bu kadar (saniye) bekle.\nBu, tetikleyici değerlendirmesinin performans etkisini sınırlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đánh giá các trình kích hoạt luỹ đẳng trong ứng dụng tương tác, chờ khoảng thời gian này (tính bằng giây) giữa các lần cập nhật.\nĐiều này giới hạn tác động hiệu năng của việc đánh giá trình kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在交互式应用程序中评估幂等触发器时，更新之间需等待的时长（以秒为单位）。\n这有助于限制触发器评估对性能的影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在互動式 App 中評估冪等觸發器時，每次更新之間等待的時間（秒）。\n這可限制觸發器評估對效能的影響。"
          }
        }
      }
    },
    "AdvancedSetting.idleTimeSeconds" : {
      "comment" : "Advanced setting: idleTimeSeconds",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doba v sekundách, po které se relace považuje za nečinnou.\nPoužívá se k aktualizaci ikon a indikátoru aktivity v panelech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid i sekunder, før en session regnes som passiv.\nBruges til opdatering af symboler og aktivitetsindikator i faner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit in Sekunden, nach der eine Sitzung als inaktiv gilt.\nWird verwendet, um Symbole und die Aktivitätsanzeige in Tabs zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Time in seconds before a session is considered idle.\nUsed for updating icons and activity indicator in tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo en segundos antes de que una sesión se considere inactiva.\nSe usa para actualizar los iconos y el indicador de actividad de las pestañas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aika sekunteina, jonka jälkeen istunto katsotaan toimettomaksi.\nKäytetään välilehtien kuvakkeiden ja aktiivisuusilmaisimen päivittämiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée en secondes avant qu’une session soit considérée comme inactive.\nUtilisé pour la mise à jour des icônes et de l’indicateur d’activité dans les onglets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo in secondi prima che una sessione sia considerata inattiva.\nUsato per aggiornare le icone e l’indicatore di attività nei pannelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションがアイドルとみなされるまでの時間 (秒単位)。\nタブ内のアイコンとアクティビティインジケーターの更新に使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 유휴 상태로 간주하기까지의 시간(초).\n탭의 아이콘과 활동 표시기를 업데이트하는 데 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid i sekunder før en økt regnes som inaktiv.\nBrukes til å oppdatere symboler og aktivitetsindikator i faner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijd in seconden voordat een sessie als inactief wordt beschouwd.\nWordt gebruikt voor het bijwerken van symbolen en de activiteitsindicator in tabbladen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas w sekundach, po którym sesja jest uznawana za bezczynną.\nUżywany do aktualizacji ikon i wskaźnika aktywności na kartach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo em segundos antes de uma sessão ser considerada ociosa.\nUsado para atualizar ícones e o indicador de atividade nas abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время в секундах, по истечении которого сессия считается простаивающей.\nИспользуется для обновления значков и индикатора активности во вкладках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas v sekundách, po ktorom sa relácia považuje za nečinnú.\nPoužíva sa na aktualizáciu ikon a indikátora aktivity v tabech."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čas v sekundah, preden se seja šteje za nedejavno.\nUporablja se za posodabljanje ikon in kazalnika dejavnosti v zavihkih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid i sekunder innan en session anses inaktiv.\nAnvänds för att uppdatera symboler och aktivitetsindikator i flikar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturumun boşta sayılmasından önceki süre (saniye).\nSekmelerdeki simgeleri ve etkinlik göstergesini güncellemek için kullanılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian tính bằng giây trước khi một phiên được coi là không hoạt động.\nDùng để cập nhật biểu tượng và chỉ báo hoạt động trong tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话视为空闲前的秒数。\n用于更新标签页中的图标和活动指示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段被視為閒置之前的時間（秒）。\n用於更新標籤頁中的圖像和活動指示器。"
          }
        }
      }
    },
    "AdvancedSetting.ignoreHardNewlinesInURLs" : {
      "comment" : "Advanced setting: ignoreHardNewlinesInURLs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorovat pevné konce řádků při hledání URL a názvů souborů pro sémantickou historii.\nPokud pevný konec řádku nastane na konci řádku, ⌘-kliknutí neuvidí vše, dokud není toto nastavení zapnuto. Je to užitečné pro některé interaktivní aplikace. Zapnutím se z náhrad \\3 a \\4 odstraní konce řádků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer hårde linjeskift ved søgning efter URL’er og arkivnavne til Semantisk historik.\nHvis et hårdt linjeskift forekommer i slutningen af en linje, ser ⌘-klik ikke det hele, medmindre denne indstilling er slået til. Det er nyttigt for nogle interaktive programmer. Hvis du slår det til, fjernes linjeskift fra erstatningerne \\3 og \\4."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feste Zeilenumbrüche beim Suchen von URLs und Dateinamen für Semantic History ignorieren.\nWenn am Ende einer Zeile ein fester Zeilenumbruch steht, erkennt ⌘-Klick diesen nicht vollständig, sofern diese Einstellung nicht aktiviert ist. Dies ist für manche interaktive Anwendungen nützlich. Durch Aktivieren werden Zeilenumbrüche aus den Ersetzungen \\3 und \\4 entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ignore hard newlines for the purposes of locating URLs and file names for Semantic History.\nIf a hard newline occurs at the end of a line then ⌘-click will not see it all unless this setting is turned on. This is useful for some interactive applications. Turning this on will remove newlines from the \\3 and \\4 substitutions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorar los saltos de línea duros al localizar URL y nombres de archivo para el historial semántico.\nSi un salto de línea duro ocurre al final de una línea, ⌘-clic no la verá entera a menos que este ajuste esté activado. Es útil en algunas aplicaciones interactivas. Al activarlo se eliminan los saltos de línea de las sustituciones \\3 y \\4."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita kovat rivinvaihdot etsittäessä URL-osoitteita ja tiedostonimiä semanttista historiaa varten.\nJos kova rivinvaihto esiintyy rivin lopussa, ⌘-klikkaus ei näe koko tekstiä, ellei tämä asetus ole päällä. Tämä on hyödyllistä joissakin interaktiivisissa sovelluksissa. Sen käyttöönotto poistaa rivinvaihdot korvauksista \\3 ja \\4."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer les sauts de ligne durs pour la localisation des URL et des noms de fichiers dans l’historique sémantique.\nSi un saut de ligne dur se trouve en fin de ligne, ⌘-clic ne verra pas l’ensemble tant que ce réglage n’est pas activé. C’est utile pour certaines applications interactives. L’activer supprimera les sauts de ligne des substitutions \\3 et \\4."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignora gli a capo forzati per individuare URL e nomi file per la cronologia semantica.\nSe un a capo forzato si trova alla fine di una riga, ⌘-clic non vedrà tutto a meno che questa impostazione sia attiva. È utile per alcune applicazioni interattive. Attivandola, gli a capo vengono rimossi dalle sostituzioni \\3 e \\4."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セマンティック履歴で URL やファイル名を特定する際、ハード改行を無視します。\n行末にハード改行がある場合、この設定をオンにしない限り ⌘ クリックはそれをすべて認識しません。これは一部の対話型アプリケーションで役立ちます。これをオンにすると、\\3 と \\4 の置換から改行が取り除かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시맨틱 히스토리에서 URL과 파일 이름을 찾을 때 하드 줄바꿈을 무시합니다.\n줄 끝에 하드 줄바꿈이 있으면 이 설정을 켜지 않는 한 ⌘-클릭으로 전체를 인식하지 못합니다. 일부 대화형 응용 프로그램에서 유용합니다. 이 설정을 켜면 \\3 및 \\4 치환에서 줄바꿈이 제거됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer harde linjeskift når URL-er og filnavn for semantisk historikk skal finnes.\nHvis et hardt linjeskift forekommer på slutten av en linje, ser ikke ⌘-klikk hele teksten med mindre denne innstillingen er slått på. Dette er nyttig for enkelte interaktive apper. Når dette slås på, fjernes linjeskift fra erstatningene \\3 og \\4."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negeer harde regeleinden bij het zoeken naar URL’s en bestandsnamen voor Semantische geschiedenis.\nAls aan het einde van een regel een hard regeleinde staat, ziet ⌘-klik niet alles, tenzij deze instelling is ingeschakeld. Dit is handig voor sommige interactieve toepassingen. Als je dit inschakelt, worden regeleinden uit de vervangingen \\3 en \\4 verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoruj twarde znaki nowego wiersza przy wyszukiwaniu adresów URL i nazw plików dla historii semantycznej.\nJeśli twardy znak nowego wiersza występuje na końcu wiersza, ⌘-kliknięcie nie zobaczy całości, chyba że to ustawienie jest włączone. Przydatne w niektórych aplikacjach interaktywnych. Włączenie usunie znaki nowego wiersza z podstawień \\3 i \\4."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorar quebras de linha fixas para localizar URLs e nomes de arquivos no Semantic History.\nSe uma quebra de linha fixa ocorrer no fim de uma linha, o clique com ⌘ não a verá por completo a menos que este ajuste esteja ativado. Isto é útil para alguns aplicativos interativos. Ativar isto removerá quebras de linha das substituições \\3 e \\4."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игнорировать жёсткие переводы строк при поиске URL и имён файлов для Semantic History.\nЕсли жёсткий перевод строки находится в конце строки, ⌘-щелчок не увидит его полностью, если эта настройка не включена. Это полезно для некоторых интерактивных приложений. Включение этого удалит переводы строк из подстановок \\3 и \\4."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorovať pevné zalomenia riadkov pri hľadaní URL a názvov súborov pre Sémantickú históriu.\nAk pevné zalomenie nastane na konci riadka, ⌘-kliknutie nezachytí všetko, kým nie je toto nastavenie zapnuté. Užitočné pre niektoré interaktívne aplikácie. Zapnutím sa zo substitúcií \\3 a \\4 odstránia zalomenia riadkov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezri trde nove vrstice pri iskanju URL-jev in imen datotek za semantično zgodovino.\nČe se trda nova vrstica pojavi na koncu vrstice, ⌘-klik ne bo videl vsega, razen če je ta nastavitev vklopljena. To je uporabno za nekatere interaktivne aplikacije. Vklop odstrani nove vrstice iz zamenjav \\3 in \\4."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorera hårda nyrader när URL:er och filnamn för semantisk historik lokaliseras.\nOm en hård nyrad förekommer i slutet av en rad ser ⌘-klick inte hela texten om inte den här inställningen är aktiverad. Det är användbart för vissa interaktiva program. Om du aktiverar detta tas nyrader bort från ersättningarna \\3 och \\4."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamsal Geçmiş için URL’leri ve dosya adlarını bulurken kesin satır sonlarını yok say.\nSatır sonunda kesin bir satır sonu varsa bu ayar açık olmadıkça ⌘-tıklama tamamını görmez. Bu, bazı etkileşimli uygulamalar için yararlıdır. Bunu açmak \\3 ve \\4 yer değiştirmelerinden satır sonlarını kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua ký tự xuống dòng cứng khi xác định URL và tên tệp cho Lịch sử ngữ nghĩa.\nNếu có ký tự xuống dòng cứng ở cuối một dòng thì ⌘-bấm sẽ không thấy toàn bộ trừ khi bật cài đặt này. Điều này hữu ích với một số ứng dụng tương tác. Bật tùy chọn này sẽ loại bỏ ký tự xuống dòng khỏi các phép thay thế \\3 và \\4."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在语义历史中定位URL和文件名时，忽略硬换行符。\n如果行尾出现硬换行，除非开启此设置，否则按⌘-点击无法完整显示。这对某些交互式应用很有用。开启后，\\3和\\4替换将移除换行符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為語意歷史記錄尋找 URL 和檔名時，忽略硬換行。\n如果硬換行出現在一行的結尾，除非開啟此設定，否則按 ⌘ 並按一下時看不到完整內容。這對某些互動式 App 很有用。開啟後會從 \\3 和 \\4 的替換內容中移除換行。"
          }
        }
      }
    },
