          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera una contraseña aleatoria. Mantén pulsada Opción para usar solo caracteres alfanuméricos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo satunnainen salasana. Pidä optionäppäintä painettuna käyttääksesi vain kirjaimia ja numeroita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générer un mot de passe aléatoire. Maintenez Option pour n’utiliser que des caractères alphanumériques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera una password casuale. Tieni premuto Opzione per usare solo caratteri alfanumerici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランダムなパスワードを生成します。英数字のみを使用するにはOptionキーを押しながら実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "임의의 암호를 생성합니다. 영숫자만 사용하려면 Option 키를 누르고 있으십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
