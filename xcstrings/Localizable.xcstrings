    "PTYSession.SusLocaleWarning" : {
      "comment" : "Warning that a profile’s locale does not use UTF-8 while the profile does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozor! Tento profil používá vlastní národní prostředí, které jako kódování znaků nepoužívá UTF-8, ale váš profil UTF-8 *používá*. To může způsobit, že se chybová hlášení a text mimo ASCII zobrazí nesprávně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel! Denne profil bruger en tilpasset landestandard, der ikke bruger UTF-8 som tegnkodning, men din profil bruger *faktisk* UTF-8. Det kan få fejlmeddelelser og tekst uden for ASCII til at blive vist forkert."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung! Dieses Profil verwendet ein benutzerdefiniertes Gebietsschema, das nicht UTF-8 als Zeichenkodierung nutzt, aber Ihr Profil verwendet *tatsächlich* UTF-8. Dies kann dazu führen, dass Fehlermeldungen und Nicht-ASCII-Text falsch dargestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning! This profile uses a custom locale that doesn't use UTF-8 as its character encoding, but your profile *is* using UTF-8. This can cause error messages and non-ASCII text to appear wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Advertencia! Este perfil usa una configuración regional personalizada que no usa UTF-8 como codificación de caracteres, pero tu perfil *sí* usa UTF-8. Esto puede hacer que los mensajes de error y el texto no ASCII se muestren de forma incorrecta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoitus! Tämä profiili käyttää mukautettua alueasetusta, joka ei käytä merkistökoodauksena UTF-8:aa, mutta profiilisi *käyttää* UTF-8:aa. Tämä voi aiheuttaa sen, että virheilmoitukset ja muu kuin ASCII-teksti näkyvät väärin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention ! Ce profil utilise des paramètres régionaux personnalisés qui n’utilisent pas UTF-8 comme encodage des caractères, alors que votre profil utilise *bien* UTF-8. Cela peut provoquer un affichage incorrect des messages d’erreur et du texte non ASCII."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione! Questo profilo usa impostazioni locali personalizzate che non usano UTF-8 come codifica dei caratteri, ma il tuo profilo *usa* UTF-8. Questo può far apparire in modo errato i messaggi di errore e il testo non ASCII."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！このプロファイルは文字エンコーディングにUTF-8を使用しないカスタムロケールを使用していますが、あなたのプロファイルは*実際に*UTF-8を使用しています。これにより、エラーメッセージや非ASCII文字が正しく表示されないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고! 이 프로파일은 문자 인코딩으로 UTF-8을 사용하지 않는 사용자 지정 로케일을 사용하지만, 프로파일 자체는 UTF-8을 *사용하고 있습니다*. 이로 인해 오류 메시지와 비ASCII 텍스트가 잘못 표시될 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel! Denne profilen bruker en egendefinert språkinnstilling som ikke bruker UTF-8 som tegnkoding, men profilen din bruker *faktisk* UTF-8. Dette kan føre til at feilmeldinger og tekst som ikke er ASCII, vises feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op! Dit profiel gebruikt een aangepaste taalversie die geen UTF-8 als tekencodering gebruikt, maar je profiel gebruikt *wel* UTF-8. Hierdoor kunnen foutmeldingen en niet-ASCII-tekst er verkeerd uitzien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie! Ten profil używa niestandardowych ustawień regionalnych, które nie używają UTF-8 jako kodowania znaków, ale twój profil *używa* UTF-8. Może to powodować nieprawidłowe wyświetlanie komunikatów o błędach i tekstu spoza ASCII."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso! Este perfil usa uma configuração regional personalizada que não usa UTF-8 como codificação de caracteres, mas seu perfil *está* usando UTF-8. Isso pode fazer com que mensagens de erro e texto não ASCII apareçam incorretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание! Этот профиль использует собственную локаль, которая не использует UTF-8 в качестве кодировки символов, но ваш профиль *использует* UTF-8. Это может привести к неправильному отображению сообщений об ошибках и текста, не входящего в ASCII."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozor! Tento profil používa vlastné miestne nastavenia, ktoré nepoužívajú UTF-8 ako kódovanie znakov, ale váš profil UTF-8 *používa*. Môže to spôsobiť, že chybové hlásenia a text mimo ASCII sa budú zobrazovať nesprávne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozorilo! Ta profil uporablja po meri nastavljeno območno nastavitev, ki kot kodiranje znakov ne uporablja UTF-8, vaš profil pa UTF-8 *uporablja*. To lahko povzroči napačen prikaz sporočil o napakah in besedila, ki ni ASCII."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning! Den här profilen använder en anpassad språkinställning som inte använder UTF-8 som teckenkodning, men din profil använder *just* UTF-8. Det kan göra att felmeddelanden och text som inte är ASCII visas fel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı! Bu profil, karakter kodlaması olarak UTF-8 kullanmayan özel bir yerel ayar kullanıyor, ancak profiliniz UTF-8 kullanıyor. Bu, hata iletilerinin ve ASCII olmayan metnin yanlış görünmesine neden olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo! Hồ sơ này dùng thiết lập vùng tùy chỉnh không dùng UTF-8 làm mã hóa ký tự, nhưng hồ sơ của bạn *đang* dùng UTF-8. Điều này có thể khiến thông báo lỗi và văn bản không phải ASCII hiển thị sai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此配置文件使用的自定义语言环境不使用 UTF-8 作为字符编码，但你的配置文件*确实*使用 UTF-8。这可能导致错误消息和非 ASCII 文本显示异常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此描述檔使用的自訂語系並未使用 UTF-8 作為字元編碼，但你的描述檔*正在*使用 UTF-8。這可能導致錯誤訊息和非 ASCII 文字顯示異常。"
          }
        }
      }
    },
