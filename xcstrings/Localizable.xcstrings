    "Companion.PhoneApp.Body" : {
      "comment" : "Explanatory paragraph on the phone-app install screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párování propojí tento Mac s aplikací iTerm2 Buddy na vašem iPhonu. Nainstalujte ji nyní, pak se vraťte a pokračujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenkobling forbinder denne Mac med appen iTerm2 Buddy på din iPhone. Installer den nu, og kom derefter tilbage for at fortsætte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopplung verbindet diesen Mac mit der iTerm2-Buddy-App auf Ihrem iPhone. Installieren Sie sie jetzt und kehren Sie dann hierher zurück, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pairing connects this Mac to the iTerm2 Buddy app on your iPhone. Install it now, then come back and continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emparejamiento conecta este Mac con la app iTerm2 Buddy de tu iPhone. Instálala ahora y luego vuelve y continúa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parin muodostus yhdistää tämän Macin iPhonesi iTerm2 Buddy -sovellukseen. Asenna se nyt ja palaa sitten jatkamaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’association connecte ce Mac à l’app iTerm2 Buddy sur votre iPhone. Installez-la maintenant, puis revenez et continuez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’associazione collega questo Mac all’app iTerm2 Buddy sul tuo iPhone. Installala ora, poi torna qui e continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングにより、このMacがiPhone上のiTerm2 Buddyアプリと接続されます。今すぐインストールしてから、戻って続行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링하면 이 Mac이 iPhone의 iTerm2 Buddy 앱에 연결됩니다. 지금 앱을 설치한 다음 돌아와서 계속하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paring kobler denne Macen til iTerm2 Buddy-appen på iPhone. Installer den nå, og kom tilbake og fortsett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het koppelen wordt deze Mac verbonden met de app iTerm2 Buddy op je iPhone. Installeer de app nu en kom daarna terug om door te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parowanie łączy ten Mac z aplikacją iTerm2 Buddy na urządzeniu iPhone. Zainstaluj ją teraz, a potem wróć i kontynuuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pareamento conecta este Mac ao app iTerm2 Buddy no seu iPhone. Instale-o agora, depois volte e continue."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопряжение подключает этот Mac к приложению iTerm2 Buddy на вашем iPhone. Установите его сейчас, а затем вернитесь и продолжите."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Párovanie prepojí tento Mac s apkou iTerm2 Buddy na vašom iPhone. Nainštalujte ju teraz, potom sa vráťte a pokračujte."
          }
        },
        "sl" : {
