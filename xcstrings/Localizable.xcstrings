    "AdvancedSetting.webKitAdblockEnabled" : {
      "comment" : "Advanced setting: webKitAdblockEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout blokování reklam ve webovém prohlížeči?\nPokud je zapnuto, stáhne a použije pravidla blokování reklam z nakonfigurované URL."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå reklameblokering til i browseren?\nNår det er slået til, hentes og anvendes regler for reklameblokering fra den konfigurerede URL."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbeblockierung im Webbrowser aktivieren?\nWenn aktiviert, werden Werbeblockierregeln von der konfigurierten URL heruntergeladen und angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable ad blocking in the web browser?\nWhen enabled, downloads and applies ad blocking rules from the configured URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar el bloqueo de anuncios en el navegador web?\nCuando está activado, descarga y aplica reglas de bloqueo de anuncios desde la URL configurada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaanko mainosten esto käyttöön verkkoselaimessa?\nKun käytössä, lataa ja ottaa käyttöön mainostenestosäännöt määritetystä URLista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le blocage des publicités dans le navigateur web ?\nSi activé, télécharge et applique les règles de blocage des publicités depuis l’URL configurée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare il blocco delle pubblicità nel browser web?\nSe attivo, scarica e applica le regole di blocco delle pubblicità dall’URL configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webブラウザで広告ブロックを有効にしますか？\n有効にすると、設定されたURLから広告ブロックルールをダウンロードして適用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 브라우저에서 광고 차단을 켜겠습니까?\n켜면 구성된 URL에서 광고 차단 규칙을 다운로드하여 적용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver annonseblokkering i nettleseren?\nNår dette er aktivert, lastes annonseblokkeringsregler ned fra den konfigurerte URL-en og brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertentieblokkering in de webbrowser inschakelen?\nAls dit is ingeschakeld, worden regels voor advertentieblokkering gedownload van de ingestelde URL en toegepast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy włączyć blokowanie reklam w przeglądarce?\nGdy włączone, pobiera i stosuje reguły blokowania reklam ze skonfigurowanego URL-a."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar bloqueio de anúncios no navegador web?\nQuando ativado, baixa e aplica regras de bloqueio de anúncios da URL configurada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить блокировку рекламы в веб-браузере?\nЕсли включено, загружает и применяет правила блокировки рекламы с настроенного URL."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť blokovanie reklám vo webovom prehliadači?\nKeď je zapnuté, stiahne a použije pravidlá blokovania reklám z nastavenej URL."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se v spletnem brskalniku omogoči blokiranje oglasov?\nČe je omogočeno, prenese in uporabi pravila za blokiranje oglasov iz nastavljenega URL-ja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera annonsblockering i webbläsaren?\nNär det är aktiverat hämtas och tillämpas regler för annonsblockering från den konfigurerade URL:en."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web tarayıcısında reklam engelleme etkinleştirilsin mi?\nEtkinse yapılandırılan URL’den reklam engelleme kurallarını indirir ve uygular."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật chặn quảng cáo trong trình duyệt web?\nKhi bật, tải về và áp dụng các quy tắc chặn quảng cáo từ URL đã cấu hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在网页浏览器中启用广告拦截？\n当启用时，会下载并应用来自配置 URL 的广告拦截规则。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在瀏覽器中啟用廣告封鎖？\n啟用後，會從設定的 URL 下載並套用廣告封鎖規則。"
          }
        }
      }
    },
    "AdvancedSetting.webUserAgent" : {
      "comment" : "Advanced setting: webUserAgent",
