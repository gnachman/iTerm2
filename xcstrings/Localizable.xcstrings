          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso de ajuste alterado quando os ajustes são carregados de uma URL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение об изменённых настройках при загрузке настроек по URL-адресу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar bir URL’den yüklendiğinde, değişen ayar uyarısını bir daha gösterme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从URL加载设置时是否抑制更改设置警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
