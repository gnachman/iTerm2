    "AdvancedSetting.indicateBellsInDockBadgeLabel" : {
      "comment" : "Advanced setting: indicateBellsInDockBadgeLabel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
