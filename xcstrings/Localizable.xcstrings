    "Appearance.ExcludeFromDockWarning" : {
      "comment" : "Warning shown when the user excludes iTerm2 from the Dock and app switcher",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn iTerm2 aus dem Dock ausgeschlossen ist, können Sie über das Statusleistensymbol jederzeit zu den Einstellungen zurückkehren. Suchen Sie nach einem iTerm2-Symbol auf der rechten Seite Ihrer Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When iTerm2 is excluded from the dock, you can always get back to Preferences using the status bar item. Look for an iTerm2 icon on the right side of your menu bar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2をDockから除外した場合でも、ステータスバー項目を使って常に環境設定に戻ることができます。メニューバーの右側にあるiTerm2アイコンを探してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2를 Dock에서 제외해도 메뉴 막대의 상태 항목을 사용하여 언제든지 설정으로 돌아갈 수 있습니다. 메뉴 막대 오른쪽에서 iTerm2 아이콘을 찾으십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o iTerm2 é excluído do Dock, você sempre pode voltar aos Ajustes usando o item da barra de menus. Procure um ícone do iTerm2 no lado direito da sua barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если iTerm2 исключён из Dock, вы всегда сможете вернуться в настройки с помощью элемента строки состояния. Ищите значок iTerm2 в правой части строки меню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 iTerm2 从 Dock 中排除时，你始终可以通过状态栏项目回到“设置”。请查看菜单栏右侧的 iTerm2 图标。"
          }
