    "MigrationHelper.MoveOpenAIKeyMessage" : {
      "comment" : "Message asking whether to move the OpenAI API key into the keychain",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesunout API klíč OpenAI do svazku klíčů? Aktuálně je uložen v uživatelských předvolbách, což není tak bezpečné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du flytte OpenAI API-nøglen til nøgleringen? Den er i øjeblikket gemt i User Defaults, hvilket er mindre sikkert."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI-API-Schlüssel in den Schlüsselbund verschieben? Er wird derzeit in User Defaults gespeichert, was weniger sicher ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move OpenAI API key into the keychain? It is currently stored in User Defaults, which is not as secure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
