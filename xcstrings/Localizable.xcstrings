    "Tip.0039.Body" : {
      "comment" : "Tip of the day body, id 0039",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud máte nainstalovanou integraci shellu, můžete adresář označit hvězdičkou, aby zůstal vždy dole v nástroji Nedávné adresáře v pásu nástrojů. Klikněte pravým tlačítkem a zvolte „Zapnout/vypnout hvězdičku“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har shell-integration installeret, kan du give en mappe en stjerne for altid at have den nederst i værktøjet Seneste mapper i værktøjsbæltet. Højreklik, og vælg “Slå stjerne til/fra”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die Shell-Integration installiert haben, können Sie ein Verzeichnis „markieren“, damit es im Werkzeug „Zuletzt verwendete Verzeichnisse“ im Werkzeugkasten immer unten angezeigt wird. Klicken Sie mit der rechten Maustaste und wählen Sie „Markierung umschalten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you have Shell Integration installed, you can “star” a directory to keep it always at the bottom of the Recent Directories tool in the Toolbelt. Right click and choose “Toggle Star.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tienes instalada la integración con el shell, puedes marcar un directorio con una estrella para mantenerlo siempre al final de la herramienta Directorios recientes de la Caja de herramientas. Haz clic con el botón derecho y elige “Activar/desactivar estrella”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos komentotulkki-integraatio on asennettu, voit merkitä hakemiston tähdellä, jolloin se pysyy aina työkaluvyön Äskeiset hakemistot -työkalun alalaidassa. Klikkaa oikealla painikkeella ja valitse ”Tähti päälle/pois”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’intégration du shell est installée, vous pouvez mettre un répertoire en favori avec une étoile pour qu’il reste toujours en bas de l’outil Répertoires récents de la boîte à outils. Faites un clic droit et choisissez « Activer/désactiver l’étoile »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai installato l’integrazione shell, puoi contrassegnare con una stella una directory per tenerla sempre in fondo allo strumento Directory recenti nella Cassetta attrezzi. Fai clic con il tasto destro e scegli “Attiva/disattiva stella”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合をインストールしていれば、ディレクトリに「スター」を付けて、ツールベルトの最近使ったディレクトリツールの一番下に常に表示させておくことができます。右クリックして「スターの切り替え」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 설치되어 있으면 디렉토리에 “별표”를 표시하여 도구 벨트의 최근 디렉토리 도구 맨 아래에 항상 유지할 수 있습니다. 오른쪽 클릭한 다음 “별표 전환”을 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har skallintegrering installert, kan du sette en stjerne på en mappe for å holde den nederst i verktøyet Nylige mapper i Verktøybeltet. Høyreklikk og velg «Slå stjerne av/på»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je shell-integratie hebt geïnstalleerd, kun je een map een ster geven om die altijd onderaan de tool Recente mappen in de Gereedschapsriem te houden. Klik met de rechtermuisknop en kies ‘Schakel ster in/uit’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli masz zainstalowaną integrację z powłoką, możesz oznaczyć katalog gwiazdką, aby zawsze był na dole narzędzia Ostatnie katalogi w pasie narzędzi. Kliknij prawym przyciskiem i wybierz „Włącz/wyłącz gwiazdkę”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você tem a Shell Integration instalada, pode marcar um diretório com uma estrela para mantê-lo sempre na parte inferior da ferramenta Diretórios recentes na Caixa de ferramentas. Clique com o botão direito e escolha “Alternar estrela”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если у вас установлена интеграция с оболочкой, вы можете «пометить звёздочкой» каталог, чтобы он всегда оставался внизу инструмента «Недавние каталоги» на панели инструментов. Щёлкните правой кнопкой мыши и выберите «Переключить звёздочку»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak máte nainštalovanú integráciu shellu, adresár môžete označiť hviezdičkou, aby zostal vždy na konci nástroja Nedávne adresáre v Páse s nástrojmi. Kliknite pravým tlačidlom a zvoľte „Zapnúť/vypnúť hviezdičku“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če imate nameščeno integracijo lupine, lahko imenik označite z zvezdico, da vedno ostane na dnu orodja Nedavni imeniki v Pasu z orodji. Kliknite z desno tipko in izberite »Vklopi/izklopi zvezdico«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du har skalintegrering installerad kan du ”stjärnmärka” en katalog för att alltid ha den längst ned i verktyget Senaste kataloger i verktygsbältet. Högerklicka och välj ”Slå på/av stjärna”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu yüklüyse bir dizini Araç Kemeri’ndeki Son Dizinler aracının en altında sürekli kalması için “yıldızlayabilirsiniz”. Sağ tıklayıp “Yıldızı Aç/Kapat”ı seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đã cài đặt Tích hợp shell, bạn có thể gắn “sao” cho một thư mục để luôn giữ nó ở cuối công cụ Thư mục gần đây trong Đai công cụ. Bấm chuột phải và chọn “Bật/tắt dấu sao.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果安装了 Shell Integration，你可以给某个目录添加“星标”，这样该目录会始终出现在 Toolbelt 中“最近的目录”工具的底部。点击右键并选择“切换星标”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果安裝了 Shell 整合，你可以為目錄加上「星號」，讓它一律保持在工具帶「最近的目錄」工具的底部。按一下右鍵並選擇「切換星號」即可。"
          }
        }
      }
    },
