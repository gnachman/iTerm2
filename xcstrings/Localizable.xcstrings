          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, tout ce que vous tapez dans cet onglet est envoyé à toutes les sessions de cet onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
