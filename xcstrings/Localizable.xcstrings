    "TmuxWorkgroupAttacher.UnmatchedBody" : {
      "comment" : "Notification body when a workgroup found in a tmux session matches no local workgroup; %@ is the tmux session's name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace tmux „%@“ obsahuje pracovní skupinu, které neodpovídá žádná z vašich pracovních skupin, proto se její podokna zobrazí jako běžná podokna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-sessionen “%@” har en arbejdsgruppe, som ingen af dine arbejdsgrupper passer til, så dens ruder vises som almindelige ruder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die tmux-Sitzung „%@“ hat eine Arbeitsgruppe, auf die keine Ihrer Arbeitsgruppen passt, daher werden ihre Bereiche als normale Bereiche angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "tmux session “%@” has a workgroup that none of your workgroups match, so its panes are shown as ordinary panes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de tmux “%@” tiene un grupo de trabajo que no coincide con ninguno de tus grupos de trabajo, por lo que sus paneles se muestran como paneles normales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-istunnossa ”%@” on työryhmä, joka ei vastaa yhtäkään työryhmääsi, joten sen paneelit näytetään tavallisina paneeleina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session tmux « %@ » contient un groupe de travail qui ne correspond à aucun de vos groupes de travail. Ses volets sont donc affichés comme des volets ordinaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione tmux “%@” ha un gruppo di lavoro che non corrisponde a nessuno dei tuoi gruppi di lavoro, quindi i suoi riquadri sono mostrati come riquadri normali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxセッション「%@」には、あなたのどのワークグループにも一致しないワークグループがあるため、そのペインは通常のペインとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 세션 “%@”에 사용자의 어떤 워크그룹과도 일치하지 않는 워크그룹이 있어 해당 패널을 일반 패널로 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-økten «%@» har en arbeidsgruppe som ingen av arbeidsgruppene dine passer med, så rutene vises som vanlige ruter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tmux-sessie ‘%@’ heeft een werkgroep die met geen van je werkgroepen overeenkomt, dus de panelen worden als gewone panelen getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja tmux „%@” ma grupę roboczą, do której nie pasuje żadna z twoich grup roboczych, więc jej panele są wyświetlane jako zwykłe panele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do tmux “%@” tem um grupo de trabalho que não corresponde a nenhum dos seus grupos de trabalho, por isso seus painéis são mostrados como painéis comuns."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В сессии tmux «%@» есть рабочая группа, которой не соответствует ни одна из ваших рабочих групп, поэтому её панели показаны как обычные панели."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácia tmux „%@“ obsahuje pracovnú skupinu, ktorej nezodpovedá žiadna z vašich pracovných skupín, preto sa jej panely zobrazujú ako bežné panely."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja tmux »%@« vsebuje delovno skupino, ki ne ustreza nobeni od vaših delovnih skupin, zato so njena podokna prikazana kot navadna podokna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-sessionen ”%@” har en arbetsgrupp som inte matchar någon av dina arbetsgrupper, så dess paneler visas som vanliga paneler."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” tmux oturumunda, çalışma gruplarınızın hiçbiriyle eşleşmeyen bir çalışma grubu var; bu yüzden bölmeleri normal bölmeler olarak gösteriliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên tmux “%@” có một nhóm làm việc không khớp với nhóm làm việc nào của bạn, nên các khung của nó được hiển thị như khung thông thường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 会话“%@”中有一个工作组与你的任何工作组都不匹配，因此其窗格显示为普通窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 工作階段「%@」中有一個工作群組，與你的任何工作群組都不符，因此其窗格會顯示為一般窗格。"
          }
        }
      }
    },
