    "DynamicProfiles.EntryNotObject" : {
      "comment" : "Error shown when an entry in a dynamic profiles file is not a dictionary; %@ is the file name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V souboru dynamických profilů %@ není položka v „Profiles“ objekt (tj. slovník), proto byla ignorována."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I arkivet med dynamiske profiler %@ er et emne i “Profiles” ikke et objekt (dvs. en ordbog), så det blev ignoreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Datei für dynamische Profile %@ ist ein Eintrag in „Profiles“ kein Objekt (d. h. kein Dictionary) und wurde daher ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In Dynamic Profiles file %@, an entry in “Profiles” is not an object (i.e., a dictionary), so it was ignored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el archivo de perfiles dinámicos %@, una entrada de “Profiles” no es un objeto (es decir, un diccionario), por lo que se ignoró."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynaamisten profiilien tiedostossa %@ yksi ”Profiles”-kohdan merkintä ei ole objekti (eli sanakirja), joten se ohitettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le fichier de profils dynamiques %@, une entrée de « Profiles » n’est pas un objet (c’est-à-dire un dictionnaire) et a donc été ignorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel file di profili dinamici %@, una voce di “Profiles” non è un oggetto (cioè un dizionario), quindi è stata ignorata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動的プロファイルファイル %@ で、「Profiles」内のエントリがオブジェクト (つまり辞書) ではないため、無視されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일 파일 %@에서 “Profiles”의 항목이 객체(즉, 딕셔너리)가 아니므로 무시되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I filen %@ for dynamiske profiler er en oppføring i «Profiles» ikke et objekt (altså en ordbok), så den ble ignorert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het bestand met dynamische profielen %@ is een onderdeel in ‘Profiles’ geen object (dus geen dictionary), daarom is het genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pliku profili dynamicznych %@ wpis w „Profiles” nie jest obiektem (czyli słownikiem), więc został zignorowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
