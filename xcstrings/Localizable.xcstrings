          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập lệnh được khởi chạy bởi thao tác của người dùng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由用户操作启动的脚本"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由使用者操作啟動的腳本"
