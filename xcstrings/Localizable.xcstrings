    "ProfilesAdvanced.TriggersHelpBrowser" : {
      "comment" : "Help text describing triggers in a browser session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spouštěče jsou akce, které nastavíte tak, aby se provedly při návštěvě určitých URL nebo při nalezení textu na webové stránce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløsere er handlinger, du konfigurerer til at køre, når bestemte URL’er besøges, eller tekst findes på en webside."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger sind Aktionen, die Sie so konfigurieren, dass sie ausgeführt werden, wenn bestimmte URLs besucht werden oder Text auf einer Webseite gefunden wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers are actions you configure to run when certain URLs are visited or text on a web page is found."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los disparadores son acciones que configuras para que se ejecuten cuando se visitan ciertas URLs o se encuentra texto en una página web."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistimet ovat toimintoja, jotka määrität suoritettaviksi, kun tiettyjä URL-osoitteita käydään tai verkkosivulta löytyy tiettyä tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclencheurs sont des actions que vous configurez pour s’exécuter lorsque certaines URLs sont visitées ou qu’un texte est trouvé sur une page web."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli attivatori sono azioni che configuri per essere eseguite quando vengono visitati determinati URL o viene trovato del testo in una pagina web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーとは、特定のURLにアクセスしたときやWebページ上でテキストが見つかったときに実行するよう設定できるアクションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 특정 URL을 방문하거나 웹 페이지에서 특정 텍스트를 발견했을 때 실행되도록 구성하는 동작입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløsere er handlinger du setter opp for å kjøre når bestemte URL-er besøkes eller tekst på en nettside blir funnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triggers zijn acties die je instelt om uit te voeren wanneer bepaalde URL’s worden bezocht of tekst op een webpagina wordt gevonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzwalacze to akcje, które uruchamiają się po odwiedzeniu określonych adresów URL lub znalezieniu tekstu na stronie internetowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gatilhos são ações que você configura para executar quando certos URLs são visitados ou um texto é encontrado em uma página web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггеры представляют собой действия, которые запускаются при посещении определённых URL-адресов или при обнаружении текста на веб-странице."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spúšťače sú akcie, ktoré nastavíte tak, aby sa spustili pri návšteve určitých URL alebo pri nájdení textu na webovej stránke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprožilci so dejanja, ki jih nastavite, da se izvedejo ob obisku določenih naslovov URL ali ko je na spletni strani najdeno besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utlösare är åtgärder som du ställer in att köras när vissa URL:er besöks eller text hittas på en webbsida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyiciler, belirli URL’ler ziyaret edildiğinde veya bir web sayfasında metin bulunduğunda çalışacak şekilde yapılandırdığınız eylemlerdir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình kích hoạt là các tác vụ bạn cấu hình để chạy khi truy cập một số URL nhất định hoặc tìm thấy văn bản trên trang web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器是你配置的操作，当访问特定 URL 或在网页上找到文本时运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發器是你設定的動作，會在造訪特定 URL 或在網頁上找到文字時執行。"
          }
        }
      }
    },
    "ProfilesAdvanced.TriggersHelpTerminal" : {
      "comment" : "Help text describing triggers in a terminal session",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spouštěče čekají, až do relace terminálu dorazí text odpovídající regulárnímu výrazu, a poté provedou příslušnou akci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløsere holder øje med, at tekst, der matcher et regulært udtryk, ankommer til en terminalsession, og udfører derefter en handling som svar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trigger überwachen eine Terminal-Sitzung auf Text, der einem regulären Ausdruck entspricht, und führen dann als Reaktion eine Aktion aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Triggers watch for text matching a regular expression to arrive in a terminal session and then perform an action in response."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los disparadores esperan a que llegue a una sesión de terminal un texto que coincida con una expresión regular y entonces realizan una acción en respuesta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistimet odottavat säännöllistä lauseketta vastaavan tekstin saapumista päätteen istuntoon ja suorittavat sitten toiminnon vastauksena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les déclencheurs surveillent l’arrivée dans une session de terminal d’un texte correspondant à une expression régulière, puis exécutent une action en réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli attivatori attendono che in una sessione del terminale arrivi un testo che corrisponde a un’espressione regolare e quindi eseguono un’azione in risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーは、正規表現に一致するテキストがターミナルセッションに届くのを監視し、それに応じてアクションを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거는 정규 표현식과 일치하는 텍스트가 터미널 세션에 도착하는지 감시하다가 그에 대한 응답으로 동작을 수행합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløsere venter på at tekst som samsvarer med et regulært uttrykk, kommer til en terminaløkt, og utfører deretter en handling som svar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triggers letten op tekst die overeenkomt met een reguliere expressie en in een terminalsessie binnenkomt, en voeren dan een actie uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzwalacze czekają, aż w sesji terminala pojawi się tekst pasujący do wyrażenia regularnego, a następnie wykonują w odpowiedzi akcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os gatilhos aguardam a chegada, em uma sessão de terminal, de um texto que corresponda a uma expressão regular e então executam uma ação em resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триггеры отслеживают появление в сессии терминала текста, соответствующего регулярному выражению, и в ответ выполняют действие."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spúšťače sledujú príchod textu zodpovedajúceho regulárnemu výrazu do relácie terminálu a potom vykonajú príslušnú akciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprožilci čakajo, da v terminalski seji prispe besedilo, ki ustreza regularnemu izrazu, in se nato odzovejo z dejanjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utlösare bevakar om text som matchar ett reguljärt uttryck kommer till en terminalsession och utför sedan en åtgärd som svar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyiciler, bir terminal oturumuna düzenli ifadeyle eşleşen bir metnin gelmesini bekler ve buna karşılık bir eylem gerçekleştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình kích hoạt theo dõi văn bản khớp với một biểu thức chính quy xuất hiện trong phiên terminal rồi thực hiện một tác vụ đáp lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触发器监视与正则表达式匹配的文本到达终端会话，然后执行相应的操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發器會監看符合正規表示式的文字何時出現在終端機工作階段中，然後執行對應的動作。"
          }
        }
      }
    },
