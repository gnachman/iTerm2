    "OrchestratorDispatcher.WatchScreenReadConsent" : {
      "comment" : "Body of a prompt asking the user to let an AI chat’s watch read a terminal session’s screen on a timer. The placeholder is the session’s name, such as -zsh. View Contents and Ask are the names of a setting and its value.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto sledování během čekání opakovaně čte obrazovku relace %@. Pro tuto relaci je volba „Zobrazit obsah“ nastavena na „Zeptat se“. Chcete toto čtení na pozadí povolit, dokud sledování neskončí?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne overvågning læser skærmen i %@ gentagne gange, mens den venter. Vis indhold er sat til Spørg for denne session. Vil du tillade denne baggrundslæsning, indtil overvågningen er færdig?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Überwachung liest den Bildschirm von %@ wiederholt, während sie wartet. „KI kann Inhalte anzeigen“ ist für diese Sitzung auf „Fragen“ gesetzt. Möchten Sie dieses Lesen im Hintergrund erlauben, bis die Überwachung endet?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This watch reads %@’s screen repeatedly while it waits. View Contents is set to Ask for this session, so allow this background reading until the watch finishes?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vigilancia lee repetidamente la pantalla de %@ mientras espera. “Ver contenido” está en “Preguntar” para esta sesión, así que ¿quieres permitir esta lectura en segundo plano hasta que termine la vigilancia?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä seuranta lukee istunnon %@ näyttöä toistuvasti odottaessaan. Asetuksen ”Näytä sisältö” arvo on tässä istunnossa ”Kysy”. Sallitaanko tämä taustalla tapahtuva lukeminen, kunnes seuranta päättyy?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette veille lit l’écran de %@ à intervalles réguliers pendant son attente. « L’IA peut voir le contenu » est réglé sur « Demander » pour cette session. Autoriser cette lecture en arrière-plan jusqu’à la fin de la veille ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sorveglianza legge ripetutamente lo schermo di %@ mentre è in attesa. “Visualizza contenuto” è impostato su “Chiedi” per questa sessione: vuoi consentire questa lettura in background finché la sorveglianza non termina?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この監視は、待機中に%@の画面を繰り返し読み取ります。このセッションでは「AI が内容を表示可能」が「毎回確認」に設定されています。監視が終了するまで、このバックグラウンドでの読み取りを許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 감시는 기다리는 동안 %@의 화면을 반복해서 읽습니다. 이 세션의 “내용 보기”가 “묻기”로 설정되어 있습니다. 감시가 끝날 때까지 이 백그라운드 읽기를 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne overvåkingen leser skjermen til %@ gjentatte ganger mens den venter. «Vis innhold» er satt til «Spør» for denne økten. Vil du tillate denne bakgrunnslesingen til overvåkingen er ferdig?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze bewaking leest herhaaldelijk het scherm van %@ terwijl ze wacht. ‘Toon inhoud’ staat voor deze sessie op ‘Vraag’. Wil je dit lezen op de achtergrond toestaan totdat de bewaking klaar is?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta obserwacja podczas oczekiwania wielokrotnie odczytuje ekran sesji %@. Dla tej sesji opcja „Wyświetl zawartość” jest ustawiona na „Pytaj”. Czy zezwolić na odczyt w tle do zakończenia obserwacji?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este monitoramento lê a tela de %@ repetidamente enquanto aguarda. “A IA pode ver o conteúdo” está definido como “Perguntar” para esta sessão. Permitir esta leitura em segundo plano até o monitoramento terminar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это наблюдение многократно считывает экран %@ во время ожидания. Для этого сеанса параметр «ИИ может просматривать содержимое» установлен в значение «Спрашивать». Разрешить это фоновое чтение до завершения наблюдения?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto sledovanie opakovane číta obrazovku relácie %@, kým čaká. Pre túto reláciu je „Zobraziť obsah“ nastavené na „Pýtať sa“. Povoliť toto čítanie na pozadí, kým sledovanie neskončí?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To opazovanje med čakanjem večkrat prebere zaslon seje %@. Za to sejo je »Ogled vsebine« nastavljen na »Vprašaj«. Želite dovoliti to branje v ozadju, dokler se opazovanje ne konča?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här bevakningen läser skärmen i %@ upprepade gånger medan den väntar. ”Visa innehåll” är inställt på ”Fråga” för den här sessionen. Vill du tillåta den här bakgrundsläsningen tills bevakningen är klar?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu izleme, beklerken %@ oturumunun ekranını tekrar tekrar okur. Bu oturum için İçeriği görüntüle ayarı Sor olarak belirlenmiş. İzleme bitene kadar bu arka plan okumasına izin verilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lượt theo dõi này đọc màn hình của %@ nhiều lần trong khi chờ. “Xem nội dung” được đặt là “Hỏi” cho phiên này, vì vậy bạn có muốn cho phép đọc nền này cho đến khi lượt theo dõi kết thúc không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此监视在等待期间会反复读取 %@ 的屏幕。此会话的“AI可以查看文件内容”设置为“询问”。是否允许在监视结束前进行这种后台读取？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此監看在等待期間會重複讀取 %@ 的螢幕。此工作階段的「檢視內容」設為「詢問」，要允許這項背景讀取直到監看結束嗎？"
          }
        }
      }
    },
