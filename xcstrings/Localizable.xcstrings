            "value" : "Показывать предпросмотр URL-адреса при наведении с Cmd для совпадений «Семантической истории»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť náhľad URL pri prechode myšou so ⌘ pre zhody sémantickej histórie."
          }
        },
        "sl" : {
          "stringUnit" : {
