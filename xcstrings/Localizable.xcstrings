    "AdvancedSetting.logTimestampFormat" : {
      "comment" : "Advanced setting: logTimestampFormat",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formát časových razítek v protokolu. Syntaxi najdete v Unicode TR 35-31.\nChcete-li změnu tohoto nastavení uplatnit, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Format for tidsstempler i loggen. Se Unicode TR 35-31 for syntaks.\nDu skal starte iTerm2 igen, for at ændringer af denne indstilling træder i kraft."
          }
        },
        "de" : {
