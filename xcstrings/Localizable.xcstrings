    "Tip.0067.Body" : {
      "comment" : "Tip of the day body, id 0067",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud používáte písmo podporující ligatury, můžete podporu ligatur zapnout v „Nastavení > Profily > Text“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du bruger en skrift, der understøtter ligaturer, kan du slå understøttelse af ligaturer til i Indstillinger > Profiler > Tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie eine Schriftart verwenden, die Ligaturen unterstützt, können Sie die Ligaturunterstützung unter „Einstellungen > Profile > Text“ aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you use a font that supports ligatures, you can enable ligature support in Settings > Profiles > Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usas un tipo de letra que admite ligaduras, puedes activar la compatibilidad con ligaduras en Ajustes > Perfiles > Texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos käytät fonttia, joka tukee ligatuureja, voit ottaa ligatuurituen käyttöön kohdassa Asetukset > Profiilit > Teksti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous utilisez une police qui prend en charge les ligatures, vous pouvez activer cette prise en charge dans Réglages > Profils > Texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usi un font che supporta le legature, puoi abilitarne il supporto in Impostazioni > Profili > Testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リガチャに対応したフォントを使っている場合は、設定 > プロファイル > テキストでリガチャのサポートを有効にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합자를 지원하는 서체를 사용하는 경우 설정 > 프로파일 > 텍스트에서 합자 지원을 켤 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du bruker en font som støtter ligaturer, kan du slå på støtte for ligaturer i «Innstillinger > Profiler > Tekst»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een lettertype gebruikt dat ligaturen ondersteunt, kun je ondersteuning voor ligaturen inschakelen in Instellingen > Profielen > Tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli używasz czcionki obsługującej ligatury, możesz włączyć obsługę ligatur w Ustawienia > Profile > Tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você usa uma fonte que suporta ligaduras, pode ativar o suporte a ligaduras em Ajustes > Perfis > Texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы используете шрифт с поддержкой лигатур, вы можете включить их поддержку в «Настройки > Профили > Текст»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak používate písmo, ktoré podporuje ligatúry, môžete zapnúť podporu ligatúr v časti „Nastavenia > Profily > Text“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če uporabljate pisavo, ki podpira ligature, lahko podporo za ligature omogočite v »Nastavitve > Profili > Besedilo«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du använder ett typsnitt som stöder ligaturer kan du aktivera ligaturstöd i Inställningar > Profiler > Text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitişik harfleri destekleyen bir font kullanıyorsanız Ayarlar > Profiller > Metin bölümünden bitişik harf desteğini etkinleştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn dùng phông chữ hỗ trợ chữ ghép, bạn có thể bật hỗ trợ chữ ghép trong Cài đặt > Hồ sơ > Văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您使用支持连字效果的字体，可以在设置中的“Profiles > Text”里启用连字支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你使用支援連字的字體，可以在「設定 > 描述檔 > 文字」中啟用連字支援。"
          }
        }
      }
    },
