    "ChatProviderBinding.ProviderMismatch" : {
      "comment" : "Error shown when the user tries to switch a chat to a model from a different AI provider",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento chat používá „%1$@“ a „%2$@“ patří jinému poskytovateli AI. Chat nemůže po zahájení konverzace změnit poskytovatele. Chcete-li použít „%3$@“, zahajte nový chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne chat bruger “%1$@”, og “%2$@” tilhører en anden AI-udbyder. En chat kan ikke skifte udbyder, når samtalen er startet. Start en ny chat for at bruge “%3$@”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Chat verwendet „%1$@“, und „%2$@“ gehört zu einem anderen KI-Anbieter. Ein Chat kann den Anbieter nach Beginn der Unterhaltung nicht mehr wechseln. Starten Sie einen neuen Chat, um „%3$@“ zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This chat uses “%1$@”, and “%2$@” belongs to a different AI provider. A chat cannot change providers once the conversation has started; start a new chat to use “%3$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat usa “%1$@”, y “%2$@” pertenece a otro proveedor de IA. Un chat no puede cambiar de proveedor una vez iniciada la conversación; inicia un chat nuevo para usar “%3$@”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä keskustelu käyttää mallia ”%1$@”, ja ”%2$@” kuuluu eri AI-palveluntarjoajalle. Keskustelun palveluntarjoajaa ei voi vaihtaa keskustelun alettua. Aloita uusi keskustelu käyttääksesi mallia ”%3$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce chat utilise « %1$@ », et « %2$@ » appartient à un autre fournisseur d’IA. Un chat ne peut pas changer de fournisseur une fois la conversation commencée ; démarrez un nouveau chat pour utiliser « %3$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa chat usa “%1$@”, e “%2$@” appartiene a un altro provider IA. Una chat non può cambiare provider dopo l’inizio della conversazione; avvia una nuova chat per usare “%3$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットは「%1$@」を使用しています。「%2$@」は別の AI プロバイダーに属しています。会話が開始された後はチャットのプロバイダーを変更できません。「%3$@」を使用するには新しいチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅은 “%1$@”을(를) 사용하며, “%2$@”은(는) 다른 AI 제공업체에 속합니다. 대화가 시작된 후에는 채팅의 제공업체를 변경할 수 없습니다. “%3$@”을(를) 사용하려면 새로운 채팅을 시작하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne chatten bruker «%1$@», og «%2$@» tilhører en annen KI-leverandør. En chat kan ikke bytte leverandør etter at samtalen har startet. Start en ny chat for å bruke «%3$@»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze chat gebruikt ‘%1$@’ en ‘%2$@’ hoort bij een andere AI-aanbieder. Een chat kan niet van aanbieder wisselen zodra het gesprek is begonnen. Begin een nieuwe chat om ‘%3$@’ te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten czat używa: „%1$@”, a „%2$@” należy do innego dostawcy AI. Czat nie może zmienić dostawcy po rozpoczęciu rozmowy. Rozpocznij nowy czat, aby użyć: „%3$@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat usa “%1$@”, e “%2$@” pertence a um provedor de IA diferente. Um chat não pode trocar de provedor depois que a conversa começa; inicie um novo chat para usar “%3$@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот чат использует «%1$@», а «%2$@» относится к другому поставщику ИИ. Чат не может сменить поставщика после начала беседы; чтобы использовать «%3$@», начните новый чат."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento chat používa model „%1$@“ a model „%2$@“ patrí inému poskytovateľovi AI. Po začatí konverzácie už chat nemôže zmeniť poskytovateľa; ak chcete použiť model „%3$@“, začnite nový chat."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta klepet uporablja »%1$@«, »%2$@« pa pripada drugemu ponudniku AI. Klepet ne more zamenjati ponudnika, ko se pogovor začne; za uporabo »%3$@« začnite nov klepet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här chatten använder ”%1$@”, och ”%2$@” tillhör en annan AI-leverantör. En chatt kan inte byta leverantör när konversationen har startat. Starta en ny chatt för att använda ”%3$@”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbet “%1$@” kullanıyor ve “%2$@” farklı bir YZ sağlayıcısına ait. Konuşma başladıktan sonra sohbetin sağlayıcısı değiştirilemez; “%3$@” kullanmak için yeni bir sohbet başlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộc trò chuyện này dùng “%1$@”, còn “%2$@” thuộc về một nhà cung cấp AI khác. Cuộc trò chuyện không thể đổi nhà cung cấp sau khi đã bắt đầu; hãy bắt đầu cuộc trò chuyện mới để dùng “%3$@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此聊天使用“%1$@”，而“%2$@”属于其他AI提供商。一旦对话开始，聊天无法更换提供商；请开始新对话以使用“%3$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此聊天使用「%1$@」，而「%2$@」屬於不同的 AI 供應商。對話開始後，聊天無法更換供應商；請開始新的聊天以使用「%3$@」。"
          }
        }
      }
    },
