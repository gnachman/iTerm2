    "InstanceLock.Message" : {
      "comment" : "Shown at launch when another instance of iTerm2 is already running. %d is a process ID.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiná kopie iTerm2 (ID procesu %d) už běží. Pokud dvě kopie používají stejné nastavení současně, mohou si navzájem přepsat předvolby a uložená okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden kopi af iTerm2 (proces-id %d) kører allerede. Hvis to kopier bruger de samme indstillinger på samme tid, kan de overskrive hinandens indstillinger og gemte vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Instanz von iTerm2 (Prozess-ID %d) läuft bereits. Wenn zwei Instanzen gleichzeitig dieselben Einstellungen verwenden, können sie gegenseitig ihre Einstellungen und gespeicherten Fenster überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another copy of iTerm2 (process ID %d) is already running. If two copies use the same settings at once, they can overwrite each other’s preferences and saved windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se está ejecutando otra copia de iTerm2 (ID de proceso %d). Si dos copias usan los mismos ajustes a la vez, pueden sobrescribirse mutuamente las preferencias y las ventanas guardadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2:n toinen kopio (prosessin tunnus %d) on jo käynnissä. Jos kaksi kopiota käyttää samoja asetuksia yhtä aikaa, ne voivat korvata toistensa asetukset ja tallennetut ikkunat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre copie d’iTerm2 (ID de processus %d) est déjà en cours d’exécution. Si deux copies utilisent les mêmes réglages en même temps, elles peuvent écraser mutuellement leurs préférences et leurs fenêtres enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra copia di iTerm2 (ID processo %d) è già in esecuzione. Se due copie usano le stesse impostazioni contemporaneamente, possono sovrascrivere a vicenda le preferenze e le finestre salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の iTerm2 (プロセス ID %d) がすでに実行中です。2 つの iTerm2 が同時に同じ設定を使用すると、互いの環境設定や保存されたウインドウを上書きする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 iTerm2(프로세스 ID %d)가 이미 실행 중입니다. 두 개의 iTerm2가 동시에 같은 설정을 사용하면 서로의 환경설정과 저장된 윈도우를 덮어쓸 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen kopi av iTerm2 (prosess-ID %d) kjører allerede. Hvis to kopier bruker de samme innstillingene samtidig, kan de overskrive hverandres innstillinger og lagrede vinduer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is al een andere kopie van iTerm2 geopend (proces-ID %d). Als twee kopieën tegelijk dezelfde instellingen gebruiken, kunnen ze elkaars voorkeuren en bewaarde vensters overschrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inna kopia iTerm2 (identyfikator procesu: %d) jest już uruchomiona. Jeśli dwie kopie używają tych samych ustawień jednocześnie, mogą nadpisywać nawzajem swoje preferencje i zapisane okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra cópia do iTerm2 (ID do processo %d) já está em execução. Se duas cópias usarem as mesmas configurações ao mesmo tempo, elas podem sobrescrever as preferências e as janelas salvas uma da outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая копия iTerm2 (идентификатор процесса %d) уже запущена. Если две копии одновременно используют одни и те же настройки, они могут перезаписать настройки и сохранённые окна друг друга."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iná kópia aplikácie iTerm2 (ID procesu %d) už je spustená. Ak dve kópie používajú rovnaké nastavenia súčasne, môžu si navzájom prepísať predvoľby a uložené okná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druga kopija aplikacije iTerm2 (ID procesa %d) je že zagnana. Če dve kopiji hkrati uporabljata iste nastavitve, lahko prepišeta druga drugi nastavitve in shranjena okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan kopia av iTerm2 (process-ID %d) körs redan. Om två kopior använder samma inställningar samtidigt kan de skriva över varandras inställningar och sparade fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin başka bir kopyası (işlem kimliği %d) zaten çalışıyor. İki kopya aynı ayarları aynı anda kullanırsa birbirlerinin tercihlerinin ve kayıtlı pencerelerin üzerine yazabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một bản sao khác của iTerm2 (ID tiến trình %d) đang chạy. Nếu hai bản sao dùng cùng cài đặt cùng lúc, chúng có thể ghi đè tùy chọn và cửa sổ đã lưu của nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 iTerm2 副本（进程 ID %d）已在运行。如果两个副本同时使用相同的设置，它们可能会相互覆盖偏好设置和已保存的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個 iTerm2 副本（程序 ID %d）已在執行中。如果兩個副本同時使用相同的設定，可能會互相覆寫偏好設定與已儲存的視窗。"
          }
        }
      }
    },
