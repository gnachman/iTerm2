    "AdvancedSetting.clearBellIconAggressively" : {
      "comment" : "Advanced setting: clearBellIconAggressively",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat ikonu zvonku, když se relace stane aktivní.\nPokud je vypnuto, musíte ikonu zvonku smazat psaním v relaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryd klokkesymbolet, når en session bliver aktiv.\nNår det er slået fra, skal du skrive i sessionen for at rydde klokkesymbolet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelsymbol löschen, wenn eine Sitzung aktiv wird.\nWenn deaktiviert, müssen Sie in der Sitzung tippen, um das Klingelsymbol zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clear bell icon when a session becomes active.\nWhen off, you must type in the session to clear the bell icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar el icono de campana cuando una sesión pasa a estar activa.\nSi está desactivado, debes escribir en la sesión para borrar el icono de campana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjennä äänimerkkikuvake, kun istunnosta tulee aktiivinen.\nKun tämä on pois päältä, äänimerkkikuvake tyhjennetään kirjoittamalla istuntoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer l’icône de sonnerie quand une session devient active.\nSi cette option est désactivée, vous devez saisir du texte dans la session pour effacer l’icône de sonnerie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella l’icona del campanello quando una sessione diventa attiva.\nSe disattivato, devi digitare nella sessione per cancellare l’icona del campanello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションがアクティブになったときにベルアイコンをクリアします。\nオフの場合、ベルアイコンをクリアするにはセッション内で入力する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 활성화되면 벨 아이콘을 지웁니다.\n꺼져 있으면 세션에 입력해야 벨 아이콘이 지워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern bjellesymbolet når en økt blir aktiv.\nNår dette er av, må du skrive i økten for å fjerne bjellesymbolet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wis het belsymbool wanneer een sessie actief wordt.\nAls dit is uitgeschakeld, moet je in de sessie typen om het belsymbool te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyść ikonę dzwonka, gdy sesja stanie się aktywna.\nGdy wyłączone, aby wyczyścić ikonę dzwonka, musisz coś wpisać w sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpar o ícone de campainha quando uma sessão se tornar ativa.\nQuando desativado, você deve digitar na sessão para limpar o ícone de campainha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирать значок колокольчика, когда сессия становится активной.\nЕсли выключено, для сброса значка колокольчика нужно набирать текст в сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymazať ikonu zvončeka, keď sa relácia stane aktívnou.\nAk je vypnuté, ikonu zvončeka vymažete písaním v relácii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počisti ikono zvonca, ko seja postane aktivna.\nČe je izklopljeno, morate za počiščenje ikone zvonca vnesti besedilo v sejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rensa klocksymbolen när en session blir aktiv.\nNär den är av måste du skriva i sessionen för att rensa klocksymbolen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturum etkin olduğunda zil simgesini temizle.\nKapalıyken zil simgesini temizlemek için oturuma yazı yazmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa biểu tượng chuông khi một phiên trở thành hoạt động.\nKhi tắt, bạn phải gõ trong phiên để xóa biểu tượng chuông."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话激活时清除角标图标\n关闭此选项后，需手动输入会话名称以清除角标图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段變為使用中時清除響鈴圖像。\n關閉時，你必須在該工作階段中輸入才能清除響鈴圖像。"
          }
        }
      }
    },
    "AdvancedSetting.clippingSeparator" : {
      "comment" : "Advanced setting: clippingSeparator",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddělovač vkládaný mezi více výstřižků při jejich odesílání nebo kopírování.\nHodnota by měla používat syntaxi Vimu, například \\n pro nový řádek a \\e pro escape."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilletegn, der indsættes mellem flere udklip, når de sendes eller kopieres.\nVærdien skal bruge Vim-syntaks, f.eks. \\n for linjeskift og \\e for escape."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennzeichen, das beim Senden oder Kopieren mehrerer Ausschnitte zwischen ihnen eingefügt wird.\nDer Wert sollte die Vim-Syntax verwenden, zum Beispiel \\n für Zeilenumbruch und \\e für Escape."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Separator inserted between multiple clippings when sending or copying them.\nThe value should use Vim syntax, such as \\n for newline and \\e for escape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separador que se inserta entre varios recortes al enviarlos o copiarlos.\nEl valor debe usar la sintaxis de Vim, como \\n para salto de línea y \\e para escape."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useiden leikkeiden väliin lisättävä erotin niitä lähetettäessä tai kopioitaessa.\nArvon tulee käyttää Vimin syntaksia, kuten \\n rivinvaihdolle ja \\e escapelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparateur inséré entre plusieurs coupures lors de leur envoi ou de leur copie.\nLa valeur doit utiliser la syntaxe de Vim, par exemple \\n pour un saut de ligne et \\e pour Échap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separatore inserito tra più ritagli quando vengono inviati o copiati.\nIl valore deve usare la sintassi di Vim, come \\n per l’a capo e \\e per escape."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のクリッピングを送信またはコピーする際に、それらの間に挿入するセパレーター。\n値は Vim の構文を使用してください。例えば改行には \\n、エスケープには \\e を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 클리핑을 보내거나 복사할 때 그 사이에 삽입되는 구분자.\n값에는 줄바꿈은 \\n, 이스케이프는 \\e처럼 Vim 구문을 사용해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilletegn som settes inn mellom flere klipp når de sendes eller kopieres.\nVerdien bør bruke Vim-syntaks, som \\n for linjeskift og \\e for escape."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheidingsteken dat tussen meerdere knipsels wordt ingevoegd bij het versturen of kopiëren ervan.\nDe waarde moet Vim-syntaxis gebruiken, zoals \\n voor een nieuwe regel en \\e voor escape."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separator wstawiany między wieloma wycinkami przy ich wysyłaniu lub kopiowaniu.\nWartość powinna używać składni Vima, np. \\n dla nowego wiersza i \\e dla Esc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separador inserido entre múltiplos recortes ao enviá-los ou copiá-los.\nO valor deve usar a sintaxe do Vim, como \\n para nova linha e \\e para escape."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разделитель, вставляемый между несколькими фрагментами при их отправке или копировании.\nЗначение должно использовать синтаксис Vim, например \\n для новой строки и \\e для escape."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddeľovač vkladaný medzi viaceré výstrižky pri ich odosielaní alebo kopírovaní.\nHodnota by mala používať syntax Vimu, napríklad \\n pre nový riadok a \\e pre escape."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ločilo, vstavljeno med več izsekov pri pošiljanju ali kopiranju.\nVrednost naj uporablja sintakso Vim, na primer \\n za novo vrstico in \\e za Escape."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgränsare som infogas mellan flera urklippsbitar när de skickas eller kopieras.\nVärdet ska använda Vim-syntax, till exempel \\n för nyrad och \\e för escape."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden çok kırpıntı gönderilirken veya kopyalanırken araya eklenen ayırıcı.\nDeğer, satır sonu için \\n ve kaçış için \\e gibi Vim sözdizimini kullanmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu phân cách được chèn giữa nhiều mẩu cắt khi gửi hoặc sao chép chúng.\nGiá trị nên dùng cú pháp Vim, như \\n cho xuống dòng và \\e cho escape."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送或复制多个剪裁内容时插入的分隔符\n值应使用Vim语法，例如\\n表示换行，\\e表示转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送或拷貝多個剪輯時，插入在它們之間的分隔符號。\n值應使用 Vim 語法，例如 \\n 代表換行，\\e 代表跳脫。"
          }
        }
      }
    },
    "AdvancedSetting.closingTmuxTabKillsTmuxWindows" : {
