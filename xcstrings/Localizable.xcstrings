    "Companion.ChooseMode.TerminalOnlyDetail" : {
      "comment" : "Detail under the terminal-only button on the choose-mode screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuchen Sie Sitzungen, verfolgen Sie die Live-Ausgabe und tippen Sie von Ihrem iPhone aus. Keine KI oder API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Browse sessions, watch live output, and type from your iPhone. No AI or API key needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora sesiones, mira la salida en vivo y escribe desde tu iPhone. No se necesita IA ni clave de API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez les sessions, suivez la sortie en direct et saisissez depuis votre iPhone. Aucune IA ni clé d’API requise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoglia le sessioni, guarda l’output in tempo reale e scrivi dal tuo iPhone. Non servono IA né chiave API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを閲覧し、出力をリアルタイムで確認し、iPhoneから入力できます。AIやAPIキーは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 세션을 탐색하고, 실시간 출력을 보고, 입력할 수 있습니다. AI나 API 키가 필요 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue pelas sessões, acompanhe a saída em tempo real e digite a partir do seu iPhone. Não é necessária IA nem chave de API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просматривайте сессии, следите за выводом в реальном времени и вводите текст с iPhone. ИИ и ключ API не требуются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlara göz atın, canlı çıktıyı izleyin ve iPhone’unuzdan yazın. YZ veya API anahtarı gerekmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览会话、查看实时输出，并从 iPhone 上输入内容。无需 AI 或 API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
