    "ClaudeCodeOnboarding.InstallRemoteHookDescription" : {
      "comment" : "Description of the onboarding step that installs the Claude Code hook on a remote host; the value is the host, such as user@example.com",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install the Claude Code hook on %1$@, so Claude Code running there shows its state (working, waiting, idle) in the Session Status tool too.\n\nThis adds a hook to Claude Code’s settings on %2$@. It runs the it2 command that SSH Integration keeps up to date on that host."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert den Claude-Code-Hook auf %1$@, damit auch das dort laufende Claude Code seinen Status (Arbeitet, Wartet, Inaktiv) im Werkzeug „Sitzungsstatus“ anzeigt.\n\nDadurch wird den Einstellungen von Claude Code auf %2$@ ein Hook hinzugefügt. Er führt den it2-Befehl aus, den die SSH-Integration auf diesem Host aktuell hält."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@にClaude Codeフックをインストールし、そこで実行されているClaude Codeの状態（作業中、待機中、アイドル）もSession Statusツールに表示されるようにします。\n\nこれにより、%2$@のClaude Codeの設定にフックが追加されます。このフックは、SSH統合がそのホスト上で最新の状態に保っているit2コマンドを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 Claude Code 훅을 설치하여 그곳에서 실행되는 Claude Code도 세션 상태 도구에 상태(작업 중, 대기 중, 유휴)를 표시하게 합니다.\n\n%2$@의 Claude Code 설정에 훅이 추가됩니다. 이 훅은 SSH 통합이 해당 호스트에서 최신 상태로 유지하는 it2 명령을 실행합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale o hook do Claude Code em %1$@, para que o Claude Code executado lá também mostre seu estado (trabalhando, aguardando, ocioso) na ferramenta Status da sessão.\n\nIsso adiciona um hook aos ajustes do Claude Code em %2$@. Ele executa o comando it2 que a Integração SSH mantém atualizado nesse host."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите хук Claude Code на %1$@, чтобы Claude Code, работающий там, тоже показывал своё состояние (работает, ожидает, простаивает) в инструменте «Статус сессии».\n\nЭто добавляет хук в настройки Claude Code на %2$@. Хук запускает команду it2, которую интеграция с SSH поддерживает в актуальном состоянии на этом хосте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@ 上安装 Claude Code 钩子，使在那里运行的 Claude Code 也能在“会话状态”工具中显示其状态（工作中、等待中、空闲）。\n\n这会在 %2$@ 上 Claude Code 的设置中添加一个钩子。该钩子运行由 SSH 集成在该主机上保持最新的 it2 命令。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.InstallRemoteHookTitle" : {
      "comment" : "Title of the onboarding step that installs the Claude Code hook on the host the session is connected to through SSH Integration",
      "extractionState" : "extracted_with_value",
