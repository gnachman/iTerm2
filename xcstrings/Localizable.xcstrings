    "TmuxController.NotUTF8Message" : {
      "comment" : "Error explaining that tmux must be run in UTF-8 mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux není v režimu UTF-8. Předejte tmuxu argument příkazového řádku -u nebo změňte proměnnou prostředí LANG tak, aby končila na „.UTF-8“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux er ikke i UTF-8-tilstand. Giv tmux kommandolinjeargumentet -u, eller ændr din miljøvariabel LANG, så den ender på “.UTF-8”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux befindet sich nicht im UTF-8-Modus. Bitte übergeben Sie das Kommandozeilenargument -u an tmux oder ändern Sie Ihre Umgebungsvariable LANG so, dass sie mit „.UTF-8“ endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "tmux is not in UTF-8 mode. Please pass the -u command line argument to tmux or change your LANG environment variable to end with “.UTF-8”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux no está en modo UTF-8. Pasa el argumento de línea de comandos -u a tmux o cambia tu variable de entorno LANG para que termine en “.UTF-8”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux ei ole UTF-8-tilassa. Anna tmuxille komentoriviargumentti -u tai muuta LANG-ympäristömuuttujasi päättymään merkkijonoon ”.UTF-8”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux n’est pas en mode UTF-8. Passez l’argument de ligne de commande -u à tmux ou modifiez votre variable d’environnement LANG pour qu’elle se termine par « .UTF-8 »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux non è in modalità UTF-8. Passa a tmux l’argomento da riga di comando -u oppure modifica la variabile d’ambiente LANG in modo che termini con “.UTF-8”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxがUTF-8モードになっていません。tmuxに-uコマンドライン引数を渡すか、LANG環境変数の末尾を「.UTF-8」に変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux가 UTF-8 모드가 아닙니다. tmux에 -u 명령줄 인수를 전달하거나 LANG 환경 변수가 “.UTF-8”로 끝나도록 변경하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux er ikke i UTF-8-modus. Send kommandolinjeargumentet -u til tmux, eller endre miljøvariabelen LANG slik at den ender med «.UTF-8»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux staat niet in UTF-8-modus. Geef het opdrachtregelargument -u mee aan tmux of wijzig je omgevingsvariabele LANG zodat die eindigt op ‘.UTF-8’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux nie jest w trybie UTF-8. Przekaż do tmux argument wiersza poleceń -u lub zmień zmienną środowiskową LANG tak, aby kończyła się na „.UTF-8”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tmux não está no modo UTF-8. Passe o argumento de linha de comando -u para o tmux ou altere sua variável de ambiente LANG para terminar com “.UTF-8”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux работает не в режиме UTF-8. Передайте tmux аргумент командной строки -u или измените переменную окружения LANG так, чтобы она заканчивалась на «.UTF-8»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux nie je v režime UTF-8. Odovzdajte tmux argument príkazového riadka -u alebo zmeňte premennú prostredia LANG tak, aby končila na „.UTF-8“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux ni v načinu UTF-8. Tmuxu posredujte argument ukazne vrstice -u ali spremenite spremenljivko okolja LANG, da se konča z ».UTF-8«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux är inte i UTF-8-läge. Skicka kommandoradsargumentet -u till tmux eller ändra miljövariabeln LANG så att den slutar på ”.UTF-8”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux UTF-8 modunda değil. Lütfen tmux’a -u komut satırı bağımsız değişkenini iletin veya LANG ortam değişkeninizi “.UTF-8” ile bitecek şekilde değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux không ở chế độ UTF-8. Vui lòng truyền đối số dòng lệnh -u cho tmux hoặc đổi biến môi trường LANG của bạn để kết thúc bằng “.UTF-8”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 未处于 UTF-8 模式。请向 tmux 传递 -u 命令行参数，或将你的 LANG 环境变量改为以“.UTF-8”结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 不在 UTF-8 模式。請將 -u 命令列引數傳給 tmux，或將 LANG 環境變數改為以「.UTF-8」結尾。"
          }
        }
      }
    },
