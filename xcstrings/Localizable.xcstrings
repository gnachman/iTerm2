    "Tip.0014.Body" : {
      "comment" : "Tip of the day body, id 0014",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Funktion „Semantischer Verlauf“ können Sie bei gedrückter ⌘-Taste auf eine Datei oder URL klicken, um sie zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “Semantic History” feature allows you to ⌘-click on a file or URL to open it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「セマンティックヒストリー」機能を使うと、ファイルやURLを⌘クリックして開くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“시맨틱 히스토리” 기능을 사용하면 파일이나 URL을 ⌘-클릭하여 열 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso “Semantic History” permite clicar com ⌘ em um arquivo ou URL para abri-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция «Семантическая история» позволяет открыть файл или URL-адрес щелчком с ⌘."
          }
        },
        "zh-Hans" : {
