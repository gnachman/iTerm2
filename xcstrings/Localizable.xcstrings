    "TransferrableFile.FileExistsPrompt" : {
      "comment" : "Prompt shown when a downloaded file name already exists; %@ is the file name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei namens %@ existiert bereits. Beide Dateien behalten oder die vorhandene Datei ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A file named %@ already exists. Keep both files or replace the existing file?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@という名前のファイルはすでに存在します。両方のファイルを残しますか、それとも既存のファイルを置き換えますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)라는 파일이 이미 있습니다. 두 파일을 모두 유지하겠습니까, 아니면 기존 파일을 대치하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já existe um arquivo chamado %@. Manter ambos os arquivos ou substituir o arquivo existente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл с именем %@ уже существует. Оставить оба файла или заменить существующий?"
          }
        },
