    "ClaudeCodeOnboarding.InstallHookDescription" : {
      "comment" : "Description of the install-hook onboarding step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert einen Claude-Code-Hook, mit dem iTerm2 den Status von Claude (Arbeitet, Wartet, Inaktiv) erkennen und im Werkzeug „Sitzungsstatus“ anzeigen kann.\n\nDadurch wird Ihren Claude-Code-Einstellungen ein Hook hinzugefügt, der automatisch ausgeführt wird, während Claude arbeitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install a Claude Code hook that lets iTerm2 detect Claude’s state (working, waiting, idle) and display it in the Session Status tool.\n\nThis adds a hook to your Claude Code settings that runs automatically as Claude works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala un hook de Claude Code que permite a iTerm2 detectar el estado de Claude (trabajando, en espera, inactivo) y mostrarlo en la herramienta Estado de la sesión.\n\nEsto añade un hook a los ajustes de Claude Code que se ejecuta automáticamente mientras Claude trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez un hook Claude Code qui permet à iTerm2 de détecter l’état de Claude (au travail, en attente, inactif) et de l’afficher dans l’outil État des sessions.\n\nCela ajoute à vos réglages de Claude Code un hook qui s’exécute automatiquement pendant que Claude travaille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa un hook di Claude Code che permette a iTerm2 di rilevare lo stato di Claude (in corso, in attesa, inattivo) e mostrarlo nello strumento Stato sessione.\n\nQuesto aggiunge alle impostazioni di Claude Code un hook che viene eseguito automaticamente mentre Claude lavora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2がClaudeの状態（作業中、待機中、アイドル）を検出してSession Statusツールに表示できるようにするClaude Codeフックをインストールします。\n\nこれにより、Claudeの動作中に自動的に実行されるフックがClaude Codeの設定に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 Claude의 상태(작업 중, 대기 중, 유휴)를 감지하여 세션 상태 도구에 표시할 수 있도록 Claude Code 훅을 설치합니다.\n\nClaude가 작업할 때 자동으로 실행되는 훅이 Claude Code 설정에 추가됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale um hook do Claude Code que permite ao iTerm2 detectar o estado do Claude (trabalhando, aguardando, ocioso) e exibi-lo na ferramenta Status da sessão.\n\nIsso adiciona um hook aos seus ajustes do Claude Code que roda automaticamente enquanto o Claude trabalha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите хук Claude Code, который позволяет iTerm2 определять состояние Claude (работает, ожидает, простаивает) и отображать его в инструменте «Статус сессии».\n\nЭто добавляет хук в настройки Claude Code, который автоматически запускается по мере работы Claude."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin Claude’un durumunu (çalışıyor, bekliyor, boşta) algılayıp Oturum Durumu aracında göstermesini sağlayan bir Claude Code kancası yükleyin.\n\nBu, Claude Code ayarlarınıza Claude çalışırken otomatik olarak çalışan bir kanca ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Claude Code 钩子，让 iTerm2 检测 Claude 的状态（工作中、等待中、空闲）并显示在“会话状态”工具中。\n\n这会在你的 Claude Code 设置中添加一个在 Claude 工作时自动运行的钩子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝 Claude Code hook，讓 iTerm2 偵測 Claude 的狀態（處理中、等待中、閒置）並顯示在「工作階段狀態」工具中。\n\n這會在你的 Claude Code 設定中加入一個 hook，並在 Claude 工作時自動執行。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.InstallHookTitle" : {
