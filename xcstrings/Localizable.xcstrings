    "StatusBarAction.DetailedDescription" : {
      "comment" : "Detailed description of the custom action status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá tlačítko, které provede uživatelsky nastavitelnou akci, podobně jako přiřazení klávesy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer en knap, der udfører en handling, brugeren kan konfigurere, ligesom en tastetildeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Schaltfläche hinzu, die eine benutzerdefinierte Aktion ausführt, ähnlich einer Tastenkombination."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds a button that performs a user-configurable action, similar to a key binding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un botón que realiza una acción configurable por el usuario, similar a una asignación de teclas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää painikkeen, joka suorittaa käyttäjän määrittämän toiminnon, kuten näppäinmääritys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un bouton qui exécute une action configurable par l’utilisateur, comme une association de touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un pulsante che esegue un’azione configurabile dall’utente, simile a un’associazione tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーバインドのように、ユーザーが設定可能なアクションを実行するボタンを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키 바인딩과 비슷하게 사용자가 구성할 수 있는 동작을 수행하는 버튼을 추가합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til en knapp som utfører en handling du kan konfigurere, på samme måte som en tastetilordning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een knop toe die een door de gebruiker in te stellen actie uitvoert, vergelijkbaar met een toetstoewijzing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje przycisk wykonujący akcję konfigurowaną przez użytkownika, podobnie jak przypisanie klawisza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona um botão que executa uma ação configurável pelo usuário, semelhante a uma associação de teclas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет кнопку, которая выполняет настраиваемое пользователем действие, аналогично сочетанию клавиш."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridá tlačidlo, ktoré vykoná akciu nastaviteľnú užívateľom, podobne ako priradenie klávesov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doda gumb, ki izvede dejanje, ki ga lahko nastavi uporabnik, podobno kot dodelitev tipke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till en knapp som utför en åtgärd som användaren kan konfigurera, ungefär som en tangentkoppling."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuş atamasına benzer şekilde, kullanıcı tarafından yapılandırılabilen bir eylemi gerçekleştiren bir düğme ekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một nút thực hiện tác vụ do người dùng cấu hình, tương tự như gán phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加一个执行用户可配置操作的按钮，类似于按键绑定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入一個按鈕，可執行使用者可設定的動作，類似按鍵對應。"
          }
        }
      }
    },
