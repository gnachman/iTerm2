          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trackpad scrolls fast?\nSet to No for legacy scrolling speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El trackpad se desplaza rápido?\nEstablécelo en No para usar la velocidad de desplazamiento heredada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défilement rapide au trackpad ?\nDéfinissez Non pour la vitesse de défilement historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trackpad scorre velocemente?\nImposta No per la velocità di scorrimento precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラックパッドを高速でスクロールしますか?\n従来のスクロール速度にするには「いいえ」に設定してください。"
