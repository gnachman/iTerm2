    "AddTrigger.LeaderOnlyTooltip" : {
      "comment" : "Tooltip explaining the leader-only trigger option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je zapnuto, spouštěč se aktivuje pouze pro vedoucího pracovní skupiny (relaci, která do pracovní skupiny původně vstoupila). Členové, například relace Revize kódu a Diff, jej neaktivují, takže opětovné načtení nebo ukončení některého z nich ponechá pracovní skupinu otevřenou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er slået til, udløses udløseren kun for arbejdsgruppens leder (den session, der oprindeligt kom ind i arbejdsgruppen). Medlemmer som sessionerne Kodegennemgang og Diff udløser den ikke, så genindlæsning eller lukning af et af dem holder arbejdsgruppen åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, löst der Trigger nur beim Leiter der Arbeitsgruppe aus (der Sitzung, die die Arbeitsgruppe ursprünglich betreten hat). Peers wie die Sitzungen für Code-Review und Diff lösen nicht aus, sodass das Neuladen oder Beenden einer solchen Sitzung die Arbeitsgruppe geöffnet lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When set, the trigger fires only for the workgroup leader (the session that originally entered the workgroup). Peers such as the Code Review and Diff sessions do not, so reloading or quitting one keeps the workgroup open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, el disparador se activa solo para el líder del grupo de trabajo (la sesión que entró originalmente en el grupo de trabajo). Los pares, como las sesiones de Revisión de código y Diff, no lo activan, de modo que recargar o cerrar uno de ellos mantiene abierto el grupo de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on valittuna, käynnistin laukeaa vain työryhmän johtajalle (istunnolle, joka alun perin siirtyi työryhmään). Jäsenet, kuten Koodikatselmointi- ja Diff-istunnot, eivät laukaise sitä, joten jonkin niistä lataaminen uudelleen tai sulkeminen pitää työryhmän auki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, le déclencheur ne s’active que pour le meneur du groupe de travail (la session qui est entrée à l’origine dans le groupe de travail). Les pairs, comme les sessions Revue de code et Diff, ne l’activent pas, si bien que recharger ou quitter l’un d’eux laisse le groupe de travail ouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se selezionato, l’attivatore scatta solo per il capogruppo del gruppo di lavoro (la sessione che ha originariamente creato il gruppo di lavoro). I pari, come le sessioni Revisione del codice e Diff, non lo fanno scattare, quindi ricaricarne o chiuderne uno mantiene aperto il gruppo di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定すると、トリガーはワークグループリーダー（最初にワークグループに参加したセッション）に対してのみ発動します。コードレビューやDiffセッションなどのピアは対象外なので、それらを再読み込みまたは終了してもワークグループは開いたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정하면 트리거가 워크그룹 리더(처음 워크그룹에 진입한 세션)에서만 실행됩니다. 코드 리뷰 및 Diff 세션 같은 피어에서는 실행되지 않으므로 그중 하나를 다시 로드하거나 종료해도 워크그룹이 열린 상태로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, utløses utløseren bare for arbeidsgruppens leder (økten som opprinnelig gikk inn i arbeidsgruppen). Medlemmer som Kodegjennomgang- og Diff-øktene utløser den ikke, så å laste om eller avslutte ett av dem holder arbeidsgruppen åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingesteld, wordt de trigger alleen geactiveerd voor de werkgroepleider (de sessie die oorspronkelijk de werkgroep is binnengegaan). Leden zoals de sessies Codereview en Diff activeren hem niet, zodat het opnieuw laden of sluiten van een lid de werkgroep open houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zaznaczone, wyzwalacz uruchamia się tylko dla lidera grupy roboczej (sesji, która pierwotnie weszła do grupy roboczej). Członkowie, tacy jak sesje Przeglądu kodu i Diff, go nie uruchamiają, więc ponowne wczytanie lub zakończenie jednej z nich nie zamyka grupy roboczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando definido, o gatilho é acionado apenas para o líder do grupo de trabalho (a sessão que originalmente entrou no grupo de trabalho). Sessões pares, como as de Revisão de código e Diff, não são acionadas, portanto recarregar ou encerrar uma delas mantém o grupo de trabalho aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр установлен, триггер срабатывает только для лидера рабочей группы (сессии, которая изначально вошла в рабочую группу). Для равноправных участников, таких как сессии Code Review и Diff, он не срабатывает, поэтому перезагрузка или завершение одной из них не закрывает рабочую группу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, spúšťač sa aktivuje iba pre vedúceho pracovnej skupiny (reláciu, ktorá do pracovnej skupiny pôvodne vstúpila). Členovia, ako relácie Revízia kódu a Diff, ho neaktivujú, takže opätovné načítanie alebo ukončenie jednej z nich ponechá pracovnú skupinu otvorenú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je nastavljeno, se sprožilec sproži samo za vodjo delovne skupine (sejo, ki je prvotno vstopila v delovno skupino). Člani, kot sta seji Pregled kode in Diff, ga ne sprožijo, zato ponovno nalaganje ali zapiranje enega od njih delovno skupino ohrani odprto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är aktiverat utlöses utlösaren bara för arbetsgruppens ledare (sessionen som ursprungligen gick in i arbetsgruppen). Medlemmar som sessionerna Kodgranskning och Diff gör det inte, så om du läser in en av dem på nytt eller stänger den förblir arbetsgruppen öppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlandığında tetikleyici yalnızca çalışma grubu lideri (çalışma grubuna ilk giren oturum) için çalışır. Kod İncelemesi ve Diff oturumları gibi eşler için çalışmaz; böylece birini yeniden yüklemek veya kapatmak çalışma grubunu açık tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi được đặt, trình kích hoạt chỉ chạy cho trưởng nhóm của nhóm làm việc (phiên ban đầu đã vào nhóm làm việc). Các thành viên ngang hàng như phiên Xem xét mã và Diff thì không, nên việc tải lại hoặc thoát một phiên trong số đó vẫn giữ nhóm làm việc mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置后，触发器仅在工作组主导者（最初进入工作组的会话）上触发。代码审查和差异等对等会话不会触发，因此重新载入或退出其中一个会话不会关闭工作组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定後，觸發器僅會在工作群組主導者（最初進入工作群組的工作階段）上觸發。程式碼審查和 Diff 等同儕工作階段不會觸發，因此重新載入或結束其中一個工作階段不會關閉工作群組。"
          }
        }
      }
    },
