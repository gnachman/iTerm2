    "WorkgroupAutoRequestReview.ToolTipDisabled" : {
      "comment" : "Tooltip when the auto-request-review toggle is disabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch ein Review anfordern, wenn inaktiv (erfordert genau eine Code-Review-Sitzung)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-request a review when idle (needs exactly one code review session)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル時に自動でレビューをリクエスト（コードレビューセッションが1つだけ必要です）"
          }
