        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista över typsnitt som använder en alternativ avrundningsalgoritm vid beräkning av radhöjd.\nDetta rättar till consolas och efterliknar Terminal.apps beteende i macOS 10.15. Det är en kommaavgränsad lista med delsträngar av typsnittsfamiljer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satır yüksekliği hesabı için alternatif yuvarlama algoritmasının kullanılacağı fontların listesi.\nBu, consolas’ı düzeltir ve Terminal.app’in macOS 10.15’teki davranışını taklit eder. Font ailesi alt dizelerinin virgülle ayrılmış listesidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách phông chữ dùng thuật toán làm tròn thay thế để tính chiều cao dòng.\nĐiều này sửa consolas và mô phỏng hành vi của Terminal.app trên macOS 10.15. Đây là danh sách các chuỗi con của họ phông chữ, phân tách bằng dấu phẩy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在线性高度计算中采用替代四舍五入算法的字体列表。\n此设置可修复consolas的问题，并模拟macOS 10.15版本中Terminal.app的行为。该列表为以逗号分隔的字体系列子串。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用替代捨入演算法計算行高的字體清單。\n這可修正 consolas，並模擬 macOS 10.15 上「終端機」App 的行為。這是以逗號分隔的字體系列子字串清單。"
          }
        }
      }
    },
    "AdvancedSetting.forceAntialiasingOnRetina" : {
      "comment" : "Advanced setting: forceAntialiasingOnRetina",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynutit vyhlazování textu na displejích Retina.\nZapnutím použijete na displejích bez Retiny text bez vyhlazování, který někdy vypadá lépe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemtving udjævning af tekst på Retina-skærme.\nSlå dette til for at bruge tekst uden udjævning på skærme uden Retina, hvilket nogle gange ser bedre ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text auf Retina-Displays erzwungen glätten (Anti-Aliasing).\nAktivieren Sie dies, um auf Nicht-Retina-Displays nicht geglätteten Text zu verwenden, der manchmal besser aussieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Force text to be anti-aliased on Retina displays.\nEnable this to use non-AA text on non-retina displays, which sometimes looks better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar el suavizado del texto en pantallas Retina.\nActívalo para usar texto sin suavizado en pantallas no Retina, que a veces se ve mejor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakota tekstin reunanpehmennys Retina-näytöillä.\nOta tämä käyttöön käyttääksesi reunanpehmentämätöntä tekstiä ei-Retina-näytöillä, mikä näyttää joskus paremmalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forcer l’anticrénelage du texte sur les écrans Retina.\nActivez cette option pour utiliser du texte non anticrénelé sur les écrans non Retina, ce qui rend parfois mieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza l’antialiasing del testo sui display Retina.\nAbilitalo per usare testo senza antialiasing sui display non Retina, che a volte appare migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina ディスプレイでテキストを強制的にアンチエイリアス処理します。\nこれを有効にすると、非 Retina ディスプレイではアンチエイリアスなしのテキストを使用できます。こちらの方が見た目が良い場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina 디스플레이에서 텍스트에 강제로 안티앨리어싱 적용.\nRetina가 아닌 디스플레이에서 안티앨리어싱되지 않은 텍스트를 사용하려면 이 옵션을 켜십시오. 그 편이 더 보기 좋을 때가 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tving tekst til å være kantutjevnet på Retina-skjermer.\nAktiver dette for å bruke tekst uten kantutjevning på skjermer som ikke er Retina, noe som noen ganger ser bedre ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forceer anti-aliasing van tekst op Retina-schermen.\nSchakel dit in om tekst zonder anti-aliasing te gebruiken op schermen die niet Retina zijn, wat soms beter oogt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuszaj antyaliasing tekstu na wyświetlaczach Retina.\nWyłącz, aby używać tekstu bez antyaliasingu na wyświetlaczach innych niż Retina, co czasem wygląda lepiej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forçar o texto a ter anti-aliasing em telas Retina.\nAtive isto para usar texto sem AA em telas não retina, o que às vezes fica melhor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительно сглаживать текст на дисплеях Retina.\nВключите это, чтобы использовать текст без сглаживания на дисплеях, отличных от Retina, что иногда выглядит лучше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynútiť vyhladzovanie textu na displejoch Retina.\nZapnite na použitie textu bez vyhladzovania na displejoch bez Retina, čo niekedy vyzerá lepšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsili glajenje robov besedila na zaslonih Retina.\nOmogočite za besedilo brez glajenja na zaslonih, ki niso Retina, kar je včasih videti bolje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvinga text att kantutjämnas på Retina-skärmar.\nAktivera detta för att använda text utan kantutjämning på skärmar som inte är Retina, vilket ibland ser bättre ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina ekranlarda metni zorla kenar yumuşatmalı yap.\nRetina olmayan ekranlarda bazen daha iyi görünen kenar yumuşatmasız metin kullanmak için bunu etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buộc văn bản được khử răng cưa trên màn hình Retina.\nBật tùy chọn này để dùng văn bản không khử răng cưa trên màn hình không phải Retina, đôi khi trông đẹp hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制在视网膜显示屏上对文本进行抗锯齿处理。\n启用此选项可在非视网膜显示屏上使用非抗锯齿文本，这类文本有时看起来效果更好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制在 Retina 顯示器上對文字進行反鋸齒。\n啟用此項可在非 Retina 顯示器上使用非反鋸齒文字，有時看起來更好。"
          }
        }
      }
    },
    "AdvancedSetting.fractionOfCharacterSelectingNextNeighbor" : {
      "comment" : "Advanced setting: fractionOfCharacterSelectingNextNeighbor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlomek šířky znaku na jeho pravé straně, který lze použít k výběru znaku vpravo od něj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den brøkdel af et tegns bredde i dets højre side, der kan bruges til at markere tegnet til højre for det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil der Zeichenbreite auf der rechten Seite, der zur Auswahl des rechts benachbarten Zeichens verwendet werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fraction of character’s width on its right side that can be used to select the character to its right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracción de la anchura de un carácter, en su lado derecho, que se puede usar para seleccionar el carácter de su derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkin oikeanpuoleisen osan leveyden osuus, jolla voi valita merkin oikealla puolella olevan merkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraction de la largeur d’un caractère, sur son côté droit, qui peut servir à sélectionner le caractère à sa droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frazione della larghezza di un carattere, sul suo lato destro, che può essere usata per selezionare il carattere alla sua destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字の右側の幅のうち、右隣の文字を選択するために使用できる割合。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 문자를 선택하는 데 사용할 수 있는, 문자 너비 중 오른쪽 부분의 비율."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brøkdel av et tegns bredde på høyre side som kan brukes til å markere tegnet til høyre for det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fractie van de breedte van een teken, aan de rechterkant, die kan worden gebruikt om het teken rechts ervan te selecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ułamek szerokości znaku po jego prawej stronie, który może służyć do zaznaczenia znaku po prawej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fração da largura do caractere no seu lado direito que pode ser usada para selecionar o caractere à sua direita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля ширины символа с правой стороны, которая может использоваться для выбора символа справа от него."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlomok šírky znaku na jeho pravej strane, ktorý možno použiť na výber znaku napravo od neho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delež širine znaka na njegovi desni strani, ki ga je mogoče uporabiti za izbiro znaka na desni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andel av ett tecknets bredd på dess högra sida som kan användas för att markera tecknet till höger om det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karakterin sağ tarafında, sağındaki karakteri seçmek için kullanılabilecek genişlik kesri."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tỷ lệ chiều rộng của ký tự ở phía bên phải có thể dùng để chọn ký tự bên phải nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用于选取右侧字符的、位于该字符右侧的那部分宽度比例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字元右側可用來選取其右方字元的寬度比例。"
          }
        }
      }
    },
    "AdvancedSetting.fullHeightCursor" : {
      "comment" : "Advanced setting: fullHeightCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzor zabírá oblast řádkování.\nPokud mají řádky svislé mezery větší než 100 % a toto nastavení je zapnuto, spodní okraj kurzoru se zarovná se spodním okrajem oblasti mezer."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markøren fylder linjeafstandsområdet.\nHvis linjer har mere end 100 % lodret afstand, og denne indstilling er slået til, flugter markørens bund med bunden af afstandsområdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor nimmt den Zeilenabstandsbereich ein.\nWenn Zeilen einen vertikalen Abstand von mehr als 100 % haben und diese Einstellung aktiviert ist, wird die Unterkante des Cursors an der Unterkante des Abstandsbereichs ausgerichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cursor occupies line spacing area.\nIf lines have more than 100% vertical spacing and this setting is enabled the bottom of the cursor will be aligned to the bottom of the spacing area."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cursor ocupa el área de interlineado.\nSi el espaciado vertical de las líneas supera el 100% y este ajuste está activado, la parte inferior del cursor se alineará con la parte inferior del área de espaciado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohdistin täyttää riviväliin varatun alueen.\nJos rivien pystysuuntainen väli on yli 100 % ja tämä asetus on käytössä, kohdistimen alareuna kohdistetaan välialueen alareunaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le curseur occupe la zone d’interligne.\nSi les lignes ont plus de 100 % d’espacement vertical et que cette option est activée, le bas du curseur est aligné sur le bas de la zone d’espacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cursore occupa l’area dell’interlinea.\nSe le righe hanno una spaziatura verticale superiore al 100% e questa impostazione è abilitata, il fondo del cursore sarà allineato al fondo dell’area di spaziatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルが行間の領域を占めるようにします。\n行の垂直方向の間隔が 100% を超えていて、この設定が有効な場合、カーソルの下端は間隔領域の下端に揃えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서가 행 간격 영역을 차지합니다.\n행의 세로 간격이 100%보다 크고 이 설정이 켜져 있으면 커서 아래쪽이 간격 영역 아래쪽에 맞춰 정렬됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markøren opptar linjeavstandsområdet.\nHvis linjene har mer enn 100 % loddrett avstand og denne innstillingen er aktivert, justeres bunnen av markøren mot bunnen av avstandsområdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cursor beslaat het gebied van de regelafstand.\nAls regels meer dan 100% verticale afstand hebben en deze instelling is ingeschakeld, wordt de onderkant van de cursor uitgelijnd met de onderkant van het afstandsgebied."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursor zajmuje obszar odstępu między wierszami.\nJeśli wiersze mają ponad 100% odstępu pionowego i to ustawienie jest włączone, dół kursora zostanie wyrównany do dołu obszaru odstępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cursor ocupa a área de espaçamento entre linhas.\nSe as linhas tiverem mais de 100% de espaçamento vertical e este ajuste estiver ativado, a parte inferior do cursor será alinhada à parte inferior da área de espaçamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсор занимает область межстрочного интервала.\nЕсли строки имеют межстрочный интервал больше 100 % и эта настройка включена, нижняя часть курсора будет выровнена по нижнему краю области интервала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzor zaberá oblasť riadkovania.\nAk majú riadky viac ako 100 % zvislého rozstupu a toto nastavenie je zapnuté, spodok kurzora sa zarovná so spodkom oblasti rozstupu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazalec zaseda območje razmika vrstic.\nČe imajo vrstice več kot 100 % navpičnega razmika in je ta nastavitev omogočena, bo dno kazalca poravnano z dnom območja razmika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markören upptar radavståndsområdet.\nOm rader har mer än 100 % lodrätt avstånd och den här inställningen är aktiverad justeras markörens nederkant mot nederkanten av avståndsområdet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç satır aralığı alanını kaplar.\nSatırların dikey aralığı %100’den fazlaysa ve bu ayar etkinse imlecin alt kenarı aralık alanının alt kenarıyla hizalanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con trỏ chiếm vùng giãn dòng.\nNếu các dòng có giãn dọc hơn 100% và cài đặt này được bật, đáy của con trỏ sẽ căn theo đáy của vùng giãn dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标会占据行间距区域。\n如果行的垂直间距超过100%，且启用了此设置，则光标的底部会与间距区域的底部对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標佔滿行距區域。\n如果行距的垂直間距超過 100% 且啟用此設定，游標底部會與間距區域底部對齊。"
          }
        }
      }
    },
    "AdvancedSetting.fullWidthFlags" : {
      "comment" : "Advanced setting: fullWidthFlags",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samostatné regionální indikátory se vykreslují v plné šířce.\nÚplná vlajka vždy zabírá dva sloupce, což je šířka, kterou wcwidth hlásí pro dvojici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkeltstående regionale indikatorer gengives med fuld bredde.\nEt komplet flag er altid to kolonner, hvilket er den bredde, wcwidth rapporterer for parret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzelne Regionalindikatoren werden in voller Breite dargestellt.\nEine vollständige Flagge belegt immer zwei Spalten, was der Breite entspricht, die wcwidth für das Paar meldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lone regional indicators render full-width.\nA complete flag is always two columns, which is the width wcwidth reports for the pair."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los indicadores regionales aislados se renderizan a anchura completa.\nUna bandera completa siempre ocupa dos columnas, que es la anchura que wcwidth informa para el par."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksittäiset alueindikaattorit renderöidään täysleveinä.\nTäydellinen lippu on aina kaksi saraketta, mikä on leveys, jonka wcwidth raportoi parille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les indicateurs régionaux isolés s’affichent en pleine largeur.\nUn drapeau complet occupe toujours deux colonnes, soit la largeur que wcwidth signale pour la paire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli indicatori regionali isolati vengono visualizzati a larghezza intera.\nUna bandiera completa occupa sempre due colonne, che è la larghezza riportata da wcwidth per la coppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単独の地域表示記号を全角で表示します。\n完全な国旗は常に2列分の幅になり、これはwcwidthがその組に対して報告する幅と一致します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단독 지역 표시 기호를 전각 너비로 렌더링합니다.\n완전한 국기는 항상 두 열을 차지하며, 이는 wcwidth가 그 쌍에 대해 보고하는 너비입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enslige regionale indikatorer gjengis med full bredde.\nEt komplett flagg er alltid to kolonner, som er bredden wcwidth rapporterer for paret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Losse regionale indicatoren worden op volledige breedte weergegeven.\nEen complete vlag beslaat altijd twee kolommen, de breedte die wcwidth voor het paar meldt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojedyncze wskaźniki regionalne są renderowane jako pełnej szerokości.\nKompletna flaga zawsze zajmuje dwie kolumny, czyli szerokość zgłaszaną przez wcwidth dla pary."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicadores regionais isolados são renderizados com largura total.\nUma bandeira completa ocupa sempre duas colunas, que é a largura que o wcwidth informa para o par."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельные региональные индикаторы отображаются на полную ширину.\nПолный флаг всегда занимает два столбца — именно такую ширину wcwidth сообщает для пары."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samostatné regionálne indikátory sa vykresľujú v plnej šírke.\nÚplná vlajka má vždy dva stĺpce, čo je šírka, ktorú wcwidth hlási pre dvojicu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samostojni regionalni kazalniki so upodobljeni s polno širino.\nPopolna zastava je vedno široka dva stolpca, kar je širina, ki jo wcwidth sporoči za par."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensamma regionala indikatorer renderas med full bredd.\nEn komplett flagga är alltid två kolumner, vilket är den bredd wcwidth rapporterar för paret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız bölgesel göstergeler tam genişlikte işlenir.\nTam bir bayrak her zaman iki sütundur; bu, wcwidth’in çift için bildirdiği genişliktir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chỉ báo vùng đơn lẻ được kết xuất rộng đủ hai ô.\nMột lá cờ hoàn chỉnh luôn rộng hai cột, là chiều rộng mà wcwidth báo cáo cho cặp này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独的区域指示符以全宽显示。\n完整的旗帜始终占两列，这也是 wcwidth 为该对字符报告的宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨的區域指示符號以全形寬度繪製。\n完整的旗幟一律為兩欄，這也是 wcwidth 對該組合所回報的寬度。"
          }
        }
      }
    },
    "AdvancedSetting.generativeAIAllowed" : {
      "comment" : "Advanced setting: generativeAIAllowed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit používání API velkých jazykových modelů?\nÚčelem tohoto nastavení je usnadnit spravovaným prostředím vypnutí používání LLM. Klíč uživatelských výchozích hodnot je `GenerativeAIAllowed`."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad brug af API’er til store sprogmodeller?\nFormålet med denne indstilling er at gøre det let for administrerede miljøer at slå brug af LLM’er fra. Nøglen i brugerstandarder er `GenerativeAIAllowed`."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verwendung von APIs für große Sprachmodelle erlauben?\nDer Zweck dieser Einstellung besteht darin, verwalteten Umgebungen die Deaktivierung der Verwendung von LLMs zu erleichtern. Der User-Defaults-Schlüssel ist `GenerativeAIAllowed`."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow the use of large language model APIs?\nThe purpose of this setting is to make it easy for managed environments to disable the use of LLMs. The user defaults key is `GenerativeAIAllowed`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir el uso de API de modelos de lenguaje grandes?\nLa finalidad de este ajuste es facilitar que los entornos gestionados desactiven el uso de LLM. La clave de los ajustes predeterminados del usuario es `GenerativeAIAllowed`."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallitaanko suurten kielimallien API-rajapintojen käyttö?\nTämän asetuksen tarkoitus on helpottaa LLM:ien käytön poistamista käytöstä hallituissa ympäristöissä. Käyttäjäasetusten avain on `GenerativeAIAllowed`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’utilisation des API de grands modèles de langage ?\nCe réglage permet aux environnements gérés de désactiver facilement l’utilisation des LLM. La clé des préférences utilisateur est `GenerativeAIAllowed`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire l’uso delle API dei modelli linguistici di grandi dimensioni?\nLo scopo di questa impostazione è facilitare agli ambienti gestiti la disabilitazione dell’uso degli LLM. La chiave delle preferenze utente è `GenerativeAIAllowed`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大規模言語モデル (LLM) API の使用を許可しますか?\nこの設定の目的は、管理環境で LLM の使用を簡単に無効化できるようにすることです。ユーザーデフォルトのキーは `GenerativeAIAllowed` です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대규모 언어 모델 API 사용을 허용하겠습니까?\n이 설정은 관리되는 환경에서 LLM 사용을 쉽게 비활성화할 수 있도록 하기 위한 것입니다. 사용자 기본값 키는 `GenerativeAIAllowed`입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillate bruk av API-er for store språkmodeller?\nFormålet med denne innstillingen er å gjøre det enkelt for administrerte miljøer å deaktivere bruk av LLM-er. Brukerstandardnøkkelen er `GenerativeAIAllowed`."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gebruik van API’s voor grote taalmodellen toestaan?\nDeze instelling is bedoeld om het voor beheerde omgevingen eenvoudig te maken het gebruik van LLM’s uit te schakelen. De sleutel in de gebruikersstandaarden is `GenerativeAIAllowed`."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwolić na używanie API dużych modeli językowych?\nCelem tego ustawienia jest ułatwienie środowiskom zarządzanym wyłączenia używania LLM. Kluczem w ustawieniach domyślnych użytkownika jest `GenerativeAIAllowed`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir o uso de APIs de grandes modelos de linguagem?\nO propósito deste ajuste é facilitar que ambientes gerenciados desativem o uso de LLMs. A chave de user defaults é `GenerativeAIAllowed`."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить использование API больших языковых моделей?\nЦель этой настройки — упростить управляемым средам отключение использования LLM. Ключ пользовательских настроек — `GenerativeAIAllowed`."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť používanie API veľkých jazykových modelov?\nÚčelom tohto nastavenia je uľahčiť spravovaným prostrediam vypnutie používania LLM. Kľúč užívateľských predvolieb je `GenerativeAIAllowed`."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovoli uporabo API velikih jezikovnih modelov?\nNamen te nastavitve je upravljanim okoljem olajšati onemogočenje uporabe LLM. Ključ uporabniških privzetih nastavitev je `GenerativeAIAllowed`."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåta användning av API:er för stora språkmodeller?\nSyftet med den här inställningen är att göra det enkelt för hanterade miljöer att avaktivera användning av LLM:er. Nyckeln i användarens förval är `GenerativeAIAllowed`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük dil modeli API’lerinin kullanımına izin verilsin mi?\nBu ayarın amacı, yönetilen ortamların LLM kullanımını kolayca devre dışı bırakmasını sağlamaktır. Kullanıcı varsayılanları anahtarı `GenerativeAIAllowed` değeridir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép dùng các API mô hình ngôn ngữ lớn?\nMục đích của cài đặt này là giúp các môi trường được quản lý dễ dàng tắt việc dùng LLM. Khóa user defaults là `GenerativeAIAllowed`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许使用大型语言模型API？\n设置此选项的目的是便于受管理环境禁用LLM的使用。用户的默认值为`GenerativeAIAllowed`。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許使用大型語言模型 API？\n此設定的目的是讓受管理的環境能輕鬆停用 LLM 的使用。使用者預設值的鍵為 `GenerativeAIAllowed`。"
          }
        }
      }
    },
    "AdvancedSetting.gitSearchPath" : {
      "comment" : "Advanced setting: gitSearchPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH použitá při spouštění gitu pro součást stavového řádku.\nZměňte pro použití vlastní instalace gitu. Aby se změna projevila, musíte iTerm2 restartovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, der bruges, når git køres til statuslinjekomponenten.\nÆndr dette for at bruge en brugerdefineret installation af git. Du skal starte iTerm2 igen, for at en ændring her træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, das beim Ausführen von git für die Statusleisten-Komponente verwendet wird.\nÄndern Sie dies, um eine benutzerdefinierte Installation von git zu verwenden. Sie müssen iTerm2 neu starten, damit eine Änderung hier wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "$PATH used when running git for the status bar component.\nChange this to use a custom install of git. You must restart iTerm2 for a change here to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usado al ejecutar git para el componente de la barra de estado.\nCámbialo para usar una instalación personalizada de git. Debes reiniciar iTerm2 para que un cambio aquí surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, jota käytetään gitiä suoritettaessa tilapalkin osaa varten.\nMuuta tätä käyttääksesi gitin mukautettua asennusta. iTerm2 on käynnistettävä uudelleen, jotta muutos tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH utilisé pour exécuter git pour le composant de la barre d’état.\nModifiez-le pour utiliser une installation personnalisée de git. Vous devez redémarrer iTerm2 pour que la modification prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usato quando si esegue git per il componente della barra di stato.\nModificalo per usare un’installazione personalizzata di git. Devi riavviare iTerm2 affinché la modifica abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーコンポーネント用に git を実行する際に使用する $PATH。\ngit のカスタムインストールを使用するにはこれを変更してください。ここでの変更を反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대 구성 요소에서 git을 실행할 때 사용하는 $PATH.\n사용자 지정 설치된 git을 사용하려면 이 값을 변경하십시오. 변경 사항을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH som brukes når git kjøres for statuslinjekomponenten.\nEndre dette for å bruke en egendefinert installasjon av git. Du må starte iTerm2 på nytt for at en endring her skal tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH die wordt gebruikt bij het uitvoeren van git voor het statusbalkonderdeel.\nWijzig dit om een aangepaste installatie van git te gebruiken. Je moet iTerm2 herstarten om een wijziging hier door te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH używany przy uruchamianiu gita dla składnika paska stanu.\nZmień, aby użyć własnej instalacji gita. Aby zmiana tutaj zaczęła działać, musisz uruchomić iTerm2 ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usado ao executar o git para o componente da barra de status.\nAltere isto para usar uma instalação personalizada do git. Você deve reiniciar o iTerm2 para que uma alteração aqui tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, используемый при запуске git для компонента строки состояния.\nИзмените это, чтобы использовать пользовательскую установку git. Для вступления изменения в силу нужно перезапустить iTerm2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH používaná pri spúšťaní git pre komponent stavovej lišty.\nZmeňte ju na použitie vlastnej inštalácie git. Aby sa zmena prejavila, musíte reštartovať iTerm2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, uporabljen pri zagonu git za komponento vrstice stanja.\nSpremenite za uporabo namestitve git po meri. Za uveljavitev spremembe morate znova zagnati iTerm2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH som används när git körs för statusfältskomponenten.\nÄndra detta för att använda en anpassad installation av git. Du måste starta om iTerm2 för att en ändring här ska börja gälla."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum çubuğu bileşeni için git çalıştırılırken kullanılan $PATH.\nÖzel bir git kurulumu kullanmak için bunu değiştirin. Buradaki değişikliğin etkili olması için iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH dùng khi chạy git cho thành phần thanh trạng thái.\nĐổi giá trị này để dùng bản cài đặt git tùy chỉnh. Bạn phải khởi động lại iTerm2 để thay đổi ở đây có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于状态栏组件的git运行时的$PATH路径。\n可更改此值以使用自定义安装的git版本。此处所做的更改需重启iTerm2才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為狀態列元件執行 git 時所使用的 $PATH。\n變更此項可使用自訂安裝的 git。你必須重新啟動 iTerm2，這裡的變更才會生效。"
          }
        }
      }
    },
