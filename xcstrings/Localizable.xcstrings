    "PTYSession.ResizePrompt" : {
      "comment" : "Prompt asking whether to allow a program to resize the window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm hat versucht, die Fenstergröße zu ändern. Erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A program has tried to resize the window. Allow it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa ha intentado cambiar el tamaño de la ventana. ¿Permitirlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme a tenté de redimensionner la fenêtre. L’autoriser ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma ha tentato di ridimensionare la finestra. Vuoi consentirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プログラムがウィンドウのサイズ変更を試みました。許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 윈도우 크기를 조절하려고 했습니다. 허용하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um programa tentou redimensionar a janela. Permitir?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программа попыталась изменить размер окна. Разрешить это?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir program pencereyi yeniden boyutlandırmaya çalıştı. İzin verilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程序尝试调整窗口大小。允许吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有程式嘗試調整視窗大小。要允許嗎？"
          }
        }
      }
    },
    "PTYSession.ResizeReportingLeftOn" : {
      "comment" : "Announcement offering to turn off resize reporting that was left enabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anscheinend wurde die Größenänderungs-Berichterstattung aktiviert gelassen, als eine SSH-Sitzung unerwartet endete oder sich eine App fehlerhaft verhielt. Ausschalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like resize reporting was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que el informe del cambio de tamaño se quedó activado cuando una sesión ssh terminó de forma inesperada o una app se comportó mal. ¿Desactivarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que le signalement du redimensionnement soit resté activé après la fin inattendue d’une session ssh ou le dysfonctionnement d’une app. Le désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che la segnalazione del ridimensionamento sia rimasta attiva dopo la fine inattesa di una sessione ssh o il malfunzionamento di un’app. Vuoi disattivarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが予期せず終了したか、アプリが誤動作したため、リサイズレポートがオンのままになっているようです。オフにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 세션이 예기치 않게 종료되었거나 앱이 오작동하여 크기 조절 리포팅이 켜진 채로 남아 있는 것 같습니다. 끄겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que o relatório de redimensionamento ficou ativado quando uma sessão ssh terminou inesperadamente ou um app se comportou mal. Desativá-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, отслеживание изменения размера окна осталось включённым после неожиданного завершения SSH-сессии или сбоя приложения. Отключить его?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ssh oturumu beklenmedik şekilde sona erdiğinde veya bir uygulama hatalı davrandığında yeniden boyutlandırma raporlama açık kalmış gibi görünüyor. Kapatılsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来 ssh 会话意外结束或应用异常时，调整大小上报仍处于开启状态。要关闭吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看來在 ssh 工作階段意外結束或 App 行為異常時，調整大小回報被保持開啟。要將它關閉嗎？"
          }
        }
      }
    },
