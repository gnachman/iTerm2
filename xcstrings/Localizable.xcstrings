    "AdvancedSetting.asyncPreconvertStrings" : {
      "comment" : "Advanced setting: asyncPreconvertStrings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předkonvertovat dlouhé řetězce mimo ASCII ve frontě na pozadí.\nTím se předkonverze odděluje od vlákna analyzátoru pro lepší propustnost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forkonverter lange strenge uden ASCII-tegn i en baggrundskø.\nDette adskiller forkonvertering fra parsertråden for bedre gennemløb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lange Nicht-ASCII-Zeichenfolgen in einer Hintergrundwarteschlange vorkonvertieren.\nDies entkoppelt die Vorkonvertierung vom Parser-Thread für einen besseren Durchsatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pre-convert long non-ASCII strings on a background queue.\nThis decouples preconversion from the parser thread for better throughput."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preconvertir las cadenas largas no ASCII en una cola en segundo plano.\nEsto desacopla la preconversión del hilo del analizador para lograr un mejor rendimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esimuunna pitkät ei-ASCII-merkkijonot taustajonossa.\nTämä erottaa esimuunnoksen jäsennyssäikeestä paremman läpäisykyvyn saavuttamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préconvertir les longues chaînes non ASCII dans une file d’arrière-plan.\nCela découple la préconversion du thread d’analyse pour un meilleur débit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre-converti le stringhe lunghe non ASCII in una coda in background.\nQuesto separa la pre-conversione dal thread del parser per un throughput migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い非 ASCII 文字列をバックグラウンドキューで事前変換します。\nこれにより、事前変換をパーサースレッドから分離し、スループットを向上させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 큐에서 긴 비ASCII 문자열을 미리 변환.\n처리량을 높이기 위해 사전 변환을 파서 스레드와 분리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhåndskonverter lange ikke-ASCII-strenger i en bakgrunnskø.\nDette kobler forhåndskonverteringen fra parsertråden for bedre gjennomstrømming."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet lange niet-ASCII-tekenreeksen vooraf om in een achtergrondwachtrij.\nHierdoor is de voorconversie losgekoppeld van de parserthread voor een betere doorvoer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstępnie konwertuj długie ciągi spoza ASCII w kolejce w tle.\nOddziela to wstępną konwersję od wątku parsera, co poprawia przepustowość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-converter strings longas não-ASCII em uma fila em segundo plano.\nIsso desacopla a pré-conversão da thread do analisador para melhor taxa de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительно преобразовывать длинные строки не из ASCII в фоновой очереди.\nЭто отделяет предварительное преобразование от потока разбора для повышения пропускной способности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predkonvertovať dlhé reťazce mimo ASCII vo fronte na pozadí.\nTým sa predkonverzia oddelí od vlákna parsera pre lepšiu priepustnosť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predpretvori dolge nize, ki niso ASCII, v čakalni vrsti v ozadju.\nTo loči predpretvorbo od niti razčlenjevalnika za boljšo prepustnost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
