    "AdvancedSetting.underlineCursorOffset" : {
      "comment" : "Advanced setting: underlineCursorOffset",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svislý posun kurzoru ve tvaru podtržení.\nKladné hodnoty ho posouvají nahoru, záporné dolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lodret forskydning af understregningsmarkøren.\nPositive værdier flytter den op, negative værdier flytter den ned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikaler Versatz für den Unterstrich-Cursor.\nPositive Werte verschieben ihn nach oben, negative Werte nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
