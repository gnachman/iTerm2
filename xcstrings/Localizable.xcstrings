    "Tip.0055.Body" : {
      "comment" : "Tip of the day body, id 0055",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledejte URL přes „Úpravy > Hledat > Hledat URL“. Mezi výsledky se pohybujete pomocí ⌘G a ⇧⌘G. Aktuální výběr otevřete pomocí ⌥⌘O."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg efter URL’er med “Rediger > Find > Find URL’er”. Gå gennem søgeresultaterne med ⌘G og ⇧⌘G. Åbn den aktuelle markering med ⌥⌘O."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen Sie nach URLs mit „Bearbeiten > Suchen > URLs suchen“. Navigieren Sie mit ⌘G und ⇧⌘G durch die Suchergebnisse. Öffnen Sie die aktuelle Auswahl mit ⌥⌘O."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Search for URLs using “Edit > Find > Find URLs.” Navigate search results with ⌘G and ⇧⌘G. Open the current selection with ⌥⌘O."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca URLs con “Edición > Buscar > Buscar URLs”. Navega por los resultados con ⌘G y ⇧⌘G. Abre la selección actual con ⌥⌘O."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hae URL-osoitteita komennolla ”Muokkaa > Etsi > Etsi URL-osoitteita”. Selaa hakutuloksia näppäimillä ⌘G ja ⇧⌘G. Avaa nykyinen valinta painamalla ⌥⌘O."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez des URL avec « Édition > Rechercher > Rechercher des URL ». Parcourez les résultats avec ⌘G et ⇧⌘G. Ouvrez la sélection actuelle avec ⌥⌘O."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca gli URL con “Modifica > Trova > Trova URL”. Scorri i risultati con ⌘G e ⇧⌘G. Apri la selezione corrente con ⌥⌘O."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 検索 > URLを検索」を使ってURLを検索できます。⌘Gと⇧⌘Gで検索結果を移動し、⌥⌘Oで現在の選択範囲を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“편집 > 찾기 > URL 찾기”를 사용하여 URL을 검색하십시오. ⌘G 및 ⇧⌘G로 검색 결과 사이를 이동하고, ⌥⌘O로 현재 선택 항목을 열 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk etter URL-er med «Rediger > Finn > Finn URL-er». Naviger i søkeresultatene med ⌘G og ⇧⌘G. Åpne gjeldende markering med ⌥⌘O."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek naar URL’s met ‘Wijzig > Zoek > Zoek URL’s’. Navigeer door de zoekresultaten met ⌘G en ⇧⌘G. Open de huidige selectie met ⌥⌘O."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj adresów URL przez „Edycja > Znajdź > Znajdź adresy URL”. Poruszaj się po wynikach skrótami ⌘G i ⇧⌘G. Otwórz bieżące zaznaczenie skrótem ⌥⌘O."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque URLs usando “Editar > Buscar > Buscar URLs”. Navegue pelos resultados da busca com ⌘G e ⇧⌘G. Abra a seleção atual com ⌥⌘O."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищите URL-адреса с помощью «Правка > Найти > Найти URL-адреса». Переходите между результатами поиска с помощью ⌘G и ⇧⌘G. Открывайте текущее выделение с помощью ⌥⌘O."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hľadajte URL cez menu „Upraviť > Nájsť > Nájsť URL“. Výsledkami sa pohybujete pomocou ⌘G a ⇧⌘G. Aktuálny výber otvoríte pomocou ⌥⌘O."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL-je poiščite z »Uredi > Poišči > Poišči URL-je«. Po rezultatih se pomikate z ⌘G in ⇧⌘G. Trenutni izbor odprete z ⌥⌘O."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök efter URL:er med ”Redigera > Sök > Sök efter URL:er”. Navigera bland sökträffarna med ⌘G och ⇧⌘G. Öppna den aktuella markeringen med ⌥⌘O."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Düzen > Bul > URL’leri Bul” ile URL arayın. Arama sonuçları arasında ⌘G ve ⇧⌘G ile gezinin. Geçerli seçimi ⌥⌘O ile açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm URL bằng “Sửa > Tìm > Tìm URL.” Di chuyển giữa các kết quả tìm kiếm bằng ⌘G và ⇧⌘G. Mở vùng chọn hiện tại bằng ⌥⌘O."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“编辑 > 查找 > 查找 URL”功能进行 URL 搜索。可通过 ⌘G 和 ⇧⌘G 浏览搜索结果，用 ⌥⌘O 打开当前选中项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「編輯 > 尋找 > 尋找 URL」搜尋 URL。用 ⌘G 和 ⇧⌘G 瀏覽搜尋結果，用 ⌥⌘O 打開目前的選取項目。"
          }
        }
      }
    },
