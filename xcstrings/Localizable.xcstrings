    "HotKeyMigration.ChangesToMakeBody" : {
      "comment" : "Body explaining which settings to add; first %@ is the profile name, second %@ is the file name, third %@ is the settings text",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie diese Einstellungen zum Profil „%1$@“ in „%2$@“ hinzu:\n%3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add these settings to the profile named “%1$@” in “%2$@”:\n%3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
