    "AIPluginClient.VersionMismatch" : {
      "comment" : "Error message when the AI plugin version does not match the version iTerm2 expects",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Plugin hat Version %1$@, aber iTerm2 erwartet %2$@. Aktualisieren Sie eines von beiden oder beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plugin has version %1$@ but iTerm2 expects %2$@. Upgrade one or both."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインのバージョンは%1$@ですが、iTerm2は%2$@を想定しています。どちらか、または両方をアップグレードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플러그인 버전은 %1$@이지만 iTerm2는 %2$@ 버전을 요구합니다. 둘 중 하나 또는 둘 다 업그레이드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O plugin tem a versão %1$@, mas o iTerm2 espera a %2$@. Atualize um ou ambos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия плагина %1$@, но iTerm2 ожидает %2$@. Обновите один из компонентов или оба."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件版本为%1$@，但iTerm2期望%2$@。请升级其中一个或两个。"
          }
        }
      }
    },
