    "NaggingController.JSONPromotion" : {
      "comment" : "Announcement offering to pretty-print a JSON selection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist aber ein ganz schön unübersichtlicher JSON-Blob! iTerm2 kann diese schwer lesbare Auswahl durch eine hübsch formatierte Version ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That's a gnarly JSON blob you've got there! iTerm2 can replace this hard-to-read selection with a pretty-printed value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Menudo bloque de JSON tienes ahí! iTerm2 puede reemplazar esta selección difícil de leer por un valor con formato legible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voilà un sacré bloc JSON ! iTerm2 peut remplacer cette sélection difficile à lire par une version mise en forme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che brutto blocco JSON hai lì! iTerm2 può sostituire questa selezione difficile da leggere con un valore formattato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それは読みにくいJSONの塊ですね!iTerm2はこの読みにくい選択範囲を、整形済みの値に置き換えることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꽤 읽기 힘든 JSON 덩어리군요! iTerm2가 읽기 어려운 이 선택 영역을 보기 좋게 정리된 값으로 대치할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que bloco de JSON complicado você tem aí! O iTerm2 pode substituir esta seleção difícil de ler por um valor formatado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас тут довольно запутанный JSON! iTerm2 может заменить это трудночитаемое выделение на аккуратно отформатированное значение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elinizdeki JSON epey karmaşık! iTerm2, okunması zor bu seçimi biçimlendirilmiş bir değerle değiştirebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你选中的是一段难以阅读的 JSON 数据！iTerm2 可以将其替换为美化排版后的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你這裡有一大坨難以閱讀的 JSON！iTerm2 可以將這個難以閱讀的選取內容取代為格式化的值。"
          }
        }
      }
    },
    "NaggingController.MouseReportingFrustration" : {
      "comment" : "Prompt asking whether to disable mouse reporting when it blocks selection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht so aus, als würden Sie versuchen, etwas in die Zwischenablage zu kopieren, aber die Mausberichterstattung hat die Auswahl verhindert. Mausberichterstattung deaktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like you’re trying to copy to the pasteboard, but mouse reporting has prevented making a selection. Disable mouse reporting?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que intentas copiar al portapapeles, pero el informe del ratón ha impedido hacer una selección. ¿Desactivar el informe del ratón?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous essayiez de copier dans le presse-papiers, mais le signalement de la souris a empêché la sélection. Désactiver le signalement de la souris ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu stia cercando di copiare negli Appunti, ma la segnalazione del mouse ha impedito di effettuare una selezione. Disabilitare la segnalazione del mouse?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストボードにコピーしようとしているようですが、マウスレポートが有効なため選択できないようです。マウスレポートを無効にしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드에 복사하려는 것 같지만 마우스 리포팅 때문에 선택할 수 없습니다. 마우스 리포팅을 끄겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está tentando copiar para a área de transferência, mas o relatório do mouse impediu a seleção. Desativar o relatório do mouse?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы пытаетесь скопировать текст в буфер обмена, но отчёты о мыши мешают сделать выделение. Отключить отчёты о мыши?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoya kopyalamaya çalışıyor gibisiniz ancak fare raporlama seçim yapılmasını engelledi. Fare raporlama devre dışı bırakılsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来你想拷贝到剪贴板，但鼠标报告功能阻止了选区操作。要停用鼠标报告吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
