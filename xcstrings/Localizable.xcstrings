        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링하면 이 Mac이 iPhone의 iTerm2 Buddy 앱에 연결됩니다. 지금 앱을 설치한 다음 돌아와서 계속하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
