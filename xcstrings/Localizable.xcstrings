    "KeysPreferences.TouchBarItemAddedDescription" : {
      "comment" : "Notification body explaining how to enable a newly added Touch Bar item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie „Darstellung“ > „Touch Bar anpassen“, um Ihr neues Touch Bar-Element zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select View > Customize Touch Bar to enable your new touch bar item."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona Visualización > Personalizar Touch Bar para activar tu nuevo ítem de la Touch Bar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Présentation > Personnaliser la Touch Bar pour activer votre nouvel élément de la Touch Bar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona Vista > Personalizza Touch Bar per abilitare il nuovo elemento della Touch Bar."
          }
        },
        "ja" : {
