    "AISafetyCheck.EnablePromptBody" : {
      "comment" : "Body of the prompt asking whether to enable command safety checking",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann KI verwenden, um die Sicherheit von Befehlen zu überprüfen, die von Ihrem KI-Agenten vorgeschlagen werden. Möchten Sie die Sicherheitsüberprüfung aktivieren?\n\nWenn aktiviert, wird jeder vorgeschlagene Befehl zur Sicherheitsüberprüfung an Ihren konfigurierten KI-Anbieter gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can use AI to check the safety of commands suggested by your AI agent. Would you like to enable safety checking?\n\nWhen enabled, each proposed command will be sent to your configured AI provider for a safety check."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、AIエージェントが提案するコマンドの安全性をAIでチェックできます。安全性チェックを有効にしますか？\n\n有効にすると、提案された各コマンドが安全性チェックのために設定済みのAIプロバイダーに送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 AI를 사용하여 AI 에이전트가 제안한 명령의 안전성을 검사할 수 있습니다. 안전성 검사를 켜겠습니까?\n\n켜면 제안된 각 명령이 안전성 검사를 위해 구성된 AI 제공업체에게 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode usar IA para verificar a segurança dos comandos sugeridos pelo seu agente de IA. Deseja ativar a verificação de segurança?\n\nQuando ativada, cada comando proposto será enviado ao provedor de IA configurado para uma verificação de segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может использовать ИИ для проверки безопасности команд, предложенных вашим ИИ-агентом. Включить проверку безопасности?\n\nПри включении каждая предложенная команда будет отправляться настроенному поставщику ИИ для проверки безопасности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以使用 AI 检查你的 AI 智能体建议的命令是否安全。要启用安全检查吗？\n\n启用后，每条建议的命令都将发送给你配置的 AI 提供者进行安全检查。"
          }
        }
      }
    },
    "AISafetyCheck.EnablePromptHeading" : {
      "comment" : "Heading of the prompt asking whether to enable command safety checking",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehlssicherheitsprüfung aktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable Command Safety Checking?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
