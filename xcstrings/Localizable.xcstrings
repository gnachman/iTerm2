    "AdvancedSetting.focusNewSplitPaneWithFocusFollowsMouse" : {
      "comment" : "Advanced setting: focusNewSplitPaneWithFocusFollowsMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollen neue geteilte Bereiche automatisch fokussiert werden, wenn „Fokus folgt der Maus“ aktiviert ist?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When focus follows mouse is enabled, should new split panes automatically be focused?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando “El foco sigue al ratón” está activado, ¿deben recibir el foco automáticamente los nuevos paneles divididos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le focus suit la souris, les nouveaux volets scindés doivent-ils recevoir automatiquement le focus ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il focus segue il mouse è abilitato, i nuovi riquadri divisi devono ricevere automaticamente il focus?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーカスがマウスに追従する設定が有効な場合、新しい分割ペインに自動的にフォーカスしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포커스가 마우스를 따라가도록 설정된 경우 새로운 분할 패널에 자동으로 포커스를 맞춥니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o foco segue o mouse está ativado, novos painéis divididos devem ser focados automaticamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено «фокус следует за мышью», должны ли новые разделённые панели автоматически получать фокус?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Odak fareyi izlesin” etkinken yeni bölmelere otomatik odaklanılsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用“焦点跟随鼠标”功能时，新创建的分屏窗格是否应自动获得焦点？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「焦點跟隨滑鼠」時，新的分割窗格是否應自動取得焦點？"
          }
        }
      }
    },
    "AdvancedSetting.focusReportingEnabled" : {
      "comment" : "Advanced setting: focusReportingEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwendungen dürfen die Fokus-Berichterstattung aktivieren.\nDie Fokus-Berichterstattung veranlasst iTerm2, eine Escape-Sequenz zu senden, wenn eine Sitzung den Fokus erhält oder verliert. Sie kann Probleme verursachen, wenn eine SSH-Sitzung unerwartet endet, da sie dann aktiviert bleibt. Manche Benutzer deaktivieren sie deshalb lieber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps may turn on Focus Reporting.\nFocus reporting causes iTerm2 to send an escape sequence when a session gains or loses focus. It can cause problems when an ssh session dies unexpectedly because it gets left on, so some users prefer to disable it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps pueden activar el informe de foco.\nEl informe de foco hace que iTerm2 envíe una secuencia de escape cuando una sesión gana o pierde el foco. Puede causar problemas cuando una sesión ssh termina inesperadamente porque se queda activado, por lo que algunos usuarios prefieren desactivarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps peuvent activer le signalement du focus.\nLe signalement du focus fait envoyer une séquence d’échappement par iTerm2 quand une session gagne ou perd le focus. Il peut poser problème quand une session ssh meurt brutalement, car il reste activé ; certains utilisateurs préfèrent donc le désactiver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app possono attivare la segnalazione del focus.\nLa segnalazione del focus fa sì che iTerm2 invii una sequenza di escape quando una sessione ottiene o perde il focus. Può causare problemi quando una sessione ssh termina inaspettatamente perché resta attiva, quindi alcuni utenti preferiscono disabilitarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがフォーカスレポートをオンにできるようにします。\nフォーカスレポートが有効な場合、セッションがフォーカスを得たり失ったりしたときに iTerm2 はエスケープシーケンスを送信します。SSH セッションが予期せず切断された際にオンのままになってしまい問題を引き起こすことがあるため、これを無効にしたいユーザーもいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 포커스 리포팅을 켤 수 있습니다.\n포커스 리포팅을 사용하면 세션이 포커스를 얻거나 잃을 때 iTerm2가 이스케이프 시퀀스를 보냅니다. SSH 세션이 예기치 않게 종료되면 켜진 채로 남아 문제가 생길 수 있으므로 일부 사용자는 끄는 것을 선호합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps podem ativar o Relatório de foco.\nO relatório de foco faz o iTerm2 enviar uma sequência de escape quando uma sessão ganha ou perde o foco. Pode causar problemas quando uma sessão ssh morre inesperadamente porque fica ativado, então alguns usuários preferem desativá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения могут включать отчёт о фокусе.\nОтчёт о фокусе заставляет iTerm2 отправлять управляющую последовательность при получении или потере фокуса сессией. Это может вызывать проблемы, когда сессия ssh неожиданно завершается, а функция остаётся включённой, поэтому некоторые пользователи предпочитают отключать её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar Odak Raporlamayı açabilir.\nOdak raporlama, bir oturum odak kazandığında veya kaybettiğinde iTerm2’nin bir kaçış dizisi göndermesine neden olur. Açık kaldığı için bir ssh oturumu beklenmedik şekilde öldüğünde sorun çıkarabilir; bu nedenle bazı kullanıcılar devre dışı bırakmayı tercih eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用程序可能会开启焦点报告功能。\n焦点报告功能会在会话获得或失去焦点时让iTerm2发送转义序列。当SSH会话意外终止而该功能仍处于开启状态时，可能会引发问题，因此有些用户更倾向于关闭它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 可以開啟焦點回報。\n焦點回報會讓 iTerm2 在工作階段取得或失去焦點時傳送跳脫序列。當 ssh 工作階段意外中斷時，它可能因為被留在開啟狀態而造成問題，所以有些使用者偏好停用。"
          }
        }
      }
    },
    "AdvancedSetting.fontChangeAffectsBroadcastingSessions" : {
      "comment" : "Advanced setting: fontChangeAffectsBroadcastingSessions",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll das Vergrößern oder Verkleinern der Schrift in einer Sitzung, die Eingaben überträgt, alle Sitzungen betreffen, die Eingaben übertragen?\nDies gilt nur für die Änderung der Schriftgröße mit „Text vergrößern“, „Normale Textgröße“ und „Text verkleinern“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should growing or shrinking the font in a session that's broadcasting input affect all session that broadcast input?\nThis only applies to changing the font size with Make Text Bigger, Make Text Normal Size, and Make Text Smaller"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe agrandar o reducir el tipo de letra en una sesión que transmite entrada afectar a todas las sesiones que transmiten entrada?\nSolo se aplica al cambiar el tamaño del tipo de letra con Hacer el texto más grande, Tamaño de texto normal y Hacer el texto más pequeño"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrandir ou réduire la police d’une session qui diffuse la saisie doit-il affecter toutes les sessions qui diffusent la saisie ?\nCela ne concerne que la modification de la taille de police avec Agrandir le texte, Rétablir la taille normale du texte et Réduire le texte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandire o ridurre il font in una sessione che trasmette input deve influire su tutte le sessioni che trasmettono input?\nSi applica solo alla modifica della dimensione del font con Ingrandisci testo, Dimensione normale del testo e Riduci testo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力をブロードキャスト中のセッションでフォントを拡大・縮小したとき、入力をブロードキャストしているすべてのセッションに影響させますか?\nこれは、「テキストを大きくする」「テキストを標準サイズにする」「テキストを小さくする」でフォントサイズを変更する場合にのみ適用されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력을 브로드캐스트하는 세션에서 서체를 키우거나 줄이면 입력을 브로드캐스트하는 모든 세션에 적용하겠습니까?\n텍스트 크게, 텍스트 기본 크기, 텍스트 작게로 서체 크기를 변경할 때만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar ou diminuir a fonte em uma sessão que está transmitindo entrada deve afetar todas as sessões que transmitem entrada?\nIsto só se aplica a alterar o tamanho da fonte com Aumentar o texto, Tamanho normal do texto e Diminuir o texto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должно ли увеличение или уменьшение шрифта в сессии, транслирующей ввод, влиять на все сессии, транслирующие ввод?\nЭто применяется только при изменении размера шрифта командами «Увеличить текст», «Обычный размер текста» и «Уменьшить текст»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girdi yayınlayan bir oturumda fontu büyütmek veya küçültmek, girdi yayınlayan tüm oturumları etkilesin mi?\nBu yalnızca Metni Büyüt, Metni Normal Boyut Yap ve Metni Küçült ile font boyutunu değiştirmek için geçerlidir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在正在传输输入的会话中调整字体大小，是否会影响所有也在传输输入的会话？\n此规则仅适用于通过“放大文本”、“恢复文本正常大小”和“缩小文本”来调整字体大小的情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在廣播輸入的工作階段中放大或縮小字體，是否應影響所有廣播輸入的工作階段？\n這只適用於使用「放大文字」、「恢復一般文字大小」和「縮小文字」變更字體大小的情況"
          }
        }
      }
    },
    "AdvancedSetting.fontsForGenerousRounding" : {
      "comment" : "Advanced setting: fontsForGenerousRounding",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste von Schriftarten, für die ein alternativer Rundungsalgorithmus zur Berechnung der Zeilenhöhe verwendet wird.\nDies behebt Probleme mit Consolas und ahmt das Verhalten von Terminal.app unter macOS 10.15 nach. Dies ist eine durch Kommas getrennte Liste von Teilzeichenfolgen für Schriftfamilien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List of fonts to use alternate rounding algorithm for line height calculation.\nThis fixes consolas and emulates Terminal.app’s behavior on macOS 10.15. This is a comma-delimited list of font family substrings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista de tipos de letra para los que usar un algoritmo de redondeo alternativo en el cálculo de la altura de línea.\nEsto corrige consolas y emula el comportamiento de Terminal.app en macOS 10.15. Es una lista de subcadenas de familias de tipos de letra separadas por comas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste de polices pour lesquelles utiliser un autre algorithme d’arrondi dans le calcul de la hauteur de ligne.\nCela corrige consolas et émule le comportement de Terminal.app sous macOS 10.15. Il s’agit d’une liste de sous-chaînes de familles de polices séparées par des virgules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenco di font per cui usare un algoritmo di arrotondamento alternativo nel calcolo dell’altezza delle righe.\nCorregge consolas ed emula il comportamento di Terminal.app su macOS 10.15. È un elenco separato da virgole di sottostringhe del nome della famiglia di font."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行の高さの計算に別の丸めアルゴリズムを使用するフォントのリスト。\nこれにより Consolas の問題が修正され、macOS 10.15 での Terminal.app の動作をエミュレートします。フォントファミリー名の部分文字列をカンマ区切りで指定するリストです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "줄 높이 계산에 대체 반올림 알고리즘을 사용할 서체 목록입니다.\n이 옵션은 Consolas 문제를 해결하고 macOS 10.15에서 Terminal.app의 동작을 흉내 냅니다. 서체 패밀리 이름의 일부 문자열을 쉼표로 구분한 목록입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista de fontes para usar o algoritmo de arredondamento alternativo no cálculo da altura da linha.\nIsto corrige o consolas e emula o comportamento do Terminal.app no macOS 10.15. Esta é uma lista, separada por vírgulas, de substrings de família de fonte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список шрифтов, для которых используется альтернативный алгоритм округления при расчёте высоты строки.\nЭто исправляет Consolas и имитирует поведение Terminal.app в macOS 10.15. Список подстрок семейств шрифтов, разделённых запятыми."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satır yüksekliği hesabı için alternatif yuvarlama algoritmasının kullanılacağı fontların listesi.\nBu, consolas’ı düzeltir ve Terminal.app’in macOS 10.15’teki davranışını taklit eder. Font ailesi alt dizelerinin virgülle ayrılmış listesidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在线性高度计算中采用替代四舍五入算法的字体列表。\n此设置可修复consolas的问题，并模拟macOS 10.15版本中Terminal.app的行为。该列表为以逗号分隔的字体系列子串。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用替代捨入演算法計算行高的字體清單。\n這可修正 consolas，並模擬 macOS 10.15 上「終端機」App 的行為。這是以逗號分隔的字體系列子字串清單。"
          }
        }
      }
    },
    "AdvancedSetting.forceAntialiasingOnRetina" : {
      "comment" : "Advanced setting: forceAntialiasingOnRetina",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text auf Retina-Displays erzwungen glätten (Anti-Aliasing).\nAktivieren Sie dies, um auf Nicht-Retina-Displays nicht geglätteten Text zu verwenden, der manchmal besser aussieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Force text to be anti-aliased on Retina displays.\nEnable this to use non-AA text on non-retina displays, which sometimes looks better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar el suavizado del texto en pantallas Retina.\nActívalo para usar texto sin suavizado en pantallas no Retina, que a veces se ve mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forcer l’anticrénelage du texte sur les écrans Retina.\nActivez cette option pour utiliser du texte non anticrénelé sur les écrans non Retina, ce qui rend parfois mieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza l’antialiasing del testo sui display Retina.\nAbilitalo per usare testo senza antialiasing sui display non Retina, che a volte appare migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina ディスプレイでテキストを強制的にアンチエイリアス処理します。\nこれを有効にすると、非 Retina ディスプレイではアンチエイリアスなしのテキストを使用できます。こちらの方が見た目が良い場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina 디스플레이에서 텍스트에 강제로 안티앨리어싱 적용.\nRetina가 아닌 디스플레이에서 안티앨리어싱되지 않은 텍스트를 사용하려면 이 옵션을 켜십시오. 그 편이 더 보기 좋을 때가 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forçar o texto a ter anti-aliasing em telas Retina.\nAtive isto para usar texto sem AA em telas não retina, o que às vezes fica melhor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительно сглаживать текст на дисплеях Retina.\nВключите это, чтобы использовать текст без сглаживания на дисплеях, отличных от Retina, что иногда выглядит лучше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retina ekranlarda metni zorla kenar yumuşatmalı yap.\nRetina olmayan ekranlarda bazen daha iyi görünen kenar yumuşatmasız metin kullanmak için bunu etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制在视网膜显示屏上对文本进行抗锯齿处理。\n启用此选项可在非视网膜显示屏上使用非抗锯齿文本，这类文本有时看起来效果更好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制在 Retina 顯示器上對文字進行反鋸齒。\n啟用此項可在非 Retina 顯示器上使用非反鋸齒文字，有時看起來更好。"
          }
        }
      }
    },
    "AdvancedSetting.fractionOfCharacterSelectingNextNeighbor" : {
      "comment" : "Advanced setting: fractionOfCharacterSelectingNextNeighbor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil der Zeichenbreite auf der rechten Seite, der zur Auswahl des rechts benachbarten Zeichens verwendet werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fraction of character’s width on its right side that can be used to select the character to its right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fracción de la anchura de un carácter, en su lado derecho, que se puede usar para seleccionar el carácter de su derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraction de la largeur d’un caractère, sur son côté droit, qui peut servir à sélectionner le caractère à sa droite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frazione della larghezza di un carattere, sul suo lato destro, che può essere usata per selezionare il carattere alla sua destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字の右側の幅のうち、右隣の文字を選択するために使用できる割合。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 문자를 선택하는 데 사용할 수 있는, 문자 너비 중 오른쪽 부분의 비율."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fração da largura do caractere no seu lado direito que pode ser usada para selecionar o caractere à sua direita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля ширины символа с правой стороны, которая может использоваться для выбора символа справа от него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karakterin sağ tarafında, sağındaki karakteri seçmek için kullanılabilecek genişlik kesri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用于选取右侧字符的、位于该字符右侧的那部分宽度比例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字元右側可用來選取其右方字元的寬度比例。"
          }
        }
      }
    },
    "AdvancedSetting.fullHeightCursor" : {
      "comment" : "Advanced setting: fullHeightCursor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor nimmt den Zeilenabstandsbereich ein.\nWenn Zeilen einen vertikalen Abstand von mehr als 100 % haben und diese Einstellung aktiviert ist, wird die Unterkante des Cursors an der Unterkante des Abstandsbereichs ausgerichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cursor occupies line spacing area.\nIf lines have more than 100% vertical spacing and this setting is enabled the bottom of the cursor will be aligned to the bottom of the spacing area."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cursor ocupa el área de interlineado.\nSi el espaciado vertical de las líneas supera el 100% y este ajuste está activado, la parte inferior del cursor se alineará con la parte inferior del área de espaciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le curseur occupe la zone d’interligne.\nSi les lignes ont plus de 100 % d’espacement vertical et que cette option est activée, le bas du curseur est aligné sur le bas de la zone d’espacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cursore occupa l’area dell’interlinea.\nSe le righe hanno una spaziatura verticale superiore al 100% e questa impostazione è abilitata, il fondo del cursore sarà allineato al fondo dell’area di spaziatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソルが行間の領域を占めるようにします。\n行の垂直方向の間隔が 100% を超えていて、この設定が有効な場合、カーソルの下端は間隔領域の下端に揃えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서가 행 간격 영역을 차지합니다.\n행의 세로 간격이 100%보다 크고 이 설정이 켜져 있으면 커서 아래쪽이 간격 영역 아래쪽에 맞춰 정렬됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cursor ocupa a área de espaçamento entre linhas.\nSe as linhas tiverem mais de 100% de espaçamento vertical e este ajuste estiver ativado, a parte inferior do cursor será alinhada à parte inferior da área de espaçamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсор занимает область межстрочного интервала.\nЕсли строки имеют межстрочный интервал больше 100 % и эта настройка включена, нижняя часть курсора будет выровнена по нижнему краю области интервала."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç satır aralığı alanını kaplar.\nSatırların dikey aralığı %100’den fazlaysa ve bu ayar etkinse imlecin alt kenarı aralık alanının alt kenarıyla hizalanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标会占据行间距区域。\n如果行的垂直间距超过100%，且启用了此设置，则光标的底部会与间距区域的底部对齐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標佔滿行距區域。\n如果行距的垂直間距超過 100% 且啟用此設定，游標底部會與間距區域底部對齊。"
          }
        }
      }
    },
    "AdvancedSetting.fullWidthFlags" : {
      "comment" : "Advanced setting: fullWidthFlags",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einzelne Regionalindikatoren werden in voller Breite dargestellt.\nEine vollständige Flagge belegt immer zwei Spalten, was der Breite entspricht, die wcwidth für das Paar meldet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lone regional indicators render full-width.\nA complete flag is always two columns, which is the width wcwidth reports for the pair."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los indicadores regionales aislados se renderizan a anchura completa.\nUna bandera completa siempre ocupa dos columnas, que es la anchura que wcwidth informa para el par."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les indicateurs régionaux isolés s’affichent en pleine largeur.\nUn drapeau complet occupe toujours deux colonnes, soit la largeur que wcwidth signale pour la paire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli indicatori regionali isolati vengono visualizzati a larghezza intera.\nUna bandiera completa occupa sempre due colonne, che è la larghezza riportata da wcwidth per la coppia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単独の地域表示記号を全角で表示します。\n完全な国旗は常に2列分の幅になり、これはwcwidthがその組に対して報告する幅と一致します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단독 지역 표시 기호를 전각 너비로 렌더링합니다.\n완전한 국기는 항상 두 열을 차지하며, 이는 wcwidth가 그 쌍에 대해 보고하는 너비입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicadores regionais isolados são renderizados com largura total.\nUma bandeira completa ocupa sempre duas colunas, que é a largura que o wcwidth informa para o par."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельные региональные индикаторы отображаются на полную ширину.\nПолный флаг всегда занимает два столбца — именно такую ширину wcwidth сообщает для пары."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız bölgesel göstergeler tam genişlikte işlenir.\nTam bir bayrak her zaman iki sütundur; bu, wcwidth’in çift için bildirdiği genişliktir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独的区域指示符以全宽显示。\n完整的旗帜始终占两列，这也是 wcwidth 为该对字符报告的宽度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨的區域指示符號以全形寬度繪製。\n完整的旗幟一律為兩欄，這也是 wcwidth 對該組合所回報的寬度。"
          }
        }
      }
    },
    "AdvancedSetting.generativeAIAllowed" : {
      "comment" : "Advanced setting: generativeAIAllowed",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verwendung von APIs für große Sprachmodelle erlauben?\nDer Zweck dieser Einstellung besteht darin, verwalteten Umgebungen die Deaktivierung der Verwendung von LLMs zu erleichtern. Der User-Defaults-Schlüssel ist `GenerativeAIAllowed`."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow the use of large language model APIs?\nThe purpose of this setting is to make it easy for managed environments to disable the use of LLMs. The user defaults key is `GenerativeAIAllowed`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir el uso de API de modelos de lenguaje grandes?\nLa finalidad de este ajuste es facilitar que los entornos gestionados desactiven el uso de LLM. La clave de los ajustes predeterminados del usuario es `GenerativeAIAllowed`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l’utilisation des API de grands modèles de langage ?\nCe réglage permet aux environnements gérés de désactiver facilement l’utilisation des LLM. La clé des préférences utilisateur est `GenerativeAIAllowed`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire l’uso delle API dei modelli linguistici di grandi dimensioni?\nLo scopo di questa impostazione è facilitare agli ambienti gestiti la disabilitazione dell’uso degli LLM. La chiave delle preferenze utente è `GenerativeAIAllowed`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大規模言語モデル (LLM) API の使用を許可しますか?\nこの設定の目的は、管理環境で LLM の使用を簡単に無効化できるようにすることです。ユーザーデフォルトのキーは `GenerativeAIAllowed` です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대규모 언어 모델 API 사용을 허용하겠습니까?\n이 설정은 관리되는 환경에서 LLM 사용을 쉽게 비활성화할 수 있도록 하기 위한 것입니다. 사용자 기본값 키는 `GenerativeAIAllowed`입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir o uso de APIs de grandes modelos de linguagem?\nO propósito deste ajuste é facilitar que ambientes gerenciados desativem o uso de LLMs. A chave de user defaults é `GenerativeAIAllowed`."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить использование API больших языковых моделей?\nЦель этой настройки — упростить управляемым средам отключение использования LLM. Ключ пользовательских настроек — `GenerativeAIAllowed`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük dil modeli API’lerinin kullanımına izin verilsin mi?\nBu ayarın amacı, yönetilen ortamların LLM kullanımını kolayca devre dışı bırakmasını sağlamaktır. Kullanıcı varsayılanları anahtarı `GenerativeAIAllowed` değeridir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许使用大型语言模型API？\n设置此选项的目的是便于受管理环境禁用LLM的使用。用户的默认值为`GenerativeAIAllowed`。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許使用大型語言模型 API？\n此設定的目的是讓受管理的環境能輕鬆停用 LLM 的使用。使用者預設值的鍵為 `GenerativeAIAllowed`。"
          }
        }
      }
    },
    "AdvancedSetting.gitSearchPath" : {
      "comment" : "Advanced setting: gitSearchPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, das beim Ausführen von git für die Statusleisten-Komponente verwendet wird.\nÄndern Sie dies, um eine benutzerdefinierte Installation von git zu verwenden. Sie müssen iTerm2 neu starten, damit eine Änderung hier wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "$PATH used when running git for the status bar component.\nChange this to use a custom install of git. You must restart iTerm2 for a change here to take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usado al ejecutar git para el componente de la barra de estado.\nCámbialo para usar una instalación personalizada de git. Debes reiniciar iTerm2 para que un cambio aquí surta efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH utilisé pour exécuter git pour le composant de la barre d’état.\nModifiez-le pour utiliser une installation personnalisée de git. Vous devez redémarrer iTerm2 pour que la modification prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usato quando si esegue git per il componente della barra di stato.\nModificalo per usare un’installazione personalizzata di git. Devi riavviare iTerm2 affinché la modifica abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーコンポーネント用に git を実行する際に使用する $PATH。\ngit のカスタムインストールを使用するにはこれを変更してください。ここでの変更を反映するには iTerm2 を再起動する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대 구성 요소에서 git을 실행할 때 사용하는 $PATH.\n사용자 지정 설치된 git을 사용하려면 이 값을 변경하십시오. 변경 사항을 적용하려면 iTerm2를 재시작해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH usado ao executar o git para o componente da barra de status.\nAltere isto para usar uma instalação personalizada do git. Você deve reiniciar o iTerm2 para que uma alteração aqui tenha efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$PATH, используемый при запуске git для компонента строки состояния.\nИзмените это, чтобы использовать пользовательскую установку git. Для вступления изменения в силу нужно перезапустить iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum çubuğu bileşeni için git çalıştırılırken kullanılan $PATH.\nÖzel bir git kurulumu kullanmak için bunu değiştirin. Buradaki değişikliğin etkili olması için iTerm2’yi yeniden başlatmalısınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于状态栏组件的git运行时的$PATH路径。\n可更改此值以使用自定义安装的git版本。此处所做的更改需重启iTerm2才能生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為狀態列元件執行 git 時所使用的 $PATH。\n變更此項可使用自訂安裝的 git。你必須重新啟動 iTerm2，這裡的變更才會生效。"
          }
        }
      }
    },
