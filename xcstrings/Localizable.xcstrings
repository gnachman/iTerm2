    "Companion.SAS.Body" : {
      "comment" : "Explanatory paragraph on the SAS confirmation screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte 6místný kód zobrazený na vašem iPhonu. Tím se potvrdí, že párujete se svým vlastním telefonem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv den 6-cifrede kode, der vises på din iPhone. Det bekræfter, at du sammenkobler med din egen telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den 6-stelligen Code ein, der auf Ihrem iPhone angezeigt wird. Damit wird bestätigt, dass Sie mit Ihrem eigenen Telefon koppeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type the 6-digit code shown on your iPhone. This confirms you’re pairing with your own phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el código de 6 dígitos que se muestra en tu iPhone. Esto confirma que estás emparejando con tu propio teléfono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita iPhonessasi näkyvä 6-numeroinen koodi. Tämä vahvistaa, että muodostat parin omalla puhelimellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le code à 6 chiffres affiché sur votre iPhone. Cela confirme que vous associez votre propre téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita il codice di 6 cifre mostrato sul tuo iPhone. Questo conferma che stai associando il tuo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneに表示されている6桁のコードを入力してください。これにより、自分自身のiPhoneとペアリングしていることが確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에 표시된 6자리 코드를 입력하십시오. 본인의 iPhone과 페어링하고 있는지 확인하는 절차입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn den sifrede koden på seks tegn som vises på iPhone. Dette bekrefter at du parer med din egen telefon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ de code van 6 cijfers die op je iPhone wordt getoond. Hiermee bevestig je dat je met je eigen telefoon koppelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz 6-cyfrowy kod widoczny na urządzeniu iPhone. Potwierdza to, że parujesz własny telefon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o código de 6 dígitos exibido no seu iPhone. Isto confirma que você está pareando com o seu próprio telefone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите 6-значный код, показанный на вашем iPhone. Это подтверждает, что вы сопрягаетесь с собственным телефоном."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte 6-ciferný kód zobrazený na vašom iPhone. Potvrdíte tým, že párujete s vlastným telefónom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite 6-mestno kodo, prikazano na vašem iPhonu. To potrdi, da se seznanjate z lastnim telefonom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv den 6-siffriga koden som visas på din iPhone. Det bekräftar att du paras ihop med din egen telefon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzda gösterilen 6 haneli kodu yazın. Bu, kendi telefonunuzla eşleştirdiğinizi doğrular."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập mã gồm 6 chữ số hiển thị trên iPhone của bạn. Việc này xác nhận bạn đang ghép nối với chính điện thoại của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入iPhone上显示的6位代码。这用于确认您正在与自己的手机配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入 iPhone 上顯示的 6 位數代碼。這可確認你正在與自己的手機配對。"
          }
        }
      }
    },
