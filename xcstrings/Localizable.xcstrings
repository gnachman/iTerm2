    "AdvancedSetting.toolbeltFontSize" : {
      "comment" : "Advanced setting: toolbeltFontSize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost písma pásu nástrojů v bodech.\nHodnotou 0 použijete systémovou výchozí. Změna tohoto nastavení neovlivní existující okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriftstørrelse for Værktøjsbælte i punkter.\nSæt til 0 for at bruge systemets standard. Ændring af denne indstilling påvirker ikke eksisterende vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schriftgröße des Toolbelt in Punkten.\nAuf 0 setzen, um die Systemvorgabe zu verwenden. Das Ändern dieser Einstellung wirkt sich nicht auf bestehende Fenster aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toolbelt font size in points.\nSet to 0 to use the system default. Changing this setting does not affect existing windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño de letra de la caja de herramientas en puntos.\nEstablécelo en 0 para usar el predeterminado del sistema. Cambiar este ajuste no afecta a las ventanas existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työkaluvyön fonttikoko pisteinä.\nAseta 0, jos haluat käyttää järjestelmän oletusta. Tämän asetuksen muuttaminen ei vaikuta olemassa oleviin ikkunoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille de la police de la boîte à outils en points.\nDéfinissez 0 pour utiliser la valeur par défaut du système. La modification de ce réglage n’affecte pas les fenêtres existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensione del font della cassetta attrezzi in punti.\nImposta 0 per usare quella predefinita del sistema. La modifica di questa impostazione non influisce sulle finestre esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールベルトのフォントサイズ（ポイント単位）。\nシステムのデフォルトを使用するには0に設定してください。この設定を変更しても、既存のウィンドウには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 벨트 서체 크기(포인트).\n시스템 기본값을 사용하려면 0으로 설정하십시오. 이 설정을 변경해도 기존 윈도우에는 영향을 주지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontstørrelse for verktøybeltet i punkter.\nSett til 0 for å bruke systemstandarden. Endring av denne innstillingen påvirker ikke eksisterende vinduer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettergrootte van de gereedschapsriem in punten.\nStel in op 0 voor de systeemstandaard. Het wijzigen van deze instelling heeft geen invloed op bestaande vensters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmiar czcionki Pasa narzędzi w punktach.\nUstaw 0, aby użyć domyślnego systemowego. Zmiana tego ustawienia nie wpływa na istniejące okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho da fonte da Caixa de ferramentas em pontos.\nDefina como 0 para usar o padrão do sistema. Alterar este ajuste não afeta janelas existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер шрифта панели инструментов в пунктах.\nУстановите 0, чтобы использовать системное значение по умолчанию. Изменение этого параметра не влияет на уже открытые окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veľkosť písma Pásu s nástrojmi v bodoch.\nHodnotou 0 sa použije systémová predvolená. Zmena tohto nastavenia neovplyvní existujúce okná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost pisave Pasu z orodji v točkah.\nNastavite 0 za sistemsko privzeto. Sprememba te nastavitve ne vpliva na obstoječa okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typsnittsstorlek för verktygsbältet i punkter.\nAnge 0 för att använda systemets förval. Ändringen av den här inställningen påverkar inte befintliga fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç Kemeri font boyutu (punto).\nSistem varsayılanını kullanmak için 0 yapın. Bu ayarı değiştirmek mevcut pencereleri etkilemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cỡ phông chữ của đai công cụ, tính bằng point.\nĐặt 0 để dùng mặc định của hệ thống. Thay đổi cài đặt này không ảnh hưởng đến các cửa sổ hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbelt字体大小（点）。  \n设置为0则使用系统默认。更改此设置不会影响现有窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具帶字體大小，以點為單位。\n設為 0 則使用系統預設值。變更此設定不會影響現有的視窗。"
          }
        }
      }
    },
    "AdvancedSetting.trackingRunloopForLiveResize" : {
      "comment" : "Advanced setting: trackingRunloopForLiveResize",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít sledovací runloop pro živou změnu velikosti.\nUmožňuje terminálu překreslovat během tažení při změně velikosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug en tracking-runloop til live ændring af størrelse.\nDet gør det muligt for terminalen at gentegne under et træk for at ændre størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracking-Runloop für die Größenänderung in Echtzeit verwenden.\nDies ermöglicht dem Terminal, sich während eines Größenänderungsvorgangs neu zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use a tracking runloop for live resizing.\nThis allows the terminal to redraw during a resizing drag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un runloop de seguimiento para el cambio de tamaño en vivo.\nPermite que la terminal se redibuje durante un arrastre de cambio de tamaño."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä seuranta-runloopia reaaliaikaiseen koonmuutokseen.\nTämä sallii päätteen piirtää uudelleen koonmuutosvedon aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser une boucle d’exécution de suivi pour le redimensionnement en direct.\nCela permet au terminal de se redessiner pendant un glissement de redimensionnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un runloop di tracciamento per il ridimensionamento in tempo reale.\nPermette al terminale di ridisegnarsi durante il trascinamento per il ridimensionamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブリサイズ時にトラッキングランループを使用します。\nこれにより、リサイズのドラッグ中でもターミナルが再描画されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 크기 조절 시 추적 런 루프 사용\n크기 조절을 위해 드래그하는 동안 터미널을 다시 그릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk en sporingsløkke (runloop) for live størrelsesendring.\nDette lar terminalen tegnes på nytt under en dragning for å endre størrelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een tracking-runloop voor live formaatwijziging.\nHierdoor kan de terminal opnieuw tekenen tijdens het slepen om het formaat te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj śledzącej pętli runloop przy zmianie rozmiaru na żywo.\nPozwala terminalowi odrysowywać się podczas przeciągania zmieniającego rozmiar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um runloop de rastreamento para redimensionamento ao vivo.\nIsso permite que o terminal redesenhe durante um arraste de redimensionamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать tracking runloop для обновления экрана в реальном времени при изменении размера.\nЭто позволяет терминалу перерисовываться во время перетаскивания при изменении размера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použiť tracking runloop pri zmene veľkosti naživo.\nUmožňuje terminálu prekresľovať počas ťahania pri zmene veľkosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabi sledilno zanko dogodkov za sprotno spreminjanje velikosti.\nTo terminalu omogoča ponovni izris med vlečenjem za spreminjanje velikosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd en spårande runloop för live-storleksändring.\nDet låter terminalen rita om under en storleksändring med dragning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı yeniden boyutlandırma için izleme çalışma döngüsü kullan.\nBu, terminalin yeniden boyutlandırma sürüklemesi sırasında yeniden çizilmesine izin verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng vòng lặp theo dõi khi thay đổi kích thước trực tiếp.\nCho phép terminal vẽ lại trong khi kéo để đổi kích thước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用跟踪运行循环进行实时调整大小。  \n这允许终端在调整大小拖拽过程中重新绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用追蹤 runloop 進行即時調整大小。\n這讓終端機可在拖移調整大小的過程中重新繪製。"
          }
        }
      }
    },
    "AdvancedSetting.traditionalVisualBell" : {
