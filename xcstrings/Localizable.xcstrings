    "LastPass.CannotFindCLIMessage" : {
      "comment" : "Alert body when the LastPass CLI cannot be found",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die LastPass-Integration zu verwenden, muss iTerm2 wissen, wo sich die CLI-App namens „lpass“ befindet. Wählen Sie „Suchen“, um den Speicherort anzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In order to use the LastPass integration, iTerm2 needs to know where to find the CLI app named “lpass”. Select Locate to provide its location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar la integración con LastPass, iTerm2 necesita saber dónde encontrar la app de CLI llamada “lpass”. Selecciona Localizar para indicar su ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour utiliser l’intégration de LastPass, iTerm2 doit savoir où trouver l’app CLI nommée « lpass ». Cliquez sur Localiser pour indiquer son emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per usare l’integrazione con LastPass, iTerm2 deve sapere dove trovare l’app CLI chiamata “lpass”. Seleziona Individua per indicarne la posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LastPass連携を使用するには、iTerm2が「lpass」という名前のCLIアプリの場所を知る必要があります。「探す」を選択して場所を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LastPass 통합을 사용하려면 iTerm2가 “lpass”라는 CLI 앱의 위치를 알아야 합니다. 위치를 지정하려면 찾기를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar a integração com o LastPass, o iTerm2 precisa saber onde encontrar o app de CLI chamado “lpass”. Selecione Localizar para fornecer a localização dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать интеграцию с LastPass, iTerm2 нужно знать, где находится приложение командной строки с именем «lpass». Выберите «Найти», чтобы указать его расположение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LastPass entegrasyonunu kullanmak için iTerm2’nin “lpass” adlı CLI uygulamasının nerede olduğunu bilmesi gerekir. Konumunu belirtmek için “Konumunu Belirt” seçeneğini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用 LastPass 集成，iTerm2 需要知道名为“lpass”的 CLI 应用的位置。选择“定位”以提供其位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使用 LastPass 整合功能，iTerm2 需要知道名為「lpass」的 CLI App 位於何處。請選取「尋找位置」來指定其位置。"
          }
        }
      }
    },
