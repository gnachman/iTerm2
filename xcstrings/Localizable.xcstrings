        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Python-runtime van iTerm2 is een groot binair pakket (honderden MB’s) waarmee de Python-API wordt ingeschakeld door een voorgebouwde Python-omgeving te installeren die scripts kunnen gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Środowisko uruchomieniowe Pythona w iTerm2 to duży pakiet binarny (setki MB), który włącza API Pythona przez zainstalowanie gotowego środowiska Pythona, z którego mogą korzystać skrypty."
