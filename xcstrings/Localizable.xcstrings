    "AdvancedSetting.browserProxyEnabled" : {
      "comment" : "Advanced setting: browserProxyEnabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout HTTP proxy pro webový prohlížeč?\nPokud je zapnuto, veškerý provoz prohlížeče se směruje přes nakonfigurovaný server proxy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå HTTP-proxy til for webbrowseren?\nNår det er slået til, sendes al browsertrafik gennem den konfigurerede proxyserver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP-Proxy für den Webbrowser aktivieren?\nWenn aktiviert, wird der gesamte Browser-Datenverkehr über den konfigurierten Proxyserver geleitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable HTTP proxy for web browser?\nWhen enabled, routes all browser traffic through the configured proxy server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar el proxy HTTP para el navegador web?\nSi se activa, todo el tráfico del navegador se dirige a través del servidor proxy configurado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaanko HTTP-välityspalvelin käyttöön verkkoselaimessa?\nKun tämä on käytössä, kaikki selainliikenne ohjataan määritetyn välityspalvelimen kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer le proxy HTTP pour le navigateur web ?\nSi cette option est activée, tout le trafic du navigateur passe par le serveur proxy configuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare il proxy HTTP per il browser web?\nSe abilitato, instrada tutto il traffico del browser attraverso il server proxy configurato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web ブラウザ用の HTTP プロキシを有効にしますか?\n有効にすると、すべてのブラウザトラフィックが設定されたプロキシサーバー経由でルーティングされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹 브라우저에 HTTP 프록시를 활성화하겠습니까?\n활성화하면 모든 브라우저 트래픽이 구성된 프록시 서버를 거칩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivere HTTP-proxy for nettleseren?\nNår dette er aktivert, rutes all nettlesertrafikk gjennom den konfigurerte proxy-tjeneren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTP-proxy voor de webbrowser inschakelen?\nAls dit is ingeschakeld, wordt al het browserverkeer via de geconfigureerde proxyserver geleid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączyć serwer proxy HTTP dla przeglądarki?\nPo włączeniu cały ruch przeglądarki jest kierowany przez skonfigurowany serwer proxy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar proxy HTTP para o navegador web?\nQuando ativado, roteia todo o tráfego do navegador pelo servidor proxy configurado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить HTTP-прокси для веб-браузера?\nПри включении весь трафик браузера направляется через настроенный прокси-сервер."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť proxy HTTP pre webový prehliadač?\nAk je zapnuté, všetka prevádzka prehliadača sa smeruje cez nastavený proxy server."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči posrednik HTTP za spletni brskalnik?\nČe je omogočeno, usmeri ves promet brskalnika prek nastavljenega posredniškega strežnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera HTTP-proxy för webbläsaren?\nOm detta är aktiverat dirigeras all webbläsartrafik via den konfigurerade proxyservern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web tarayıcısı için HTTP proxy etkinleştirilsin mi?\nEtkinleştirildiğinde tüm tarayıcı trafiğini yapılandırılmış proxy sunucusu üzerinden yönlendirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật proxy HTTP cho trình duyệt web?\nKhi bật, mọi lưu lượng trình duyệt sẽ đi qua máy chủ proxy đã cấu hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用网页浏览器HTTP代理？  \n启用后，所有浏览器流量将通过配置的代理服务器路由。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為網頁瀏覽器啟用 HTTP 代理伺服器？\n啟用後，所有瀏覽器流量都會經由設定的代理伺服器傳送。"
          }
        }
      }
    },
