    "ClaudeCode.HookMalformed" : {
      "comment" : "Detail shown when the Claude Code settings file is not valid JSON; the interpolated value is the absolute path to settings.json",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht als JSON geparst werden. Öffnen Sie sie in einem Texteditor und prüfen Sie sie auf Syntaxfehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ couldn’t be parsed as JSON. Open it in a text editor and check it for syntax errors."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をJSONとして解析できませんでした。テキストエディタで開いて構文エラーを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
