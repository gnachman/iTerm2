    "AdvancedSetting.setCookie" : {
      "comment" : "Advanced setting: setCookie",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavit proměnnou prostředí ITERM2_COOKIE, aby šlo spouštět skripty v Pythonu bez potvrzení?\nOvlivní to jen relace vytvořené po změně tohoto nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt miljøvariablen ITERM2_COOKIE, så Python-instrukser kan startes uden bekræftelse?\nDet påvirker kun sessioner, der oprettes efter ændring af denne indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgebungsvariable ITERM2_COOKIE setzen, damit Python-Skripte ohne Bestätigung gestartet werden können?\nDies wirkt sich nur auf Sitzungen aus, die nach dem Ändern dieser Einstellung erstellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set ITERM2_COOKIE environment variable, allowing Python scripts to be launched without confirmation?\nThis will only affect sessions created after changing this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Establecer la variable de entorno ITERM2_COOKIE, para permitir iniciar scripts de Python sin confirmación?\nSolo afectará a las sesiones creadas tras cambiar este ajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetetaanko ympäristömuuttuja ITERM2_COOKIE, jotta Python-skriptit voi käynnistää ilman vahvistusta?\nTämä vaikuttaa vain istuntoihin, jotka luodaan tämän asetuksen muuttamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définir la variable d’environnement ITERM2_COOKIE, afin de pouvoir lancer des scripts Python sans confirmation ?\nCela n’affectera que les sessions créées après la modification de ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostare la variabile d’ambiente ITERM2_COOKIE, consentendo l’avvio degli script Python senza conferma?\nInfluirà solo sulle sessioni create dopo la modifica di questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITERM2_COOKIE環境変数を設定し、Pythonスクリプトを確認なしで起動できるようにするか？\nこれはこの設定を変更した後に作成されたセッションにのみ影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITERM2_COOKIE 환경 변수를 설정하여 확인 없이 Python 스크립트를 실행할 수 있도록 하겠습니까?\n이 설정을 변경한 후에 생성된 세션에만 영향을 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett miljøvariabelen ITERM2_COOKIE slik at Python-skript kan startes uten bekreftelse?\nDette påvirker bare økter som opprettes etter at denne innstillingen er endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De omgevingsvariabele ITERM2_COOKIE instellen, zodat Python-scripts zonder bevestiging kunnen worden gestart?\nDit geldt alleen voor sessies die zijn aangemaakt na het wijzigen van deze instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ustawić zmienną środowiskową ITERM2_COOKIE, umożliwiając uruchamianie skryptów Pythona bez potwierdzenia?\nWpłynie to tylko na sesje utworzone po zmianie tego ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir a variável de ambiente ITERM2_COOKIE, permitindo que scripts do Python sejam iniciados sem confirmação?\nIsto afetará apenas as sessões criadas após alterar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задавать переменную окружения ITERM2_COOKIE, позволяющую запускать сценарии Python без подтверждения?\nЭто повлияет только на сеансы, созданные после изменения этого параметра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaviť premennú prostredia ITERM2_COOKIE, aby bolo možné spúšťať skripty Python bez potvrdenia?\nOvplyvní to iba relácie vytvorené po zmene tohto nastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se nastavi spremenljivka okolja ITERM2_COOKIE, ki omogoča zagon skriptov Python brez potrditve?\nTo vpliva le na seje, ustvarjene po spremembi te nastavitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange miljövariabeln ITERM2_COOKIE så att Python-skript kan startas utan bekräftelse?\nDet påverkar bara sessioner som skapas efter att den här inställningen ändrats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITERM2_COOKIE ortam değişkeni ayarlansın mı? Bu, Python betiklerinin onay olmadan başlatılmasını sağlar.\nBu yalnızca ayar değiştirildikten sonra oluşturulan oturumları etkiler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt biến môi trường ITERM2_COOKIE, cho phép khởi chạy tập lệnh Python mà không cần xác nhận?\nChỉ ảnh hưởng đến các phiên được tạo sau khi thay đổi cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置ITERM2_COOKIE环境变量，使Python脚本无需确认即可启动？  \n仅影响更改后创建的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 ITERM2_COOKIE 環境變數，讓 Python 腳本無需確認即可啟動？\n這只會影響變更此設定之後建立的工作階段。"
          }
        }
      }
    },
    "AdvancedSetting.setIT2AppPath" : {
      "comment" : "Advanced setting: setIT2AppPath",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavit v nových relacích proměnnou prostředí IT2_APP_PATH ukazující na balíček aplikace tohoto sestavení iTerm2?\nTím se odliší cíl AppleScriptu, když běží více sestavení iTerm2 se stejným identifikátorem balíčku, aby příkaz „it2“ žádal o svůj cookie tuto instanci iTerm2. Určeno pro vývojáře iTerm2. Ovlivní jen relace vytvořené po změně tohoto nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt miljøvariablen IT2_APP_PATH i nye sessioner, så den peger på denne iTerm2-builds appbundt?\nDet gør AppleScript-målet entydigt, når flere iTerm2-builds med samme bundt-id kører, så CLI’en “it2” anmoder om sin cookie fra denne iTerm2-instans. Beregnet til iTerm2-udviklere. Påvirker kun sessioner, der oprettes efter ændring af denne indstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgebungsvariable IT2_APP_PATH bei neuen Sitzungen setzen, die auf das App-Bundle dieses iTerm2-Builds verweist?\nDies löst Mehrdeutigkeiten beim AppleScript-Ziel auf, wenn mehrere iTerm2-Builds mit derselben Bundle-ID laufen, sodass die „it2“-CLI ihren Cookie von dieser iTerm2-Instanz anfordert. Für iTerm2-Entwickler gedacht. Wirkt sich nur auf Sitzungen aus, die nach dem Ändern dieser Einstellung erstellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set IT2_APP_PATH environment variable on new sessions, pointing at this iTerm2 build’s app bundle?\nThis disambiguates the AppleScript target when multiple iTerm2 builds with the same bundle identifier are running, so that the “it2” CLI requests its cookie from this iTerm2 instance. Intended for iTerm2 developers. Only affects sessions created after changing this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Establecer la variable de entorno IT2_APP_PATH en las sesiones nuevas, apuntando al paquete de la app de esta compilación de iTerm2?\nEsto desambigua el destino de AppleScript cuando se ejecutan varias compilaciones de iTerm2 con el mismo identificador de paquete, de modo que la CLI “it2” solicite su cookie a esta instancia de iTerm2. Pensado para desarrolladores de iTerm2. Solo afecta a las sesiones creadas tras cambiar este ajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetetaanko uusissa istunnoissa ympäristömuuttuja IT2_APP_PATH, joka osoittaa tämän iTerm2-version sovelluspakettiin?\nTämä yksiselitteistää AppleScript-kohteen, kun useita samaa bundle-tunnusta käyttäviä iTerm2-versioita on käynnissä, jotta ”it2” CLI pyytää evästeensä tältä iTerm2-instanssilta. Tarkoitettu iTerm2-kehittäjille. Vaikuttaa vain istuntoihin, jotka luodaan tämän asetuksen muuttamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définir la variable d’environnement IT2_APP_PATH dans les nouvelles sessions, pointant vers le bundle de cette version d’iTerm2 ?\nCela lève l’ambiguïté de la cible AppleScript lorsque plusieurs versions d’iTerm2 ayant le même identifiant de bundle sont en cours d’exécution, afin que la CLI « it2 » demande son cookie à cette instance d’iTerm2. Destiné aux développeurs d’iTerm2. N’affecte que les sessions créées après la modification de ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostare la variabile d’ambiente IT2_APP_PATH sulle nuove sessioni, puntando al bundle dell’app di questa build di iTerm2?\nDisambigua la destinazione di AppleScript quando sono in esecuzione più build di iTerm2 con lo stesso identificatore di bundle, in modo che la CLI “it2” richieda il proprio cookie a questa istanza di iTerm2. Pensato per gli sviluppatori di iTerm2. Influisce solo sulle sessioni create dopo la modifica di questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいセッションにIT2_APP_PATH環境変数を設定し、このiTerm2ビルドのアプリバンドルを指すようにするか？\nこれは、同じバンドル識別子を持つ複数のiTerm2ビルドが実行されている場合にAppleScriptのターゲットを明確にし、「it2」CLIがこのiTerm2インスタンスからCookieを要求するようにします。iTerm2開発者向けです。この設定を変更した後に作成されたセッションにのみ影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 세션에 이 iTerm2 빌드의 앱 번들을 가리키는 IT2_APP_PATH 환경 변수를 설정하겠습니까?\n같은 번들 식별자를 가진 여러 iTerm2 빌드가 실행 중일 때 AppleScript 대상을 명확히 하여 “it2” CLI가 이 iTerm2 인스턴스에 쿠키를 요청하도록 합니다. iTerm2 개발자용입니다. 이 설정을 변경한 후 생성된 세션에만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett miljøvariabelen IT2_APP_PATH i nye økter, med peker til denne iTerm2-byggets app-pakke?\nDette skiller AppleScript-målet når flere iTerm2-bygg med samme pakkeidentifikator kjører, slik at «it2»-CLI-en ber om informasjonskapselen sin fra denne iTerm2-instansen. Beregnet på iTerm2-utviklere. Påvirker bare økter som opprettes etter at denne innstillingen er endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De omgevingsvariabele IT2_APP_PATH instellen voor nieuwe sessies, die naar de appbundel van deze iTerm2-build wijst?\nDit maakt het AppleScript-doel eenduidig wanneer meerdere iTerm2-builds met dezelfde bundel-ID draaien, zodat de CLI ‘it2’ zijn cookie bij deze iTerm2-instantie opvraagt. Bedoeld voor iTerm2-ontwikkelaars. Geldt alleen voor sessies die zijn aangemaakt na het wijzigen van deze instelling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ustawiać zmienną środowiskową IT2_APP_PATH w nowych sesjach, wskazującą pakiet aplikacji tej kompilacji iTerm2?\nPozwala to jednoznacznie wskazać cel AppleScript, gdy działa wiele kompilacji iTerm2 z tym samym identyfikatorem pakietu, aby narzędzie „it2” pobierało swoje ciasteczko z tego wystąpienia iTerm2. Przeznaczone dla deweloperów iTerm2. Wpływa tylko na sesje utworzone po zmianie tego ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definir a variável de ambiente IT2_APP_PATH em novas sessões, apontando para o app bundle deste build do iTerm2?\nIsto desambigua o alvo do AppleScript quando múltiplos builds do iTerm2 com o mesmo identificador de bundle estão em execução, para que a CLI “it2” solicite seu cookie a esta instância do iTerm2. Destinado a desenvolvedores do iTerm2. Afeta apenas as sessões criadas após alterar este ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задавать переменную окружения IT2_APP_PATH в новых сеансах, указывающую на пакет приложения этой сборки iTerm2?\nЭто устраняет неоднозначность цели AppleScript, когда одновременно запущено несколько сборок iTerm2 с одинаковым идентификатором пакета, чтобы CLI «it2» запрашивал cookie именно у этого экземпляра iTerm2. Предназначено для разработчиков iTerm2. Влияет только на сеансы, созданные после изменения этого параметра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaviť v nových reláciách premennú prostredia IT2_APP_PATH ukazujúcu na balík aplikácie tohto zostavenia iTerm2?\nTým sa spresní cieľ AppleScriptu, keď beží viacero zostavení iTerm2 s rovnakým identifikátorom balíka, takže príkaz „it2“ si vyžiada svoj cookie od tejto inštancie iTerm2. Určené pre vývojárov iTerm2. Ovplyvní iba relácie vytvorené po zmene tohto nastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se v novih sejah nastavi spremenljivka okolja IT2_APP_PATH, ki kaže na paket aplikacije te gradnje iTerm2?\nTo razloči cilj AppleScript, ko teče več gradenj iTerm2 z istim identifikatorjem paketa, tako da CLI »it2« zahteva piškotek od tega primerka iTerm2. Namenjeno razvijalcem iTerm2. Vpliva le na seje, ustvarjene po spremembi te nastavitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange miljövariabeln IT2_APP_PATH i nya sessioner, som pekar på det här iTerm2-byggets appaket?\nDet gör AppleScript-målet entydigt när flera iTerm2-byggen med samma paketidentifierare körs, så att CLI:n ”it2” begär sin cookie från den här iTerm2-instansen. Avsett för iTerm2-utvecklare. Påverkar bara sessioner som skapas efter att den här inställningen ändrats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni oturumlarda, bu iTerm2 derlemesinin uygulama paketini gösteren IT2_APP_PATH ortam değişkeni ayarlansın mı?\nBu, aynı paket tanımlayıcısına sahip birden çok iTerm2 derlemesi çalışırken AppleScript hedefini netleştirir; böylece “it2” CLI çerezini bu iTerm2 örneğinden ister. iTerm2 geliştiricileri için tasarlanmıştır. Yalnızca ayar değiştirildikten sonra oluşturulan oturumları etkiler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt biến môi trường IT2_APP_PATH trong các phiên mới, trỏ đến gói ứng dụng của bản dựng iTerm2 này?\nĐiều này phân biệt đích AppleScript khi nhiều bản dựng iTerm2 có cùng mã định danh gói đang chạy, để CLI “it2” yêu cầu cookie từ đúng phiên bản iTerm2 này. Dành cho nhà phát triển iTerm2. Chỉ ảnh hưởng đến các phiên được tạo sau khi thay đổi cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新会话中设置IT2_APP_PATH环境变量，指向此iTerm2版本的应用包？  \n当多个具有相同包标识符的iTerm2版本运行时，此设置可避免AppleScript冲突，使“it2”CLI从该实例获取cookie。适用于iTerm2开发者，仅影响更改后创建的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新的工作階段中設定 IT2_APP_PATH 環境變數，指向此 iTerm2 建置版本的 App 套件？\n當多個具有相同套件識別碼的 iTerm2 建置版本同時執行時，這可釐清 AppleScript 的目標，讓「it2」CLI 向此 iTerm2 實例要求其 cookie。供 iTerm2 開發者使用。只會影響變更此設定之後建立的工作階段。"
          }
        }
      }
    },
