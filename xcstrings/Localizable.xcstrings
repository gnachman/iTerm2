        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förbättrar ritningsprestandan på bekostnad av att alfanumeriska tecken inte kan ingå i ligaturer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alfasayısal karakterlerin bitişik harflere dahil olmasına izin vermeyerek çizim performansını artırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cải thiện hiệu năng vẽ bằng cách không cho ký tự chữ-số thuộc về chữ ghép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过禁止字母数字字符属于连字，提升绘图性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以不允許英數字元屬於連字為代價，改善繪製效能。"
          }
        }
      }
    },
    "AdvancedSetting.preferredBaseDir" : {
      "comment" : "Advanced setting: preferredBaseDir",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
