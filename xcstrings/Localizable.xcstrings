      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dialog zum Beenden/Ausblenden beim Schließen eines tmux-Tabs unterdrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress kill/hide dialog when closing a tmux tab."
