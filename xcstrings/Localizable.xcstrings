    "PasswordManager.ResetConfigurationWarning" : {
      "comment" : "Body of the warning shown before resetting a password manager integration configuration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se vymaže konfigurace iTerm2 pro tohoto správce hesel. Samotná hesla zůstanou nedotčena. Pro další používání budete muset projít několika kroky nastavení. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter konfigurationsindstillingerne i iTerm2 for denne adgangskodeadministrator. Selve adgangskoderne påvirkes ikke. Du skal gennemgå nogle opsætningstrin for at bruge den igen. Handlingen kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die iTerm2-Konfigurationseinstellungen für diesen Passwort-Manager gelöscht. Die eigentlichen Passwörter bleiben davon unberührt. Sie müssen einige Einrichtungsschritte erneut durchlaufen, um ihn wieder nutzen zu können. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will erase iTerm2’s configuration settings for this password manager. The actual passwords will remain unaffected. You’ll have to go through some setup steps to use it again. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borrará los ajustes de configuración de iTerm2 para este gestor de contraseñas. Las contraseñas en sí no se verán afectadas. Tendrás que seguir algunos pasos de configuración para volver a usarlo. Esta acción no se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa iTerm2:n määritykset tälle salasanojen hallinnalle. Varsinaisiin salasanoihin ei kosketa. Joudut käymään läpi joitakin asetusvaiheita ottaaksesi sen uudelleen käyttöön. Toimintoa ei voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera les réglages de configuration d’iTerm2 pour ce gestionnaire de mots de passe. Les mots de passe eux-mêmes ne seront pas affectés. Vous devrez suivre quelques étapes de configuration pour le réutiliser. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione cancellerà le impostazioni di configurazione di iTerm2 per questo gestore password. Le password vere e proprie non verranno modificate. Dovrai eseguire alcuni passaggi di configurazione per usarlo di nuovo. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、このパスワードマネージャーに関するiTerm2の設定が消去されます。実際のパスワードには影響しません。再度使用するにはセットアップ手順をやり直す必要があります。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 암호 관리자에 대한 iTerm2의 구성 설정이 지워집니다. 실제 암호에는 영향이 없습니다. 다시 사용하려면 몇 가지 설정 단계를 거쳐야 합니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter iTerm2s konfigurasjonsinnstillinger for denne passordbehandleren. Selve passordene påvirkes ikke. Du må gå gjennom noen oppsettstrinn for å bruke den igjen. Du kan ikke angre denne handlingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de configuratie-instellingen van iTerm2 voor deze wachtwoordbeheerder gewist. De wachtwoorden zelf blijven ongewijzigd. Je moet enkele installatiestappen doorlopen om hem weer te gebruiken. Deze actie kan niet worden hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to wymazanie ustawień konfiguracji iTerm2 dla tego menedżera haseł. Same hasła pozostaną nienaruszone. Aby ponownie z niego korzystać, trzeba będzie wykonać kilka kroków konfiguracji. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apagará as configurações do iTerm2 para este cofre de senhas. As senhas em si não serão afetadas. Você terá que passar por algumas etapas de configuração para usá-lo novamente. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приведёт к удалению настроек конфигурации iTerm2 для этого менеджера паролей. Сами пароли не будут затронуты. Чтобы снова использовать его, потребуется заново пройти настройку. Это действие нельзя отменить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tým sa vymažú konfiguračné nastavenia iTerm2 pre tohto správcu hesiel. Samotné heslá zostanú nedotknuté. Na opätovné použitie bude potrebné absolvovať niekoľko krokov nastavenia. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem boste izbrisali konfiguracijske nastavitve aplikacije iTerm2 za tega upravitelja gesel. Sama gesla ne bodo prizadeta. Za ponovno uporabo boste morali opraviti nekaj korakov nastavitve. Tega dejanja ni mogoče razveljaviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar iTerm2:s konfigurationsinställningar för den här lösenordshanteraren. Själva lösenorden påverkas inte. Du måste gå igenom några installationssteg för att använda den igen. Åtgärden kan inte ångras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, iTerm2’nin bu parola yöneticisi için yapılandırma ayarlarını siler. Gerçek parolalar etkilenmez. Yeniden kullanmak için bazı kurulum adımlarını tamamlamanız gerekir. Bu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa các cài đặt cấu hình của iTerm2 cho trình quản lý mật khẩu này. Bản thân các mật khẩu sẽ không bị ảnh hưởng. Bạn sẽ phải thực hiện một số bước thiết lập để dùng lại. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将清除 iTerm2 对此密码管理器的配置设置。实际密码不受影响。要再次使用它，你需要重新完成一些设置步骤。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會清除 iTerm2 對此密碼管理器的設定。實際的密碼不受影響。若要再次使用，你需要重新完成一些設定步驟。此操作無法還原。"
          }
        }
      }
    },
