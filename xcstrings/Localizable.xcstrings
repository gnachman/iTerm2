    "Tip.0023.Body" : {
      "comment" : "Tip of the day body, id 0023",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlost blikání kurzoru můžete nastavit v „Nastavení > Pokročilé“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan konfigurere, hvor hurtigt markøren blinker, i “Indstillinger > Avanceret”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können unter „Einstellungen > Erweitert“ festlegen, wie schnell der Cursor blinkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can configure how quickly the cursor blinks in “Settings > Advanced.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes configurar la velocidad de parpadeo del cursor en “Ajustes > Avanzado”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit määrittää, kuinka nopeasti kohdistin vilkkuu, kohdassa ”Asetukset > Lisävalinnat”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez configurer la vitesse de clignotement du curseur dans « Réglages > Avancé »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi configurare la velocità di lampeggiamento del cursore in “Impostazioni > Avanzate”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > 詳細」で、カーソルの点滅速度を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서가 깜빡이는 속도는 “설정 > 고급”에서 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan konfigurere hvor raskt markøren blinker i «Innstillinger > Avansert»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt instellen hoe snel de cursor knippert in ‘Instellingen > Geavanceerd’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkość migania kursora możesz skonfigurować w „Ustawienia > Zaawansowane”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar a velocidade de piscar do cursor em “Ajustes > Avançado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость мигания курсора можно настроить в «Настройки > Дополнительные»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rýchlosť blikania kurzora môžete nastaviť v časti „Nastavenia > Rozšírené“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitrost utripanja kazalca lahko nastavite v »Nastavitve > Napredno«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ställa in hur snabbt markören blinkar i ”Inställningar > Avancerat”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmlecin ne kadar hızlı yanıp söneceğini “Ayarlar > Gelişmiş” bölümünden yapılandırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể cấu hình tốc độ nhấp nháy của con trỏ trong “Cài đặt > Nâng cao.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在“设置 > 高级”中配置光标闪烁的速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在「設定 > 進階」中設定游標的閃爍速度。"
          }
        }
      }
    },
