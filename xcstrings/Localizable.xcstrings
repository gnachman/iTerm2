    "Tip.0026.Body" : {
      "comment" : "Tip of the day body, id 0026",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit installierter Shell-Integration können Sie die Ausgabe des letzten Befehls mit ⇧⌘A auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With Shell Integration installed, you can select the output of the last command with ⇧⌘A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la integración con el shell instalada, puedes seleccionar la salida del último comando con ⇧⌘A."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l’intégration du shell installée, vous pouvez sélectionner la sortie de la dernière commande avec ⇧⌘A."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l’integrazione shell installata, puoi selezionare l’output dell’ultimo comando con ⇧⌘A."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合をインストールしていれば、⇧⌘Aで直前のコマンドの出力を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 설치되어 있으면 ⇧⌘A로 마지막 명령의 출력을 선택할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a Shell Integration instalada, você pode selecionar a saída do último comando com ⇧⌘A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если установлена «Интеграция с оболочкой», вы можете выделить вывод последней команды с помощью ⇧⌘A."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu yüklüyken son komutun çıktısını ⇧⌘A ile seçebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Shell Integration 后，可以使用 ⇧⌘A 选择上一个命令的输出内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝 Shell 整合後，你可以使用 ⇧⌘A 選取上一個指令的輸出。"
          }
        }
      }
    },
