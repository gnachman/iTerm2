    "AdvancedSetting.unameCommand" : {
      "comment" : "Advanced setting: unameCommand",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl zum Setzen der Variable `uname`.\nDer Hauptzweck besteht darin, sie im KI-Prompt zu verwenden, damit das Sprachmodell das Betriebssystem kennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command used to set the `uname` variable.\nThe main use of this is to use in the AI prompt so the language model knows the operating system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando que se usa para establecer la variable `uname`.\nSu uso principal es en el prompt de IA, para que el modelo de lenguaje conozca el sistema operativo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commande utilisée pour définir la variable `uname`.\nElle sert principalement dans le prompt IA afin que le modèle de langage connaisse le système d’exploitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando usato per impostare la variabile `uname`.\nL’uso principale è nel prompt IA, così il modello linguistico conosce il sistema operativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`uname`変数を設定するために使用するコマンド。\n主に、言語モデルがオペレーティングシステムを認識できるようAIプロンプトで使用するためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`uname` 변수를 설정하는 데 사용하는 명령.\n주로 AI 프롬프트에서 사용하여 언어 모델이 운영 체제를 알 수 있게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando usado para definir a variável `uname`.\nO principal uso disto é no prompt de IA para que o modelo de linguagem saiba o sistema operacional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда, используемая для установки переменной `uname`.\nОсновное назначение — использование в запросе к ИИ, чтобы языковая модель знала операционную систему."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`uname` değişkenini ayarlamak için kullanılan komut.\nBunun asıl kullanımı, dil modelinin işletim sistemini bilmesi için YZ isteminde kullanılmasıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于设置 `uname`变量的命令。  \n主要用途是在AI提示词中，以便语言模型了解操作系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於設定 `uname` 變數的指令。\n主要用途是用在 AI 提示詞中，讓語言模型知道作業系統。"
          }
        }
      }
    },
