    "SCPFile.AuthenticityUnknown" : {
      "comment" : "Prompt shown when connecting to a host for the first time; first %@ is the host, second %@ is the key hash type, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Authentizität des Hosts '%1$@' kann nicht festgestellt werden.\n\nDer %2$@-Schlüssel-Fingerabdruck lautet %3$@.\n\nTrotzdem verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The authenticity of host '%1$@' can't be established.\n\n%2$@ key fingerprint is %3$@.\n\nConnect anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede establecer la autenticidad del host “%1$@”.\n\nLa huella de la clave %2$@ es %3$@.\n\n¿Conectar de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authenticité de l’hôte « %1$@ » ne peut pas être établie.\n\nL’empreinte de la clé %2$@ est %3$@.\n\nSe connecter quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile stabilire l’autenticità dell’host “%1$@”.\n\nL’impronta della chiave %2$@ è %3$@.\n\nConnettersi comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト '%1$@' の信頼性を確認できません。\n\n%2$@ 鍵のフィンガープリントは %3$@ です。\n\nこのまま接続しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 '%1$@'의 진위를 확인할 수 없습니다.\n\n%2$@ 키 지문은 %3$@입니다.\n\n그래도 연결하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível estabelecer a autenticidade do host “%1$@”.\n\nA impressão digital da chave %2$@ é %3$@.\n\nConectar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно установить подлинность узла «%1$@».\n\nОтпечаток ключа %2$@: %3$@.\n\nВсё равно подключиться?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ana makinesinin gerçekliği doğrulanamıyor.\n\n%2$@ anahtar parmak izi: %3$@.\n\nYine de bağlanılsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认主机 '%1$@' 的真实性。\n\n%2$@ 按键指纹为 %3$@。\n\n仍要连接吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認主機「%1$@」的真實性。\n\n%2$@ 金鑰指紋為 %3$@。\n\n仍要連線嗎？"
          }
        }
      }
    },
