    "NightlyBuild.OldWarning" : {
      "comment" : "Warning that the nightly build is over 30 days old",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Nightly Build ist über 30 Tage alt. Erwägen Sie ein baldiges Update: Möglicherweise leiden Sie gerade in seliger Unwissenheit unter schlimmen Fehlern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
