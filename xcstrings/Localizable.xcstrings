    "AIConnectionTester.ReviewPlaceholder" : {
      "comment" : "Result of the AI connection test when the App Review placeholder key is configured",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzhalterschlüssel in Verwendung: KI-Antworten werden für die App-Überprüfung simuliert, es wird kein externer Dienst kontaktiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Placeholder key in use: AI responses are simulated for App Review and no external service is contacted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレースホルダキーを使用中です。App Review用にAI応答がシミュレートされ、外部サービスには接続されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자리표시자 키 사용 중: App Review용으로 AI 응답을 시뮬레이션하며 외부 서비스에 연결하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave de espaço reservado em uso: as respostas de IA são simuladas para a Revisão do App e nenhum serviço externo é contatado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется ключ-заполнитель: ответы ИИ имитируются для проверки приложения, внешние службы не задействуются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用占位密钥：AI 回复为 App 审核模拟生成，不会联系任何外部服务。"
          }
        }
      }
    },
    "AIConnectionTester.SelfHostedAuthHint" : {
      "comment" : "Advice shown when a request to a self-hosted AI server fails and no credential header is configured; the placeholder is an HTTP header name such as Authorization or x-api-key, and “Custom headers” is the label of a section of the model editor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 hat mit dieser Anfrage keinen API-Schlüssel gesendet. Wenn dieser Endpunkt eine Authentifizierung erfordert, fügen Sie den Header „%@“ unter „Benutzerdefinierte Header“ hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 did not send an API key with this request. If this endpoint requires authentication, add the header “%@” under “Custom headers”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2はこのリクエストでAPIキーを送信しませんでした。このエンドポイントが認証を必要とする場合は、「カスタムヘッダー」に「%@」ヘッダーを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 이 요청에 API 키를 보내지 않았습니다. 이 엔드포인트에 인증이 필요하면 “사용자 지정 헤더” 아래에 “%@” 헤더를 추가하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não enviou uma chave de API com esta solicitação. Se este endpoint exigir autenticação, adicione o cabeçalho “%@” em “Cabeçalhos personalizados”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не отправил ключ API с этим запросом. Если этой конечной точке требуется аутентификация, добавьте заголовок «%@» в разделе «Пользовательские заголовки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 未随此请求发送 API 密钥。如果此端点需要身份验证，请在“自定义头信息”中添加“%@”头信息。"
          }
        }
      }
    },
