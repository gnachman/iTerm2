    "AdvancedSetting.requireCmdForDraggingText" : {
      "comment" : "Advanced setting: requireCmdForDraggingText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Bilder oder ausgewählten Text zu ziehen, müssen Sie ⌘ gedrückt halten. Dies verhindert versehentliches Ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To drag images or selected text, you must hold ⌘. This prevents accidental drags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para arrastrar imágenes o texto seleccionado, debes mantener pulsado ⌘. Esto evita arrastres accidentales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour faire glisser des images ou du texte sélectionné, vous devez maintenir ⌘. Cela évite les glissements accidentels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per trascinare immagini o testo selezionato, devi tenere premuto ⌘. Evita trascinamenti accidentali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像や選択したテキストをドラッグするには⌘を押しておく必要があります。これにより誤ったドラッグを防止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지나 선택한 텍스트를 드래그하려면 ⌘를 누르고 있어야 합니다. 실수로 드래그하는 것을 방지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para arrastar imagens ou texto selecionado, você precisa manter ⌘ pressionado. Isto evita arrastos acidentais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы перетаскивать изображения или выделенный текст, нужно удерживать ⌘. Это предотвращает случайные перетаскивания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntüleri veya seçili metni sürüklemek için ⌘ tuşunu basılı tutmalısınız. Bu, kazara sürüklemeleri önler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动图片或选中文本时，必须按住⌘键。这可以防止意外拖动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移影像或選取的文字時，必須按住 ⌘。這可避免意外拖移。"
          }
        }
      }
    },
    "AdvancedSetting.requireOptionToDragSplitPaneTitleBar" : {
