    "Tip.0090.Body" : {
      "comment" : "Tip of the day body, id 0090",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvářejte zkratky o dvou stisknutích pomocí „předponové zkratky“: zvláštní klávesové zkratky, která předchází vlastnímu přiřazení kláves."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret genveje med to tastetryk med en “leder”: et særligt tastetryk, der går forud for en brugerdefineret tastetildeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Tastenkombinationen aus zwei Tastenanschlägen mithilfe eines „Leaders“: einem speziellen Tastendruck, der einer benutzerdefinierten Tastenzuordnung vorausgeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create two-keystroke shortcuts with a “leader”: a special keystroke that precedes a custom key binding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea atajos de dos pulsaciones con un “líder”: una tecla especial que precede a una asignación de teclas personalizada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo kahden näppäinpainalluksen oikoteitä etuliitteellä: erityisellä näppäinpainalluksella, joka edeltää mukautettua näppäinmääritystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des raccourcis à deux frappes avec un « préfixe » : une frappe spéciale qui précède une association de touches personnalisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea abbreviazioni a due tasti con un “prefisso”: una combinazione speciale che precede un’associazione tasti personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「リーダー」(カスタムキーバインディングの前に押す特別なキー操作)を使うと、2ストロークのショートカットを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“리더”를 사용하여 두 번의 키 입력으로 된 단축키를 만들 수 있습니다. 리더는 사용자 지정 키 바인딩 앞에 누르는 특수 키 입력입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag snarveier med to tastetrykk med en «prefiks-snarvei»: et spesielt tastetrykk som kommer foran en egendefinert tastetilordning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak toetscombinaties van twee toetsaanslagen met een ‘prefixtoets’: een speciale toetsaanslag die voorafgaat aan een aangepaste toetstoewijzing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz skróty z dwóch naciśnięć za pomocą „prefiksu”: specjalnego klawisza poprzedzającego niestandardowe przypisanie klawisza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie atalhos de duas teclas com um “líder”: uma tecla especial que precede um atalho de teclado personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте двухклавишные сочетания с помощью «лидера»: специальной клавиши, которая предшествует пользовательской привязке клавиш."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte skratky z dvoch stlačení klávesov pomocou prefixovej skratky: špeciálneho stlačenia klávesu, ktoré predchádza vlastné priradenie klávesov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvarite bližnjice z dvema pritiskoma tipk s »predponsko bližnjico«: posebno tipko, ki je pred dodelitvijo tipke po meri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa kortkommandon med två tangenttryckningar med ett ”prefix”: en särskild tangenttryckning som föregår en anpassad tangentkoppling."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir “önek” ile iki tuşlu kısayollar oluşturun: özel bir tuş atamasından önce gelen özel bir tuş vuruşu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo phím tắt hai lần nhấn với “phím tiền tố”: một phím đặc biệt đứng trước một gán phím tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建一个“leader”键快捷方式：即一个位于自定义按键绑定之前的特殊按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「前置快速鍵」建立兩段式快速鍵：一個位於自訂按鍵對應之前的特殊按鍵。"
          }
        }
      }
    },
