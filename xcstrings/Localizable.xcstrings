    "Announcement.PressAnyKeyToDismiss" : {
      "comment" : "Notice appended to an announcement telling the user to press any key to dismiss it",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDrücken Sie eine beliebige Taste, um diese Meldung zu schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nPress any key to dismiss this message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPulsa cualquier tecla para descartar este mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nAppuyez sur une touche pour fermer ce message."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPremi un tasto qualsiasi per chiudere questo messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n任意のキーを押すとこのメッセージを閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n이 메시지를 닫으려면 아무 키나 누르십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPressione qualquer tecla para dispensar esta mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНажмите любую клавишу, чтобы закрыть это сообщение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBu iletiyi kapatmak için herhangi bir tuşa basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n按任意键关闭此消息。"
