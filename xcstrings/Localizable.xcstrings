    "Profiles.Window.SpacesWarning" : {
      "comment" : "Warning explaining how to configure Spaces so new windows can open in a specific space.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby se nové okno otevřelo na konkrétní ploše, ověřte, že jsou v Nastavení systému zapnuty plochy a že jsou nakonfigurovány pro přímé přepínání na plochu pomocí ^ číselných kláves."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at få et nyt vindue til at åbne på et bestemt skrivebord skal du sørge for, at flere skriveborde er slået til i Systemindstillinger, og at det er sat til at skifte direkte til et skrivebord med ^ talstaster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ein neues Fenster in einem bestimmten Space geöffnet wird, stellen Sie sicher, dass Spaces in den Systemeinstellungen aktiviert und so konfiguriert ist, dass mit ^ Zifferntasten direkt zu einem Space gewechselt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To have a new window open in a specific space, make sure that Spaces is enabled in System Preferences and that it is configured to switch directly to a space with ^ Number Keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que una nueva ventana se abra en un espacio concreto, asegúrate de que los espacios estén activados en Ajustes del Sistema y de que estén configurados para cambiar directamente a un espacio con ^ Teclas numéricas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotta uusi ikkuna avautuu tietylle työpöydälle, varmista, että työpöydät on otettu käyttöön Järjestelmäasetuksissa ja että ne on määritetty vaihtamaan suoraan työpöytään ^ numeronäppäimillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour qu’une nouvelle fenêtre s’ouvre dans un espace précis, vérifiez que les espaces sont activés dans Réglages Système et configurés pour passer directement à un espace avec les touches ^ Chiffre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aprire una nuova finestra in uno spazio specifico, assicurati che gli spazi siano abilitati in Impostazioni di Sistema e che siano configurati per passare direttamente a uno spazio con ^ Tasti numerici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新規ウインドウを特定のスペースで開くには、システム環境設定でSpacesが有効になっており、^ 数字キーで直接スペースに切り替わるよう設定されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 윈도우가 특정 Space에서 열리게 하려면 시스템 환경설정에서 Spaces가 켜져 있고 ^ 숫자 키로 Space에 바로 전환하도록 설정되어 있는지 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at et nytt vindu skal åpnes i et bestemt arbeidsområde, må du sørge for at arbeidsområder er slått på i Systeminnstillinger og at de er satt opp til å bytte direkte til et arbeidsområde med ^ Talltaster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je dat een nieuw venster in een specifieke Space opent, controleer dan of Spaces is ingeschakeld in Systeeminstellingen en is ingesteld om direct naar een Space te schakelen met ^ Cijfertoetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby nowe okno otwierało się na określonym biurku, upewnij się, że biurka są włączone w Ustawieniach systemowych i skonfigurowane tak, aby można było przełączać się bezpośrednio na biurko za pomocą ^ klawiszy numerycznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que uma nova janela abra em um espaço específico, verifique se os Espaços estão ativados nas Preferências do Sistema e configurados para alternar diretamente para um espaço com as teclas ^ Número."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы новое окно открывалось в определённом пространстве, убедитесь, что функция Spaces включена в Системных настройках и настроена на переключение непосредственно в пространство с помощью ^ Number Keys."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby sa nové okno otvorilo na konkrétnej ploche, uistite sa, že plochy sú zapnuté v Systémových nastaveniach a že sú nastavené na priame prepínanie na plochu pomocou ^ Číselných klávesov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite, da se novo okno odpre v določenem namizju Space, preverite, ali so Spaces omogočeni v Nastavitvah sistema in nastavljeni za neposredni preklop na namizje s ^ številskimi tipkami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att ett nytt fönster ska öppnas i ett visst Space måste Spaces vara aktiverat i Systeminställningar och inställt på att byta direkt till ett Space med ^ siffertangenter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir pencerenin belirli bir alanda açılması için Sistem Ayarları bölümünde alanların etkin olduğundan ve ^ Sayı Tuşları ile doğrudan bir alana geçecek şekilde yapılandırıldığından emin olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để cửa sổ mới mở trong một không gian cụ thể, hãy đảm bảo Spaces đã được bật trong Cài đặt hệ thống và được cấu hình để chuyển thẳng đến một không gian bằng ^ Phím số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要让新窗口在特定空间中打开，请确保“系统设置”中启用了“空间”，并且配置为使用 ^ 数字键直接切换空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要讓新視窗在特定空間中打開，請確定「系統設定」中已啟用「空間」，並已設定為使用 ^ 數字鍵直接切換空間。"
          }
        }
      }
    },
    "Profiles.Window.TabTitleContextMistake" : {
      "comment" : "Warning shown when a custom tab title references session variables directly instead of through the tab’s context.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento interpolovaný řetězec se vyhodnocuje v kontextu panelu, nikoli relace. Pro přístup k proměnným aktuální relace použijte currentSession.sessionVariableNameHere"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne interpolerede streng evalueres i fanens kontekst, ikke sessionens kontekst. Brug currentSession.sessionVariableNameHere for at få adgang til variabler i den aktuelle session"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese interpolierte Zeichenfolge wird im Kontext des Tabs ausgewertet, nicht im Kontext der Sitzung. Um auf Variablen der aktuellen Sitzung zuzugreifen, verwenden Sie currentSession.sessionVariableNameHere"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This interpolated string is evaluated in the tab’s context, not the session’s context. To access variables in the current session, use currentSession.sessionVariableNameHere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cadena interpolada se evalúa en el contexto de la pestaña, no en el de la sesión. Para acceder a las variables de la sesión actual, usa currentSession.sessionVariableNameHere"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä interpoloitu merkkijono arvioidaan välilehden kontekstissa, ei istunnon kontekstissa. Käytä nykyisen istunnon muuttujia varten: currentSession.sessionVariableNameHere"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette chaîne interpolée est évaluée dans le contexte de l’onglet, pas dans celui de la session. Pour accéder aux variables de la session actuelle, utilisez currentSession.sessionVariableNameHere"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa stringa interpolata viene valutata nel contesto del pannello, non in quello della sessione. Per accedere alle variabili della sessione corrente, usa currentSession.sessionVariableNameHere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この補間文字列はセッションのコンテキストではなく、タブのコンテキストで評価されます。現在のセッションの変数にアクセスするには、currentSession.sessionVariableNameHereを使用してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보간 문자열은 세션의 컨텍스트가 아닌 탭의 컨텍스트에서 평가됩니다. 현재 세션의 변수에 접근하려면 currentSession.sessionVariableNameHere를 사용하십시오"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne interpolerte strengen evalueres i fanens kontekst, ikke øktens kontekst. Bruk currentSession.sessionVariableNameHere for å få tilgang til variabler i gjeldende økt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze geïnterpoleerde tekenreeks wordt geëvalueerd in de context van het tabblad, niet in die van de sessie. Gebruik currentSession.sessionVariableNameHere om variabelen in de huidige sessie te benaderen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten ciąg interpolowany jest obliczany w kontekście karty, a nie sesji. Aby uzyskać dostęp do zmiennych bieżącej sesji, użyj currentSession.sessionVariableNameHere"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta string interpolada é avaliada no contexto da aba, não no contexto da sessão. Para acessar variáveis na sessão atual, use currentSession.sessionVariableNameHere"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта интерполированная строка вычисляется в контексте вкладки, а не в контексте сессии. Чтобы получить доступ к переменным текущей сессии, используйте currentSession.sessionVariableNameHere"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento interpolovaný reťazec sa vyhodnocuje v kontexte tabu, nie relácie. Na prístup k premenným aktuálnej relácie použite currentSession.sessionVariableNameHere"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta interpoliran niz se vrednoti v kontekstu zavihka, ne seje. Za dostop do spremenljivk trenutne seje uporabite currentSession.sessionVariableNameHere"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här interpolerade strängen utvärderas i flikens kontext, inte sessionens. Om du vill komma åt variabler i den aktuella sessionen använder du currentSession.sessionVariableNameHere"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ara değerli dize, oturumun değil sekmenin bağlamında değerlendirilir. Geçerli oturumdaki değişkenlere erişmek için currentSession.sessionVariableNameHere kullanın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuỗi nội suy này được đánh giá trong ngữ cảnh của tab, không phải của phiên. Để truy cập các biến trong phiên hiện tại, hãy dùng currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字符串在标签页上下文中被计算，而非会话上下文。要访问当前会话中的变量，请使用 currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字串是在標籤頁的環境中求值，而非工作階段的環境。若要存取目前工作階段中的變數，請使用 currentSession.sessionVariableNameHere"
          }
        }
      }
    },
