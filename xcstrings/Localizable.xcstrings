    "Tip.0100.Body" : {
      "comment" : "Tip of the day body, id 0100",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie Ihren Protokollen Zeitstempel hinzu, um die Nachverfolgung und Korrelation von Ereignissen zu verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Include timestamps in your logs for better tracking and event correlation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye marcas de tiempo en tus registros para mejorar el seguimiento y la correlación de eventos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluez des horodatages dans vos journaux pour un meilleur suivi et une meilleure corrélation des événements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includi i timestamp nei log per un migliore tracciamento e una migliore correlazione degli eventi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログにタイムスタンプを含めると、追跡やイベントの相関がわかりやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그에 타임스탬프를 포함하면 추적과 이벤트 상관관계 파악이 쉬워집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua marcações de tempo nos seus logs para melhor rastreamento e correlação de eventos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте отметки времени в журналы для лучшего отслеживания и сопоставления событий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha iyi izleme ve olay ilişkilendirme için günlüklerinize zaman damgaları ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日志中添加时间戳，以便更好地跟踪和关联事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在記錄中加入時間戳記，以便更妥善地追蹤並關聯事件。"
          }
        }
      }
    },
