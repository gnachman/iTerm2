    "StatusBarSwiftyString.DetailedDescription" : {
      "comment" : "Detailed description of the interpolated string status bar component",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das Ergebnis der Auswertung einer Zeichenfolge mit eingebetteten Ausdrücken an, die Sitzungsvariablen oder die Ausgabe registrierter Skriptfunktionen enthalten können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the evaluation of a string with inline expressions which may include session variables or the output of registered scripting functions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la evaluación de una cadena con expresiones en línea que pueden incluir variables de sesión o la salida de funciones de script registradas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l’évaluation d’une chaîne contenant des expressions en ligne, pouvant inclure des variables de session ou la sortie de fonctions de script enregistrées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la valutazione di una stringa con espressioni inline che possono includere variabili di sessione o l’output di funzioni di scripting registrate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション変数や登録済みのスクリプト関数の出力を含めることができるインライン式を持つ文字列の評価結果を表示します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 변수나 등록된 스크립팅 함수의 출력을 포함할 수 있는 인라인 표현식이 들어 있는 문자열의 평가 결과를 표시합니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o resultado da avaliação de uma string com expressões inline que podem incluir variáveis de sessão ou a saída de funções de script registradas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает результат вычисления строки со встроенными выражениями, которые могут включать переменные сессии или результат работы зарегистрированных функций сценариев"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum değişkenlerini veya kayıtlı betik işlevlerinin çıktısını içerebilen satır içi ifadeler barındıran bir dizenin değerlendirmesini gösterir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示对包含内联表达式的字符串求值的结果，这些表达式可能包含会话变量或已注册脚本函数的输出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示含有內嵌運算式的字串的求值結果，運算式可包含工作階段變數或已註冊腳本函式的輸出"
          }
        }
      }
    },
