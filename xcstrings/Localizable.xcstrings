          }
        }
      }
    },
    "PTYSession.JSONSelectionChanged" : {
      "comment" : "Warning that the selection is no longer valid JSON",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anscheinend hat sich die Auswahl geändert und ist kein gültiges JSON-Objekt mehr.\nSie finden diese Funktion unter Bearbeiten > Auswahl ersetzen > Durch formatiertes JSON ersetzen, wenn Sie es erneut versuchen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like the selection changed and is no longer a valid JSON object.\nYou can find this feature under Edit > Replace Selection > Replace with Pretty-Printed JSON if you want to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que la selección cambió y ya no es un objeto JSON válido.\nPuedes encontrar esta función en Edición > Reemplazar selección > Reemplazar por JSON con formato legible si quieres volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection a visiblement changé et n’est plus un objet JSON valide.\nVous retrouverez cette fonctionnalité dans Édition > Remplacer la sélection > Remplacer par du JSON mis en forme si vous voulez réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che la selezione sia cambiata e non sia più un oggetto JSON valido.\nSe vuoi riprovare, trovi questa funzione in Modifica > Sostituisci selezione > Sostituisci con JSON formattato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択範囲が変更され、有効なJSONオブジェクトではなくなったようです。\nもう一度試したい場合、この機能は編集 > 選択範囲を置換 > 整形されたJSONで置換 にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 영역이 변경되어 더 이상 유효한 JSON 객체가 아닌 것 같습니다.\n다시 시도하려면 편집 > 선택 영역 대치 > 보기 좋게 정렬된 JSON으로 대치에서 이 기능을 찾을 수 있습니다."
