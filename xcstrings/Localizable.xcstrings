            "value" : "윈도우 메뉴에 윈도우별 키보드 단축키를 포함하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluir atalho de teclado para janelas no menu Janela?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включать клавиатурное сочетание для окон в меню «Окно»?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere menüsünde pencereler için klavye kısayolu bulunsun mu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口菜单中是否包含窗口的键盘快捷键？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「視窗」選單中包含視窗的鍵盤快速鍵？"
          }
        }
      }
    },
    "AdvancedSetting.indicateBellsInDockBadgeLabel" : {
