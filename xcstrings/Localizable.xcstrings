    "AIKeyHint.UnrecognizedHost" : {
      "comment" : "Hint shown when a manual AI model’s endpoint is not its provider’s own server (for example a third-party gateway), where the automatic API key choice sends no key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API klíč se automaticky neodesílá, protože tento koncový bod neprovozuje poskytovatel modelu. Vyberte potřebný klíč nebo použijte vlastní hlavičku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der sendes ingen API-nøgle automatisk, da dette slutpunkt ikke drives af modellens udbyder. Vælg den nøgle, det skal bruge, eller brug en brugerdefineret header."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nicht automatisch ein API-Schlüssel gesendet, da dieser Endpunkt nicht vom Anbieter des Modells betrieben wird. Wählen Sie den benötigten Schlüssel aus oder verwenden Sie einen benutzerdefinierten Header."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No API key is sent automatically, since this endpoint is not run by the model’s provider. Choose the key it needs, or use a custom header."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía ninguna clave de API automáticamente, ya que este endpoint no lo gestiona el proveedor del modelo. Elige la clave que necesita o usa un encabezado personalizado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-avainta ei lähetetä automaattisesti, koska mallin palveluntarjoaja ei ylläpidä tätä päätepistettä. Valitse tarvittava avain tai käytä mukautettua otsaketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé d’API n’est envoyée automatiquement, car ce point de terminaison n’est pas exploité par le fournisseur du modèle. Choisissez la clé requise ou utilisez un en-tête personnalisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene inviata alcuna chiave API automaticamente, perché questo endpoint non è gestito dal provider del modello. Scegli la chiave necessaria o usa un’intestazione personalizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンドポイントはモデルのプロバイダーが運営していないため、APIキーは自動では送信されません。必要なキーを選択するか、カスタムヘッダーを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 엔드포인트는 모델 제공업체가 운영하지 않으므로 API 키가 자동으로 전송되지 않습니다. 필요한 키를 선택하거나 사용자 지정 헤더를 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen API-nøkkel sendes automatisk, siden dette endepunktet ikke drives av modellens leverandør. Velg nøkkelen det trenger, eller bruk en egendefinert hode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt niet automatisch een API-sleutel verstuurd, omdat dit eindpunt niet door de aanbieder van het model wordt beheerd. Kies de benodigde sleutel of gebruik een aangepaste header."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz API nie jest wysyłany automatycznie, ponieważ ten punkt końcowy nie jest prowadzony przez dostawcę modelu. Wybierz potrzebny klucz albo użyj własnego nagłówka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma chave de API é enviada automaticamente, pois este endpoint não é operado pelo provedor do modelo. Escolha a chave necessária ou use um cabeçalho personalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API не отправляется автоматически, так как эта конечная точка не обслуживается поставщиком модели. Выберите нужный ключ или используйте пользовательский заголовок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API kľúč sa neodosiela automaticky, keďže tento koncový bod neprevádzkuje poskytovateľ modelu. Vyberte kľúč, ktorý potrebuje, alebo použite vlastnú hlavičku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noben ključ API ni samodejno poslan, ker te končne točke ne upravlja ponudnik modela. Izberite ključ, ki ga potrebuje, ali uporabite glavo po meri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen API-nyckel skickas automatiskt, eftersom den här slutpunkten inte drivs av modellens leverantör. Välj den nyckel som behövs eller använd en anpassad rubrik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uç nokta modelin sağlayıcısı tarafından işletilmediği için API anahtarı otomatik olarak gönderilmiyor. Gereken anahtarı seçin ya da özel bir üst bilgi kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa API không được tự động gửi vì điểm cuối này không do nhà cung cấp của mô hình vận hành. Hãy chọn khóa cần dùng, hoặc dùng tiêu đề tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于此端点并非由模型的提供商运营，因此不会自动发送 API 密钥。请选择它所需的密钥，或使用自定义头信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於此端點並非由模型的供應商營運，因此不會自動傳送 API 金鑰。請選擇它所需的金鑰，或使用自訂標頭。"
          }
        }
      }
    },
