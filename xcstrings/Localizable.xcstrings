    "ClaudeHealthMonitor.BrokenTitle" : {
      "comment" : "Body of the warning shown when the Claude Code status hook is missing from settings.json; the interpolated value is the absolute path to settings.json",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der cc-status-Hook von iTerm2 befindet sich nicht mehr in %@. Das bedeutet meist, dass Claude Code diese Datei überschrieben hat. Soll der Hook neu installiert werden, damit die Statusanzeigen pro Tab („Arbeitet…“, „Wartet…“) wieder funktionieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2’s cc-status hook is no longer in %@. This usually means Claude Code rewrote that file. Reinstall the hook so per-tab status indicators (“Working…,” “Waiting…”) work again?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2のcc-statusフックが%@に存在しなくなりました。これは通常、Claude Codeがそのファイルを書き換えたことを意味します。タブごとのステータス表示（「作業中…」「待機中…」）が再び機能するように、フックを再インストールしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O hook cc-status do iTerm2 não está mais em %@. Isso geralmente significa que o Claude Code reescreveu esse arquivo. Reinstalar o hook para que os indicadores de status por aba (“Trabalhando…”, “Aguardando…”) voltem a funcionar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хук cc-status от iTerm2 больше не находится в %@. Обычно это означает, что Claude Code перезаписал этот файл. Переустановить хук, чтобы индикаторы статуса на вкладках («Работает…», «Ожидание…») снова заработали?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 cc-status 钩子已不在 %@ 中。这通常意味着 Claude Code 重写了该文件。重新安装钩子，以便每个标签页的状态指示器（“正在处理…”、“正在等待…”）重新工作？"
          }
        }
      }
    },
    "ClaudeHealthMonitor.HookNotWorkingTitle" : {
      "comment" : "Body of the warning shown when the Claude Code status hook is missing from settings.json or points at a file that can’t run; the interpolated value is the absolute path to settings.json",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 konnte in %@ nicht für jedes Claude-Code-Ereignis einen funktionierenden Status-Hook finden. Soll der Hook neu installiert werden, damit die Statusanzeigen pro Tab („Arbeitet…“, „Wartet…“) wieder funktionieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 couldn’t find a working status hook for every Claude Code event in %@. Reinstall the hook so per-tab status indicators (“Working…,” “Waiting…”) work again?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は%@で、Claude Codeのすべてのイベントに対して機能するステータスフックを見つけられませんでした。タブごとのステータス表示（「作業中…」「待機中…」）が再び機能するように、フックを再インストールしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 %@에서 모든 Claude Code 이벤트에 대해 작동하는 상태 훅을 찾을 수 없습니다. 탭별 상태 표시기(“작업 중…”, “대기 중…”)가 다시 작동하도록 훅을 다시 설치하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não encontrou em %@ um hook de status funcionando para todos os eventos do Claude Code. Reinstalar o hook para que os indicadores de status por aba (“Trabalhando…”, “Aguardando…”) voltem a funcionar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не нашёл в %@ работающего хука статуса для каждого события Claude Code. Переустановить хук, чтобы индикаторы статуса на вкладках («Работает…», «Ожидание…») снова заработали?"
          }
        },
        "zh-Hans" : {
