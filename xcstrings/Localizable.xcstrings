    "NaggingController.PasteBracketingLeftOn" : {
      "comment" : "Prompt asking whether to turn off paste bracketing",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že vkládání v závorkách zůstalo zapnuté po neočekávaném ukončení relace SSH nebo chybě aplikace. Vypnout ho?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at grupperet indsætning blev efterladt slået til, da en ssh-session sluttede uventet, eller et program opførte sig forkert. Vil du slå det fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als sei der Paste-Bracketing-Modus aktiviert geblieben, als eine ssh-Sitzung unerwartet endete oder sich eine App falsch verhalten hat. Ausschalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like paste bracketing was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que el modo de pegado entre delimitadores se quedó activado cuando una sesión ssh terminó inesperadamente o una app falló. ¿Desactivarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää siltä, että sulkeistettu sijoitus jäi päälle, kun SSH-istunto päättyi odottamatta tai sovellus toimi virheellisesti. Laitetaanko se pois päältä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que le collage délimité soit resté activé après la fin inattendue d’une session ssh ou le dysfonctionnement d’une app. Le désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che l’incolla delimitato sia rimasto attivo perché una sessione ssh è terminata inaspettatamente o un’app non ha funzionato correttamente. Disattivarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが予期せず終了したか、アプリが誤動作したため、ペーストブラケッティングがオンのままになっているようです。オフにしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 세션이 예기치 않게 종료되었거나 앱이 오작동하여 브래킷 붙여넣기가 켜진 채로 남아 있는 것 같습니다. 끄겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at avgrenset innliming ble stående på da en ssh-økt tok uventet slutt eller en app oppførte seg feil. Vil du slå det av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat geaccoladeerd plakken is blijven openstaan doordat een ssh-sessie onverwacht is beëindigd of een app zich vreemd gedroeg. Wil je het uitschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że wklejanie w nawiasach zostało włączone, gdy sesja SSH nieoczekiwanie się zakończyła lub aplikacja działała nieprawidłowo. Wyłączyć je?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que o modo de colagem entre colchetes ficou ativado quando uma sessão ssh terminou inesperadamente ou um app se comportou mal. Desativá-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, режим скобок вставки остался включённым после неожиданного завершения SSH-сессии или сбоя приложения. Отключить его?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že vkladanie so zátvorkami zostalo zapnuté po neočakávanom skončení relácie ssh alebo nesprávnom správaní aplikácie. Vypnúť ho?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da je lepljenje v oklepajih ostalo vklopljeno, ker se je seja ssh nepričakovano končala ali pa se je aplikacija napačno obnašala. Ga želite izklopiti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut som att bracketed paste lämnades på när en ssh-session avslutades oväntat eller en app betedde sig fel. Vill du stänga av det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ssh oturumu beklenmedik şekilde sona erdiğinde veya bir uygulama hatalı çalıştığında ayraçlı yapıştırma açık kalmış gibi görünüyor. Kapatılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ dán có đánh dấu đã bị để bật khi phiên ssh kết thúc bất ngờ hoặc một ứng dụng hoạt động sai. Tắt nó?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来 ssh 会话意外结束或某个应用行为异常后，粘贴括号模式仍处于开启状态。要关闭它吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起來是在 ssh 工作階段意外結束或某個 App 運作異常時，括號貼上被保持開啟。要將它關閉嗎？"
          }
        }
      }
    },
