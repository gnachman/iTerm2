    "Tip.0103.Body" : {
      "comment" : "Tip of the day body, id 0103",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugen Sie starke, sichere Passwörter mit der neuen Passwortgenerierungsfunktion des Passwort-Managers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Generate strong, secure passwords using the password manager’s new password generation feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera contraseñas seguras y robustas con la nueva función de generación de contraseñas del gestor de contraseñas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez des mots de passe robustes et sécurisés avec la nouvelle fonction de génération de mots de passe du gestionnaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera password sicure e robuste con la nuova funzione di generazione password del gestore password."
          }
