          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include le sessioni in esecuzione create da un profilo che nel frattempo è stato eliminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
