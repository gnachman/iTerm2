    "PasswordManager.RenameCouldNotReadPassword" : {
      "comment" : "Error shown when a rename is aborted because the current password could not be read",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Passwort konnte nicht gelesen werden, daher wurde das Konto nicht umbenannt. Das Umbenennen dieses Kontos würde es neu erstellen, wodurch das Passwort verloren ginge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read the current password, so the account was not renamed. Renaming this account recreates it, which would lose the password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la contraseña actual, así que la cuenta no se renombró. Al renombrar esta cuenta se vuelve a crear, lo que haría perder la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le mot de passe actuel, le compte n’a donc pas été renommé. Renommer ce compte le recrée, ce qui ferait perdre le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere la password attuale, quindi l’account non è stato rinominato. Rinominare questo account lo ricrea, e la password andrebbe persa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のパスワードを読み取れなかったため、アカウント名は変更されませんでした。このアカウント名を変更するとアカウントが再作成され、パスワードが失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 암호를 읽을 수 없어 계정 이름을 변경하지 않았습니다. 이 계정의 이름을 변경하면 계정이 다시 생성되므로 암호가 손실됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a senha atual, então a conta não foi renomeada. Renomear esta conta a recria, o que faria perder a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать текущий пароль, поэтому учётная запись не была переименована. Переименование этой учётной записи приводит к её пересозданию, что привело бы к потере пароля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli parola okunamadığı için hesap yeniden adlandırılmadı. Bu hesabı yeniden adlandırmak hesabı yeniden oluşturur ve bu da parolanın kaybolmasına yol açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取当前密码，因此账户未被重命名。重命名该账户会重新创建它，从而丢失密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取目前的密碼，因此帳號未重新命名。重新命名此帳號會將其重新建立，因而遺失密碼。"
          }
        }
      }
    },
