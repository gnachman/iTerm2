    "AdvancedSetting.indicateBellsInDockBadgeLabel" : {
      "comment" : "Advanced setting: indicateBellsInDockBadgeLabel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit počet zvonků, které zazvonily, když byla aplikace neaktivní, v odznaku ikony v Docku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv antallet af klokkesignaler, der er ringet, mens appen var inaktiv, i symbolets mærkat i Dock"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der ausgelösten Signaltöne bei inaktiver App im Badge-Label des Dock-Symbols anzeigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Indicate the number of bells rung while the app is inactive in the dock icon’s badge label"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicar en la etiqueta de la insignia del icono del Dock el número de campanas sonadas mientras la app está inactiva"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä sovelluksen ollessa epäaktiivinen soineiden äänimerkkien määrä Dock-kuvakkeen kyltissä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquer le nombre de sonneries émises pendant que l’app est inactive dans le badge de l’icône du Dock"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica nell’etichetta del badge dell’icona del Dock il numero di campanelli suonati mentre l’app è inattiva"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが非アクティブな間に鳴ったベルの回数を Dock アイコンのバッジラベルに表示します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
