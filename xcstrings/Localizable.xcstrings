          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки, а также ваши сниппеты, заметки или настройки значков изменились. Скопировать их в %@?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmenili sa nastavenia a vaše úryvky, poznámky alebo prispôsobenia ikon. Skopírovať ich do priečinka %@?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavitve ter vaši izrezki, zapiski ali prilagoditve ikon so se spremenili. Jih želite kopirati v mapo %@?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningarna och dina textsnuttar, anteckningar eller symbolanpassningar har ändrats. Vill du kopiera dem till %@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar ile parçacıklarınız, notlarınız veya simge özelleştirmeleriniz değişti. %@ konumuna kopyalansın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt và đoạn mã, ghi chú hoặc tùy chỉnh biểu tượng của bạn đã thay đổi. Sao chép chúng vào %@?"
          }
