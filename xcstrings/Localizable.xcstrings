    "IT2HostGrants.Empty" : {
      "comment" : "Shown in place of the list when no remote hosts are always allowed to use the iTerm2 API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind keine Remote-Hosts dauerhaft erlaubt. Wählen Sie „Diesen Host immer erlauben“, wenn ein Remote-Host anfragt, iTerm2 zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No remote hosts are always allowed. Choose Always Allow This Host when a remote host asks to control iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún host remoto tiene permiso permanente. Elige “Permitir siempre este host” cuando un host remoto pida controlar iTerm2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun hôte distant n’est toujours autorisé. Choisissez Toujours autoriser cet hôte lorsqu’un hôte distant demande à contrôler iTerm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun host remoto è sempre consentito. Scegli “Consenti sempre questo host” quando un host remoto chiede di controllare iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に許可されているリモートホストはありません。リモートホストがiTerm2の制御を求めてきたときに「このホストを常に許可」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 허용된 원격 호스트가 없습니다. 원격 호스트가 iTerm2 제어를 요청할 때 “이 호스트를 항상 허용”을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum host remoto tem permissão permanente. Escolha “Sempre permitir este host” quando um host remoto pedir para controlar o iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет удалённых хостов, которым всегда разрешён доступ. Выберите «Всегда разрешать этому хосту», когда удалённый хост запросит управление iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir uzak ana makineye kalıcı olarak izin verilmiyor. Bir uzak ana makine iTerm2’yi denetlemek istediğinde “Bu Ana Makineye Her Zaman İzin Ver” seçeneğini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有始终允许的远程主机。当远程主机请求控制 iTerm2 时，请选择“始终允许此主机”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有一律允許的遠端主機。當遠端主機要求控制 iTerm2 時，請選擇「一律允許此主機」。"
          }
        }
      }
    },
    "IT2HostGrants.Explanation" : {
      "comment" : "Explanation at the top of the list of remote hosts always allowed to use the iTerm2 API",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Hosts können die iTerm2-API über die SSH-Integration verwenden, ohne vorher zu fragen. Wenn Sie einen Host entfernen, fragt er bei der nächsten Verbindung wieder nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These hosts can use the iTerm2 API over SSH integration without asking first. Removing a host makes it ask again the next time it connects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos hosts pueden usar la API de iTerm2 mediante la integración con SSH sin preguntar antes. Si eliminas un host, volverá a preguntar la próxima vez que se conecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces hôtes peuvent utiliser l’API d’iTerm2 via l’intégration SSH sans demander au préalable. La suppression d’un hôte lui fera redemander l’autorisation à sa prochaine connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi host possono usare l’API di iTerm2 tramite l’integrazione SSH senza chiedere prima. Rimuovendo un host, la volta successiva che si connette chiederà di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのホストは、確認なしでSSH統合経由のiTerm2 APIを使用できます。ホストを削除すると、次回接続時に再び確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트들은 묻지 않고 SSH 통합을 통해 iTerm2 API를 사용할 수 있습니다. 호스트를 제거하면 다음에 연결할 때 다시 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes hosts podem usar a API do iTerm2 pela integração de SSH sem perguntar antes. Ao remover um host, ele voltará a perguntar na próxima vez que se conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти хосты могут использовать API iTerm2 через интеграцию по SSH без предварительного запроса. Если убрать хост, он снова запросит разрешение при следующем подключении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ana makineler, önce sormadan SSH Entegrasyonu üzerinden iTerm2 API’sini kullanabilir. Bir ana makineyi kaldırırsanız bir sonraki bağlanışında yeniden sorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些主机无需事先询问即可通过 SSH 集成使用 iTerm2 API。移除某个主机后，它下次连接时会再次询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些主機可透過 SSH 整合使用 iTerm2 API，無須事先詢問。移除主機後，它下次連線時會再次詢問。"
          }
        }
      }
    },
