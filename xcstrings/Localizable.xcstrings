    "StatusPriority.MergeWorkgroupsTooltip" : {
      "comment" : "Tooltip for the merge workgroup statuses checkbox",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, zobrazí se pouze nejnovější stav z každé pracovní skupiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er slået til, vises kun den seneste status fra hver arbejdsgruppe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird nur der neueste Status jeder Arbeitsgruppe angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, only the most recent status from each workgroup is shown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, solo se muestra el estado más reciente de cada grupo de trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun käytössä, kustakin työryhmästä näytetään vain tuorein tila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, seul l’état le plus récent de chaque groupe de travail est affiché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abilitato, viene mostrato solo lo stato più recente di ciascun gruppo di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、各ワークグループの最新のステータスのみが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 각 워크그룹의 가장 최근 상태만 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, vises bare den nyeste statusen fra hver arbeidsgruppe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld, wordt alleen de meest recente status van elke werkgroep getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, pokazywany jest tylko najnowszy stan z każdej grupy roboczej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, apenas o status mais recente de cada grupo de trabalho é mostrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, показывается только самый последний статус из каждой рабочей группы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, zobrazí sa iba najnovší stav z každej pracovnej skupiny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
