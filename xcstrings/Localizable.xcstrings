    "Tip.0051.Body" : {
      "comment" : "Tip of the day body, id 0051",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte „Minimální kontrast“ v „Nastavení > Profily > Barvy“, aby byl text vždy čitelný bez ohledu na kombinaci barvy textu a pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster “Minimumskontrast” i “Indstillinger > Profiler > Farver” for at sikre, at teksten altid er læselig, uanset kombinationen af tekst- og baggrundsfarve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie „Mindestkontrast“ unter „Einstellungen > Profile > Farben“ an, damit Text unabhängig von der Kombination aus Text- und Hintergrundfarbe immer lesbar bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust “Minimum Contrast” in “Settings > Profiles > Colors” to ensure text is always legible regardless of text/background color combination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta “Contraste mínimo” en “Ajustes > Perfiles > Colores” para asegurar que el texto sea siempre legible, sea cual sea la combinación de colores de texto y fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä asetusta ”Vähimmäiskontrasti” kohdassa ”Asetukset > Profiilit > Värit”, jotta teksti on aina luettavaa tekstin ja taustan värien yhdistelmästä riippumatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez « Contraste minimum » dans « Réglages > Profils > Couleurs » pour que le texte reste toujours lisible, quelle que soit la combinaison de couleurs du texte et de l’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola “Contrasto minimo” in “Impostazioni > Profili > Colori” per garantire che il testo sia sempre leggibile, qualunque sia la combinazione di colori del testo e dello sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」で「最小コントラスト」を調整すると、文字色と背景色の組み合わせにかかわらず、常にテキストを読みやすくできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상”에서 “최소 대비”를 조절하면 텍스트/배경 색상 조합에 관계없이 항상 텍스트를 읽을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster «Minimumskontrast» i «Innstillinger > Profiler > Farger» for å sikre at teksten alltid er lesbar uansett kombinasjon av tekst- og bakgrunnsfarge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas ‘Minimaal contrast’ aan in ‘Instellingen > Profielen > Kleuren’ om ervoor te zorgen dat tekst altijd leesbaar is, welke combinatie van tekst- en achtergrondkleur je ook gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj „Minimalny kontrast” w „Ustawienia > Profile > Kolory”, aby tekst był zawsze czytelny niezależnie od połączenia kolorów tekstu i tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste “Contraste mínimo” em “Ajustes > Perfis > Cores” para garantir que o texto seja sempre legível, independentemente da combinação de cores de texto e fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте «Минимальный контраст» в «Настройки > Профили > Цвета», чтобы текст всегда оставался читаемым независимо от сочетания цветов текста и фона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V časti „Nastavenia > Profily > Farby“ upravte „Minimálny kontrast“, aby bol text vždy čitateľný bez ohľadu na kombináciu farby textu a pozadia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite »Najmanjši kontrast« v »Nastavitve > Profili > Barve«, da bo besedilo vedno čitljivo, ne glede na kombinacijo barv besedila in ozadja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera ”Minsta kontrast” i ”Inställningar > Profiler > Färger” för att se till att texten alltid är läsbar oavsett kombination av text- och bakgrundsfärg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin/arka plan rengi bileşiminden bağımsız olarak metnin her zaman okunaklı olmasını sağlamak için “Ayarlar > Profiller > Renkler” bölümünde “Minimum kontrast”ı ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh “Độ tương phản tối thiểu” trong “Cài đặt > Hồ sơ > Màu” để đảm bảo văn bản luôn dễ đọc bất kể tổ hợp màu văn bản/nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 颜色”中调整“最小对比度”，以确保无论文本与背景颜色如何组合，文本始终清晰可辨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 描述檔 > 顏色」中調整「最小對比度」，可確保無論文字與背景顏色如何搭配，文字都清晰易讀。"
          }
        }
      }
    },
