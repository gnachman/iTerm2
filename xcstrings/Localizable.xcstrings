    "Tip.0077.Body" : {
      "comment" : "Tip of the day body, id 0077",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panely mohou zobrazovat ikonu označující aktuální aplikaci. Nastavíte to v „Nastavení > Profily > Obecné > Ikona“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faner kan vise et symbol, der angiver det aktuelle program. Konfigurer det i “Indstillinger > Profiler > Generelt > Symbol”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs können ein Symbol anzeigen, das die aktuelle Anwendung angibt. Konfigurieren Sie dies unter „Einstellungen > Profile > Allgemein > Symbol“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tabs can show an icon indicating the current application. Configure it in “Settings > Profiles > General > Icon.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pestañas pueden mostrar un icono que indique la aplicación actual. Configúralo en “Ajustes > Perfiles > General > Icono”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välilehdet voivat näyttää kuvakkeen, joka ilmaisee nykyisen sovelluksen. Määritä se kohdassa ”Asetukset > Profiilit > Yleiset > Kuvake”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les onglets peuvent afficher une icône indiquant l’application actuelle. Configurez-la dans « Réglages > Profils > Général > Icône »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pannelli possono mostrare un’icona che indica l’applicazione corrente. Configurala in “Impostazioni > Profili > Generali > Icona”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブには現在のアプリケーションを示すアイコンを表示できます。「設定 > プロファイル > 一般 > アイコン」で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭에 현재 응용 프로그램을 나타내는 아이콘을 표시할 수 있습니다. “설정 > 프로파일 > 일반 > 아이콘”에서 구성하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faner kan vise et symbol som angir gjeldende app. Konfigurer det i «Innstillinger > Profiler > Generelt > Symbol»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbladen kunnen een symbool tonen dat de huidige app aangeeft. Stel dit in via ‘Instellingen > Profielen > Algemeen > Symbool’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty mogą pokazywać ikonę wskazującą bieżącą aplikację. Skonfiguruj ją w „Ustawienia > Profile > Ogólne > Ikona”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As abas podem exibir um ícone indicando o aplicativo atual. Configure isso em “Ajustes > Perfis > Geral > Ícone”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкладки могут отображать значок, показывающий текущее приложение. Настройте это в «Настройки > Профили > Общие > Значок»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taby môžu zobrazovať ikonu aktuálnej aplikácie. Nastavíte ju v časti „Nastavenia > Profily > Všeobecné > Ikona“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavihki lahko prikažejo ikono, ki označuje trenutno aplikacijo. Nastavite jo v »Nastavitve > Profili > Splošno > Ikona«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flikar kan visa en symbol som anger det aktuella programmet. Konfigurera det i ”Inställningar > Profiler > Allmänt > Symbol”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeler, geçerli uygulamayı belirten bir simge gösterebilir. “Ayarlar > Profiller > Genel > Simge” bölümünden yapılandırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab có thể hiển thị một biểu tượng cho biết ứng dụng hiện tại. Cấu hình trong “Cài đặt > Hồ sơ > Chung > Biểu tượng.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签页可以显示表示当前应用程序的图标。在“设置 > 配置文件 > 通用 > 图标”中进行配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁可以顯示代表目前應用程式的圖像。在「設定 > 描述檔 > 一般 > 圖像」中設定。"
          }
        }
      }
    },
