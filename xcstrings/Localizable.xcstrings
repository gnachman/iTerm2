    "SavePanel.ExistsHeading" : {
      "comment" : "Heading of the overwrite confirmation; placeholder is the filename",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor „%@“ už existuje. Chcete jej nahradit, nebo k němu připojit data?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” findes allerede. Vil du erstatte det eller føje til det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ existiert bereits. Möchten Sie sie ersetzen oder anhängen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” already exists. Do you want to replace it or append to it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya existe. ¿Quieres reemplazarlo o añadirle contenido al final?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” on jo olemassa. Haluatko korvata sen vai lisätä siihen loppuun?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » existe déjà. Voulez-vous le remplacer ou ajouter à la suite ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” esiste già. Vuoi sostituirlo o aggiungere in coda?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は既に存在します。置き換えますか、それとも追加しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 이미 존재합니다. 대치하겠습니까, 아니면 뒤에 추가하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» finnes allerede. Vil du erstatte den eller legge til på slutten?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ bestaat al. Wil je het vervangen of er tekst aan toevoegen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik „%@” już istnieje. Czy chcesz go zastąpić, czy dołączyć do niego dane?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já existe. Deseja substituí-lo ou adicionar ao final?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже существует. Заменить его или добавить в конец?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor „%@“ už existuje. Chcete ho nahradiť, alebo k nemu pripojiť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteka »%@« že obstaja. Jo želite zamenjati ali ji dodati na konec?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” finns redan. Vill du ersätta den eller lägga till i slutet av den?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” zaten var. Değiştirmek mi yoksa sonuna eklemek mi istiyorsunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đã tồn tại. Bạn muốn thay thế hay nối thêm vào nó?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已存在。要替换它还是追加到它？"
          }
