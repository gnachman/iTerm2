          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nObwohl Sie sich dafür entschieden haben, Verbindungen automatisch zuzulassen, hat dieses Skript kein gültiges Cookie vorgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@\n\nAlthough you have chosen to allow connections automatically, this script has not presented a valid cookie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nAunque has elegido permitir conexiones automáticamente, este script no ha presentado una cookie válida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nVaikka olet valinnut sallia yhteydet automaattisesti, tämä skripti ei ole esittänyt kelvollista evästettä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBien que vous ayez choisi d’autoriser les connexions automatiquement, ce script n’a pas présenté de cookie valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nPur avendo scelto di consentire le connessioni automaticamente, questo script non ha presentato un cookie valido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n接続を自動的に許可する設定になっていますが、このスクリプトは有効なCookieを提示していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n연결을 자동으로 허용하도록 선택했지만 이 스크립트가 유효한 쿠키를 제시하지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nSelv om du har valgt å tillate tilkoblinger automatisk, har ikke dette skriptet presentert en gyldig informasjonskapsel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nHoewel je ervoor hebt gekozen verbindingen automatisch toe te staan, heeft dit script geen geldige cookie aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nChociaż wybrano automatyczne pozwalanie na połączenia, ten skrypt nie przedstawił prawidłowego ciasteczka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nEmbora você tenha optado por permitir conexões automaticamente, este script não apresentou um cookie válido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nХотя вы разрешили автоматически принимать подключения, этот скрипт не предоставил действительный cookie."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nHoci ste sa rozhodli povoliť pripojenia automaticky, tento skript nepredložil platný cookie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nČeprav ste izbrali samodejno dovoljevanje povezav, ta skript ni predložil veljavnega piškotka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nÄven om du har valt att tillåta anslutningar automatiskt har det här skriptet inte presenterat en giltig cookie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nBağlantılara otomatik olarak izin vermeyi seçmiş olsanız da bu betik geçerli bir çerez sunmadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nDù bạn đã chọn cho phép kết nối tự động, tập lệnh này chưa trình ra cookie hợp lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n虽然你已选择自动允许连接，但此脚本未提供有效的 cookie。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n雖然你已選擇自動允許連線，但此腳本未提供有效的 cookie。"
          }
        }
      }
    },
