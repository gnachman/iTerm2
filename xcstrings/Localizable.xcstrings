    "AdvancedSetting.workAroundMultiDisplayOSBug" : {
      "comment" : "Advanced setting: workAroundMultiDisplayOSBug",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgehung eines macOS-Fehlers, bei dem das Betriebssystem Fenster ohne triftigen Grund auf den ersten Bildschirm verschiebt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Work around a macOS bug where the OS moves windows to the first display for no good reason."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita un error de macOS por el que el sistema mueve ventanas a la primera pantalla sin motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contourner un bogue de macOS où le système déplace les fenêtres vers le premier écran sans raison valable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggira un bug di macOS per cui il sistema sposta le finestre sul primo schermo senza motivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSが理由もなくウィンドウを最初のディスプレイに移動させるmacOSのバグを回避します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OS가 특별한 이유 없이 윈도우를 첫 번째 디스플레이로 이동시키는 macOS 버그를 우회합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contornar um erro do macOS em que o sistema move janelas para a primeira tela sem um bom motivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обходить ошибку macOS, из-за которой система без видимой причины перемещает окна на первый экран."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşletim sisteminin pencereleri sebepsiz yere ilk ekrana taşıdığı bir macOS hatasına geçici çözüm uygula."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解决 macOS 的一个缺陷：系统无理由将窗口移动到第一个显示器上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
