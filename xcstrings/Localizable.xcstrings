    "SetStatus.ThenWithoutExpiresOn" : {
      "comment" : "Error when a caller asks for a replacement status without saying when it should be applied",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die then_-Argumente haben nur in Verbindung mit expires_on eine Bedeutung, aber expires_on wurde nicht angegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The then_ arguments only mean something with expires_on, which was not given."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los argumentos then_ solo tienen sentido junto con expires_on, que no se indicó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les arguments then_ n’ont de sens qu’avec expires_on, qui n’a pas été fourni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli argomenti then_ hanno senso solo insieme a expires_on, che non è stato specificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "then_引数はexpires_onと一緒に指定した場合にのみ意味を持ちますが、expires_onが指定されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "then_ 인수는 expires_on과 함께 사용할 때만 의미가 있는데, expires_on이 지정되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os argumentos then_ só fazem sentido com expires_on, que não foi informado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аргументы then_ имеют смысл только вместе с expires_on, который не был указан."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "then_ bağımsız değişkenleri yalnızca expires_on ile anlam taşır, ancak expires_on verilmedi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "then_ 参数只有在配合 expires_on 时才有意义，但未提供 expires_on。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "then_ 引數只有搭配 expires_on 才有意義，但未提供 expires_on。"
          }
        }
      }
    },
    "SetStatus.UnknownExpiresOn" : {
      "comment" : "Error when the expires_on argument names an event iTerm2 does not know. The placeholder is the value the caller passed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekanntes expires_on „%@“. Der einzige unterstützte Wert ist progress-end."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unknown expires_on “%@”. The only supported value is progress-end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "expires_on desconocido “%@”. El único valor admitido es progress-end."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeur expires_on inconnue « %@ ». La seule valeur prise en charge est progress-end."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "expires_on “%@” sconosciuto. L’unico valore supportato è progress-end."
