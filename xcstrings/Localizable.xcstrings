          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren svarede ikke i tide. Webstedet er muligvis midlertidigt utilgængeligt eller overbelastet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
