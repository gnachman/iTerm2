    "Tip.0020.Body" : {
      "comment" : "Tip of the day body, id 0020",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotkey-Fenster können geöffnet bleiben, auch wenn sie den Fokus verlieren. Aktivieren Sie dies unter „Fenster > Hotkey-Fenster anheften“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hotkey windows can stay open after losing focus. Turn it on in “Window > Pin Hotkey Window.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas de tecla rápida pueden permanecer abiertas después de perder el foco. Actívalo en “Ventana > Fijar ventana de tecla rápida”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres à raccourci global peuvent rester ouvertes après avoir perdu le focus. Activez cette option dans « Fenêtre > Épingler la fenêtre à raccourci global »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre ad abbreviazione globale possono restare aperte dopo aver perso il focus. Attivalo in “Finestra > Fissa finestra ad abbreviazione globale”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキーウィンドウは、フォーカスを失った後も開いたままにできます。「ウィンドウ > ホットキーウィンドウを固定」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 윈도우는 포커스를 잃은 후에도 열린 상태로 유지할 수 있습니다. “윈도우 > 단축키 윈도우 고정”에서 켜십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas de tecla de atalho podem permanecer abertas após perder o foco. Ative em “Janela > Fixar janela de tecla de atalho”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окна горячих клавиш могут оставаться открытыми после потери фокуса. Включите это в «Окно > Закрепить окно горячих клавиш»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşu pencereleri odağı kaybettikten sonra da açık kalabilir. “Pencere > Kısayol Tuşu Penceresini Sabitle” ile açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "失去焦点后，快捷键窗口仍可以保持打开状态。在“窗口 > 固定快捷键窗口”中开启此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全域快速鍵視窗在失去焦點後可以保持打開。你可以在「視窗 > 釘選全域快速鍵視窗」中開啟。"
          }
        }
      }
    },
