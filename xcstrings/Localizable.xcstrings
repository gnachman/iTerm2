    "GeneralPrefs.TmuxPauseAgeLimit" : {
      "comment" : "Label for the tmux pause age limit setting",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert eine tmux-Pane, wenn sie mehr als so viele Sekunden bräuchte, um aufzuholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pause a tmux pane if it would take more than this many seconds to catch up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar un panel de tmux si tardaría más de esta cantidad de segundos en ponerse al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre en pause un volet tmux s’il lui faudrait plus de ce nombre de secondes pour rattraper son retard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa un riquadro tmux se per recuperare occorrerebbero più di questi secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追いつくのにこの秒数を超える場合、tmux ペインを一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따라잡는 데 이 시간(초)보다 오래 걸리면 tmux 패널을 일시 정지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar um painel do tmux se ele levasse mais do que esta quantidade de segundos para se atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливать панель tmux, если для синхронизации потребуется больше указанного числа секунд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir tmux bölmesinin yetişmesi bu kadar saniyeden uzun sürecekse bölmeyi duraklat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果追赶需要超过此秒数，则暂停 tmux 窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若 tmux 窗格需要超過此秒數才能趕上進度，就暫停該窗格。"
          }
        }
      }
    },
    "GeneralPrefs.WindowRestorationDisabledMessage13" : {
      "comment" : "Warning shown when macOS window restoration is disabled (macOS 13+)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Systemfenster-Wiederherstellung wurde deaktiviert, wodurch iTerm2 diese Einstellung nicht berücksichtigen kann. Deaktivieren Sie „Systemeinstellungen > Schreibtisch & Dock > Fenster beim Beenden einer App schließen“, um die Fenster-Wiederherstellung zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "System window restoration has been disabled, which prevents iTerm2 from respecting this setting. Disable ”System Settings > Desktop & Dock > Close windows when quitting an application“ to enable window restoration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha desactivado la restauración de ventanas del sistema, lo que impide que iTerm2 respete este ajuste. Desactiva “Ajustes del Sistema > Escritorio y Dock > Cerrar las ventanas al salir de una aplicación” para activar la restauración de ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration des fenêtres du système a été désactivée, ce qui empêche iTerm2 de respecter ce réglage. Désactivez « Réglages Système > Bureau et Dock > Fermer les fenêtres à la fermeture d’une app » pour activer la restauration des fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino delle finestre di sistema è stato disabilitato, il che impedisce a iTerm2 di rispettare questa impostazione. Disabilita “Impostazioni di Sistema > Scrivania e Dock > Chiudi le finestre quando esci da un’applicazione” per abilitare il ripristino delle finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのウインドウ復元が無効になっているため、iTerm2 はこの設定に従うことができません。ウインドウの復元を有効にするには、「システム設定 > デスクトップと Dock > アプリケーション終了時にウインドウを閉じる」をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 윈도우 복원이 비활성화되어 있어 iTerm2가 이 설정을 따를 수 없습니다. 윈도우 복원을 활성화하려면 “시스템 설정 > 데스크탑 및 Dock > 앱 종료 시 윈도우 닫기”를 끄십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A restauração de janelas do sistema foi desativada, o que impede o iTerm2 de respeitar este ajuste. Desative “Ajustes do Sistema > Mesa e Dock > Fechar janelas ao encerrar um aplicativo” para ativar a restauração de janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление окон системой отключено, из-за чего iTerm2 не может применить эту настройку. Отключите «Настройки системы > Рабочий стол и Dock > Закрывать окна при выходе из приложения», чтобы включить восстановление окон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem pencere geri yüklemesi devre dışı bırakılmış, bu da iTerm2’nin bu ayara uymasını engelliyor. Pencere geri yüklemeyi etkinleştirmek için “Sistem Ayarları > Masaüstü ve Dock > Bir uygulamadan çıkarken pencereleri kapat” seçeneğini devre dışı bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统窗口恢复已被停用，这导致 iTerm2 无法遵循此设置。请停用“系统设置 > 桌面与程序坞 > 退出应用时关闭窗口”以启用窗口恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統視窗回復已停用，導致 iTerm2 無法遵循此設定。請停用「系統設定 > 桌面與 Dock > 結束 App 時關閉視窗」以啟用視窗回復。"
          }
        }
      }
    },
