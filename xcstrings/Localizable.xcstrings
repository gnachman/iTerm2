        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verticale verschuiving voor de onderstrepingscursor.\nPositieve waarden verplaatsen hem omhoog, negatieve waarden omlaag."
          }
        },
        "pl" : {
          "stringUnit" : {
