    "Tip.0049.Body" : {
      "comment" : "Tip of the day body, id 0049",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⇧⌥⌘ gedrückt und ziehen Sie eine Sitzung in eine andere, um geteilte Bereiche zu erstellen oder zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⇧⌥⌘ and drag a session into another session to create or change split panes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌥⌘を押しながらセッションを別のセッションにドラッグすると、分割ペインを作成したり変更したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⇧⌥⌘를 누른 채 세션을 다른 세션으로 드래그하여 분할 패널을 만들거나 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⇧⌥⌘ pressionado e arraste uma sessão para outra sessão para criar ou alterar painéis divididos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⇧⌥⌘ и перетащите одну сессию в другую, чтобы создать или изменить разделённые панели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⇧⌥⌘ 键并拖动一个会话到另一个会话中，可创建或更改分屏窗格。"
          }
        }
      }
    },
