    "Profiles.Window.BackgroundImagePickerMessage" : {
      "comment" : "Prompt in the open panel for choosing a background image or folder.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte obrázek na pozadí nebo složku, jejíž obrázky se budou střídat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et billede til baggrunden eller en mappe, hvis billeder skal skiftes imellem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein Bild für den Hintergrund oder einen Ordner, dessen Bilder abwechselnd angezeigt werden sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose an image for the background, or a folder to rotate through its images."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una imagen para el fondo o una carpeta para alternar entre sus imágenes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse taustakuva tai kansio, jonka kuvia kierrätetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une image pour l’arrière-plan, ou un dossier dont les images défileront en alternance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un’immagine per lo sfondo oppure una cartella per alternarne le immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景に使用する画像、またはその画像を順番に切り替えるフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경으로 사용할 이미지를 선택하거나, 이미지를 순환하며 표시할 폴더를 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg et bilde til bakgrunnen, eller en mappe der bildene skal veksle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een afbeelding voor de achtergrond, of een map om door de afbeeldingen ervan te laten wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz obraz tła lub folder, z którego obrazy będą się zmieniać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma imagem para o plano de fundo ou uma pasta para alternar entre suas imagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
