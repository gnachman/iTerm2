    "AdvancedSetting.doubleReportScrollWheel" : {
      "comment" : "Advanced setting: doubleReportScrollWheel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mausrad-Ereignisse doppelt melden, um einen tmux-Scrollfehler zu umgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Double-report scroll wheel events to work around tmux scrolling bug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informar dos veces de los eventos de la rueda de desplazamiento para evitar un error de desplazamiento de tmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signaler deux fois les événements de molette pour contourner un bug de défilement de tmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala due volte gli eventi della rotellina per aggirare un bug di scorrimento di tmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux のスクロールに関するバグを回避するため、スクロールホイールイベントを二重に報告します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 스크롤 버그를 피하기 위해 스크롤 휠 이벤트를 두 번 보고합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar em dobro os eventos da roda de rolagem para contornar um bug de rolagem do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дублировать отчёт о событиях колеса прокрутки, чтобы обойти ошибку прокрутки в tmux."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux kaydırma hatasını aşmak için kaydırma tekerleği olaylarını iki kez raporla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为规避 tmux 滚动故障，对滚轮事件进行双重上报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複回報滾輪事件，以繞過 tmux 捲動的錯誤。"
          }
        }
      }
    },
    "AdvancedSetting.downloadsDirectory" : {
      "comment" : "Advanced setting: downloadsDirectory",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads-Ordner.\nFalls gesetzt, werden heruntergeladene Dateien an diesem Ort statt im Ordner $HOME/Downloads des Benutzers abgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Downloads folder.\nIf set, downloaded files go to this location instead of the user’s $HOME/Downloads folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta de descargas.\nSi se define, los archivos descargados van a esta ubicación en lugar de la carpeta $HOME/Downloads del usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier des téléchargements.\nSi défini, les fichiers téléchargés vont à cet emplacement au lieu du dossier $HOME/Downloads de l’utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella dei download.\nSe impostata, i file scaricati vanno in questa posizione invece che nella cartella $HOME/Downloads dell’utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードフォルダ。\n設定すると、ダウンロードしたファイルはユーザーの $HOME/Downloads フォルダではなく、この場所に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드 폴더.\n설정하면 다운로드한 파일이 사용자의 $HOME/Downloads 폴더 대신 이 위치에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta de downloads.\nSe definida, os arquivos baixados vão para este local em vez da pasta $HOME/Downloads do usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка загрузок.\nЕсли задана, скачанные файлы попадают в это расположение вместо папки $HOME/Downloads пользователя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilenler klasörü.\nAyarlanırsa indirilen dosyalar kullanıcının $HOME/Downloads klasörü yerine bu konuma gider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载文件夹。\n若已设置，下载的文件将存放在该位置，而非用户的 $HOME/Downloads 文件夹中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載項目檔案夾。\n設定後，下載的檔案會存放在此位置，而不是使用者的 $HOME/Downloads 檔案夾。"
          }
        }
      }
    },
    "AdvancedSetting.drawBottomLineForHorizontalTabBar" : {
      "comment" : "Advanced setting: drawBottomLineForHorizontalTabBar",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untere Linie für die horizontale Tableiste in den Designs „Regulär“, „Dunkel“ und „Hell“ zeichnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draw bottom line for horizontal tabbar in Regular, Dark and Light theme?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dibujar la línea inferior de la barra de pestañas horizontal en los temas Normal, Oscuro y Claro?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiner une ligne inférieure pour la barre d’onglets horizontale dans les thèmes Normal, Sombre et Clair ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
