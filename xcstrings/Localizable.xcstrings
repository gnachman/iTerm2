    "AdvancedSetting.disableMetalWhenIdle" : {
      "comment" : "Advanced setting: disableMetalWhenIdle",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnout vykreslovací modul Metal v nečinnosti kvůli úspoře využití CPU?\nVyžaduje vykreslovací modul Metal"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Metal-gengivelsesmotoren fra, når den er passiv, for at spare CPU-forbrug?\nKræver Metal-gengivelsesmotoren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal-Renderer im Leerlauf deaktivieren, um CPU-Auslastung zu sparen?\nErfordert Metal-Renderer"
