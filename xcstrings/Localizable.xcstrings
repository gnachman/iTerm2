    "ApplyLayout.OrphanedSession" : {
      "comment" : "Error shown when a session is left unaccounted for by an apply_layout spec",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace %1$@ v panelu %2$@ není zahrnuta; musí se objevit v novém rozvržení nebo v close_sessions/close_tabs"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen %1$@ i fanen %2$@ er ikke taget højde for. Den skal forekomme i det nye layout eller i close_sessions/close_tabs"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzung %1$@ in Tab %2$@ ist nicht berücksichtigt; sie muss im neuen Layout oder in close_sessions/close_tabs erscheinen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Session %1$@ in tab %2$@ is unaccounted for; it must appear in the new layout or in close_sessions/close_tabs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión %1$@ de la pestaña %2$@ no está contemplada; debe aparecer en el nuevo diseño o en close_sessions/close_tabs"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunto %1$@ välilehdellä %2$@ on selvittämättä; sen on esiinnyttävä uudessa asettelussa tai kohdassa close_sessions/close_tabs"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session %1$@ de l’onglet %2$@ n’est pas prise en compte ; elle doit figurer dans la nouvelle disposition ou dans close_sessions/close_tabs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione %1$@ nel pannello %2$@ non è considerata; deve comparire nel nuovo layout o in close_sessions/close_tabs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブ%2$@内のセッション%1$@が対応付けられていません。新しいレイアウト、またはclose_sessions/close_tabsに含める必要があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 %2$@의 세션 %1$@이(가) 처리되지 않았습니다. 새로운 레이아웃이나 close_sessions/close_tabs에 포함되어야 합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økten %1$@ i fanen %2$@ er ikke tatt hensyn til; den må finnes i den nye layouten eller i close_sessions/close_tabs"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessie %1$@ in tabblad %2$@ is niet verantwoord; die moet voorkomen in de nieuwe indeling of in close_sessions/close_tabs"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja %1$@ w karcie %2$@ nie została uwzględniona; musi występować w nowym układzie lub w close_sessions/close_tabs"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão %1$@ na aba %2$@ não foi contabilizada; ela deve aparecer no novo layout ou em close_sessions/close_tabs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс %1$@ во вкладке %2$@ не учтён; он должен присутствовать в новой раскладке либо в close_sessions/close_tabs"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácia %1$@ v tabe %2$@ nie je zahrnutá; musí sa objaviť v novom rozložení alebo v close_sessions/close_tabs"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja %1$@ v zavihku %2$@ ni upoštevana; mora biti v novi razporeditvi ali v close_sessions/close_tabs"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen %1$@ i fliken %2$@ är inte omhändertagen; den måste finnas i den nya layouten eller i close_sessions/close_tabs"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum %1$@ (sekme %2$@) hesaba katılmamış; yeni düzende veya close_sessions/close_tabs içinde yer almalıdır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên %1$@ trong tab %2$@ không được xử lý; nó phải xuất hiện trong bố cục mới hoặc trong close_sessions/close_tabs"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@中的会话 %1$@未被考虑；它必须出现在新布局中或 close_tabs/close_sessions 目录中"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁 %2$@ 中的工作階段 %1$@ 未被處理；它必須出現在新的版面配置中，或出現在 close_sessions/close_tabs 中"
          }
        }
      }
    },
    "ApplyLayout.SplitterTooFewChildren" : {
      "comment" : "apply_layout error when a splitter has too few children; first placeholder is the path, second is the child count",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělovač v %1$@ má %2$#@children@; musí mít alespoň 2"
          },
          "substitutions" : {
            "children" : {
