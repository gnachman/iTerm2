    "Tip.0071.Body" : {
      "comment" : "Tip of the day body, id 0071",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaci můžete „zahrabat“ přes „Relace > Zahrabat relaci“. Zůstane skrytá, dokud ji neobnovíte výběrem z „Relace > Zahrabané relace > Vaše relace“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan “begrave” en session med “Session > Begrav session”. Den forbliver skjult, indtil du gendanner den ved at vælge den i “Session > Begravede sessioner > Din session”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können eine Sitzung mit „Sitzung > Sitzung vergraben“ „vergraben“. Sie bleibt verborgen, bis Sie sie über „Sitzung > Vergrabene Sitzungen > Ihre Sitzung“ wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can “bury” a session with “Session > Bury Session.” It remains hidden until you restore it by selecting it from “Session > Buried Sessions > Your session.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes “enterrar” una sesión con “Sesión > Enterrar sesión”. Permanece oculta hasta que la restaures seleccionándola en “Sesión > Sesiones enterradas > Tu sesión”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit ”haudata” istunnon komennolla ”Istunto > Hautaa istunto”. Se pysyy piilossa, kunnes palautat sen valitsemalla sen kohdasta ”Istunto > Haudatut istunnot > Istuntosi”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez « enfouir » une session avec « Session > Enfouir la session ». Elle reste masquée jusqu’à ce que vous la restauriez en la sélectionnant dans « Session > Sessions enfouies > Votre session »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi “seppellire” una sessione con “Sessione > Seppellisci sessione”. Resta nascosta finché non la ripristini selezionandola da “Sessione > Sessioni sepolte > La tua sessione”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「セッション > セッションを埋める」でセッションを「埋める」ことができます。「セッション > 埋めたセッション > (該当セッション)」から選択して復元するまで、非表示のままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“세션 > 세션 숨겨두기”로 세션을 “숨겨둘” 수 있습니다. 숨겨둔 세션은 “세션 > 숨겨둔 세션 > 해당 세션”을 선택하여 복원할 때까지 보이지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan «begrave» en økt med «Økt > Begrav økt». Den forblir skjult til du gjenoppretter den ved å velge den i «Økt > Begravde økter > Din økt»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een sessie ‘begraven’ met ‘Sessie > Begraaf sessie’. Die blijft verborgen tot je hem terugzet door hem te kiezen via ‘Sessie > Begraven sessies > Je sessie’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz „zakopać” sesję przez „Sesja > Zakop sesję”. Pozostaje ukryta, dopóki jej nie przywrócisz, wybierając ją z „Sesja > Zakopane sesje > Twoja sesja”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode “enterrar” uma sessão com “Sessão > Enterrar sessão”. Ela permanece oculta até você restaurá-la selecionando-a em “Sessão > Sessões enterradas > Sua sessão”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете «скрыть» сессию с помощью «Сессия > Скрыть сессию». Она останется скрытой, пока вы не восстановите её, выбрав в «Сессия > Скрытые сессии > Ваша сессия»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reláciu môžete „pochovať“ cez menu „Relácia > Pochovať reláciu“. Zostane skrytá, kým ju neobnovíte výberom v menu „Relácia > Pochované relácie > Vaša relácia“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejo lahko »pokopljete« z »Seja > Pokoplji sejo«. Ostane skrita, dokler je ne obnovite z izbiro v »Seja > Pokopane seje > Vaša seja«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ”begrava” en session med ”Session > Begrav session”. Den förblir gömd tills du återställer den genom att välja den i ”Session > Begravda sessioner > Din session”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturumu “Oturum > Oturumu Göm” ile “gömebilirsiniz”. “Oturum > Gömülü Oturumlar > Oturumunuz” altından seçerek geri yükleyene kadar gizli kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể “chôn” một phiên bằng “Phiên > Chôn phiên.” Phiên sẽ vẫn bị ẩn cho đến khi bạn khôi phục bằng cách chọn nó từ “Phiên > Phiên đã chôn > Phiên của bạn.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用“会话 > 隐藏会话”功能将会话“隐藏”。在从“会话 > 隐藏会话 > 您的会话”中恢复之前，该会话会保持隐藏状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以使用「工作階段 > 埋藏工作階段」來「埋藏」工作階段。它會一直保持隱藏，直到你從「工作階段 > 已埋藏的工作階段 > 你的工作階段」中選取它來回復。"
          }
        }
      }
    },
