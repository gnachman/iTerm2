    "PTYSession.UnsafeBadgeFormat" : {
      "comment" : "Warning that a badge format was rejected because it contained a function call",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung hat versucht, das Badge auf einen Wert zu setzen, der einen Funktionsaufruf auslösen würde. Aus Sicherheitsgründen ist dies nicht zulässig, und das Badge wurde nicht aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The application attempted to set the badge to a value that would invoke a function call. For security reasons, this is not allowed and the badge was not updated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación intentó establecer la insignia con un valor que invocaría una llamada a función. Por motivos de seguridad, esto no está permitido y la insignia no se actualizó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application a tenté de définir le badge sur une valeur qui appellerait une fonction. Pour des raisons de sécurité, c’est interdit et le badge n’a pas été mis à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’applicazione ha tentato di impostare il badge su un valore che richiamerebbe una funzione. Per motivi di sicurezza questo non è consentito e il badge non è stato aggiornato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションが関数呼び出しを実行する値にバッジを設定しようとしました。セキュリティ上の理由からこれは許可されておらず、バッジは更新されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 함수 호출을 일으키는 값으로 배지를 설정하려고 했습니다. 보안상의 이유로 이는 허용되지 않으며 배지가 업데이트되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo tentou definir o selo com um valor que invocaria uma chamada de função. Por motivos de segurança, isso não é permitido e o selo não foi atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение попыталось установить для значка значение, которое вызвало бы вызов функции. В целях безопасности это не разрешено, и значок не был обновлён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, rozeti bir işlev çağrısı yapacak bir değere ayarlamaya çalıştı. Güvenlik nedeniyle buna izin verilmez ve rozet güncellenmedi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用试图将角标设置为会触发函数调用的值。出于安全原因，此操作不被允许，角标未更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 App 嘗試將標記牌設為會叫用函式呼叫的值。基於安全考量，不允許此操作，標記牌未更新。"
          }
        }
      }
    },
    "PTYSession.UnsupportedUploadFormat" : {
      "comment" : "Warning that an upload used an unsupported archive format",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
