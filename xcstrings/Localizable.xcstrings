    "EventTrigger.Help.ActivityAfterIdle" : {
      "comment" : "Help text for the Activity After Idle event trigger",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ausgelöst, wenn die Ausgabe nach einer Ruhephase fortgesetzt wird."
