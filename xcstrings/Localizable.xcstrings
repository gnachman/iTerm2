        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkelheit (im Bereich [0…1]) für nicht ausgewählte Tabs in Designs außer „Minimal“ im hellen Modus."
          }
        },
        "en" : {
