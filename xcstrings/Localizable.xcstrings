    "InstanceLock.SuiteMessage" : {
      "comment" : "Shown at launch when another instance uses the same -suite. %1$d is a process ID; %2$@ is the suite name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Instanz von iTerm2 (Prozess-ID %1$d) läuft bereits mit der Einstellungs-Suite „%2$@“. Wenn zwei Instanzen gleichzeitig dieselben Einstellungen verwenden, können sie gegenseitig ihre Einstellungen und gespeicherten Fenster überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another copy of iTerm2 (process ID %1$d) is already running with the settings suite “%2$@”. If two copies use the same settings at once, they can overwrite each other’s preferences and saved windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se está ejecutando otra copia de iTerm2 (ID de proceso %1$d) con el conjunto de ajustes “%2$@”. Si dos copias usan los mismos ajustes a la vez, pueden sobrescribirse mutuamente las preferencias y las ventanas guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre copie d’iTerm2 (ID de processus %1$d) est déjà en cours d’exécution avec la suite de réglages « %2$@ ». Si deux copies utilisent les mêmes réglages en même temps, elles peuvent écraser mutuellement leurs préférences et leurs fenêtres enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra copia di iTerm2 (ID processo %1$d) è già in esecuzione con la suite di impostazioni “%2$@”. Se due copie usano le stesse impostazioni contemporaneamente, possono sovrascrivere a vicenda le preferenze e le finestre salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の iTerm2 (プロセス ID %1$d) が設定スイート「%2$@」ですでに実行中です。2 つの iTerm2 が同時に同じ設定を使用すると、互いの環境設定や保存されたウインドウを上書きする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 iTerm2 사본(프로세스 ID %1$d)이 설정 모음 “%2$@”(으)로 이미 실행 중입니다. 두 사본이 같은 설정을 동시에 사용하면 서로의 설정과 저장된 윈도우를 덮어쓸 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra cópia do iTerm2 (ID do processo %1$d) já está em execução com o conjunto de configurações “%2$@”. Se duas cópias usarem as mesmas configurações ao mesmo tempo, elas podem sobrescrever as preferências e as janelas salvas uma da outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая копия iTerm2 (идентификатор процесса %1$d) уже запущена с набором настроек «%2$@». Если две копии одновременно используют одни и те же настройки, они могут перезаписать настройки и сохранённые окна друг друга."
          }
        },
        "tr" : {
