    "Profiles.Window.ImageCorruptMessage" : {
      "comment" : "Warning body when a background image is corrupt or an unsupported format. %@ is the image file name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrázek „%@“ se nepodařilo načíst, protože je poškozený nebo nemá podporovaný formát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billedet “%@” kunne ikke indlæses, fordi det er beskadiget eller ikke har et understøttet format."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild „%@“ konnte nicht geladen werden, da es beschädigt ist oder ein nicht unterstütztes Format hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The image “%@” could not be loaded because it is corrupt or not a supported format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar la imagen “%@” porque está dañada o no tiene un formato compatible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvaa ”%@” ei voitu ladata, koska se on vioittunut tai sen muotoa ei tueta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image « %@ » n’a pas pu être chargée, car elle est corrompue ou son format n’est pas pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare l’immagine “%@” perché è danneggiata o in un formato non supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像「%@」は破損しているかサポートされていない形式のため読み込めませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 “%@”이(가) 손상되었거나 지원되지 않는 형식이어서 불러올 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildet «%@» kunne ikke lastes fordi det er skadet eller ikke har et støttet format."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
