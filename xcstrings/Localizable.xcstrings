    "Codecierge.PrivacyWarningBody" : {
      "comment" : "Body of the Codecierge privacy warning",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was in Ihrem Terminal geschieht, während Codecierge läuft, wird an Ihren KI-Anbieter gesendet. Senden Sie ihm keine vertraulichen Informationen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything that happens in your terminal while Codecierge is running will be sent to your AI provider. Don't send them confidential information!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que ocurra en tu terminal mientras Codecierge esté en ejecución se enviará a tu proveedor de IA. ¡No le envíes información confidencial!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui se passe dans votre terminal pendant l’exécution de Codecierge sera envoyé à votre fournisseur d’IA. N’envoyez pas d’informations confidentielles !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che accade nel terminale mentre Codecierge è in esecuzione verrà inviato al tuo provider IA. Non inviare informazioni riservate!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codeciergeの実行中にターミナルで起きたことはすべてAIプロバイダーに送信されます。機密情報を送信しないでください！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge가 실행되는 동안 터미널에서 일어나는 모든 일이 AI 제공업체로 전송됩니다. 기밀 정보를 보내지 마십시오!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que acontece no seu terminal enquanto o Concierge de código está em execução será enviado ao seu provedor de IA. Não envie informações confidenciais a ele!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что происходит в терминале во время работы Codecierge, будет отправлено вашему провайдеру ИИ. Не отправляйте им конфиденциальную информацию!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge çalışırken terminalinizde olan her şey YZ sağlayıcınıza gönderilir. Gizli bilgileri göndermeyin!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Codecierge 运行时，终端中发生的所有内容都将发送到您的 AI 提供商。请勿发送机密信息！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codecierge 執行期間，終端機中發生的所有內容都會傳送給你的 AI 供應商。請勿傳送機密資訊！"
          }
        }
      }
    },
