    "CorruptApplication.SignatureMismatch" : {
      "comment" : "Alert shown when a required resource is missing and the code signature does not match the official distribution",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, und die Codesignatur von iTerm2 stimmte nicht mit der der offiziellen Distribution überein. Sie sollten eine neue Kopie der App herunterladen und sie neu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted and iTerm2’s code signature did not match that of the official distribution. You should download a fresh copy of the app and reinstall it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようで、iTerm2のコード署名が公式配布版のものと一致しませんでした。アプリを新たにダウンロードして再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것 같으며, iTerm2의 코드 서명이 공식 배포판의 서명과 일치하지 않습니다. 앱을 새로 다운로드하여 다시 설치하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido e a assinatura de código do iTerm2 não correspondeu à da distribuição oficial. Você deve baixar uma cópia nova do app e reinstalá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, а цифровая подпись кода iTerm2 не совпадает с подписью официальной версии. Рекомендуется скачать новую копию приложения и переустановить его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，且 iTerm2 的代码签名与官方版本不符。您应该下载新的应用并重新安装它。"
          }
        }
      }
    },
    "CorruptApplication.SignatureUnverifiable" : {
      "comment" : "Alert shown when a required resource is missing and the code signature could not be verified",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, und die Codesignatur von iTerm2 konnte nicht überprüft werden. Sie sollten eine neue Kopie der App herunterladen und sie neu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted and iTerm2’s code signature could not be verified. You should download a fresh copy of the app and reinstall it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようで、iTerm2のコード署名を検証できませんでした。アプリを新たにダウンロードして再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이며 iTerm2의 코드 서명을 확인할 수 없습니다. 앱을 새로 다운로드하여 다시 설치해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido e a assinatura de código do iTerm2 não pôde ser verificada. Você deve baixar uma cópia nova do app e reinstalá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, а цифровую подпись кода iTerm2 не удалось проверить. Рекомендуется скачать новую копию приложения и переустановить его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，且无法验证 iTerm2 的代码签名。您应该下载新的应用并重新安装它。"
          }
        }
      }
    },
    "CorruptApplication.SignatureValidUnexpected" : {
      "comment" : "Alert shown when a required resource is missing but the code signature is unexpectedly valid",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, doch wider Erwarten ist die Codesignatur von iTerm2 gültig. Bitte melden Sie einen Fehler unter https://iterm2.com/bugs"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted, yet against all odds the code signature for iTerm2 is valid. Please file a bug at https://iterm2.com/bugs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようですが、意外なことにiTerm2のコード署名は有効です。https://iterm2.com/bugs でバグを報告してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것으로 보이지만, 의외로 iTerm2의 코드 서명은 유효합니다. https://iterm2.com/bugs 에서 버그를 보고하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido, mas contra todas as probabilidades a assinatura de código do iTerm2 é válida. Registre um bug em https://iterm2.com/bugs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, однако вопреки всему цифровая подпись кода iTerm2 действительна. Пожалуйста, сообщите об ошибке на странице https://iterm2.com/bugs"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，但出乎意料的是 iTerm2 的代码签名是有效的。请向 https://iterm2.com/bugs 提交错误报告。"
          }
        }
      }
    },
