    "ColorPreset.ImportedMessage" : {
      "comment" : "Message telling the user where to find the imported color scheme",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barevné schéma bylo importováno a přidáno do předvoleb. Najdete jej v části „Nastavení > Profily > Barvy > Předvolby barev…“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farveskemaet blev importeret og føjet til forindstillinger. Du finder det under Indstillinger > Profiler > Farver > Farveforindstillinger…."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Farbschema wurde importiert und zu den Voreinstellungen hinzugefügt. Sie finden es unter Einstellungen > Profile > Farben > Voreinstellungen laden…."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The color scheme was imported and added to presets. You can find it under Settings > Profiles > Colors > Load Presets…."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esquema de colores se importó y se añadió a los preajustes. Lo encontrarás en Ajustes > Perfiles > Colores > Cargar preajustes…."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väriteema tuotiin ja lisättiin esiasetuksiin. Löydät sen kohdasta Asetukset > Profiilit > Värit > Lataa esiasetukset…."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu de couleurs a été importé et ajouté aux préréglages. Vous le trouverez dans Réglages > Profils > Couleurs > Charger les préréglages…."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La combinazione di colori è stata importata e aggiunta alle preimpostazioni. La trovi in Impostazioni > Profili > Colori > Carica preimpostazioni…."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カラースキームがインポートされ、プリセットに追加されました。「設定」＞「プロファイル」＞「カラー」＞「プリセットを読み込む…」から確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상 구성표를 가져와 사전 설정에 추가했습니다. 설정 > 프로파일 > 색상 > 사전 설정 불러오기…에서 찾을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fargeskjemaet ble importert og lagt til i forhåndsinnstillingene. Du finner det under «Innstillinger > Profiler > Farger > Last inn forhåndsinnstillinger…»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kleurenschema is geïmporteerd en toegevoegd aan de voorinstellingen. Je vindt het onder Instellingen > Profielen > Kleuren > Kleurvoorinstellingen…."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schemat kolorów został zaimportowany i dodany do ustawień wstępnych. Znajdziesz go w: Ustawienia > Profile > Kolory > Wczytaj ustawienia wstępne…."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esquema de cores foi importado e adicionado às predefinições. Você pode encontrá-lo em Ajustes > Perfis > Cores > Carregar predefinições…."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цветовая схема импортирована и добавлена в пресеты. Её можно найти в разделе Настройки > Профили > Цвета > Загрузить пресеты…."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farebná schéma bola importovaná a pridaná do predvolieb. Nájdete ju v časti „Nastavenia > Profily > Farby > Predvoľby farieb…“."
          }
        },
        "sl" : {
          "stringUnit" : {
