        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor alfa del color de las pestañas coloreadas no seleccionadas en el tema Minimalista.\nDebe estar entre 0 y 1."
          }
        },
        "fr" : {
          "stringUnit" : {
