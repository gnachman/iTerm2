    "PTYSession.BellRingingVisible" : {
      "comment" : "Announcement offering to suppress output because the bell is ringing frequently",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvonek zvoní příliš často. Chcete potlačit veškerý výstup, dokud se situace neuklidní?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klokken ringer meget. Vil du undertrykke alt output, indtil det har lagt sig?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Signalton ertönt sehr häufig. Möchten Sie die gesamte Ausgabe unterdrücken, bis sich die Lage beruhigt hat?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The bell is ringing a lot. Want to suppress all output until things calm down?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana suena mucho. ¿Quieres suprimir toda la salida hasta que las cosas se calmen?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänimerkki soi usein. Haluatko estää kaiken tulosteen, kunnes tilanne rauhoittuu?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sonnerie retentit très souvent. Voulez-vous désactiver toute la sortie jusqu’au retour au calme ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il campanello suona spesso. Vuoi disattivare tutto l’output finché la situazione non si calma?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベルが頻繁に鳴っています。落ち着くまですべての出力を抑制しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벨이 자주 울리고 있습니다. 잠잠해질 때까지 모든 출력을 숨기겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bjellen ringer mye. Vil du skjule all utdata til ting roer seg?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bel gaat veel af. Wil je alle uitvoer onderdrukken totdat het weer rustig is?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzwonek dzwoni bardzo często. Pominąć całe wyjście, aż sytuacja się uspokoi?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A campainha está tocando muito. Deseja suprimir toda a saída até as coisas se acalmarem?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звонок звучит слишком часто. Подавить весь вывод, пока всё не успокоится?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvonček zvoní príliš často. Chcete potlačiť všetok výstup, kým sa situácia neupokojí?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvonec zvoni pogosto. Želite skriti ves izpis, dokler se stvari ne umirijo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljudsignalen låter mycket. Vill du dölja all utdata tills det lugnar ner sig?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zil çok sık çalıyor. Her şey yatışana kadar tüm çıktı bastırılsın mı?"
