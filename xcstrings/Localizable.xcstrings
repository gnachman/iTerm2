    "Tip.0035.Body" : {
      "comment" : "Tip of the day body, id 0035",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie in den Tag eines Profils einen Schrägstrich einfügen, wird dadurch implizit eine Hierarchie festgelegt. Diese sehen Sie im Profile-Menü als verschachtelte Untermenüs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you put a slash in a profile’s tag, that implicitly defines a hierarchy. You can see it in the Profiles menu as nested submenus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pones una barra en la etiqueta de un perfil, eso define implícitamente una jerarquía. Puedes verla en el menú Perfiles como submenús anidados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous placez une barre oblique dans le tag d’un profil, cela définit implicitement une hiérarchie. Vous la voyez dans le menu Profils sous forme de sous-menus imbriqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inserisci una barra nel tag di un profilo, questo definisce implicitamente una gerarchia. La vedi nel menu Profili come sottomenu annidati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルのタグにスラッシュを入れると、暗黙的に階層が定義されます。これはプロファイルメニューに入れ子になったサブメニューとして表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일 태그에 슬래시를 넣으면 계층 구조가 암묵적으로 정의됩니다. 프로파일 메뉴에서 중첩된 하위 메뉴로 확인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você colocar uma barra na tag de um perfil, isso define implicitamente uma hierarquia. Você pode vê-la no menu Perfis como submenus aninhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вставить в тег профиля косую черту, это неявно задаёт иерархию. Её можно увидеть в меню «Профили» в виде вложенных подменю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir profilin etiketine eğik çizgi koyarsanız bu örtük olarak bir hiyerarşi tanımlar. Bunu Profiller menüsünde iç içe alt menüler olarak görebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在配置文件的标签中加上斜杠，则隐含了层级关系。在“Profiles”菜单中可以看到嵌套的子菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在描述檔的標籤中加入斜線，就會隱含地定義出階層。你可以在「描述檔」選單中看到巢狀的子選單。"
          }
        }
      }
    },
