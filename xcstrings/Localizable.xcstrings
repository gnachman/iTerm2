    "Tip.0057.Body" : {
      "comment" : "Tip of the day body, id 0057",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte „Úpravy > Výběr respektuje měkké hranice“, aby se rozpoznaly dělicí čáry rozdělených podoken v programech jako vi, emacs a tmux a mohli jste vybrat více řádků textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå “Rediger > Markering respekterer bløde grænser” til for at genkende delere mellem opdelte ruder i programmer som vi, emacs og tmux, så du kan markere flere tekstlinjer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Bearbeiten > Auswahl berücksichtigt weiche Grenzen“, damit Trennlinien geteilter Bereiche in Programmen wie vi, emacs und tmux erkannt werden, sodass Sie mehrere Textzeilen auswählen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on “Edit > Selection Respects Soft Boundaries” to recognize split pane dividers in programs like vi, emacs, and tmux so you can select multiple lines of text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa “Edición > La selección respeta los límites flexibles” para reconocer los divisores de paneles en programas como vi, emacs y tmux y poder seleccionar varias líneas de texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön ”Muokkaa > Valinta noudattaa pehmeitä rajoja”, jotta jaettujen paneelien jakajat tunnistetaan ohjelmissa, kuten vi, emacs ja tmux, ja voit valita useita tekstirivejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Édition > La sélection respecte les limites souples » pour reconnaître les séparateurs de volets scindés dans des programmes comme vi, emacs et tmux et ainsi sélectionner plusieurs lignes de texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva “Modifica > La selezione rispetta i limiti morbidi” per riconoscere i divisori dei riquadri in programmi come vi, emacs e tmux e poter selezionare più righe di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 選択範囲でソフト境界を考慮」をオンにすると、vi、emacs、tmuxなどのプログラムで分割ペインの区切りを認識できるようになり、複数行のテキストを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“편집 > 소프트 경계를 고려하여 선택”을 켜면 vi, emacs, tmux 같은 프로그램의 분할 패널 구분선을 인식하므로 여러 줄의 텍스트를 선택할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på «Rediger > Markering respekterer myke grenser» for å gjenkjenne skillelinjer mellom delte ruter i programmer som vi, emacs og tmux, slik at du kan markere flere tekstlinjer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel ‘Wijzig > Selectie respecteert zachte grenzen’ in om scheidingslijnen van gesplitste panelen in programma’s als vi, emacs en tmux te herkennen, zodat je meerdere regels tekst kunt selecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz „Edycja > Zaznaczenie respektuje miękkie granice”, aby rozpoznawać separatory paneli w programach takich jak vi, emacs i tmux i móc zaznaczać wiele wierszy tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Editar > A seleção respeita limites flexíveis” para reconhecer divisórias de painéis em programas como vi, emacs e tmux, permitindo selecionar várias linhas de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Правка > Выделение учитывает мягкие границы», чтобы распознавать разделители панелей в таких программах, как vi, emacs и tmux, и выделять несколько строк текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite položku „Upraviť > Výber rešpektuje mäkké hranice“, aby sa v programoch ako vi, emacs a tmux rozpoznali oddeľovače rozdelených panelov a mohli ste vybrať viac riadkov textu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vklopite »Uredi > Izbor upošteva mehke meje«, da prepoznate razdelilnike podoken v programih, kot so vi, emacs in tmux, in lahko izberete več vrstic besedila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på ”Redigera > Markering respekterar mjuka gränser” för att känna igen avdelare mellan delade paneler i program som vi, emacs och tmux, så att du kan markera flera rader text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vi, emacs ve tmux gibi programlardaki bölme ayırıcılarını tanıyıp birden çok metin satırı seçebilmek için “Düzen > Seçim Yumuşak Sınırlara Uyar”ı açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật “Sửa > Vùng chọn tôn trọng ranh giới mềm” để nhận biết đường phân chia khung trong các chương trình như vi, emacs và tmux, để bạn có thể chọn nhiều dòng văn bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“编辑 > 选择遵循软边界”以识别 vi、emacs 和 tmux 等程序中的分屏窗格分隔线，从而可以选择多行文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「編輯 > 選取範圍遵循軟邊界」，即可辨識 vi、emacs 和 tmux 等程式中的分割窗格分隔線，讓你能選取多行文字。"
          }
        }
      }
    },
