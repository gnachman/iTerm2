          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Cursor Colorのテキスト色のしきい値（0から1）。\n0はカーソルのテキスト色が常にセルの背景色になり、1は常に黒または白になることを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 색상에 대한 스마트 커서 색상 임계값(0~1)\n0이면 커서의 텍스트 색상이 항상 셀의 배경색이 되고, 1이면 항상 검은색 또는 흰색이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terskel for smart markørfarge for tekstfarge (0 til 1).\n0 betyr at markørens tekstfarge alltid er cellens bakgrunnsfarge, mens 1 betyr at den alltid er svart eller hvit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drempel voor Slimme cursorkleur voor tekstkleur (0 tot 1).\n0 betekent dat de tekstkleur van de cursor altijd de achtergrondkleur van de cel is, terwijl 1 betekent dat die altijd zwart of wit is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próg Inteligentnego koloru kursora dla koloru tekstu (od 0 do 1).\n0 oznacza, że kolor tekstu kursora będzie zawsze kolorem tła komórki, a 1, że zawsze będzie czarny lub biały."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite da cor inteligente do cursor para a cor do texto (0 a 1).\n0 significa que a cor do texto do cursor será sempre a cor de plano de fundo da célula, enquanto 1 significa que será sempre preto ou branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог для функции «умный цвет курсора» (Smart Cursor Color) для цвета текста (от 0 до 1).\n0 означает, что цвет текста курсора всегда будет совпадать с цветом фона ячейки, а 1 — что он всегда будет чёрным или белым."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prah inteligentnej farby kurzora pre farbu textu (0 až 1).\n0 znamená, že farba textu kurzora bude vždy farba pozadia bunky, 1 že bude vždy čierna alebo biela."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prag za pametno barvo kazalca za barvo besedila (0 do 1).\n0 pomeni, da bo barva besedila kazalca vedno barva ozadja celice, 1 pa, da bo vedno črna ali bela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tröskelvärde för smart markörfärg för textfärg (0 till 1).\n0 betyder att markörens textfärg alltid är cellens bakgrundsfärg, medan 1 betyder att den alltid är svart eller vit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin rengi için Akıllı İmleç Rengi eşiği (0 ile 1).\n0, imlecin metin renginin her zaman hücrenin arka plan rengi olacağı, 1 ise her zaman siyah veya beyaz olacağı anlamına gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngưỡng của Màu con trỏ thông minh cho màu văn bản (0 đến 1).\n0 nghĩa là màu văn bản của con trỏ luôn là màu nền của ô, còn 1 nghĩa là luôn là đen hoặc trắng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本颜色智能光标颜色的阈值（0到1）。\n0表示光标文本颜色始终为单元格背景颜色，1则表示始终为黑色或白色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字顏色的智慧型游標顏色閾值（0 到 1）。\n0 表示游標的文字顏色一律為儲存格的背景顏色，1 則表示一律為黑色或白色。"
          }
        }
      }
    },
    "AdvancedSetting.smartLoggingWithAutoComposer" : {
      "comment" : "Advanced setting: smartLoggingWithAutoComposer",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout úspornější zapisování při použití automatického editoru příkazů?\nVyhne se zapisování nezpracovaných dat ve výzvě a vašich interakcí s ní. Místo toho se výzva zapíše jednou jako prostý text a příkaz se zapíše při odeslání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå mere kompakt logning til, når Automatisk kommandoeditor bruges?\nDet undgår at logge rådata i din prompt og dine interaktioner med den. I stedet logges prompten én gang som almindelig tekst, og kommandoen logges, når den sendes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompakteres Protokollieren bei Verwendung des Auto-Composers aktivieren?\nDadurch wird vermieden, dass Rohdaten Ihres Prompts und Ihrer Interaktionen damit protokolliert werden. Stattdessen wird der Prompt einmal als Klartext protokolliert und der Befehl beim Senden protokolliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable more compact logging when using auto composer?\nThis will avoid logging raw data in your prompt and your interactions with it. Instead, the prompt is logged once in plain text and the command is logged when sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Activar un registro más compacto al usar el compositor automático?\nEvita registrar datos sin procesar en tu prompt y tus interacciones con él. En su lugar, el prompt se registra una vez en texto sin formato y el comando se registra cuando se envía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaanko käyttöön kompaktimpi kirjaus automaattista komentoeditoria käytettäessä?\nTämä välttää raakadatan kirjaamisen komentokehotteessasi ja vuorovaikutuksessasi sen kanssa. Sen sijaan kehote kirjataan kerran pelkkänä tekstinä ja komento kirjataan lähetettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer une journalisation plus compacte avec le compositeur automatique ?\nCela évite de consigner les données brutes de votre invite et vos interactions avec elle. À la place, l’invite est consignée une fois en texte brut et la commande l’est à l’envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitare una registrazione più compatta quando si usa il compositore automatico?\nEvita di registrare i dati grezzi nel prompt e nelle tue interazioni con esso. Invece, il prompt viene registrato una volta in testo semplice e il comando viene registrato quando viene inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto Composer使用時、よりコンパクトなログ記録を有効にするか？\nこれによりプロンプトやそのやり取りの生データをログに残すことを避けられます。代わりに、プロンプトは一度だけプレーンテキストで記録され、コマンドは送信時に記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 컴포저를 사용할 때 더 간결한 로깅을 켜겠습니까?\n프롬프트의 원시 데이터와 프롬프트에서의 상호 작용을 로깅하지 않습니다. 대신 프롬프트는 일반 텍스트로 한 번 로깅되고 명령은 보낼 때 로깅됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver mer kompakt logging ved bruk av automatisk kommandoskriver?\nDette unngår å logge rådata i ledeteksten og samhandlingen din med den. I stedet logges ledeteksten én gang som ren tekst, og kommandoen logges når den sendes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compacter loggen inschakelen bij gebruik van de automatische opsteller?\nHierdoor worden ruwe gegevens in je prompt en je interacties ermee niet gelogd. In plaats daarvan wordt de prompt eenmaal als platte tekst gelogd en het commando wanneer het wordt verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy włączyć bardziej zwarte rejestrowanie przy użyciu Automatycznego edytora poleceń?\nUnika to zapisywania surowych danych w znaku zachęty i Twoich interakcji z nim. Zamiast tego znak zachęty jest zapisywany raz jako zwykły tekst, a polecenie jest zapisywane po wysłaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar registro mais compacto ao usar o auto composer?\nIsso evitará registrar dados brutos no seu prompt e suas interações com ele. Em vez disso, o prompt é registrado uma vez em texto simples e o comando é registrado quando enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить более компактное журналирование при использовании Автокомпозера?\nЭто позволит избежать журналирования необработанных данных приглашения и взаимодействия с ним. Вместо этого приглашение записывается один раз в виде обычного текста, а команда — при отправке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť kompaktnejšie zaznamenávanie pri použití automatického editora príkazov?\nVyhne sa zaznamenávaniu nespracovaných údajov vo vašej výzve a vašich interakcií s ňou. Namiesto toho sa výzva zaznamená raz ako obyčajný text a príkaz sa zaznamená pri odoslaní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se pri uporabi samodejnega urejevalnika ukazov omogoči kompaktnejše beleženje?\nTako se izogne beleženju neobdelanih podatkov v ukaznem pozivu in vaših interakcij z njim. Namesto tega se poziv enkrat zabeleži kot navadno besedilo, ukaz pa ob pošiljanju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera mer kompakt loggning när automatisk kommandoredigerare används?\nDet undviker att logga rådata i din prompt och dina interaktioner med den. I stället loggas prompten en gång som vanlig text och kommandot loggas när det skickas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik oluşturucu kullanılırken daha kompakt günlükleme etkinleştirilsin mi?\nBu, isteminizdeki ve onunla etkileşimlerinizdeki ham verilerin günlüğe yazılmasını önler. Bunun yerine istem düz metin olarak bir kez günlüğe yazılır ve komut gönderildiğinde günlüğe yazılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật ghi nhật ký gọn hơn khi dùng trình soạn lệnh tự động?\nĐiều này tránh ghi dữ liệu thô trong dấu nhắc và các tương tác của bạn với nó. Thay vào đó, dấu nhắc được ghi một lần dưới dạng văn bản thuần và lệnh được ghi khi gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自动生成器时是否启用更紧凑的日志？\n这将避免在提示词和您的交互中记录原始数据。相反，提示词以纯文本形式记录一次，命令在发送时记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自動編寫器時啟用更精簡的記錄？\n這會避免記錄提示詞及你與它互動的原始資料。取而代之，提示詞會以純文字記錄一次，指令則在傳送時記錄。"
          }
        }
      }
    },
    "AdvancedSetting.smartSelectionRadius" : {
      "comment" : "Advanced setting: smartSelectionRadius",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální počet řádků před místem kliknutí a za ním, které se zahrnou do chytrého výběru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt antal linjer før og efter klikpositionen, der medtages i smart markering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Zeilen vor und nach der Klickposition, die in die intelligente Auswahl einbezogen werden."
          }
        },
        "en" : {
