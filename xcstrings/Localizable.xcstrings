    "AdvancedSetting.detectParagraphDirection" : {
      "comment" : "Advanced setting: detectParagraphDirection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky zjišťovat směr psaní odstavce podle prvního silného směrového znaku?\nVyžaduje zapnutou podporu textu zprava doleva."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer automatisk afsnits skriveretning ud fra det første stærkt retningsbestemte tegn?\nKræver, at understøttelse af tekst fra højre mod venstre er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibrichtung von Absätzen automatisch anhand des ersten stark richtungsbestimmenden Zeichens erkennen?\nErfordert aktivierte Unterstützung für Rechts-nach-links-Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-detect paragraph writing direction based on the first strong directional character?\nRequires right-to-left text support to be enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Detectar automáticamente la dirección de escritura del párrafo según el primer carácter direccional fuerte?\nRequiere que esté activado el soporte de texto de derecha a izquierda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havaitaanko kappaleen kirjoitussuunta automaattisesti ensimmäisen vahvan suuntamerkin perusteella?\nVaatii oikealta vasemmalle -tekstin tuen käyttöönoton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecter automatiquement le sens d’écriture des paragraphes d’après le premier caractère directionnel fort ?\nNécessite l’activation de la prise en charge du texte de droite à gauche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevare automaticamente la direzione di scrittura del paragrafo in base al primo carattere direzionale forte?\nRichiede che il supporto per il testo da destra a sinistra sia abilitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段落の最初の強い方向性文字に基づいて、段落の書字方向を自動検出しますか?\n右から左のテキストサポートを有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 강한 방향성 문자를 기준으로 문단 쓰기 방향을 자동 감지하겠습니까?\n오른쪽에서 왼쪽으로 쓰는 텍스트 지원이 활성화되어 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdage skriveretningen for avsnitt automatisk ut fra det første sterkt retningsbestemte tegnet?\nKrever at støtte for tekst fra høyre mot venstre er aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schrijfrichting van een alinea automatisch detecteren op basis van het eerste sterke richtingsteken?\nVereist dat ondersteuning voor tekst van rechts naar links is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie wykrywać kierunek pisania akapitu na podstawie pierwszego silnie kierunkowego znaku?\nWymaga włączonej obsługi tekstu pisanego od prawej do lewej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar automaticamente a direção de escrita do parágrafo com base no primeiro caractere direcional forte?\nRequer que o suporte a texto da direita para a esquerda esteja ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически определять направление письма абзаца по первому символу с выраженным направлением?\nТребует включённой поддержки текста справа налево."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky zisťovať smer písania odseku podľa prvého silného smerového znaku?\nVyžaduje zapnutú podporu textu sprava doľava."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodejno zaznaj smer pisanja odstavka glede na prvi močni smerni znak?\nZahteva omogočeno podporo za besedilo od desne proti levi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiera styckets skrivriktning automatiskt utifrån det första starka riktningstecknet?\nKräver att stöd för höger-till-vänster-text är aktiverat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paragraf yazı yönü ilk güçlü yönlü karaktere göre otomatik algılansın mı?\nSağdan sola metin desteğinin etkin olmasını gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động phát hiện hướng viết của đoạn văn dựa trên ký tự có hướng mạnh đầu tiên?\nYêu cầu bật hỗ trợ văn bản từ phải sang trái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据第一个强方向字符自动检测段落书写方向？\n需要启用从右到左文本支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據第一個強方向字元自動偵測段落書寫方向？\n需要啟用由右至左文字支援。"
          }
        }
      }
    },
