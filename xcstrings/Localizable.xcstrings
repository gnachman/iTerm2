    "ChatViewController.PermissionScopeInfo" : {
      "comment" : "Explains the scope of a granted or denied permission",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Pokud oprávnění udělíte nebo zamítnete, platí to jen pro tuto konverzaci v chatu, dokud je propojena s touto konkrétní relací terminálu. Oprávnění můžete změnit v nabídce Informace v chatu.*"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Hvis du giver eller afviser tilladelse, gælder det kun denne chatsamtale, mens den er knyttet til netop denne terminalsession. Du kan ændre tilladelser i chattens menu Info.*"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Wenn Sie eine Berechtigung erteilen oder verweigern, wirkt sich das nur auf diese Chat-Unterhaltung aus, solange sie mit dieser bestimmten Terminalsitzung verknüpft ist. Sie können Berechtigungen im Info-Menü des Chats ändern.*"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "*If you grant or deny permission, it affects only this chat conversation while linked to this particular terminal session. You can change permissions in the chat Info menu.*"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Si concedes o denegas el permiso, solo afecta a esta conversación de chat mientras esté vinculada a esta sesión de terminal concreta. Puedes cambiar los permisos en el menú Información del chat.*"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Jos myönnät tai estät luvan, se vaikuttaa vain tähän keskusteluun, kun se on linkitetty tähän tiettyyn päätteen istuntoon. Voit muuttaa lupia keskustelun Tiedot-valikossa.*"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Si vous accordez ou refusez l’autorisation, elle ne concerne que cette conversation de chat tant qu’elle est liée à cette session de terminal précise. Vous pouvez modifier les autorisations dans le menu Informations du chat.*"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Se concedi o rifiuti l’autorizzazione, vale solo per questa conversazione della chat finché è collegata a questa specifica sessione di terminale. Puoi modificare le autorizzazioni nel menu Info della chat.*"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*権限を許可または拒否しても、この特定のターミナルセッションにリンクされている間のこのチャットの会話にのみ影響します。権限はチャットの情報メニューで変更できます。*"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*권한을 허용하거나 거부하면 이 특정 터미널 세션에 연결되어 있는 동안 이 채팅 대화에만 적용됩니다. 채팅 정보 메뉴에서 권한을 변경할 수 있습니다.*"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Hvis du gir eller avslår tillatelse, gjelder det bare denne chat-samtalen så lenge den er koblet til akkurat denne terminaløkten. Du kan endre tillatelser i chattens Info-meny.*"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Als je toestemming verleent of weigert, geldt dat alleen voor dit chatgesprek zolang het aan deze specifieke terminalsessie is gekoppeld. Je kunt toestemmingen wijzigen in het infomenu van de chat.*"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Przyznanie lub odmowa uprawnienia dotyczy tylko tej rozmowy na czacie, dopóki jest powiązana z tą konkretną sesją terminala. Uprawnienia możesz zmienić w menu Informacje czatu.*"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Se você conceder ou recusar a permissão, ela afeta apenas esta conversa de chat enquanto vinculada a esta sessão de terminal específica. Você pode alterar as permissões no menu Informações do chat.*"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Если вы предоставите или отклоните разрешение, это повлияет только на этот чат, пока он привязан именно к этой сессии терминала. Изменить разрешения можно в меню «Инфо» чата.*"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Ak povolenie udelíte alebo zamietnete, platí iba pre túto konverzáciu v chate, kým je prepojená s touto konkrétnou reláciou terminálu. Povolenia môžete zmeniť v menu Informácie chatu.*"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Če dovoljenje odobrite ali zavrnete, velja samo za ta pogovor v klepetu, dokler je povezan s to določeno sejo terminala. Dovoljenja lahko spremenite v meniju Informacije klepeta.*"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Om du ger eller nekar behörighet påverkar det bara den här chattkonversationen medan den är länkad till just den här terminalsessionen. Du kan ändra behörigheter i chattens Info-meny.*"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*İzin verirseniz veya reddederseniz, bu yalnızca bu sohbet konuşmasını ve yalnızca bu terminal oturumuna bağlı olduğu süreyi etkiler. İzinleri sohbetin Bilgi menüsünden değiştirebilirsiniz.*"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*Nếu bạn cấp hoặc từ chối quyền, quyết định đó chỉ ảnh hưởng đến cuộc trò chuyện này khi nó được liên kết với phiên terminal cụ thể này. Bạn có thể thay đổi quyền trong menu Thông tin của cuộc trò chuyện.*"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*如果授予或拒绝权限，仅影响与当前终端会话关联的此聊天对话。可在聊天界面中的信息菜单中更改权限。*"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*無論授予或拒絕權限，都只會影響此聊天對話與此特定終端機工作階段連結期間。你可以在聊天的「資訊」選單中變更權限。*"
          }
        }
      }
    },
    "ChatViewController.PermissionsHelp" : {
      "comment" : "Explains how to control AI permissions for a chat",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomocí těchto tlačítek nebo nabídky tlačítka informací v horní části okna chatu můžete řídit oprávnění AI pro tento chat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bruge disse knapper eller menuen under infoknappen øverst i chatvinduet til at styre AI-tilladelser for denne chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können diese Schaltflächen oder das Menü der Info-Schaltfläche oben im Chat-Fenster verwenden, um die KI-Berechtigungen für diesen Chat zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can use these buttons or the info button menu at the top of the chat window to control AI permissions for this chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes usar estos botones o el menú del botón de información en la parte superior de la ventana del chat para controlar los permisos de IA de este chat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit hallita tämän keskustelun AI-lupia näillä painikkeilla tai keskusteluikkunan yläreunan tietopainikkeen valikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser ces boutons ou le menu du bouton d’informations en haut de la fenêtre du chat pour contrôler les autorisations de l’IA pour ce chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi usare questi pulsanti o il menu del pulsante info nella parte superiore della finestra della chat per controllare le autorizzazioni IA di questa chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのボタン、またはチャットウインドウ上部にある情報ボタンのメニューを使って、このチャットのAI権限を管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버튼들이나 채팅 윈도우 상단의 정보 버튼 메뉴를 사용하여 이 채팅의 AI 권한을 제어할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bruke disse knappene eller menyen bak infoknappen øverst i chatvinduet til å styre KI-tillatelser for denne chatten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze knoppen of het menu van de infoknop boven in het chatvenster beheer je de AI-toestemmingen voor deze chat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz użyć tych przycisków lub menu przycisku informacji u góry okna czatu, aby kontrolować uprawnienia AI dla tego czatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode usar estes botões ou o menu do botão de informações no topo da janela de chat para controlar as permissões de IA deste chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете использовать эти кнопки или меню кнопки «Инфо» в верхней части окна чата, чтобы управлять разрешениями ИИ для этого чата."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ovládanie povolení AI pre tento chat môžete použiť tieto tlačidlá alebo menu tlačidla s informáciami v hornej časti okna chatu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S temi gumbi ali menijem gumba z informacijami na vrhu okna klepeta lahko nadzorujete dovoljenja AI za ta klepet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan använda de här knapparna eller menyn för infoknappen högst upp i chattfönstret för att styra AI-behörigheter för den här chatten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbetin YZ izinlerini denetlemek için bu düğmeleri veya sohbet penceresinin üstündeki bilgi düğmesi menüsünü kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể dùng các nút này hoặc menu của nút thông tin ở đầu cửa sổ trò chuyện để kiểm soát quyền AI cho cuộc trò chuyện này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用聊天窗口顶部的按钮或信息按钮菜单来控制此聊天的AI权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以使用這些按鈕，或聊天視窗頂端的資訊按鈕選單，來控制此聊天的 AI 權限。"
          }
        }
      }
    },
