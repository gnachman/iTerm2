    "JobTerminationMonitor.CannotWatchJob" : {
      "comment" : "Alert body when a process cannot be watched because it already exited",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemůže sledovat proces %1$@ s ID procesu %2$@, protože již byl ukončen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke overvåge processen %1$@ med proces-id %2$@, fordi den allerede er afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann den Prozess %1$@ mit der Prozess-ID %2$@ nicht überwachen, da er bereits beendet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 cannot watch the job %1$@ with process ID %2$@ because it has already terminated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 no puede vigilar el proceso %1$@ con ID de proceso %2$@ porque ya ha terminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei voi seurata prosessia %1$@ (prosessin tunnus %2$@), koska se on jo päättynyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ne peut pas surveiller le processus %1$@ (ID de processus %2$@), car il est déjà terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non può monitorare il processo %1$@ con ID processo %2$@ perché è già terminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブ %1$@（プロセス ID %2$@）はすでに終了しているため、iTerm2 は監視できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 %1$@(프로세스 ID %2$@)이(가) 이미 종료되어 iTerm2가 감시할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan ikke overvåke prosessen %1$@ med prosess-ID %2$@ fordi den allerede er avsluttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan het proces %1$@ met proces-ID %2$@ niet volgen, omdat het al is beëindigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie może obserwować procesu %1$@ o identyfikatorze %2$@, ponieważ został już zakończony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não pode monitorar o processo %1$@ com ID de processo %2$@ porque ele já foi encerrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 не может отслеживать задачу %1$@ с ID процесса %2$@, так как она уже завершилась."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nemôže sledovať proces %1$@ s ID procesu %2$@, pretože už bol ukončený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija iTerm2 ne more spremljati procesa %1$@ z ID-jem procesa %2$@, ker je že končan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan inte bevaka processen %1$@ med process-ID %2$@ eftersom den redan har avslutats."
          }
