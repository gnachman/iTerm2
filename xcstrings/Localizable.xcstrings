    "UvMigration.CompatibilityNote" : {
      "comment" : "Trailing note in the startup warning shown when migration bumps a script’s pinned Python version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze Pythonu nejsou mezi vydáními vždy kompatibilní, takže skript s novější verzí může vyžadovat drobné úpravy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-versioner er ikke altid kompatible på tværs af udgivelser, så en opdateret instruks kan have brug for små ændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-Versionen sind zwischen Releases nicht immer kompatibel, daher benötigt ein aktualisiertes Skript möglicherweise kleine Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Python versions are not always compatible across releases, so a bumped script may need small changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones de Python no siempre son compatibles entre versiones, por lo que un script actualizado puede necesitar pequeños cambios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-versiot eivät aina ole yhteensopivia julkaisujen välillä, joten päivitetty skripti voi vaatia pieniä muutoksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les versions de Python ne sont pas toujours compatibles d’une version à l’autre, un script mis à niveau peut donc nécessiter de petites modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le versioni di Python non sono sempre compatibili tra una release e l’altra, quindi uno script aggiornato potrebbe richiedere piccole modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythonのバージョンはリリース間で必ずしも互換性があるとは限らないため、バージョンが上がったスクリプトには軽微な変更が必要になる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 버전은 릴리스 간에 항상 호환되지는 않으므로, 버전이 올라간 스크립트는 약간 수정해야 할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-versjoner er ikke alltid kompatible på tvers av utgivelser, så et oppdatert skript kan trenge små endringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-versies zijn niet altijd compatibel tussen releases, dus een bijgewerkt script heeft mogelijk kleine aanpassingen nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersje Pythona nie zawsze są zgodne między wydaniami, więc skrypt z podniesioną wersją może wymagać drobnych zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As versões do Python nem sempre são compatíveis entre lançamentos, então um script atualizado pode precisar de pequenas alterações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версии Python не всегда совместимы между релизами, поэтому обновлённому скрипту могут потребоваться небольшие изменения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzie Python nie sú vždy kompatibilné medzi vydaniami, preto môže skript s novšou verziou vyžadovať drobné úpravy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različice Pythona med izdajami niso vedno združljive, zato bo posodobljen skript morda treba rahlo popraviti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-versioner är inte alltid kompatibla mellan utgåvor, så ett uppdaterat skript kan behöva små ändringar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python sürümleri her yayında uyumlu olmayabilir, bu yüzden sürümü yükseltilen bir betikte küçük değişiklikler gerekebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các phiên bản Python không phải lúc nào cũng tương thích giữa các bản phát hành, nên một tập lệnh đã được nâng cấp có thể cần chỉnh sửa nhỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python版本在不同版本间并不总是兼容，因此升级后的脚本可能需要一些小修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 版本在不同發行版之間不一定相容，因此升級後的腳本可能需要一些小幅修改。"
          }
        }
      }
    },
    "UvMigration.MultipleScriptsLead" : {
