    "AdvancedSetting.alertTriggerRateLimit" : {
      "comment" : "Advanced setting: alertTriggerRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omezení frekvence spouštěčů Upozornění.\nPokud se stejný spouštěč aktivuje s kratším časovým odstupem (v sekundách), než je tato hodnota, bude potlačen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastighedsgrænse for advarselsudløsere.\nHvis den samme udløser aktiveres med mindre end dette tidsinterval (i sekunder) mellem aktiveringerne, bliver den undertrykt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratenbegrenzung für Warnmeldungs-Trigger.\nWenn derselbe Trigger mit weniger als diesem Zeitintervall (in Sekunden) zwischen den Auslösungen feuert, wird er unterdrückt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rate limit for Alert triggers.\nIf the same trigger fires with less than this time interval (in seconds) between firings, it will be suppressed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de frecuencia de los disparadores de alerta.\nSi el mismo disparador se activa con un intervalo de tiempo (en segundos) menor que este entre activaciones, se suprimirá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoituskäynnistinten nopeusraja.\nJos sama käynnistin laukeaa laukeamisten välillä tätä aikaväliä (sekunteina) lyhyemmällä viiveellä, se vaimennetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de fréquence pour les déclencheurs d’alerte.\nSi le même déclencheur s’active avec un intervalle inférieur à cette durée (en secondes) entre deux activations, il sera ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite di frequenza per gli attivatori Avviso.\nSe lo stesso attivatore scatta con meno di questo intervallo di tempo (in secondi) tra un’attivazione e l’altra, verrà disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラートトリガーのレート制限。\n同じトリガーがこの間隔（秒）未満で連続して発動した場合、抑制されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고 트리거의 빈도 제한.\n같은 트리거가 이 시간 간격(초)보다 짧은 간격으로 실행되면 표시되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frekvensgrense for Varsel-utløsere.\nHvis den samme utløseren utløses med kortere tidsintervall (i sekunder) enn dette mellom utløsningene, undertrykkes den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequentielimiet voor Waarschuwing-triggers.\nAls dezelfde trigger wordt geactiveerd met minder dan dit tijdsinterval (in seconden) tussen activeringen, wordt hij onderdrukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit częstotliwości wyzwalaczy alertów.\nJeśli ten sam wyzwalacz uruchomi się z odstępem krótszym niż ten czas (w sekundach), zostanie pominięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa para gatilhos de Alerta.\nSe o mesmo gatilho disparar com menos que este intervalo de tempo (em segundos) entre disparos, ele será suprimido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничение частоты для триггеров типа «Оповещение».\nЕсли один и тот же триггер срабатывает чаще, чем раз в указанный интервал (в секундах), последующие срабатывания подавляются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit frekvencie spúšťačov upozornení.\nAk sa ten istý spúšťač aktivuje s časovým odstupom (v sekundách) menším, než je táto hodnota, bude potlačený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omejitev hitrosti za sprožilce opozoril.\nČe se isti sprožilec sproži z manjšim časovnim razmikom (v sekundah) od te vrednosti, bo utišan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frekvensgräns för varningsutlösare.\nOm samma utlösare utlöses med kortare tid än så här (i sekunder) mellan utlösningarna undertrycks den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı tetikleyicileri için hız sınırı.\nAynı tetikleyici, tetiklenmeleri arasında bu süreden (saniye cinsinden) kısa bir aralıkla tetiklenirse bastırılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn tần suất cho trình kích hoạt Cảnh báo.\nNếu cùng một trình kích hoạt chạy với khoảng thời gian (tính bằng giây) giữa các lần chạy ngắn hơn giá trị này, nó sẽ bị chặn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert触发器的限制时间。\n如果同一触发器在小于该间隔（以秒为单位）的时间内再次触发，则会被抑制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警示觸發器的速率限制。\n如果同一個觸發器兩次觸發的間隔短於此時間（以秒為單位），就會被抑制。"
          }
        }
      }
    },
