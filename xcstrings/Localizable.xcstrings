    "Tip.0011.Body" : {
      "comment" : "Tip of the day body, id 0011",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamické profily umožňují uložit profily do jednoho nebo více souborů JSON. Jsou skvělé pro hromadné vytváření a úpravy profilů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dynamiske profiler kan du gemme dine profiler som en eller flere JSON-arkiver. Det er perfekt til at oprette og redigere profiler i bulk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Dynamischen Profilen können Sie Ihre Profile als eine oder mehrere JSON-Dateien speichern. Das eignet sich hervorragend, um Profile im großen Stil zu erstellen und zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamic Profiles let you store your profiles as one or more JSON files. It’s great for batch creating and editing profiles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles dinámicos te permiten almacenar tus perfiles como uno o más archivos JSON. Es ideal para crear y editar perfiles por lotes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynaamisten profiilien avulla voit tallentaa profiilisi yhteen tai useampaan JSON-tiedostoon. Se sopii erinomaisesti profiilien joukkoluontiin ja -muokkaukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils dynamiques vous permettent de stocker vos profils dans un ou plusieurs fichiers JSON. C’est idéal pour créer et modifier des profils par lots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili dinamici ti permettono di memorizzare i profili in uno o più file JSON. Sono ideali per creare e modificare profili in blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイナミックプロファイルを使うと、プロファイルを1つ以上のJSONファイルとして保存できます。プロファイルの一括作成や編集に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동적 프로파일을 사용하면 프로파일을 하나 이상의 JSON 파일로 저장할 수 있습니다. 프로파일을 일괄 생성하고 편집할 때 매우 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dynamiske profiler kan du lagre profilene dine som én eller flere JSON-filer. Det er flott for å opprette og redigere profiler i bulk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met dynamische profielen kun je je profielen opslaan als een of meer JSON-bestanden. Ideaal voor het in bulk maken en wijzigen van profielen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile dynamiczne pozwalają przechowywać profile w jednym lub wielu plikach JSON. Świetnie nadają się do zbiorczego tworzenia i edytowania profili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Perfis dinâmicos permitem armazenar seus perfis como um ou mais arquivos JSON. É ótimo para criar e editar perfis em lote."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Динамические профили позволяют хранить ваши профили в виде одного или нескольких файлов JSON. Это отлично подходит для пакетного создания и редактирования профилей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamické profily umožňujú ukladať profily v jednom alebo viacerých súboroch JSON. Skvelé na hromadné vytváranie a úpravu profilov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamični profili omogočajo shranjevanje profilov v eni ali več datotekah JSON. Odlični so za množično ustvarjanje in urejanje profilov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med dynamiska profiler kan du lagra dina profiler som en eller flera JSON-filer. Det är utmärkt för att skapa och redigera profiler i grupp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinamik Profiller, profillerinizi bir veya daha fazla JSON dosyasında saklamanızı sağlar. Profilleri toplu oluşturmak ve düzenlemek için harikadır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hồ sơ động cho phép bạn lưu các hồ sơ dưới dạng một hoặc nhiều tệp JSON. Rất phù hợp để tạo và sửa hồ sơ hàng loạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "动态配置文件允许你将配置文件存储为一个或多个JSON文件。非常适合批量创建和编辑配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動態描述檔可讓你將描述檔儲存為一個或多個 JSON 檔案，非常適合批次建立和編輯描述檔。"
          }
        }
      }
    },
