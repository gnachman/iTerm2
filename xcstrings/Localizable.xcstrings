    "Tip.0061.Body" : {
      "comment" : "Tip of the day body, id 0061",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wussten Sie schon? Wenn der Signalton zu häufig ertönt, werden Sie gefragt, ob Sie ihn vorübergehend stummschalten möchten. iTerm2 legt Wert auf Ihren Komfort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Did you know? If the bell rings too often, you’ll be asked if you’d like to silence it temporarily. iTerm2 cares about your comfort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sabías que...? Si la campana suena con demasiada frecuencia, se te preguntará si quieres silenciarla temporalmente. A iTerm2 le importa tu comodidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le saviez-vous ? Si la sonnerie retentit trop souvent, on vous demandera si vous voulez la couper temporairement. iTerm2 se soucie de votre confort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sapevi? Se il campanello suona troppo spesso, ti verrà chiesto se vuoi silenziarlo temporaneamente. A iTerm2 sta a cuore il tuo comfort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご存じでしたか?ベルが頻繁に鳴りすぎると、一時的に消音するかどうか尋ねられます。iTerm2はあなたの快適さを大切にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알고 계셨습니까? 벨이 너무 자주 울리면 일시적으로 소리를 끌지 묻는 메시지가 표시됩니다. iTerm2는 사용자의 편안함을 생각합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sabia? Se a campainha tocar com muita frequência, será perguntado se você deseja silenciá-la temporariamente. O iTerm2 se importa com o seu conforto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А вы знали? Если звуковой сигнал звучит слишком часто, вам предложат временно его отключить. iTerm2 заботится о вашем комфорте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biliyor muydunuz? Zil çok sık çalarsa onu geçici olarak sessize almak isteyip istemediğiniz sorulur. iTerm2 rahatınızı önemser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道吗？如果铃声响得太频繁，系统会询问你是否希望暂时关闭它。iTerm2注重你的使用体验。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道嗎？如果響鈴響得太頻繁，系統會詢問你是否要暫時將它靜音。iTerm2 很在意你的使用感受。"
          }
        }
      }
    },
    "Tip.0061.Title" : {
      "comment" : "Tip of the day title, id 0061",
