    "ColorPresets.DuplicateInformative" : {
      "comment" : "Informative text shown when adding a duplicate color preset; %@ is the preset name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolba barev „%@“ je stejná jako předvolba, kterou se pokoušíte přidat. Opravdu ji přidat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
