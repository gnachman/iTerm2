    "KeysPreferences.HotkeyPanelExplanation" : {
      "comment" : "Explanation shown in the hotkey window configuration panel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento panel vám pomůže nastavit nový profil, který bude svázán s klávesovou zkratkou, kterou zadáte. Stisknutím horké klávesy (i když iTerm2 není aktivní) se zobrazí nebo skryje speciální okno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette panel hjælper dig med at konfigurere en ny profil, der knyttes til et tastetryk, du vælger. Når du trykker på genvejstasten (også når iTerm2 ikke er aktiv), vises eller skjules et særligt vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Bedienfeld hilft Ihnen, ein neues Profil zu konfigurieren, das an eine von Ihnen zugewiesene Tastenkombination gebunden wird. Das Drücken des Hotkeys (auch wenn iTerm2 nicht aktiv ist) schaltet ein spezielles Fenster um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This panel helps you configure a new profile that will be bound to a keystroke you assign. Pressing the hotkey (even when iTerm2 is not active) will toggle a special window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este panel te ayuda a configurar un nuevo perfil que se asociará a una combinación de teclas que asignes. Al pulsar la tecla rápida (incluso cuando iTerm2 no está activo) se mostrará u ocultará una ventana especial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä paneeli auttaa määrittämään uuden profiilin, joka sidotaan antamaasi näppäinyhdistelmään. Pikanäppäimen painaminen (myös silloin, kun iTerm2 ei ole aktiivinen) näyttää tai kätkee erityisen ikkunan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce panneau vous aide à configurer un nouveau profil qui sera associé à une combinaison de touches que vous choisirez. Appuyer sur le raccourci global (même quand iTerm2 n’est pas actif) affichera ou masquera une fenêtre spéciale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo pannello ti aiuta a configurare un nuovo profilo che sarà associato a una combinazione di tasti che assegni. Premendo l’abbreviazione globale (anche quando iTerm2 non è attivo) verrà mostrata o nascosta una finestra speciale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパネルでは、割り当てたキーストロークにバインドされる新しいプロファイルを設定できます。ホットキーを押すと（iTerm2がアクティブでない場合でも）、特別なウインドウが表示または非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패널에서는 사용자가 지정한 키 입력에 연결될 새로운 프로파일을 구성할 수 있습니다. 단축키를 누르면(iTerm2가 활성 상태가 아닐 때도) 특수 윈도우가 열리거나 닫힙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette panelet hjelper deg med å konfigurere en ny profil som knyttes til en tastekombinasjon du velger. Når du trykker hurtigtasten (selv når iTerm2 ikke er aktivt), vises eller skjules et spesialvindu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met dit paneel configureer je een nieuw profiel dat wordt gekoppeld aan een toetscombinatie die je zelf kiest. Als je op de sneltoets drukt (ook als iTerm2 niet actief is), wordt een speciaal venster getoond of verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten panel pomaga skonfigurować nowy profil powiązany z przypisanym przez ciebie skrótem klawiszowym. Naciśnięcie klawisza skrótu (nawet gdy iTerm2 nie jest aktywny) pokaże lub ukryje specjalne okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este painel ajuda você a configurar um novo perfil que será associado a uma tecla que você atribuir. Pressionar a hotkey (mesmo quando o iTerm2 não está ativo) alternará uma janela especial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта панель помогает настроить новый профиль, который будет привязан к назначенному вами сочетанию клавиш. Нажатие горячей клавиши (даже если iTerm2 неактивен) переключает специальное окно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento panel vám pomôže nastaviť nový profil, ktorý bude viazaný na vami zvolenú skratku. Stlačením aktivačnej skratky (aj keď iTerm2 nie je aktívny) sa zobrazí alebo skryje špeciálne okno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta plošča vam pomaga konfigurirati nov profil, ki bo povezan z dodeljeno kombinacijo tipk. S pritiskom hitre tipke (tudi ko aplikacija iTerm2 ni aktivna) boste prikazali ali skrili posebno okno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här panelen hjälper dig att konfigurera en ny profil som kopplas till ett tangenttryck som du anger. När du trycker på snabbtangenten (även när iTerm2 inte är aktivt) visas eller göms ett särskilt fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panel, atadığınız bir tuş kombinasyonuna bağlanacak yeni bir profil yapılandırmanıza yardımcı olur. Kısayol tuşuna basmak (iTerm2 etkin olmasa bile) özel bir pencereyi açıp kapatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng này giúp bạn định cấu hình một hồ sơ mới sẽ được gán với tổ hợp phím do bạn chỉ định. Nhấn phím nóng (kể cả khi iTerm2 không hoạt động) sẽ bật/tắt một cửa sổ đặc biệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板可帮助你配置一个绑定到你指定的按键的新配置文件。按下热键（即使 iTerm2 未处于活跃状态）将切换一个特殊窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板可協助你設定一個綁定至你所指定按鍵的新描述檔。按下全域快速鍵（即使 iTerm2 不是使用中的 App）會切換一個特殊視窗。"
          }
        }
      }
    },
