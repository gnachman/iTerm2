    "ImportExport.DryRunCompleteBody" : {
      "comment" : "Body of the alert shown after a dry-run erase completes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 zapsal do Console.app, co by smazal. Ve skutečnosti nebylo nic smazáno, protože je zapnuto pokročilé nastavení „Zkušební spuštění akce ‚Smazat všechna nastavení a data‘“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 loggede til Console.app, hvad det ville have slettet. Der blev ikke slettet noget, fordi den avancerede indstilling “Testkørsel af ‘Slet alle indstillinger og data’” er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 hat protokolliert, was es in Console.app gelöscht hätte. Es wurde nichts tatsächlich gelöscht, da die erweiterte Einstellung „Testlauf: Alle Einstellungen und Daten löschen“ aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 logged what it would have erased to Console.app. Nothing was actually deleted because the “Dry-run Erase All Settings and Data” advanced setting is enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 registró en Console.app lo que habría borrado. En realidad no se eliminó nada porque el ajuste avanzado “Simulacro de ‘Borrar todos los ajustes y datos’” está activado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kirjasi Console.app-sovellukseen, mitä se olisi poistanut. Mitään ei todellisuudessa poistettu, koska lisäasetus ”Kuivakäynti: poista kaikki asetukset ja tiedot” on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 a consigné dans Console.app ce qu’il aurait effacé. Rien n’a réellement été supprimé, car le réglage avancé « Simulation de “Effacer tous les réglages et données” » est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ha registrato in Console.app ciò che avrebbe cancellato. In realtà non è stato eliminato nulla perché è abilitata l’impostazione avanzata “Prova a vuoto di ‘Cancella tutte le impostazioni e i dati’”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 は、消去する予定だった内容を Console.app に記録しました。「Dry-run Erase All Settings and Data」の詳細設定が有効になっているため、実際には何も削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 지웠을 항목을 Console.app에 기록했습니다. “‘모든 설정 및 데이터 지우기’ 시험 실행” 고급 설정이 켜져 있으므로 실제로는 아무것도 삭제되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 logget det som ville ha blitt slettet, til Console.app. Ingenting ble faktisk slettet fordi den avanserte innstillingen «Prøvekjøring av ‘Slett alle innstillinger og data’» er aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 heeft in Console.app vastgelegd wat er gewist zou zijn. Er is niets daadwerkelijk verwijderd omdat de geavanceerde instelling ‘Proefrun van “Wis alle instellingen en gegevens”’ is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 zapisał w Console.app, co zostałoby usunięte. Nic nie zostało faktycznie usunięte, ponieważ włączone jest ustawienie zaawansowane „Próbny przebieg ‚Usuń wszystkie ustawienia i dane’”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 registrou no aplicativo Console o que teria apagado. Nada foi realmente excluído porque o ajuste avançado “Dry-run Erase All Settings and Data” está ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 записал в Console.app информацию о том, что было бы удалено. Ничего не было удалено на самом деле, поскольку включена расширенная настройка «Пробное удаление всех настроек и данных»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 zaznamenal do Console.app, čo by vymazal. Nič sa skutočne neodstránilo, pretože je zapnuté rozšírené nastavenie „Dry-run Erase All Settings and Data“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 je v Console.app zabeležil, kaj bi izbrisal. Dejansko ni bilo izbrisano nič, ker je omogočena napredna nastavitev »Poskusni zagon ›Izbriši vse nastavitve in podatke‹«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 loggade till Console.app vad som skulle ha raderats. Ingenting raderades egentligen eftersom den avancerade inställningen ”Testkörning av Radera alla inställningar och data” är aktiverad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, sileceği öğeleri Console.app’e kaydetti. “Tüm Ayarları ve Verileri Silme Denemesi” gelişmiş ayarı etkin olduğundan gerçekte hiçbir şey silinmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 đã ghi vào Console.app những gì lẽ ra đã bị xóa. Thực tế không có gì bị xóa vì cài đặt nâng cao “Chạy thử việc xóa tất cả cài đặt và dữ liệu” đang bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 已将本应擦除的内容记录到“控制台”应用中。由于“干运行擦除所有设置和数据”高级设置已启用，实际上没有删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 已將原本會清除的內容記錄到 Console.app。由於已啟用「模擬清除所有設定與資料」進階設定，實際上並未刪除任何內容。"
          }
        }
      }
    },
