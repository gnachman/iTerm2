        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영숫자가 합자에 포함되지 않도록 하는 대신 그리기 성능을 향상시킵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedrer tegneytelsen på bekostning av at alfanumeriske tegn ikke kan inngå i ligaturer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbetert de tekenprestaties ten koste van het niet toestaan dat alfanumerieke tekens deel uitmaken van ligaturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprawia wydajność rysowania kosztem zakazu należenia znaków alfanumerycznych do ligatur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhora o desempenho de desenho ao custo de não permitir que caracteres alfanuméricos pertençam a ligaduras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повышает производительность отрисовки за счёт запрета буквенно-цифровым символам входить в лигатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlepší výkon kreslenia za cenu toho, že alfanumerické znaky nemôžu patriť do ligatúr."
          }
        },
        "sl" : {
          "stringUnit" : {
