      }
    },
    "PTYSession.ResizeReportingLeftOn" : {
      "comment" : "Announcement offering to turn off resize reporting that was left enabled",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že hlášení změny velikosti zůstalo zapnuté po neočekávaném ukončení relace ssh nebo chybě aplikace. Vypnout ho?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at rapportering af størrelsesændring blev ladt slået til, da en ssh-session sluttede uventet, eller et program fungerede forkert. Vil du slå den fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anscheinend wurde die Größenänderungs-Berichterstattung aktiviert gelassen, als eine SSH-Sitzung unerwartet endete oder sich eine App fehlerhaft verhielt. Ausschalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks like resize reporting was left on when an ssh session ended unexpectedly or an app misbehaved. Turn it off?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que el informe del cambio de tamaño se quedó activado cuando una sesión ssh terminó de forma inesperada o una app se comportó mal. ¿Desactivarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koonmuutoksen raportointi näyttää jääneen päälle, kun ssh-istunto päättyi odottamatta tai sovellus toimi virheellisesti. Laitetaanko se pois päältä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que le signalement du redimensionnement soit resté activé après la fin inattendue d’une session ssh ou le dysfonctionnement d’une app. Le désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che la segnalazione del ridimensionamento sia rimasta attiva dopo la fine inattesa di una sessione ssh o il malfunzionamento di un’app. Vuoi disattivarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが予期せず終了したか、アプリが誤動作したため、リサイズレポートがオンのままになっているようです。オフにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 세션이 예기치 않게 종료되었거나 앱이 오작동하여 크기 조절 리포팅이 켜진 채로 남아 있는 것 같습니다. 끄겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at rapportering av størrelsesendring ble stående på da en ssh-økt tok uventet slutt eller et program oppførte seg feil. Vil du slå den av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat rapportage van formaatwijzigingen is blijven aanstaan nadat een ssh-sessie onverwacht eindigde of een app zich misdroeg. Wil je het uitschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że raportowanie zmiany rozmiaru pozostało włączone po nieoczekiwanym zakończeniu sesji ssh lub nieprawidłowym działaniu aplikacji. Wyłączyć je?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que o relatório de redimensionamento ficou ativado quando uma sessão ssh terminou inesperadamente ou um app se comportou mal. Desativá-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, отслеживание изменения размера окна осталось включённым после неожиданного завершения SSH-сессии или сбоя приложения. Отключить его?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá sa, že hlásenie zmeny veľkosti zostalo zapnuté po neočakávanom skončení relácie ssh alebo nesprávnom správaní aplikácie. Vypnúť ho?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videti je, da je poročanje spremembe velikosti ostalo vklopljeno, ker se je seja SSH nepričakovano končala ali pa se je aplikacija nepravilno obnašala. Ga želite izklopiti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut som att rapportering av storleksändring lämnades på när en ssh-session avslutades oväntat eller ett program betedde sig fel. Vill du stänga av den?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ssh oturumu beklenmedik şekilde sona erdiğinde veya bir uygulama hatalı davrandığında yeniden boyutlandırma raporlama açık kalmış gibi görünüyor. Kapatılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ báo cáo đổi kích thước đã bị để bật khi một phiên ssh kết thúc bất ngờ hoặc một ứng dụng hoạt động sai. Tắt nó đi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来 ssh 会话意外结束或应用异常时，调整大小上报仍处于开启状态。要关闭吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看來在 ssh 工作階段意外結束或 App 行為異常時，調整大小回報被保持開啟。要將它關閉嗎？"
          }
        }
      }
    },
    "PTYSession.ResizeUnfocusedPrompt" : {
      "comment" : "Prompt asking whether to allow a program to resize the window while the session is inactive",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program se pokusil změnit velikost okna, když tato relace nebyla aktivní. Povolit to?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et program har forsøgt at ændre vinduets størrelse, mens denne session ikke var aktiv. Vil du tillade det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Programm hat versucht, die Fenstergröße zu ändern, während diese Sitzung nicht aktiv war. Erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A program has tried to resize the window while this session was not active. Allow it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programa ha intentado cambiar el tamaño de la ventana mientras esta sesión no estaba activa. ¿Permitirlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjelma yritti muuttaa ikkunan kokoa, kun tämä istunto ei ollut aktiivinen. Sallitaanko se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programme a tenté de redimensionner la fenêtre alors que cette session n’était pas active. L’autoriser ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un programma ha tentato di ridimensionare la finestra mentre questa sessione non era attiva. Vuoi consentirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションがアクティブでないときに、プログラムがウィンドウのサイズ変更を試みました。許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션이 활성 상태가 아닐 때 프로그램이 윈도우 크기를 조절하려고 했습니다. 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et program har forsøkt å endre størrelsen på vinduet mens denne økten ikke var aktiv. Vil du tillate det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een programma heeft geprobeerd het formaat van het venster te wijzigen terwijl deze sessie niet actief was. Wil je dit toestaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program próbował zmienić rozmiar okna, gdy ta sesja nie była aktywna. Pozwolić na to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um programa tentou redimensionar a janela enquanto esta sessão não estava ativa. Permitir?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Программа попыталась изменить размер окна, пока эта сессия была неактивна. Разрешить это?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program sa pokúsil zmeniť veľkosť okna, keď táto relácia nebola aktívna. Povoliť to?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program je poskušal spremeniti velikost okna, ko ta seja ni bila aktivna. Ga želite dovoliti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett program har försökt ändra fönstrets storlek medan den här sessionen inte var aktiv. Vill du tillåta det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oturum etkin değilken bir program pencereyi yeniden boyutlandırmaya çalıştı. İzin verilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một chương trình đã cố đổi kích thước cửa sổ khi phiên này không hoạt động. Cho phép?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话不活动时，程序尝试调整窗口大小。允许吗？"
