    "LaunchExperience.SystemPythonOutdatedMessage" : {
      "comment" : "Message that the system Python iterm2 module is out of date; placeholder is the shell command to run",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul iterm2 systémového Pythonu je zastaralý a s touto verzí iTerm2 nebude fungovat. Opravíte to spuštěním `%@`."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-modulet iterm2 i systemet er forældet og virker ikke med denne version af iTerm2. Kør `%@` for at rette det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iterm2-Modul des System-Python ist veraltet und funktioniert nicht mit dieser Version von iTerm2. Führen Sie `%@` aus, um das Problem zu beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
