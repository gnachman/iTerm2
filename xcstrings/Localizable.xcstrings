    "RestorableState.RestoreWindowsMessage" : {
      "comment" : "Warning asking whether to retry restoring windows after a failure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim letzten Start von iTerm2 gab es Probleme bei der Wiederherstellung einiger Fenster. Erneut versuchen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some windows had trouble restoring last time iTerm2 launched. Try again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas ventanas tuvieron problemas al restaurarse la última vez que se inició iTerm2. ¿Volver a intentarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines fenêtres ont rencontré des difficultés lors de leur restauration au dernier lancement d’iTerm2. Réessayer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune finestre hanno avuto problemi di ripristino all’ultimo avvio di iTerm2. Riprovare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回iTerm2を起動したとき、一部のウィンドウの復元に問題がありました。もう一度試しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난번 iTerm2를 실행했을 때 일부 윈도우를 복원하는 데 문제가 있었습니다. 다시 시도하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas janelas tiveram problemas ao serem restauradas na última vez que o iTerm2 foi iniciado. Tentar novamente?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При последнем запуске iTerm2 не удалось восстановить некоторые окна. Повторить попытку?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 en son başlatıldığında bazı pencereler geri yüklenirken sorun yaşandı. Yeniden denensin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次 iTerm2 启动时某些窗口恢复出现问题。重试？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次 iTerm2 啟動時，部分視窗在回復時發生問題。要再試一次嗎？"
          }
        }
      }
    },
    "RestorableState.SlowRestoreBody" : {
      "comment" : "Explanation shown when window restoration is slow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 benötigt länger als üblich, um Ihre gespeicherten Fenster und Tabs zu überprüfen. Das bedeutet in der Regel, dass das System ausgelastet ist und es unbedenklich ist, weiter zu warten. Es kann aber auch an einer beschädigten Datenbank zur Zustandswiederherstellung liegen. Sie können die gespeicherten Fenster stattdessen verwerfen, wenn Sie nicht warten möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 is taking longer than usual to verify your saved windows and tabs. This usually means the system is busy and it’s safe to keep waiting, but a damaged state restoration database could also cause it. You can discard the saved windows instead if you’d rather not wait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 está tardando más de lo habitual en verificar tus ventanas y pestañas guardadas. Normalmente significa que el sistema está ocupado y es seguro seguir esperando, pero también podría deberse a una base de datos de restauración de estado dañada. Si prefieres no esperar, puedes descartar las ventanas guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 met plus de temps que d’habitude à vérifier vos fenêtres et onglets enregistrés. Cela signifie généralement que le système est occupé et que vous pouvez continuer d’attendre, mais une base de données de restauration d’état endommagée peut aussi en être la cause. Vous pouvez abandonner les fenêtres enregistrées si vous préférez ne pas attendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 sta impiegando più del solito per verificare le finestre e i pannelli salvati. Di solito significa che il sistema è occupato ed è sicuro continuare ad attendere, ma potrebbe dipendere anche da un database di ripristino dello stato danneggiato. Se preferisci non attendere, puoi scartare le finestre salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は保存されたウィンドウとタブの確認にいつもより時間がかかっています。通常はシステムが混雑していることが原因で、そのまま待機しても問題ありませんが、状態復元用データベースが破損していることも原因として考えられます。待ちたくない場合は、代わりに保存されたウィンドウを破棄できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2가 저장된 윈도우와 탭을 확인하는 데 평소보다 오래 걸리고 있습니다. 보통은 시스템이 바쁘다는 뜻이므로 계속 기다려도 괜찮지만, 상태 복원 데이터베이스가 손상되어 발생할 수도 있습니다. 기다리고 싶지 않다면 대신 저장된 윈도우를 버릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 está demorando mais do que o normal para verificar as janelas e abas salvas. Isso geralmente significa que o sistema está ocupado e é seguro continuar aguardando, mas um banco de dados de restauração de estado danificado também pode causar isso. Se preferir não esperar, você pode descartar as janelas salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка сохранённых окон и вкладок в iTerm2 занимает больше времени, чем обычно. Как правило, это означает, что система перегружена и можно спокойно подождать, но причиной также может быть повреждённая база данных восстановления состояния. Если вы не хотите ждать, можно отказаться от восстановления сохранённых окон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, kaydedilen pencerelerinizi ve sekmelerinizi doğrulamak için normalden uzun sürüyor. Bu genellikle sistemin meşgul olduğu anlamına gelir ve beklemeye devam etmek güvenlidir, ancak hasarlı bir durum geri yükleme veritabanı da buna neden olabilir. Beklemek istemiyorsanız kaydedilen pencereleri atabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 验证已存储的窗口和标签页所花的时间比平时更长。这通常意味着系统繁忙，继续等待是安全的，但状态恢复数据库损坏也可能导致此情况。如果你不想等待，可以改为丢弃已存储的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 驗證你已儲存的視窗和標籤頁所花的時間比平常更久。這通常表示系統正忙碌，繼續等待是安全的，但狀態回復資料庫損毀也可能造成此情況。如果你不想等待，可以改為捨棄已儲存的視窗。"
          }
        }
      }
    },
