    "DebugLogging.LoggingEnabledMessage" : {
      "comment" : "Alert message instructing the user to reproduce the bug while debug logging is on",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte reproduzieren Sie den Fehler. Schalten Sie dann die Debug-Protokollierung erneut um, um das Protokoll zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
