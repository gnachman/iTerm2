    "Tip.0036.Body" : {
      "comment" : "Tip of the day body, id 0036",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 umí stahovat soubory jejich zakódováním do Base64. Kliknutím na „Další informace“ stáhnete shell skript, který to usnadní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan hente arkiver ved at base64-kode dem. Klik på “Læs mere” for at hente en shell-instruks, der gør det nemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann Dateien herunterladen, indem es sie Base64-codiert. Klicken Sie auf „Mehr erfahren“, um ein Shellskript herunterzuladen, das dies vereinfacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can download files by base-64 encoding them. Click “Learn More” to download a shell script that makes it easy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 puede descargar archivos codificándolos en base64. Haz clic en “Más información” para descargar un script de shell que lo facilita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 voi ladata tiedostoja base64-koodaamalla ne. Lataa komentotulkkiskripti, joka tekee siitä helppoa, klikkaamalla ”Lisätietoja”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut télécharger des fichiers en les encodant en base64. Cliquez sur « En savoir plus » pour télécharger un script shell qui facilite l’opération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può scaricare file codificandoli in base64. Fai clic su “Ulteriori informazioni” per scaricare uno script di shell che lo rende semplice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、ファイルをBase64エンコードすることでダウンロードできます。「詳しくはこちら」をクリックすると、これを簡単にするシェルスクリプトをダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 파일을 base-64로 인코딩하여 다운로드할 수 있습니다. 이를 쉽게 해 주는 셸 스크립트를 다운로드하려면 “더 알아보기”를 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan laste ned filer ved å base64-kode dem. Klikk på «Finn ut mer» for å laste ned et skallskript som gjør det enkelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan bestanden downloaden door ze met base64 te coderen. Klik op ‘Meer informatie’ om een shellscript te downloaden dat dit eenvoudig maakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 może pobierać pliki, kodując je w base64. Kliknij „Więcej informacji”, aby pobrać skrypt powłoki, który to ułatwia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode transferir arquivos codificando-os em base-64. Clique em “Saiba mais” para transferir um shell script que facilita isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может загружать файлы, кодируя их в base-64. Нажмите «Подробнее», чтобы загрузить сценарий оболочки, который упрощает этот процесс."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 dokáže sťahovať súbory ich kódovaním do base64. Kliknutím na „Viac informácií“ stiahnete skript shellu, ktorý to uľahčuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 lahko prenaša datoteke tako, da jih kodira v base64. Kliknite »Več o tem«, da prenesete skript lupine, ki to olajša."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan hämta filer genom att base64-koda dem. Klicka på ”Läs mer” för att hämta ett skalskript som gör det enkelt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 dosyaları base64 olarak kodlayarak indirebilir. Bunu kolaylaştıran bir kabuk betiğini indirmek için “Daha Fazla Bilgi”ye tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 có thể tải tệp về bằng cách mã hóa base64. Bấm “Tìm hiểu thêm” để tải một tập lệnh shell giúp việc này dễ dàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以通过 Base-64 编码来下载文件。点击“了解更多”，可以下载一个 shell 脚本，方便使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以透過 base-64 編碼來下載檔案。按一下「進一步了解」可下載一個讓此操作更輕鬆的 shell 腳本。"
          }
        }
      }
    },
