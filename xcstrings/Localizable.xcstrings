    "Tip.0078.Body" : {
      "comment" : "Tip of the day body, id 0078",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⌥ gedrückt, während Sie einen Tab ziehen, um das Fenster zu verschieben. Das ist besonders bei den Designs „Kompakt“ und „Minimal“ nützlich, die nur einen sehr kleinen Bereich zum Verschieben des Fensters bieten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥ while dragging a tab to move the window. This is useful in the Compact and Minimal themes, which have a very small area for dragging the window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ⌥ mientras arrastras una pestaña para mover la ventana. Es útil en los temas Compacto y Minimalista, que tienen un área muy pequeña para arrastrar la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⌥ tout en faisant glisser un onglet pour déplacer la fenêtre. C’est utile avec les thèmes Compact et Minimal, qui offrent une très petite zone pour déplacer la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⌥ mentre trascini un pannello per spostare la finestra. È utile nei temi Compatto e Minimale, che hanno un’area molto piccola per trascinare la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥を押しながらタブをドラッグすると、ウィンドウを移動できます。ウィンドウをドラッグできる領域がとても小さいコンパクトテーマやミニマルテーマで便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥를 누른 채 탭을 드래그하면 윈도우를 이동할 수 있습니다. 윈도우를 드래그할 수 있는 영역이 매우 작은 컴팩트 및 미니멀 테마에서 유용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥ pressionado ao arrastar uma aba para mover a janela. Isso é útil nos temas Compacto e Minimalista, que têm uma área muito pequena para arrastar a janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌥ при перетаскивании вкладки, чтобы переместить окно. Это удобно в темах «Компактная» и «Минимальная», где для перетаскивания окна отведена очень маленькая область."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereyi taşımak için bir sekmeyi sürüklerken ⌥ tuşunu basılı tutun. Pencereyi sürüklemek için çok küçük bir alanı olan Kompakt ve Minimal temalarda kullanışlıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动标签页时按住 ⌥ 可移动窗口。在紧凑和极简主题中非常有用，因为该主题的窗口拖动区域非常小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移標籤頁時按住 ⌥ 即可移動視窗。這在「精簡」和「極簡」主題中特別有用，因為這兩種主題可用來拖移視窗的區域非常小。"
          }
        }
      }
    },
