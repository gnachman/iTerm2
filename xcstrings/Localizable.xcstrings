    "Codecierge.GoalPrompt" : {
      "comment" : "Prompt asking the user what they are trying to do",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchten Sie tun? Ich schlage Befehle vor und erkläre ihre Ausgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What are you trying to do? I'll suggest commands and explain their output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué intentas hacer? Te sugeriré comandos y explicaré su salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que cherchez-vous à faire ? Je vous suggérerai des commandes et j’expliquerai leur sortie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che cosa stai cercando di fare? Ti suggerirò comandi e spiegherò il loro output."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何をしようとしていますか？コマンドを提案し、その出力を説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 하려고 하십니까? 명령을 제안하고 그 출력을 설명해 드리겠습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você está tentando fazer? Vou sugerir comandos e explicar sua saída."
          }
        },
        "ru" : {
