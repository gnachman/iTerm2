    "ShortcutInput.AccidentalConfirmHotkey" : {
      "comment" : "Confirmation when a chosen hotkey looks like a common keystroke; the placeholder is the shortcut",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opravdu chcete použít „%@“ jako horkou klávesu? Vypadá to jako běžně používaná klávesová zkratka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil bruge “%@” som genvejstast? Det ligner en almindeligt brugt tastekombination."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie „%@“ als Hotkey verwenden möchten? Dies sieht nach einem häufig verwendeten Tastendruck aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Are you sure you want to use “%@” as a hotkey? This looks like a commonly used keystroke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres usar “%@” como tecla rápida? Parece una combinación de teclas de uso común."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti käyttää yhdistelmää ”%@” pikanäppäimenä? Se vaikuttaa yleisesti käytetyltä näppäinyhdistelmältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment utiliser « %@ » comme raccourci global ? Cette combinaison semble couramment utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi davvero usare “%@” come abbreviazione globale? Sembra una combinazione di tasti di uso comune."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をホットキーとして使用してもよろしいですか? これはよく使われるキー操作のようです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말로 “%@”을(를) 단축키로 사용하겠습니까? 흔히 사용하는 키 입력으로 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil bruke «%@» som hurtigtast? Dette ligner en vanlig tastekombinasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je ‘%@’ als sneltoets wilt gebruiken? Dit lijkt op een veelgebruikte toetsaanslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz użyć „%@” jako klawisza skrótu? Wygląda to na powszechnie używany skrót klawiszowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja usar “%@” como atalho? Isto parece uma combinação de teclas de uso comum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите использовать «%@» в качестве горячей клавиши? Это похоже на часто используемое сочетание клавиш."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naozaj chcete použiť „%@“ ako aktivačnú skratku? Vyzerá to ako bežne používaná klávesová skratka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ste prepričani, da želite uporabiti »%@« kot hitro tipko? To je videti kot pogosto uporabljena kombinacija tipk."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill använda ”%@” som snabbtangent? Det ser ut som en vanligt förekommande tangentkombination."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kısayolunu kısayol tuşu olarak kullanmak istediğinizden emin misiniz? Bu, sık kullanılan bir tuş vuruşuna benziyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có chắc chắn muốn dùng “%@” làm phím nóng không? Đây có vẻ là tổ hợp phím thường dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要将“%@”设为热键吗？这看起来是一个常用的按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定要將「%@」用作全域快速鍵嗎？這看起來是常用的按鍵組合。"
          }
        }
      }
    },
