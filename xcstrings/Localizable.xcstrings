          "stringUnit" : {
            "state" : "translated",
            "value" : "Äänimerkki soi usein. Mykistetäänkö se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sonnerie retentit très souvent. La désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il campanello suona spesso. Vuoi silenziarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベルが頻繁に鳴っています。消音しますか?"
