      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another iTerm2 attached to this tmux session is setting up a workgroup. This one is waiting for it to finish."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes iTerm2, das mit dieser tmux-Sitzung verbunden ist, richtet gerade eine Arbeitsgruppe ein. Dieses wartet, bis es fertig ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
