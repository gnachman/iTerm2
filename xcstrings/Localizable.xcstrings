      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung (%1$@ Sek.) bei der Auswertung des Aufrufs „%2$@“. Die Zeitüberschreitung trat bei der Auswertung der folgenden Argumente für %3$@ auf: %4$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout (%1$@ sec) while evaluating invocation “%2$@”. The timeout occurred while evaluating the following arguments to %3$@: %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera agotado (%1$@ s) al evaluar la invocación “%2$@”. El tiempo se agotó al evaluar los siguientes argumentos de %3$@: %4$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé (%1$@ s) lors de l’évaluation de l’invocation « %2$@ ». Le délai a été dépassé lors de l’évaluation des arguments suivants de %3$@ : %4$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (%1$@ s) durante la valutazione dell’invocazione “%2$@”. Il timeout si è verificato durante la valutazione dei seguenti argomenti di %3$@: %4$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼び出し「%2$@」の評価中にタイムアウトしました(%1$@秒)。タイムアウトは %3$@ への次の引数を評価中に発生しました: %4$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호출 “%2$@”을(를) 평가하는 동안 시간이 초과되었습니다(%1$@초). %3$@에 대한 다음 인수를 평가하는 중 시간 초과가 발생했습니다: %4$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo esgotado (%1$@ s) ao avaliar a invocação “%2$@”. O tempo se esgotou ao avaliar os seguintes argumentos para %3$@: %4$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайм-аут (%1$@ с) при вычислении вызова «%2$@». Тайм-аут произошёл при вычислении следующих аргументов для %3$@: %4$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%2$@” çağrısı değerlendirilirken zaman aşımına uğradı (%1$@ sn). Zaman aşımı, %3$@ işlevinin şu bağımsız değişkenleri değerlendirilirken oluştu: %4$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在评估调用“%2$@”时发生超时（%1$@秒）。该超时发生在对%3$@的以下参数进行评估时：%4$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "求值呼叫「%2$@」時逾時（%1$@ 秒）。逾時發生在對 %3$@ 的以下引數求值時：%4$@"
          }
        }
      }
    },
    "ScriptFunctionCall.TimeoutWaitingReturn" : {
      "comment" : "Error when a function invocation times out waiting for a return value; placeholders are the timeout, invocation, and function name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung (%1$@ Sek.) bei der Auswertung des Aufrufs „%2$@“. Die Zeitüberschreitung trat beim Warten auf die Rückgabe von %3$@ auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout (%1$@ sec) while evaluating invocation “%2$@”. The timeout occurred while waiting for %3$@ to return."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo de espera agotado (%1$@ s) al evaluar la invocación “%2$@”. El tiempo se agotó mientras se esperaba que %3$@ devolviera un valor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé (%1$@ s) lors de l’évaluation de l’invocation « %2$@ ». Le délai a été dépassé en attendant le retour de %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (%1$@ s) durante la valutazione dell’invocazione “%2$@”. Il timeout si è verificato in attesa che %3$@ restituisse un valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼び出し「%2$@」の評価中にタイムアウトしました(%1$@秒)。タイムアウトは %3$@ の戻り値を待機中に発生しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호출 “%2$@”을(를) 평가하는 중 시간이 초과되었습니다(%1$@초). %3$@의 반환을 기다리는 동안 시간 초과가 발생했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo esgotado (%1$@ s) ao avaliar a invocação “%2$@”. O tempo se esgotou ao aguardar o retorno de %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайм-аут (%1$@ с) при вычислении вызова «%2$@». Тайм-аут произошёл при ожидании возврата значения от %3$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%2$@” çağrısı değerlendirilirken zaman aşımına uğradı (%1$@ sn). Zaman aşımı, %3$@ işlevinin dönmesi beklenirken oluştu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评估调用“%2$@”时超时了(%1$@秒)。该超时发生在等待%3$@返回的过程中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "求值呼叫「%2$@」時逾時（%1$@ 秒）。逾時發生在等待 %3$@ 傳回時。"
          }
        }
      }
    },
