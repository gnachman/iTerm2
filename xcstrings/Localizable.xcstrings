    "MigrationHelper.RemoveKeyMappingsHeading" : {
      "comment" : "Heading asking whether to remove deprecated key mappings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veraltete Tastenzuordnungen entfernen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove Deprecated Key Mappings?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar asignaciones de teclas obsoletas?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer les associations de touches obsolètes ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere le associazioni tasti obsolete?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
