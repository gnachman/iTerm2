    "Tip.0010.Body" : {
      "comment" : "Tip of the day body, id 0010",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pozadí můžete v pravém horním rohu relace zobrazit stavovou zprávu. Říká se jí „odznak“. Pokud nainstalujete integraci shellu, můžete do ní zahrnout informace jako uživatelské jméno, název hostitele, aktuální adresář a další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan vise en statusbesked øverst til højre i din session i baggrunden. Den kaldes en “etiket”. Hvis du installerer shell-integration, kan du medtage oplysninger som brugernavn, værtsnavn, aktuel mappe og mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können im Hintergrund oben rechts in Ihrer Sitzung eine Statusmeldung anzeigen lassen. Das nennt sich „Badge“. Wenn Sie die Shell-Integration installieren, können Sie Informationen wie Benutzername, Hostname, aktuelles Verzeichnis und mehr einbeziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can display a status message in the top right of your session in the background. It’s called a “Badge.” If you install Shell Integration you can include info like user name, hostname, current directory, and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes mostrar un mensaje de estado en la esquina superior derecha de tu sesión, en segundo plano. Se llama “insignia”. Si instalas la integración con el shell, puedes incluir información como el nombre de usuario, el nombre de host, el directorio actual y más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit näyttää tilaviestin istuntosi oikeassa yläkulmassa taustalla. Sitä kutsutaan ”kyltiksi”. Jos asennat komentotulkki-integraation, voit sisällyttää siihen tietoja, kuten käyttäjätunnuksen, palvelinnimen, nykyisen hakemiston ja muuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez afficher un message d’état en arrière-plan en haut à droite de votre session. On l’appelle « badge ». Si vous installez l’intégration du shell, vous pouvez y inclure des informations comme le nom d’utilisateur, le nom d’hôte, le répertoire actuel, etc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi mostrare un messaggio di stato nell’angolo in alto a destra della sessione, sullo sfondo. Si chiama “Badge”. Se installi l’integrazione shell puoi includere informazioni come nome utente, nome host, directory corrente e altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションの右上背景にステータスメッセージを表示できます。これは「バッジ」と呼ばれます。シェル統合をインストールすると、ユーザー名、ホスト名、現在のディレクトリなどの情報を含めることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 배경의 오른쪽 상단에 상태 메시지를 표시할 수 있습니다. 이를 “배지”라고 합니다. 셸 통합을 설치하면 사용자 이름, 호스트 이름, 현재 디렉토리 등의 정보를 포함할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan vise en statusmelding øverst til høyre i økten din, i bakgrunnen. Den kalles et «skilt». Hvis du installerer skallintegrering, kan du ta med info som brukernavn, vertsnavn, gjeldende mappe og mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt op de achtergrond een statusbericht rechtsboven in je sessie tonen. Dat heet een ‘badge’. Als je shell-integratie installeert, kun je informatie opnemen zoals gebruikersnaam, hostnaam, huidige map en meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz wyświetlać komunikat o stanie w prawym górnym rogu sesji, w tle. Nazywa się on „plakietką”. Jeśli zainstalujesz integrację z powłoką, możesz w nim umieścić informacje takie jak nazwa użytkownika, nazwa hosta, bieżący katalog i inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode exibir uma mensagem de status no canto superior direito da sua sessão, ao fundo. Ela é chamada de “selo”. Se você instalar a Shell Integration, poderá incluir informações como nome de usuário, nome de host, diretório atual e muito mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете отображать статусное сообщение в правом верхнем углу вашей сессии на заднем плане. Это называется «Значок» (Badge). Если установить Shell Integration, в него можно включить такую информацию, как имя пользователя, имя узла, текущий каталог и многое другое."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V pravom hornom rohu relácie môžete na pozadí zobraziť stavovú správu. Nazýva sa „odznak“. Ak nainštalujete integráciu shellu, môžete zahrnúť informácie ako užívateľské meno, názov hostiteľa, aktuálny adresár a ďalšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V ozadju seje lahko v zgornjem desnem kotu prikažete sporočilo o stanju. Imenuje se »značka«. Če namestite integracijo lupine, lahko vključite podatke, kot so uporabniško ime, ime gostitelja, trenutni imenik in drugo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan visa ett statusmeddelande uppe till höger i sessionen, i bakgrunden. Det kallas en ”bricka”. Om du installerar skalintegrering kan du ta med information som användarnamn, värdnamn, aktuell katalog med mera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuzun sağ üst köşesinde arka planda bir durum iletisi gösterebilirsiniz. Buna “Rozet” denir. Kabuk Entegrasyonu’nu yüklerseniz kullanıcı adı, ana makine adı, geçerli dizin ve daha fazlası gibi bilgileri ekleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể hiển thị một thông báo trạng thái ở góc trên bên phải của phiên, ở nền. Nó được gọi là “Huy hiệu.” Nếu cài đặt Tích hợp shell, bạn có thể đưa vào thông tin như tên người dùng, tên máy chủ, thư mục hiện tại, v.v."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在会话的右上角后台显示状态消息，称为“角标”。若安装Shell集成组件，可包含用户名、主机名、当前目录等信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在背景中於工作階段的右上角顯示一則狀態訊息，稱為「標記牌」。如果安裝了 Shell 整合，還可以包含使用者名稱、主機名稱、目前目錄等資訊。"
          }
        }
      }
    },
