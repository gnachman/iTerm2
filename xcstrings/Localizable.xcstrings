    "Tip.0043.Body" : {
      "comment" : "Tip of the day body, id 0043",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost rozdělených podoken změníte z klávesnice pomocí ^⌘ a klávesy se šipkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændr størrelsen på opdelte ruder med tastaturet ved hjælp af ^⌘ og en piletast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie die Größe geteilter Bereiche über die Tastatur mit ^⌘-Pfeiltaste an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Resize split panes with the keyboard using ^⌘-Arrow Key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el tamaño de los paneles divididos con el teclado usando ^⌘ y una tecla de flecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta jaettujen paneelien kokoa näppäimistöllä näppäimillä ^⌘-nuolinäppäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionnez les volets scindés au clavier avec ^⌘-touche fléchée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridimensiona i riquadri divisi con la tastiera usando ^⌘-Tasto freccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⌘と矢印キーを使うと、キーボードで分割ペインのサイズを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^⌘-화살표 키를 사용하여 키보드로 분할 패널의 크기를 조절할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre størrelsen på delte ruter med tastaturet ved å bruke ^⌘-piltast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig de grootte van gesplitste panelen met het toetsenbord via ^⌘-pijltoets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniaj rozmiar podzielonych paneli z klawiatury skrótem ^⌘ i klawiszem strzałki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensione painéis divididos pelo teclado usando ^⌘ e uma tecla de seta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменяйте размер разделённых панелей с клавиатуры с помощью ^⌘-стрелка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veľkosť rozdelených panelov zmeníte klávesnicou pomocou ^⌘ a klávesu so šípkou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost razdeljenih podoken spreminjajte s tipkovnico z ^⌘ in puščično tipko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändra storlek på delade paneler med tangentbordet med ^⌘-piltangent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölünmüş bölmeleri klavyeyle ^⌘-Ok Tuşu kullanarak yeniden boyutlandırın."
          }
        },
        "vi" : {
          "stringUnit" : {
