          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se poistaa koukun myös Claude Coden asetuksista palvelimella %@, jos se on siellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime aussi le hook des réglages de Claude Code sur %@, s’il s’y trouve."
