    "SavePanel.ExistsBodyDesktop" : {
      "comment" : "Body of the overwrite confirmation when the file is on the Desktop",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Schreibtisch ist bereits eine Datei oder ein Ordner mit demselben Namen vorhanden. Wenn Sie sie ersetzen, wird der aktuelle Inhalt überschrieben."
          }
