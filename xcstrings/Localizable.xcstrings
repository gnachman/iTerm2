    "LLMMetadata.ManualModelUnavailable" : {
      "comment" : "Error shown in an AI chat that uses a model the user configured manually (for example, one on a local server) after that model was removed or renamed in Settings, instead of sending the message to a different AI provider. The placeholder is the model's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell „%@“ ist nicht mehr unter Einstellungen > Allgemein > KI konfiguriert. Fügen Sie es mit demselben Namen wieder hinzu, oder beginnen Sie einen neuen Chat mit einem anderen Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The model “%@” is no longer configured in Settings > General > AI. Add it again with the same name, or start a new chat with a different model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo “%@” ya no está configurado en Ajustes > General > IA. Añádelo de nuevo con el mismo nombre o inicia un chat nuevo con otro modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle « %@ » n’est plus configuré dans Réglages > Général > IA. Ajoutez-le à nouveau avec le même nom, ou démarrez un nouveau chat avec un autre modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello “%@” non è più configurato in Impostazioni > Generali > IA. Aggiungilo di nuovo con lo stesso nome oppure avvia una nuova chat con un altro modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデル「%@」は「設定 > 一般 > AI」で構成されなくなりました。同じ名前で再度追加するか、別のモデルで新しいチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 “%@”이(가) 더 이상 설정 > 일반 > AI에 구성되어 있지 않습니다. 같은 이름으로 다시 추가하거나 다른 모델로 새로운 채팅을 시작하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo “%@” não está mais configurado em Ajustes > Geral > IA. Adicione-o novamente com o mesmo nome ou inicie um novo chat com outro modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель «%@» больше не настроена в разделе «Настройки > Основные > ИИ». Добавьте её снова с тем же именем или начните новый чат с другой моделью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” modeli artık Ayarlar > Genel > YZ bölümünde yapılandırılmış değil. Aynı adla yeniden ekleyin veya farklı bir modelle yeni bir sohbet başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型“%@”已不再在“设置 > 通用 > AI”中配置。请使用相同名称重新添加，或使用其他模型开始新的聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型「%@」已不在「設定 > 一般 > AI」中設定。請以相同名稱重新加入，或以其他模型開始新的聊天。"
          }
        }
      }
    },
    "LLMMetadata.ModelUnavailable" : {
      "comment" : "Error shown in an AI chat whose Llama-family model is no longer available, instead of sending the message to a different AI provider. The placeholder is the model's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell „%@“ ist nicht verfügbar. Wenn es ein Ollama-Modell ist, starten Sie Ollama. Beginnen Sie andernfalls einen neuen Chat mit einem anderen Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The model “%@” is not available. If it is an Ollama model, start Ollama. Otherwise, start a new chat with a different model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo “%@” no está disponible. Si es un modelo de Ollama, inicia Ollama. De lo contrario, inicia un chat nuevo con otro modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle « %@ » n’est pas disponible. S’il s’agit d’un modèle Ollama, démarrez Ollama. Sinon, démarrez un nouveau chat avec un autre modèle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello “%@” non è disponibile. Se è un modello Ollama, avvia Ollama. Altrimenti, avvia una nuova chat con un altro modello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデル「%@」は利用できません。Ollamaのモデルの場合は、Ollamaを起動してください。それ以外の場合は、別のモデルで新しいチャットを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 “%@”을(를) 사용할 수 없습니다. Ollama 모델이라면 Ollama를 시작하십시오. 그렇지 않으면 다른 모델로 새로운 채팅을 시작하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo “%@” não está disponível. Se for um modelo do Ollama, inicie o Ollama. Caso contrário, comece um novo chat com outro modelo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель «%@» недоступна. Если это модель Ollama, запустите Ollama. В противном случае начните новый чат с другой моделью."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” modeli kullanılamıyor. Bir Ollama modeliyse Ollama’yı başlatın. Aksi halde farklı bir modelle yeni bir sohbet başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型“%@”不可用。如果它是 Ollama 模型，请启动 Ollama；否则，请使用其他模型开始新的聊天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型「%@」無法使用。如果它是 Ollama 模型，請啟動 Ollama。否則，請以其他模型開始新的聊天。"
          }
        }
      }
    },
