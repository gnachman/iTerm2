    "Tip.0078.Body" : {
      "comment" : "Tip of the day body, id 0078",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie ⌥ gedrückt, während Sie einen Tab ziehen, um das Fenster zu verschieben. Das ist besonders bei den Designs „Kompakt“ und „Minimal“ nützlich, die nur einen sehr kleinen Bereich zum Verschieben des Fensters bieten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold ⌥ while dragging a tab to move the window. This is useful in the Compact and Minimal themes, which have a very small area for dragging the window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥を押しながらタブをドラッグすると、ウィンドウを移動できます。ウィンドウをドラッグできる領域がとても小さいコンパクトテーマやミニマルテーマで便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥를 누른 채 탭을 드래그하면 윈도우를 이동할 수 있습니다. 윈도우를 드래그할 수 있는 영역이 매우 작은 컴팩트 및 미니멀 테마에서 유용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⌥ pressionado ao arrastar uma aba para mover a janela. Isso é útil nos temas Compacto e Minimalista, que têm uma área muito pequena para arrastar a janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⌥ при перетаскивании вкладки, чтобы переместить окно. Это удобно в темах «Компактная» и «Минимальная», где для перетаскивания окна отведена очень маленькая область."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动标签页时按住 ⌥ 可移动窗口。在紧凑和极简主题中非常有用，因为该主题的窗口拖动区域非常小。"
          }
        }
      }
    },
