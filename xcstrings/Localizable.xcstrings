    "PTYSession.ClipboardAccessDenied" : {
      "comment" : "Announcement that clipboard access was denied and how to enable it",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminál se pokusil získat přístup ke schránce, ale byl zamítnut. Přístup ke schránce zapnete v části „Nastavení > Obecné > Výběr > Aplikace v terminálu mohou přistupovat ke schránce“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalen forsøgte at få adgang til udklipsholderen, men blev afvist. Slå adgang til udklipsholderen til i “Indstillinger > Generelt > Markering > Programmer i terminalen kan tilgå udklipsholderen”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Terminal hat versucht, auf die Zwischenablage zuzugreifen, dies wurde jedoch verweigert. Aktivieren Sie den Zugriff auf die Zwischenablage unter „Einstellungen > Allgemein > Auswahl > Anwendungen im Terminal dürfen auf die Zwischenablage zugreifen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The terminal attempted to access the clipboard but it was denied. Enable clipboard access in “Settings > General > Selection > Applications in terminal may access clipboard”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La terminal intentó acceder al portapapeles, pero se denegó. Activa el acceso al portapapeles en “Ajustes > General > Selección > Las aplicaciones en la terminal pueden acceder al portapapeles”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pääte yritti käyttää leikepöytää, mutta pääsy estettiin. Ota leikepöydän käyttö käyttöön kohdassa ”Asetukset > Yleiset > Valinta > Päätteessä olevat sovellukset voivat käyttää leikepöytää”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le terminal a tenté d’accéder au presse-papiers, mais l’accès a été refusé. Activez l’accès au presse-papiers dans « Réglages > Général > Sélection > Les applications du terminal peuvent accéder au presse-papiers »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il terminale ha tentato di accedere agli Appunti, ma l’accesso è stato negato. Abilita l’accesso agli Appunti in “Impostazioni > Generali > Selezione > Le applicazioni nel terminale possono accedere agli Appunti”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルがクリップボードへのアクセスを試みましたが、拒否されました。「設定 > 一般 > 選択 > ターミナル内のアプリケーションによるクリップボードへのアクセスを許可」でクリップボードへのアクセスを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널이 클립보드에 접근하려 했지만 거부되었습니다. “설정 > 일반 > 선택 > 터미널의 응용 프로그램이 클립보드에 접근 허용”에서 클립보드 접근을 허용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalen forsøkte å få tilgang til utklippstavlen, men fikk avslag. Aktiver tilgang til utklippstavlen i «Innstillinger > Generelt > Markering > Apper i terminalen kan få tilgang til utklippstavlen»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De terminal probeerde toegang te krijgen tot het klembord, maar dit is geweigerd. Schakel toegang tot het klembord in via ‘Instellingen > Algemeen > Selectie > Apps in de terminal mogen het klembord gebruiken’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal próbował uzyskać dostęp do schowka, ale odmówiono. Włącz dostęp do schowka w „Ustawienia > Ogólne > Zaznaczanie > Aplikacje w terminalu mogą uzyskiwać dostęp do schowka”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O terminal tentou acessar a área de transferência, mas o acesso foi negado. Ative o acesso à área de transferência em “Ajustes > Geral > Seleção > Aplicativos no terminal podem acessar a área de transferência”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терминал попытался получить доступ к буферу обмена, но получил отказ. Включите доступ к буферу обмена в «Настройки > Общие > Выделение > Приложения в терминале могут обращаться к буферу обмена»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminál sa pokúsil získať prístup do schránky, ale bol zamietnutý. Zapnite prístup do schránky v časti „Nastavenia > Všeobecné > Výber > Aplikácie v termináli môžu pristupovať k schránke“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal je poskušal dostopati do odložišča, vendar je bil dostop zavrnjen. Omogočite dostop do odložišča v »Nastavitve > Splošno > Izbor > Aplikacije v terminalu lahko dostopajo do odložišča«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalen försökte komma åt urklipp, men det nekades. Aktivera åtkomst till urklipp i ”Inställningar > Allmänt > Markering > Program i terminalen får komma åt urklipp”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal panoya erişmeye çalıştı ancak reddedildi. Pano erişimini “Ayarlar > Genel > Seçim > Terminaldeki uygulamalar panoya erişebilir” bölümünden etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal đã cố truy cập bảng nhớ tạm nhưng bị từ chối. Hãy bật quyền truy cập bảng nhớ tạm trong “Cài đặt > Chung > Vùng chọn > Ứng dụng trong terminal có thể truy cập bảng nhớ tạm”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端尝试访问剪贴板但被拒绝。请在“设置 > 通用 > 选择 > 终端中的应用可以访问剪贴板”中启用剪贴板访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端機嘗試存取剪貼簿但被拒絕。請在「設定 > 一般 > 選取範圍 > 終端機中的 App 可存取剪貼簿」中啟用剪貼簿存取。"
          }
        }
      }
    },
