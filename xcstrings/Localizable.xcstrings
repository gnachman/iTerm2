          }
        }
      }
    },
    "PTYTask.UnableToForkMessage" : {
      "comment" : "Message shown when the app cannot fork a child process.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze vytvořit podřízený proces (fork): možná již běží příliš mnoho procesů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke oprette underproces med fork: der kører muligvis allerede for mange processer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kindprozess konnte nicht erzeugt werden: Möglicherweise laufen bereits zu viele Prozesse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unable to fork child process: you may have too many processes already running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo hacer fork del proceso hijo: puede que ya haya demasiados procesos en ejecución."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aliprosessia ei voitu forkata: käynnissä voi olla jo liian monta prosessia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de créer le processus enfant par fork : trop de processus sont peut-être déjà en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile eseguire il fork del processo figlio: potrebbero essere già in esecuzione troppi processi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子プロセスをフォークできません。既に実行中のプロセスが多すぎる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자식 프로세스를 포크할 수 없습니다. 이미 너무 많은 프로세스가 실행 중일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke forgreine underprosessen: det kan hende at for mange prosesser allerede kjører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan geen kindproces forken: mogelijk zijn er al te veel processen actief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można wykonać fork procesu potomnego: może już działać zbyt wiele procesów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível fazer fork do processo filho: talvez você já tenha processos demais em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось создать дочерний процесс (fork): возможно, уже запущено слишком много процессов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa vytvoriť fork podriadeného procesu: možno už beží príliš veľa procesov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrejenega procesa ni bilo mogoče ustvariti (fork): morda že teče preveč procesov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte förgrena barnprocessen: det kan redan köras för många processer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt işlem çatallanamadı: halihazırda çok fazla işlem çalışıyor olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể fork tiến trình con: có thể đã có quá nhiều tiến trình đang chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法派生子进程：你可能已经在运行太多进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法 fork 子程序：你可能已有太多程序正在執行。"
          }
        }
      }
    },
