    "ChatAgent.AutoProvideBody" : {
      "comment" : "Body text of the dialog asking whether to automatically share terminal contents with AI chats",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann den sichtbaren Bildschirminhalt und Terminalstatus dieser Sitzung bei jeder Nachricht mitsenden, die Sie in KI-Chats senden, in denen Sie dies erlaubt haben, damit der Assistent sieht, was Sie sehen. Sie können dies jederzeit in den Berechtigungseinstellungen eines Chats deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can include this session’s visible screen and terminal state with every message you send in AI chats where you’ve allowed it, so the assistant sees what you see. You can turn this off any time from a chat’s permission settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 では、許可した AI チャットで送信するすべてのメッセージに、このセッションの表示中の画面とターミナルの状態を含めることができます。これにより、アシスタントはあなたが見ているものを把握できます。この設定はいつでもチャットの権限設定からオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 허용된 AI 채팅에서 보내는 모든 메시지에 이 세션의 보이는 화면과 터미널 상태를 포함하여, 어시스턴트가 사용자가 보는 것을 함께 볼 수 있게 할 수 있습니다. 언제든지 채팅의 권한 설정에서 이 기능을 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode incluir a tela visível e o estado do terminal desta sessão em cada mensagem que você envia nos chats de IA onde você permitiu, para que o assistente veja o que você vê. Você pode desativar isso a qualquer momento nos ajustes de permissão de um chat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может включать видимый экран и состояние терминала этой сессии в каждое сообщение, которое вы отправляете в чатах с ИИ, где вы это разрешили, чтобы ассистент видел то же, что и вы. Вы можете отключить это в любой момент в настройках разрешений чата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以在你允许的 AI 聊天中，将每条消息附带该会话的可见屏幕和终端状态，以便助手看到你所看到的内容。你可以随时在聊天的权限设置中关闭此功能。"
          }
        }
      }
    },
    "ChatAgent.AutoProvideHeading" : {
      "comment" : "Heading of the dialog asking whether to automatically share terminal contents with AI chats",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
