    "Cockpit.NotifyWatchingTooltip" : {
      "comment" : "Tooltip for the notify button when it is armed and watching for a status change",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje se změna stavu vybrané položky. Při další změně se zobrazí upozornění a poté se tato volba vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder øje med en statusændring for det markerede emne. En advarsel vises ved næste ændring, og så slås dette fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwacht eine Statusänderung des ausgewählten Elements. Bei der nächsten Änderung erscheint eine Meldung, danach wird dies wieder ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watching for a status change on the selected item. An alert will appear on the next change, then turn this off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigilando un cambio de estado en el ítem seleccionado. Aparecerá una alerta en el siguiente cambio y después esto se desactivará."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seurataan valitun kohteen tilan muutosta. Varoitus näytetään seuraavan muutoksen yhteydessä, minkä jälkeen tämä menee pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillance d’un changement d’état de l’élément sélectionné. Une alerte apparaîtra au prochain changement, puis cette option se désactivera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoraggio di un cambio di stato sull’elemento selezionato. Alla prossima modifica apparirà un avviso, poi questa opzione si disattiverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した項目のステータス変化を監視しています。次の変化でアラートが表示され、その後この機能はオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 항목의 상태 변화를 감시하는 중입니다. 다음 변경 시 경고가 표시된 후 이 기능이 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvåker for statusendring på det markerte objektet. Et varsel vises ved neste endring, og deretter slås dette av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht op een statuswijziging van het geselecteerde onderdeel. Bij de volgende wijziging verschijnt een waarschuwing en wordt dit uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwanie na zmianę stanu wybranego elementu. Alert pojawi się przy następnej zmianie, po czym ta opcja się wyłączy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitorando uma mudança de status no item selecionado. Um alerta aparecerá na próxima mudança e, em seguida, isso será desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживание изменения статуса выбранного элемента. При следующем изменении появится оповещение, после чего это будет отключено."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje sa zmena stavu vybranej položky. Pri najbližšej zmene sa zobrazí upozornenie a potom sa toto vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljanje spremembe stanja izbranega elementa. Ob naslednji spremembi se prikaže opozorilo, nato se to izklopi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevakar statusändring för det markerade objektet. En varning visas vid nästa ändring, därefter stängs detta av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili öğenin durum değişikliği izleniyor. Bir sonraki değişiklikte bir uyarı görünür, ardından bu kapanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang theo dõi thay đổi trạng thái của mục đã chọn. Một cảnh báo sẽ xuất hiện ở lần thay đổi tiếp theo, sau đó tính năng này sẽ tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在监视所选项目的状态更改。下一次更改时会出现提醒，然后此选项会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在監看所選項目的狀態變更。下次變更時會出現警示，然後此選項會關閉。"
          }
        }
      }
    },
