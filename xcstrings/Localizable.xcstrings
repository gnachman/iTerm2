    "Tip.000.Body" : {
      "comment" : "Tip of the day body, id 000",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto okno zobrazuje tip dne pro iTerm2. Objeví se každých 24 hodin a seznámí vás s novými funkcemi a skrytými tajemstvími. Kliknutím na „Další volby“ zobrazíte další tipy nebo je úplně vypnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vindue viser iTerm2-tippet for dagen. Det vises hver 24. time for at fortælle dig om nye funktioner og skjulte hemmeligheder. Klik på “Flere valgmuligheder” for at se flere tips eller for helt at holde op med at få dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Fenster zeigt den iTerm2-Tipp des Tages. Es erscheint alle 24 Stunden, um Sie über neue Funktionen und versteckte Geheimnisse zu informieren. Klicken Sie auf „Weitere Optionen“, um weitere Tipps anzuzeigen oder sie ganz zu deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This window shows the iTerm2 tip of the day. It’ll appear every 24 hours to let you know about new features and hidden secrets. Hit “More Options” to view more tips or to stop getting them altogether."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ventana muestra el consejo del día de iTerm2. Aparecerá cada 24 horas para informarte de nuevas funciones y secretos ocultos. Haz clic en “Más opciones” para ver más consejos o para dejar de recibirlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä ikkuna näyttää iTerm2:n päivän vinkin. Se tulee näkyviin 24 tunnin välein ja kertoo uusista ominaisuuksista ja piilotetuista salaisuuksista. Näe lisää vinkkejä tai lopeta niiden saaminen kokonaan painamalla ”Lisää valintoja”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fenêtre affiche l’astuce du jour d’iTerm2. Elle apparaît toutes les 24 heures pour vous présenter les nouvelles fonctionnalités et les secrets bien cachés. Cliquez sur « Plus d’options » pour voir d’autres astuces ou ne plus en recevoir du tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa finestra mostra il suggerimento del giorno di iTerm2. Compare ogni 24 ore per farti scoprire nuove funzioni e segreti nascosti. Fai clic su “Altre opzioni” per vedere altri suggerimenti o per non riceverli più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウには iTerm2 の今日のヒントが表示されます。新機能や隠された秘密を知らせるために、24 時間ごとに表示されます。「その他のオプション」をクリックすると、他のヒントを見たり、表示を完全に停止したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 윈도우에는 iTerm2 오늘의 팁이 표시됩니다. 24시간마다 나타나 새로운 기능과 숨겨진 비밀을 알려 줍니다. 더 많은 팁을 보거나 팁을 아예 받지 않으려면 “옵션 더 보기”를 누르십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vinduet viser iTerm2-tipset for dagen. Det vises hver 24. time for å fortelle deg om nye funksjoner og skjulte hemmeligheter. Klikk på «Flere valg» for å se flere tips eller for å slutte å få dem helt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dit venster zie je de iTerm2-tip van de dag. Elke 24 uur verschijnt er een tip over nieuwe functies en verborgen geheimen. Kies ‘Meer opties’ om meer tips te bekijken of om ze helemaal uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To okno pokazuje wskazówkę dnia iTerm2. Pojawia się co 24 godziny, aby informować o nowych funkcjach i ukrytych możliwościach. Kliknij „Więcej opcji”, aby zobaczyć więcej wskazówek lub całkowicie przestać je otrzymywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta janela mostra a dica do dia do iTerm2. Ela aparece a cada 24 horas para informar sobre novos recursos e segredos ocultos. Clique em “Mais opções” para ver mais dicas ou para parar de recebê-las de vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это окно показывает совет дня iTerm2. Оно появляется каждые 24 часа, чтобы рассказать о новых функциях и скрытых возможностях. Нажмите «Дополнительные параметры», чтобы просмотреть другие советы или полностью отключить их показ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto okno zobrazuje tip dňa pre iTerm2. Zobrazí sa každých 24 hodín a oboznámi vás s novými funkciami a skrytými tajomstvami. Kliknutím na „Ďalšie možnosti“ zobrazíte ďalšie tipy alebo ich úplne vypnete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To okno prikazuje iTerm2 nasvet dneva. Pojavi se vsakih 24 ur in vas seznani z novimi funkcijami in skritimi skrivnostmi. Kliknite »Več možnosti«, da si ogledate več nasvetov ali jih povsem izklopite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här fönstret visar iTerm2:s tips. Det visas var 24:e timme för att berätta om nya funktioner och dolda hemligheter. Klicka på ”Fler alternativ” för att se fler tips eller för att sluta få dem helt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu pencere iTerm2’nin günün ipucunu gösterir. Yeni özelliklerden ve gizli sırlardan haberdar olmanız için her 24 saatte bir görünür. Daha fazla ipucu görmek veya bunları almayı tamamen bırakmak için “Diğer Seçenekler”e tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ này hiển thị mẹo trong ngày của iTerm2. Cửa sổ sẽ xuất hiện mỗi 24 giờ để giới thiệu các tính năng mới và những điều thú vị ẩn giấu. Bấm “Thêm tùy chọn” để xem thêm mẹo hoặc để ngừng nhận mẹo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗口显示 iTerm2 每日提示。每24小时出现一次，用于告知您新功能和隐藏功能。点击“更多选项”可查看更多提示或完全停止接收。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此視窗會顯示 iTerm2 每日小技巧。它每 24 小時出現一次，讓你得知新功能和隱藏的訣竅。按一下「更多選項」可查看更多小技巧，或完全停止接收。"
          }
        }
      }
    },
