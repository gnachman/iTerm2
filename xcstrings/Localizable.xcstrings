    "AdvancedSetting.restoreWindowContents" : {
      "comment" : "Advanced setting: restoreWindowContents",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovit obsah oken při spuštění.\nVyžaduje, aby bylo vypnuto „Nastavení systému > Plocha a Dock > Při ukončování aplikace zavřít okna“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendan vinduesindhold ved start.\nDet kræver, at “Systemindstillinger > Skrivebord & Dock > Luk vinduer, når en app afsluttes” er slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fensterinhalte beim Start wiederherstellen.\nDies erfordert, dass „Systemeinstellungen > Schreibtisch & Dock > Fenster beim Beenden einer App schließen“ deaktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Restore window contents at startup.\nThis requires “System Settings > Desktop & Dock > Close windows when quitting an app” to be off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura el contenido de las ventanas al iniciar.\nRequiere que “Ajustes del Sistema > Escritorio y Dock > Cerrar ventanas al salir de una app” esté desactivado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palauta ikkunoiden sisältö käynnistettäessä.\nTämä edellyttää, että ”Järjestelmäasetukset > Työpöytä ja Dock > Sulje ikkunat, kun sovellus lopetetaan” on pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurer le contenu des fenêtres au démarrage.\nCela nécessite que « Réglages Système > Bureau et Dock > Fermer les fenêtres à la fermeture d’une app » soit désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina il contenuto delle finestre all’avvio.\nRichiede che “Impostazioni di Sistema > Scrivania e Dock > Chiudi le finestre quando esci da un’app” sia disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にウィンドウの内容を復元する。\nこれには「システム設定 > デスクトップとDock > アプリケーション終了時にウィンドウを閉じる」がオフになっている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시동 시 윈도우 내용 복원\n“시스템 설정 > 데스크탑 및 Dock > 앱 종료 시 윈도우 닫기”가 꺼져 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenopprett vinduinnhold ved oppstart.\nDette krever at «Systeminnstillinger > Skrivebord og Dock > Lukk vinduer når en app avsluttes» er av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstel de vensterinhoud bij het opstarten.\nHiervoor moet ‘Systeeminstellingen > Bureaublad en Dock > Sluit vensters als een app wordt gestopt’ zijn uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracaj zawartość okien przy uruchamianiu.\nWymaga wyłączenia opcji „Ustawienia systemowe > Biurko i Dock > Zamykaj okna po zakończeniu aplikacji”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurar o conteúdo das janelas na inicialização.\nIsto requer que “Ajustes do Sistema > Mesa e Dock > Fechar janelas ao encerrar um app” esteja desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливать содержимое окон при запуске.\nДля этого параметр «Системные настройки > Рабочий стол и Dock > Закрывать окна при выходе из приложения» должен быть выключен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnoviť obsah okien pri spustení.\nVyžaduje, aby bolo vypnuté „Systémové nastavenia > Plocha a Dock > Pri ukončovaní aplikácií zatvoriť okná“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovi vsebino oken ob zagonu.\nZa to mora biti »Nastavitve sistema > Namizje in Dock > Zapri okna ob zaprtju aplikacije« izklopljeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställ fönsterinnehållet vid start.\nDet kräver att ”Systeminställningar > Skrivbord och Dock > Stäng fönster när en app avslutas” är av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlangıçta pencere içeriklerini geri yükle.\nBunun için “Sistem Ayarları > Masaüstü ve Dock > Bir uygulamadan çıkarken pencereleri kapat” seçeneğinin kapalı olması gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục nội dung cửa sổ khi khởi động.\nYêu cầu “Cài đặt hệ thống > Màn hình nền & Dock > Đóng cửa sổ khi thoát ứng dụng” phải tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动时是否恢复窗口内容。\n这要求“系统设置 > 桌面与 Dock > 关闭应用时窗口”选项被禁用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動時回復視窗內容。\n這需要關閉「系統設定 > 桌面與 Dock > 結束 App 時關閉視窗」。"
          }
        }
      }
    },
    "AdvancedSetting.restoreWindowsWithinScreens" : {
      "comment" : "Advanced setting: restoreWindowsWithinScreens",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při obnově uspořádání oken zajistit, aby okna ležela celá v mezích aktuálních displejů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at vinduer ligger helt inden for de nuværende skærmes grænser, når en vinduesopstilling gendannes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen einer Fensteranordnung sicherstellen, dass sich Fenster vollständig innerhalb der Grenzen der aktuellen Bildschirme befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When restoring a window arrangement, ensure windows are entirely within the bounds of the current displays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al restaurar una disposición de ventanas, asegura que las ventanas queden totalmente dentro de los límites de las pantallas actuales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ikkunajärjestely palautetaan, varmista, että ikkunat ovat kokonaan nykyisten näyttöjen rajojen sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la restauration d’une disposition de fenêtres, s’assurer que les fenêtres se trouvent entièrement dans les limites des écrans actuels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si ripristina una disposizione di finestre, assicura che le finestre rientrino interamente nei limiti degli schermi attuali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウ配置を復元する際、ウィンドウが現在のディスプレイの範囲内に完全に収まるようにする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우 배치를 복원할 때 윈도우가 현재 디스플레이의 경계 안에 완전히 들어가도록 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et vindusoppsett gjenopprettes, sørg for at vinduene ligger helt innenfor de gjeldende skjermene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg er bij het terugzetten van een vensterindeling voor dat vensters zich volledig binnen de grenzen van de huidige schermen bevinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy przywracaniu układu okien zapewnij, że okna mieszczą się w całości w granicach bieżących wyświetlaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao restaurar um arranjo de janelas, garantir que as janelas fiquem inteiramente dentro dos limites das telas atuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При восстановлении расстановки окон следить, чтобы окна полностью помещались в границы текущих дисплеев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri obnove usporiadania okien zaistiť, aby boli okná celé v hraniciach aktuálnych displejov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri obnovi razporeditve oken zagotovi, da so okna v celoti znotraj meja trenutnih zaslonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se till att fönster ligger helt inom de aktuella skärmarnas gränser när ett fönsterarrangemang återställs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere düzeni geri yüklenirken pencerelerin tamamen mevcut ekranların sınırları içinde kalmasını sağla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi khôi phục bố cục cửa sổ, đảm bảo các cửa sổ nằm hoàn toàn trong giới hạn của các màn hình hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在恢复窗口排列时，确保窗口完全位于当前显示范围内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復視窗排列時，確保視窗完全位於目前顯示器的範圍內。"
          }
        }
      }
    },
    "AdvancedSetting.restrictSemanticHistoryPrefixAndSuffixToLogicalWindow" : {
      "comment" : "Advanced setting: restrictSemanticHistoryPrefixAndSuffixToLogicalWindow",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respektovat měkké hranice při výpočtu textu předpony a přípony předávaného příkazům sémantické historie?\nKvůli dlouho existující chybě se to dříve nerespektovalo. Měkké hranice se vždy respektovaly při určování, na jaký text bylo kliknuto, ale předpona a přípona nikoli. Pokud máte příkaz sémantické historie, který na chybě závisí, můžete to vypnout a získat chování před verzí 3.1.2."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respektér bløde grænser ved beregning af præfiks- og suffikstekst, der sendes til kommandoer for semantisk historik?\nPå grund af en gammel fejl blev det tidligere ikke respekteret. Bløde grænser blev altid respekteret ved afgørelsen af, hvilken tekst der blev klikket på, men ikke for præfikset og suffikset. Hvis du har en kommando for semantisk historik, der afhænger af fejlen, kan du slå dette fra for at få adfærden fra før 3.1.2."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiche Grenzen beim Berechnen des an Semantic-History-Befehle übergebenen Präfix- und Suffix-Texts berücksichtigen?\nAufgrund eines seit Langem bestehenden Fehlers wurde dies bisher nicht berücksichtigt. Weiche Grenzen wurden immer berücksichtigt, um zu bestimmen, auf welchen Text geklickt wurde, jedoch nicht für Präfix und Suffix. Wenn Sie einen Semantic-History-Befehl haben, der von diesem Fehler abhängt, können Sie dies deaktivieren, um das Verhalten vor Version 3.1.2 zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Respect soft boundaries for computing the prefix and suffix text passed to semantic history commands?\nDue to a long-standing bug this did not used to be respected. Soft boundaries were always respected for deciding what text was clicked on, but the prefix and suffix did not. If you have a semantic history command that depends on the bug, you can switch this off to get the pre-3.1.2 behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Respetar los límites flexibles al calcular el texto de prefijo y sufijo que se pasa a los comandos del historial semántico?\nPor un error antiguo, esto no se respetaba. Los límites flexibles siempre se respetaban para decidir en qué texto se hacía clic, pero no para el prefijo y el sufijo. Si tienes un comando del historial semántico que depende del error, puedes desactivarlo para obtener el comportamiento anterior a la versión 3.1.2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noudatetaanko pehmeitä rajoja laskettaessa semanttisen historian komennoille välitettävää etu- ja takaliitetekstiä?\nPitkäaikaisen virheen vuoksi tätä ei ennen noudatettu. Pehmeitä rajoja noudatettiin aina päätettäessä, mitä tekstiä klikattiin, mutta etu- ja takaliitettä ei. Jos sinulla on semanttisen historian komento, joka riippuu virheestä, voit laittaa tämän pois päältä saadaksesi version 3.1.2:ta edeltävän toiminnan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respecter les limites souples pour calculer le texte de préfixe et de suffixe transmis aux commandes de l’historique sémantique ?\nÀ cause d’un ancien bogue, elles n’étaient pas respectées. Les limites souples l’étaient toujours pour décider du texte cliqué, mais pas pour le préfixe et le suffixe. Si une commande de l’historique sémantique dépend du bogue, vous pouvez désactiver ce réglage pour retrouver le comportement antérieur à la version 3.1.2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispettare i limiti morbidi nel calcolo del testo di prefisso e suffisso passato ai comandi della Cronologia semantica?\nA causa di un bug di vecchia data, prima non venivano rispettati. I limiti morbidi venivano sempre rispettati per decidere su quale testo si era fatto clic, ma non per prefisso e suffisso. Se hai un comando della Cronologia semantica che dipende dal bug, puoi disattivare questa opzione per ottenere il comportamento precedente alla versione 3.1.2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semantic Historyコマンドに渡す接頭辞・接尾辞テキストの計算でソフト境界を尊重するか？\n長年のバグにより、これまでは尊重されていませんでした。どのテキストがクリックされたかを判定する際はソフト境界が常に尊重されていましたが、接頭辞・接尾辞には反映されていませんでした。このバグに依存するSemantic Historyコマンドがある場合、これをオフにすることでバージョン3.1.2以前の動作に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시맨틱 히스토리 명령에 전달되는 접두사 및 접미사 텍스트를 계산할 때 소프트 경계를 준수하겠습니까?\n오래된 버그 때문에 이전에는 준수되지 않았습니다. 클릭한 텍스트를 판단할 때는 항상 소프트 경계를 준수했지만 접두사와 접미사는 그렇지 않았습니다. 이 버그에 의존하는 시맨틱 히스토리 명령이 있다면 이 옵션을 꺼서 3.1.2 이전 동작을 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respekter myke grenser ved beregning av prefiks- og suffikstekst som sendes til kommandoer for semantisk historikk?\nPå grunn av en gammel feil ble dette tidligere ikke respektert. Myke grenser ble alltid respektert for å avgjøre hvilken tekst som ble klikket på, men ikke for prefiks og suffiks. Hvis du har en kommando for semantisk historikk som avhenger av feilen, kan du slå dette av for å få oppførselen fra før 3.1.2."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachte grenzen respecteren bij het berekenen van de voor- en achtergedeelten van tekst die aan commando’s voor semantische geschiedenis worden doorgegeven?\nDoor een oude bug werd dit vroeger niet gerespecteerd. Zachte grenzen werden altijd gerespecteerd om te bepalen op welke tekst werd geklikt, maar het voor- en achtergedeelte niet. Als je een commando voor semantische geschiedenis hebt dat van de bug afhankelijk is, kun je dit uitschakelen om het gedrag van vóór 3.1.2 te krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy respektować miękkie granice przy obliczaniu tekstu prefiksu i sufiksu przekazywanego do poleceń historii semantycznej?\nZe względu na dawny błąd nie było to respektowane. Miękkie granice były zawsze respektowane przy ustalaniu, w jaki tekst kliknięto, ale prefiks i sufiks nie. Jeśli masz polecenie historii semantycznej zależne od tego błędu, możesz to wyłączyć, aby uzyskać zachowanie sprzed wersji 3.1.2."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respeitar limites flexíveis ao calcular o texto de prefixo e sufixo passado aos comandos do Semantic History?\nDevido a um bug antigo, isto não costumava ser respeitado. Os limites flexíveis eram sempre respeitados para decidir em qual texto foi clicado, mas o prefixo e o sufixo não. Se você tem um comando do Semantic History que depende do bug, pode desativar isto para obter o comportamento anterior à 3.1.2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учитывать мягкие границы при вычислении текста-префикса и текста-суффикса, передаваемых командам «Семантической истории»?\nИз-за давней ошибки это раньше не учитывалось. Мягкие границы всегда учитывались при определении того, по какому тексту произошёл щелчок, но не для префикса и суффикса. Если ваша команда «Семантической истории» зависит от этой ошибки, можно выключить этот параметр, чтобы получить поведение, как до версии 3.1.2."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rešpektovať mäkké hranice pri výpočte textu pred a za, ktorý sa odovzdáva príkazom sémantickej histórie?\nKvôli dlhodobej chybe sa to predtým nerešpektovalo. Mäkké hranice sa vždy rešpektovali pri určovaní, na aký text sa kliklo, ale text pred a za nie. Ak máte príkaz sémantickej histórie, ktorý na tejto chybe závisí, môžete to vypnúť a získať správanie spred verzie 3.1.2."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se mehke meje upoštevajo pri izračunu predpone in pripone besedila, posredovanih ukazom semantične zgodovine?\nZaradi dolgoletne napake to prej ni bilo upoštevano. Mehke meje so bile vedno upoštevane pri odločanju, na katero besedilo je bilo kliknjeno, predpona in pripona pa ne. Če imate ukaz semantične zgodovine, ki je odvisen od napake, lahko to izklopite za vedenje pred 3.1.2."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respektera mjuka gränser när prefix- och suffixtext som skickas till kommandon för semantisk historik beräknas?\nPå grund av en gammalt fel respekterades det inte tidigare. Mjuka gränser respekterades alltid för att avgöra vilken text som klickades på, men inte för prefix och suffix. Om du har ett kommando för semantisk historik som är beroende av felet kan du stänga av det här för att få beteendet från före 3.1.2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anlamsal geçmiş komutlarına geçirilen önek ve sonek metni hesaplanırken yumuşak sınırlar gözetilsin mi?\nUzun süredir var olan bir hata nedeniyle bu eskiden gözetilmiyordu. Yumuşak sınırlar, tıklanan metnin belirlenmesinde her zaman gözetiliyordu ancak önek ve sonek için gözetilmiyordu. Hataya bağlı bir anlamsal geçmiş komutunuz varsa 3.1.2 öncesi davranışı elde etmek için bunu kapatabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôn trọng ranh giới mềm khi tính văn bản tiền tố và hậu tố truyền cho các lệnh lịch sử ngữ nghĩa?\nDo một lỗi tồn tại lâu, trước đây điều này không được tôn trọng. Ranh giới mềm luôn được tôn trọng khi quyết định văn bản nào được bấm vào, nhưng tiền tố và hậu tố thì không. Nếu bạn có lệnh lịch sử ngữ nghĩa phụ thuộc vào lỗi đó, bạn có thể tắt tùy chọn này để có hành vi như trước 3.1.2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在计算传递给语义历史命令的前缀和后缀文本时，是否尊重软边界？\n由于长期存在的bug，此功能以前未被尊重。软边界始终被尊重用于判断点击了什么文本，但前缀和后缀则没有。如果某个语义历史命令依赖于此bug，可以关闭此功能以恢复3.1.2之前的行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算傳遞給語意歷史記錄指令的前綴和後綴文字時，是否遵循軟邊界？\n由於一個長期存在的錯誤，過去並未遵循。判斷按一下了哪段文字時一直都會遵循軟邊界，但前綴和後綴則沒有。如果你有依賴該錯誤的語意歷史記錄指令，可以關閉此設定以取得 3.1.2 之前的行為。"
          }
        }
      }
    },
