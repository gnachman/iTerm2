    "ProfilePreferences.InvalidJSONMissingNameOrGuid" : {
      "comment" : "Error message for malformed profile JSON",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neplatný JSON: v nadřazeném slovníku chybí klíč Name nebo Guid."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugyldig JSON: nøglen Name eller Guid mangler i ordbogen på øverste niveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungültiges JSON: Der Schlüssel „Name“ oder „Guid“ fehlt im obersten Dictionary."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Invalid JSON: missing Name or Guid key in top-level dictionary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON no válido: falta la clave Name o Guid en el diccionario de nivel superior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virheellinen JSON: ylätason sanakirjasta puuttuu avain Name tai Guid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON non valide : clé Name ou Guid manquante dans le dictionnaire de premier niveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON non valido: chiave Name o Guid mancante nel dizionario di primo livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効なJSON: トップレベルの辞書にNameまたはGuidキーがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유효하지 않은 JSON: 최상위 딕셔너리에 Name 또는 Guid 키가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugyldig JSON: nøkkelen Name eller Guid mangler i ordboken på øverste nivå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeldige JSON: sleutel Name of Guid ontbreekt in het hoofdwoordenboek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprawidłowy JSON: brak klucza Name lub Guid w słowniku najwyższego poziomu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON inválido: falta a chave Name ou Guid no dicionário de nível superior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недопустимый JSON: отсутствует ключ Name или Guid в словаре верхнего уровня."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neplatný JSON: v slovníku najvyššej úrovne chýba kľúč Name alebo Guid."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neveljaven JSON: v slovarju najvišje ravni manjka ključ Name ali Guid."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogiltig JSON: nyckeln Name eller Guid saknas i ordlistan på översta nivån."
