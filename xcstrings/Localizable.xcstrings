        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo em “%@” não pôde ser posto em quarentena nem apagado! Ele é perigoso e deve ser removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» не удалось поместить в карантин или удалить! Он опасен, и его следует удалить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” konumundaki dosya karantinaya alınamadı veya silinemedi! Tehlikelidir ve kaldırılmalıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
