    "AdvancedSetting.remapModifiersWithoutEventTap" : {
      "comment" : "Advanced setting: remapModifiersWithoutEventTap",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbelegen von Modifizierertasten für Systemtastenkombinationen deaktivieren.\nDadurch entfällt die Abfrage der Bedienungshilfen-Berechtigung. Das Umbelegen von Systemtastenkombinationen wie Cmd-Tab funktioniert dadurch nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable remapping modifiers for system shortcuts.\nThis prevents asking for accessibility permission. It breaks remapping system shortcuts like cmd-tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva la reasignación de modificadores para atajos del sistema.\nEvita pedir permiso de accesibilidad. Impide reasignar atajos del sistema como cmd-tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver le remappage des modificateurs pour les raccourcis système.\nCela évite de demander l’autorisation d’accessibilité. Cela empêche le remappage de raccourcis système comme cmd-tab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabilita la rimappatura dei tasti modificatori per le abbreviazioni di sistema.\nEvita di richiedere l’autorizzazione di accessibilità. Impedisce di rimappare abbreviazioni di sistema come cmd-tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムショートカットの修飾キー再マッピングを無効にする。\nこれによりアクセシビリティ権限の要求を防げます。ただし、cmd-tabのようなシステムショートカットの再マッピングが機能しなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 단축키에 대한 보조 키 재지정 끄기\n손쉬운 사용 권한을 요청하지 않게 됩니다. 대신 cmd-tab 같은 시스템 단축키의 재지정이 작동하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o remapeamento de modificadores para atalhos do sistema.\nIsto evita solicitar permissão de acessibilidade. Isto quebra o remapeamento de atalhos do sistema como cmd-tab."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить переназначение модификаторов для системных сочетаний клавиш.\nЭто предотвращает запрос разрешения специальных возможностей. При этом перестаёт работать переназначение системных сочетаний клавиш, например cmd-tab."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem kısayolları için değiştirici tuş yeniden atamayı devre dışı bırak.\nBu, erişilebilirlik izni istenmesini önler. cmd-tab gibi sistem kısayollarının yeniden atanmasını bozar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用系统快捷键的映射转换。\n这可以防止请求无障碍权限，同时会破坏如cmd-tab这样的快捷键映射功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用為系統快速鍵重新對應變更鍵。\n這可避免要求輔助使用權限，但會使 cmd-tab 等系統快速鍵的重新對應失效。"
          }
        }
      }
    },
    "AdvancedSetting.rememberTmuxWindowSizes" : {
      "comment" : "Advanced setting: rememberTmuxWindowSizes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstergrößen bei der tmux-Integration merken?\nErfordert tmux 2.9 oder höher. Die erweiterte Einstellung „Variable Fenstergröße“ muss aktiviert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remember window sizes in tmux integration?\nRequires tmux 2.9 or later. The “variable window size” advanced setting must be enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Recordar los tamaños de ventana en la integración con tmux?\nRequiere tmux 2.9 o posterior. Debe estar activado el ajuste avanzado “tamaño de ventana variable”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoriser la taille des fenêtres dans l’intégration tmux ?\nNécessite tmux 2.9 ou version ultérieure. Le réglage avancé « taille de fenêtre variable » doit être activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricordare le dimensioni delle finestre nell’integrazione tmux?\nRichiede tmux 2.9 o successivo. L’impostazione avanzata “Consenti dimensioni variabili delle finestre” deve essere attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合でウィンドウサイズを記憶するか？\ntmux 2.9以降が必要です。「可変ウィンドウサイズ」詳細設定を有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 통합에서 윈도우 크기를 기억하겠습니까?\ntmux 2.9 이상이 필요합니다. “가변 윈도우 크기” 고급 설정이 켜져 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar os tamanhos das janelas na integração do tmux?\nRequer tmux 2.9 ou posterior. O ajuste avançado “tamanho de janela variável” deve estar ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запоминать размеры окон при интеграции с tmux?\nТребуется tmux версии 2.9 или новее. Должен быть включён дополнительный параметр «variable window size»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux entegrasyonunda pencere boyutları hatırlansın mı?\ntmux 2.9 veya üzerini gerektirir. “tmux entegrasyonunda değişken pencere boyutlarına izin ver” gelişmiş ayarı etkin olmalıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在tmux集成中是否记得窗口大小？\n需要使用tmux 2.9或更高版本。必须启用“变量窗口大小”高级设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 tmux 整合中記住視窗大小？\n需要 tmux 2.9 或更新版本。必須啟用「可變視窗大小」進階設定。"
          }
        }
      }
    },
    "AdvancedSetting.removeAddTabButton" : {
      "comment" : "Advanced setting: removeAddTabButton",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schaltfläche „Neuer Tab“ aus horizontalen Tableisten entfernen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove the “new tab” button from horizontal tab bars?"
          }
        },
        "es" : {
          "stringUnit" : {
