    "Tip.0116.Body" : {
      "comment" : "Tip of the day body, id 0116",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno Tip dne můžete pohodlně přesunout na obrazovce, protože ho lze nyní přetahovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt vinduet Dagens tip til det sted på skærmen, der passer dig, da det nu kan trækkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positionieren Sie das Fenster „Tipp des Tages“ bequem auf Ihrem Bildschirm, denn es lässt sich jetzt per Ziehen verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reposition the Tip of the Day window conveniently on your screen, as it is now draggable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposiciona cómodamente la ventana Consejo del día en tu pantalla, ya que ahora se puede arrastrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä Päivän vinkki -ikkuna sopivaan kohtaan näytöllä, sillä sitä voi nyt vetää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repositionnez la fenêtre Astuce du jour où vous voulez sur votre écran, car vous pouvez désormais la faire glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposiziona comodamente la finestra Suggerimento del giorno sullo schermo, perché ora si può trascinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今日のヒント」ウィンドウはドラッグできるようになったので、画面上の好きな位置に移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 오늘의 팁 윈도우를 드래그할 수 있으므로 화면의 편한 위치로 옮길 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt vinduet Dagens tips der det passer på skjermen, siden det nå kan dras."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats het venster Tip van de dag gemakkelijk over je scherm, want het is nu versleepbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygodnie zmieniaj położenie okna Wskazówka dnia na ekranie, ponieważ można je teraz przeciągać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposicione a janela Dica do dia convenientemente na sua tela, pois agora ela pode ser arrastada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удобно перемещайте окно «Совет дня» по экрану, теперь его можно перетаскивать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno Tip dňa môžete pohodlne premiestniť na obrazovke, pretože ho teraz možno ťahať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno z nasvetom dneva udobno premaknite po zaslonu, saj ga je zdaj mogoče vleči."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta fönstret Dagens tips dit du vill på skärmen, eftersom det nu går att dra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün İpucu penceresi artık sürüklenebildiği için onu ekranınızda rahatça yeniden konumlandırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dễ dàng đặt lại vị trí cửa sổ Mẹo trong ngày trên màn hình, vì giờ đây bạn có thể kéo nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每日提示窗格现在可拖拽至屏幕任意位置，便于调整布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「每日小技巧」視窗現在可以拖移，方便你在螢幕上重新擺放位置。"
          }
        }
      }
    },
