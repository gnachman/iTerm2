          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči podporo za ubežno zaporedje REP (ponovi prejšnji znak)?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera stöd för escapesekvensen REP (upprepa föregående tecken)?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "REP (önceki karakteri tekrarla) kaçış dizisi desteği etkinleştirilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
