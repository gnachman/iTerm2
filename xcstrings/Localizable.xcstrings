    "ChatViewController.StreamPrivacyMessage" : {
      "comment" : "Warning shown before streaming all terminal content to AI",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Terminalinhalt wird an die KI gesendet, was an Dritte weitergeleitet werden kann. Vergewissern Sie sich, dass dies unbedenklich ist, bevor Sie fortfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All terminal content will be sent to AI, which may go to a third party. Ensure this is safe to do before proceeding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el contenido de la terminal se enviará a la IA, lo que podría llegar a un tercero. Asegúrate de que sea seguro antes de continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu du terminal sera envoyé à l’IA, et peut-être à un tiers. Assurez-vous que c’est sans risque avant de continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il contenuto del terminale verrà inviato all’IA, e potrebbe arrivare a una terza parte. Assicurati che sia sicuro prima di procedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのターミナルの内容がAIに送信され、第三者に渡る可能性があります。続行する前に、これが安全であることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 터미널 내용이 AI로 전송되며, 제3자에게 전달될 수 있습니다. 계속하기 전에 안전한지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o conteúdo do terminal será enviado à IA, o que pode ir para terceiros. Certifique-se de que isso é seguro antes de prosseguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё содержимое терминала будет отправлено в ИИ, что может означать передачу третьей стороне. Прежде чем продолжить, убедитесь, что это безопасно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm terminal içeriği YZ’ye gönderilecek ve bu içerik üçüncü bir tarafa ulaşabilir. Devam etmeden önce bunun güvenli olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有终端内容都会发送给 AI，可能会发送给第三方。继续前请确保这样做是安全的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有終端機內容都會傳送給 AI，其中可能會傳送給第三方。繼續之前，請確認這樣做是安全的。"
          }
        }
      }
    },
