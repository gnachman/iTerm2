    "ProfilesSession.SendCodeWhenIdleWarning" : {
      "comment" : "Warning shown when enabling the send-ASCII-code-when-idle option",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravděpodobně to zapnout nechcete. Není to vhodné k udržení relací ssh při životě, ani s kódem „0“. Opravdu to chcete zapnout?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil sandsynligvis ikke slå dette til. Det egner sig ikke til at holde ssh-sessioner i live, selv med koden “0”. Er du sikker på, at du vil have det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sollten Sie wahrscheinlich nicht aktivieren. Es eignet sich nicht dazu, ssh-Sitzungen aufrechtzuerhalten, selbst mit einem Code von „0“. Sind Sie sicher, dass Sie dies möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You probably don’t want to turn this on. It's not suitable for keeping ssh sessions alive, even with a code of “0”. Are you sure you want this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probablemente no quieras activar esto. No es adecuado para mantener activas las sesiones de ssh, ni siquiera con un código “0”. ¿Seguro que quieres hacerlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et luultavasti halua ottaa tätä käyttöön. Se ei sovellu ssh-istuntojen pitämiseen yhteydessä, vaikka koodi olisi ”0”. Haluatko varmasti tämän?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne voulez probablement pas activer ceci. Ce n’est pas adapté pour maintenir des sessions ssh actives, même avec un code « 0 ». Voulez-vous vraiment l’activer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente non vuoi attivarlo. Non è adatto a mantenere attive le sessioni ssh, nemmeno con il codice “0”. Vuoi davvero attivarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすることはお勧めしません。コード「0」を使用してもsshセッションを維持する用途には適していません。本当によろしいですか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션은 켜지 않는 것이 좋습니다. 코드를 “0”으로 지정해도 SSH 세션을 유지하는 데 적합하지 않습니다. 정말 켜겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil sannsynligvis ikke slå på dette. Det egner seg ikke til å holde ssh-økter i live, selv med koden «0». Er du sikker på at du vil ha dette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wilt dit waarschijnlijk niet inschakelen. Het is niet geschikt om ssh-sessies actief te houden, zelfs niet met de code “0”. Weet je zeker dat je dit wilt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raczej nie chcesz tego włączać. To nie nadaje się do podtrzymywania sesji ssh, nawet z kodem „0”. Czy na pewno chcesz to włączyć?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você provavelmente não quer ativar isto. Não é adequado para manter sessões ssh ativas, mesmo com um código “0”. Tem certeza de que quer isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорее всего, вам не стоит включать эту функцию. Она не подходит для поддержания ssh-сессий активными, даже с кодом «0». Вы уверены, что хотите это сделать?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravdepodobne to nechcete zapnúť. Nehodí sa na udržiavanie relácií ssh pri živote, ani s kódom „0“. Naozaj to chcete?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tega verjetno ne želite vklopiti. Ni primerno za ohranjanje povezav SSH, niti s kodo »0«. Ste prepričani, da to želite?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill förmodligen inte slå på detta. Det lämpar sig inte för att hålla ssh-sessioner vid liv, inte ens med koden ”0”. Är du säker på att du vill göra det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muhtemelen bunu açmak istemezsiniz. “0” koduyla bile ssh oturumlarını canlı tutmak için uygun değildir. Bunu gerçekten istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
