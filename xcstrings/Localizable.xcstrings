            "state" : "translated",
            "value" : "Tarkistetaanko älykkään valinnan toiminnot ennen olemassa olevia tiedostoja cmd-klikattaessa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier les actions de sélection intelligente avant les fichiers existants lors d’un clic avec ⌘ ?"
          }
        },
        "it" : {
          "stringUnit" : {
