    "NSFileManager.AppSupportError" : {
      "comment" : "Error shown when the application support directory could not be created; placeholder is the underlying error message",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při hledání nebo vytváření adresáře Application Support došlo k problému. Dokud nebude opraven, iTerm2 nebude fungovat správně.\n\nAdresář by měl být v ~/Library/Application Support/iTerm2.\n\nChyba:\n%@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der opstod et problem under søgning efter eller oprettelse af din Application Support-mappe. iTerm2 fungerer ikke særlig godt, før problemet er løst.\n\nMappen skulle være ~/Library/Application Support/iTerm2.\n\nFejlen var:\n%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Suchen oder Erstellen Ihres Application-Support-Verzeichnisses ist ein Problem aufgetreten. iTerm2 funktioniert erst dann einwandfrei, wenn dieses Problem behoben ist.\n\nEs sollte sich unter ~/Library/Application Support/iTerm2 befinden.\n\nDer Fehler lautete:\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem finding or creating your application support directory. iTerm2 won't work very well until this problem is fixed.\n\nIt should be at ~/Library/Application Support/iTerm2.\n\nThe error was:\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubo un problema al buscar o crear tu directorio de soporte de aplicaciones. iTerm2 no funcionará muy bien hasta que se solucione.\n\nDebería estar en ~/Library/Application Support/iTerm2.\n\nEl error fue:\n%@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovellustukihakemiston etsimisessä tai luomisessa oli ongelma. iTerm2 ei toimi kovin hyvin, ennen kuin tämä on korjattu.\n\nSen pitäisi olla sijainnissa ~/Library/Application Support/iTerm2.\n\nVirhe oli:\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un problème est survenu lors de la recherche ou de la création de votre répertoire Application Support. iTerm2 ne fonctionnera pas correctement tant que ce problème ne sera pas résolu.\n\nIl devrait se trouver dans ~/Library/Application Support/iTerm2.\n\nL’erreur était :\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un problema nel trovare o creare la directory Application Support. iTerm2 non funzionerà bene finché il problema non sarà risolto.\n\nDovrebbe trovarsi in ~/Library/Application Support/iTerm2.\n\nL’errore era:\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションサポートディレクトリの検索または作成中に問題が発生しました。この問題が修正されるまで、iTerm2は正常に動作しません。\n\nこれは~/Library/Application Support/iTerm2にあるはずです。\n\nエラーは次のとおりです:\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램 지원 디렉토리를 찾거나 생성하는 데 문제가 발생했습니다. 이 문제가 해결될 때까지 iTerm2가 제대로 작동하지 않습니다.\n\n디렉토리는 ~/Library/Application Support/iTerm2에 있어야 합니다.\n\n오류:\n%@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det oppsto et problem med å finne eller opprette mappen Application Support. iTerm2 fungerer dårlig til dette er rettet.\n\nDen skal ligge på ~/Library/Application Support/iTerm2.\n\nFeilen var:\n%@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een probleem opgetreden bij het zoeken naar of maken van je map Application Support. iTerm2 werkt niet goed totdat dit probleem is opgelost.\n\nDe map hoort te staan op ~/Library/Application Support/iTerm2.\n\nDe fout was:\n%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystąpił problem ze znalezieniem lub utworzeniem twojego katalogu Application Support. iTerm2 nie będzie dobrze działać, dopóki ten problem nie zostanie rozwiązany.\n\nKatalog powinien znajdować się w ~/Library/Application Support/iTerm2.\n\nBłąd:\n%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um problema ao localizar ou criar o diretório de suporte do aplicativo. O iTerm2 não funcionará muito bem até que este problema seja resolvido.\n\nEle deveria estar em ~/Library/Application Support/iTerm2.\n\nO erro foi:\n%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возникла проблема при поиске или создании каталога поддержки приложений. iTerm2 не будет нормально работать, пока эта проблема не будет устранена.\n\nОн должен находиться по адресу ~/Library/Application Support/iTerm2.\n\nОшибка:\n%@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri hľadaní alebo vytváraní adresára Application Support nastal problém. Kým sa nevyrieši, iTerm2 nebude fungovať veľmi dobre.\n\nMal by sa nachádzať v ~/Library/Application Support/iTerm2.\n\nChyba bola:\n%@"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri iskanju ali ustvarjanju imenika Application Support je prišlo do težave. Aplikacija iTerm2 ne bo delovala dobro, dokler težave ne odpravite.\n\nImenik bi moral biti v ~/Library/Application Support/iTerm2.\n\nNapaka:\n%@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att hitta eller skapa katalogen Application Support. iTerm2 fungerar inte särskilt bra förrän problemet är åtgärdat.\n\nDen ska finnas på ~/Library/Application Support/iTerm2.\n\nFelet var:\n%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application Support dizininiz bulunurken veya oluşturulurken bir sorun oluştu. Bu sorun giderilene kadar iTerm2 pek iyi çalışmayacak.\n\nDizin ~/Library/Application Support/iTerm2 konumunda olmalıdır.\n\nHata şuydu:\n%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra sự cố khi tìm hoặc tạo thư mục application support của bạn. iTerm2 sẽ không hoạt động tốt cho đến khi sự cố này được khắc phục.\n\nThư mục này phải nằm ở ~/Library/Application Support/iTerm2.\n\nLỗi là:\n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找或创建应用支持目录时出现问题。在此问题修复前，iTerm2 将无法正常工作。\n\n它应位于 ~/Library/Application Support/iTerm2。\n\n错误为：\n%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋找或建立你的 Application Support 目錄時發生問題。在問題修正之前，iTerm2 將無法正常運作。\n\n它應該位於 ~/Library/Application Support/iTerm2。\n\n錯誤內容：\n%@"
          }
        }
      }
    },
