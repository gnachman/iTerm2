          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если установлена «Интеграция с оболочкой», вы можете выделить вывод последней команды с помощью ⇧⌘A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Shell Integration 后，可以使用 ⇧⌘A 选择上一个命令的输出内容。"
          }
        }
      }
    },
