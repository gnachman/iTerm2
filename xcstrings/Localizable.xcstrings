        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förvalt värde för brickans toppmarginal\nHur mycket utrymme som ska lämnas mellan brickans överkant och terminalens överkant. Kan åsidosättas av en profilinställning. Detta är förvalet om en profil inte har någon inställning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozet için varsayılan üst kenar boşluğu\nRozetin üst kenarı ile terminalin üst kenarı arasında ne kadar boşluk bırakılacağı. Bir profil ayarıyla geçersiz kılınabilir. Bir profilde ayar yoksa varsayılan değer budur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị mặc định cho lề trên của huy hiệu\nKhoảng trống để lại giữa cạnh trên của huy hiệu và cạnh trên của terminal. Có thể bị cài đặt của hồ sơ ghi đè. Đây là giá trị mặc định nếu hồ sơ không có cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "徽章顶部边缘的默认值  \n徽章顶部边缘与终端顶部边缘之间的间距。可通过配置文件设置覆盖此值。若未配置配置文件，则采用默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標記牌上邊界的預設值\n標記牌上緣與終端機上緣之間要保留多少空間。可由描述檔設定覆寫。描述檔未設定時，會使用此預設值。"
          }
        }
      }
    },
    "AdvancedSetting.bellRateLimit" : {
      "comment" : "Advanced setting: bellRateLimit",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimální doba mezi pípnutími nebo bliknutími obrazovky při zvonku, v sekundách.\nPokud je časový odstup mezi zvonky kratší než tato doba, bude ignorován."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindste tid mellem bip eller skærmblink ved klokken, i sekunder.\nHvis tidsrummet mellem klokkesignaler er kortere end dette, ignoreres det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestzeit zwischen Signalton oder Bildschirmblitz bei einem Klingelzeichen, in Sekunden.\nWenn das Zeitintervall zwischen Klingelzeichen kürzer als dieser Wert ist, wird es ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum time between beeping or flashing screen on bell, in seconds.\nIf the time interval between bells is less than this amount of time, it will be ignored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo mínimo entre pitidos o destellos de pantalla por la campana, en segundos.\nSi el intervalo entre campanas es menor que este tiempo, se ignorará."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähimmäisaika äänimerkin tai näytön välähdyksen välillä sekunteina.\nJos äänimerkkien väli on tätä lyhyempi, äänimerkki ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée minimale, en secondes, entre deux bips ou clignotements de l’écran lors d’une sonnerie.\nSi l’intervalle entre deux sonneries est inférieur à cette durée, la sonnerie est ignorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo minimo tra un segnale acustico o lampeggiamento dello schermo e il successivo in risposta al campanello, in secondi.\nSe l’intervallo tra due campanelli è inferiore a questo valore, il campanello verrà ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベル時にビープ音を鳴らしたり画面を点滅させたりする間隔の最小時間 (秒単位)。\nベルの間隔がこの時間より短い場合、無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벨이 울릴 때 경고음 또는 화면 깜빡임 사이의 최소 시간(초).\n벨 사이의 간격이 이 시간보다 짧으면 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minste tid mellom pip eller blinking på skjermen ved bjelle, i sekunder.\nHvis tidsintervallet mellom bjeller er kortere enn dette, ignoreres bjellen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimale tijd tussen piepen of knipperen van het scherm bij de bel, in seconden.\nAls het tijdsinterval tussen bellen korter is dan deze tijd, wordt de bel genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimalny czas w sekundach między sygnałami dźwiękowymi lub błyskami ekranu przy dzwonku.\nJeśli odstęp między dzwonkami jest krótszy niż ten czas, dzwonek zostanie zignorowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo mínimo entre bipes ou piscadas da tela na campainha, em segundos.\nSe o intervalo de tempo entre campainhas for menor que este período, ela será ignorada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимальное время между звуковым сигналом или миганием экрана при сигнале колокольчика, в секундах.\nЕсли интервал между сигналами меньше этого значения, он будет проигнорирован."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimálny čas medzi pípnutím alebo zablikaním obrazovky pri zvončeku, v sekundách.\nAk je časový odstup medzi zvončekmi menší ako táto hodnota, bude ignorovaný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najmanjši čas med piski ali utripanji zaslona ob zvoncu, v sekundah.\nČe je časovni razmik med zvonci krajši od tega, bo prezrt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minsta tid mellan ljudsignaler eller skärmblinkningar vid klocka, i sekunder.\nOm tiden mellan klockor är kortare än så ignoreras den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilde bip sesi çıkarma veya ekranı yanıp söndürme arasındaki en kısa süre, saniye cinsinden.\nZiller arasındaki süre bu değerden kısaysa yok sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian tối thiểu giữa các lần phát tiếng bíp hoặc nháy màn hình khi có chuông, tính bằng giây.\nNếu khoảng thời gian giữa các hồi chuông ngắn hơn mức này, chuông sẽ bị bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "铃声或屏幕闪烁之间的最小时间（秒）。  \n若铃声间隔小于此值，则会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "響鈴時發出嗶聲或閃爍螢幕之間的最短時間，以秒為單位。\n如果兩次響鈴的間隔短於此時間，就會被忽略。"
          }
        }
      }
    },
    "AdvancedSetting.bootstrapDaemon" : {
      "comment" : "Advanced setting: bootstrapDaemon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožnit relacím přežít odhlášení a opětovné přihlášení.\nTím se naruší trik „auth sufficient pam_tid.so“, který někteří lidé používají k ověřování sudo pomocí Touch ID."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad sessioner overleve, at man logger ud og ind igen.\nDette bryder hacket “auth sufficient pam_tid.so”, som nogle bruger til at lade sudo godkende med Touch ID."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass Sitzungen ein Ab- und wieder Anmelden überstehen.\nDies bricht den „auth sufficient pam_tid.so“-Hack, den manche Leute verwenden, damit sudo sich per Touch ID authentifizieren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow sessions to survive logging out and back in.\nThis breaks the “auth sufficient pam_tid.so” hack some people use to allow sudo to authenticate with Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que las sesiones sobrevivan al cerrar y volver a iniciar sesión.\nEsto rompe el truco “auth sufficient pam_tid.so” que algunas personas usan para que sudo se autentique con Touch ID."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli istuntojen säilyä uloskirjautumisen ja sisäänkirjautumisen yli.\nTämä rikkoo ”auth sufficient pam_tid.so” -kikan, jota jotkut käyttävät sallimaan sudon todennuksen Touch ID:llä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permettre aux sessions de survivre à une déconnexion puis reconnexion.\nCela casse l’astuce « auth sufficient pam_tid.so » que certains utilisent pour authentifier sudo avec Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti alle sessioni di sopravvivere a una disconnessione e a un nuovo accesso.\nQuesto interrompe il trucco “auth sufficient pam_tid.so” che alcuni usano per consentire a sudo di autenticarsi con Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウトして再度ログインしてもセッションを保持できるようにします。\nこれにより、一部のユーザーが sudo を Touch ID で認証させるために使っている「auth sufficient pam_tid.so」というハックが機能しなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그아웃했다가 다시 로그인해도 세션 유지 허용.\n일부 사용자가 sudo에서 Touch ID로 인증하기 위해 사용하는 “auth sufficient pam_tid.so” 편법이 작동하지 않게 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La økter overleve utlogging og pålogging.\nDette bryter «auth sufficient pam_tid.so»-trikset som noen bruker for at sudo skal autentisere med Touch ID."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat sessies uitloggen en weer inloggen overleven.\nHierdoor werkt de hack ‘auth sufficient pam_tid.so’ niet meer, die sommige mensen gebruiken om sudo met Touch ID te laten authenticeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól sesjom przetrwać wylogowanie i ponowne zalogowanie.\nPsuje to sztuczkę „auth sufficient pam_tid.so”, której niektórzy używają, aby sudo uwierzytelniało się za pomocą Touch ID."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que sessões sobrevivam ao logout e login novamente.\nIsso quebra o truque “auth sufficient pam_tid.so” que algumas pessoas usam para permitir que o sudo autentique com Touch ID."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить сессиям переживать выход из системы и повторный вход.\nЭто нарушает хак «auth sufficient pam_tid.so», которым некоторые пользуются, чтобы разрешить sudo аутентификацию по Touch ID."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožniť reláciám prežiť odhlásenie a opätovné prihlásenie.\nTýmto sa naruší trik „auth sufficient pam_tid.so“, ktorý niektorí ľudia používajú na overovanie sudo cez Touch ID."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovoli, da seje preživijo odjavo in ponovno prijavo.\nTo pokvari trik »auth sufficient pam_tid.so«, ki ga nekateri uporabljajo, da sudo overja s Touch ID."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt sessioner överleva utloggning och inloggning.\nDetta förstör hacket ”auth sufficient pam_tid.so” som vissa använder för att låta sudo autentisera med Touch ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumların oturumu kapatıp yeniden açmadan sağ çıkmasına izin ver.\nBu, bazı kişilerin sudo’nun Touch ID ile kimlik doğrulamasına izin vermek için kullandığı “auth sufficient pam_tid.so” yöntemini bozar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép các phiên tồn tại qua việc đăng xuất rồi đăng nhập lại.\nĐiều này làm hỏng mẹo “auth sufficient pam_tid.so” mà một số người dùng để cho phép sudo xác thực bằng Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许会话在登出后重新登录时继续运行。  \n此设置可解除部分用户使用的“auth sufficient pam_tid.so”技巧，该技巧用于允许sudo通过Touch ID认证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許工作階段在登出後再登入時繼續存在。\n這會破壞有些人用來讓 sudo 以 Touch ID 驗證的「auth sufficient pam_tid.so」做法。"
          }
        }
      }
    },
    "AdvancedSetting.bordersOnlyInLightMode" : {
      "comment" : "Advanced setting: bordersOnlyInLightMode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprůhledná okna mají okraj pouze ve světlém režimu.\nToto nastavení upravuje volbu „Zobrazit okraj kolem oken“. Okraje neprůhledných oken v tmavém režimu jsou ošklivé a systém kreslí vlastní, který je docela použitelný. Zapněte, pokud je špatně vidíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uigennemsigtige vinduer har kun en kant i lys tilstand.\nDenne indstilling ændrer “Vis kant omkring vinduer”. Kanter på uigennemsigtige vinduer i mørk tilstand er grimme, og systemet tegner en, der er ganske brugbar. Slå dette til, hvis du har svært ved at se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undurchsichtige Fenster haben nur im hellen Modus einen Rahmen.\nDiese Einstellung ändert „Rahmen um Fenster anzeigen“. Rahmen bei undurchsichtigen Fenstern im dunklen Modus sehen unschön aus, und das Betriebssystem zeichnet ohnehin einen brauchbaren Rahmen. Aktivieren Sie dies, wenn Sie Schwierigkeiten haben, sie zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opaque windows have a border only in light mode.\nThis setting modifies “Show border around windows”. Borders in opaque windows in dark mode are ugly and the OS draws one that is pretty serviceable. Enable this if you have trouble seeing them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas opacas tienen borde solo en el modo claro.\nEste ajuste modifica “Mostrar borde alrededor de las ventanas”. Los bordes de las ventanas opacas en el modo oscuro son feos y el sistema dibuja uno bastante aceptable. Actívalo si tienes problemas para verlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läpinäkymättömillä ikkunoilla on reunus vain vaaleassa tilassa.\nTämä asetus muokkaa asetusta ”Näytä ikkunoiden reunukset”. Läpinäkymättömien ikkunoiden reunukset ovat rumia tummassa tilassa, ja käyttöjärjestelmä piirtää varsin kelvollisen. Ota tämä käyttöön, jos et näe niitä hyvin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres opaques n’ont de bordure qu’en mode clair.\nCe réglage modifie « Afficher une bordure autour des fenêtres ». Les bordures des fenêtres opaques en mode sombre sont laides et le système en dessine une tout à fait correcte. Activez cette option si vous avez du mal à les voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre opache hanno un bordo solo in modalità chiara.\nQuesta impostazione modifica “Mostra bordo attorno alle finestre”. I bordi nelle finestre opache in modalità scura sono brutti e il sistema ne disegna uno più che adeguato. Abilitala se hai difficoltà a vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明なウィンドウは、ライトモードのときのみ境界線を表示します。\nこの設定は「ウィンドウの周囲に境界線を表示」を変更します。ダークモードの不透明なウィンドウの境界線は見た目が悪く、OS が描画するもので十分実用的です。境界線が見えにくい場合はこれを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불투명 윈도우는 라이트 모드에서만 테두리를 가집니다.\n이 설정은 “윈도우 주위에 테두리 보기”를 변경합니다. 다크 모드에서 불투명 윈도우의 테두리는 보기 좋지 않으며 OS가 꽤 쓸 만한 테두리를 그려 줍니다. 테두리가 잘 보이지 않으면 이 설정을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugjennomsiktige vinduer har bare ramme i lys modus.\nDenne innstillingen endrer «Vis ramme rundt vinduer». Rammer rundt ugjennomsiktige vinduer i mørk modus er stygge, og operativsystemet tegner en som fungerer helt greit. Aktiver dette hvis du har problemer med å se dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekkende vensters hebben alleen een rand in de lichte modus.\nDeze instelling past ‘Toon rand rond vensters’ aan. Randen om dekkende vensters in de donkere modus zijn lelijk en het systeem tekent er een die prima voldoet. Schakel dit in als je ze moeilijk kunt zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprzezroczyste okna mają obramowanie tylko w trybie jasnym.\nTo ustawienie modyfikuje „Pokaż obramowanie wokół okien”. Obramowania nieprzezroczystych okien w trybie ciemnym są brzydkie, a system rysuje własne, całkiem użyteczne. Włącz, jeśli masz problem z ich dostrzeżeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas opacas têm borda apenas no modo claro.\nEste ajuste modifica “Mostrar borda ao redor das janelas”. Bordas em janelas opacas no modo escuro são feias e o sistema desenha uma que é bastante útil. Ative isto se tiver dificuldade em vê-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрозрачные окна имеют рамку только в светлом режиме.\nЭта настройка изменяет «Показывать рамку вокруг окон». Рамки у непрозрачных окон в тёмном режиме выглядят некрасиво, а ОС и так рисует вполне приемлемую рамку. Включите это, если вам трудно их разглядеть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepriehľadné okná majú rámik iba vo svetlom režime.\nToto nastavenie upravuje možnosť „Zobraziť rámik okolo okien“. Rámiky nepriehľadných okien v tmavom režime sú škaredé a systém vykresľuje vlastný, ktorý je celkom použiteľný. Zapnite, ak ich ťažko vidíte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprosojna okna imajo obrobo samo v svetlem načinu.\nTa nastavitev spreminja »Prikaži obrobo okoli oken«. Obrobe neprosojnih oken v temnem načinu so grde, sistem pa nariše svojo, ki je povsem uporabna. Omogočite, če jih težko vidite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täckande fönster har bara ram i ljust läge.\nDen här inställningen ändrar ”Visa ram runt fönster”. Ramar runt täckande fönster i mörkt läge är fula och systemet ritar en som fungerar ganska bra. Aktivera detta om du har svårt att se dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opak pencerelerin kenarlığı yalnızca açık modda olur.\nBu ayar “Pencerelerin çevresinde kenarlık göster” ayarını değiştirir. Koyu moddaki opak pencerelerde kenarlıklar çirkin görünür ve işletim sisteminin çizdiği kenarlık oldukça yeterlidir. Kenarlıkları görmekte zorlanıyorsanız bunu etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ không trong suốt chỉ có viền ở chế độ sáng.\nCài đặt này sửa đổi “Hiển thị viền quanh cửa sổ”. Viền của cửa sổ không trong suốt ở chế độ tối trông xấu và hệ điều hành đã vẽ một viền khá ổn. Hãy bật tùy chọn này nếu bạn khó nhìn thấy chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明窗口在亮色模式下仅有边框。  \n此设置修改“显示窗口边框”选项。暗色模式下的不透明窗口边框会显得丑陋，操作系统会自动绘制一个美观的边框。若难以看到边框，可启用此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明視窗僅在淺色模式下有邊框。\n此設定會變更「在視窗周圍顯示邊框」。深色模式下不透明視窗的邊框很難看，而系統繪製的邊框已相當堪用。如果你看不清楚邊框，請啟用此項。"
          }
        }
      }
    },
    "AdvancedSetting.bounceOnInactiveBell" : {
      "comment" : "Advanced setting: bounceOnInactiveBell",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechat ikonu v Docku poskakovat, když zazvoní zvonek v době, kdy je aktivní jiná aplikace?"
          }
        },
        "da" : {
