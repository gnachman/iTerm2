    "Tip.0053.Body" : {
      "comment" : "Tip of the day body, id 0053",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte pravým tlačítkem na číslo a kontextová nabídka ho zobrazí převedené do šestnáctkové nebo desítkové soustavy, podle potřeby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på et tal, så viser kontekstmenuen det konverteret til hexadecimal eller decimal, alt efter hvad der passer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie mit der rechten Maustaste auf eine Zahl, und das Kontextmenü zeigt sie je nach Bedarf in hexadezimaler oder dezimaler Form an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Right-click on a number and the context menu shows it converted to hex or decimal as appropriate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic con el botón derecho en un número y el menú contextual lo mostrará convertido a hexadecimal o decimal, según corresponda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa lukua oikealla painikkeella, niin kontekstivalikko näyttää sen muunnettuna heksa- tai desimaaliluvuksi tilanteen mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur un nombre et le menu contextuel l’affiche converti en hexadécimal ou en décimal, selon le cas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con il tasto destro su un numero e il menu contestuale lo mostrerà convertito in esadecimale o decimale, a seconda del caso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数値を右クリックすると、コンテキストメニューにその数値を16進数または10進数に変換した値が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫자를 오른쪽 클릭하면 문맥 메뉴에 해당 숫자를 16진수 또는 10진수로 변환한 값이 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på et tall, så viser kontekstmenyen det konvertert til heksadesimal eller desimal etter behov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een getal en het contextmenu toont het omgezet naar hexadecimaal of decimaal, al naargelang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij liczbę prawym przyciskiem, a menu kontekstowe pokaże ją przekonwertowaną na system szesnastkowy lub dziesiętny, zależnie od potrzeby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em um número e o menu de contexto o mostrará convertido para hexadecimal ou decimal, conforme apropriado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните правой кнопкой мыши по числу, и контекстное меню покажет его перевод в шестнадцатеричную или десятичную систему в зависимости от ситуации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite pravým tlačidlom na číslo a kontextové menu ho zobrazí prevedené na hexadecimálne alebo desiatkové, podľa potreby."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z desnim klikom na število kontekstni meni prikaže njegovo pretvorbo v šestnajstiško ali desetiško obliko, kot je ustrezno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på ett tal så visar snabbmenyn det omvandlat till hexadecimalt eller decimalt, beroende på vad som passar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sayıya sağ tıklayın; bağlam menüsü onu uygun şekilde onaltılık veya onluk tabanda gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm chuột phải vào một số và menu ngữ cảnh sẽ hiển thị số đó được chuyển sang hệ thập lục phân hoặc thập phân tùy trường hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在数字上右键点击时，上下文菜单会显示对应的十六进制或十进制数值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在數字上按一下右鍵，快顯選單會顯示它轉換成的十六進位或十進位值。"
          }
        }
      }
    },
