    "Tip.0025.Body" : {
      "comment" : "Tip of the day body, id 0025",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkce integrace shellu umístí vedle výzvy shellu modrou šipku. Pokud příkaz selže, zčervená. Kliknutím pravým tlačítkem zobrazíte dobu běhu a stav."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-integration sætter en blå pil ved siden af din shell-prompt. Hvis du kører en kommando, der mislykkes, bliver den rød. Højreklik på den for at se køretid og status."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shell-Integration zeigt einen blauen Pfeil neben Ihrer Shell-Eingabeaufforderung an. Wenn ein ausgeführter Befehl fehlschlägt, wird er rot. Klicken Sie mit der rechten Maustaste darauf, um Laufzeit und Status zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Shell Integration feature puts a blue arrow next to your shell prompt. If you run a command that fails, it turns red. Right click on it to get the running time and status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con el shell coloca una flecha azul junto al prompt del shell. Si ejecutas un comando que falla, se vuelve roja. Haz clic con el botón derecho en ella para ver el tiempo de ejecución y el estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komentotulkki-integraatio lisää sinisen nuolen komentotulkin kehotteen viereen. Jos suoritat komennon, joka epäonnistuu, nuoli muuttuu punaiseksi. Klikkaa sitä oikealla painikkeella nähdäksesi suoritusajan ja tilan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration du shell place une flèche bleue à côté de l’invite de votre shell. Si une commande échoue, elle devient rouge. Faites un clic droit dessus pour obtenir la durée d’exécution et l’état."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione shell inserisce una freccia blu accanto al prompt della shell. Se esegui un comando che non riesce, diventa rossa. Fai clic con il tasto destro su di essa per vedere il tempo di esecuzione e lo stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合機能は、シェルプロンプトの横に青い矢印を表示します。実行したコマンドが失敗すると、矢印は赤くなります。右クリックすると、実行時間とステータスを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합 기능은 셸 프롬프트 옆에 파란색 화살표를 표시합니다. 실행한 명령이 실패하면 빨간색으로 바뀝니다. 화살표를 오른쪽 클릭하면 실행 시간과 상태를 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skallintegrering setter en blå pil ved siden av ledeteksten i skallet. Hvis du kjører en kommando som mislykkes, blir den rød. Høyreklikk på den for å se kjøretid og status."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-integratie plaatst een blauwe pijl naast je shell-prompt. Als een commando mislukt, wordt de pijl rood. Klik er met de rechtermuisknop op om de uitvoeringstijd en status te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracja z powłoką umieszcza niebieską strzałkę obok znaku zachęty powłoki. Jeśli uruchomione polecenie zakończy się niepowodzeniem, strzałka robi się czerwona. Kliknij ją prawym przyciskiem, aby zobaczyć czas wykonania i stan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso Shell Integration coloca uma seta azul ao lado do seu prompt do shell. Se você executar um comando que falha, ela fica vermelha. Clique nela com o botão direito para ver o tempo de execução e o status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функция «Интеграция с оболочкой» отображает синюю стрелку рядом с приглашением оболочки. Если выполненная команда завершается ошибкой, стрелка становится красной. Щёлкните по ней правой кнопкой мыши, чтобы узнать время выполнения и статус."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcia integrácie shellu umiestni modrú šípku vedľa výzvy shellu. Ak príkaz zlyhá, zmení sa na červenú. Kliknutím pravým tlačidlom na ňu zobrazíte čas behu a stav."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funkcija integracije lupine postavi moder trikotnik ob ukazni poziv lupine. Če ukaz ne uspe, postane rdeč. Z desnim klikom nanj prikažete čas izvajanja in stanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalintegrering sätter en blå pil bredvid skalpromten. Om du kör ett kommando som misslyckas blir den röd. Högerklicka på den för att se körtiden och statusen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu özelliği kabuk isteminizin yanına mavi bir ok koyar. Başarısız bir komut çalıştırırsanız ok kırmızıya döner. Çalışma süresini ve durumu görmek için sağ tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng Tích hợp shell đặt một mũi tên xanh cạnh dấu nhắc shell. Nếu bạn chạy một lệnh bị lỗi, mũi tên chuyển sang màu đỏ. Bấm chuột phải vào nó để xem thời gian chạy và trạng thái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell集成功能会在您的shell提示符旁添加蓝色箭头。如果运行的命令失败，它会变为红色。点击右键可查看运行时间和状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 整合功能會在 shell 提示符號旁放置一個藍色箭頭。如果執行的指令失敗，箭頭會變成紅色。在它上面按一下右鍵可查看執行時間和狀態。"
          }
        }
      }
    },
