    "APIHelper.EnablePythonAPIMessage" : {
      "comment" : "Body text explaining what enabling the Python API allows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API umožňuje skriptům, které spustíte, ovládat iTerm2 a přistupovat ke všem jeho datům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
