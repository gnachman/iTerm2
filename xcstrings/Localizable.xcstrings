    "Tip.0056.Body" : {
      "comment" : "Tip of the day body, id 0056",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaškrtávací políčko „okamžitě“ ve spouštěči umožní jeho aktivaci, i když je kurzor na stejném řádku jako text odpovídající vašemu regulárnímu výrazu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afkrydsningsfeltet “Øjeblikkelig” i en udløser lader den udløses, mens markøren er på samme linje som teksten, der matcher dit regulære udtryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kontrollkästchen „Sofort“ in einem Trigger kann dieser bereits ausgelöst werden, während sich der Cursor noch in derselben Zeile wie der zu Ihrem regulären Ausdruck passende Text befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “instant” checkbox in a Trigger allows it to fire while the cursor is on the same line as the text that matches your regular expression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casilla “Instantáneo” de un disparador permite que se active mientras el cursor está en la misma línea que el texto que coincide con tu expresión regular."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistimen ”instant”-valintaruutu sallii sen laukeamisen, kun kohdistin on samalla rivillä kuin säännölliseen lausekkeeseesi täsmäävä teksti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case « instantané » d’un déclencheur lui permet de s’activer pendant que le curseur se trouve sur la même ligne que le texte correspondant à votre expression régulière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casella “istantaneo” di un attivatore gli permette di scattare mentre il cursore si trova sulla stessa riga del testo che corrisponde alla tua espressione regolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーの「即時」チェックボックスをオンにすると、正規表現に一致するテキストと同じ行にカーソルがある間もトリガーを発火させられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거의 ‘즉시’ 체크박스를 선택하면 정규 표현식과 일치하는 텍스트와 같은 줄에 커서가 있는 동안에도 트리거가 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avkrysningsboksen «Øyeblikkelig» i en utløser gjør at den kan utløses mens markøren er på samme linje som teksten som treffer det regulære uttrykket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met het aanvinkvak ‘Direct’ in een trigger kan die afgaan terwijl de cursor op dezelfde regel staat als de tekst die overeenkomt met je reguliere expressie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole wyboru „natychmiast” w wyzwalaczu pozwala mu zadziałać, gdy kursor jest w tym samym wierszu co tekst pasujący do wyrażenia regularnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa de seleção “instantâneo” em um gatilho permite que ele seja acionado enquanto o cursor está na mesma linha do texto que corresponde à sua expressão regular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флажок «мгновенно» в триггере позволяет ему срабатывать, пока курсор находится на той же строке, что и текст, соответствующий регулярному выражению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začiarkavacie políčko „okamžitý“ v spúšťači umožní jeho aktiváciu, kým je kurzor na tom istom riadku ako text zodpovedajúci vášmu regulárnemu výrazu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrditveno polje »Takoj« v sprožilcu omogoči, da se sproži, medtem ko je kazalec v isti vrstici kot besedilo, ki se ujema z vašim regularnim izrazom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kryssrutan ”Omedelbar” i en utlösare gör att den kan utlösas medan markören står på samma rad som texten som matchar ditt reguljära uttryck."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Tetikleyici’deki “anında” onay kutusu, imleç düzenli ifadenizle eşleşen metinle aynı satırdayken tetiklenmesini sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hộp kiểm “Tức thì” trong một trình kích hoạt cho phép nó kích hoạt khi con trỏ đang ở cùng dòng với văn bản khớp với biểu thức chính quy của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Trigger 中的“即时”复选框允许在光标位于与正则表达式匹配的文本同一行时触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發器中的「即時」核取方塊，可讓觸發器在游標與符合正規表示式的文字位於同一行時就觸發。"
          }
        }
      }
    },
