    "ClaudeCodeOnboarding.RemoteIt2Missing" : {
      "comment" : "Shown when the remote host lacks the uploaded it2 wrapper; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SSH Integration couldn’t set up the it2 command on %@, so the hook would have nothing to run. This happens when the login shell there is not one SSH Integration supports: zsh, bash, fish, or xonsh."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die SSH-Integration konnte den it2-Befehl auf %@ nicht einrichten, daher hätte der Hook nichts auszuführen. Das passiert, wenn die Login-Shell dort keine von der SSH-Integration unterstützte Shell ist: zsh, bash, fish oder xonsh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合が%@にit2コマンドを設定できなかったため、フックが実行するものがありません。これは、そこのログインシェルがSSH統合のサポートするシェル（zsh、bash、fish、xonsh）ではない場合に発生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합이 %@에 it2 명령을 설정할 수 없어 훅이 실행할 것이 없습니다. 이는 해당 호스트의 로그인 셸이 SSH 통합이 지원하는 셸(zsh, bash, fish, xonsh)이 아닐 때 발생합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Integração SSH não conseguiu configurar o comando it2 em %@, então o hook não teria nada para executar. Isso acontece quando o shell de login lá não é um dos compatíveis com a Integração SSH: zsh, bash, fish ou xonsh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеграции с SSH не удалось настроить команду it2 на %@, поэтому хуку нечего запускать. Так бывает, когда оболочка входа там не поддерживается интеграцией с SSH. Поддерживаются zsh, bash, fish и xonsh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 集成无法在 %@ 上设置 it2 命令，因此钩子将无可运行的命令。当该主机上的登录 Shell 不是 SSH 集成支持的 Shell（zsh、bash、fish 或 xonsh）时，就会出现这种情况。"
          }
        }
      }
    },
    "ClaudeCodeOnboarding.RemoteSettingsMalformed" : {
      "comment" : "Shown when Claude Code settings on a remote host could not be parsed; the values are a file path and the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ on %2$@ isn’t valid JSON. iTerm2 left it unchanged. Fix or remove it and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ auf %2$@ ist kein gültiges JSON. iTerm2 hat die Datei nicht verändert. Korrigieren oder entfernen Sie sie und versuchen Sie es erneut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@上の%1$@は有効なJSONではありません。iTerm2は変更しませんでした。修正または削除してから、もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 %1$@은(는) 유효한 JSON이 아닙니다. iTerm2는 이 파일을 변경하지 않았습니다. 파일을 수정하거나 제거한 후 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ em %2$@ não é um JSON válido. O iTerm2 o deixou inalterado. Corrija-o ou remova-o e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ на %2$@ не является допустимым JSON. iTerm2 не стал изменять файл. Исправьте или удалите его и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上的 %1$@ 不是有效的 JSON。iTerm2 未对其进行更改。请修复或删除该文件，然后重试。"
          }
        }
      }
    },
