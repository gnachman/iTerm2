          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene permiso permanente para usar la API de iTerm2. Puedes cambiarlo en Ajustes > General > Magia > Acceso a la API por SSH."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin %@ on jo pysyvästi sallittu käyttämään iTerm2 API:a. Voit muuttaa tätä kohdassa Asetukset > Yleiset > Taikuus > API-käyttö SSH:n kautta."
