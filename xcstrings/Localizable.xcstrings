    "MigrationHelper.ManualUpdateBody" : {
      "comment" : "Explanation that the application support directory changed and the user must move files manually",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Application-Support-Verzeichnis von iTerm2 hat sich geändert.\n\nBisher wurden beide dieser Verzeichnisse unterstützt:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nJetzt wird nur noch die iTerm2-Version unterstützt. Da Sie jedoch Dateien in beiden haben, verschieben Sie bitte alles von iTerm nach iTerm2."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2's Application Support directory has changed.\n\nPreviously, both these directories were supported:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nNow, only the iTerm2 version is supported. But you have files in both so please move everything from iTerm to iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El directorio Application Support de iTerm2 ha cambiado.\n\nAntes se admitían estos dos directorios:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nAhora solo se admite la versión iTerm2. Pero tienes archivos en ambos, así que mueve todo de iTerm a iTerm2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le répertoire Application Support d’iTerm2 a changé.\n\nAuparavant, ces deux répertoires étaient pris en charge :\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nDésormais, seule la version iTerm2 est prise en charge. Mais vous avez des fichiers dans les deux, veuillez donc tout déplacer d’iTerm vers iTerm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La directory Application Support di iTerm2 è cambiata.\n\nPrima erano supportate entrambe queste directory:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nOra è supportata solo la versione iTerm2. Ma hai file in entrambe, quindi sposta tutto da iTerm a iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2のApplication Supportディレクトリが変更されました。\n\n以前は次の両方のディレクトリがサポートされていました。\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\n現在はiTerm2の方のみがサポートされています。ただし両方にファイルがあるため、iTermからiTerm2へすべて移動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2의 Application Support 디렉토리가 변경되었습니다.\n\n이전에는 다음 두 디렉토리가 모두 지원되었습니다.\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\n이제는 iTerm2 디렉토리만 지원됩니다. 그런데 두 곳 모두에 파일이 있으므로 iTerm에 있는 모든 항목을 iTerm2로 옮기십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O diretório Application Support do iTerm2 foi alterado.\n\nAnteriormente, estes dois diretórios eram compatíveis:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nAgora, apenas a versão iTerm2 é compatível. Mas você tem arquivos em ambos, então mova tudo de iTerm para iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог Application Support для iTerm2 изменился.\n\nРанее поддерживались оба этих каталога:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nТеперь поддерживается только версия для iTerm2. Но у вас есть файлы в обоих каталогах, поэтому, пожалуйста, перенесите всё из iTerm в iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin Application Support dizini değişti.\n\nÖnceden şu iki dizin de destekleniyordu:\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2.\n\nArtık yalnızca iTerm2 sürümü destekleniyor. Ancak ikisinde de dosyalarınız var; lütfen her şeyi iTerm’den iTerm2’ye taşıyın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Application Support 目录已更改。\n\n以前，以下两个目录均受支持：\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2。\n\n现在仅支持 iTerm2 版本。但两个目录中都有你的文件，因此请将所有文件从 iTerm 移到 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 的 Application Support 目錄已變更。\n\n先前支援以下兩個目錄：\n~/Library/Application Support/iTerm\n~/Library/Application Support/iTerm2。\n\n現在僅支援 iTerm2 版本。但你兩個目錄中都有檔案，請將 iTerm 中的所有內容移至 iTerm2。"
          }
        }
      }
    },
