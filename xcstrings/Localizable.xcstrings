    "LocalePrompt.Message" : {
      "comment" : "Explanation shown when no valid UNIX locale exists for the user’s language and country",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die aktuelle Sprache und das Land Ihres Computers existiert kein gültiges UNIX-Gebietsschema. Dies kann dazu führen, dass Kommandozeilen-Apps sich fehlerhaft verhalten. Bitte wählen Sie eines aus der folgenden Liste aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No valid UNIX locale exists for your computer’s current language and country. This may cause command-line apps to misbehave. Please select one from the list below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No existe ninguna configuración regional UNIX válida para el idioma y el país actuales de tu Mac. Esto puede hacer que las apps de línea de comandos se comporten mal. Selecciona uno de la lista siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe aucun paramètre régional UNIX valide pour la langue et le pays actuels de votre ordinateur. Cela peut perturber le fonctionnement des apps en ligne de commande. Veuillez en choisir un dans la liste ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esistono impostazioni locali UNIX valide per la lingua e il paese attuali del computer. Questo potrebbe causare malfunzionamenti nelle app da riga di comando. Selezionane una dall’elenco qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのコンピュータの現在の言語と国に対応する有効なUNIXロケールが存在しません。これによりコマンドラインアプリが正しく動作しないことがあります。以下のリストから1つ選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 현재 언어 및 국가에 해당하는 유효한 UNIX 로케일이 없습니다. 이로 인해 명령줄 앱이 오작동할 수 있습니다. 아래 목록에서 하나를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe nenhum locale UNIX válido para o idioma e o país atuais do seu computador. Isso pode fazer com que apps de linha de comando se comportem mal. Selecione um na lista abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для текущего языка и страны вашего компьютера не существует допустимой локали UNIX. Это может привести к некорректной работе приложений командной строки. Выберите локаль из списка ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızın geçerli dili ve ülkesi için geçerli bir UNIX yerel ayarı yok. Bu, komut satırı uygulamalarının hatalı çalışmasına neden olabilir. Lütfen aşağıdaki listeden birini seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的电脑当前语言和国家/地区不存在有效的 UNIX locale。这可能导致命令行应用行为异常。请从下方列表中选择一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你電腦目前的語言與國家或地區沒有有效的 UNIX 語系。這可能導致命令列 App 運作異常。請從下方列表選擇一個。"
          }
        }
      }
    },
