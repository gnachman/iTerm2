    "Companion.SAS.Body" : {
      "comment" : "Explanatory paragraph on the SAS confirmation screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie den 6-stelligen Code ein, der auf Ihrem iPhone angezeigt wird. Damit wird bestätigt, dass Sie mit Ihrem eigenen Telefon koppeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type the 6-digit code shown on your iPhone. This confirms you’re pairing with your own phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el código de 6 dígitos que se muestra en tu iPhone. Esto confirma que estás emparejando con tu propio teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez le code à 6 chiffres affiché sur votre iPhone. Cela confirme que vous associez votre propre téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita il codice di 6 cifre mostrato sul tuo iPhone. Questo conferma che stai associando il tuo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneに表示されている6桁のコードを入力してください。これにより、自分自身のiPhoneとペアリングしていることが確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에 표시된 6자리 코드를 입력하십시오. 본인의 iPhone과 페어링하고 있는지 확인하는 절차입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o código de 6 dígitos exibido no seu iPhone. Isto confirma que você está pareando com o seu próprio telefone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите 6-значный код, показанный на вашем iPhone. Это подтверждает, что вы сопрягаетесь с собственным телефоном."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuzda gösterilen 6 haneli kodu yazın. Bu, kendi telefonunuzla eşleştirdiğinizi doğrular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入iPhone上显示的6位代码。这用于确认您正在与自己的手机配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入 iPhone 上顯示的 6 位數代碼。這可確認你正在與自己的手機配對。"
          }
        }
      }
    },
