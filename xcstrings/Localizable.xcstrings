    "Tip.0096.Body" : {
      "comment" : "Tip of the day body, id 0096",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazte velikost relace přímo v názvech panelů pro pohodlné informace na první pohled."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis sessionens størrelse direkte i fanetitler for praktisk information med et blik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie die Sitzungsgröße direkt im Tab-Titel an, um praktische Informationen auf einen Blick zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Display session size directly in tab titles for convenient at-a-glance information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el tamaño de la sesión directamente en los títulos de las pestañas para ver la información de un vistazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä istunnon koko suoraan välilehtien otsikoissa, jotta tieto on kätevästi yhdellä silmäyksellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez la taille de la session directement dans les titres d’onglet pour une information pratique en un coup d’œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le dimensioni della sessione direttamente nei titoli dei pannelli per avere le informazioni a colpo d’occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションサイズをタブタイトルに直接表示して、一目で情報を確認できるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 제목에 세션 크기를 바로 표시하여 한눈에 정보를 확인할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis øktstørrelsen direkte i fanetitlene for praktisk informasjon på et øyeblikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
