    "ScriptLauncher.IntelOnlyBase" : {
      "comment" : "Error explaining a script uses an Intel-only environment; %@ is the script name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verwendet eine reine Intel-Python-Umgebung, die auf dieser Version von macOS nicht ausgeführt werden kann, da Rosetta nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” uses an Intel-only Python environment, which cannot run on this version of macOS because Rosetta is not available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” usa un entorno de Python solo para Intel, que no se puede ejecutar en esta versión de macOS porque Rosetta no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » utilise un environnement Python réservé à Intel, qui ne peut pas s’exécuter sur cette version de macOS, car Rosetta n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” usa un ambiente Python solo per Intel, che non può essere eseguito su questa versione di macOS perché Rosetta non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はIntel専用のPython環境を使用していますが、Rosettaが利用できないため、このバージョンのmacOSでは実行できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) Intel 전용 Python 환경을 사용하며, Rosetta를 사용할 수 없으므로 이 버전의 macOS에서 실행할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” usa um ambiente Python somente para Intel, que não pode ser executado nesta versão do macOS porque o Rosetta não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» использует окружение Python только для Intel, которое не может работать в этой версии macOS, так как Rosetta недоступна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”, yalnızca Intel için bir Python ortamı kullanıyor; Rosetta kullanılamadığından bu ortam macOS’un bu sürümünde çalışamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”使用的是仅限 Intel 的 Python 环境，由于未安装 Rosetta，它无法在这版 macOS 上运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」使用僅限 Intel 的 Python 環境，由於無法使用 Rosetta，因此無法在此版本的 macOS 上執行。"
          }
        }
      }
    },
