    "Tip.0038.Body" : {
      "comment" : "Tip of the day body, id 0038",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 si pamatuje, které adresáře používáte nejčastěji na každém hostiteli s nainstalovanou integrací shellu. V pásu nástrojů je nástroj pro jejich procházení a ⌥⌘/ zobrazí vyskakovací okno seřazené podle četnosti a nedávnosti použití."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 husker, hvilke mapper du bruger mest på hver vært med shell-integration installeret. Der er et værktøj i værktøjsbæltet til at gennemse dem, og ⌥⌘/ giver dig en lokalmenu sorteret efter, hvor ofte og hvor for nylig de er brugt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 merkt sich, welche Verzeichnisse Sie auf jedem Host mit installierter Shell-Integration am häufigsten verwenden. Im Werkzeugkasten gibt es ein Werkzeug, um diese zu durchsuchen, und ⌥⌘/ zeigt ein Popup, das nach Häufigkeit und Aktualität der Nutzung sortiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 remembers which directories you use the most on each host that has Shell Integration installed. There’s a Toolbelt tool to browse them, and ⌥⌘/ gives you a popup sorted by frequency and recency of use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 recuerda qué directorios usas más en cada host que tiene instalada la integración con el shell. Hay una herramienta de la Caja de herramientas para explorarlos, y ⌥⌘/ muestra una ventana emergente ordenada por frecuencia y recencia de uso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 muistaa, mitä hakemistoja käytät eniten kullakin palvelimella, jolla komentotulkki-integraatio on asennettuna. Työkaluvyössä on niiden selaamiseen työkalu, ja ⌥⌘/ avaa ponnahdusikkunan, joka on lajiteltu käyttötiheyden ja -tuoreuden mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 mémorise les répertoires que vous utilisez le plus sur chaque hôte où l’intégration du shell est installée. Un outil de la boîte à outils permet de les parcourir, et ⌥⌘/ affiche une fenêtre contextuelle triée par fréquence et ancienneté d’utilisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ricorda quali directory usi di più su ogni host con l’integrazione shell installata. Esiste uno strumento della Cassetta attrezzi per esplorarle e ⌥⌘/ mostra un popup ordinato per frequenza e recenza d’uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、シェル統合をインストールした各ホストで、最もよく使うディレクトリを記憶します。それらを閲覧するツールがツールベルトにあり、⌥⌘/を押すと使用頻度と直近の使用状況で並べ替えられたポップアップが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 셸 통합이 설치된 각 호스트에서 가장 많이 사용하는 디렉토리를 기억합니다. 도구 벨트에 이를 탐색하는 도구가 있으며, ⌥⌘/를 누르면 사용 빈도와 최근 사용 순으로 정렬된 팝업이 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 husker hvilke mapper du bruker mest på hver vert som har skallintegrering installert. Det finnes et verktøy i Verktøybeltet for å bla gjennom dem, og ⌥⌘/ gir deg en hurtigmeny sortert etter hvor ofte og hvor nylig de er brukt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 onthoudt welke mappen je het meest gebruikt op elke host met shell-integratie. Er is een tool in de Gereedschapsriem om ze te doorbladeren, en ⌥⌘/ toont een pop-up gesorteerd op frequentie en recentheid van gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 zapamiętuje, których katalogów używasz najczęściej na każdym hoście z zainstalowaną integracją z powłoką. Narzędzie w pasie narzędzi pozwala je przeglądać, a ⌥⌘/ pokazuje wyskakujące okienko posortowane według częstotliwości i niedawności użycia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 lembra quais diretórios você mais usa em cada host que tem a Shell Integration instalada. Há uma ferramenta na Caixa de ferramentas para navegar por eles, e ⌥⌘/ abre um pop-up ordenado por frequência e recência de uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 запоминает, какие каталоги вы чаще всего используете на каждом хосте с установленной интеграцией с оболочкой. Для их просмотра есть инструмент на панели инструментов, а ⌥⌘/ открывает всплывающее окно, отсортированное по частоте и давности использования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 si pamätá, ktoré adresáre používate najčastejšie na každom hostiteľovi s nainštalovanou integráciou shellu. V Páse s nástrojmi je nástroj na ich prehliadanie a ⌥⌘/ zobrazí kontextové okno zoradené podľa frekvencie a nedávnosti použitia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 si zapomni, katere imenike največ uporabljate na vsakem gostitelju z nameščeno integracijo lupine. V Pasu z orodji je orodje za brskanje po njih, ⌥⌘/ pa prikaže pojavni seznam, razvrščen po pogostosti in nedavnosti uporabe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kommer ihåg vilka kataloger du använder mest på varje värd som har skalintegrering installerad. Det finns ett verktyg i verktygsbältet för att bläddra bland dem, och ⌥⌘/ ger dig en popup sorterad efter hur ofta och hur nyligen de använts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, Kabuk Entegrasyonu yüklü her ana makinede en çok kullandığınız dizinleri hatırlar. Bunlara göz atmak için bir Araç Kemeri aracı vardır; ⌥⌘/ ise kullanım sıklığına ve yakınlığına göre sıralanmış bir açılır pencere sunar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ghi nhớ thư mục bạn dùng nhiều nhất trên mỗi máy chủ có cài Tích hợp shell. Có một công cụ Đai công cụ để duyệt chúng, và ⌥⌘/ hiển thị một cửa sổ bật lên được sắp xếp theo tần suất và độ gần đây của việc sử dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 会记录安装了 Shell Integration 的每台主机上你最常使用的目录。Toolbelt 提供了一个工具用于浏览这些目录，同时 ⌥⌘/ 可弹出按使用频率和频率排序的列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 會記住在每個已安裝 Shell 整合的主機上你最常使用的目錄。工具帶中有一個可瀏覽這些目錄的工具，而 ⌥⌘/ 會顯示一個依使用頻率和最近使用時間排序的彈出視窗。"
          }
        }
      }
    },
