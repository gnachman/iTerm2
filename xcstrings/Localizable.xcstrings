    "Tip.0041.Body" : {
      "comment" : "Tip of the day body, id 0041",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkopírujte soubor do schránky ve Finderu a pak použijte „Úpravy > Vložit jinak > Vložit soubor zakódovaný v Base64“ pro snadné nahrávání binárních souborů. Na vzdáleném hostiteli ho dekódujete příkazem „base64 -D“ (nebo -d v Linuxu)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier et arkiv til udklipsholderen i Finder, og brug derefter “Rediger > Sæt ind specielt > Indsæt arkiv Base64-kodet” for nem overførsel af binære arkiver. Brug “base64 -D” (eller -d på Linux) på den eksterne vært til at afkode det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie im Finder eine Datei in die Zwischenablage und verwenden Sie dann „Bearbeiten > Spezielles Einfügen > Datei Base64-codiert einfügen“ für einen einfachen Upload von Binärdateien. Verwenden Sie auf dem entfernten Host „base64 -D“ (unter Linux „-d“), um sie zu decodieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy a file to the pasteboard in Finder and then use “Edit > Paste Special > Paste File Base64-Encoded” for easy uploads of binary files. Use ”base64 -D” (or -d on Linux) on the remote host to decode it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un archivo al portapapeles en Finder y luego usa “Edición > Pegado especial > Pegar archivo codificado en Base64” para subir fácilmente archivos binarios. Usa “base64 -D” (o -d en Linux) en el host remoto para decodificarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopioi tiedosto leikepöydälle Finderissa ja käytä sitten komentoa ”Muokkaa > Erikoissijoitus > Sijoita tiedosto Base64-koodattuna” binääritiedostojen helppoon lähetykseen. Pura koodaus etäpalvelimella komennolla ”base64 -D” (tai -d Linuxissa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez un fichier dans le presse-papiers depuis le Finder, puis utilisez « Édition > Collage spécial > Coller le fichier encodé en Base64 » pour téléverser facilement des fichiers binaires. Utilisez « base64 -D » (ou -d sous Linux) sur l’hôte distant pour le décoder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un file negli Appunti dal Finder e poi usa “Modifica > Incolla speciale > Incolla file codificato in Base64” per caricare facilmente file binari. Usa “base64 -D” (o -d su Linux) sull’host remoto per decodificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finderでファイルをコピーしてから、「編集 > 特殊なペースト > ファイルをBase64エンコードでペースト」を使うと、バイナリファイルを簡単にアップロードできます。リモートホストでは「base64 -D」(Linuxでは-d)を使ってデコードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에서 파일을 클립보드로 복사한 다음 “편집 > 특수 붙여넣기 > Base64로 인코딩된 파일 붙여넣기”를 사용하면 바이너리 파일을 쉽게 업로드할 수 있습니다. 원격 호스트에서 “base64 -D”(Linux에서는 -d)를 사용하여 디코딩하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier en fil til utklippstavlen i Finder, og bruk deretter «Rediger > Lim inn spesielt > Lim inn fil Base64-kodet» for enkel opplasting av binære filer. Bruk «base64 -D» (eller -d på Linux) på den eksterne verten for å dekode den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer een bestand naar het klembord in Finder en gebruik dan ‘Wijzig > Plak speciaal > Plak bestand als Base64-gecodeerd’ om eenvoudig binaire bestanden te uploaden. Gebruik ‘base64 -D’ (of -d op Linux) op de externe host om het te decoderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj plik do schowka w Finderze, a następnie użyj „Edycja > Wklej specjalnie > Wklej plik zakodowany w Base64”, aby łatwo wysyłać pliki binarne. Użyj „base64 -D” (lub -d w Linuksie) na zdalnym hoście, aby go zdekodować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie um arquivo para a área de transferência no Finder e use “Editar > Colar especial > Colar arquivo codificado em Base64” para enviar arquivos binários com facilidade. Use “base64 -D” (ou -d no Linux) no host remoto para decodificá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте файл в буфер обмена в Finder, а затем используйте «Правка > Специальная вставка > Вставить файл в кодировке Base64» для удобной отправки бинарных файлов. Используйте «base64 -D» (или -d в Linux) на удалённом хосте, чтобы декодировать его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopírujte súbor do schránky vo Finderi a potom použite položku „Upraviť > Vložiť špeciálne > Vložiť súbor kódovaný v Base64“ na jednoduché odosielanie binárnych súborov. Na vzdialenom hostiteľovi ho dekódujete príkazom „base64 -D“ (alebo -d v Linuxe)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikaciji Finder kopirajte datoteko v odložišče, nato uporabite »Uredi > Posebno lepljenje > Prilepi datoteko, kodirano z Base64« za enostavno nalaganje binarnih datotek. Na oddaljenem gostitelju jo dekodirajte z »base64 -D« (v Linuxu -d)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiera en fil till urklipp i Finder och använd sedan ”Redigera > Klistra in special > Klistra in fil Base64-kodad” för enkel överföring av binärfiler. Använd ”base64 -D” (eller -d på Linux) på fjärrvärden för att avkoda den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder’da bir dosyayı panoya kopyalayın, ardından ikili dosyaları kolayca yüklemek için “Düzen > Özel Yapıştır > Dosyayı Base64 Kodlu Yapıştır”ı kullanın. Kodunu çözmek için uzak ana makinede “base64 -D” (Linux’ta -d) kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép một tệp vào bảng nhớ tạm trong Finder rồi dùng “Sửa > Dán đặc biệt > Dán tệp mã hóa Base64” để tải lên các tệp nhị phân dễ dàng. Dùng “base64 -D” (hoặc -d trên Linux) trên máy chủ từ xa để giải mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Finder 中将文件复制到“pasteboard”，然后使用“编辑 > 粘贴特殊 > 粘贴 Base64 编码的文件”来轻松上传二进制文件。在远程主机上使用“base64 -D”（或 Linux 下的 -d）进行解码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Finder 中將檔案拷貝到剪貼簿，然後使用「編輯 > 特殊貼上 > 以 Base64 編碼貼上檔案」，即可輕鬆上傳二進位檔案。在遠端主機上使用 `base64 -D`（Linux 上為 -d）解碼。"
          }
        }
      }
    },
