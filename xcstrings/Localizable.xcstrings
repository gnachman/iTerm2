    "CrashReporter.FeedbackExplanation" : {
      "comment" : "Explanatory text at the top of the feedback window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níže zadejte svou zprávu. Pokud hlásíte chybu, uveďte informace o svém Macu a verzi operačního systému a seznam kroků, jak problém reprodukovat.\n\nUveďte také svou e-mailovou adresu, jinak vám nebudeme moci odpovědět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv din besked nedenfor. Hvis du rapporterer en fejl, bedes du oplyse om din Mac og din version af operativsystemet samt en liste over trin, der kan hjælpe med at genskabe problemet.\n\nHusk at angive din e-mailadresse, ellers kan vi ikke svare dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie unten Ihre Nachricht ein. Wenn Sie einen Fehler melden, geben Sie bitte Informationen zu Ihrem Mac und der Betriebssystemversion sowie eine Liste von Schritten an, mit denen sich das Problem reproduzieren lässt.\n\nGeben Sie unbedingt Ihre E-Mail-Adresse an, sonst können wir uns nicht bei Ihnen melden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enter your message below. If you are reporting a bug, please include information about your Mac and operating system version and a list of steps to help reproduce the problem.\n\nBe sure to include your email address or we won’t be able to get back to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe tu mensaje a continuación. Si informas de un error, incluye información sobre tu Mac y la versión del sistema operativo, así como una lista de pasos para reproducir el problema.\n\nIncluye tu dirección de correo electrónico o no podremos responderte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita viestisi alle. Jos ilmoitat virheestä, liitä mukaan tiedot Macistasi ja macOS-versiosta sekä luettelo vaiheista, joilla ongelma saadaan toistumaan.\n\nMuista antaa sähköpostiosoitteesi, muuten emme voi vastata sinulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre message ci-dessous. Si vous signalez un bogue, indiquez des informations sur votre Mac et la version de votre système d’exploitation, ainsi qu’une liste d’étapes pour reproduire le problème.\n\nN’oubliez pas d’indiquer votre adresse e-mail, sans quoi nous ne pourrons pas vous répondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi il tuo messaggio qui sotto. Se segnali un bug, includi informazioni sul tuo Mac e sulla versione del sistema operativo, insieme a un elenco di passaggi per riprodurre il problema.\n\nRicordati di indicare il tuo indirizzo email, altrimenti non potremo risponderti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下にメッセージを入力してください。バグを報告する場合は、Macとオペレーティングシステムのバージョンに関する情報、および問題を再現する手順を含めてください。\n\nメールアドレスを必ず記載してください。記載がないと返信できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 메시지를 입력하십시오. 버그를 보고하는 경우 Mac 및 운영 체제 버전에 관한 정보와 문제를 재현하는 단계 목록을 포함하십시오.\n\n이메일 주소를 반드시 포함하십시오. 그렇지 않으면 회신할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv meldingen din nedenfor. Hvis du melder fra om en feil, ta med informasjon om Mac-en og macOS-versjonen din og en liste over trinn for å gjenskape problemet.\n\nHusk å oppgi e-postadressen din, ellers kan vi ikke svare deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer hieronder je bericht in. Als je een bug meldt, vermeld dan informatie over je Mac en de versie van het besturingssysteem, plus een lijst met stappen om het probleem te reproduceren.\n\nVermeld ook je e-mailadres, anders kunnen we je niet antwoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz swoją wiadomość poniżej. Jeśli zgłaszasz błąd, podaj informacje o swoim komputerze Mac i wersji systemu operacyjnego oraz listę kroków potrzebnych do odtworzenia problemu.\n\nPodaj swój adres e-mail, bo inaczej nie będziemy mogli ci odpowiedzieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite sua mensagem abaixo. Se estiver relatando um bug, inclua informações sobre o seu Mac e a versão do sistema operacional, além de uma lista de passos para ajudar a reproduzir o problema.\n\nInclua seu endereço de email; caso contrário, não poderemos responder a você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите сообщение ниже. Если вы сообщаете об ошибке, укажите сведения о вашем Mac и версии операционной системы, а также шаги для воспроизведения проблемы.\n\nОбязательно укажите адрес электронной почты, иначе мы не сможем с вами связаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nižšie zadajte svoju správu. Ak hlásite chybu, uveďte informácie o svojom Macu a verzii operačného systému a zoznam krokov na reprodukciu problému.\n\nNezabudnite uviesť svoju e-mailovú adresu, inak vám nebudeme môcť odpovedať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spodaj vnesite svoje sporočilo. Če poročate o napaki, navedite podatke o svojem računalniku Mac in različici operacijskega sistema ter seznam korakov za ponovitev težave.\n\nObvezno navedite svoj e-poštni naslov, sicer vam ne bomo mogli odgovoriti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ditt meddelande nedan. Om du rapporterar ett fel bör du ta med information om din Mac och version av operativsystemet samt en lista med steg för att återskapa problemet.\n\nSe till att ange din e-postadress, annars kan vi inte svara dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajınızı aşağıya yazın. Bir hata bildiriyorsanız lütfen Mac’iniz ve işletim sistemi sürümünüz hakkında bilgi ile sorunu yeniden oluşturmaya yardımcı olacak adımların listesini ekleyin.\n\nE-posta adresinizi eklemeyi unutmayın, aksi hâlde size geri dönemeyiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập tin nhắn của bạn bên dưới. Nếu bạn báo lỗi, vui lòng kèm thông tin về Mac, phiên bản hệ điều hành và danh sách các bước để tái hiện sự cố.\n\nHãy nhớ ghi địa chỉ email của bạn, nếu không chúng tôi sẽ không thể phản hồi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在下方输入您的消息。如果您正在报告错误，请包含有关您的Mac和操作系统版本的信息以及有助于重现问题的步骤列表。\n\n务必包含您的电子邮件地址，否则我们将无法回复您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在下方輸入你的訊息。如果你要回報錯誤，請附上你的 Mac 與作業系統版本資訊，以及重現問題的步驟清單。\n\n請務必附上你的電子郵件地址，否則我們將無法回覆你。"
          }
        }
      }
    },
    "CrashReporter.FeedbackMessageTemplate" : {
      "comment" : "Prefilled body of the feedback message. {USERNAME} and {EMAIL} are replaced with the user’s full name and email address; keep those tokens verbatim.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobrý den, vývojáři iTerm2,\n\nchci vám sdělit toto:\n\n\t...\n\n-- {USERNAME}\n\nOdpovězte mi na {EMAIL}"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej iTerm2-udviklere,\n\nher er, hvad jeg gerne vil fortælle jer:\n\n\t...\n\n-- {USERNAME}\n\nSvar mig på {EMAIL}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo iTerm2-Entwickler,\n\nhier ist, was ich euch mitteilen möchte:\n\n\t...\n\n-- {USERNAME}\n\nAntworten Sie mir unter {EMAIL}"
          }
        },
        "en" : {
          "stringUnit" : {
