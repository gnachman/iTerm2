    "APIScriptLauncher.MigrationFallback" : {
      "comment" : "Script Console diagnostic when migrating a script to the uv Python runtime fails and it falls back to the old runtime; %1$@ is the script name and %2$@ is the error",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript „%1$@“ se nepodařilo migrovat na běhové prostředí Pythonu uv (%2$@). Místo toho byl spuštěn na stávajícím běhovém prostředí.\n"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
