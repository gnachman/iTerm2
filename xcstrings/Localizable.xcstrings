    "Tip.0085.Body" : {
      "comment" : "Tip of the day body, id 0085",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generujte příkazy pomocí AI zadáním promptu v editoru příkazů a výběrem „Úpravy > Zapojit umělou inteligenci“. Tato funkce vyžaduje API klíč OpenAI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generer kommandoer med AI ved at skrive en prompt i kommandoeditoren og vælge “Rediger > Aktiver kunstig intelligens”. Til denne funktion kræves en OpenAI API-nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugen Sie Befehle mithilfe von KI, indem Sie im Composer eine Eingabeaufforderung eingeben und „Bearbeiten > Künstliche Intelligenz aktivieren“ wählen. Für diese Funktion ist ein OpenAI-API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Generate commands using AI by entering a prompt in the composer and selecting “Edit > Engage Artificial Intelligence”. An OpenAI API key is required for this functionality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera comandos con IA escribiendo un prompt en el compositor y seleccionando “Edición > Activar inteligencia artificial”. Esta función requiere una clave de API de OpenAI."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo komentoja tekoälyllä kirjoittamalla kehote komentoeditoriin ja valitsemalla ”Muokkaa > Ota tekoäly käyttöön”. Tämä toiminto vaatii OpenAI API -avaimen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Générez des commandes avec l’IA en saisissant un prompt dans le compositeur et en choisissant « Édition > Activer l’intelligence artificielle ». Une clé d’API OpenAI est requise pour cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genera comandi con l’IA inserendo un prompt nel compositore e selezionando “Modifica > Attiva l’intelligenza artificiale”. Per questa funzione è necessaria una chiave API di OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンポーザーにプロンプトを入力して「編集 > 人工知能を利用する」を選択すると、AIを使ってコマンドを生成できます。この機能を使うにはOpenAI APIキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴포저에 프롬프트를 입력하고 “편집 > 인공지능 사용”을 선택하면 AI로 명령을 생성할 수 있습니다. 이 기능을 사용하려면 OpenAI API 키가 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generer kommandoer med KI ved å skrive inn en prompt i kommandoskriveren og velge «Rediger > Aktiver kunstig intelligens». Det kreves en OpenAI API-nøkkel for denne funksjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genereer commando’s met AI door een prompt in de opsteller in te voeren en ‘Wijzig > Activeer kunstmatige intelligentie’ te kiezen. Hiervoor is een OpenAI-API-sleutel nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generuj polecenia za pomocą AI, wpisując prompt w edytorze poleceń i wybierając „Edycja > Włącz sztuczną inteligencję”. Ta funkcja wymaga klucza API OpenAI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gere comandos usando IA digitando um prompt no compositor e selecionando “Edit > Engage Artificial Intelligence”. Uma chave de API da OpenAI é necessária para essa funcionalidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте команды с помощью ИИ, введя запрос в Композере и выбрав «Правка > Задействовать искусственный интеллект». Для этой функции требуется ключ API OpenAI."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generujte príkazy pomocou AI zadaním promptu v editore príkazov a výberom položky „Upraviť > Zapojiť umelú inteligenciu“. Táto funkcia vyžaduje API kľúč OpenAI."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukaze ustvarjajte z AI tako, da v urejevalniku ukazov vnesete poziv in izberete »Uredi > Vključi umetno inteligenco«. Za to funkcijo je potreben ključ API OpenAI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generera kommandon med AI genom att skriva en prompt i kommandoredigeraren och välja ”Redigera > Aktivera artificiell intelligens”. Den här funktionen kräver en OpenAI API-nyckel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oluşturucu’ya bir istem girip “Düzen > Yapay Zekâyı Devreye Sok”u seçerek YZ ile komut oluşturun. Bu işlev için bir OpenAI API anahtarı gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo lệnh bằng AI bằng cách nhập lời nhắc trong trình soạn lệnh và chọn “Sửa > Kích hoạt trí tuệ nhân tạo”. Tính năng này cần có khóa API OpenAI."
          }
