    "Tip.0027.Body" : {
      "comment" : "Tip of the day body, id 0027",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona v Docku zobrazuje počet zvonění a oznámení od posledního aktivního stavu aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock-symbolet viser antallet af klokkesignaler og notifikationer, der er kommet, siden appen sidst var aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dock-Symbol zeigt die Anzahl der Signaltöne und Benachrichtigungen an, die seit der letzten Aktivität der App aufgetreten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The dock icon shows a count of the number of bells rung and notifications posted since the app was last active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono del Dock muestra el número de campanas sonadas y notificaciones publicadas desde la última vez que la app estuvo activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockin kuvake näyttää äänimerkkien ja ilmoitusten määrän, jotka ovat tulleet sovelluksen viimeisen aktiivisuuden jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icône du Dock affiche le nombre de sonneries émises et de notifications publiées depuis la dernière activité de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icona nel Dock mostra il numero di campanelli suonati e di notifiche pubblicate dall’ultima volta che l’app è stata attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockアイコンには、アプリが最後にアクティブだった時から鳴ったベルの回数と、投稿された通知の数が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock 아이콘에 앱이 마지막으로 활성화된 이후 울린 벨과 게시된 알림의 개수가 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock-symbolet viser antall bjeller som har ringt og varslinger som er sendt siden appen sist var aktiv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Dock-symbool toont het aantal keren dat de bel is afgegaan en het aantal meldingen dat is geplaatst sinds de app voor het laatst actief was."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona w Docku pokazuje liczbę dzwonków i powiadomień od czasu, gdy aplikacja była ostatnio aktywna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ícone no Dock mostra a contagem de campainhas tocadas e notificações publicadas desde a última vez que o app esteve ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок в доке показывает количество поданных звуковых сигналов и полученных уведомлений с момента последней активности приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona v Docku zobrazuje počet zvončekov a hlásení od poslednej aktivity apky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona v Docku prikazuje število zvoncev in obvestil od zadnje aktivnosti aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock-symbolen visar antalet ljudsignaler och notiser som skickats sedan appen senast var aktiv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock simgesi, uygulama en son etkin olduğundan beri çalan zil sayısını ve gönderilen bildirimlerin sayısını gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biểu tượng Dock hiển thị số lần chuông đã kêu và thông báo đã đăng kể từ lần cuối ứng dụng hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "栏架图标会显示自上次应用运行时已发出的铃声次数和通知数量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock 圖像會顯示自 App 上次處於使用中以來，響鈴次數和已發出通知的數量。"
          }
        }
      }
    },
