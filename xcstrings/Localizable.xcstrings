    "NaggingController.JSONPromotion" : {
      "comment" : "Announcement offering to pretty-print a JSON selection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je ale pěkně nepřehledný JSON! iTerm2 může tento těžko čitelný výběr nahradit formátovaným JSON."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er en broget JSON-klump, du har der! iTerm2 kan erstatte denne sværlæselige markering med en formateret version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist aber ein ganz schön unübersichtlicher JSON-Blob! iTerm2 kann diese schwer lesbare Auswahl durch eine hübsch formatierte Version ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
