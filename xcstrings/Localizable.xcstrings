    "ScriptArchive.TrustedAutoLaunchMessage" : {
      "comment" : "Prompt asking whether to allow a trusted script to auto-launch; %@ is the script name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript „%@“ se chce automaticky spustit při spuštění iTerm2. Chcete to povolit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” vil gerne starte automatisk, når iTerm2 starter. Vil du tillade det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ möchte automatisch gestartet werden, wenn iTerm2 startet. Möchten Sie das zulassen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” would like to launch automatically when iTerm2 starts. Would you like to allow that?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” quiere iniciarse automáticamente cuando se abra iTerm2. ¿Quieres permitirlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” haluaa käynnistyä automaattisesti, kun iTerm2 käynnistyy. Haluatko sallia sen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » souhaite se lancer automatiquement au démarrage d’iTerm2. Voulez-vous l’autoriser ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” vorrebbe avviarsi automaticamente all’avvio di iTerm2. Vuoi consentirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はiTerm2の起動時に自動的に起動しようとしています。許可しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) iTerm2가 시작될 때 자동으로 실행되려고 합니다. 허용하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» vil starte automatisk når iTerm2 starter. Vil du tillate det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ wil automatisch starten wanneer iTerm2 wordt geopend. Wil je dat toestaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrypt „%@” chce uruchamiać się automatycznie po uruchomieniu iTerm2. Czy chcesz na to pozwolić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gostaria de iniciar automaticamente quando o iTerm2 é aberto. Deseja permitir isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» хочет запускаться автоматически при запуске iTerm2. Разрешить это?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript „%@“ sa chce automaticky spustiť pri spustení iTerm2. Chcete to povoliť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript »%@« se želi samodejno zagnati ob zagonu aplikacije iTerm2. Ali želite to dovoliti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” vill startas automatiskt när iTerm2 startar. Vill du tillåta det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”, iTerm2 başlatıldığında otomatik olarak başlamak istiyor. Buna izin vermek istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” muốn tự động khởi chạy khi iTerm2 khởi động. Bạn có muốn cho phép không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”想要在 iTerm2 启动时自动运行。允许吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」想要在 iTerm2 啟動時自動啟動。要允許嗎？"
          }
        }
      }
