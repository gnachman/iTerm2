    "Tip.0026.Body" : {
      "comment" : "Tip of the day body, id 0026",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit installierter Shell-Integration können Sie die Ausgabe des letzten Befehls mit ⇧⌘A auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With Shell Integration installed, you can select the output of the last command with ⇧⌘A."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合をインストールしていれば、⇧⌘Aで直前のコマンドの出力を選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 설치되어 있으면 ⇧⌘A로 마지막 명령의 출력을 선택할 수 있습니다."
