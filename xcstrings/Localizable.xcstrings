    "KeysPreferences.HotkeyPanelExplanation" : {
      "comment" : "Explanation shown in the hotkey window configuration panel",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Bedienfeld hilft Ihnen, ein neues Profil zu konfigurieren, das an eine von Ihnen zugewiesene Tastenkombination gebunden wird. Das Drücken des Hotkeys (auch wenn iTerm2 nicht aktiv ist) schaltet ein spezielles Fenster um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This panel helps you configure a new profile that will be bound to a keystroke you assign. Pressing the hotkey (even when iTerm2 is not active) will toggle a special window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este panel te ayuda a configurar un nuevo perfil que se asociará a una combinación de teclas que asignes. Al pulsar la tecla rápida (incluso cuando iTerm2 no está activo) se mostrará u ocultará una ventana especial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce panneau vous aide à configurer un nouveau profil qui sera associé à une combinaison de touches que vous choisirez. Appuyer sur le raccourci global (même quand iTerm2 n’est pas actif) affichera ou masquera une fenêtre spéciale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo pannello ti aiuta a configurare un nuovo profilo che sarà associato a una combinazione di tasti che assegni. Premendo l’abbreviazione globale (anche quando iTerm2 non è attivo) verrà mostrata o nascosta una finestra speciale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパネルでは、割り当てたキーストロークにバインドされる新しいプロファイルを設定できます。ホットキーを押すと（iTerm2がアクティブでない場合でも）、特別なウインドウが表示または非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패널에서는 사용자가 지정한 키 입력에 연결될 새로운 프로파일을 구성할 수 있습니다. 단축키를 누르면(iTerm2가 활성 상태가 아닐 때도) 특수 윈도우가 열리거나 닫힙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este painel ajuda você a configurar um novo perfil que será associado a uma tecla que você atribuir. Pressionar a hotkey (mesmo quando o iTerm2 não está ativo) alternará uma janela especial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта панель помогает настроить новый профиль, который будет привязан к назначенному вами сочетанию клавиш. Нажатие горячей клавиши (даже если iTerm2 неактивен) переключает специальное окно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu panel, atadığınız bir tuş kombinasyonuna bağlanacak yeni bir profil yapılandırmanıza yardımcı olur. Kısayol tuşuna basmak (iTerm2 etkin olmasa bile) özel bir pencereyi açıp kapatır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板可帮助你配置一个绑定到你指定的按键的新配置文件。按下热键（即使 iTerm2 未处于活跃状态）将切换一个特殊窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板可協助你設定一個綁定至你所指定按鍵的新描述檔。按下全域快速鍵（即使 iTerm2 不是使用中的 App）會切換一個特殊視窗。"
          }
        }
      }
    },
