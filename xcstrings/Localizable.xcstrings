    "AdvancedSetting.neverWarnAboutOverrides" : {
      "comment" : "Advanced setting: neverWarnAboutOverrides",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
