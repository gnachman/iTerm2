      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordern, dass die Wahltaste (Option) gedrückt wird, um einen Split-Bereich an seiner Titelleiste zu ziehen?\nDies hilft, versehentliches Ziehen zu verhindern."
          }
