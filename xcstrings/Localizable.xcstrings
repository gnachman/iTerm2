    "Tip.0042.Body" : {
      "comment" : "Tip of the day body, id 0042",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können einen Tab mit ⌘D und ⇧⌘D in mehrere Bereiche aufteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can split a tab into multiple panes with ⌘D and ⇧⌘D."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dividir una pestaña en varios paneles con ⌘D y ⇧⌘D."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez scinder un onglet en plusieurs volets avec ⌘D et ⇧⌘D."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi dividere un pannello in più riquadri con ⌘D e ⇧⌘D."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Dと⇧⌘Dを使うと、タブを複数のペインに分割できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘D 및 ⇧⌘D로 탭을 여러 패널로 분할할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode dividir uma aba em vários painéis com ⌘D e ⇧⌘D."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете разделить вкладку на несколько панелей с помощью ⌘D и ⇧⌘D."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sekmeyi ⌘D ve ⇧⌘D ile birden çok bölmeye bölebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以使用 ⌘D 和 ⇧⌘D 将标签页拆分为多个窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以使用 ⌘D 和 ⇧⌘D 將標籤頁分割成多個窗格。"
          }
        }
      }
    },
