        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session actuelle est une session tmux. Voulez-vous créer un nouvel onglet tmux ou utiliser le profil par défaut ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione corrente è una sessione tmux. Vuoi creare un nuovo pannello tmux o usare il profilo predefinito?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
