    "Tip.0054.Body" : {
      "comment" : "Tip of the day body, id 0054",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „Einstellungen > Tasten“ können Sie mit der Aktion „Regulären Ausdruck suchen…“ einem Tastendruck eine Suche nach einem regulären Ausdruck zuweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In “Settings > Keys” you can assign a keystroke to a search for a regular expression with the “Find Regular Expression…” action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En “Ajustes > Teclas” puedes asignar una combinación de teclas a una búsqueda de expresión regular con la acción “Buscar expresión regular…”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans « Réglages > Touches », vous pouvez associer un raccourci à une recherche d’expression régulière avec l’action « Rechercher une expression régulière… »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In “Impostazioni > Tasti” puoi assegnare una combinazione di tasti a una ricerca di espressione regolare con l’azione “Trova espressione regolare…”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > キー」では、「正規表現を検索…」アクションを使って、正規表現の検索にキー操作を割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 키”에서 “정규 표현식 찾기…” 동작으로 정규 표현식 검색에 키 입력을 지정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em “Ajustes > Teclas” você pode atribuir um atalho de teclado a uma busca por expressão regular com a ação “Buscar expressão regular…”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «Настройки > Клавиши» можно назначить сочетание клавиш для поиска по регулярному выражению с помощью действия «Найти регулярное выражение…»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ayarlar > Tuşlar” bölümünde “Düzenli İfade Bul…” eylemiyle bir düzenli ifade aramasına tuş vuruşu atayabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 按键”中，可以通过“查找正则表达式…”功能将按键与正则表达式搜索关联起来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 按鍵」中，你可以使用「尋找正規表示式…」動作，為搜尋某個正規表示式指定一組按鍵。"
          }
        }
      }
    },
