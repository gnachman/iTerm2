    "Codecierge.GoalPrompt" : {
      "comment" : "Prompt asking the user what they are trying to do",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co se pokoušíte udělat? Navrhnu příkazy a vysvětlím jejich výstup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad vil du gøre? Jeg foreslår kommandoer og forklarer deres output."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchten Sie tun? Ich schlage Befehle vor und erkläre ihre Ausgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What are you trying to do? I'll suggest commands and explain their output."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué intentas hacer? Te sugeriré comandos y explicaré su salida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä yrität tehdä? Ehdotan komentoja ja selitän niiden tulosteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que cherchez-vous à faire ? Je vous suggérerai des commandes et j’expliquerai leur sortie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che cosa stai cercando di fare? Ti suggerirò comandi e spiegherò il loro output."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何をしようとしていますか？コマンドを提案し、その出力を説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇을 하려고 하십니까? 명령을 제안하고 그 출력을 설명해 드리겠습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva prøver du å gjøre? Jeg foreslår kommandoer og forklarer utdataene deres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat probeer je te doen? Ik stel commando’s voor en leg de uitvoer uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co chcesz zrobić? Zaproponuję polecenia i wyjaśnię ich dane wyjściowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você está tentando fazer? Vou sugerir comandos e explicar sua saída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы пытаетесь сделать? Я предложу команды и объясню их вывод."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čo sa snažíte urobiť? Navrhnem príkazy a vysvetlím ich výstup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaj poskušate narediti? Predlagal bom ukaze in razložil njihov izpis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad försöker du göra? Jag föreslår kommandon och förklarar deras utdata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne yapmaya çalışıyorsunuz? Komutlar önereceğim ve çıktılarını açıklayacağım."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đang cố làm gì? Tôi sẽ gợi ý các lệnh và giải thích đầu ra của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想做什么？我会建议命令并解释其输出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想做什麼？我會建議指令並說明其輸出。"
          }
        }
      }
    },
