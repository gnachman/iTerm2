    "Tip.0019.Body" : {
      "comment" : "Tip of the day body, id 0019",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno terminálu můžete otevřít klávesovou zkratkou, i když používáte jiné aplikace. Klikněte na „Vytvořit vyhrazené okno horké klávesy“ v „Nastavení > Klávesy“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan åbne et terminalvindue med et tastetryk, selv når du er i andre apps. Klik på “Opret et dedikeret genvejstastvindue” i “Indstillinger > Taster”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können ein Terminalfenster per Tastendruck öffnen, selbst wenn Sie sich in einer anderen App befinden. Klicken Sie auf „Eigenes Hotkey-Fenster erstellen“ unter „Einstellungen > Tasten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can have a terminal window open with a keystroke, even while in other apps. Click “Create a Dedicated Hotkey Window” in “Settings > Keys.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes abrir una ventana de terminal con una combinación de teclas, incluso desde otras apps. Haz clic en “Crear una ventana de tecla rápida dedicada” en “Ajustes > Teclas”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit avata päätteen ikkunan näppäinyhdistelmällä, vaikka olisit toisessa sovelluksessa. Klikkaa ”Luo oma pikanäppäinikkuna” kohdassa ”Asetukset > Näppäimet”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ouvrir une fenêtre de terminal d’une simple frappe, même depuis d’autres apps. Cliquez sur « Créer une fenêtre à raccourci global dédiée » dans « Réglages > Touches »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aprire una finestra del terminale con una combinazione di tasti, anche mentre usi altre app. Fai clic su “Crea una finestra dedicata ad abbreviazione globale” in “Impostazioni > Tasti”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のアプリを使用中でも、キー操作1つでターミナルウィンドウを開けます。「設定 > キー」で「専用ホットキーウィンドウを作成」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱을 사용하는 중에도 키 입력 한 번으로 터미널 윈도우를 열 수 있습니다. “설정 > 키”에서 “전용 단축키 윈도우 생성”을 클릭하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan få opp et terminalvindu med et tastetrykk, selv mens du er i andre apper. Klikk på «Opprett et dedikert hurtigtastvindu» i «Innstillinger > Taster»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een terminalvenster met een toetsaanslag openen, zelfs vanuit andere apps. Klik op ‘Maak een speciaal sneltoetsvenster’ in ‘Instellingen > Toetsen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno terminala możesz otwierać skrótem klawiszowym, nawet gdy działasz w innych aplikacjach. Kliknij „Utwórz dedykowane okno klawisza skrótu” w „Ustawienia > Klawisze”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode abrir uma janela de terminal com um atalho de teclado, mesmo em outros apps. Clique em “Criar uma janela de tecla de atalho dedicada” em “Ajustes > Teclas”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете открывать окно терминала одним нажатием клавиши, даже находясь в других приложениях. Нажмите «Создать выделенное окно горячих клавиш» в «Настройки > Клавиши»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno terminálu môžete otvoriť stlačením klávesu, aj keď ste v iných apkách. Kliknite na „Vytvoriť vyhradené okno aktivačnej skratky“ v časti „Nastavenia > Klávesy“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminalsko okno lahko odprete s pritiskom tipk, tudi iz drugih aplikacij. Kliknite »Ustvari namensko okno hitre tipke« v »Nastavitve > Tipke«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan öppna ett terminalfönster med en tangenttryckning, även när du är i andra appar. Klicka på ”Skapa ett dedikerat snabbtangentsfönster” i ”Inställningar > Tangenter”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka uygulamalardayken bile bir tuş vuruşuyla terminal penceresi açabilirsiniz. “Ayarlar > Tuşlar” bölümünde “Özel Kısayol Tuşu Penceresi Oluştur”a tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể mở một cửa sổ terminal chỉ bằng một tổ hợp phím, kể cả khi đang ở trong ứng dụng khác. Bấm “Tạo cửa sổ phím nóng riêng” trong “Cài đặt > Phím.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在其他应用程序中，也可以通过按键操作打开终端窗口。在“设置 > 快捷键”中点击“创建专用快捷键窗口”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在其他 App 中，你也可以用一個按鍵組合打開終端機視窗。在「設定 > 按鍵」中按一下「建立專用全域快速鍵視窗」。"
          }
        }
      }
    },
