          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動游標"
          }
        }
      }
    },
    "Tip.0045.Body" : {
      "comment" : "Tip of the day body, id 0045",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihrem Profil unter „Einstellungen > Profile > Fenster“ mitteilen, dass es Fenster erzeugen soll, die an einem Bildschirmrand andocken. Sie können deren Größe durch Ziehen der Ränder ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can tell your profile to create windows that are attached to one edge of the screen in “Settings > Profiles > Window.” You can resize them by dragging the edges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes indicar a tu perfil que cree ventanas ancladas a un borde de la pantalla en “Ajustes > Perfiles > Ventana”. Puedes cambiar su tamaño arrastrando los bordes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez indiquer à votre profil de créer des fenêtres fixées à un bord de l’écran dans « Réglages > Profils > Fenêtre ». Vous pouvez les redimensionner en faisant glisser les bords."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi indicare al tuo profilo di creare finestre agganciate a un bordo dello schermo in “Impostazioni > Profili > Finestra”. Puoi ridimensionarle trascinando i bordi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > ウィンドウ」で、画面の端に固定されたウィンドウを作成するようプロファイルに指定できます。端をドラッグしてサイズを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 윈도우”에서 화면의 한쪽 가장자리에 붙는 윈도우를 생성하도록 프로파일을 설정할 수 있습니다. 가장자리를 드래그하여 크기를 조절할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar seu perfil para criar janelas fixadas em uma das bordas da tela em “Ajustes > Perfis > Janela”. Você pode redimensioná-las arrastando as bordas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить профиль так, чтобы он создавал окна, прикреплённые к одному из краёв экрана, в «Настройки > Профили > Окно». Их можно изменять в размере, перетаскивая края."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilinizin “Ayarlar > Profiller > Pencere” bölümünde ekranın bir kenarına bağlı pencereler oluşturmasını sağlayabilirsiniz. Kenarlarını sürükleyerek yeniden boyutlandırabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在“设置 > 配置文件 > 窗口”中让你的配置文件创建固定在屏幕一边的窗口。你可以通过拖动边缘来调整其大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在「設定 > 描述檔 > 視窗」中，讓描述檔建立貼附於螢幕某一邊的視窗，並可拖移邊緣來調整大小。"
          }
        }
      }
    },
