    "ScriptsMenu.BumpUpgradeIncompleteSentence" : {
      "comment" : "Message shown when some scripts could not be upgraded to the new Python runtime; %ld is the number of scripts",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%ld Skript konnte nicht aktualisiert werden und verwendet weiterhin die vorherige Python-Laufzeitumgebung. Es wird automatisch aktualisiert, wenn es das nächste Mal ausgeführt wird."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%ld Skripte konnten nicht aktualisiert werden und verwenden weiterhin die vorherige Python-Laufzeitumgebung. Jedes wird automatisch aktualisiert, wenn es das nächste Mal ausgeführt wird."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%ld script could not be upgraded and still uses the previous Python runtime. It will be upgraded automatically the next time it runs."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%ld scripts could not be upgraded and still use the previous Python runtime. Each will be upgraded automatically the next time it runs."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%ld個のスクリプトをアップグレードできず、以前のPythonランタイムを引き続き使用しています。それぞれは次回実行時に自動的にアップグレードされます。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "스크립트 %ld개를 업그레이드할 수 없어 여전히 이전 Python 런타임을 사용합니다. 각 스크립트는 다음에 실행될 때 자동으로 업그레이드됩니다."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%ld script não pôde ser atualizado e ainda usa o runtime Python anterior. Ele será atualizado automaticamente na próxima vez que for executado."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%ld scripts não puderam ser atualizados e ainda usam o runtime Python anterior. Cada um será atualizado automaticamente na próxima vez que for executado."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%ld скрипта не удалось обновить, они всё ещё используют предыдущую среду выполнения Python. Каждый из них будет обновлён автоматически при следующем запуске."
                }
              },
              "many" : {
