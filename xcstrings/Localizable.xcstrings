    "Tip.0123.Body" : {
      "comment" : "Tip of the day body, id 0123",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie über die SSH-Integration verbunden sind, verwenden Sie „Shell > ssh > Dateien herunterladen“, um Dateien vom entfernten Host zu durchsuchen und herunterzuladen, ohne eine neue Verbindung zu öffnen. Dateien auf SSH-Hosts erscheinen auch in Dialogen zum Öffnen/Speichern von Dateien!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When connected via SSH Integration, use “Shell > ssh > Download Files” to browse and download files from the remote host without opening a new connection. Files on SSH hosts also appear in file open/save dialogs!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando estés conectado mediante la integración con SSH, usa “Shell > ssh > Descargar archivos” para explorar y descargar archivos del host remoto sin abrir una nueva conexión. ¡Los archivos de los hosts SSH también aparecen en los diálogos de abrir/guardar archivos!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous êtes connecté via l’intégration SSH, utilisez « Shell > ssh > Télécharger des fichiers » pour parcourir et télécharger des fichiers de l’hôte distant sans ouvrir de nouvelle connexion. Les fichiers des hôtes SSH apparaissent aussi dans les dialogues d’ouverture et d’enregistrement de fichiers !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando sei connesso tramite l’integrazione SSH, usa “Shell > ssh > Scarica file” per esplorare e scaricare file dall’host remoto senza aprire una nuova connessione. I file sugli host SSH compaiono anche nei pannelli di apertura/salvataggio dei file!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合で接続している場合、「シェル > ssh > ファイルをダウンロード」を使うと、新しい接続を開かずにリモートホストのファイルを参照・ダウンロードできます。SSHホスト上のファイルは、ファイルを開く/保存するダイアログにも表示されます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 통합으로 연결된 경우 “셸 > ssh > 파일 다운로드”를 사용하면 새로운 연결을 열지 않고 원격 호스트의 파일을 탐색하고 다운로드할 수 있습니다. SSH 호스트의 파일은 파일 열기/저장 대화상자에도 나타납니다!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando conectado via SSH Integration, use “Shell > ssh > Download Files” para navegar e transferir arquivos do host remoto sem abrir uma nova conexão. Arquivos em hosts SSH também aparecem nas caixas de diálogo de abrir/salvar arquivos!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При подключении через интеграцию с SSH используйте «Оболочка > ssh > Скачать файлы», чтобы просматривать и скачивать файлы с удалённого узла без открытия нового соединения. Файлы на SSH-узлах также отображаются в диалогах открытия и сохранения файлов!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH Entegrasyonu ile bağlıyken yeni bir bağlantı açmadan uzak ana makinedeki dosyalara göz atıp indirmek için “Kabuk > ssh > Dosyaları İndir”i kullanın. SSH ana makinelerindeki dosyalar dosya açma/kaydetme iletişim kutularında da görünür!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当通过SSH集成连接时，使用“Shell > ssh > 下载文件”功能可以在不打开新连接的情况下浏览和下载远程主机上的文件。SSH主机上的文件也会出现在文件打开/保存对话框中！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 SSH 整合連線時，使用「Shell > ssh > 下載檔案」可瀏覽並下載遠端主機上的檔案，不需另外建立新連線。SSH 主機上的檔案也會出現在檔案打開/儲存對話框中！"
          }
        }
      }
    },
