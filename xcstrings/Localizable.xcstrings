    "Companion.SetupFailed.AIModelCannotAuthenticate" : {
      "comment" : "Error shown when the companion setup wizard installed its plugins but the AI model still cannot authenticate with the entered API key",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI- und Begleit-Plugins wurden installiert, aber das KI-Modell ist nicht für die Verwendung des eingegebenen API-Schlüssels konfiguriert. Überprüfen Sie den Anbieter und das KI-Modell unter Einstellungen > Allgemein > KI und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The AI and companion plugins were installed, but the AI model is not configured to use the API key you entered. Check the provider and the AI model in Settings > General > AI, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los plugins de IA y complementario se instalaron, pero el modelo de IA no está configurado para usar la clave de API que introdujiste. Comprueba el proveedor y el modelo de IA en Ajustes > General > IA y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modules IA et compagnon ont été installés, mais le modèle d’IA n’est pas configuré pour utiliser la clé d’API que vous avez saisie. Vérifiez le fournisseur et le modèle d’IA dans Réglages > Général > IA, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I plug-in IA e associato sono stati installati, ma il modello IA non è configurato per usare la chiave API che hai inserito. Controlla il provider e il modello IA in Impostazioni > Generali > IA, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプラグインとコンパニオンプラグインはインストールされましたが、AIモデルが入力したAPIキーを使用するように設定されていません。設定 > 一般 > AIでプロバイダーとAIモデルを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 및 컴패니언 플러그인은 설치되었지만 AI 모델이 입력한 API 키를 사용하도록 구성되지 않았습니다. 설정 > 일반 > AI에서 제공업체와 AI 모델을 확인한 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os plugins de IA e do Companion foram instalados, mas o modelo de IA não está configurado para usar a chave de API que você digitou. Verifique o provedor e o modelo de IA em Ajustes > Geral > IA e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины ИИ и Компаньон установлены, но модель ИИ не настроена на использование введённого вами ключа API. Проверьте поставщика и модель ИИ в Настройки > Общие > ИИ, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ ve eşlik eden eklentiler yüklendi, ancak YZ modeli girdiğiniz API anahtarını kullanacak şekilde yapılandırılmamış. Ayarlar > Genel > YZ bölümünde sağlayıcıyı ve YZ modelini denetleyip yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 插件和 Companion 插件已安装，但 AI 模型未配置为使用您输入的 API 密钥。请在“设置 > 通用 > AI”中检查提供商和 AI 模型，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 與搭配外掛程式已安裝，但 AI 模型未設定為使用你輸入的 API 金鑰。請在「設定 > 一般 > AI」中檢查供應商與 AI 模型，然後再試一次。"
          }
        }
      }
    },
    "Companion.SetupFailed.Suffix" : {
      "comment" : "Text appended after the error message in the setup-failed alert",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nSie können die Einrichtung in den Begleitgerät-Einstellungen abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nYou can finish setting up in Companion Device Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nPuedes terminar la configuración en Ajustes del dispositivo complementario."
