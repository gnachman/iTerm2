    "PasteView.KeystrokeToolTip" : {
      "comment" : "Tooltip for the button that sends keystrokes directly to the terminal during a paste",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Psát přímo do terminálu (například pro odpověď na výzvu k zadání hesla) místo řazení stisků kláves do fronty do dokončení vložení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv direkte i terminalen (for eksempel for at svare på en adgangskodeprompt) i stedet for at sætte dine tastetryk i kø, til indsætningen er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt in das Terminal tippen (zum Beispiel, um eine Passwortabfrage zu beantworten), anstatt Ihre Tastatureingaben bis zum Ende des Einfügevorgangs in eine Warteschlange zu stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Type directly to the terminal (for example to answer a password prompt) instead of queueing your keystrokes until the paste finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe directamente en la terminal (por ejemplo, para responder a un prompt de contraseña) en lugar de poner en cola tus pulsaciones hasta que termine el pegado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita suoraan päätteeseen (esimerkiksi vastataksesi salasanakehotteeseen) sen sijaan, että näppäinpainalluksesi jonotetaan sijoituksen päättymiseen asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez directement dans le terminal (par exemple pour répondre à une invite de mot de passe) au lieu de mettre vos frappes en file d’attente jusqu’à la fin du collage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita direttamente nel terminale (ad esempio per rispondere a un prompt della password) invece di mettere in coda i tasti premuti fino al termine dell’incolla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キー入力をペーストが終わるまでキューに入れる代わりに、ターミナルへ直接入力します（たとえばパスワードプロンプトに答える場合など）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣기가 끝날 때까지 키 입력을 대기열에 두지 않고 터미널에 직접 입력합니다(예: 암호 프롬프트에 응답할 때)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv direkte til terminalen (f.eks. for å svare på en passordledetekst) i stedet for å legge tastetrykkene i kø til innlimingen er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ rechtstreeks in de terminal (bijvoorbeeld om een wachtwoordprompt te beantwoorden) in plaats van je toetsaanslagen in de wachtrij te zetten totdat het plakken klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisuj bezpośrednio do terminala (na przykład, aby odpowiedzieć na znak zachęty hasła) zamiast kolejkować naciśnięcia klawiszy do końca wklejania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite diretamente no terminal (por exemplo, para responder a um prompt de senha) em vez de enfileirar suas teclas até a colagem terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводить текст непосредственно в терминал (например, чтобы ответить на запрос пароля) вместо постановки нажатий клавиш в очередь до завершения вставки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Písať priamo do terminálu (napríklad na odpoveď na výzvu na heslo) namiesto zaradenia stlačení klávesov do fronty, kým sa vkladanie neskončí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnašajte neposredno v terminal (na primer za odgovor na poziv za geslo), namesto da se vaši pritiski tipk postavijo v vrsto do konca lepljenja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv direkt i terminalen (till exempel för att svara på en lösenordsprompt) i stället för att köa tangenttrycken tills inklistringen är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuş vuruşlarınızı yapıştırma bitene kadar kuyruğa almak yerine doğrudan terminale yazın (örneğin bir parola istemini yanıtlamak için)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gõ trực tiếp vào terminal (ví dụ để trả lời dấu nhắc mật khẩu) thay vì xếp hàng các lần nhấn phím cho đến khi dán xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接输入到终端（例如回答密码提示），而不是将按键排入队列直到粘贴完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接輸入到終端機（例如回答密碼提示），而不是將按鍵排入佇列直到貼上完成。"
          }
        }
      }
    },
    "PasteView.QueuedHint" : {
      "comment" : "Hint shown while pasting explaining that keystrokes are queued",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během vkládání se psaní řadí do fronty. Řazení zapnete nebo vypnete kliknutím na klávesnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det, du skriver, sættes i kø under indsætning. Klik på tastaturet for at slå køsætning til eller fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Einfügens werden Tastatureingaben in eine Warteschlange gestellt. Klicken Sie auf die Tastatur, um die Warteschlange ein- oder auszuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Typing is queued while pasting. Click the keyboard to toggle queueing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escribes se pone en cola durante el pegado. Haz clic en el teclado para activar o desactivar la cola."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoitus jonotetaan sijoituksen aikana. Vaihda jonotus päälle/pois klikkaamalla näppäimistöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La saisie est mise en file d’attente pendant le collage. Cliquez sur le clavier pour activer/désactiver la file d’attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La digitazione viene messa in coda durante l’incolla. Fai clic sulla tastiera per attivare o disattivare la coda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペースト中はキー入力がキューに入れられます。キーボードをクリックするとキュー機能の有効/無効を切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣는 동안에는 입력이 대기열에 쌓입니다. 키보드를 클릭하면 대기열 사용을 켜거나 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastetrykk legges i kø under innliming. Klikk på tastaturet for å slå køing av/på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typen wordt tijdens het plakken in de wachtrij gezet. Klik op het toetsenbord om de wachtrij in of uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisywanie jest kolejkowane podczas wklejania. Kliknij klawiaturę, aby włączyć lub wyłączyć kolejkowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A digitação é enfileirada durante a colagem. Clique no teclado para alternar o enfileiramento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время вставки ввод ставится в очередь. Нажмите на значок клавиатуры, чтобы включить или выключить очередь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Písanie sa počas vkladania zaraďuje do fronty. Kliknutím na klávesnicu prepnete zaraďovanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med lepljenjem se vnos postavlja v vrsto. Kliknite tipkovnico, da vklopite ali izklopite čakalno vrsto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangenttryck köas under inklistring. Klicka på tangentbordet för att slå på/av köning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapıştırma sırasında yazdıklarınız kuyruğa alınır. Kuyruğa almayı açıp kapatmak için klavyeye tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc gõ được xếp hàng trong khi dán. Bấm vào bàn phím để bật/tắt việc xếp hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴期间输入会排队。点按键盘图标可切换排队。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上期間，輸入會排入佇列。按一下鍵盤圖像可切換排入佇列。"
          }
        }
      }
    },
