          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondersteuning voor de escapereeks REP (vorig teken herhalen) inschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy włączyć obsługę sekwencji sterującej REP (powtórz poprzedni znak)?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
