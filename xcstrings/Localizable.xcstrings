    "Tip.0019.Body" : {
      "comment" : "Tip of the day body, id 0019",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können ein Terminalfenster per Tastendruck öffnen, selbst wenn Sie sich in einer anderen App befinden. Klicken Sie auf „Eigenes Hotkey-Fenster erstellen“ unter „Einstellungen > Tasten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can have a terminal window open with a keystroke, even while in other apps. Click “Create a Dedicated Hotkey Window” in “Settings > Keys.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のアプリを使用中でも、キー操作1つでターミナルウィンドウを開けます。「設定 > キー」で「専用ホットキーウィンドウを作成」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱을 사용하는 중에도 키 입력 한 번으로 터미널 윈도우를 열 수 있습니다. “설정 > 키”에서 “전용 단축키 윈도우 생성”을 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode abrir uma janela de terminal com um atalho de teclado, mesmo em outros apps. Clique em “Criar uma janela de tecla de atalho dedicada” em “Ajustes > Teclas”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете открывать окно терминала одним нажатием клавиши, даже находясь в других приложениях. Нажмите «Создать выделенное окно горячих клавиш» в «Настройки > Клавиши»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在其他应用程序中，也可以通过按键操作打开终端窗口。在“设置 > 快捷键”中点击“创建专用快捷键窗口”。"
          }
        }
      }
    },
    "Tip.0019.Title" : {
