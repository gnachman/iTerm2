    "Tip.0063.Body" : {
      "comment" : "Tip of the day body, id 0063",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Online-Farbgalerie bietet über hundert wunderschöne Farbschemata zum Herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The online color gallery features over one hundred beautiful color schemes you can download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインカラーギャラリーには、ダウンロードできる100種類以上の美しいカラースキームが用意されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "온라인 색상 갤러리에는 다운로드할 수 있는 아름다운 색상 구성표가 100개 넘게 있습니다."
