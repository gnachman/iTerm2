    "Tip.0017.Body" : {
      "comment" : "Tip of the day body, id 0017",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čtyřnásobným kliknutím použijete chytrý výběr. Na základě regulárních výrazů seřazených podle priority zjistí, zda vybíráte URL, název souboru, e-mailovou adresu apod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik fire gange for at bruge smart markering. Den finder ud af, om du markerer en URL, et arkivnavn, en e-mailadresse osv. ud fra regulære udtryk med prioritet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie viermal, um die Intelligente Auswahl auszulösen. Anhand priorisierter regulärer Ausdrücke wird erkannt, ob Sie eine URL, einen Dateinamen, eine E-Mail-Adresse und so weiter auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Quadruple click to perform Smart Selection. It figures out if you’re selecting a URL, filename, email address, etc. based on prioritized regular expressions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz cuatro clics para usar la selección inteligente. Averigua si estás seleccionando una URL, un nombre de archivo, una dirección de correo electrónico, etc. a partir de expresiones regulares priorizadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelinkertainen klikkaus suorittaa älykkään valinnan. Se päättelee, valitsetko URL-osoitteen, tiedostonimen, sähköpostiosoitteen tms. tärkeysjärjestykseen asetettujen säännöllisten lausekkeiden perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez quatre fois pour utiliser la sélection intelligente. Elle détermine si vous sélectionnez une URL, un nom de fichier, une adresse e-mail, etc., à partir d’expressions régulières classées par priorité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic quattro volte per usare la selezione intelligente. Capisce se stai selezionando un URL, un nome file, un indirizzo email e così via in base a espressioni regolari con priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4回クリックするとスマート選択が実行されます。優先順位付けされた正規表現に基づいて、URL、ファイル名、メールアドレスなどのどれを選択しようとしているかを自動的に判別します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네 번 클릭하면 스마트 선택이 수행됩니다. 우선순위가 지정된 정규 표현식을 기반으로 URL, 파일 이름, 이메일 주소 등 무엇을 선택하는지 알아냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk fire ganger for å bruke smart markering. Den finner ut om du markerer en URL, et filnavn, en e-postadresse osv. basert på regulære uttrykk med prioritet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik vier keer om Slimme selectie te gebruiken. Op basis van geprioriteerde reguliere expressies bepaalt iTerm2 of je een URL, bestandsnaam, e-mailadres enzovoort selecteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij czterokrotnie, aby użyć inteligentnego zaznaczania. Rozpoznaje, czy zaznaczasz URL, nazwę pliku, adres e-mail itp., na podstawie uszeregowanych według priorytetu wyrażeń regularnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique quatro vezes para usar a Seleção inteligente. Ela descobre se você está selecionando um URL, nome de arquivo, endereço de e-mail etc. com base em expressões regulares priorizadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре щелчка подряд запускают умное выделение. Оно определяет, что вы выделяете (URL-адрес, имя файла, адрес электронной почты и т. д.), на основе приоритизированных регулярных выражений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Štvornásobným kliknutím použijete inteligentný výber. Podľa prioritizovaných regulárnych výrazov zistí, či vyberáte URL, názov súboru, e-mailovú adresu atď."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Štirikratni klik izvede pametni izbor. Na podlagi prednostnih regularnih izrazov ugotovi, ali izbirate URL, ime datoteke, e-poštni naslov ipd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrdubbelklicka för att använda smart markering. Den räknar ut om du markerar en URL, ett filnamn, en e-postadress osv. utifrån prioriterade reguljära uttryck."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı Seçim yapmak için dört kez tıklayın. Öncelik sıralı düzenli ifadelere göre bir URL, dosya adı, e-posta adresi vb. seçip seçmediğinizi anlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm bốn lần để dùng Chọn thông minh. Tính năng này tự nhận biết bạn đang chọn URL, tên tệp, địa chỉ email, v.v. dựa trên các biểu thức chính quy có thứ tự ưu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四次点击可触发智能选取。它根据优先级正则表达式判断您正在选择 URL、文件名、电子邮件地址等。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連按四下可執行智慧型選取。它會依據有優先順序的正規表示式，判斷你選取的是 URL、檔名、電子郵件地址等。"
          }
        }
      }
    },
