    "Tip.0097.Body" : {
      "comment" : "Tip of the day body, id 0097",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úryvky v pokročilém vkládání upravíte podržením klávesy ⌥ nebo je otevřete v editoru příkazů pomocí ⇧."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rediger tekststykker i Avanceret indsætning ved at holde tasten ⌥ nede, eller åbn dem i kommandoeditoren med ⇧."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeiten Sie Snippets im Erweiterten Einfügen, indem Sie die ⌥-Taste gedrückt halten, oder öffnen Sie sie mit ⇧ im Composer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Edit snippets in Advanced Paste by holding the ⌥ key, or open them in the composer with ⇧."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita fragmentos en Pegado avanzado manteniendo pulsada la tecla ⌥, o ábrelos en el compositor con ⇧."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muokkaa katkelmia Edistyneessä sijoituksessa pitämällä ⌥-näppäintä painettuna tai avaa ne komentoeditorissa ⇧-näppäimellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez les extraits dans Collage avancé en maintenant la touche ⌥, ou ouvrez-les dans le compositeur avec ⇧."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica i frammenti in Incolla avanzato tenendo premuto il tasto ⌥, oppure aprili nel compositore con ⇧."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥キーを押しながらにすると高度なペーストでスニペットを編集でき、⇧を押すとコンポーザーで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ 키를 누른 채로 고급 붙여넣기에서 스니펫을 편집하거나, ⇧ 키로 컴포저에서 스니펫을 열 수 있습니다."
