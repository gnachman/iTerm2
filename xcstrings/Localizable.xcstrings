    "TransferrableFile.CouldNotQuarantine" : {
      "comment" : "Warning shown when a downloaded file could not be quarantined or removed; %@ is the file path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor „%@“ se nepodařilo dát do karantény ani smazat! Je nebezpečný a měl by být odstraněn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivet på “%@” kunne ikke sættes i karantæne eller slettes! Det er farligt og bør fjernes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei unter „%@“ konnte nicht unter Quarantäne gestellt oder gelöscht werden! Sie ist gefährlich und sollte entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The file at “%@” could not be quarantined or deleted! It is dangerous and should be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido poner en cuarentena ni eliminar el archivo en “%@”. Es peligroso y debería eliminarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostoa kohteessa ”%@” ei voitu asettaa karanteeniin eikä poistaa! Se on vaarallinen ja pitäisi poistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier à l’emplacement « %@ » n’a pas pu être mis en quarantaine ni supprimé ! Il est dangereux et doit être supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile mettere in quarantena o eliminare il file in “%@”. È pericoloso e andrebbe rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」にあるファイルを隔離または削除できませんでした！このファイルは危険なため、削除する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에 있는 파일을 격리하거나 삭제할 수 없습니다! 위험한 파일이므로 제거해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen i «%@» kunne ikke settes i karantene eller slettes! Den er farlig og bør fjernes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand op ‘%@’ kon niet in quarantaine worden geplaatst of verwijderd! Het is gevaarlijk en moet worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się poddać kwarantannie ani usunąć pliku „%@”! Jest niebezpieczny i należy go usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo em “%@” não pôde ser posto em quarentena nem apagado! Ele é perigoso e deve ser removido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» не удалось поместить в карантин или удалить! Он опасен, и его следует удалить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor v umiestnení „%@“ sa nepodarilo dať do karantény ani odstrániť! Je nebezpečný a mal by sa odstrániť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke »%@« ni bilo mogoče dati v karanteno ali izbrisati! Nevarna je in jo je treba odstraniti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen ”%@” kunde inte sättas i karantän eller raderas! Den är farlig och bör tas bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” konumundaki dosya karantinaya alınamadı veya silinemedi! Tehlikelidir ve kaldırılmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể cách ly hoặc xóa tệp tại “%@”! Tệp này nguy hiểm và nên được gỡ bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”处的文件无法隔离或删除！它很危险，应将其移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
