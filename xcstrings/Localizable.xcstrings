    "AdvancedSetting.maximumBytesToProvideToPythonAPI" : {
      "comment" : "Advanced setting: maximumBytesToProvideToPythonAPI",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl an Bytes der Auswahl, die an die Python-API übergeben werden.\nEin hoher Wert kann bei einer großen Auswahl zu Leistungsproblemen führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of bytes of selection to provide to Python API.\nA large value here can cause performance issues when you have a big selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de bytes de la selección que se proporcionan a la API de Python.\nUn valor alto puede causar problemas de rendimiento cuando tienes una selección grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre maximal d’octets de la sélection à fournir à l’API Python.\nUne valeur élevée peut causer des problèmes de performances lorsque la sélection est volumineuse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero massimo di byte della selezione da fornire all’API Python.\nUn valore alto può causare problemi di prestazioni quando hai una selezione ampia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API に渡す選択範囲の最大バイト数。\nここで大きな値を指定すると、大きな選択範囲がある場合にパフォーマンスの問題が発生することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API에 제공할 선택 영역의 최대 바이트 수입니다.\n이 값이 크면 선택 영역이 클 때 성능 문제가 발생할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número máximo de bytes da seleção a fornecer à API do Python.\nUm valor alto aqui pode causar problemas de desempenho quando você tem uma seleção grande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное количество байт выделения, предоставляемых Python API.\nБольшое значение здесь может вызвать проблемы с производительностью при большом выделении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API’sine sağlanacak azami seçim bayt sayısı.\nBüyük bir seçiminiz olduğunda buradaki yüksek bir değer performans sorunlarına yol açabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供给Python API的选择范围最大字节数。\n此处设置较大的数值可能导致选择范围过大时性能下降。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供給 Python API 的選取範圍最大位元組數。\n如果選取範圍很大，這裡設定很大的值可能造成效能問題。"
          }
        }
      }
    },
