        }
      }
    },
    "AISafetyCheck.KeepAppleIntelligence" : {
      "comment" : "Button to keep using Apple Intelligence for safety checks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence beibehalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep Apple Intelligence"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceを使い続ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 계속 사용"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter o Apple Intelligence"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить Apple Intelligence"
          }
