    "APIHelper.EnablePythonAPIMessage" : {
      "comment" : "Body text explaining what enabling the Python API allows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Python-API ermöglicht es den von Ihnen ausgeführten Skripten, iTerm2 zu steuern und auf alle seine Daten zuzugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Python API allows scripts you run to control iTerm2 and access all its data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La API de Python permite que los scripts que ejecutes controlen iTerm2 y accedan a todos sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’API Python permet aux scripts que vous exécutez de contrôler iTerm2 et d’accéder à toutes ses données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’API Python consente agli script che esegui di controllare iTerm2 e di accedere a tutti i suoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python APIを使うと、実行するスクリプトがiTerm2を制御し、そのすべてのデータにアクセスできるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API를 사용하면 실행하는 스크립트가 iTerm2를 제어하고 iTerm2의 모든 데이터에 접근할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A API do Python permite que os scripts executados controlem o iTerm2 e acessem todos os seus dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API позволяет запускаемым вами скриптам управлять iTerm2 и получать доступ ко всем его данным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API’si, çalıştırdığınız betiklerin iTerm2’yi denetlemesine ve tüm verilerine erişmesine olanak tanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API 允许你运行的脚本控制 iTerm2 并访问其所有数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python API 允許你執行的腳本控制 iTerm2 並取用其所有資料。"
          }
        }
      }
    },
