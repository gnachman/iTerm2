    "AdvancedSetting.hideStuckTooltips" : {
      "comment" : "Advanced setting: hideStuckTooltips",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängende Tooltips ausblenden.\nWenn Sie iTerm2 mit einer Hotkey-Taste ausblenden, während ein Tooltip gerade ausgeblendet wird, bleibt er aufgrund eines Betriebssystemfehlers hängen. Umgehen Sie dies mit einem unschönen Hack, indem Sie diese Funktion aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide stuck tooltips.\nWhen you hide iTerm2 using a hotkey while a tooltip is fading out it gets stuck because of an OS bug. Work around it with a nasty hack by enabling this feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar las descripciones emergentes atascadas.\nCuando ocultas iTerm2 con una tecla rápida mientras una descripción emergente se desvanece, se queda atascada por un error del sistema. Actívalo para evitarlo con un truco poco elegante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les infobulles bloquées.\nQuand vous masquez iTerm2 avec un raccourci global pendant qu’une infobulle s’estompe, elle reste bloquée à cause d’un bug du système. Contournez-le avec un vilain hack en activant cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi i suggerimenti bloccati.\nQuando nascondi iTerm2 con un’abbreviazione globale mentre un suggerimento sta svanendo, questo si blocca a causa di un bug del sistema. Aggira il problema con un brutto trucco abilitando questa funzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固まったツールチップを非表示にします。\nツールチップがフェードアウト中にホットキーで iTerm2 を非表示にすると、OS のバグによりツールチップが固まってしまいます。この機能を有効にすると、強引なハックでこれを回避します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춘 도움말 풍선을 가립니다.\n도움말 풍선이 사라지는 동안 단축키로 iTerm2를 가리면 OS 버그 때문에 도움말 풍선이 화면에 멈춰 남습니다. 이 기능을 켜면 지저분한 편법으로 이 문제를 우회합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar dicas travadas.\nQuando você oculta o iTerm2 usando uma hotkey enquanto uma dica está desaparecendo, ela fica travada por causa de um bug do sistema. Contorne isso com um hack desagradável ativando este recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать зависшие подсказки.\nКогда вы скрываете iTerm2 горячей клавишей во время затухания подсказки, она зависает из-за ошибки ОС. Обойдите это неприятным хаком, включив эту функцию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takılı kalan araç ipuçlarını gizle.\nBir araç ipucu kaybolurken iTerm2’yi kısayol tuşuyla gizlerseniz işletim sistemi hatası nedeniyle takılı kalır. Bu özelliği etkinleştirerek çirkin bir yöntemle bunu aşın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏卡住的工具提示。\n当工具提示正在消失时通过热键隐藏iTerm2，由于操作系统缺陷会导致工具提示卡住。可通过启用此功能来作为变通方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱藏卡住的工具提示。\n當工具提示正在淡出時，你以全域快速鍵隱藏 iTerm2，工具提示會因為系統錯誤而卡住。啟用此功能可用一個醜陋的方法繞過這個問題。"
          }
        }
      }
    },
    "AdvancedSetting.highVisibility" : {
      "comment" : "Advanced setting: highVisibility",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High-Contrast-Modi maximieren die Sichtbarkeit.\nWenn aktiviert, legt das dunkle High-Contrast-Design mehr Wert auf Sichtbarkeit als auf Optik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High Contrast modes maximize visibility.\nWhen enabled, the dark high-contrast theme emphasizes visibility over beauty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modos de alto contraste maximizan la visibilidad.\nSi se activa, el tema oscuro de alto contraste da prioridad a la visibilidad sobre la estética."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modes Contraste élevé maximisent la visibilité.\nSi cette option est activée, le thème sombre à contraste élevé privilégie la visibilité sur l’esthétique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modalità ad alto contrasto massimizzano la visibilità.\nSe abilitato, il tema scuro ad alto contrasto privilegia la visibilità rispetto all’estetica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイコントラストモードで視認性を最大化します。\n有効にすると、ダークハイコントラストテーマは美しさよりも視認性を重視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고대비 모드로 가시성 극대화\n켜면 다크 고대비 테마가 미관보다 가시성을 우선합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modos de Alto Contraste maximizam a visibilidade.\nQuando ativado, o tema escuro de alto contraste enfatiza a visibilidade em vez da beleza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режимы High Contrast максимизируют видимость.\nПри включении тёмная тема высокой контрастности делает упор на видимость, а не на красоту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek Karşıtlık modları görünürlüğü en üst düzeye çıkarır.\nEtkinleştirildiğinde koyu yüksek karşıtlık teması güzellik yerine görünürlüğü vurgular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高对比度模式可提升可见度。\n启用后，深色高对比度主题会更注重显示效果而非美观性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高對比模式將可見度最大化。\n啟用後，深色高對比主題會以可見度優先於美觀。"
          }
        }
      }
    },
    "AdvancedSetting.holdScreenDuringPromptRepaint" : {
      "comment" : "Advanced setting: holdScreenDuringPromptRepaint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Bildschirm unverändert anzeigen, während die Shell ihren Prompt neu zeichnet?\nManche Zeileneditoren, etwa der von nushell, zeichnen den Prompt und die Befehlszeile bei jedem Tastendruck neu. Wenn aktiviert, zeigt iTerm2 den Bildschirm im vorherigen Zustand an, bis das Neuzeichnen abgeschlossen ist, damit der Befehl nicht flackert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep showing the screen as it was while the shell redraws its prompt?\nSome line editors, such as nushell’s, redraw the prompt and command line on every keystroke. When enabled, iTerm2 keeps drawing the screen as it was until the redraw finishes so the command doesn’t blink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguir mostrando la pantalla tal como estaba mientras el shell redibuja su prompt?\nAlgunos editores de línea, como el de nushell, redibujan el prompt y la línea de comandos con cada pulsación de tecla. Si se activa, iTerm2 sigue dibujando la pantalla tal como estaba hasta que termina el redibujado, para que el comando no parpadee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer d’afficher l’écran tel qu’il était pendant que le shell redessine son invite ?\nCertains éditeurs de ligne, comme celui de nushell, redessinent l’invite et la ligne de commande à chaque frappe. Si cette option est activée, iTerm2 continue d’afficher l’écran tel qu’il était jusqu’à la fin du redessin, pour que la commande ne clignote pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuare a mostrare lo schermo com’era mentre la shell ridisegna il prompt?\nAlcuni editor di riga, come quello di nushell, ridisegnano il prompt e la riga di comando a ogni pressione di un tasto. Se abilitato, iTerm2 continua a disegnare lo schermo com’era finché il ridisegno non termina, così il comando non lampeggia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルがプロンプトを再描画している間、画面を以前のまま表示し続けますか？\nnushell のものなど、一部のラインエディタはキーを押すたびにプロンプトとコマンドラインを再描画します。有効にすると、再描画が終わるまで iTerm2 は以前の画面を表示し続けるため、コマンドがちらつきません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸이 프롬프트를 다시 그리는 동안 화면을 이전 상태로 계속 표시하겠습니까?\nnushell의 것과 같은 일부 줄 편집기는 키를 누를 때마다 프롬프트와 명령줄을 다시 그립니다. 켜면 다시 그리기가 끝날 때까지 iTerm2가 이전 화면을 계속 표시하므로 명령이 깜박이지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar mostrando a tela como estava enquanto o shell redesenha o prompt?\nAlguns editores de linha, como o do nushell, redesenham o prompt e a linha de comando a cada tecla. Quando ativado, o iTerm2 continua mostrando a tela como estava até o redesenho terminar, para que o comando não pisque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать экран в прежнем виде, пока оболочка перерисовывает приглашение?\nНекоторые редакторы строки, например в nushell, перерисовывают приглашение и командную строку при каждом нажатии клавиши. Если параметр включён, iTerm2 показывает прежнее содержимое экрана, пока перерисовка не закончится, чтобы команда не мигала."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk istemini yeniden çizerken ekran eski haliyle gösterilmeye devam edilsin mi?\nnushell gibi bazı satır düzenleyiciler her tuş vuruşunda istemi ve komut satırını yeniden çizer. Etkinleştirildiğinde iTerm2, komutun yanıp sönmemesi için yeniden çizim bitene kadar ekranı eski haliyle çizmeyi sürdürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 shell 重绘提示符时继续显示原来的屏幕内容？\n某些行编辑器（例如 nushell 的）会在每次按键时重绘提示符和命令行。启用后，iTerm2 会在重绘完成前继续显示原来的屏幕内容，使命令不会闪烁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 重繪提示符號時，持續顯示原本的螢幕？\n某些行編輯器（例如 nushell 的）會在每次按鍵時重繪提示符號和命令列。啟用後，iTerm2 會持續繪製原本的螢幕直到重繪完成，使指令不致閃爍。"
          }
        }
      }
    },
    "AdvancedSetting.honorBidiSupportModeEscapeSequence" : {
      "comment" : "Advanced setting: honorBidiSupportModeEscapeSequence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps die Steuerung der Rechts-nach-links-Neuanordnung über die Escape-Sequenzen BDSM und SCP erlauben?\nManche Vollbildanwendungen gestalten ihren Text selbst und werden durch die Neuanordnung durcheinandergebracht. Wenn diese Option aktiviert ist, bleibt Text, der nach CSI 8 l (expliziter Modus) geschrieben wird, unverändert, und CSI 8 h (impliziter Modus, die Standardeinstellung) schaltet die Neuanordnung wieder ein. CSI 1 SP k und CSI 2 SP k setzen die Grundrichtung neu angeordneter Zeilen auf links-nach-rechts bzw. rechts-nach-links, und CSI 0 SP k stellt die Standardeinstellung wieder her. Erfordert Unterstützung für Rechts-nach-links-Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Let apps control right-to-left reordering with the BDSM and SCP escape sequences?\nSome full-screen apps lay out their own text and are scrambled by reordering. When this is on, text written after CSI 8 l (explicit mode) is left as is, and CSI 8 h (implicit mode, the default) turns reordering back on. CSI 1 SP k and CSI 2 SP k set the base direction of reordered lines to left-to-right or right-to-left, and CSI 0 SP k restores the default. Requires right-to-left text support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que las apps controlen el reordenamiento de derecha a izquierda con las secuencias de escape BDSM y SCP?\nAlgunas apps a pantalla completa distribuyen su propio texto y el reordenamiento lo desordena. Si esto está activado, el texto escrito después de CSI 8 l (modo explícito) se deja tal cual, y CSI 8 h (modo implícito, el predeterminado) vuelve a activar el reordenamiento. CSI 1 SP k y CSI 2 SP k establecen la dirección base de las líneas reordenadas de izquierda a derecha o de derecha a izquierda, y CSI 0 SP k restablece el valor predeterminado. Requiere el soporte de texto de derecha a izquierda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser les apps contrôler le réordonnancement de droite à gauche avec les séquences d’échappement BDSM et SCP ?\nCertaines apps en plein écran organisent leur propre texte et sont perturbées par le réordonnancement. Si cette option est activée, le texte écrit après CSI 8 l (mode explicite) est laissé tel quel, et CSI 8 h (mode implicite, par défaut) réactive le réordonnancement. CSI 1 SP k et CSI 2 SP k définissent le sens de base des lignes réordonnées de gauche à droite ou de droite à gauche, et CSI 0 SP k rétablit la valeur par défaut. Nécessite la prise en charge du texte de droite à gauche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire alle app di controllare il riordino da destra a sinistra con le sequenze di escape BDSM e SCP?\nAlcune app a tutto schermo dispongono da sole il proprio testo e il riordino le scompone. Se attivo, il testo scritto dopo CSI 8 l (modalità esplicita) viene lasciato così com’è, e CSI 8 h (modalità implicita, quella predefinita) riattiva il riordino. CSI 1 SP k e CSI 2 SP k impostano la direzione di base delle righe riordinate da sinistra a destra o da destra a sinistra, e CSI 0 SP k ripristina quella predefinita. Richiede il supporto per il testo da destra a sinistra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BDSM および SCP エスケープシーケンスで、アプリが右から左への並べ替えを制御できるようにしますか?\n一部のフルスクリーンアプリは自身でテキストをレイアウトしており、並べ替えによって表示が崩れます。これをオンにすると、CSI 8 l (明示モード) の後に書き込まれたテキストはそのまま表示され、CSI 8 h (暗黙モード、デフォルト) で並べ替えが再び有効になります。CSI 1 SP k と CSI 2 SP k は並べ替えられる行の基本方向をそれぞれ左から右、右から左に設定し、CSI 0 SP k はデフォルトに戻します。右から左のテキストサポートが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 BDSM 및 SCP 이스케이프 시퀀스로 오른쪽에서 왼쪽 재정렬을 제어하도록 허용합니까?\n일부 전체 화면 앱은 텍스트를 직접 배치하므로 재정렬하면 텍스트가 뒤섞입니다. 이 설정이 켜져 있으면 CSI 8 l(명시적 모드) 이후에 쓰인 텍스트는 그대로 유지되고, CSI 8 h(암시적 모드, 기본값)는 재정렬을 다시 켭니다. CSI 1 SP k 및 CSI 2 SP k는 재정렬된 줄의 기본 방향을 각각 왼쪽에서 오른쪽 또는 오른쪽에서 왼쪽으로 설정하고, CSI 0 SP k는 기본값을 복원합니다. 오른쪽에서 왼쪽 텍스트 지원이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que apps controlem a reordenação da direita para a esquerda com as sequências de escape BDSM e SCP?\nAlguns apps de tela cheia organizam o próprio texto e ficam embaralhados com a reordenação. Quando esta opção está ativada, o texto escrito após CSI 8 l (modo explícito) é mantido como está, e CSI 8 h (modo implícito, o padrão) reativa a reordenação. CSI 1 SP k e CSI 2 SP k definem a direção base das linhas reordenadas como da esquerda para a direita ou da direita para a esquerda, e CSI 0 SP k restaura o padrão. Requer suporte a texto da direita para a esquerda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить приложениям управлять переупорядочиванием текста справа налево с помощью escape-последовательностей BDSM и SCP?\nНекоторые полноэкранные приложения сами располагают свой текст, и переупорядочивание его искажает. Если этот параметр включён, текст, выведенный после CSI 8 l (явный режим), остаётся без изменений, а CSI 8 h (неявный режим, по умолчанию) снова включает переупорядочивание. CSI 1 SP k и CSI 2 SP k задают базовое направление переупорядочиваемых строк слева направо или справа налево, а CSI 0 SP k восстанавливает значение по умолчанию. Требуется поддержка текста справа налево."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar sağdan sola yeniden sıralamayı BDSM ve SCP kaçış dizileriyle denetleyebilsin mi?\nBazı tam ekran uygulamalar kendi metnini yerleştirir ve yeniden sıralamayla bozulur. Bu açıkken CSI 8 l (açık mod) sonrasında yazılan metin olduğu gibi bırakılır, CSI 8 h (örtük mod, varsayılan) yeniden sıralamayı tekrar açar. CSI 1 SP k ve CSI 2 SP k, yeniden sıralanan satırların temel yönünü soldan sağa veya sağdan sola ayarlar; CSI 0 SP k varsayılanı geri yükler. Sağdan sola metin desteği gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许应用通过 BDSM 和 SCP 转义序列控制从右到左的重新排序吗？\n某些全屏应用会自行排列文本，重新排序会使其显示错乱。开启此选项后，在 CSI 8 l（显式模式）之后写入的文本将保持原样，而 CSI 8 h（隐式模式，默认）会重新开启重新排序。CSI 1 SP k 和 CSI 2 SP k 分别将重新排序行的基本方向设为从左到右或从右到左，CSI 0 SP k 则恢复默认值。需要支持从右到左的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 App 使用 BDSM 和 SCP 跳脫序列控制由右至左的重新排列？\n某些全螢幕 App 會自行安排文字，重新排列會使其錯亂。開啟後，CSI 8 l（明確模式）之後寫入的文字會維持原樣，而 CSI 8 h（隱含模式，預設）會重新開啟重新排列。CSI 1 SP k 和 CSI 2 SP k 會將重新排列之行的基準方向設為由左至右或由右至左，CSI 0 SP k 則會回復預設值。需要由右至左文字支援。"
          }
        }
      }
    },
    "AdvancedSetting.horizontalScrollingSensitivity" : {
      "comment" : "Advanced setting: horizontalScrollingSensitivity",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfindlichkeit des Mausrads für horizontales Scrollen.\nVerwenden Sie 0, um es zu deaktivieren. Der Wert sollte zwischen 0 und 1 liegen. Änderungen an dieser Einstellung wirken sich nur auf neue Sitzungen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity of mouse wheel for horizontal scrolling.\nUse 0 to disable. Value should be between 0 and 1. Changes to this setting only affect new sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensibilidad de la rueda del ratón para el desplazamiento horizontal.\nUsa 0 para desactivarlo. El valor debe estar entre 0 y 1. Los cambios de este ajuste solo afectan a las sesiones nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensibilité de la molette de la souris pour le défilement horizontal.\nUtilisez 0 pour désactiver. La valeur doit être comprise entre 0 et 1. Les modifications de ce réglage n’affectent que les nouvelles sessions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensibilità della rotellina del mouse per lo scorrimento orizzontale.\nUsa 0 per disabilitare. Il valore deve essere tra 0 e 1. Le modifiche a questa impostazione influiscono solo sulle nuove sessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平スクロールに対するマウスホイールの感度。\n無効にするには 0 を指定してください。値は 0 から 1 の間で指定します。この設定への変更は新しいセッションにのみ影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로 스크롤에 대한 마우스 휠 감도\n끄려면 0을 사용하십시오. 값은 0과 1 사이여야 합니다. 이 설정의 변경 사항은 새로운 세션에만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensibilidade da roda do mouse para rolagem horizontal.\nUse 0 para desativar. O valor deve estar entre 0 e 1. Alterações neste ajuste só afetam novas sessões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чувствительность колеса мыши для горизонтальной прокрутки.\nИспользуйте 0, чтобы отключить. Значение должно быть между 0 и 1. Изменения этой настройки влияют только на новые сессии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatay kaydırma için fare tekerleği duyarlılığı.\nDevre dışı bırakmak için 0 kullanın. Değer 0 ile 1 arasında olmalıdır. Bu ayardaki değişiklikler yalnızca yeni oturumları etkiler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠标滚轮用于水平滚动的灵敏度。\n设为0可禁用该功能。数值应在0到1之间。此设置仅对新建会话生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平捲動時滑鼠滾輪的靈敏度。\n使用 0 可停用。值應介於 0 到 1 之間。變更此設定只會影響新的工作階段。"
          }
        }
      }
    },
