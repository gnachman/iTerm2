    "Tip.0093.Body" : {
      "comment" : "Tip of the day body, id 0093",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte přiřazení kláves jednotně ve více relacích pro konzistentní ovládání v různých panelech nebo oknech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anvend tastetildelinger ensartet på tværs af flere sessioner for konsekvent styring i forskellige faner eller vinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenden Sie Tastenzuordnungen einheitlich über mehrere Sitzungen hinweg an, um eine konsistente Steuerung in verschiedenen Tabs oder Fenstern zu gewährleisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apply key bindings uniformly across multiple sessions for consistent control in different tabs or windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica asignaciones de teclas de manera uniforme en varias sesiones para un control coherente en distintas pestañas o ventanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä näppäinmäärityksiä yhtenäisesti useissa istunnoissa, jotta hallinta on johdonmukaista eri välilehdissä tai ikkunoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquez des associations de touches de manière uniforme à plusieurs sessions pour un contrôle cohérent dans différents onglets ou fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica le associazioni tasti in modo uniforme a più sessioni per un controllo coerente in pannelli o finestre diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のセッションに一律にキーバインディングを適用することで、異なるタブやウィンドウでも一貫した操作ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 세션에 키 바인딩을 일괄 적용하여 서로 다른 탭이나 윈도우에서도 일관되게 제어할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk tastetilordninger ensartet på tvers av flere økter for konsekvent kontroll i ulike faner eller vinduer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas toetstoewijzingen uniform toe op meerdere sessies voor consistente bediening in verschillende tabbladen of vensters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stosuj przypisania klawiszy jednolicie w wielu sesjach, aby zachować spójną obsługę w różnych kartach i oknach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplique atalhos de teclado de maneira uniforme em várias sessões para um controle consistente em diferentes abas ou janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяйте привязки клавиш единообразно к нескольким сессиям для согласованного управления в разных вкладках или окнах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použite priradenia klávesov jednotne vo viacerých reláciách pre konzistentné ovládanie v rôznych tabech alebo oknách."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodelitve tipk enotno uveljavite v več sejah za dosleden nadzor v različnih zavihkih ali oknih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillämpa tangentkopplingar enhetligt över flera sessioner för konsekvent styrning i olika flikar eller fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı sekmelerde veya pencerelerde tutarlı denetim için tuş atamalarını birden çok oturumda aynı şekilde uygulayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áp dụng gán phím đồng nhất trên nhiều phiên để điều khiển nhất quán ở các tab hoặc cửa sổ khác nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多个标签页或窗口中统一应用按键绑定，以实现一致控制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多個工作階段中統一套用按鍵對應，讓不同標籤頁或視窗中的操作保持一致。"
          }
        }
      }
    },
