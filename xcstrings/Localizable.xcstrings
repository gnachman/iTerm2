    "SCPFile.KnownHostsUnreadable" : {
      "comment" : "Warning shown when the known_hosts file cannot be read; first %@ is the host, second %@ is the key hash type, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor known_hosts se nepodařilo přečíst.\nProto nelze ověřit pravost hostitele „%1$@“. Otisk klíče %2$@ je %3$@. Přesto se připojit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke læse arkivet known_hosts.\nDerfor kan værten “%1$@” ikke godkendes som ægte. Fingeraftrykket for %2$@-nøglen er %3$@. Vil du oprette forbindelse alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei known_hosts konnte nicht gelesen werden.\nDaher kann die Authentizität des Hosts '%1$@' nicht festgestellt werden. Der %2$@-Schlüssel-Fingerabdruck lautet %3$@. Trotzdem verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read the known_hosts file.\nAs a result, the authenticity of host '%1$@' can't be established.%2$@ key fingerprint is %3$@. Connect anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el archivo known_hosts.\nPor ello, no se puede establecer la autenticidad del host “%1$@”. La huella de la clave %2$@ es %3$@. ¿Conectar de todos modos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostoa known_hosts ei voitu lukea.\nSiksi palvelimen ”%1$@” aitoutta ei voida varmistaa. %2$@-avaimen sormenjälki on %3$@. Yhdistetäänkö silti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le fichier known_hosts.\nPar conséquent, l’authenticité de l’hôte « %1$@ » ne peut pas être établie. L’empreinte de la clé %2$@ est %3$@. Se connecter quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il file known_hosts.\nDi conseguenza, non è possibile stabilire l’autenticità dell’host “%1$@”. L’impronta della chiave %2$@ è %3$@. Connettersi comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hostsファイルを読み込めませんでした。\nそのため、ホスト '%1$@' の信頼性を確認できません。%2$@ 鍵のフィンガープリントは %3$@ です。このまま接続しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hosts 파일을 읽을 수 없습니다.\n따라서 호스트 '%1$@'의 진위를 확인할 수 없습니다.%2$@ 키 지문은 %3$@입니다. 그래도 연결하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese filen known_hosts.\nDerfor er det ikke mulig å fastslå om verten «%1$@» er ekte. Nøkkelfingeravtrykket for %2$@ er %3$@. Vil du koble til likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan het bestand known_hosts niet lezen.\nDaardoor kan de authenticiteit van host ‘%1$@’ niet worden vastgesteld. De vingerafdruk van de %2$@-sleutel is %3$@. Toch verbinden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać pliku known_hosts.\nW związku z tym nie można ustalić autentyczności hosta „%1$@”. Odcisk klucza %2$@ to %3$@. Połączyć mimo to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o arquivo known_hosts.\nComo resultado, não é possível estabelecer a autenticidade do host “%1$@”.A impressão digital da chave %2$@ é %3$@. Conectar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать файл known_hosts.\nВ результате невозможно установить подлинность узла «%1$@». Отпечаток ключа %2$@: %3$@. Всё равно подключиться?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Súbor known_hosts sa nepodarilo prečítať.\nPreto sa nedá overiť pravosť hostiteľa „%1$@“. Odtlačok kľúča %2$@ je %3$@. Pripojiť sa aj tak?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datoteke known_hosts ni bilo mogoče prebrati.\nZato pristnosti gostitelja »%1$@« ni mogoče ugotoviti. Prstni odtis ključa %2$@ je %3$@. Želite kljub temu vzpostaviti povezavo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan inte läsa filen known_hosts.\nDärför kan värden ”%1$@” inte autentiseras. Nyckelns %2$@-fingeravtryck är %3$@. Vill du ansluta ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "known_hosts dosyası okunamadı.\nBu nedenle “%1$@” ana makinesinin gerçekliği doğrulanamıyor. %2$@ anahtar parmak izi: %3$@. Yine de bağlanılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc tệp known_hosts.\nDo đó, không thể xác lập tính xác thực của máy chủ “%1$@”. Dấu vân tay khóa %2$@ là %3$@. Vẫn kết nối?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 known_hosts 文件。\n因此，无法确认主机 '%1$@' 的真实性。%2$@ 密钥指纹为 %3$@。是否仍要连接？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 known_hosts 檔案。\n因此無法確認主機「%1$@」的真實性。%2$@ 金鑰指紋為 %3$@。仍要連線嗎？"
          }
        }
      }
    },
