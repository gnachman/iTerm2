    "Companion.PhoneApp.BetaBody" : {
      "comment" : "Explanatory paragraph shown for beta builds on the phone-app install screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist eine Beta-Version, daher wird iTerm2 Buddy über TestFlight verteilt. Installieren Sie TestFlight und treten Sie dann der Beta bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is a beta build, so iTerm2 Buddy is distributed through TestFlight. Install TestFlight, then join the beta."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una compilación beta, por lo que iTerm2 Buddy se distribuye mediante TestFlight. Instala TestFlight y luego únete a la beta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est une version bêta, iTerm2 Buddy est donc distribué via TestFlight. Installez TestFlight, puis rejoignez la bêta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una build beta, quindi iTerm2 Buddy viene distribuito tramite TestFlight. Installa TestFlight, poi unisciti alla beta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはベータビルドのため、iTerm2 BuddyはTestFlightを通じて配布されています。TestFlightをインストールしてから、ベータ版に参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베타 빌드이므로 iTerm2 Buddy는 TestFlight를 통해 배포됩니다. TestFlight를 설치한 다음 베타에 참여하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é uma versão beta, então o iTerm2 Buddy é distribuído pelo TestFlight. Instale o TestFlight e, em seguida, participe do beta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это бета-сборка, поэтому iTerm2 Buddy распространяется через TestFlight. Установите TestFlight, а затем присоединитесь к бета-тестированию."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir beta sürümü olduğundan iTerm2 Buddy, TestFlight üzerinden dağıtılıyor. TestFlight’ı yükleyin, ardından beta sürümüne katılın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是测试版版本，因此 iTerm2 Buddy 通过 TestFlight 分发。请安装 TestFlight，然后参与测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是測試版，因此 iTerm2 Buddy 透過 TestFlight 發行。請安裝 TestFlight，然後加入測試。"
          }
        }
      }
    },
    "Companion.PhoneApp.Body" : {
      "comment" : "Explanatory paragraph on the phone-app install screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopplung verbindet diesen Mac mit der iTerm2-Buddy-App auf Ihrem iPhone. Installieren Sie sie jetzt und kehren Sie dann hierher zurück, um fortzufahren."
