          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení k %1$@:%2$d se nezdařilo. Zkontrolujte, zda je název hostitele správný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ikke oprette forbindelse til %1$@:%2$d. Kontroller, at værtsnavnet er korrekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zu %1$@:%2$d fehlgeschlagen. Überprüfen Sie, ob der Hostname korrekt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Failed to connect to %1$@:%2$d. Double-check that the host name is correct."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con %1$@:%2$d. Comprueba que el nombre de host sea correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistäminen palvelimeen %1$@:%2$d epäonnistui. Tarkista, että palvelinnimi on oikein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la connexion à %1$@:%2$d. Vérifiez que le nom d’hôte est correct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile connettersi a %1$@:%2$d. Controlla che il nome host sia corretto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@:%2$d への接続に失敗しました。ホスト名が正しいか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@:%2$d에 연결하지 못했습니다. 호스트 이름이 올바른지 다시 확인하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke koble til %1$@:%2$d. Kontroller at vertsnavnet er riktig."
