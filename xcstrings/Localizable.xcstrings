          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшенная поддержка редакторов методов ввода, таких как AquaSKK."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AquaSKK gibi girdi yöntemi düzenleyicileri için iyileştirilmiş destek."
          }
        },
        "zh-Hans" : {
