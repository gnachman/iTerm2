    "AdvancedSetting.noSyncNeverAskAboutMouseReportingFrustration" : {
      "comment" : "Advanced setting: noSyncNeverAskAboutMouseReportingFrustration",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat oznámení s dotazem, zda chcete vypnout hlášení myši, které se zobrazí po tažení následovaném Cmd-C při zapnutém hlášení myši?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul notifikationen, der spørger, om du vil slå rapportering af mus fra, og som vises efter et træk efterfulgt af Kommando-C, når rapportering af mus er slået til?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Benachrichtigung unterdrücken, die nach einem Ziehen gefolgt von Cmd-C bei aktivierter Mausmeldung angezeigt wird und fragt, ob Sie die Mausmeldung deaktivieren möchten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress the notification asking if you want to disable mouse reporting that is shown after a drag followed by Cmd-C when mouse reporting is on?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Suprimir la notificación que pregunta si quieres desactivar el informe del ratón, que se muestra tras un arrastre seguido de Cmd-C cuando el informe del ratón está activado?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaimennetaanko ilmoitus, joka kysyy, haluatko poistaa hiiren raportoinnin käytöstä ja joka näytetään vedon ja Cmd-C:n jälkeen, kun hiiren raportointi on päällä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver la notification demandant si vous voulez désactiver le signalement de la souris, affichée après un glissement suivi de Cmd-C lorsque le signalement de la souris est activé ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivare la notifica che chiede se vuoi disabilitare la segnalazione del mouse, mostrata dopo un trascinamento seguito da Cmd-C quando la segnalazione del mouse è attiva?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウス報告が有効な状態でドラッグの後にCmd-Cを行った際に表示される、マウス報告を無効にするかどうかを尋ねる通知を表示しない？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅이 켜져 있을 때 드래그 후 Cmd-C를 누르면 표시되는, 마우스 리포팅을 끌지 묻는 알림을 숨기겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis varselet som spør om du vil deaktivere musrapportering, som vises etter en dragning etterfulgt av ⌘C når musrapportering er på?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk de melding waarin wordt gevraagd of je muisrapportage wilt uitschakelen, die verschijnt na slepen gevolgd door Cmd-C terwijl muisrapportage aan staat?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy nie pokazywać powiadomienia z pytaniem, czy wyłączyć raportowanie myszy, wyświetlanego po przeciągnięciu, po którym następuje Cmd-C, gdy raportowanie myszy jest włączone?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir a notificação que pergunta se você deseja desativar o relato de mouse, exibida após um arrasto seguido de Cmd-C quando o relato de mouse está ativado?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить уведомление с вопросом, хотите ли вы отключить сообщения о мыши, которое показывается после перетаскивания и последующего Cmd-C, если сообщения о мыши включены?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať hlásenie s otázkou, či chcete vypnúť hlásenie myši, ktoré sa zobrazí po potiahnutí nasledovanom skratkou Cmd-C, keď je hlásenie myši zapnuté?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži obvestila, ki vpraša, ali želite onemogočiti poročanje miške, prikazanega po vlečenju in ukazu Cmd-C, ko je poročanje miške vklopljeno?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj notisen som frågar om du vill avaktivera musrapportering och som visas efter en dragning följd av ⌘C när musrapportering är på?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare raporlaması açıkken bir sürüklemenin ardından Cmd-C yapıldığında görünen, fare raporlamasını devre dışı bırakmak isteyip istemediğinizi soran bildirim bir daha gösterilmesin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị thông báo hỏi có muốn tắt báo cáo chuột, vốn hiện ra sau khi kéo rồi nhấn Cmd-C khi báo cáo chuột đang bật?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制在鼠标报告开启后，拖拽后按Cmd-C显示的鼠标报告禁用提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示詢問是否停用滑鼠回報的通知（滑鼠回報開啟時，拖移後按 Cmd-C 會顯示此通知）？"
          }
        }
      }
    },
