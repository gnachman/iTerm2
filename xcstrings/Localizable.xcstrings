            "value" : "Aynı ada sahip bir dosya veya klasör zaten var. Değiştirirseniz mevcut içeriğinin üzerine yazılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存在同名文件或文件夹。替换它会覆盖其当前内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有同名的檔案或檔案夾。取代後將覆寫其目前的內容。"
          }
        }
      }
    },
    "SavePanel.ExistsHeading" : {
      "comment" : "Heading of the overwrite confirmation; placeholder is the filename",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ existiert bereits. Möchten Sie sie ersetzen oder anhängen?"
          }
