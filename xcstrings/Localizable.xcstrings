    "Tip.0076.Body" : {
      "comment" : "Tip of the day body, id 0076",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können unter „Einstellungen > Profile > Allgemein > Titel“ festlegen, welche Elemente in Sitzungstiteln enthalten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can configure which elements are present in session titles in “Settings > Profiles > General > Title.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes configurar qué elementos aparecen en los títulos de sesión en “Ajustes > Perfiles > General > Título”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez configurer les éléments présents dans les titres de session dans « Réglages > Profils > Général > Titre »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi configurare quali elementi compaiono nei titoli delle sessioni in “Impostazioni > Profili > Generali > Titolo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > 一般 > タイトル」で、セッションタイトルにどの要素を表示するかを設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 제목에 표시할 요소는 “설정 > 프로파일 > 일반 > 제목”에서 구성할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar quais elementos aparecem nos títulos de sessão em “Ajustes > Perfis > Geral > Título”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить, какие элементы отображаются в заголовках сессий, в «Настройки > Профили > Общие > Заголовок»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum başlıklarında hangi öğelerin bulunacağını “Ayarlar > Profiller > Genel > Başlık” bölümünden yapılandırabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在“设置 > 配置文件 > 通用 > 标题”中配置会话标题中包含的元素。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在「設定 > 描述檔 > 一般 > 標題」中，設定工作階段標題要包含哪些元素。"
          }
        }
      }
    },
