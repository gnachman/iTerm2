    "EventTrigger.Help.ActivityAfterIdle" : {
      "comment" : "Help text for the Activity After Idle event trigger",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí se, když se výstup obnoví po nečinnosti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløses, når output genoptages efter at have været passivt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ausgelöst, wenn die Ausgabe nach einer Ruhephase fortgesetzt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fires when output resumes after being idle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dispara cuando se reanuda la salida tras un periodo de inactividad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukeaa, kun tuloste jatkuu toimettomuuden jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déclenche quand la sortie reprend après une période d’inactivité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si attiva quando l’output riprende dopo un periodo di inattività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイドル状態の後に出力が再開すると発火します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유휴 상태 후 출력이 다시 시작되면 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløses når utdata gjenopptas etter inaktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt geactiveerd wanneer de uitvoer hervat na inactiviteit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzwala się, gdy wyjście wznawia się po bezczynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara quando a saída é retomada após ficar ociosa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает, когда вывод возобновляется после простоя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí sa, keď sa výstup obnoví po období nečinnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sproži se, ko se izhod nadaljuje po nedejavnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utlöses när utdata återupptas efter inaktivitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşta kaldıktan sonra çıktı yeniden başladığında tetiklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích hoạt khi đầu ra tiếp tục sau thời gian không hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空闲后恢复输出时触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閒置後恢復輸出時觸發。"
          }
        }
      }
    },
