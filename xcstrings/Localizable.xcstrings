    "AIModelCatalogUpdater.ConsentBody" : {
      "comment" : "Body text of the dialog asking whether to periodically check for AI model list updates",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann seine integrierte Liste der KI-Modelle aktuell halten, indem es regelmäßig eine kryptografisch signierte Liste von iterm2.com herunterlädt. Dabei werden keine Terminal-Inhalte oder persönlichen Daten gesendet. Möchten Sie dies erlauben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can keep its built-in list of AI models current by periodically downloading a cryptographically signed list from iterm2.com. No terminal content or personal data is sent. Allow this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 puede mantener actualizada su lista integrada de modelos de IA descargando periódicamente desde iterm2.com una lista firmada criptográficamente. No se envía contenido de la terminal ni datos personales. ¿Quieres permitirlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut tenir à jour sa liste intégrée de modèles d’IA en téléchargeant périodiquement depuis iterm2.com une liste signée cryptographiquement. Aucun contenu du terminal ni donnée personnelle n’est envoyé. Autoriser cette opération ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può mantenere aggiornato il proprio elenco integrato di modelli IA scaricando periodicamente da iterm2.com un elenco firmato crittograficamente. Non vengono inviati contenuti del terminale né dati personali. Vuoi consentirlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、iterm2.comから暗号署名付きのリストを定期的にダウンロードすることで、組み込みのAIモデル一覧を最新の状態に保つことができます。ターミナルの内容や個人データは送信されません。これを許可しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 iterm2.com에서 암호화 서명된 목록을 주기적으로 다운로드하여 내장 AI 모델 목록을 최신 상태로 유지할 수 있습니다. 터미널 내용이나 개인 데이터는 전송되지 않습니다. 허용하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 pode manter sua lista integrada de modelos de IA atualizada baixando periodicamente uma lista assinada criptograficamente de iterm2.com. Nenhum conteúdo do terminal ou dado pessoal é enviado. Permitir isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 может обновлять встроенный список моделей ИИ, периодически загружая криптографически подписанный список с iterm2.com. Содержимое терминала и личные данные при этом не передаются. Разрешить это?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, iterm2.com adresinden kriptografik olarak imzalanmış bir liste indirerek yerleşik YZ modelleri listesini düzenli olarak güncel tutabilir. Terminal içeriği veya kişisel veri gönderilmez. İzin verilsin mi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以定期从 iterm2.com 下载经过加密签名的列表，以保持内置 AI 模型列表的最新状态。不会发送任何终端内容或个人数据。允许吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 可以定期從 iterm2.com 下載經過加密簽署的清單，以保持內建 AI 模型清單為最新狀態。不會傳送任何終端機內容或個人資料。要允許嗎？"
          }
        }
      }
    },
    "AIModelCatalogUpdater.ConsentHeading" : {
      "comment" : "Heading of the dialog asking whether to periodically check for AI model list updates",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
