    "Tip.0042.Body" : {
      "comment" : "Tip of the day body, id 0042",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel můžete rozdělit na více podoken pomocí ⌘D a ⇧⌘D."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan opdele en fane i flere ruder med ⌘D og ⇧⌘D."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können einen Tab mit ⌘D und ⇧⌘D in mehrere Bereiche aufteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can split a tab into multiple panes with ⌘D and ⇧⌘D."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes dividir una pestaña en varios paneles con ⌘D y ⇧⌘D."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit jakaa välilehden useaan paneeliin näppäimillä ⌘D ja ⇧⌘D."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez scinder un onglet en plusieurs volets avec ⌘D et ⇧⌘D."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi dividere un pannello in più riquadri con ⌘D e ⇧⌘D."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Dと⇧⌘Dを使うと、タブを複数のペインに分割できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘D 및 ⇧⌘D로 탭을 여러 패널로 분할할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan dele en fane i flere ruter med ⌘D og ⇧⌘D."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt een tabblad splitsen in meerdere panelen met ⌘D en ⇧⌘D."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz podzielić kartę na wiele paneli skrótami ⌘D i ⇧⌘D."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode dividir uma aba em vários painéis com ⌘D e ⇧⌘D."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете разделить вкладку на несколько панелей с помощью ⌘D и ⇧⌘D."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab môžete rozdeliť na viac panelov pomocou ⌘D a ⇧⌘D."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavihek lahko razdelite na več podoken z ⌘D in ⇧⌘D."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan dela en flik i flera paneler med ⌘D och ⇧⌘D."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sekmeyi ⌘D ve ⇧⌘D ile birden çok bölmeye bölebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể chia một tab thành nhiều khung bằng ⌘D và ⇧⌘D."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以使用 ⌘D 和 ⇧⌘D 将标签页拆分为多个窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以使用 ⌘D 和 ⇧⌘D 將標籤頁分割成多個窗格。"
          }
        }
      }
    },
