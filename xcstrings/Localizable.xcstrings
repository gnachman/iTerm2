    "SCPFile.AuthenticityUnknown" : {
      "comment" : "Prompt shown when connecting to a host for the first time; first %@ is the host, second %@ is the key hash type, third %@ is the fingerprint",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze ověřit pravost hostitele „%1$@“.\n\nOtisk klíče %2$@ je %3$@.\n\nPřesto se připojit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værten “%1$@” kan ikke godkendes som ægte.\n\nFingeraftrykket for %2$@-nøglen er %3$@.\n\nVil du oprette forbindelse alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Authentizität des Hosts '%1$@' kann nicht festgestellt werden.\n\nDer %2$@-Schlüssel-Fingerabdruck lautet %3$@.\n\nTrotzdem verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The authenticity of host '%1$@' can't be established.\n\n%2$@ key fingerprint is %3$@.\n\nConnect anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede establecer la autenticidad del host “%1$@”.\n\nLa huella de la clave %2$@ es %3$@.\n\n¿Conectar de todos modos?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelimen ”%1$@” aitoutta ei voida varmistaa.\n\n%2$@-avaimen sormenjälki on %3$@.\n\nYhdistetäänkö silti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authenticité de l’hôte « %1$@ » ne peut pas être établie.\n\nL’empreinte de la clé %2$@ est %3$@.\n\nSe connecter quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile stabilire l’autenticità dell’host “%1$@”.\n\nL’impronta della chiave %2$@ è %3$@.\n\nConnettersi comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト '%1$@' の信頼性を確認できません。\n\n%2$@ 鍵のフィンガープリントは %3$@ です。\n\nこのまま接続しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 '%1$@'의 진위를 확인할 수 없습니다.\n\n%2$@ 키 지문은 %3$@입니다.\n\n그래도 연결하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke mulig å fastslå om verten «%1$@» er ekte.\n\nNøkkelfingeravtrykket for %2$@ er %3$@.\n\nVil du koble til likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De authenticiteit van host ‘%1$@’ kan niet worden vastgesteld.\n\nDe vingerafdruk van de %2$@-sleutel is %3$@.\n\nToch verbinden?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można ustalić autentyczności hosta „%1$@”.\n\nOdcisk klucza %2$@ to %3$@.\n\nPołączyć mimo to?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível estabelecer a autenticidade do host “%1$@”.\n\nA impressão digital da chave %2$@ é %3$@.\n\nConectar mesmo assim?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно установить подлинность узла «%1$@».\n\nОтпечаток ключа %2$@: %3$@.\n\nВсё равно подключиться?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravosť hostiteľa „%1$@“ sa nedá overiť.\n\nOdtlačok kľúča %2$@ je %3$@.\n\nPripojiť sa aj tak?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristnosti gostitelja »%1$@« ni mogoče ugotoviti.\n\nPrstni odtis ključa %2$@ je %3$@.\n\nŽelite kljub temu vzpostaviti povezavo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värden ”%1$@” kan inte autentiseras.\n\nNyckelns %2$@-fingeravtryck är %3$@.\n\nVill du ansluta ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ana makinesinin gerçekliği doğrulanamıyor.\n\n%2$@ anahtar parmak izi: %3$@.\n\nYine de bağlanılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác lập tính xác thực của máy chủ “%1$@”.\n\nDấu vân tay khóa %2$@ là %3$@.\n\nVẫn kết nối?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认主机 '%1$@' 的真实性。\n\n%2$@ 按键指纹为 %3$@。\n\n仍要连接吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認主機「%1$@」的真實性。\n\n%2$@ 金鑰指紋為 %3$@。\n\n仍要連線嗎？"
          }
        }
      }
    },
