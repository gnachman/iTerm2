          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt je een profiel te kiezen en splitst daarna de huidige sessie horizontaal, waarbij de nieuwe sessie in de onderste helft komt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi o wybranie profilu, a następnie dzieli bieżącą sesję poziomo i umieszcza nową sesję w dolnej połowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita que você selecione um perfil e depois divide a sessão atual horizontalmente, colocando a nova sessão na metade inferior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предлагает выбрать профиль, а затем разделяет текущую сессию по горизонтали, помещая новую сессию в нижнюю половину."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzve vás na výber profilu a potom rozdelí aktuálnu reláciu vodorovne, pričom novú reláciu umiestni do dolnej polovice."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozove vas, da izberete profil, nato pa trenutno sejo razdeli vodoravno in novo sejo postavi v spodnjo polovico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ber dig välja en profil och delar sedan den aktuella sessionen horisontellt, med den nya sessionen i den nedre halvan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir profil seçmenizi ister, ardından geçerli oturumu yatay olarak böler ve yeni oturumu alt yarıya yerleştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhắc bạn chọn một hồ sơ rồi chia phiên hiện tại theo chiều ngang, đặt phiên mới ở nửa dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示你选择配置文件，然后水平分割当前会话，将新会话放在下半部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示你選擇描述檔，然後將目前的工作階段水平分割，並將新的工作階段放在下半部。"
          }
        }
      }
    },
    "MenuTip.SplitVerticallywithCurrentProfile" : {
      "comment" : "Menu item help for the ‘Split Vertically with Current Profile’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělí aktuální relaci svisle a novou relaci umístí do pravé poloviny. Nová relace převezme profil aktuální relace, včetně změn provedených v `Relace > Upravit relaci`."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdeler den aktuelle session lodret og placerer en ny session i den højre halvdel. Den nye session arver den aktuelle sessions profil, inklusive ændringer foretaget under `Session > Rediger session`."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt die aktuelle Sitzung vertikal, wobei eine neue Sitzung in der rechten Hälfte platziert wird. Die neue Sitzung übernimmt das Profil der aktuellen Sitzung, einschließlich aller Änderungen, die unter `Session > Edit Session` vorgenommen wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Splits the current session vertically, placing a new session in the right half. The new session inherits the profile of the current session, including any changes made in `Session > Edit Session`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide la sesión actual verticalmente y coloca una sesión nueva en la mitad derecha. La sesión nueva hereda el perfil de la sesión actual, incluidos los cambios hechos en `Sesión > Editar sesión`."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakaa nykyisen istunnon pystysuunnassa ja sijoittaa uuden istunnon oikeaan puoliskoon. Uusi istunto perii nykyisen istunnon profiilin, mukaan lukien kohdassa `Istunto > Muokkaa istuntoa` tehdyt muutokset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scinde la session actuelle verticalement et place la nouvelle session dans la moitié droite. La nouvelle session hérite du profil de la session actuelle, y compris des modifications faites dans `Session > Modifier la session`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide verticalmente la sessione corrente, ponendo la nuova sessione nella metà destra. La nuova sessione eredita il profilo di quella corrente, comprese le modifiche fatte in `Sessione > Modifica sessione`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のセッションを垂直に分割し、新しいセッションを右半分に配置します。新しいセッションは、`セッション > セッションを編集`で行った変更を含め、現在のセッションのプロファイルを引き継ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 세션을 세로로 분할하여 오른쪽 절반에 새로운 세션을 배치합니다. 새로운 세션은 `세션 > 세션 편집`에서 변경한 내용을 포함하여 현재 세션의 프로파일을 상속합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deler gjeldende økt vertikalt og plasserer en ny økt i høyre halvdel. Den nye økten arver profilen til gjeldende økt, inkludert endringer gjort i «Økt > Rediger økt»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Splitst de huidige sessie verticaal en plaatst een nieuwe sessie in de rechterhelft. De nieuwe sessie erft het profiel van de huidige sessie, inclusief alle wijzigingen die in `Sessie > Wijzig sessie…` zijn aangebracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzieli bieżącą sesję pionowo i umieszcza nową sesję w prawej połowie. Nowa sesja dziedziczy profil bieżącej sesji, w tym zmiany wprowadzone w `Sesja > Edytuj sesję`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide a sessão atual verticalmente, colocando uma nova sessão na metade direita. A nova sessão herda o perfil da sessão atual, incluindo quaisquer alterações feitas em `Sessão > Editar sessão`."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разделяет текущую сессию по вертикали, помещая новую сессию в правую половину. Новая сессия наследует профиль текущей сессии, включая любые изменения, внесённые в `Session > Edit Session`."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdelí aktuálnu reláciu zvisle a novú reláciu umiestni do pravej polovice. Nová relácia zdedí profil aktuálnej relácie vrátane všetkých zmien vykonaných v `Relácia > Upraviť reláciu`."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutno sejo razdeli navpično, novo sejo pa postavi v desno polovico. Nova seja podeduje profil trenutne seje, vključno z vsemi spremembami, narejenimi v »Seja > Uredi sejo«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delar den aktuella sessionen vertikalt och placerar en ny session i den högra halvan. Den nya sessionen ärver den aktuella sessionens profil, inklusive ändringar som gjorts i `Session > Redigera session`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli oturumu dikey olarak böler ve yeni oturumu sağ yarıya yerleştirir. Yeni oturum, `Oturum > Oturumu Düzenle` ile yapılan değişiklikler dahil, geçerli oturumun profilini devralır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia phiên hiện tại theo chiều dọc, đặt phiên mới ở nửa bên phải. Phiên mới kế thừa hồ sơ của phiên hiện tại, kể cả mọi thay đổi thực hiện trong `Phiên > Sửa phiên`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "垂直分割当前会话，将新会话放在右侧半部分。新会话会继承当前会话的配置文件，包括 `Session > Edit Session`中的任何更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將目前的工作階段垂直分割，並將新的工作階段放在右半部。新的工作階段會繼承目前工作階段的描述檔，包括在 「工作階段 > 編輯工作階段」 中所做的任何變更。"
          }
        }
      }
    },
    "MenuTip.SplitVertically…" : {
      "comment" : "Menu item help for the ‘Split Vertically…’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
