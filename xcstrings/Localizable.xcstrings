    "RemotePreferences.SyncDataFilesPrompt" : {
      "comment" : "Prompt asking whether to also sync data files to the settings folder; %@ is the folder path",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 může také ukládat vaše úryvky, globální poznámky a úpravy ikon relací do složky nastavení „%@“, aby se synchronizovaly mezi počítači. Poznámky a úryvky mohou obsahovat citlivý text, například hesla nebo tokeny. Synchronizovat i je?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan også gemme dine tekststykker, globale noter og tilpasninger af sessionssymboler i indstillingsmappen “%@”, så de synkroniseres mellem computere. Noter og tekststykker kan indeholde følsom tekst som adgangskoder eller tokens. Vil du synkronisere dem også?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann außerdem Ihre Schnipsel, globalen Notizen und Sitzungssymbol-Anpassungen im Einstellungsordner „%@“ aufbewahren, damit sie zwischen Rechnern synchronisiert werden. Notizen und Schnipsel können vertrauliche Texte wie Passwörter oder Tokens enthalten. Sollen auch diese synchronisiert werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can also keep your snippets, global notes, and session icon customizations in the settings folder “%@” so they sync across machines. Notes and snippets can contain sensitive text such as passwords or tokens. Sync them too?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 también puede guardar tus fragmentos, notas globales y personalizaciones de iconos de sesión en la carpeta de ajustes “%@” para que se sincronicen entre equipos. Las notas y los fragmentos pueden contener texto sensible, como contraseñas o tokens. ¿Sincronizarlos también?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 voi myös säilyttää katkelmasi, yleiset muistiinpanosi ja istuntokuvakkeiden mukautukset asetuskansiossa ”%@”, jolloin ne synkronoituvat koneiden välillä. Muistiinpanot ja katkelmat voivat sisältää arkaluonteista tekstiä, kuten salasanoja tai tokeneita. Synkronoidaanko nekin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 peut aussi conserver vos extraits, notes globales et personnalisations d’icônes de session dans le dossier de réglages « %@ » pour les synchroniser entre vos machines. Les notes et extraits peuvent contenir du texte sensible, comme des mots de passe ou des jetons. Les synchroniser aussi ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 può anche conservare i tuoi frammenti, le note globali e le personalizzazioni delle icone delle sessioni nella cartella delle impostazioni “%@”, così da sincronizzarli tra computer. Note e frammenti possono contenere testo sensibile come password o token. Sincronizzare anche questi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 では、スニペット、グローバルメモ、セッションアイコンのカスタマイズも設定フォルダ「%@」に保存し、複数のマシン間で同期することができます。メモやスニペットにはパスワードやトークンなどの機密情報が含まれる場合があります。これらも同期しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2는 스니펫, 전역 메모, 세션 아이콘 사용자화도 설정 폴더 “%@”에 보관하여 여러 컴퓨터 간에 동기화할 수 있습니다. 메모와 스니펫에는 암호나 토큰 같은 민감한 텍스트가 포함될 수 있습니다. 이것들도 동기화하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan også lagre tekstbitene, de globale notatene og symboltilpasningene for økter i innstillingsmappen «%@», slik at de synkroniseres mellom maskiner. Notater og tekstbiter kan inneholde sensitiv tekst, som passord eller tokens. Vil du synkronisere dem også?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan je fragmenten, algemene notities en symboolaanpassingen van sessies ook bewaren in de instellingenmap ‘%@’, zodat ze worden gesynchroniseerd tussen computers. Notities en fragmenten kunnen gevoelige tekst bevatten, zoals wachtwoorden of tokens. Deze ook synchroniseren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 może też przechowywać twoje fragmenty kodu, notatki globalne i dostosowania ikon sesji w folderze ustawień „%@”, aby synchronizowały się między komputerami. Notatki i fragmenty kodu mogą zawierać dane wrażliwe, takie jak hasła lub tokeny. Synchronizować je także?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 também pode manter seus Fragmentos, notas globais e personalizações de ícone de sessão na pasta de ajustes “%@” para que sejam sincronizados entre máquinas. Notas e Fragmentos podem conter texto sensível, como senhas ou tokens. Sincronizá-los também?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 также может хранить ваши сниппеты, глобальные заметки и настройки значков сеансов в папке настроек «%@», чтобы синхронизировать их между компьютерами. Заметки и сниппеты могут содержать конфиденциальные данные, такие как пароли или токены. Синхронизировать их тоже?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 môže v priečinku nastavení „%@“ uchovávať aj vaše úryvky, globálne poznámky a prispôsobenia ikon relácií, aby sa synchronizovali medzi počítačmi. Poznámky a úryvky môžu obsahovať citlivý text, napríklad heslá alebo tokeny. Synchronizovať aj ich?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 lahko vaše izrezke, globalne zapiske in prilagoditve ikon sej shranjuje tudi v mapo z nastavitvami »%@«, da se sinhronizirajo med računalniki. Zapiski in izrezki lahko vsebujejo občutljivo besedilo, kot so gesla ali žetoni. Jih želite sinhronizirati tudi?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kan även spara dina textsnuttar, globala anteckningar och sessionssymbolanpassningar i inställningsmappen ”%@” så att de synkas mellan datorer. Anteckningar och textsnuttar kan innehålla känslig text, till exempel lösenord eller tokens. Vill du synka dem också?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2, parçacıklarınızı, genel notlarınızı ve oturum simgesi özelleştirmelerinizi makineler arasında eşitlenmeleri için “%@” ayar klasöründe de tutabilir. Notlar ve parçacıklar parola veya token gibi hassas metinler içerebilir. Bunlar da eşitlensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 cũng có thể lưu đoạn mã, ghi chú chung và tùy chỉnh biểu tượng phiên của bạn trong thư mục cài đặt “%@” để đồng bộ giữa các máy. Ghi chú và đoạn mã có thể chứa văn bản nhạy cảm như mật khẩu hoặc token. Đồng bộ cả những mục này?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 还可以将你的代码片段、全局笔记和会话图标自定义项保存在设置文件夹“%@”中，以便在机器之间同步。笔记和代码片段可能包含密码或令牌等敏感文本。也同步它们？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 也可以將你的片段、全域備註和工作階段圖像自訂內容保存在設定檔案夾「%@」中，以便在多部電腦之間同步。備註和片段可能含有密碼或權杖等敏感文字。要一併同步嗎？"
          }
        }
      }
    },
