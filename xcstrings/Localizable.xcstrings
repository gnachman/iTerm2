          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seleccionar pestañas al pulsar el botón del ratón?\nCambiar este ajuste no afectará a las ventanas existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionner les onglets à l’appui sur le bouton de la souris ?\nLa modification de ce réglage n’affectera pas les fenêtres existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selezionare i pannelli alla pressione del pulsante del mouse?\nLa modifica di questa impostazione non influirà sulle finestre esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスボタンを押した時点でタブを選択するか？\nこの設定の変更は既存のウィンドウには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 버튼을 누를 때 탭을 선택하겠습니까?\n이 설정을 변경해도 기존 윈도우에는 영향을 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar abas ao pressionar o mouse?\nAlterar este ajuste não afetará as janelas existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирать вкладки при нажатии кнопки мыши (mouse-down)?\nИзменение этого параметра не повлияет на уже открытые окна."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmeler fare düğmesine basıldığında seçilsin mi?\nBu ayarı değiştirmek mevcut pencereleri etkilemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠标按下时选择标签页？  \n更改此设置不会影响现有窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下滑鼠時選取標籤頁？\n變更此設定不會影響現有的視窗。"
          }
        }
      }
    },
    "AdvancedSetting.sensitiveScrollWheel" : {
