        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘を押しながらドラッグすると、矩形選択ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘를 누른 채 드래그하면 직사각형으로 선택할 수 있습니다."
          }
        },
        "pt-BR" : {
