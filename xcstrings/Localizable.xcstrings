    "AdvancedSetting.requireCmdForDraggingText" : {
      "comment" : "Advanced setting: requireCmdForDraggingText",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K přetažení obrázků nebo vybraného textu musíte podržet ⌘. Zabrání to nechtěnému přetažení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal holde ⌘ nede for at trække billeder eller markeret tekst. Det forhindrer utilsigtede træk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Bilder oder ausgewählten Text zu ziehen, müssen Sie ⌘ gedrückt halten. Dies verhindert versehentliches Ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
