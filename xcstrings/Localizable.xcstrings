    "PTYSession.ClipboardAccessDenied" : {
      "comment" : "Announcement that clipboard access was denied and how to enable it",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Terminal hat versucht, auf die Zwischenablage zuzugreifen, dies wurde jedoch verweigert. Aktivieren Sie den Zugriff auf die Zwischenablage unter „Einstellungen > Allgemein > Auswahl > Anwendungen im Terminal dürfen auf die Zwischenablage zugreifen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The terminal attempted to access the clipboard but it was denied. Enable clipboard access in “Settings > General > Selection > Applications in terminal may access clipboard”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルがクリップボードへのアクセスを試みましたが、拒否されました。「設定 > 一般 > 選択 > ターミナル内のアプリケーションによるクリップボードへのアクセスを許可」でクリップボードへのアクセスを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널이 클립보드에 접근하려 했지만 거부되었습니다. “설정 > 일반 > 선택 > 터미널의 응용 프로그램이 클립보드에 접근 허용”에서 클립보드 접근을 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O terminal tentou acessar a área de transferência, mas o acesso foi negado. Ative o acesso à área de transferência em “Ajustes > Geral > Seleção > Aplicativos no terminal podem acessar a área de transferência”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терминал попытался получить доступ к буферу обмена, но получил отказ. Включите доступ к буферу обмена в «Настройки > Общие > Выделение > Приложения в терминале могут обращаться к буферу обмена»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端尝试访问剪贴板但被拒绝。请在“设置 > 通用 > 选择 > 终端中的应用可以访问剪贴板”中启用剪贴板访问。"
          }
        }
      }
    },
