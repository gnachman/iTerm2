    "Tip.0056.Body" : {
      "comment" : "Tip of the day body, id 0056",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kontrollkästchen „Sofort“ in einem Trigger kann dieser bereits ausgelöst werden, während sich der Cursor noch in derselben Zeile wie der zu Ihrem regulären Ausdruck passende Text befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “instant” checkbox in a Trigger allows it to fire while the cursor is on the same line as the text that matches your regular expression."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casilla “Instantáneo” de un disparador permite que se active mientras el cursor está en la misma línea que el texto que coincide con tu expresión regular."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La case « instantané » d’un déclencheur lui permet de s’activer pendant que le curseur se trouve sur la même ligne que le texte correspondant à votre expression régulière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casella “istantaneo” di un attivatore gli permette di scattare mentre il cursore si trova sulla stessa riga del testo che corrisponde alla tua espressione regolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーの「即時」チェックボックスをオンにすると、正規表現に一致するテキストと同じ行にカーソルがある間もトリガーを発火させられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거의 ‘즉시’ 체크박스를 선택하면 정규 표현식과 일치하는 텍스트와 같은 줄에 커서가 있는 동안에도 트리거가 실행됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa de seleção “instantâneo” em um gatilho permite que ele seja acionado enquanto o cursor está na mesma linha do texto que corresponde à sua expressão regular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флажок «мгновенно» в триггере позволяет ему срабатывать, пока курсор находится на той же строке, что и текст, соответствующий регулярному выражению."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Tetikleyici’deki “anında” onay kutusu, imleç düzenli ifadenizle eşleşen metinle aynı satırdayken tetiklenmesini sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Trigger 中的“即时”复选框允许在光标位于与正则表达式匹配的文本同一行时触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觸發器中的「即時」核取方塊，可讓觸發器在游標與符合正規表示式的文字位於同一行時就觸發。"
          }
        }
      }
    },
