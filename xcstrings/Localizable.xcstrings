    "MenuTip.StartInstantReplay" : {
      "comment" : "Menu item help for the ‘Start Instant Replay’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Okamžité přehrání** umožňuje prohlédnout si nedávnou historii terminálu. Hodí se, když něco právě zmizelo z obrazovky a není to v historii posouvání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med **Øjeblikkelig genafspilning** kan du gennemse den seneste terminalhistorik. Det er praktisk, hvis noget lige er forsvundet fra skærmen, og det ikke findes i rullebufferen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sofortwiedergabe** ermöglicht es Ihnen, die letzte Terminal-Historie noch einmal anzusehen. Praktisch, wenn gerade etwas vom Bildschirm verschwunden ist und es sich nicht im Scrollback-Verlauf befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Instant Replay** lets you review recent terminal history. It’s handy if something just disappeared from the screen and it isn’t in scrollback history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **repetición instantánea** te permite revisar el historial reciente de la terminal. Es útil si algo acaba de desaparecer de la pantalla y no está en el historial de desplazamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pikatoisto** antaa tarkastella päätteen viimeaikaista historiaa. Se on kätevä, jos jokin katosi juuri näytöltä eikä ole vierityshistoriassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **relecture instantanée** permet de revoir l’historique récent du terminal. C’est pratique si quelque chose vient de disparaître de l’écran et ne figure pas dans l’historique de défilement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il **replay istantaneo** ti permette di rivedere la cronologia recente del terminale. È comodo se qualcosa è appena scomparso dallo schermo e non si trova nella cronologia di scorrimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**インスタントリプレイ**を使うと、最近のターミナル履歴を振り返ることができます。画面から消えてしまい、スクロールバック履歴にも残っていない内容を確認したいときに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**즉시 재생**을 사용하면 최근 터미널 기록을 다시 볼 수 있습니다. 무언가 방금 화면에서 사라졌는데 스크롤백 기록에 없을 때 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med **øyeblikkelig avspilling** kan du gå gjennom nylig terminalhistorikk. Det er praktisk hvis noe nettopp forsvant fra skjermen og ikke finnes i tilbakerullingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met **Directe herhaling** bekijk je de recente terminalgeschiedenis opnieuw. Handig als er net iets van het scherm is verdwenen en het niet in de scrollbackgeschiedenis staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Natychmiastowa powtórka** pozwala przejrzeć niedawną historię terminala. Przydaje się, gdy coś właśnie zniknęło z ekranu i nie ma tego w buforze przewijania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O **Instant Replay** permite revisar o histórico recente do terminal. É útil se algo acabou de desaparecer da tela e não está no histórico de rolagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Мгновенный повтор** позволяет просмотреть недавнюю историю терминала. Это удобно, если что-то только что исчезло с экрана и этого нет в истории прокрутки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Okamžité prehratie** vám umožňuje prezrieť si nedávnu históriu terminálu. Hodí sa, ak niečo práve zmizlo z obrazovky a nie je v histórii rolovania."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Takojšnje predvajanje** vam omogoča pregled nedavne zgodovine terminala. Je priročno, če je nekaj pravkar izginilo z zaslona in ni v zgodovini medpomnilnika za pomikanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med **Direktuppspelning** kan du gå igenom den senaste terminalhistoriken. Praktiskt om något just försvann från skärmen och inte finns i rullningshistoriken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Anında Tekrar**, yakın zamandaki terminal geçmişini gözden geçirmenizi sağlar. Ekrandan yeni kaybolan ve geri kaydırma geçmişinde olmayan bir şey için kullanışlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Phát lại tức thì** cho phép bạn xem lại lịch sử terminal gần đây. Rất tiện nếu có gì đó vừa biến mất khỏi màn hình mà không có trong cuộn ngược."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**即时回放**功能可让你查看最近的终端历史记录。如果某内容从屏幕上消失且不在滚动回放记录中，这个功能非常实用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**即時重播**可讓你回顧最近的終端機歷史記錄。如果有內容剛從螢幕上消失，而且不在捲動記錄中，這會很方便。"
          }
        }
      }
    },
    "MenuTip.StopCoprocess" : {
      "comment" : "Menu item help for the ‘Stop Coprocess’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaví aktivní koproces. Vstup do terminálu se již nepřesměrovává na koproces a jeho výstup ustane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopper den aktive medproces. Input til terminalen omdirigeres ikke længere til medprocessen, og dens output ophører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet den aktiven Koprozess. Eingaben an das Terminal werden nicht mehr an den Koprozess umgeleitet, und seine Ausgabe endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stops the active coprocess. Input to the terminal is no longer redirected to the coprocess, and its output ceases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene el coproceso activo. La entrada de la terminal deja de redirigirse al coproceso y su salida cesa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäyttää aktiivisen rinnakkaisprosessin. Päätteen syötettä ei enää ohjata rinnakkaisprosessille, ja sen tuloste loppuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête le coprocessus actif. L’entrée du terminal n’est plus redirigée vers le coprocessus, et sa sortie cesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe il coprocesso attivo. L’input del terminale non viene più reindirizzato al coprocesso e il suo output cessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のコプロセスを停止します。ターミナルへの入力はコプロセスへリダイレクトされなくなり、その出力も止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 코프로세스를 중단합니다. 터미널 입력이 더 이상 코프로세스로 리디렉션되지 않으며, 코프로세스의 출력도 멈춥니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopper den aktive medprosessen. Inndata til terminalen omdirigeres ikke lenger til medprosessen, og utdataene fra den opphører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt het actieve coproces. Invoer voor de terminal wordt niet langer omgeleid naar het coproces en de uitvoer ervan stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymuje aktywny koproces. Dane wejściowe terminala nie są już przekierowywane do koprocesu, a jego dane wyjściowe ustają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompe o coprocesso ativo. A entrada do terminal deixa de ser redirecionada para o coprocesso, e sua saída cessa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает активный сопроцесс. Ввод в терминал больше не перенаправляется сопроцессу, а его вывод прекращается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaví aktívny koproces. Vstup do terminálu sa už nepresmerúva na koproces a jeho výstup prestane."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustavi aktivni soproces. Vnos v terminal ni več preusmerjen na soproces in njegov izhod preneha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppar den aktiva samprocessen. Indata till terminalen omdirigeras inte längre till samprocessen, och dess utdata upphör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin yardımcı işlemi durdurur. Terminale girdi artık yardımcı işleme yönlendirilmez ve çıktısı kesilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dừng tiến trình đồng hành đang hoạt động. Đầu vào của terminal không còn được chuyển hướng đến tiến trình đồng hành, và đầu ra của nó chấm dứt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会停止当前协处理器的运行。对终端的输入将不再被重定向到该协处理器，其输出也会停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止使用中的協同程序。終端機的輸入不再被重新導向至協同程序，其輸出也會停止。"
          }
        }
      }
    },
    "MenuTip.TerminalState.LiteralMode" : {
      "comment" : "Menu item help for the ‘Terminal State.Literal Mode’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto, řídicí znaky se zobrazují vizuálně místo toho, aby se interpretovaly jako obvykle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er slået til, vises kontroltegn visuelt i stedet for at blive fortolket som normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Steuerzeichen visuell dargestellt, anstatt wie gewohnt interpretiert zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, control characters are displayed visually rather than being interpreted as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los caracteres de control se muestran visualmente en lugar de interpretarse como de costumbre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, ohjausmerkit näytetään visuaalisesti sen sijaan, että ne tulkittaisiin tavalliseen tapaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, les caractères de contrôle sont affichés visuellement au lieu d’être interprétés comme d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abilitato, i caratteri di controllo vengono mostrati visivamente anziché essere interpretati come di consueto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、制御文字は通常のように解釈されるのではなく、視覚的に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 제어 문자를 평소처럼 해석하지 않고 눈에 보이게 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, vises kontrolltegn visuelt i stedet for å tolkes som vanlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld worden besturingstekens zichtbaar weergegeven in plaats van zoals gebruikelijk te worden geïnterpreteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy opcja jest włączona, znaki sterujące są wyświetlane wizualnie zamiast być interpretowane jak zwykle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os caracteres de controle são exibidos visualmente em vez de serem interpretados como de costume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено, управляющие символы отображаются визуально, а не интерпретируются как обычно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, riadiace znaky sa zobrazujú vizuálne namiesto toho, aby sa interpretovali ako obvykle."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je vklopljeno, so krmilni znaki prikazani vidno, namesto da bi se razlagali kot običajno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det är aktiverat visas styrtecken visuellt i stället för att tolkas som vanligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinken denetim karakterleri her zamanki gibi yorumlanmak yerine görsel olarak gösterilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các ký tự điều khiển được hiển thị trực quan thay vì được diễn giải như thường lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，控制字符会以可视化形式显示，而非按常规方式解释。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，控制字元會以視覺方式顯示，而不是照常被解譯。"
          }
        }
      }
    },
    "MenuTip.TerminalState.ReportModifierswithCSIu" : {
      "comment" : "Menu item help for the ‘Terminal State.Report Modifiers with CSI u’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento režim se obecně nedoporučuje. **Rozlišovat Esc** je modernější přístup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tilstand anbefales generelt ikke. **Disambiguer Esc** er en mere moderne fremgangsmåde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Modus wird im Allgemeinen nicht empfohlen. **Escape eindeutig machen** ist ein moderneres Vorgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This mode is generally not recommended. **Disambiguate Escape** is a more modern approach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modo no se recomienda en general. **Desambiguar Esc** es un enfoque más moderno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä tilaa ei yleensä suositella. **Erottele esc** on modernimpi tapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mode n’est généralement pas recommandé. **Lever l’ambiguïté d’Échap** est une approche plus moderne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modalità in genere non è consigliata. **Disambigua Esc** è un approccio più moderno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードは一般的には推奨されません。**エスケープの曖昧さ回避**の方がより現代的な方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모드는 일반적으로 권장되지 않습니다. **이스케이프 명확화**가 더 최신 방식입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne modusen anbefales vanligvis ikke. **Entydig Esc** er en mer moderne tilnærming."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze modus wordt over het algemeen niet aanbevolen. **Maak Esc ondubbelzinnig** is een modernere aanpak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tryb generalnie nie jest zalecany. **Rozróżniaj Esc** to nowocześniejsze podejście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modo geralmente não é recomendado. **Disambiguate Escape** é uma abordagem mais moderna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот режим, как правило, не рекомендуется. **Устранение неоднозначности Escape** является более современным подходом."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento režim sa vo všeobecnosti neodporúča. **Jednoznačný Esc** je modernejší prístup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta način na splošno ni priporočen. **Razločevanje tipke Esc** je modernejši pristop."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här läget rekommenderas i allmänhet inte. **Särskilj Esc** är ett modernare tillvägagångssätt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mod genellikle önerilmez. **Esc Belirsizliğini Gider** daha modern bir yaklaşımdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói chung không khuyên dùng chế độ này. **Phân biệt Esc** là cách tiếp cận hiện đại hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常不建议使用此模式。**消歧义退出键**是一种更现代的实现方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般不建議使用此模式。**區分 Esc 鍵**是較現代的做法。"
          }
        }
      }
    },
    "MenuTip.ToggleBufferInput" : {
      "comment" : "Menu item help for the ‘Toggle Buffer Input’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnut vstup do bufferu, vstup z klávesnice se ukládá do bufferu. Odešle se po vypnutí vstupu do bufferu. Můžete také nastavit spouštěč, který toto nastavení změní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens Buffer input er slået til, gemmes tastaturinput i en buffer. Det sendes, når Buffer input slås fra. Du kan også konfigurere en udløser til at ændre indstillingen for Buffer input."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange die Eingabepufferung aktiviert ist, wird die Tastatureingabe in einem Puffer gespeichert. Sie wird gesendet, sobald die Eingabepufferung deaktiviert wird. Sie können auch einen Trigger konfigurieren, der die Einstellung für die Eingabepufferung ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "While Buffer Input is turned on, keyboard input is stored in a buffer. It will be sent when Buffer Input is turned off. You can also configure a trigger to change the Buffer Input setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la entrada en búfer está activada, la entrada del teclado se almacena en un búfer. Se enviará cuando la entrada en búfer se desactive. También puedes configurar un disparador para cambiar el ajuste de entrada en búfer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun puskurisyöte on päällä, näppäimistösyöte tallennetaan puskuriin. Se lähetetään, kun puskurisyöte laitetaan pois päältä. Voit myös määrittää käynnistimen, joka muuttaa puskurisyötteen asetusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que la saisie en tampon est activée, la saisie au clavier est stockée dans un tampon. Elle sera envoyée quand la saisie en tampon sera désactivée. Vous pouvez aussi configurer un déclencheur pour modifier ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre “Buffer dell’input” è attivo, l’input da tastiera viene memorizzato in un buffer e verrà inviato quando “Buffer dell’input” viene disattivato. Puoi anche configurare un attivatore per cambiare l’impostazione “Buffer dell’input”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッファ入力がオンの間、キーボード入力はバッファに保存されます。バッファ入力をオフにすると送信されます。トリガーを設定してバッファ入力の設定を変更することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버퍼 입력이 켜져 있는 동안 키보드 입력은 버퍼에 저장되며, 버퍼 입력을 끄면 전송됩니다. 버퍼 입력 설정을 변경하도록 트리거를 구성할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens bufring av inndata er slått på, lagres tastaturinndata i en buffer. De sendes når bufring av inndata slås av. Du kan også konfigurere en utløser som endrer innstillingen for bufring av inndata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zolang bufferinvoer is ingeschakeld, wordt toetsenbordinvoer in een buffer opgeslagen. De invoer wordt verstuurd zodra bufferinvoer wordt uitgeschakeld. Je kunt ook een trigger instellen om de instelling voor bufferinvoer te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy buforowanie wejścia jest włączone, dane z klawiatury są przechowywane w buforze. Zostaną wysłane po wyłączeniu buforowania wejścia. Możesz też skonfigurować wyzwalacz zmieniający to ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o Buffer Input está ativado, a entrada do teclado é armazenada em um buffer. Ela será enviada quando o Buffer Input for desativado. Você também pode configurar um gatilho para alterar o ajuste de Buffer Input."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока включена буферизация ввода, ввод с клавиатуры сохраняется в буфере. Он будет отправлен, когда буферизация ввода будет отключена. Вы также можете настроить триггер для изменения настройки буферизации ввода."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnutý Buffer vstupu, vstup z klávesnice sa ukladá do buffera. Odošle sa po vypnutí Buffera vstupu. Môžete tiež nastaviť spúšťač, ktorý zmení nastavenie Buffera vstupu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je »Medpomnilnik vnosa« vklopljen, se vnos s tipkovnice shranjuje v medpomnilnik. Poslan bo, ko »Medpomnilnik vnosa« izklopite. Nastavitev lahko spreminja tudi sprožilec."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan Buffra indata är på lagras tangentbordsindata i en buffert. Den skickas när Buffra indata stängs av. Du kan också konfigurera en utlösare som ändrar inställningen Buffra indata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girdi Arabelleği açıkken klavye girdisi bir arabellekte saklanır. Girdi Arabelleği kapatıldığında gönderilir. Girdi Arabelleği ayarını değiştirmek için bir tetikleyici de yapılandırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi Đệm đầu vào đang bật, đầu vào bàn phím được lưu trong bộ đệm. Nó sẽ được gửi khi Đệm đầu vào được tắt. Bạn cũng có thể định cấu hình một trình kích hoạt để thay đổi cài đặt Đệm đầu vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当“缓冲区输入”开启时，键盘输入会存储在缓冲区中。当该设置关闭后，这些内容将被发送。您也可以配置触发器来更改“缓冲区输入”的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟緩衝輸入時，鍵盤輸入會儲存在緩衝區中，並在關閉緩衝輸入時傳送。你也可以設定觸發器來變更緩衝輸入設定。"
          }
        }
      }
    },
    "MenuTip.ToggleDebugLogging" : {
      "comment" : "Menu item help for the ‘Toggle Debug Logging’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladicí protokoly se při zapnutém nastavení ukládají do paměti a po vypnutí se zapíší do `/tmp/debuglog.txt`. Využití paměti je omezeno na asi 200 MB; pokud protokol tuto hranici překročí, nejstarší záznamy se zahodí, aby byla vždy zachována nejnovější aktivita."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fejlfindingslogge gemmes i hukommelsen, mens denne indstilling er slået til, og skrives til `/tmp/debuglog.txt`, når du slår den fra. Hukommelsesforbruget begrænses til ca. 200 MB. Hvis loggen vokser ud over det, kasseres de ældste poster, så den seneste aktivitet altid bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug-Protokolle werden im Speicher abgelegt, solange diese Einstellung aktiviert ist, und beim Deaktivieren nach `/tmp/debuglog.txt` geschrieben. Der Speicherverbrauch ist auf etwa 200 MB begrenzt; wächst das Protokoll darüber hinaus, werden die ältesten Einträge verworfen, sodass die neueste Aktivität stets erhalten bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Debug logs are saved in memory while this setting is enabled and written to `/tmp/debuglog.txt` when you turn it off. Memory use is capped at about 200MB; if the log grows past that, the oldest entries are discarded so the most recent activity is always kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros de depuración se guardan en memoria mientras este ajuste está activado y se escriben en `/tmp/debuglog.txt` cuando lo desactivas. El uso de memoria está limitado a unos 200 MB; si el registro supera ese tamaño, se descartan las entradas más antiguas para conservar siempre la actividad más reciente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vianmääritysloki tallennetaan muistiin, kun tämä asetus on käytössä, ja kirjoitetaan tiedostoon `/tmp/debuglog.txt`, kun laitat sen pois päältä. Muistin käyttö on rajattu noin 200 Mt:iin; jos loki kasvaa sitä suuremmaksi, vanhimmat merkinnät hylätään, jotta viimeisin toiminta säilyy aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux de débogage sont conservés en mémoire tant que ce réglage est activé et écrits dans `/tmp/debuglog.txt` quand vous le désactivez. L’utilisation de la mémoire est plafonnée à environ 200 Mo ; si le journal dépasse cette taille, les entrées les plus anciennes sont supprimées afin de toujours conserver l’activité la plus récente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I log di debug vengono salvati in memoria mentre questa impostazione è abilitata e scritti in `/tmp/debuglog.txt` quando la disattivi. L’uso di memoria è limitato a circa 200 MB; se il log supera tale limite, le voci più vecchie vengono scartate in modo da conservare sempre l’attività più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定が有効な間、デバッグログはメモリに保存され、オフにすると`/tmp/debuglog.txt`に書き出されます。メモリ使用量は約200MBに制限されており、ログがそれを超えて増加すると、最も古いエントリが破棄され、常に最新の活動が保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정이 켜져 있는 동안 디버그 로그는 메모리에 저장되며, 설정을 끄면 `/tmp/debuglog.txt`에 기록됩니다. 메모리 사용량은 약 200MB로 제한되며, 로그가 이를 넘으면 가장 오래된 항목부터 삭제되어 가장 최근 활동은 항상 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feilsøkingslogger lagres i minnet mens denne innstillingen er aktivert, og skrives til `/tmp/debuglog.txt` når du slår den av. Minnebruken begrenses til rundt 200 MB. Hvis loggen vokser forbi det, forkastes de eldste oppføringene slik at den nyeste aktiviteten alltid beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debuglogs worden in het geheugen bewaard zolang deze instelling is ingeschakeld en worden naar `/tmp/debuglog.txt` geschreven wanneer je de instelling uitschakelt. Het geheugengebruik is beperkt tot ongeveer 200 MB; als het log groter wordt, worden de oudste vermeldingen verwijderd, zodat de meest recente activiteit altijd behouden blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzienniki debugowania są zapisywane w pamięci, gdy to ustawienie jest włączone, i zapisywane do `/tmp/debuglog.txt` po jego wyłączeniu. Zużycie pamięci jest ograniczone do około 200 MB; jeśli dziennik urośnie powyżej tego limitu, najstarsze wpisy są odrzucane, dzięki czemu najnowsza aktywność jest zawsze zachowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os logs de depuração são salvos na memória enquanto este ajuste está ativado e gravados em `/tmp/debuglog.txt` quando você o desativa. O uso de memória é limitado a cerca de 200MB; se o log crescer além disso, as entradas mais antigas são descartadas para que a atividade mais recente seja sempre mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока эта настройка включена, отладочные журналы сохраняются в памяти, а при её отключении записываются в `/tmp/debuglog.txt`. Использование памяти ограничено примерно 200 МБ; если журнал превышает этот размер, самые старые записи удаляются, чтобы всегда сохранялась самая последняя активность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladiace záznamy sa ukladajú v pamäti, kým je toto nastavenie zapnuté, a po jeho vypnutí sa zapíšu do `/tmp/debuglog.txt`. Využitie pamäte je obmedzené na približne 200 MB; ak záznam túto hranicu prekročí, najstaršie položky sa zahodia, aby sa vždy zachovala najnovšia aktivita."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnevniki za iskanje napak se shranjujejo v pomnilnik, dokler je ta nastavitev vklopljena, in se zapišejo v `/tmp/debuglog.txt`, ko jo izklopite. Poraba pomnilnika je omejena na približno 200 MB; če dnevnik preseže to mejo, se najstarejši vnosi zavržejo, tako da se najnovejša dejavnost vedno ohrani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felsökningsloggar sparas i minnet medan den här inställningen är aktiverad och skrivs till `/tmp/debuglog.txt` när du stänger av den. Minnesanvändningen begränsas till cirka 200 MB; om loggen växer över det kasseras de äldsta posterna så att den senaste aktiviteten alltid behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayar etkinken hata ayıklama günlükleri bellekte tutulur ve kapattığınızda `/tmp/debuglog.txt` dosyasına yazılır. Bellek kullanımı yaklaşık 200 MB ile sınırlıdır; günlük bunu aşarsa en eski girdiler atılır, böylece en son etkinlik her zaman korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhật ký gỡ lỗi được lưu trong bộ nhớ khi cài đặt này bật và được ghi vào `/tmp/debuglog.txt` khi bạn tắt. Mức dùng bộ nhớ bị giới hạn khoảng 200MB; nếu nhật ký vượt quá mức đó, các mục cũ nhất sẽ bị loại bỏ để luôn giữ hoạt động gần đây nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此设置启用时，调试日志会保存在内存中，并在关闭时写入 `/tmp/debuglog.txt` 文件中。内存使用量被限制在约200MB；如果日志超过此限制，最旧的记录会被丢弃，从而确保最新的活动始终被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用此設定時，除錯記錄會儲存在記憶體中，並在你關閉時寫入 `/tmp/debuglog.txt`。記憶體用量上限約為 200MB；若記錄超過上限，會捨棄最舊的項目，以便始終保留最近的活動。"
          }
        }
      }
    },
    "MenuTip.Toolbelt" : {
      "comment" : "Menu item help for the ‘Toolbelt’ and ‘Show Toolbelt’ menu items",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pás nástrojů** je všestranný ukotvitelný boční panel, který nabízí rychlý přístup k často používaným funkcím a informacím. Podporuje více panelů zobrazených současně, včetně historie schránky, nedávno otevřených adresářů, historie příkazů, bloku poznámek a dalších."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Værktøjsbæltet** er en alsidig indholdsoversigt, der kan forankres, og som giver hurtig adgang til hyppigt brugte funktioner og oplysninger. Det understøtter flere paneler, der kan vises samtidig, bl.a. udklipsholderhistorik, senest åbnede mapper, kommandohistorik, en notesblok og meget mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der **Werkzeuggürtel** bietet eine vielseitige, andockbare Seitenleiste mit schnellem Zugriff auf häufig verwendete Funktionen und Informationen. Er unterstützt mehrere Bereiche, die gleichzeitig angezeigt werden können, darunter Zwischenablage-Verlauf, zuletzt geöffnete Verzeichnisse, Befehlsverlauf, ein Notizblock für Notizen und mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The **Toolbelt** provides a versatile, dockable sidebar that offers quick access to frequently used features and information. It supports multiple panels that can be displayed simultaneously, including clipboard history, recently opened directories, command history, a scratchpad for notes, and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **caja de herramientas** ofrece una barra lateral versátil y acoplable que da acceso rápido a funciones e información de uso frecuente. Admite varios paneles que se pueden mostrar a la vez, como el historial del portapapeles, los directorios abiertos recientemente, el historial de comandos, un bloc de notas y mucho más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Työkaluvyö** on monipuolinen, telakoitava sivupalkki, joka antaa nopean pääsyn usein käytettyihin ominaisuuksiin ja tietoihin. Se tukee useita samanaikaisesti näytettäviä paneeleita, kuten leikepöytähistoriaa, äskettäin avattuja hakemistoja, komentohistoriaa, muistiinpanoalustaa ja paljon muuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **boîte à outils** est une barre latérale polyvalente et ancrable qui donne un accès rapide aux fonctions et informations les plus utilisées. Elle prend en charge plusieurs panneaux affichables simultanément, notamment l’historique du presse-papiers, les répertoires récemment ouverts, l’historique des commandes, un bloc-notes, et plus encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **cassetta attrezzi** è una barra laterale versatile e agganciabile che offre accesso rapido alle funzioni e alle informazioni usate più di frequente. Supporta più pannelli visualizzabili contemporaneamente, tra cui cronologia degli Appunti, directory aperte di recente, cronologia comandi, un blocco per appunti e altro ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ツールベルト**は、よく使う機能や情報にすばやくアクセスできる、多機能でドッキング可能なサイドバーです。クリップボード履歴、最近開いたディレクトリ、コマンド履歴、メモ用のスクラッチパッドなど、複数のパネルを同時に表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**도구 벨트**는 자주 사용하는 기능과 정보에 빠르게 접근할 수 있는 다용도 도킹 사이드바를 제공합니다. 클립보드 기록, 최근에 연 디렉토리, 명령 기록, 메모용 스크래치패드 등 여러 패널을 동시에 표시할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Verktøybeltet** er et allsidig sidepanel som kan forankres og gir rask tilgang til ofte brukte funksjoner og informasjon. Det støtter flere paneler som kan vises samtidig, blant annet utklippstavlehistorikk, nylig åpnede mapper, kommandohistorikk, en notatblokk og mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De **gereedschapsriem** is een veelzijdige navigatiekolom die je kunt vastkoppelen en die snel toegang biedt tot veelgebruikte functies en informatie. Hij ondersteunt meerdere panelen die tegelijk kunnen worden getoond, waaronder klembordgeschiedenis, recent geopende mappen, commandogeschiedenis, een kladblok voor notities en meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pas narzędzi** to wszechstronny, dokowany pasek boczny zapewniający szybki dostęp do często używanych funkcji i informacji. Obsługuje wiele paneli wyświetlanych jednocześnie, w tym historię schowka, ostatnio otwierane katalogi, historię poleceń, notatnik na notatki i inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A **Caixa de ferramentas** oferece uma barra lateral versátil e encaixável que dá acesso rápido a recursos e informações usados com frequência. Ela suporta vários painéis que podem ser exibidos simultaneamente, incluindo histórico da área de transferência, diretórios abertos recentemente, histórico de comandos, um bloco de rascunho para notas e muito mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Панель инструментов** предоставляет универсальную закрепляемую боковую панель, обеспечивающую быстрый доступ к часто используемым функциям и информации. Она поддерживает несколько панелей, которые можно отображать одновременно, включая историю буфера обмена, недавно открытые каталоги, историю команд, блокнот для заметок и многое другое."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pás s nástrojmi** poskytuje všestranný ukotviteľný postranný panel s rýchlym prístupom k často používaným funkciám a informáciám. Podporuje viacero panelov, ktoré možno zobraziť súčasne, vrátane histórie schránky, nedávno otvorených adresárov, histórie príkazov, poznámkového bloku a ďalších."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pas z orodji** je vsestranska stranska vrstica, ki jo lahko zasidrate in ki ponuja hiter dostop do pogosto uporabljenih funkcij in informacij. Podpira več plošč, ki so lahko prikazane hkrati, med njimi zgodovino odložišča, nedavno odprte imenike, zgodovino ukazov, odlagališče za zapiske in drugo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Verktygsbältet** är ett flexibelt sidofält som kan dockas och ger snabb åtkomst till ofta använda funktioner och information. Det stöder flera paneler som kan visas samtidigt, bland annat urklippshistorik, senast öppnade kataloger, kommandohistorik, ett anteckningsblock och mer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Araç Kemeri**, sık kullanılan özelliklere ve bilgilere hızlı erişim sunan, yerleştirilebilen çok yönlü bir kenar çubuğudur. Pano geçmişi, son açılan dizinler, komut geçmişi, not defteri ve daha fazlası dahil, aynı anda görüntülenebilen birden çok paneli destekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Đai công cụ** là thanh bên linh hoạt, có thể gắn vào, cung cấp truy cập nhanh đến các tính năng và thông tin thường dùng. Nó hỗ trợ nhiều bảng có thể hiển thị đồng thời, gồm lịch sử bảng nhớ tạm, thư mục mở gần đây, lịch sử lệnh, sổ nháp ghi chú và hơn thế nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Toolbelt** 提供了一个多功能可停靠的侧边栏，可以快速访问常用功能和信息。它支持多个可以同时显示的窗格，包括剪贴板历史记录、最近打开的目录、命令历史、便签等。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**工具帶**是一個功能多樣、可停靠的側邊欄，可快速存取常用功能與資訊。它支援可同時顯示的多個面板，包括剪貼簿歷史記錄、最近打開的目錄、指令歷史記錄、用於記筆記的便條區等。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.Actions" : {
      "comment" : "Menu item help for the ‘Toolbelt.Actions’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akce jsou uložené pokyny pro iTerm2. Můžete například vytvořit akci, která otevře nové okno a poté vytvoří rozdělené podokno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlinger er gemte instruktioner til iTerm2. Du kan f.eks. oprette en handling, der åbner et nyt vindue og derefter opretter en opdelt rude."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktionen sind gespeicherte Anweisungen für iTerm2. Sie könnten zum Beispiel eine Aktion erstellen, die ein neues Fenster öffnet und dann einen geteilten Bereich erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Actions are saved instructions for iTerm2. For example, you could create an action that opens a new window and then creates a split pane."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones son instrucciones guardadas para iTerm2. Por ejemplo, podrías crear una acción que abra una ventana nueva y luego cree un panel dividido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toiminnot ovat tallennettuja ohjeita iTerm2:lle. Voit esimerkiksi luoda toiminnon, joka avaa uuden ikkunan ja luo sitten jaetun paneelin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actions sont des instructions enregistrées pour iTerm2. Par exemple, vous pouvez créer une action qui ouvre une nouvelle fenêtre puis crée un volet scindé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni sono istruzioni salvate per iTerm2. Ad esempio, puoi creare un’azione che apre una nuova finestra e poi crea un riquadro diviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクションは、iTerm2に対して保存された指示です。たとえば、新しいウィンドウを開いてから分割ペインを作成するアクションを作ることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작은 iTerm2에 내릴 지시를 저장해 둔 것입니다. 예를 들어 새로운 윈도우를 연 다음 분할 패널을 만드는 동작을 생성할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handlinger er lagrede instruksjoner for iTerm2. Du kan for eksempel lage en handling som åpner et nytt vindu og deretter oppretter en delt rute."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acties zijn bewaarde instructies voor iTerm2. Je kunt bijvoorbeeld een actie maken die een nieuw venster opent en daarna een gesplitst paneel maakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akcje to zapisane instrukcje dla iTerm2. Możesz na przykład utworzyć akcję, która otwiera nowe okno, a następnie tworzy panel podzielony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ações são instruções salvas para o iTerm2. Por exemplo, você poderia criar uma ação que abre uma nova janela e depois cria um painel dividido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действия представляют собой сохранённые инструкции для iTerm2. Например, можно создать действие, которое открывает новое окно, а затем создаёт разделённую панель."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akcie sú uložené pokyny pre iTerm2. Môžete napríklad vytvoriť akciu, ktorá otvorí nové okno a potom vytvorí rozdelený panel."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejanja so shranjena navodila za iTerm2. Ustvarite lahko na primer dejanje, ki odpre novo okno in nato ustvari razdeljeno podokno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtgärder är sparade instruktioner till iTerm2. Du kan till exempel skapa en åtgärd som öppnar ett nytt fönster och sedan skapar en delad panel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eylemler, iTerm2 için kaydedilmiş yönergelerdir. Örneğin yeni bir pencere açıp ardından bir bölme oluşturan bir eylem oluşturabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tác vụ là các chỉ dẫn đã lưu cho iTerm2. Ví dụ, bạn có thể tạo một tác vụ mở cửa sổ mới rồi tạo một khung chia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“动作”是 iTerm2 保存的指令。例如，您可以创建一个动作来打开新窗口，然后创建分屏窗格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動作是為 iTerm2 儲存的指示。例如，你可以建立一個先打開新視窗再建立分割窗格的動作。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.CapturedOutput" : {
      "comment" : "Menu item help for the ‘Toolbelt.Captured Output’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zachycený výstup** spolupracuje se spouštěčem, který v terminálu rozpozná zajímavý text a usnadní jeho nalezení. Nástroj pásu nástrojů zobrazuje seznam zachyceného textu. Kliknutím na něj přejdete, dvojitým kliknutím zadáte programovatelný příkaz. To se hodí například při hledání chyb ve výstupu příkazu sestavení. Vyžaduje integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Opfanget output** arbejder sammen med en udløser om at finde interessant tekst i terminalen og gøre den nem at finde. Værktøjet i værktøjsbæltet viser en liste over opfanget tekst. Du kan klikke for at gå til teksten eller dobbeltklikke for at angive en programmerbar kommando. Det er f.eks. nyttigt til at finde fejl i outputtet fra en byggekommando. Det kræver Shell-integration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Erfasste Ausgabe** arbeitet zusammen mit einem Trigger, um interessanten Text im Terminal zu erkennen und leicht auffindbar zu machen. Das Werkzeug im Werkzeuggürtel zeigt eine Liste des erfassten Texts. Sie können klicken, um dorthin zu springen, oder doppelklicken, um einen programmierbaren Befehl einzugeben. Das ist zum Beispiel nützlich, um Fehler in der Ausgabe eines Build-Befehls zu finden. Shell-Integration ist erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Captured Output** works in conjunction with a Trigger to detect interesting text in the terminal and make it easy to find. The Toolbelt tool shows a list of captured text. You can click to navigate to it or double-click to enter a programmable command. This is useful for finding errors in the output of a build command, for example. It requires Shell Integration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **salida capturada** funciona junto con un disparador para detectar texto interesante en la terminal y facilitar su localización. La herramienta de la caja de herramientas muestra una lista de texto capturado. Puedes hacer clic para ir a él o doble clic para introducir un comando programable. Es útil, por ejemplo, para encontrar errores en la salida de un comando de compilación. Requiere la integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Kaapattu tuloste** toimii yhdessä käynnistimen kanssa: se tunnistaa päätteestä kiinnostavaa tekstiä ja helpottaa sen löytämistä. Työkaluvyön työkalu näyttää luettelon kaapatusta tekstistä. Voit siirtyä siihen klikkaamalla tai syöttää ohjelmoitavan komennon kaksoisklikkaamalla. Tämä on hyödyllistä esimerkiksi virheiden etsimisessä koontikomennon tulosteesta. Se vaatii komentotulkki-integraation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **sortie capturée** fonctionne avec un déclencheur pour détecter du texte intéressant dans le terminal et le retrouver facilement. L’outil de la boîte à outils affiche une liste du texte capturé. Vous pouvez cliquer pour y accéder ou double-cliquer pour saisir une commande programmable. C’est utile, par exemple, pour trouver des erreurs dans la sortie d’une commande de compilation. L’intégration du shell est requise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’**output catturato** funziona insieme a un attivatore per rilevare testo interessante nel terminale e renderlo facile da trovare. Lo strumento della cassetta attrezzi mostra un elenco di testo catturato. Puoi fare clic per raggiungerlo o fare doppio clic per inserire un comando programmabile. È utile, ad esempio, per trovare errori nell’output di un comando di build. Richiede l’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**キャプチャした出力**はトリガーと連携して、ターミナル内の注目すべきテキストを検出し、見つけやすくします。ツールベルトのツールにキャプチャされたテキストの一覧が表示されます。クリックしてそこへ移動したり、ダブルクリックしてプログラム可能なコマンドを入力したりできます。たとえば、ビルドコマンドの出力からエラーを見つけるのに役立ちます。シェル統合が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**캡처된 출력**은 트리거와 함께 작동하여 터미널에서 관심 있는 텍스트를 감지하고 쉽게 찾을 수 있게 합니다. 도구 벨트 도구에 캡처된 텍스트 목록이 표시됩니다. 클릭하면 해당 위치로 이동하고, 두 번 클릭하면 프로그래밍 가능한 명령을 입력할 수 있습니다. 예를 들어 빌드 명령의 출력에서 오류를 찾을 때 유용합니다. 셸 통합이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fanget utdata** fungerer sammen med en utløser for å oppdage interessant tekst i terminalen og gjøre den lett å finne. Verktøyet i verktøybeltet viser en liste over fanget tekst. Du kan klikke for å gå til den eller dobbeltklikke for å skrive inn en programmerbar kommando. Det er nyttig for å finne feil i utdataene fra en byggekommando, for eksempel. Skallintegrering kreves."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Vastgelegde uitvoer** werkt samen met een trigger om interessante tekst in de terminal te detecteren en makkelijk vindbaar te maken. De tool in de gereedschapsriem toont een lijst met vastgelegde tekst. Je kunt klikken om ernaartoe te gaan of dubbelklikken om een programmeerbaar commando in te voeren. Dit is bijvoorbeeld handig om fouten in de uitvoer van een buildcommando te vinden. Shell-integratie is vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Przechwycone wyjście** współpracuje z wyzwalaczem, aby wykrywać interesujący tekst w terminalu i ułatwiać jego znalezienie. Narzędzie pasa narzędzi pokazuje listę przechwyconego tekstu. Możesz kliknąć, aby do niego przejść, lub kliknąć dwukrotnie, aby wprowadzić programowalne polecenie. Przydaje się to na przykład do znajdowania błędów w danych wyjściowych polecenia kompilacji. Wymaga integracji z powłoką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A **Saída capturada** funciona em conjunto com um gatilho para detectar texto interessante no terminal e facilitar sua localização. A ferramenta da caixa de ferramentas mostra uma lista de texto capturado. Você pode clicar para navegar até ele ou clicar duas vezes para executar um comando programável. Isto é útil para encontrar erros na saída de um comando de compilação, por exemplo. Requer a Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Захваченный вывод** работает совместно с триггером, обнаруживая интересный текст в терминале и упрощая его поиск. Инструмент панели инструментов показывает список захваченного текста. Вы можете щёлкнуть, чтобы перейти к нему, или дважды щёлкнуть, чтобы ввести программируемую команду. Это полезно, например, для поиска ошибок в выводе команды сборки. Требуется интеграция с оболочкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zachytený výstup** spolupracuje so Spúšťačom na zistení zaujímavého textu v termináli a jeho jednoduchom vyhľadaní. Nástroj v Páse s nástrojmi zobrazuje zoznam zachyteného textu. Kliknutím naň prejdete, dvojitým kliknutím zadáte programovateľný príkaz. Hodí sa napríklad na hľadanie chýb vo výstupe príkazu zostavenia. Vyžaduje Integráciu shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zajeti izhod** deluje skupaj s sprožilcem, da zazna zanimivo besedilo v terminalu in ga je lažje najti. Orodje v pasu z orodji prikazuje seznam zajetega besedila. S klikom se pomaknete nanj, z dvoklikom pa vnesete programabilen ukaz. To je uporabno na primer za iskanje napak v izhodu ukaza za gradnjo. Zahteva integracijo lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Fångade utdata** samverkar med en utlösare för att upptäcka intressant text i terminalen och göra den lätt att hitta. Verktyget i verktygsbältet visar en lista med fångad text. Du kan klicka för att navigera till den eller dubbelklicka för att ange ett programmerbart kommando. Det är till exempel användbart för att hitta fel i utdata från ett byggkommando. Kräver skalintegrering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Yakalanan Çıktı**, terminaldeki ilginç metni algılamak ve bulmayı kolaylaştırmak için bir Tetikleyiciyle birlikte çalışır. Araç Kemeri aracı yakalanan metinlerin bir listesini gösterir. Gitmek için tıklayabilir veya programlanabilir bir komut girmek için çift tıklayabilirsiniz. Örneğin bir derleme komutunun çıktısındaki hataları bulmak için yararlıdır. Kabuk Entegrasyonu gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Đầu ra đã bắt** hoạt động cùng với Trình kích hoạt để phát hiện văn bản đáng chú ý trong terminal và giúp dễ tìm. Công cụ của đai công cụ hiển thị danh sách văn bản đã bắt. Bạn có thể bấm để đi đến đó hoặc bấm hai lần để nhập một lệnh có thể lập trình. Điều này hữu ích để tìm lỗi trong đầu ra của lệnh build, chẳng hạn. Yêu cầu Tích hợp shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**捕获输出**与触发器配合工作，可以检测终端中的有趣文本并使其易于查找。Toolbelt 工具会显示捕获文本的列表。您可以点击以导航到该内容，或双击进入可编程命令。这对于查找构建命令输出中的错误非常有用，例如。它需要 Shell 集成功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**擷取的輸出**會搭配觸發器偵測終端機中值得注意的文字，使其容易找到。此工具帶工具會顯示擷取的文字列表。你可以按一下以瀏覽到該處，或按兩下以輸入可程式化的指令。例如，這對於在建置指令的輸出中尋找錯誤很有用。需要 Shell 整合。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.Codecierge" : {
      "comment" : "Menu item help for the ‘Toolbelt.Codecierge’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** pomocí AI pomáhá dosáhnout cíle. Řekněte mu, co chcete udělat, a může sledovat váš terminál, interpretovat výstup a navrhovat příkazy. Vyžaduje integraci shellu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** bruger AI til at hjælpe dig med at nå et mål. Fortæl, hvad du vil, så kan den følge med i din terminal for at fortolke output og foreslå kommandoer. Shell-integration er påkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** nutzt KI, um Ihnen zu helfen, ein Ziel zu erreichen. Teilen Sie ihm mit, was Sie erreichen möchten, und es kann Ihr Terminal beobachten, um die Ausgabe zu interpretieren und Befehle vorzuschlagen. Shell-Integration ist erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Codecierge** uses AI to help you achieve a goal. Tell it what you want to do, and it can watch your terminal to interpret output and suggest commands. Shell Integration is required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** usa IA para ayudarte a lograr un objetivo. Dile lo que quieres hacer y puede observar tu terminal para interpretar la salida y sugerir comandos. Se requiere la integración con el shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** auttaa AI:n avulla saavuttamaan tavoitteen. Kerro sille, mitä haluat tehdä, ja se voi seurata päätettäsi tulkitakseen tulostetta ja ehdottaakseen komentoja. Komentotulkki-integraatio vaaditaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** utilise l’IA pour vous aider à atteindre un objectif. Dites-lui ce que vous voulez faire, et il peut surveiller votre terminal pour interpréter la sortie et suggérer des commandes. L’intégration du shell est requise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** usa l’IA per aiutarti a raggiungere un obiettivo. Digli cosa vuoi fare e potrà osservare il terminale per interpretare l’output e suggerire comandi. È richiesta l’integrazione shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge**はAIを使ってあなたが目標を達成するのを助けます。やりたいことを伝えると、ターミナルを監視して出力を解釈し、コマンドを提案します。シェル統合が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge**는 AI를 사용하여 목표 달성을 돕습니다. 하고 싶은 작업을 알려 주면 터미널을 지켜보며 출력을 해석하고 명령을 제안합니다. 셸 통합이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** bruker KI til å hjelpe deg med å nå et mål. Fortell det hva du vil gjøre, så kan det følge med på terminalen din, tolke utdata og foreslå kommandoer. Skallintegrering kreves."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** gebruikt AI om je te helpen een doel te bereiken. Vertel wat je wilt doen, dan kan de AI je terminal in de gaten houden om uitvoer te interpreteren en commando’s voor te stellen. Shell-integratie is vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** używa AI, aby pomóc ci osiągnąć cel. Powiedz mu, co chcesz zrobić, a będzie mógł obserwować twój terminal, interpretować dane wyjściowe i proponować polecenia. Wymagana jest integracja z powłoką."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O **Concierge de código** usa IA para ajudar você a atingir um objetivo. Diga a ele o que você quer fazer, e ele pode observar seu terminal para interpretar a saída e sugerir comandos. É necessária a Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** использует ИИ, чтобы помочь вам достичь цели. Расскажите ему, что вы хотите сделать, и он сможет следить за вашим терминалом, интерпретировать вывод и предлагать команды. Требуется интеграция с оболочкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** využíva AI, aby vám pomohol dosiahnuť cieľ. Povedzte mu, čo chcete urobiť, a môže sledovať váš terminál, interpretovať výstup a navrhovať príkazy. Vyžaduje sa Integrácia shellu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** vam z AI pomaga doseči cilj. Povejte mu, kaj želite storiti, in lahko bo spremljal vaš terminal, razlagal izhod in predlagal ukaze. Zahtevana je integracija lupine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** använder AI för att hjälpa dig nå ett mål. Berätta vad du vill göra, så kan den följa din terminal för att tolka utdata och föreslå kommandon. Skalintegrering krävs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge**, bir hedefe ulaşmanıza yardımcı olmak için YZ kullanır. Ne yapmak istediğinizi söyleyin; terminalinizi izleyerek çıktıyı yorumlayabilir ve komut önerebilir. Kabuk Entegrasyonu gereklidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** dùng AI để giúp bạn đạt được mục tiêu. Hãy cho nó biết bạn muốn làm gì, và nó có thể theo dõi terminal của bạn để diễn giải đầu ra và đề xuất lệnh. Yêu cầu Tích hợp shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** 利用 AI 帮助您实现目标。告诉它您需要做什么，它可以监控您的终端以解析输出并建议命令。需要 Shell 集成功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Codecierge** 使用 AI 協助你達成目標。告訴它你想做什麼，它就能監看你的終端機以解讀輸出並建議指令。需要 Shell 整合。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.CommandHistory" : {
      "comment" : "Menu item help for the ‘Toolbelt.Command History’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li nainstalována integrace shellu, **Historie příkazů** zobrazuje prohledávatelný seznam nedávno spuštěných příkazů na aktuálním hostiteli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Shell-integration er installeret, viser **Kommandohistorik** en søgbar liste over de seneste kommandoer, der er kørt på den aktuelle vært."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Shell-Integration installiert ist, zeigt der **Befehlsverlauf** eine durchsuchbare Liste der zuletzt auf dem aktuellen Host ausgeführten Befehle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If Shell Integration is installed, **Command History** shows a searchable list of recently run commands on the current host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la integración con el shell está instalada, el **historial de comandos** muestra una lista con búsqueda de los comandos ejecutados recientemente en el host actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos komentotulkki-integraatio on asennettu, **Komentohistoria** näyttää haettavissa olevan luettelon nykyisellä palvelimella äskettäin suoritetuista komennoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’intégration du shell est installée, l’**historique des commandes** affiche une liste consultable des commandes récemment exécutées sur l’hôte actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’integrazione shell è installata, la **cronologia comandi** mostra un elenco ricercabile dei comandi eseguiti di recente sull’host corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合がインストールされている場合、**コマンド履歴**は現在のホストで最近実行したコマンドの検索可能な一覧を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 설치되어 있으면 **명령 기록**에 현재 호스트에서 최근 실행한 명령이 검색 가능한 목록으로 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis skallintegrering er installert, viser **Kommandohistorikk** en søkbar liste over nylig kjørte kommandoer på gjeldende vert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als shell-integratie is geïnstalleerd, toont **Commandogeschiedenis** een doorzoekbare lijst met recent uitgevoerde commando’s op de huidige host."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zainstalowano integrację z powłoką, **Historia poleceń** pokazuje przeszukiwalną listę ostatnio uruchomionych poleceń na bieżącym hoście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a Shell Integration estiver instalada, o **Histórico de comandos** mostra uma lista pesquisável de comandos executados recentemente no host atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если установлена интеграция с оболочкой, **История команд** показывает список с возможностью поиска по недавно выполненным командам на текущем узле."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je nainštalovaná Integrácia shellu, **História príkazov** zobrazuje zoznam nedávno spustených príkazov na aktuálnom hostiteľovi, v ktorom sa dá vyhľadávať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je nameščena integracija lupine, **Zgodovina ukazov** prikaže seznam nedavno zagnanih ukazov na trenutnem gostitelju, po katerem lahko iščete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om skalintegrering är installerad visar **Kommandohistorik** en sökbar lista över nyligen körda kommandon på den aktuella värden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu yüklüyse **Komut Geçmişi**, geçerli ana makinede yakın zamanda çalıştırılan komutların aranabilir bir listesini gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu đã cài Tích hợp shell, **Lịch sử lệnh** hiển thị danh sách có thể tìm kiếm các lệnh đã chạy gần đây trên máy chủ hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果安装了 Shell 集成功能，**命令历史记录**会显示当前主机上最近运行的命令可搜索列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若已安裝 Shell 整合，**指令歷史記錄**會顯示目前主機上最近執行過的指令的可搜尋列表。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.NamedMarks" : {
      "comment" : "Menu item help for the ‘Toolbelt.Named Marks’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pojmenovaná značka** se zobrazí jako modrý trojúhelník na levém okraji. Kromě snadného procházení pomocí **Další značka** a **Předchozí značka** najdete pojmenované značky také v tomto nástroji pásu nástrojů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et **navngivet mærke** vises som en blå trekant i venstre margen. Ud over at være nemt at navigere til med **Næste mærke** og **Forrige mærke** kan du også finde navngivne mærker i dette værktøj i værktøjsbæltet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine **Benannte Markierung** erscheint als blaues Dreieck am linken Rand. Sie lässt sich nicht nur einfach mit **Nächste Markierung** und **Vorherige Markierung** ansteuern, sondern Benannte Markierungen finden Sie auch in diesem Werkzeug des Werkzeuggürtels."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A **Named Mark** appears as a blue triangle in the left margin. In addition to being easy to navigate with **Next Mark** and **Previous Mark**, you can also find Named Marks in this Toolbelt tool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una **marca con nombre** aparece como un triángulo azul en el margen izquierdo. Además de poder navegar fácilmente con **Marca siguiente** y **Marca anterior**, también puedes encontrar las marcas con nombre en esta herramienta de la caja de herramientas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Nimetty merkki** näkyy sinisenä kolmiona vasemmassa marginaalissa. Sen lisäksi, että niiden välillä on helppo siirtyä komennoilla **Seuraava merkki** ja **Edellinen merkki**, nimetyt merkit löytyvät myös tästä työkaluvyön työkalusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une **marque nommée** apparaît sous la forme d’un triangle bleu dans la marge de gauche. En plus d’être facile à parcourir avec **Marque suivante** et **Marque précédente**, vous pouvez aussi retrouver les marques nommées dans cet outil de la boîte à outils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un **contrassegno con nome** appare come un triangolo blu nel margine sinistro. Oltre a essere facile da raggiungere con **Contrassegno successivo** e **Contrassegno precedente**, puoi trovare i contrassegni con nome anche in questo strumento della cassetta attrezzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**名前付きマーク**は左余白に青い三角形として表示されます。**次のマーク**や**前のマーク**で簡単に移動できるだけでなく、このツールベルトツールでも名前付きマークを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**이름 있는 마크**는 왼쪽 여백에 파란색 삼각형으로 표시됩니다. **다음 마크** 및 **이전 마크**로 쉽게 탐색할 수 있을 뿐만 아니라, 이 도구 벨트 도구에서도 이름 있는 마크를 찾을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et **navngitt merke** vises som en blå trekant i venstre margin. I tillegg til at det er enkelt å navigere med **Neste merke** og **Forrige merke**, finner du navngitte merker i dette verktøyet i verktøybeltet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een **benoemde markering** verschijnt als een blauwe driehoek in de linkermarge. Je navigeert er eenvoudig tussen met **Volgende markering** en **Vorige markering**, en je vindt benoemde markeringen ook in deze tool van de gereedschapsriem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Nazwany znacznik** pojawia się jako niebieski trójkąt na lewym marginesie. Oprócz łatwego przechodzenia za pomocą **Następny znacznik** i **Poprzedni znacznik** możesz też znaleźć nazwane znaczniki w tym narzędziu pasa narzędzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma **marca nomeada** aparece como um triângulo azul na margem esquerda. Além de serem fáceis de navegar com **Próxima marca** e **Marca anterior**, você também pode encontrar as marcas nomeadas nesta ferramenta da caixa de ferramentas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Именованная метка** отображается в виде синего треугольника на левом поле. Помимо удобной навигации с помощью **Следующая метка** и **Предыдущая метка**, именованные метки также можно найти в этом инструменте панели инструментов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Pomenovaná značka** sa zobrazí ako modrý trojuholník na ľavom okraji. Okrem jednoduchej navigácie pomocou **Ďalšia značka** a **Predošlá značka** nájdete pomenované značky aj v tomto nástroji Pása s nástrojmi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Poimenovana označba** se prikaže kot moder trikotnik na levem robu. Poleg preprostega pomikanja z ukazoma **Naslednja označba** in **Prejšnja označba** lahko poimenovane označbe najdete tudi v tem orodju v pasu z orodji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett **namngivet märke** visas som en blå triangel i vänstermarginalen. Förutom att det är lätt att navigera med **Nästa märke** och **Föregående märke** kan du också hitta namngivna märken i det här verktyget i verktygsbältet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir **Adlandırılmış İşaret**, sol kenar boşluğunda mavi bir üçgen olarak görünür. **Sonraki İşaret** ve **Önceki İşaret** ile kolayca gezinmenin yanı sıra, Adlandırılmış İşaretleri bu Araç Kemeri aracında da bulabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dấu có tên** xuất hiện dưới dạng tam giác xanh ở lề trái. Ngoài việc dễ di chuyển bằng **Dấu tiếp theo** và **Dấu trước**, bạn cũng có thể tìm Dấu có tên trong công cụ này của đai công cụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**命名标记**以左边缘的蓝色三角形形式出现。除了可以通过 **下一个标记** 和 **上一个标记** 轻松导航外，您还可以在此 Toolbelt 工具中找到命名标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**具名標記**會在左邊界顯示為藍色三角形。除了可用**下一個標記**和**上一個標記**輕鬆瀏覽外，你也可以在此工具帶工具中找到具名標記。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.Notes" : {
      "comment" : "Menu item help for the ‘Toolbelt.Notes’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Poznámky** jsou jeden trvalý blok poznámek ve vašem pásu nástrojů. Hodí se pro sledování toho, co děláte, nebo pro psaní zpráv."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Noter** er en enkelt, vedvarende notesblok i dit værktøjsbælte. Den er nyttig til at holde styr på, hvad du laver, eller til at skrive beskeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notizen** ist ein einzelner, dauerhafter Notizblock in Ihrem Werkzeuggürtel. Praktisch, um im Blick zu behalten, was Sie gerade tun, oder um Nachrichten zu verfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Notes** is a single, persistent notepad in your Toolbelt. It’s useful for keeping track of what you’re doing or composing messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notas** es un bloc de notas único y persistente en tu caja de herramientas. Es útil para llevar un registro de lo que estás haciendo o para redactar mensajes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Muistiinpanot** on yksi pysyvä muistiinpanoalusta työkaluvyössäsi. Se on hyödyllinen sen seuraamiseen, mitä olet tekemässä, tai viestien kirjoittamiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notes** est un bloc-notes unique et persistant dans votre boîte à outils. Il est utile pour garder une trace de ce que vous faites ou pour rédiger des messages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Note** è un unico blocco appunti persistente nella tua cassetta attrezzi. È utile per tenere traccia di ciò che stai facendo o per scrivere messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**メモ**は、ツールベルト内にある1つの永続的なメモ帳です。作業内容を記録したり、メッセージを作成したりするのに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**메모**는 도구 벨트에 있는 하나의 영구 메모장입니다. 하고 있는 작업을 기록하거나 메시지를 작성할 때 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notater** er én vedvarende notatblokk i verktøybeltet. Den er nyttig for å holde oversikt over hva du holder på med eller for å skrive meldinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notities** is één blijvend kladblok in je gereedschapsriem. Handig om bij te houden waar je mee bezig bent of om berichten op te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notatki** to pojedynczy, trwały notatnik w pasie narzędzi. Przydaje się do śledzenia tego, co robisz, lub do redagowania wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notas** é um bloco de notas único e persistente na sua caixa de ferramentas. É útil para controlar o que você está fazendo ou compor mensagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Заметки** представляют собой единый, постоянно сохраняемый блокнот на панели инструментов. Это удобно для отслеживания того, чем вы занимаетесь, или для составления сообщений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Poznámky** sú jeden trvalý poznámkový blok vo vašom Páse s nástrojmi. Hodí sa na sledovanie toho, čo robíte, alebo na písanie správ."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zapiski** so en sam trajen notesnik v vašem pasu z orodji. Uporaben je za beleženje, kaj počnete, ali za sestavljanje sporočil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Anteckningar** är ett enda, bestående anteckningsblock i verktygsbältet. Det är användbart för att hålla reda på vad du gör eller för att skriva meddelanden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Notlar**, Araç Kemeri’nizdeki tek ve kalıcı bir not defteridir. Ne yaptığınızı takip etmek veya mesaj yazmak için yararlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Ghi chú** là một sổ tay duy nhất, lưu lâu dài trong đai công cụ của bạn. Nó hữu ích để theo dõi việc bạn đang làm hoặc soạn tin nhắn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**备注**是您 Toolbelt 中的单个持久性记事本。它有助于记录您的操作或撰写消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**備註**是你工具帶中單一的持久記事本。適合用來記錄你正在做的事或撰寫訊息。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.PasteHistory" : {
      "comment" : "Menu item help for the ‘Toolbelt.Paste History’ menu item",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Historie vkládání** zobrazuje text, který jste v iTerm2 zkopírovali a vložili. Můžete ji nastavit tak, aby se ukládala dlouhodobě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Indsætningshistorik** viser tekst, du har kopieret og sat ind i iTerm2. Du kan konfigurere den til at blive gemt på lang sigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Einfügeverlauf** zeigt Text, den Sie in iTerm2 kopiert und eingefügt haben. Sie können ihn so konfigurieren, dass er langfristig gespeichert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**Paste History** shows text that you have copied and pasted in iTerm2. You can configure it to be saved long term."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El **historial de pegado** muestra el texto que has copiado y pegado en iTerm2. Puedes configurarlo para que se guarde a largo plazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Sijoitushistoria** näyttää tekstin, jonka olet kopioinut ja sijoittanut iTerm2:ssa. Voit määrittää sen tallennettavaksi pitkäaikaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’**historique des collages** affiche le texte que vous avez copié et collé dans iTerm2. Vous pouvez le configurer pour qu’il soit conservé à long terme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La **cronologia incolla** mostra il testo che hai copiato e incollato in iTerm2. Puoi configurarla per essere salvata a lungo termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ペースト履歴**は、iTerm2でコピー・ペーストしたテキストを表示します。長期間保存されるように設定することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**붙여넣기 기록**은 iTerm2에서 복사하고 붙여넣은 텍스트를 보여 줍니다. 장기간 저장하도록 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Innlimingshistorikk** viser tekst du har kopiert og limt inn i iTerm2. Du kan konfigurere den til å lagres over lang tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Plakgeschiedenis** toont tekst die je in iTerm2 hebt gekopieerd en geplakt. Je kunt instellen dat de geschiedenis langdurig wordt bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Historia wklejania** pokazuje tekst skopiowany i wklejony w iTerm2. Możesz skonfigurować jej długotrwałe zapisywanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O **Histórico de colagem** mostra o texto que você copiou e colou no iTerm2. Você pode configurá-lo para ser salvo a longo prazo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**История вставок** показывает текст, который вы копировали и вставляли в iTerm2. Вы можете настроить её для долгосрочного хранения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**História vkladania** zobrazuje text, ktorý ste skopírovali a vložili v iTerm2. Môžete ju nastaviť tak, aby sa ukladala dlhodobo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Zgodovina lepljenja** prikaže besedilo, ki ste ga kopirali in prilepili v aplikaciji iTerm2. Nastavite jo lahko tako, da se shrani za daljši čas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Inklistringshistorik** visar text som du har kopierat och klistrat in i iTerm2. Du kan konfigurera den så att den sparas långsiktigt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Yapıştırma Geçmişi**, iTerm2’de kopyalayıp yapıştırdığınız metinleri gösterir. Uzun süre saklanacak şekilde yapılandırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Lịch sử dán** hiển thị văn bản bạn đã sao chép và dán trong iTerm2. Bạn có thể định cấu hình để lưu lâu dài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**粘贴历史记录**显示您在 iTerm2 中复制并粘贴的文本。您可以配置将其长期保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**貼上歷史記錄**會顯示你在 iTerm2 中拷貝並貼上的文字。你可以設定為長期儲存。"
          }
        }
      }
    },
    "MenuTip.Toolbelt.Profiles" : {
