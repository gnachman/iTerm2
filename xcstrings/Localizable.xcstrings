    "Tip.0051.Body" : {
      "comment" : "Tip of the day body, id 0051",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie „Mindestkontrast“ unter „Einstellungen > Profile > Farben“ an, damit Text unabhängig von der Kombination aus Text- und Hintergrundfarbe immer lesbar bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust “Minimum Contrast” in “Settings > Profiles > Colors” to ensure text is always legible regardless of text/background color combination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta “Contraste mínimo” en “Ajustes > Perfiles > Colores” para asegurar que el texto sea siempre legible, sea cual sea la combinación de colores de texto y fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez « Contraste minimum » dans « Réglages > Profils > Couleurs » pour que le texte reste toujours lisible, quelle que soit la combinaison de couleurs du texte et de l’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola “Contrasto minimo” in “Impostazioni > Profili > Colori” per garantire che il testo sia sempre leggibile, qualunque sia la combinazione di colori del testo e dello sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」で「最小コントラスト」を調整すると、文字色と背景色の組み合わせにかかわらず、常にテキストを読みやすくできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상”에서 “최소 대비”를 조절하면 텍스트/배경 색상 조합에 관계없이 항상 텍스트를 읽을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste “Contraste mínimo” em “Ajustes > Perfis > Cores” para garantir que o texto seja sempre legível, independentemente da combinação de cores de texto e fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте «Минимальный контраст» в «Настройки > Профили > Цвета», чтобы текст всегда оставался читаемым независимо от сочетания цветов текста и фона."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin/arka plan rengi bileşiminden bağımsız olarak metnin her zaman okunaklı olmasını sağlamak için “Ayarlar > Profiller > Renkler” bölümünde “Minimum kontrast”ı ayarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 颜色”中调整“最小对比度”，以确保无论文本与背景颜色如何组合，文本始终清晰可辨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 描述檔 > 顏色」中調整「最小對比度」，可確保無論文字與背景顏色如何搭配，文字都清晰易讀。"
          }
        }
      }
    },
