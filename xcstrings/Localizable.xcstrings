          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回報變數「%@」的請求已被拒絕。日後要允許嗎？"
          }
        }
      }
    },
    "NaggingController.ResetKeyReportingMode" : {
      "comment" : "Prompt asking whether to reset the key reporting mode",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim hlášení kláves mohl zůstat v neobvyklém nastavení po ukončení relace SSH nebo pádu aplikace. Obnovit?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporteringstilstanden for taster er muligvis blevet efterladt i en usædvanlig indstilling, da en ssh-session døde, eller et program gik ned. Vil du gendanne?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Modus zur Tastenberichterstattung wurde möglicherweise in einer ungewöhnlichen Einstellung belassen, als eine ssh-Sitzung abbrach oder eine App abgestürzt ist. Wiederherstellen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The key reporting mode may have been left in an unusual setting when an ssh session died or an app crashed. Restore?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el modo de informe de teclas haya quedado en un estado inusual cuando una sesión ssh murió o una app falló. ¿Restaurarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näppäinraportoinnin tila on voinut jäädä epätavalliseen asetukseen, kun SSH-istunto kuoli tai sovellus kaatui. Palautetaanko se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode de signalement des touches a peut-être été laissé dans un état inhabituel après la fin d’une session ssh ou le plantage d’une app. Le restaurer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità di segnalazione dei tasti potrebbe essere rimasta in un’impostazione insolita perché una sessione ssh è terminata o un’app è andata in crash. Ripristinarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHセッションが切断されたか、アプリがクラッシュしたため、キーレポートモードが通常とは異なる設定のままになっている可能性があります。復元しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh 세션이 종료되거나 앱이 충돌했을 때 키 리포팅 모드가 비정상적인 설정으로 남아 있을 수 있습니다. 복원하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporteringsmodus for taster kan ha blitt stående i en uvanlig innstilling da en ssh-økt døde eller en app krasjet. Vil du gjenopprette?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toetsrapportagemodus is mogelijk in een ongebruikelijke stand blijven staan doordat een ssh-sessie is gestopt of een app is gecrasht. Wil je de modus terugzetten?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb raportowania klawiszy mógł zostać pozostawiony w nietypowym ustawieniu, gdy sesja SSH się zakończyła lub aplikacja uległa awarii. Przywrócić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de relatório de teclas pode ter ficado em uma configuração incomum quando uma sessão ssh foi encerrada ou um app travou. Restaurar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим отчётов о клавишах мог остаться в необычном состоянии после завершения SSH-сессии или сбоя приложения. Восстановить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim hlásenia klávesov mohol zostať v neobvyklom nastavení po zlyhaní relácie ssh alebo aplikácie. Obnoviť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način poročanja tipk je morda ostal v nenavadni nastavitvi, ker je seja ssh odpovedala ali se je aplikacija zrušila. Obnovim?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangentrapporteringsläget kan ha lämnats i en ovanlig inställning när en ssh-session dog eller en app kraschade. Vill du återställa det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ssh oturumu öldüğünde veya bir uygulama çöktüğünde tuş raporlama modu alışılmadık bir ayarda kalmış olabilir. Geri yüklensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ báo cáo phím có thể đã bị để ở thiết lập bất thường khi phiên ssh chết hoặc ứng dụng gặp sự cố. Khôi phục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ssh 会话终止或某个应用崩溃后，按键报告模式可能被留在了异常设置上。要恢复吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 ssh 工作階段中斷或 App 當機時，按鍵回報模式可能被留在異常的設定。要回復嗎？"
          }
        }
      }
    },
