    "AdvancedSetting.showWindowTitleWhenTabBarInvisible" : {
      "comment" : "Advanced setting: showWindowTitleWhenTabBarInvisible",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit název okna, když není viditelný řádek panelů?\nPokud je vypnuto, název panelu se zobrazí tam, kde by normálně byl název okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis vinduets titel, når fanelinjen ikke er synlig?\nNår det er slået fra, vises fanens titel, hvor vinduets titel normalt står."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstertitel anzeigen, wenn die Tab-Leiste nicht sichtbar ist?\nWenn deaktiviert, wird der Titel des Tabs dort angezeigt, wo normalerweise der Fenstertitel stehen würde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show window title when the tab bar is not visible?\nWhen disabled, the tab's title will be shown where the window title would normally go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mostrar el título de la ventana cuando la barra de pestañas no es visible?\nSi está desactivado, el título de la pestaña se mostrará donde normalmente va el título de la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytetäänkö ikkunan otsikko, kun välilehtipalkki ei ole näkyvissä?\nKun ei käytössä, välilehden otsikko näytetään siinä, missä ikkunan otsikko normaalisti olisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher le titre de la fenêtre lorsque la barre d’onglets n’est pas visible ?\nSi désactivé, le titre de l’onglet sera affiché à l’emplacement habituel du titre de la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrare il titolo della finestra quando la barra dei pannelli non è visibile?\nSe disattivato, il titolo del pannello verrà mostrato dove di solito va il titolo della finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーが表示されていないときにウィンドウタイトルを表示するか？\n無効にすると、通常ウィンドウタイトルが表示される場所にタブのタイトルが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대가 보이지 않을 때 윈도우 제목을 표시하겠습니까?\n끄면 보통 윈도우 제목이 표시되는 위치에 탭 제목이 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis vindustittel når fanelinjen ikke er synlig?\nNår dette er deaktivert, vises fanens tittel der vindustittelen normalt står."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De venstertitel tonen wanneer de tabbladbalk niet zichtbaar is?\nAls dit is uitgeschakeld, wordt de titel van het tabblad getoond waar normaal de venstertitel staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy pokazywać tytuł okna, gdy pasek kart jest niewidoczny?\nGdy wyłączone, tytuł karty będzie pokazywany tam, gdzie zwykle jest tytuł okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o título da janela quando a barra de abas não estiver visível?\nQuando desativado, o título da aba será mostrado onde o título da janela normalmente ficaria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать заголовок окна, когда панель вкладок не видна?\nЕсли отключено, на месте заголовка окна будет показан заголовок вкладки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť názov okna, keď lišta s tabmi nie je viditeľná?\nKeď je vypnuté, názov tabu sa zobrazí tam, kde by bol bežne názov okna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj se naslov okna prikaže, ko vrstica z zavihki ni vidna?\nČe je onemogočeno, se naslov zavihka prikaže tam, kjer bi bil običajno naslov okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa fönstertiteln när flikfältet inte är synligt?\nNär det är avaktiverat visas flikens titel där fönstertiteln normalt skulle vara."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğu görünür değilken pencere başlığı gösterilsin mi?\nDevre dışıyken, pencere başlığının normalde yer alacağı yerde sekmenin başlığı gösterilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị tiêu đề cửa sổ khi thanh tab không hiển thị?\nKhi tắt, tiêu đề của tab sẽ được hiển thị ở nơi thường dành cho tiêu đề cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签页栏不可见时显示窗口标题？\n当禁用时，标签页的标题将显示在通常放置窗口标题的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤頁列不可見時顯示視窗標題？\n停用時，視窗標題通常所在的位置會顯示標籤頁的標題。"
          }
        }
      }
    },
