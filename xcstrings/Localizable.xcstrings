    "Codecierge.DangerWarningBody" : {
      "comment" : "Body of the Codecierge auto-run danger warning",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch kann eine KI Ihren Computer vollständig steuern. Sie könnte Ihre Dateien löschen, etwas Dummes oder Gefährliches tun oder zum Untergang der Menschheit führen. Gehen Sie mit Vorsicht vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This lets an AI completely control your computer. It could delete your files, do something stupid or dangerous, or lead to the downfall of humanity. Proceed with caution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto permite que una IA controle por completo tu Mac. Podría borrar tus archivos, hacer algo estúpido o peligroso, o provocar la caída de la humanidad. Procede con precaución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela permet à une IA de contrôler entièrement votre ordinateur. Elle pourrait supprimer vos fichiers, faire quelque chose de stupide ou de dangereux, ou provoquer la chute de l’humanité. Procédez avec prudence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo permette a un’IA di controllare completamente il tuo computer. Potrebbe eliminare i tuoi file, fare qualcosa di stupido o pericoloso, o portare alla rovina dell’umanità. Procedi con cautela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、AIがあなたのコンピュータを完全に制御できるようになります。ファイルを削除したり、愚かで危険なことをしたり、人類の滅亡につながったりする可能性があります。十分に注意して進めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 컴퓨터를 완전히 제어하게 됩니다. 파일을 삭제하거나, 어리석거나 위험한 일을 하거나, 인류의 몰락을 초래할 수도 있습니다. 주의해서 진행하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso permite que uma IA controle completamente o seu computador. Ela pode apagar seus arquivos, fazer algo estúpido ou perigoso, ou levar à ruína da humanidade. Prossiga com cautela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это позволяет ИИ полностью управлять вашим компьютером. Он может удалить ваши файлы, сделать что-то глупое или опасное или привести к гибели человечества. Действуйте осторожно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bir YZ’nin bilgisayarınızı tamamen denetlemesine izin verir. Dosyalarınızı silebilir, aptalca veya tehlikeli bir şey yapabilir ya da insanlığın çöküşüne yol açabilir. Dikkatli ilerleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将让 AI 完全控制你的电脑。它可能会删除你的文件、做出愚蠢或危险的事情，甚至导致人类走向灭亡。请谨慎操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會讓 AI 完全控制你的電腦。它可能會刪除你的檔案、做出愚蠢或危險的事，甚至導致人類的滅亡。請謹慎操作。"
          }
        }
      }
    },
