    "ChatWindowController.OpenFailedMessage" : {
      "comment" : "Error message when the AI chat window cannot open due to a database problem",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Chat konnte nicht geöffnet werden, da beim Laden der Datenbank ein Problem aufgetreten ist. Stellen Sie sicher, dass nur eine Instanz von iTerm2 ausgeführt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI Chat could not open because of a problem loading the database. Verify there is only one instance of iTerm2 running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El chat de IA no pudo abrirse por un problema al cargar la base de datos. Comprueba que solo haya una instancia de iTerm2 en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chat IA n’a pas pu s’ouvrir à cause d’un problème de chargement de la base de données. Vérifiez qu’une seule instance d’iTerm2 est en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire la chat IA a causa di un problema nel caricamento del database. Verifica che sia in esecuzione una sola istanza di iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースの読み込みで問題が発生したため、AIチャットを開けませんでした。iTerm2のインスタンスが1つだけ実行されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스를 불러오는 중 문제가 발생하여 AI 채팅을 열 수 없습니다. iTerm2가 하나만 실행 중인지 확인하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O chat de IA não pôde ser aberto por causa de um problema ao carregar o banco de dados. Verifique se há apenas uma instância do iTerm2 em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат ИИ не удалось открыть из-за проблемы с загрузкой базы данных. Убедитесь, что запущен только один экземпляр iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veritabanı yüklenirken bir sorun oluştuğu için YZ Sohbeti açılamadı. iTerm2’nin yalnızca bir örneğinin çalıştığından emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 聊天无法打开，因为加载数据库时出现问题。请确认只有一个 iTerm2 实例在运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 聊天無法打開，因為載入資料庫時發生問題。請確認只有一個 iTerm2 實例正在執行。"
          }
        }
      }
    },
