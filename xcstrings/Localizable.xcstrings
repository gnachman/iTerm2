    "PseudoTerminal.KillOrHideTmux" : {
      "comment" : "Confirmation prompt when closing a tmux tab",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux-Fenster beenden und dessen Prozesse abbrechen oder ausblenden? Ausgeblendete Fenster können über das tmux-Dashboard wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill tmux window, terminating its jobs, or hide it? Hidden windows may be restored from the tmux dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Terminar la ventana de tmux, finalizando sus procesos, o bien ocultarla? Las ventanas ocultas se pueden restaurar desde el Tablero de tmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminer la fenêtre tmux, ce qui arrête ses processus, ou la masquer ? Les fenêtres masquées peuvent être restaurées depuis le tableau de bord tmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminare la finestra tmux, interrompendone i processi, oppure nasconderla? Le finestre nascoste possono essere ripristinate dalla dashboard di tmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxウィンドウを強制終了してジョブを終了させますか、それとも非表示にしますか？非表示にしたウィンドウはtmuxダッシュボードから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 윈도우를 종료하여 작업을 끝내겠습니까, 아니면 가리겠습니까? 가린 윈도우는 tmux 대시보드에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar a janela do tmux, encerrando suas tarefas, ou ocultá-la? Janelas ocultas podem ser restauradas pelo painel do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть окно tmux, завершив его процессы, или скрыть его? Скрытые окна можно восстановить из панели tmux."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux penceresi sonlandırılıp işlemleri durdurulsun mu, yoksa gizlensin mi? Gizlenen pencereler tmux Gösterge Paneli’nden geri yüklenebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终止 tmux 窗口及其任务，还是隐藏它？隐藏的窗口可以从 tmux 仪表盘中恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要終止 tmux 視窗並結束其程序，還是將它隱藏？隱藏的視窗可從 tmux 儀表板回復。"
          }
        }
      }
    },
    "PseudoTerminal.KillTmuxWindowMany" : {
      "comment" : "Confirmation prompt when closing multiple tmux windows",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tmux-Fenster und deren Prozesse beenden, Fenster ausblenden oder von der tmux-Sitzung trennen?\n\nAusgeblendete Fenster können über das tmux-Dashboard wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill all tmux windows and their jobs, hide windows from view, or detach from tmux session?\n\nHidden windows may be restored from the tmux dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Terminar todas las ventanas de tmux y sus procesos, ocultar las ventanas o desconectarte de la sesión de tmux?\n\nLas ventanas ocultas se pueden restaurar desde el Tablero de tmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminer toutes les fenêtres tmux et leurs processus, les masquer, ou se détacher de la session tmux ?\n\nLes fenêtres masquées peuvent être restaurées depuis le tableau de bord tmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminare tutte le finestre tmux e i relativi processi, nascondere le finestre o scollegarsi dalla sessione tmux?\n\nLe finestre nascoste possono essere ripristinate dalla dashboard di tmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのtmuxウィンドウとそのジョブを強制終了しますか、ウィンドウを非表示にしますか、それともtmuxセッションからデタッチしますか？\n\n非表示にしたウィンドウはtmuxダッシュボードから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 tmux 윈도우와 해당 작업을 종료하겠습니까, 윈도우를 가리겠습니까, 아니면 tmux 세션에서 분리하겠습니까?\n\n가린 윈도우는 tmux 대시보드에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar todas as janelas do tmux e suas tarefas, ocultar as janelas, ou desanexar da sessão do tmux?\n\nJanelas ocultas podem ser restauradas pelo painel do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть все окна tmux вместе с их процессами, скрыть окна из вида или отключиться от сеанса tmux?\n\nСкрытые окна можно восстановить из панели tmux."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm tmux pencereleri ve işlemleri sonlandırılsın mı, pencereler görünümden gizlensin mi, yoksa tmux oturumundan ayrılınsın mı?\n\nGizlenen pencereler tmux Gösterge Paneli’nden geri yüklenebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终止所有 tmux 窗口及其作业、从视图中隐藏窗口，或从 tmux 会话分离？\n\n隐藏的窗口可从 tmux 仪表盘中恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要終止所有 tmux 視窗及其程序、將視窗隱藏，還是從 tmux 工作階段分離？\n\n隱藏的視窗可從 tmux 儀表板回復。"
          }
        }
      }
    },
    "PseudoTerminal.KillTmuxWindowOne" : {
      "comment" : "Confirmation prompt when closing a single tmux window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenster und dessen Prozesse beenden, Fenster ausblenden oder von der tmux-Sitzung trennen?\n\nAusgeblendete Fenster können über das tmux-Dashboard wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kill window and its jobs, hide window from view, or detach from tmux session?\n\nHidden windows may be restored from the tmux dashboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Terminar la ventana y sus procesos, ocultarla o desconectarte de la sesión de tmux?\n\nLas ventanas ocultas se pueden restaurar desde el Tablero de tmux."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminer la fenêtre et ses processus, la masquer, ou se détacher de la session tmux ?\n\nLes fenêtres masquées peuvent être restaurées depuis le tableau de bord tmux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminare la finestra e i relativi processi, nasconderla o scollegarsi dalla sessione tmux?\n\nLe finestre nascoste possono essere ripristinate dalla dashboard di tmux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウとそのジョブを強制終了しますか、ウィンドウを非表示にしますか、それともtmuxセッションからデタッチしますか？\n\n非表示にしたウィンドウはtmuxダッシュボードから復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우와 그 작업을 강제 종료하거나, 윈도우를 화면에서 가리거나, tmux 세션에서 분리하겠습니까?\n\n가려진 윈도우는 tmux 대시보드에서 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminar a janela e suas tarefas, ocultar a janela, ou desanexar da sessão do tmux?\n\nJanelas ocultas podem ser restauradas pelo painel do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть окно вместе с его процессами, скрыть окно из вида или отключиться от сеанса tmux?\n\nСкрытые окна можно восстановить из панели tmux."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere ve işlemleri sonlandırılsın mı, pencere görünümden gizlensin mi, yoksa tmux oturumundan ayrılınsın mı?\n\nGizlenen pencereler tmux Gösterge Paneli’nden geri yüklenebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终止窗口及其作业、从视图中隐藏窗口，或从 tmux 会话分离？\n\n隐藏的窗口可从 tmux 仪表盘中恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要終止視窗及其程序、將視窗隱藏，還是從 tmux 工作階段分離？\n\n隱藏的視窗可從 tmux 儀表板回復。"
          }
        }
      }
    },
