    "ClaudeCode.DisableAPIBody" : {
      "comment" : "Explanation shown when asking whether to disable the Python API during uninstall",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalátor zapnul rozhraní Python API aplikace iTerm2. Mohou ho nyní používat jiné skripty nebo integrace. Ponechat zapnuté, nebo vypnout?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationsprogrammet slog Python API i iTerm2 til. Andre instrukser eller integrationer bruger den muligvis nu. Vil du lade den være slået til eller slå den fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Installationsprogramm hat die Python-API von iTerm2 aktiviert. Andere Skripte oder Integrationen verwenden sie möglicherweise bereits. Soll sie aktiviert bleiben oder abgeschaltet werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The installer enabled iTerm2’s Python API. Other scripts or integrations may be using it now. Leave it enabled, or turn it off?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El instalador activó la API de Python de iTerm2. Es posible que otros scripts o integraciones la estén usando ahora. ¿Quieres dejarla activada o desactivarla?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asennusohjelma otti iTerm2:n Python API:n käyttöön. Muut skriptit tai integraatiot saattavat käyttää sitä nyt. Jätetäänkö se käyttöön vai laitetaanko se pois päältä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d’installation a activé l’API Python d’iTerm2. D’autres scripts ou intégrations peuvent l’utiliser actuellement. La laisser activée ou la désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di installazione ha abilitato l’API Python di iTerm2. Altri script o integrazioni potrebbero usarla ora. Vuoi lasciarla abilitata o disabilitarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストーラーはiTerm2のPython APIを有効にしました。現在、他のスクリプトや連携機能がこれを使用している可能性があります。有効のままにしますか、それともオフにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치 프로그램이 iTerm2의 Python API를 활성화했습니다. 지금 다른 스크립트나 통합 기능에서 이를 사용하고 있을 수 있습니다. 활성화된 상태로 두겠습니까, 아니면 끄겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installasjonsprogrammet aktiverte iTerm2s Python API. Andre skript eller integreringer kan bruke det nå. Vil du la det være aktivert, eller slå det av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het installatieprogramma heeft de Python-API van iTerm2 ingeschakeld. Andere scripts of integraties gebruiken die mogelijk nu. Laat je de API ingeschakeld of schakel je hem uit?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalator włączył API Pythona iTerm2. Inne skrypty lub integracje mogą z niego teraz korzystać. Pozostawić je włączone czy wyłączyć?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O instalador ativou a Python API do iTerm2. Outros scripts ou integrações podem estar usando-a agora. Deixar ativada, ou desativá-la?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установщик включил Python API iTerm2. Сейчас его могут использовать другие скрипты или интеграции. Оставить включённым или отключить?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inštalátor zapol Python API aplikácie iTerm2. Môžu ho teraz používať iné skripty alebo integrácie. Ponechať zapnuté, alebo vypnúť?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namestitveni program je omogočil API Python v iTerm2. Morda ga zdaj uporabljajo drugi skripti ali integracije. Ga pustite omogočenega ali ga izklopite?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installationsprogrammet aktiverade iTerm2:s Python-API. Andra skript eller integreringar kanske använder det nu. Vill du låta det vara aktiverat eller stänga av det?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleyici iTerm2’nin Python API’sini etkinleştirmişti. Diğer betikler veya entegrasyonlar şu anda bunu kullanıyor olabilir. Etkin kalsın mı, yoksa kapatılsın mı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình cài đặt đã bật API Python của iTerm2. Các tập lệnh hoặc tích hợp khác có thể đang dùng nó. Giữ nguyên trạng thái bật hay tắt đi?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序启用了 iTerm2 的 Python API。其他脚本或集成现在可能正在使用它。保持启用，还是将其关闭？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝程式已啟用 iTerm2 的 Python API。其他腳本或整合功能現在可能正在使用它。要保持啟用，還是將其關閉？"
          }
        }
      }
    },
