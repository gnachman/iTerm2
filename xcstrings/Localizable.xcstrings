          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисовать нижнюю линию для горизонтальной панели вкладок в темах Regular, Dark и Light?"
          }
        },
        "tr" : {
          "stringUnit" : {
