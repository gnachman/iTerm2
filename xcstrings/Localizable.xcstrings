    "Tip.0086.Body" : {
      "comment" : "Tip of the day body, id 0086",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie mit „Codecierge“, einer Funktion im Werkzeugkasten, Terminalziele fest und erreichen Sie sie. Sie werden dabei anhand Ihrer Terminalaktivität Schritt für Schritt begleitet. Für diese Funktion ist ein OpenAI-API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set and achieve terminal goals with “Codecierge”, a Toolbelt feature that guides you step-by-step based on your terminal activity. An OpenAI API key is necessary for this feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija y alcanza objetivos en la terminal con “Codecierge”, una función de la Caja de herramientas que te guía paso a paso según tu actividad en la terminal. Esta función requiere una clave de API de OpenAI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixez-vous des objectifs dans le terminal et atteignez-les avec « Codecierge », une fonctionnalité de la boîte à outils qui vous guide pas à pas selon votre activité dans le terminal. Une clé d’API OpenAI est nécessaire pour cette fonctionnalité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definisci e raggiungi obiettivi nel terminale con “Codecierge”, una funzione della Cassetta attrezzi che ti guida passo dopo passo in base alla tua attività nel terminale. Per questa funzione è necessaria una chiave API di OpenAI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Codecierge」を使うと、ターミナルでの目標を設定して達成できます。これはターミナルでの操作に基づいて段階的に案内してくれるツールベルトの機能です。この機能にはOpenAI APIキーが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 활동을 바탕으로 단계별로 안내해 주는 도구 벨트 기능인 “Codecierge”로 터미널 작업 목표를 설정하고 달성하십시오. 이 기능에는 OpenAI API 키가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina e alcance metas no terminal com o “Concierge de código”, um recurso da Caixa de ferramentas que orienta você passo a passo com base na sua atividade no terminal. Uma chave de API da OpenAI é necessária para esse recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте и достигайте целей в терминале с помощью «Codecierge», инструмента панели инструментов, который пошагово направляет вас на основе вашей активности в терминале. Для этой функции необходим ключ API OpenAI."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal etkinliğinize göre sizi adım adım yönlendiren bir Araç Kemeri özelliği olan “Codecierge” ile terminal hedefleri belirleyin ve bunlara ulaşın. Bu özellik için bir OpenAI API anahtarı gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Codecierge”是一个工具包功能，根据你的终端活动逐步指导你实现终端目标。此功能需要OpenAI API密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用「Codecierge」設定並達成終端機目標，這是一項工具帶功能，會根據你的終端機活動逐步引導你。此功能需要 OpenAI API 金鑰。"
          }
        }
      }
    },
