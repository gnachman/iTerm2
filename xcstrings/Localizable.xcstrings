    "DependencyEditor.ConfirmDowngradeMessage" : {
      "comment" : "Confirmation prompt before downgrading the Python version",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben ein Downgrade auf eine ältere Python-Version angefordert. Abhängigkeiten müssen neu installiert werden. Das könnte schiefgehen. Möchten Sie wirklich fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have asked to downgrade to an older Python version. Dependencies will need to be reinstalled. This may go badly. Are you sure you want to do this?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has solicitado volver a una versión anterior de Python. Habrá que reinstalar las dependencias. Podría salir mal. ¿Seguro que quieres hacerlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez demandé le passage à une version antérieure de Python. Les dépendances devront être réinstallées. Cela peut mal se passer. Voulez-vous vraiment continuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai chiesto di passare a una versione precedente di Python. Le dipendenze dovranno essere reinstallate. Potrebbe andare male. Vuoi davvero procedere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いPythonのバージョンにダウングレードしようとしています。依存関係を再インストールする必要があります。うまくいかない可能性があります。本当に実行しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 Python 버전으로 다운그레이드하도록 요청했습니다. 의존성을 다시 설치해야 하며, 문제가 생길 수 있습니다. 정말로 진행하겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você solicitou o downgrade para uma versão mais antiga do Python. As dependências precisarão ser reinstaladas. Isso pode dar errado. Tem certeza de que deseja fazer isso?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы запросили понижение версии Python до более старой. Зависимости придётся переустановить. Это может пройти неудачно. Вы уверены, что хотите продолжить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python’ın daha eski bir sürümüne geçmeyi istediniz. Bağımlılıkların yeniden yüklenmesi gerekecek. Bu iyi sonuçlanmayabilir. Yine de yapmak istediğinizden emin misiniz?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已请求降级到较旧的 Python 版本。依赖项需要重新安装。这可能不太顺利。确定要这样做吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已要求降級到較舊的 Python 版本。相依項目需要重新安裝，過程可能不太順利。確定要這麼做嗎？"
          }
        }
      }
    },
