    "AdvancedSetting.noSyncDoNotWarnBeforeMultilinePaste" : {
      "comment" : "Advanced setting: noSyncDoNotWarnBeforeMultilinePaste",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovat upozornění na vkládání více řádků (nebo jednoho řádku končícího novým řádkem).\nPlatí to bez ohledu na to, zda jste na výzvě shellu, pokud se vkládají dva nebo více řádků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul advarsel om indsætning af flere linjer (eller en enkelt linje, der slutter med et linjeskift).\nDette gælder uanset om du står ved shellens prompt eller ej, så længe to eller flere linjer indsættes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung über mehrzeiliges Einfügen (oder eine einzelne Zeile, die mit einem Zeilenumbruch endet) unterdrücken.\nDies gilt unabhängig davon, ob Sie sich an der Shell-Eingabeaufforderung befinden, sofern zwei oder mehr Zeilen eingefügt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Suppress warning about multi-line pastes (or a single line ending in a newline).\nThis applies whether you are at the shell prompt or not, provided two or more lines are being pasted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprime la advertencia sobre pegados de varias líneas (o de una sola línea que termina en un salto de línea).\nSe aplica estés o no en el prompt del shell, siempre que se peguen dos o más líneas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaimenna varoitus usean rivin sijoituksista (tai yhdestä rivistä, joka päättyy rivinvaihtoon).\nTämä pätee riippumatta siitä, oletko komentokehotteessa vai et, kunhan sijoitetaan kaksi tai useampia rivejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver l’avertissement sur les collages de plusieurs lignes (ou d’une seule ligne se terminant par un saut de ligne).\nCela s’applique que vous soyez ou non à l’invite du shell, dès lors que deux lignes ou plus sont collées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva l’avviso sugli incolla su più righe (o su una singola riga che termina con un a capo).\nSi applica sia che tu sia al prompt della shell sia che non lo sia, purché vengano incollate due o più righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数行の貼り付け（または改行で終わる1行）に関する警告を表示しない。\nこれはシェルプロンプトにいるかどうかに関わらず、2行以上が貼り付けられる場合に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 줄 붙여넣기(또는 줄바꿈으로 끝나는 한 줄)에 대한 경고를 표시하지 않습니다.\n두 줄 이상을 붙여넣는 경우 셸 프롬프트에 있는지 여부와 관계없이 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vis advarsel om innliming av flere linjer (eller én linje som slutter med linjeskift).\nDette gjelder uansett om du står ved ledeteksten eller ikke, så lenge to eller flere linjer limes inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdruk de waarschuwing over plakken van meerdere regels (of één regel die eindigt op een nieuwe regel).\nDit geldt of je nu bij de shell-prompt bent of niet, zolang er twee of meer regels worden geplakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pokazuj ostrzeżenia o wklejaniu wielu wierszy (lub jednego wiersza zakończonego znakiem nowego wiersza).\nDotyczy to zarówno sytuacji, gdy jesteś przy znaku zachęty powłoki, jak i nie, o ile wklejane są co najmniej dwa wiersze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suprimir o aviso sobre colagens de várias linhas (ou de uma única linha que termina em quebra de linha).\nIsto se aplica esteja você no prompt do shell ou não, desde que duas ou mais linhas estejam sendo coladas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить предупреждение о вставке многострочного текста (или одной строки, заканчивающейся переносом строки).\nЭто применяется независимо от того, находитесь ли вы в командной строке оболочки, если вставляется две и более строк."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezobrazovať upozornenie na viacriadkové vkladanie (alebo jeden riadok končiaci znakom nového riadka).\nPlatí to bez ohľadu na to, či ste pri výzve shellu, ak sa vkladajú dva alebo viac riadkov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prikaži opozorila o večvrstičnem lepljenju (ali eni vrstici, ki se konča z novo vrstico).\nTo velja ne glede na to, ali ste pri ukaznem pozivu lupine, če se lepita dve ali več vrstic."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj varningen om inklistring av flera rader (eller en enda rad som slutar med nyrad).\nDet gäller oavsett om du står vid skalpromten eller inte, så länge två eller fler rader klistras in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok satırlı yapıştırmalar (veya yeni satırla biten tek satır) için uyarıyı bir daha gösterme.\nKabuk isteminde olsanız da olmasanız da, iki veya daha fazla satır yapıştırılıyorsa bu geçerlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không hiển thị cảnh báo về dán nhiều dòng (hoặc một dòng kết thúc bằng ký tự xuống dòng).\nĐiều này áp dụng dù bạn có đang ở dấu nhắc shell hay không, miễn là có từ hai dòng trở lên được dán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抑制多行粘贴（或单行以换行结尾）的警告。\n无论是否处于shell提示符下，只要粘贴了两行或更多行，此规则均适用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再顯示多行貼上（或以換行結尾的單行）的警告。\n無論是否位於 shell 提示符號處，只要貼上兩行或更多行，此設定都適用。"
          }
        }
      }
    },
    "AdvancedSetting.noSyncDoNotWarnBeforePastingOneLineEndingInNewlineAtShellPrompt" : {
