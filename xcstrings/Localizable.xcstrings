    "AdvancedSetting.advancedPasteWaitsForPromptByDefault" : {
      "comment" : "Advanced setting: advancedPasteWaitsForPromptByDefault",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má pokročilé vkládání ve výchozím nastavení automaticky zapnout volbu „Před vložením každého řádku počkat na výzvu shellu“, když je zjištěna integrace shellu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal Avanceret indsætning automatisk slå “Vent på shell-prompten, før hver linje indsættes” til som standard, når shell-integration registreres?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll Erweitertes Einfügen standardmäßig automatisch „Vor dem Einfügen jeder Zeile auf Shell-Prompt warten“ aktivieren, wenn Shell-Integration erkannt wird?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should Advanced Paste automatically enable “Wait for shell prompt before pasting each line” by default when shell integration is detected?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Debe el pegado avanzado activar automáticamente “Esperar el prompt del shell antes de pegar cada línea” de forma predeterminada cuando se detecta la integración con el shell?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaanko edistyneessä sijoituksessa ”Odota komentokehotetta ennen jokaisen rivin sijoitusta” automaattisesti oletuksena käyttöön, kun komentotulkki-integraatio havaitaan?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage avancé doit-il activer automatiquement « Attendre l’invite du shell avant de coller chaque ligne » par défaut lorsque l’intégration du shell est détectée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’incolla avanzato deve abilitare automaticamente “Attendi il prompt della shell prima di incollare ogni riga” per impostazione predefinita quando viene rilevata l’integrazione shell?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合が検出された場合、高度な貼り付けはデフォルトで「各行を貼り付ける前にシェルプロンプトを待つ」を自動的に有効にしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 감지되면 고급 붙여넣기에서 기본적으로 “각 줄을 붙여넣기 전에 셸 프롬프트 기다리기”를 자동으로 켜겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal avansert innliming automatisk aktivere «Vent på ledetekst før hver linje limes inn» som standard når skallintegrering oppdages?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet Geavanceerd plakken standaard automatisch ‘Wacht op shell-prompt voordat elke regel wordt geplakt’ inschakelen wanneer shell-integratie wordt gedetecteerd?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy zaawansowane wklejanie ma domyślnie automatycznie włączać „Czekaj na znak zachęty powłoki przed wklejeniem każdego wiersza”, gdy wykryto integrację z powłoką?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Colagem avançada deve ativar automaticamente “Aguardar o prompt do shell antes de colar cada linha” por padrão quando a Shell Integration é detectada?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли функция «Расширенная вставка» по умолчанию автоматически включать параметр «Ждать приглашения оболочки перед вставкой каждой строки», если обнаружена интеграция с оболочкой?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má rozšírené vkladanie predvolene automaticky zapnúť možnosť „Pred vložením každého riadka počkať na výzvu shellu“, keď sa zistí integrácia shellu?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj napredno lepljenje privzeto samodejno omogoči »Pred lepljenjem vsake vrstice počakaj na ukazni poziv lupine«, ko je zaznana integracija lupine?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ska avancerad inklistring automatiskt aktivera ”Vänta på skalprompten innan varje rad klistras in” som förval när skalintegrering upptäcks?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk entegrasyonu algılandığında Gelişmiş Yapıştırma, “Her satırı yapıştırmadan önce kabuk istemini bekle” seçeneğini varsayılan olarak otomatik etkinleştirsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán nâng cao có nên tự động bật “Chờ dấu nhắc shell trước khi dán từng dòng” theo mặc định khi phát hiện tích hợp shell không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当检测到 shell 集成时，Advanced Paste 是否应默认自动启用“在粘贴每条行前等待 shell 提示符”功能？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到 Shell 整合時，進階貼上是否應預設自動啟用「貼上每一行前等待 Shell 提示符號」？"
          }
        }
      }
    },
    "AdvancedSetting.aggressiveBaseCharacterDetection" : {
      "comment" : "Advanced setting: aggressiveBaseCharacterDetection",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjišťovat základní znaky Unicode pomocí vyhledávací tabulky.\nAlgoritmus Applu pro segmentaci složených znaků dělá špatná rozhodnutí, například u tamilštiny. Zapnutím omezíte překrývání textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer Unicode-grundtegn med en opslagstabel.\nApples algoritme til opdeling af sammensatte tegn træffer dårlige valg, f.eks. for tamil. Slå dette til for at mindske overlappende tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basis-Unicode-Zeichen mit Nachschlagetabelle erkennen.\nApples Algorithmus zur Segmentierung zusammengesetzter Zeichen trifft schlechte Entscheidungen, etwa bei Tamil. Aktivieren Sie dies, um Textüberlappungen zu verringern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Detect base unicode characters with lookup table.\nApple's algorithm for segmenting composed characters makes bad choices, such as for Tamil. Enable this to reduce text overlapping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar caracteres Unicode base con una tabla de consulta.\nEl algoritmo de Apple para segmentar caracteres compuestos toma malas decisiones, por ejemplo con el tamil. Actívalo para reducir la superposición de texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Havaitse Unicode-perusmerkit hakutaulukon avulla.\nApplen yhdistettyjen merkkien jaotteluun käyttämä algoritmi tekee huonoja valintoja, esimerkiksi tamilin kohdalla. Ota tämä käyttöön vähentääksesi tekstin päällekkäisyyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecter les caractères Unicode de base avec une table de correspondance.\nL’algorithme d’Apple pour segmenter les caractères composés fait de mauvais choix, par exemple pour le tamoul. Activez cette option pour réduire le chevauchement du texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rileva i caratteri Unicode di base con una tabella di ricerca.\nL’algoritmo di Apple per segmentare i caratteri composti fa scelte sbagliate, ad esempio per il tamil. Abilitalo per ridurre la sovrapposizione del testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルックアップテーブルを使用してUnicodeの基底文字を検出する。\n合成文字を分割するAppleのアルゴリズムは、タミル語などで不適切な判断をすることがあります。これを有効にすると、テキストの重なりを軽減できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조회 테이블로 기본 유니코드 문자를 감지합니다.\n조합 문자를 분할하는 Apple의 알고리즘은 타밀어 등에서 잘못된 선택을 합니다. 텍스트 겹침을 줄이려면 이 옵션을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdag grunnleggende Unicode-tegn med en oppslagstabell.\nApples algoritme for segmentering av sammensatte tegn tar dårlige valg, for eksempel for tamil. Aktiver dette for å redusere overlappende tekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecteer basis-unicodetekens met een opzoektabel.\nHet algoritme van Apple voor het segmenteren van samengestelde tekens maakt slechte keuzes, bijvoorbeeld bij Tamil. Schakel dit in om overlappende tekst te verminderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywaj bazowe znaki Unicode za pomocą tabeli wyszukiwania.\nAlgorytm Apple do segmentacji znaków złożonych podejmuje złe decyzje, na przykład dla tamilskiego. Włącz, aby zmniejszyć nakładanie się tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar caracteres unicode base com tabela de consulta.\nO algoritmo da Apple para segmentar caracteres compostos faz escolhas ruins, como no tâmil. Ative isto para reduzir a sobreposição de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определять базовые символы Юникода с помощью таблицы соответствий.\nАлгоритм Apple для сегментации составных символов делает неудачный выбор, например для тамильского языка. Включите этот параметр, чтобы уменьшить наложение текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zisťovať základné znaky Unicode pomocou vyhľadávacej tabuľky.\nAlgoritmus Apple na segmentáciu zložených znakov robí zlé rozhodnutia, napríklad pri tamilčine. Zapnutím sa zníži prekrývanie textu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznaj osnovne znake Unicode s preglednico.\nAppleov algoritem za segmentiranje sestavljenih znakov se slabo odloča, na primer pri tamilščini. Omogočite za zmanjšanje prekrivanja besedila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiera Unicode-bastecken med en uppslagstabell.\nApples algoritm för att segmentera sammansatta tecken gör dåliga val, till exempel för tamil. Aktivera detta för att minska överlappande text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel Unicode karakterlerini arama tablosuyla algıla.\nApple’ın birleşik karakterleri bölümleme algoritması, örneğin Tamilce için kötü seçimler yapar. Metin çakışmasını azaltmak için bunu etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát hiện các ký tự Unicode cơ sở bằng bảng tra cứu.\nThuật toán của Apple để phân đoạn các ký tự ghép đưa ra lựa chọn kém, chẳng hạn với tiếng Tamil. Bật tùy chọn này để giảm hiện tượng văn bản chồng lên nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过查找表检测基础 Unicode 字符。\nApple 的复合字符分割算法存在错误，例如泰米尔语中的处理方式。启用此功能可减少文本重叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以查詢表偵測基本 Unicode 字元。\nApple 的組合字元分割演算法會做出錯誤的選擇，例如泰米爾文。啟用此項可減少文字重疊。"
          }
        }
      }
    },
    "AdvancedSetting.aggressiveFocusFollowsMouse" : {
      "comment" : "Advanced setting: aggressiveFocusFollowsMouse",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má se při zapnuté volbě „Fokus následuje myš“ aktivovat okno pod kurzorem, když se iTerm2 stane aktivním?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Fokus følger musen er slået til, skal vinduet under markøren så aktiveres, når iTerm2 bliver aktiv?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll bei aktiviertem „Fokus folgt der Maus“ das Fenster unter dem Zeiger aktiviert werden, wenn iTerm2 aktiv wird?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Focus Follows Mouse is enabled, activate the window under the cursor when iTerm2 becomes active?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando “El foco sigue al ratón” está activado, ¿activar la ventana que hay bajo el cursor cuando iTerm2 pasa a estar activo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivoidaanko kohdistimen alla oleva ikkuna, kun iTerm2 aktivoituu ja Kohdistus seuraa hiirtä on käytössä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Le focus suit la souris » est activé, activer la fenêtre sous le curseur quand iTerm2 devient actif ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Il focus segue il mouse” è abilitato, attivare la finestra sotto il cursore quando iTerm2 diventa attivo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウス追従フォーカスが有効な場合、iTerm2がアクティブになった際にカーソル下のウィンドウをアクティブにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포커스가 마우스를 따라가기가 켜져 있을 때 iTerm2가 활성화되면 커서 아래의 윈도우를 활성화하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når «Fokus følger musen» er aktivert, skal vinduet under markøren aktiveres når iTerm2 blir aktiv?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ‘Focus volgt muis’ is ingeschakeld: het venster onder de cursor activeren wanneer iTerm2 actief wordt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy „Fokus podąża za myszą” jest włączony, czy aktywować okno pod kursorem, gdy iTerm2 staje się aktywny?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Foco segue o mouse” está ativado, ativar a janela sob o cursor quando o iTerm2 se tornar ativo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активировать окно под курсором при активации iTerm2, если включён режим «Фокус следует за мышью»?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté „Fokus nasleduje myš“, aktivovať okno pod kurzorom, keď sa iTerm2 stane aktívnym?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je omogočeno »Fokus sledi miški«, ali naj se ob aktivaciji iTerm2 aktivira okno pod kazalcem?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ”Fokus följer musen” är aktiverat, aktivera fönstret under markören när iTerm2 blir aktivt?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Odak fareyi izlesin” etkinken, iTerm2 etkin olduğunda imlecin altındaki pencere etkinleştirilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật Tiêu điểm theo chuột, có kích hoạt cửa sổ dưới con trỏ khi iTerm2 trở thành ứng dụng hoạt động không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Focus Follows Mouse 被启用时，iTerm2 激活后是否应激活光标下的窗口？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「焦點跟隨滑鼠」時，iTerm2 變為使用中後，是否啟用游標下方的視窗？"
          }
        }
      }
    },
    "AdvancedSetting.aiChatRawWireLogging" : {
      "comment" : "Advanced setting: aiChatRawWireLogging",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisovat na disk nezpracované požadavky a odpovědi API AI.\nZapisuje každý bajt odeslaný poskytovateli AI i od něj přijatý (úplné hlavičky požadavku, tělo, části streamu, konečnou odpověď, chyby a časování) do ~/Library/Application Support/iTerm2/AIChatWire/. Jeden soubor protokolu na každé spuštění aplikace; po skončení jej sami rotujte nebo smažte. VAROVÁNÍ: protokol doslovně zachycuje hlavičky Authorization / API klíče a úplný obsah promptu i odpovědi. Ve výchozím stavu vypnuto; zapněte jen při reprodukci problému a po skončení soubory smažte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log rå AI API-anmodninger og -svar på disken.\nSkriver hver byte, der sendes til og modtages fra AI-leverandøren (komplette anmodningsheadere, indhold, streamede dele, endeligt svar, fejl og tidsforløb), til ~/Library/Application Support/iTerm2/AIChatWire/. Én logfil pr. start af appen; roter eller slet den selv, når du er færdig. ADVARSEL: Loggen indeholder Authorization-headere og API-nøgleheadere samt hele prompten og svaret ordret. Slået fra som standard; slå kun til, mens du genskaber et problem, og slet arkiverne bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rohe KI-API-Anfragen und -Antworten auf der Festplatte protokollieren.\nSchreibt jedes an den KI-Anbieter gesendete und von ihm empfangene Byte (vollständige Anfrage-Header, Body, Streaming-Chunks, endgültige Antwort, Fehler und Zeitangaben) nach ~/Library/Application Support/iTerm2/AIChatWire/. Eine Protokolldatei pro App-Start; rotieren oder löschen Sie sie selbst, wenn Sie fertig sind. WARNUNG: Das Protokoll erfasst Authorization-/API-Schlüssel-Header sowie den vollständigen Prompt- und Antwortinhalt im Klartext. Standardmäßig aus; nur zum Reproduzieren eines Problems aktivieren und die Dateien danach löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log raw AI API requests and responses to disk.\nWrites every byte sent to and received from the AI vendor (full request headers, body, streaming chunks, final response, errors, and timing) to ~/Library/Application Support/iTerm2/AIChatWire/. One log file per app launch; rotate or delete it yourself when done. WARNING: the log captures Authorization / API-key headers and full prompt + response content verbatim. Off by default; turn on only while reproducing an issue and delete the files when finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar en disco las solicitudes y respuestas sin procesar de la API de IA.\nEscribe cada byte enviado al proveedor de IA y recibido de él (encabezados completos de la solicitud, cuerpo, bloques de streaming, respuesta final, errores y tiempos) en ~/Library/Application Support/iTerm2/AIChatWire/. Un archivo de registro por inicio de la app; rótalo o elimínalo tú mismo cuando termines. AVISO: el registro captura los encabezados Authorization / de clave de API y el contenido completo del prompt y de la respuesta, literalmente. Desactivado de forma predeterminada; actívalo solo mientras reproduces un problema y elimina los archivos al terminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa raa’at AI API -pyynnöt ja -vastaukset levylle.\nKirjoittaa jokaisen AI-palveluntarjoajalle lähetetyn ja sieltä vastaanotetun tavun (pyyntöjen täydet otsakkeet, rungon, suoratoisto-osat, lopullisen vastauksen, virheet ja ajoitukset) hakemistoon ~/Library/Application Support/iTerm2/AIChatWire/. Yksi lokitiedosto per sovelluksen käynnistys; kierrätä tai poista se itse, kun olet valmis. VAROITUS: loki sisältää Authorization- ja API-avainotsakkeet sekä kehotteen ja vastauksen koko sisällön sellaisenaan. Oletuksena pois päältä; ota käyttöön vain ongelmaa toistaessasi ja poista tiedostot lopuksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journaliser sur le disque les requêtes et réponses brutes de l’API d’IA.\nÉcrit chaque octet envoyé au fournisseur d’IA et reçu de lui (en-têtes complets de la requête, corps, blocs de streaming, réponse finale, erreurs et durées) dans ~/Library/Application Support/iTerm2/AIChatWire/. Un fichier journal par lancement de l’app ; effectuez vous-même la rotation ou la suppression une fois terminé. AVERTISSEMENT : le journal capture les en-têtes Authorization / clé d’API et l’intégralité du contenu du prompt et de la réponse, tels quels. Désactivé par défaut ; activez-le uniquement pendant la reproduction d’un problème et supprimez les fichiers ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra su disco le richieste e le risposte grezze dell’API IA.\nScrive ogni byte inviato e ricevuto dal fornitore IA (intestazioni complete della richiesta, corpo, blocchi di streaming, risposta finale, errori e tempistiche) in ~/Library/Application Support/iTerm2/AIChatWire/. Un file di log per ogni avvio dell’app; ruotalo o eliminalo tu stesso al termine. ATTENZIONE: il log cattura le intestazioni Authorization / chiave API e il contenuto completo di prompt e risposta, alla lettera. Disattivato per impostazione predefinita; attivalo solo mentre riproduci un problema ed elimina i file al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生のAI APIリクエストとレスポンスをディスクに記録する。\nAIベンダーとの間で送受信されるすべてのバイト（完全なリクエストヘッダー、ボディ、ストリーミングチャンク、最終レスポンス、エラー、タイミング）を~/Library/Application Support/iTerm2/AIChatWire/に書き込みます。アプリの起動ごとに1つのログファイルが作成されます。ログのローテーションや削除は自分で行ってください。警告: このログには、Authorization / APIキーのヘッダーおよびプロンプトとレスポンスの内容全体がそのまま記録されます。デフォルトでは無効です。問題を再現する際にのみ有効にし、終わったらファイルを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI API 원시 요청 및 응답을 디스크에 기록\nAI 제공업체와 주고받는 모든 바이트(전체 요청 헤더, 본문, 스트리밍 청크, 최종 응답, 오류 및 타이밍)를 ~/Library/Application Support/iTerm2/AIChatWire/에 기록합니다. 앱을 실행할 때마다 로그 파일이 하나씩 생성되며, 다 쓴 후에는 직접 정리하거나 삭제해야 합니다. 경고: 로그에는 Authorization / API 키 헤더와 프롬프트 및 응답 전체 내용이 그대로 기록됩니다. 기본적으로 꺼져 있습니다. 문제를 재현하는 동안에만 켜고 끝나면 파일을 삭제하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg rå KI-API-forespørsler og -svar til disk.\nSkriver hver byte som sendes til og mottas fra KI-leverandøren (fullstendige forespørselshoder, innhold, strømmede deler, endelig svar, feil og tidsmåling) til ~/Library/Application Support/iTerm2/AIChatWire/. Én loggfil per appstart; roter eller slett den selv når du er ferdig. ADVARSEL: Loggen fanger opp Authorization-/API-nøkkelhoder og hele prompt- og svarinnholdet ordrett. Av som standard; slå på bare mens du gjengir et problem, og slett filene når du er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log onbewerkte AI-API-verzoeken en -antwoorden naar schijf.\nSchrijft elke byte die naar de AI-aanbieder wordt verstuurd en ervan wordt ontvangen (volledige verzoekheaders, body, streamfragmenten, eindantwoord, fouten en timing) naar ~/Library/Application Support/iTerm2/AIChatWire/. Eén logbestand per start van de app; roteer of verwijder het zelf als je klaar bent. WAARSCHUWING: het log bevat Authorization-/API-sleutelheaders en de volledige prompt- en antwoordinhoud letterlijk. Standaard uitgeschakeld; schakel dit alleen in terwijl je een probleem reproduceert en verwijder de bestanden daarna."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj na dysku surowe żądania i odpowiedzi API AI.\nZapisuje każdy bajt wysłany do dostawcy AI i odebrany od niego (pełne nagłówki żądań, treść, fragmenty strumienia, ostateczną odpowiedź, błędy i czasy) w ~/Library/Application Support/iTerm2/AIChatWire/. Jeden plik dziennika na uruchomienie aplikacji; po zakończeniu sam go rotuj lub usuń. OSTRZEŻENIE: dziennik zawiera dosłownie nagłówki Authorization / klucza API oraz pełną treść promptu i odpowiedzi. Domyślnie wyłączone; włączaj tylko na czas odtwarzania problemu i usuń pliki po zakończeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar em disco as requisições e respostas brutas da API de IA.\nGrava cada byte enviado e recebido do fornecedor de IA (cabeçalhos completos da requisição, corpo, blocos de streaming, resposta final, erros e tempos) em ~/Library/Application Support/iTerm2/AIChatWire/. Um arquivo de log por inicialização do app; alterne ou apague-o você mesmo quando terminar. AVISO: o log captura cabeçalhos de Authorization / chave de API e o conteúdo completo do prompt e da resposta na íntegra. Desativado por padrão; ative apenas ao reproduzir um problema e apague os arquivos ao terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывать на диск необработанные запросы и ответы AI API.\nЗаписывает каждый байт, отправленный поставщику ИИ и полученный от него (полные заголовки запроса, тело, потоковые фрагменты, окончательный ответ, ошибки и тайминг), в ~/Library/Application Support/iTerm2/AIChatWire/. Один файл журнала на каждый запуск приложения; удаляйте или ротируйте его самостоятельно после использования. ПРЕДУПРЕЖДЕНИЕ: журнал записывает заголовки Authorization и API-ключа, а также полный текст запроса и ответа дословно. По умолчанию отключено; включайте только для воспроизведения проблемы и удаляйте файлы после завершения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenávať nespracované požiadavky a odpovede API AI na disk.\nZapisuje každý bajt odoslaný poskytovateľovi AI a prijatý od neho (úplné hlavičky požiadaviek, telo, časti streamu, konečnú odpoveď, chyby a časovanie) do ~/Library/Application Support/iTerm2/AIChatWire/. Jeden súbor záznamu na každé spustenie apky; po skončení ho rotujte alebo odstráňte sami. UPOZORNENIE: záznam doslovne zachytáva hlavičky Authorization / API kľúča a úplný obsah promptu aj odpovede. Predvolene vypnuté; zapnite iba počas reprodukcie problému a po skončení súbory odstráňte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapiši surove zahteve in odgovore API AI na disk.\nV ~/Library/Application Support/iTerm2/AIChatWire/ zapiše vsak bajt, poslan ponudniku AI in prejet od njega (celotne glave zahtev, telo, kose pretakanja, končni odgovor, napake in čase). Ena datoteka dnevnika na zagon aplikacije; ko končate, jo sami zavrtite ali izbrišite. OPOZORILO: dnevnik dobesedno zajame glave Authorization / ključa API ter celotno vsebino poziva in odgovora. Privzeto izklopljeno; vklopite samo med poustvarjanjem težave in datoteke po koncu izbrišite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga råa begäranden och svar för AI-API:et till disk.\nSkriver varje byte som skickas till och tas emot från AI-leverantören (fullständiga begärans-rubriker, brödtext, strömningsdelar, slutligt svar, fel och tidsåtgång) till ~/Library/Application Support/iTerm2/AIChatWire/. En loggfil per appstart; rotera eller radera den själv när du är klar. VARNING: loggen innehåller Authorization-/API-nyckelrubriker och fullständigt promptinnehåll och svarsinnehåll ordagrant. Av som förval; aktivera bara medan du återskapar ett problem och radera filerna när du är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ham YZ API isteklerini ve yanıtlarını diske günlükle.\nYZ sağlayıcısına gönderilen ve ondan alınan her baytı (tam istek üst bilgileri, gövde, akış parçaları, nihai yanıt, hatalar ve zamanlama) ~/Library/Application Support/iTerm2/AIChatWire/ konumuna yazar. Her uygulama başlatmasında bir günlük dosyası oluşur; işiniz bitince kendiniz döndürün veya silin. UYARI: Günlük, Authorization / API anahtarı üst bilgilerini ve istemin ile yanıtın tüm içeriğini olduğu gibi yakalar. Varsayılan olarak kapalıdır; yalnızca bir sorunu yeniden üretirken açın ve işiniz bitince dosyaları silin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi nhật ký thô các yêu cầu và phản hồi API AI vào đĩa.\nGhi mọi byte được gửi đến và nhận từ nhà cung cấp AI (đầy đủ tiêu đề yêu cầu, nội dung, các đoạn truyền phát, phản hồi cuối cùng, lỗi và thời gian) vào ~/Library/Application Support/iTerm2/AIChatWire/. Mỗi lần khởi chạy ứng dụng có một tệp nhật ký; hãy tự xoay vòng hoặc xóa khi xong. CẢNH BÁO: nhật ký ghi lại các tiêu đề Authorization / khóa API và toàn bộ nội dung lời nhắc cùng phản hồi nguyên văn. Mặc định tắt; chỉ bật khi đang tái hiện sự cố và hãy xóa các tệp khi xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应将原始 AI API 请求和响应记录到磁盘中？\n将发送给 AI 供应商的每一字节数据（完整的请求头、内容、流分块、最终响应、错误和计时信息）写入 ~/Library/Application Support/iTerm2/AIChatWire/。每个应用启动对应一个日志文件；使用完毕后可自行轮换或删除。注意：该日志会完整记录授权/API 密钥头以及完整的提示语和响应内容。默认关闭；仅在重现问题时开启，完成后删除文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將原始 AI API 請求和回應記錄到磁碟。\n將傳送給 AI 供應商及從其接收的每個位元組（完整的請求標頭、內文、串流區塊、最終回應、錯誤和時間資訊）寫入 ~/Library/Application Support/iTerm2/AIChatWire/。每次 App 啟動產生一個記錄檔；用完後請自行輪替或刪除。警告：記錄會逐字擷取 Authorization / API 金鑰標頭，以及完整的提示詞和回應內容。預設關閉；僅在重現問題時開啟，完成後請刪除這些檔案。"
          }
        }
      }
    },
    "AdvancedSetting.aiChatVerboseConsoleLogging" : {
      "comment" : "Advanced setting: aiChatVerboseConsoleLogging",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisovat provoz chatu AI do systémové konzole.\nPomocí NSLog vypisuje záznamy uživatele / agenta / nástroje za každé kolo, abyste mohli přesně sledovat, co agent přijal a vytvořil. Užitečné pro ladění odesílání nástrojů a překladu historie. Ve výchozím stavu vypnuto; zapněte jen při reprodukci problému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log AI-chattrafik i systemkonsollen.\nUdsender poster pr. tur for bruger / agent / værktøj via NSLog, så du kan spore præcis, hvad agenten modtog og producerede. Nyttigt til fejlfinding af værktøjsafsendelse og historikoversættelse. Slået fra som standard; slå kun til, mens du genskaber et problem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Chat-Datenverkehr in die Systemkonsole protokollieren.\nGibt pro Runde Einträge für Benutzer/Agent/Werkzeug über NSLog aus, damit Sie genau nachvollziehen können, was der Agent erhalten und erzeugt hat. Nützlich zum Debuggen der Werkzeugverteilung und der Verlaufsübersetzung. Standardmäßig aus; nur zum Reproduzieren eines Problems aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Log AI chat traffic to the system console.\nEmits per-turn user / agent / tool entries via NSLog so you can trace exactly what the agent received and produced. Useful for debugging tool dispatch and history translation. Off by default; turn on only while reproducing an issue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar el tráfico del chat de IA en la consola del sistema.\nEmite entradas de usuario / agente / herramienta por turno mediante NSLog para que puedas rastrear exactamente lo que el agente recibió y produjo. Útil para depurar el despacho de herramientas y la traducción del historial. Desactivado de forma predeterminada; actívalo solo mientras reproduces un problema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa AI-keskusteluliikenne järjestelmäkonsoliin.\nLähettää NSLogin kautta käyttäjän, agentin ja työkalun vuorokohtaiset merkinnät, jotta voit jäljittää tarkasti, mitä agentti vastaanotti ja tuotti. Hyödyllinen työkalujen jakelun ja historian käännöksen vianmäärityksessä. Oletuksena pois päältä; ota käyttöön vain ongelmaa toistaessasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journaliser le trafic du chat IA dans la console système.\nÉmet via NSLog des entrées par tour pour l’utilisateur, l’agent et les outils, afin de retracer exactement ce que l’agent a reçu et produit. Utile pour déboguer la répartition des outils et la traduction de l’historique. Désactivé par défaut ; activez-le uniquement pendant la reproduction d’un problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra il traffico della chat IA nella console di sistema.\nEmette voci utente / agente / strumento per ogni turno tramite NSLog, così puoi tracciare esattamente ciò che l’agente ha ricevuto e prodotto. Utile per il debug dell’invio degli strumenti e della traduzione della cronologia. Disattivato per impostazione predefinita; attivalo solo mentre riproduci un problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIチャットの通信をシステムコンソールに記録する。\nNSLogを使って、ユーザー / エージェント / ツールのやり取りをターンごとに出力し、エージェントが受け取った内容と生成した内容を正確に追跡できるようにします。ツールのディスパッチや履歴変換のデバッグに役立ちます。デフォルトでは無効です。問題を再現する際にのみ有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 채팅 트래픽을 시스템 콘솔에 기록.\n턴마다 사용자/에이전트/도구 항목을 NSLog로 출력하므로 에이전트가 받고 생성한 내용을 정확히 추적할 수 있습니다. 도구 디스패치 및 기록 변환을 디버깅할 때 유용합니다. 기본적으로 꺼져 있으며, 문제를 재현하는 동안에만 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg KI-chattrafikk til systemkonsollen.\nSender oppføringer for bruker/agent/verktøy per tur via NSLog, slik at du kan spore nøyaktig hva agenten mottok og produserte. Nyttig for feilsøking av verktøyutsendelse og historikkoversettelse. Av som standard; slå på bare mens du gjengir et problem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log AI-chatverkeer naar de systeemconsole.\nGeeft per beurt vermeldingen van gebruiker, agent en tool uit via NSLog, zodat je precies kunt volgen wat de agent heeft ontvangen en geproduceerd. Handig voor het debuggen van toolverwerking en geschiedenisvertaling. Standaard uitgeschakeld; schakel dit alleen in terwijl je een probleem reproduceert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj ruch czatu AI w konsoli systemowej.\nWysyła wpisy użytkownika / agenta / narzędzia dla każdej tury przez NSLog, aby można było prześledzić, co dokładnie agent otrzymał i wygenerował. Przydatne do debugowania wywoływania narzędzi i tłumaczenia historii. Domyślnie wyłączone; włączaj tylko na czas odtwarzania problemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar o tráfego do chat de IA no console do sistema.\nEmite entradas por turno de usuário / agente / ferramenta via NSLog para que você possa rastrear exatamente o que o agente recebeu e produziu. Útil para depurar o despacho de ferramentas e a tradução do histórico. Desativado por padrão; ative apenas ao reproduzir um problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывать трафик чата ИИ в системную консоль.\nВыводит записи пользователя, агента и инструментов для каждого хода с помощью NSLog, чтобы можно было точно отследить, что получил и произвёл агент. Полезно для отладки диспетчеризации инструментов и преобразования истории. По умолчанию отключено; включайте только для воспроизведения проблемы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenávať prevádzku chatu AI do systémovej konzoly.\nVypisuje záznamy užívateľa / agenta / nástroja po jednotlivých kolách cez NSLog, aby ste mohli presne sledovať, čo agent dostal a vytvoril. Užitočné na ladenie odosielania nástrojov a prekladu histórie. Predvolene vypnuté; zapnite iba počas reprodukcie problému."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapiši promet klepeta z AI v sistemsko konzolo.\nOddaja vnose uporabnika / agenta / orodja za vsak krog prek NSLog, da lahko natančno spremljate, kaj je agent prejel in ustvaril. Uporabno za odpravljanje napak pri razpošiljanju orodij in prevajanju zgodovine. Privzeto izklopljeno; vklopite samo med poustvarjanjem težave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga AI-chatttrafik till systemkonsolen.\nSkickar poster per tur för användare / agent / verktyg via NSLog så att du kan spåra exakt vad agenten tog emot och producerade. Användbart för felsökning av verktygsdistribution och historiköversättning. Av som förval; aktivera bara medan du återskapar ett problem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ sohbet trafiğini sistem konsoluna günlükle.\nAjanın tam olarak ne aldığını ve ne ürettiğini izleyebilmeniz için her tur için kullanıcı / ajan / araç girdilerini NSLog ile yayar. Araç dağıtımında ve geçmiş çevirisinde hata ayıklamak için yararlıdır. Varsayılan olarak kapalıdır; yalnızca bir sorunu yeniden üretirken açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi nhật ký lưu lượng trò chuyện AI vào bảng điều khiển hệ thống.\nGhi các mục người dùng / tác tử / công cụ theo từng lượt qua NSLog để bạn có thể theo dõi chính xác những gì tác tử đã nhận và tạo ra. Hữu ích để gỡ lỗi việc điều phối công cụ và chuyển đổi lịch sử. Mặc định tắt; chỉ bật khi đang tái hiện sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应将 AI 聊天流量记录到系统控制台？\n通过 NSLog 输出每轮用户/代理/工具的条目，以便准确追踪代理接收和生成的内容。有助于调试工具调度和历史翻译问题。默认关闭；仅在重现问题时开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 AI 聊天流量記錄到系統主控台。\n透過 NSLog 輸出每個回合的使用者 / 代理程式 / 工具項目，以便準確追蹤代理程式收到和產生的內容。適用於除錯工具調度和歷史記錄轉換。預設關閉；僅在重現問題時開啟。"
          }
        }
      }
    },
    "AdvancedSetting.aiGeneratedTabTitles" : {
      "comment" : "Advanced setting: aiGeneratedTabTitles",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojmenovávat panely podle práce na obrazovce pomocí AI v zařízení?\nPokud je zapnuto, proměnná relace „aiTitle“ obsahuje krátký název úlohy viditelné v relaci, který můžete zobrazit přidáním součásti názvu „Název generovaný AI“ nebo použitím \\(session.aiTitle) ve vlastním formátu názvu. Vyžaduje Apple Intelligence; obsah obrazovky tento Mac nikdy neopustí a nepoužívá se žádný API klíč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navngiv faner efter det arbejde, der vises på skærmen, med AI på enheden?\nNår det er slået til, indeholder sessionsvariablen “aiTitle” et kort navn på den opgave, der er synlig i sessionen, og du kan vise den ved at tilføje titelkomponenten “AI-genereret navn” eller bruge \\(session.aiTitle) i et brugerdefineret titelformat. Kræver Apple Intelligence; skærmens indhold forlader aldrig denne Mac, og der bruges ingen API-nøgle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs nach der auf dem Bildschirm sichtbaren Arbeit benennen, mithilfe von KI auf dem Gerät?\nWenn aktiviert, enthält die Sitzungsvariable „aiTitle“ einen kurzen Namen für die in der Sitzung sichtbare Aufgabe, den Sie anzeigen können, indem Sie die Titelkomponente „KI-generierter Name“ hinzufügen oder \\(session.aiTitle) in einem benutzerdefinierten Titelformat verwenden. Erfordert Apple Intelligence; die Bildschirminhalte verlassen diesen Mac nie, und es wird kein API-Schlüssel verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Name tabs after the work on screen, using on-device AI?\nWhen enabled, the session variable “aiTitle” holds a short name for the task visible in the session, which you can show by adding the “AI-generated name” title component or using \\(session.aiTitle) in a custom title format. Requires Apple Intelligence; the screen contents never leave this Mac, and no API key is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Nombrar las pestañas según el trabajo que se ve en pantalla, usando IA en el dispositivo?\nSi se activa, la variable de sesión “aiTitle” contiene un nombre corto para la tarea visible en la sesión, que puedes mostrar añadiendo el componente de título “Nombre generado por IA” o usando \\(session.aiTitle) en un formato de título personalizado. Requiere Apple Intelligence; el contenido de la pantalla nunca sale de este Mac y no se usa ninguna clave de API."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimetäänkö välilehdet näytöllä näkyvän työn mukaan laitteella toimivan tekoälyn avulla?\nKun tämä on käytössä, istuntomuuttuja ”aiTitle” sisältää istunnossa näkyvän tehtävän lyhyen nimen, jonka voit näyttää lisäämällä otsikon osan ”AI-luotu nimi” tai käyttämällä lauseketta \\(session.aiTitle) mukautetussa otsikkomuodossa. Vaatii Apple Intelligencen; näytön sisältö ei koskaan poistu tästä Macista, eikä API-avainta käytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommer les onglets d’après le travail affiché à l’écran, avec l’IA sur l’appareil ?\nSi cette option est activée, la variable de session « aiTitle » contient un nom court pour la tâche visible dans la session, que vous pouvez afficher en ajoutant le composant de titre « Nom généré par l’IA » ou en utilisant \\(session.aiTitle) dans un format de titre personnalisé. Nécessite Apple Intelligence ; le contenu de l’écran ne quitte jamais ce Mac et aucune clé d’API n’est utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dare ai pannelli un nome basato sul lavoro a schermo, usando l’IA sul dispositivo?\nSe abilitato, la variabile di sessione “aiTitle” contiene un nome breve per l’attività visibile nella sessione, che puoi mostrare aggiungendo il componente del titolo “Nome generato dall’IA” oppure usando \\(session.aiTitle) in un formato del titolo personalizzato. Richiede Apple Intelligence; il contenuto dello schermo non lascia mai questo Mac e non viene usata alcuna chiave API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンデバイスAIを使って、画面上の作業内容に基づいてタブに名前を付けますか？\n有効にすると、セッション変数「aiTitle」にセッション内で表示されている作業内容の短い名前が保持され、「AI生成名」というタイトルコンポーネントを追加するか、カスタムタイトル形式で\\(session.aiTitle)を使うことで表示できます。Apple Intelligenceが必要です。画面の内容はこのMacの外に送信されることはなく、APIキーも使用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 내 AI를 사용하여 화면의 작업에 맞게 탭 이름을 지정하겠습니까?\n활성화하면 세션 변수 “aiTitle”에 세션에 보이는 작업의 짧은 이름이 저장되며, “AI 생성 이름” 제목 구성 요소를 추가하거나 사용자 지정 제목 형식에 \\(session.aiTitle)을 사용하여 표시할 수 있습니다. Apple Intelligence가 필요합니다. 화면 내용은 이 Mac 밖으로 나가지 않으며 API 키도 사용하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi faner navn etter arbeidet på skjermen ved hjelp av KI på enheten?\nNår dette er aktivert, inneholder øktvariabelen «aiTitle» et kort navn på oppgaven som er synlig i økten. Du kan vise det ved å legge til tittelkomponenten «KI-generert navn» eller bruke \\(session.aiTitle) i et egendefinert tittelformat. Krever Apple Intelligence. Skjerminnholdet forlater aldri denne Macen, og ingen API-nøkkel brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbladen een naam geven op basis van het werk op het scherm, met AI op het apparaat?\nAls dit is ingeschakeld, bevat de sessievariabele ‘aiTitle’ een korte naam voor de zichtbare taak in de sessie. Je kunt die tonen door het titelonderdeel ‘Door AI gegenereerde naam’ toe te voegen of \\(session.aiTitle) te gebruiken in een aangepast titelformaat. Vereist Apple Intelligence; de scherminhoud verlaat deze Mac nooit en er wordt geen API-sleutel gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazywać karty według pracy widocznej na ekranie, używając AI na urządzeniu?\nPo włączeniu zmienna sesji „aiTitle” zawiera krótką nazwę zadania widocznego w sesji, którą możesz wyświetlić, dodając składnik tytułu „Nazwa wygenerowana przez AI” lub używając \\(session.aiTitle) we własnym formacie tytułu. Wymaga Apple Intelligence; zawartość ekranu nigdy nie opuszcza tego Maca i nie jest używany żaden klucz API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomear as abas de acordo com o trabalho na tela, usando IA no dispositivo?\nQuando ativado, a variável de sessão “aiTitle” contém um nome curto para a tarefa visível na sessão, que você pode exibir adicionando o componente de título “Nome gerado por IA” ou usando \\(session.aiTitle) em um formato de título personalizado. Requer o Apple Intelligence; o conteúdo da tela nunca sai deste Mac e nenhuma chave de API é usada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Называть вкладки по содержимому экрана с помощью ИИ на устройстве?\nПри включении переменная сессии «aiTitle» содержит краткое название задачи, видимой в сессии; его можно отобразить, добавив компонент заголовка «Имя, сгенерированное ИИ», или используя \\(session.aiTitle) в пользовательском формате заголовка. Требует Apple Intelligence; содержимое экрана никогда не покидает этот Mac, и API-ключ не используется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomenúvať taby podľa práce na obrazovke pomocou AI v zariadení?\nAk je zapnuté, premenná relácie „aiTitle“ obsahuje krátky názov úlohy viditeľnej v relácii. Môžete ho zobraziť pridaním komponentu názvu „Názov vygenerovaný AI“ alebo použitím \\(session.aiTitle) vo vlastnom formáte názvu. Vyžaduje Apple Intelligence; obsah obrazovky tento Mac nikdy neopustí a nepoužíva sa žiadny API kľúč."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poimenuj zavihke po delu na zaslonu z AI v napravi?\nČe je omogočeno, spremenljivka seje »aiTitle« vsebuje kratko ime naloge, vidne v seji, ki ga lahko prikažete z dodajanjem komponente naslova »Ime, ustvarjeno z AI« ali z uporabo \\(session.aiTitle) v obliki naslova po meri. Zahteva Apple Intelligence; vsebina zaslona nikoli ne zapusti tega računalnika Mac in ključ API ni uporabljen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namnge flikar efter arbetet på skärmen med AI på enheten?\nOm detta är aktiverat innehåller sessionsvariabeln ”aiTitle” ett kort namn för uppgiften som syns i sessionen. Du kan visa det genom att lägga till titelkomponenten ”AI-genererat namn” eller använda \\(session.aiTitle) i ett anpassat titelformat. Kräver Apple Intelligence; skärminnehållet lämnar aldrig den här Macen och ingen API-nyckel används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekmelere, cihazdaki YZ kullanılarak ekrandaki işe göre ad verilsin mi?\nEtkinleştirildiğinde “aiTitle” oturum değişkeni, oturumda görünen görev için kısa bir ad tutar; bunu “YZ tarafından oluşturulan ad” başlık bileşenini ekleyerek veya özel başlık biçiminde \\(session.aiTitle) kullanarak gösterebilirsiniz. Apple Intelligence gerektirir; ekran içeriği bu Mac’ten asla çıkmaz ve hiçbir API anahtarı kullanılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt tên tab theo công việc trên màn hình, dùng AI trên thiết bị?\nKhi bật, biến phiên “aiTitle” chứa một tên ngắn cho tác vụ hiển thị trong phiên, bạn có thể hiển thị bằng cách thêm thành phần tiêu đề “Tên do AI tạo” hoặc dùng \\(session.aiTitle) trong định dạng tiêu đề tùy chỉnh. Yêu cầu Apple Intelligence; nội dung màn hình không bao giờ rời khỏi Mac này và không dùng khóa API."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应使用设备上的 AI 为标签页命名？\n如果启用，会话变量“aiTitle”将保存任务简短名称，可在自定义标题格式中通过添加“AI生成的名称”标题组件或使用 \\(session.aiTitle) 来显示。需要 Apple Intelligence；屏幕内容不会离开此 Mac，且不使用 API 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用裝置上的 AI 依螢幕上的工作為標籤頁命名？\n啟用後，工作階段變數「aiTitle」會保存工作階段中可見工作的簡短名稱，你可以加入「AI 產生的名稱」標題元件，或在自訂標題格式中使用 \\(session.aiTitle) 來顯示。需要 Apple Intelligence；螢幕內容不會離開這部 Mac，也不使用 API 金鑰。"
          }
        }
      }
    },
    "AdvancedSetting.aiModelCatalogURL" : {
      "comment" : "Advanced setting: aiModelCatalogURL",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL pro kontrolu aktualizací katalogu modelů AI.\nKatalog definuje vestavěné modely AI (kontextové okno, schopnosti a doporučený model pro každého poskytovatele). iTerm2 pravidelně stahuje podepsanou novější kopii, aby nové modely byly dostupné bez aktualizace aplikace. K tomu dochází pouze tehdy, když jsou zapnuty funkce AI a udělili jste oprávnění; neprázdná URL sama kontrolu nezapíná. Vymazání této URL kontrolu úplně vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL til søgning efter opdateringer til AI-modelkataloget.\nKataloget definerer de indbyggede AI-modeller (kontekstvindue, funktioner og den anbefalede model pr. leverandør). iTerm2 henter med jævne mellemrum en signeret nyere kopi, så nye modeller bliver tilgængelige uden en appopdatering. Det sker kun, når AI-funktioner er slået til, og du har givet tilladelse; en URL, der ikke er tom, slår ikke i sig selv søgning til. Hvis du rydder denne URL, slås søgning helt fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL zum Prüfen auf Aktualisierungen des KI-Modellkatalogs.\nDer Katalog definiert die integrierten KI-Modelle (Kontextfenster, Fähigkeiten und das empfohlene Modell pro Anbieter). iTerm2 lädt regelmäßig eine signierte neuere Kopie herunter, damit neue Modelle ohne App-Update verfügbar werden. Dies geschieht nur, wenn KI-Funktionen aktiviert sind und Sie die Erlaubnis erteilt haben; eine nicht leere URL allein aktiviert die Prüfung nicht. Wird diese URL geleert, wird die Prüfung vollständig deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL to check for updates to the AI model catalog.\nThe catalog defines the built-in AI models (context window, capabilities, and the recommended model per vendor). iTerm2 periodically downloads a signed newer copy so new models become available without an app update. This happens only when AI features are enabled and you have granted permission; a non-empty URL by itself does not enable checking. Clearing this URL disables checking entirely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL en la que buscar actualizaciones del catálogo de modelos de IA.\nEl catálogo define los modelos de IA integrados (ventana de contexto, capacidades y el modelo recomendado de cada proveedor). iTerm2 descarga periódicamente una copia firmada más reciente para que los nuevos modelos estén disponibles sin actualizar la app. Esto solo ocurre cuando las funciones de IA están activadas y has concedido permiso; una URL no vacía por sí sola no activa la comprobación. Borrar esta URL desactiva la comprobación por completo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, josta tarkistetaan AI-mallikatalogin päivitykset.\nKatalogi määrittää sisäänrakennetut AI-mallit (kontekstiikkuna, ominaisuudet ja palveluntarjoajakohtainen suositeltu malli). iTerm2 lataa ajoittain uudemman allekirjoitetun kopion, jotta uudet mallit tulevat saataville ilman sovelluspäivitystä. Tämä tapahtuu vain, kun AI-toiminnot ovat käytössä ja olet antanut luvan; pelkkä ei-tyhjä URL ei ota tarkistusta käyttöön. URL:n tyhjentäminen poistaa tarkistuksen kokonaan käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL à interroger pour les mises à jour du catalogue de modèles d’IA.\nLe catalogue définit les modèles d’IA intégrés (fenêtre de contexte, capacités et modèle recommandé par fournisseur). iTerm2 télécharge périodiquement une copie signée plus récente afin que de nouveaux modèles soient disponibles sans mise à jour de l’app. Cela n’a lieu que lorsque les fonctionnalités d’IA sont activées et que vous avez accordé l’autorisation ; une URL non vide ne suffit pas à activer la vérification. Effacer cette URL désactive complètement la vérification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL da cui cercare aggiornamenti del catalogo dei modelli IA.\nIl catalogo definisce i modelli IA integrati (finestra di contesto, funzionalità e modello consigliato per ogni fornitore). iTerm2 scarica periodicamente una copia firmata più recente così i nuovi modelli diventano disponibili senza aggiornare l’app. Questo avviene solo quando le funzioni IA sono abilitate e hai concesso l’autorizzazione; un URL non vuoto da solo non abilita il controllo. Cancellare questo URL disabilita completamente il controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIモデルカタログの更新を確認するためのURL。\nこのカタログは組み込みのAIモデル（コンテキストウィンドウ、機能、ベンダーごとの推奨モデル）を定義します。iTerm2は署名済みの新しいコピーを定期的にダウンロードするため、アプリを更新しなくても新しいモデルを利用できるようになります。これはAI機能が有効で、かつあなたが許可を与えている場合にのみ行われます。URLを空でない値にしただけでは確認は有効になりません。このURLを空にすると、確認は完全に無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 모델 카탈로그 업데이트를 확인할 URL.\n카탈로그는 내장 AI 모델(컨텍스트 윈도우, 기능, 공급업체별 권장 모델)을 정의합니다. iTerm2는 주기적으로 서명된 최신 사본을 다운로드하므로 앱을 업데이트하지 않아도 새 모델을 사용할 수 있습니다. 이 작업은 AI 기능이 켜져 있고 사용자가 권한을 부여한 경우에만 수행되며, URL이 비어 있지 않다는 것만으로는 확인이 켜지지 않습니다. 이 URL을 지우면 확인이 완전히 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL for å se etter oppdateringer av KI-modellkatalogen.\nKatalogen definerer de innebygde KI-modellene (kontekstvindu, funksjoner og anbefalt modell per leverandør). iTerm2 laster med jevne mellomrom ned en nyere signert kopi, slik at nye modeller blir tilgjengelige uten en appoppdatering. Dette skjer bare når KI-funksjoner er aktivert og du har gitt tillatelse. En URL som ikke er tom, aktiverer ikke kontrollen alene. Hvis du fjerner denne URL-en, deaktiveres kontrollen helt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL om te controleren op updates van de catalogus met AI-modellen.\nDe catalogus definieert de ingebouwde AI-modellen (contextvenster, mogelijkheden en het aanbevolen model per aanbieder). iTerm2 downloadt regelmatig een nieuwere ondertekende kopie, zodat nieuwe modellen beschikbaar komen zonder app-update. Dit gebeurt alleen als AI-functies zijn ingeschakeld en je toestemming hebt gegeven; een URL die niet leeg is, schakelt het controleren niet vanzelf in. Als je deze URL wist, wordt het controleren helemaal uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL, pod którym sprawdzane są uaktualnienia katalogu modeli AI.\nKatalog definiuje wbudowane modele AI (okno kontekstu, możliwości i zalecany model dla każdego dostawcy). iTerm2 okresowo pobiera nowszą podpisaną kopię, dzięki czemu nowe modele stają się dostępne bez uaktualniania aplikacji. Dzieje się tak tylko wtedy, gdy funkcje AI są włączone i udzielono zgody; niepusty URL sam w sobie nie włącza sprawdzania. Wyczyszczenie tego URL całkowicie wyłącza sprawdzanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL para verificar atualizações do catálogo de modelos de IA.\nO catálogo define os modelos de IA integrados (janela de contexto, recursos e o modelo recomendado por fornecedor). O iTerm2 baixa periodicamente uma cópia mais recente assinada para que novos modelos fiquem disponíveis sem uma atualização do app. Isso acontece apenas quando os recursos de IA estão ativados e você concedeu permissão; uma URL não vazia por si só não ativa a verificação. Limpar esta URL desativa a verificação por completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL для проверки обновлений каталога моделей ИИ.\nКаталог определяет встроенные модели ИИ (размер контекстного окна, возможности и рекомендуемую модель для каждого поставщика). iTerm2 периодически загружает более новую подписанную копию, чтобы новые модели становились доступны без обновления приложения. Это происходит только при включённых функциях ИИ и наличии вашего разрешения; сам по себе непустой URL не включает проверку. Очистка этого URL полностью отключает проверку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL na kontrolu aktualizácií katalógu modelov AI.\nKatalóg definuje vstavané modely AI (kontextové okno, schopnosti a odporúčaný model pre každého poskytovateľa). iTerm2 pravidelne sťahuje podpísanú novšiu kópiu, aby nové modely boli dostupné bez aktualizácie apky. Deje sa to iba vtedy, keď sú funkcie AI zapnuté a udelili ste povolenie; samotná neprázdna URL kontrolu nezapína. Vymazaním tejto URL sa kontrola úplne vypne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL za preverjanje posodobitev kataloga modelov AI.\nKatalog določa vgrajene modele AI (kontekstno okno, zmožnosti in priporočeni model za posameznega ponudnika). iTerm2 občasno prenese podpisano novejšo kopijo, da so novi modeli na voljo brez posodobitve aplikacije. To se zgodi samo, ko so funkcije AI omogočene in ste dali dovoljenje; neprazen URL sam po sebi ne omogoči preverjanja. Če ta URL počistite, je preverjanje popolnoma onemogočeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL att söka efter uppdateringar av AI-modellkatalogen på.\nKatalogen definierar de inbyggda AI-modellerna (kontextfönster, förmågor och den rekommenderade modellen per leverantör). iTerm2 hämtar regelbundet en signerad nyare kopia så att nya modeller blir tillgängliga utan appuppdatering. Det sker bara när AI-funktioner är aktiverade och du har gett tillstånd; en URL som inte är tom aktiverar inte kontrollen i sig. Om du rensar URL:en avaktiveras kontrollen helt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ model kataloğu güncellemelerini denetlemek için URL.\nKatalog, yerleşik YZ modellerini (bağlam penceresi, yetenekler ve her sağlayıcı için önerilen model) tanımlar. iTerm2, yeni modellerin uygulama güncellemesi olmadan kullanılabilmesi için düzenli olarak daha yeni imzalı bir kopya indirir. Bu yalnızca YZ özellikleri etkinse ve izin verdiyseniz gerçekleşir; boş olmayan bir URL tek başına denetlemeyi etkinleştirmez. Bu URL’yi temizlemek denetlemeyi tamamen devre dışı bırakır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL để kiểm tra bản cập nhật của danh mục mô hình AI.\nDanh mục xác định các mô hình AI tích hợp (cửa sổ ngữ cảnh, khả năng và mô hình được khuyến nghị cho từng nhà cung cấp). iTerm2 định kỳ tải về bản sao mới hơn đã được ký để các mô hình mới khả dụng mà không cần cập nhật ứng dụng. Điều này chỉ xảy ra khi các tính năng AI được bật và bạn đã cấp quyền; một URL không trống tự nó không bật việc kiểm tra. Xóa URL này sẽ tắt hoàn toàn việc kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于检查 AI 模型目录更新的 URL。\n该目录定义了内置 AI 模型（上下文窗口、能力以及各供应商推荐的模型）。iTerm2 会定期下载签名的新版本，因此无需应用更新即可获得新模型。仅当启用了 AI 功能且已授予权限时才会发生此情况；单独的非空 URL 无法启用检查。清除该 URL 将完全禁用检查功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於檢查 AI 模型目錄更新的 URL。\n目錄定義了內建的 AI 模型（上下文視窗、功能，以及各供應商的建議模型）。iTerm2 會定期下載已簽署的較新副本，因此不需更新 App 就能使用新模型。只有在啟用 AI 功能且你已授予權限時才會進行；單獨一個非空的 URL 並不會啟用檢查。清除此 URL 會完全停用檢查。"
          }
        }
      }
    },
    "AdvancedSetting.aiModernModelPrefixes" : {
      "comment" : "Advanced setting: aiModernModelPrefixes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podřetězce názvů modelů AI, které používají moderní API „completions“.\nPodřetězce oddělujte mezerami. Tím se zpracovávají názvy ve stylu OpenRouter, například „openai/gpt-4o“. Modely o1 používají jiné API a mají napevno dané chování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delstrenge i AI-modelnavne, der bruger den moderne “completions”-API.\nDelstrenge skal adskilles med mellemrum. Dette håndterer navne i OpenRouter-stil som “openai/gpt-4o”. Bemærk, at o1-modeller bruger en anden API og har fastkodet adfærd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilzeichenfolgen von KI-Modellnamen, die die moderne „completions“-API verwenden.\nTeilzeichenfolgen sollten durch Leerzeichen getrennt werden. Dies deckt Namen im OpenRouter-Stil wie „openai/gpt-4o“ ab. Beachten Sie, dass o1-Modelle eine andere API verwenden und fest codiertes Verhalten haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI model name substrings that use the modern 'completions' API.\nSubstrings should be space-delimited. This handles OpenRouter-style names like 'openai/gpt-4o'. Note that o1 models use a different API and have hard-coded behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subcadenas de nombres de modelos de IA que usan la API “completions” moderna.\nLas subcadenas deben separarse con espacios. Esto gestiona nombres al estilo de OpenRouter como “openai/gpt-4o”. Ten en cuenta que los modelos o1 usan una API diferente y tienen un comportamiento fijo en el código."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-mallien nimien osamerkkijonot, jotka käyttävät modernia ”completions”-API:a.\nOsamerkkijonot erotetaan välilyönnein. Tämä käsittelee OpenRouter-tyylisiä nimiä, kuten ”openai/gpt-4o”. Huomaa, että o1-mallit käyttävät eri API:a ja niiden toiminta on kovakoodattu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous-chaînes de noms de modèles d’IA qui utilisent l’API « completions » moderne.\nLes sous-chaînes doivent être séparées par des espaces. Cela gère les noms de type OpenRouter comme « openai/gpt-4o ». Notez que les modèles o1 utilisent une API différente et ont un comportement codé en dur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sottostringhe dei nomi di modelli IA che usano la moderna API “completions”.\nLe sottostringhe devono essere separate da spazi. Gestisce nomi in stile OpenRouter come “openai/gpt-4o”. Nota che i modelli o1 usano un’API diversa e hanno un comportamento fisso nel codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい「completions」APIを使用するAIモデル名の部分文字列。\n部分文字列はスペースで区切ってください。これは「openai/gpt-4o」のようなOpenRouter形式の名前に対応します。なお、o1モデルは異なるAPIを使用し、動作がハードコードされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 'completions' API를 사용하는 AI 모델 이름 부분 문자열.\n부분 문자열은 공백으로 구분해야 합니다. 'openai/gpt-4o' 같은 OpenRouter 스타일 이름을 처리합니다. o1 모델은 다른 API를 사용하며 동작이 하드코딩되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delstrenger i KI-modellnavn som bruker det moderne «completions»-API-et.\nDelstrengene bør skilles med mellomrom. Dette håndterer navn i OpenRouter-stil som ‘openai/gpt-4o’. Merk at o1-modeller bruker et annet API og har hardkodet oppførsel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subreeksen van AI-modelnamen die de moderne API ‘completions’ gebruiken.\nSubreeksen moeten door spaties worden gescheiden. Zo worden namen in OpenRouter-stijl zoals ‘openai/gpt-4o’ verwerkt. Let op: o1-modellen gebruiken een andere API en hebben vastgelegd gedrag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podciągi nazw modeli AI, które używają nowoczesnego API „completions”.\nPodciągi należy oddzielać spacjami. Obsługuje to nazwy w stylu OpenRouter, takie jak „openai/gpt-4o”. Pamiętaj, że modele o1 używają innego API i mają zakodowane na stałe zachowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substrings de nome de modelo de IA que usam a API “completions” moderna.\nAs substrings devem ser separadas por espaços. Isso lida com nomes no estilo do OpenRouter como “openai/gpt-4o”. Observe que os modelos o1 usam uma API diferente e têm comportamento fixo no código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подстроки имён моделей ИИ, использующих современный API «completions».\nПодстроки должны разделяться пробелами. Это обрабатывает имена в стиле OpenRouter, например «openai/gpt-4o». Обратите внимание, что модели o1 используют другой API и имеют жёстко заданное поведение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podreťazce názvov modelov AI, ktoré používajú moderné API „completions“.\nPodreťazce oddeľte medzerami. Týmto sa spracujú názvy v štýle OpenRouter, napríklad „openai/gpt-4o“. Modely o1 používajú iné API a majú pevne zadané správanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podnizi imen modelov AI, ki uporabljajo sodobni API »completions«.\nPodnizi naj bodo ločeni s presledki. To obravnava imena v slogu OpenRouter, kot je »openai/gpt-4o«. Upoštevajte, da modeli o1 uporabljajo drug API in imajo trdo kodirano vedenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delsträngar i AI-modellnamn som använder det moderna ”completions”-API:et.\nDelsträngar ska avgränsas med mellanslag. Detta hanterar namn i OpenRouter-stil som ”openai/gpt-4o”. Observera att o1-modeller använder ett annat API och har hårdkodat beteende."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern “completions” API’sini kullanan YZ model adı alt dizeleri.\nAlt dizeler boşlukla ayrılmalıdır. Bu, “openai/gpt-4o” gibi OpenRouter tarzı adları işler. o1 modellerinin farklı bir API kullandığını ve davranışlarının koda sabitlendiğini unutmayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chuỗi con của tên mô hình AI dùng API “completions” hiện đại.\nCác chuỗi con phải được phân tách bằng dấu cách. Điều này xử lý các tên kiểu OpenRouter như “openai/gpt-4o”. Lưu ý rằng các mô hình o1 dùng API khác và có hành vi được cố định trong mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用现代 'completions' API 的 AI 模型名称子字符串。\n这些子字符串应以空格分隔。这适用于类似 'openai/gpt-4o' 的 OpenRouter 风格名称。注意，o1 模型使用不同的 API 并具有固定行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用現代「completions」API 的 AI 模型名稱子字串。\n子字串應以空格分隔。這可處理像「openai/gpt-4o」這類 OpenRouter 風格的名稱。注意，o1 模型使用不同的 API，且行為是寫死的。"
          }
        }
      }
    },
