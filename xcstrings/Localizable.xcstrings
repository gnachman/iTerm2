    "CorruptApplication.SignatureMismatch" : {
      "comment" : "Alert shown when a required resource is missing and the code signature does not match the official distribution",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine erforderliche Datei scheint zu fehlen oder beschädigt zu sein, und die Codesignatur von iTerm2 stimmte nicht mit der der offiziellen Distribution überein. Sie sollten eine neue Kopie der App herunterladen und sie neu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A required file appears to be missing or corrupted and iTerm2’s code signature did not match that of the official distribution. You should download a fresh copy of the app and reinstall it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que falta un archivo necesario o que está dañado, y la firma de código de iTerm2 no coincide con la de la distribución oficial. Debes descargar una copia nueva de la app y reinstalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier requis semble manquant ou corrompu, et la signature de code d’iTerm2 ne correspond pas à celle de la distribution officielle. Vous devriez télécharger une nouvelle copie de l’app et la réinstaller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file necessario sembra mancare o essere danneggiato e la firma del codice di iTerm2 non corrisponde a quella della distribuzione ufficiale. Scarica una nuova copia dell’app e reinstallala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要なファイルが見つからないか破損しているようで、iTerm2のコード署名が公式配布版のものと一致しませんでした。アプリを新たにダウンロードして再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요한 파일이 없거나 손상된 것 같으며, iTerm2의 코드 서명이 공식 배포판의 서명과 일치하지 않습니다. 앱을 새로 다운로드하여 다시 설치하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo necessário parece estar ausente ou corrompido e a assinatura de código do iTerm2 não correspondeu à da distribuição oficial. Você deve baixar uma cópia nova do app e reinstalá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, что необходимый файл отсутствует или повреждён, а цифровая подпись кода iTerm2 не совпадает с подписью официальной версии. Рекомендуется скачать новую копию приложения и переустановить его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekli bir dosya eksik veya bozuk görünüyor ve iTerm2’nin kod imzası resmi dağıtımınkiyle eşleşmedi. Uygulamanın yeni bir kopyasını indirip yeniden yüklemelisiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少或损坏了必需的文件，且 iTerm2 的代码签名与官方版本不符。您应该下载新的应用并重新安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似乎缺少必要的檔案或檔案已損毀，且 iTerm2 的程式碼簽章與官方發行版本不符。你應該下載全新的 App 副本並重新安裝。"
          }
        }
      }
    },
