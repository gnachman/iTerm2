    "AITerm.NoModelAPIKey" : {
      "comment" : "Error shown when a manual AI model is configured to use its own API key but none is stored; “Manage AI Models” is the name of a settings window",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento model je nastaven na použití vlastního API klíče, ale žádný nebyl zadán. Zadejte jej úpravou modelu v okně „Spravovat modely AI“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne model er indstillet til at bruge sin egen API-nøgle, men der er ikke angivet nogen. Rediger modellen i Administrer AI-modeller for at angive en."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell ist so eingestellt, dass es einen eigenen API-Schlüssel verwendet, aber es wurde keiner eingegeben. Bearbeiten Sie das Modell unter „KI-Modelle verwalten“, um einen einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This model is set to use its own API key, but none has been entered. Edit the model in Manage AI Models to enter one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo está configurado para usar su propia clave de API, pero no se ha introducido ninguna. Edita el modelo en Gestionar modelos de IA para introducir una."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä malli on asetettu käyttämään omaa API-avaintaan, mutta sitä ei ole syötetty. Syötä avain muokkaamalla mallia kohdassa Hallitse AI-malleja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce modèle est configuré pour utiliser sa propre clé d’API, mais aucune n’a été saisie. Modifiez le modèle dans « Gérer les modèles d’IA » pour en saisir une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo modello è impostato per usare una propria chiave API, ma non ne è stata inserita nessuna. Modifica il modello in Gestisci modelli IA per inserirne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルは専用のAPIキーを使用するよう設定されていますが、キーが入力されていません。「AIモデルを管理」でモデルを編集してキーを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모델은 자체 API 키를 사용하도록 설정되어 있지만 입력된 키가 없습니다. AI 모델 관리에서 모델을 편집하여 키를 입력하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne modellen er satt til å bruke sin egen API-nøkkel, men ingen er oppgitt. Rediger modellen i Administrer KI-modeller for å oppgi en."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit model is ingesteld op zijn eigen API-sleutel, maar er is er geen ingevoerd. Wijzig het model in Beheer AI-modellen om er een in te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten model jest ustawiony na używanie własnego klucza API, ale żaden nie został wpisany. Edytuj model w oknie „Zarządzaj modelami AI”, aby go wpisać."
          }
