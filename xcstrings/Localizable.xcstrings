    "InstanceLock.Message" : {
      "comment" : "Shown at launch when another instance of iTerm2 is already running. %d is a process ID.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Instanz von iTerm2 (Prozess-ID %d) läuft bereits. Wenn zwei Instanzen gleichzeitig dieselben Einstellungen verwenden, können sie gegenseitig ihre Einstellungen und gespeicherten Fenster überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another copy of iTerm2 (process ID %d) is already running. If two copies use the same settings at once, they can overwrite each other’s preferences and saved windows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se está ejecutando otra copia de iTerm2 (ID de proceso %d). Si dos copias usan los mismos ajustes a la vez, pueden sobrescribirse mutuamente las preferencias y las ventanas guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre copie d’iTerm2 (ID de processus %d) est déjà en cours d’exécution. Si deux copies utilisent les mêmes réglages en même temps, elles peuvent écraser mutuellement leurs préférences et leurs fenêtres enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra copia di iTerm2 (ID processo %d) è già in esecuzione. Se due copie usano le stesse impostazioni contemporaneamente, possono sovrascrivere a vicenda le preferenze e le finestre salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の iTerm2 (プロセス ID %d) がすでに実行中です。2 つの iTerm2 が同時に同じ設定を使用すると、互いの環境設定や保存されたウインドウを上書きする可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 iTerm2(프로세스 ID %d)가 이미 실행 중입니다. 두 개의 iTerm2가 동시에 같은 설정을 사용하면 서로의 환경설정과 저장된 윈도우를 덮어쓸 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra cópia do iTerm2 (ID do processo %d) já está em execução. Se duas cópias usarem as mesmas configurações ao mesmo tempo, elas podem sobrescrever as preferências e as janelas salvas uma da outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая копия iTerm2 (идентификатор процесса %d) уже запущена. Если две копии одновременно используют одни и те же настройки, они могут перезаписать настройки и сохранённые окна друг друга."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2’nin başka bir kopyası (işlem kimliği %d) zaten çalışıyor. İki kopya aynı ayarları aynı anda kullanırsa birbirlerinin tercihlerinin ve kayıtlı pencerelerin üzerine yazabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个 iTerm2 副本（进程 ID %d）已在运行。如果两个副本同时使用相同的设置，它们可能会相互覆盖偏好设置和已保存的窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個 iTerm2 副本（程序 ID %d）已在執行中。如果兩個副本同時使用相同的設定，可能會互相覆寫偏好設定與已儲存的視窗。"
          }
        }
      }
    },
