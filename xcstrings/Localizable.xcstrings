    "BrowserErrorHandler.NetworkLostMessage" : {
      "comment" : "Error message: network connection lost",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síťové připojení bylo ztraceno. Zkontrolujte připojení k internetu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netværksforbindelsen blev afbrudt. Kontroller din internetforbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkverbindung wurde unterbrochen. Überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The network connection was lost. Check your internet connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdió la conexión de red. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkkoyhteys katkesi. Tarkista internetyhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion réseau a été perdue. Vérifiez votre connexion à Internet et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione di rete è stata persa. Controlla la connessione a internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続が失われました。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 연결이 끊어졌습니다. 인터넷 연결을 확인한 다음 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettverkstilkoblingen ble brutt. Kontroller internettforbindelsen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De netwerkverbinding is verbroken. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie sieciowe. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão de rede foi perdida. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сетевое соединение потеряно. Проверьте подключение к интернету и попробуйте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieťové pripojenie bolo prerušené. Skontrolujte pripojenie k internetu a skúste to znovu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omrežna povezava je bila izgubljena. Preverite internetno povezavo in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nätverksanslutningen förlorades. Kontrollera din internetanslutning och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bağlantısı kesildi. İnternet bağlantınızı denetleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối mạng đã bị mất. Hãy kiểm tra kết nối internet rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
