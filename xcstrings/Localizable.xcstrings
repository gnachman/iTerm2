    "Tip.0050.Body" : {
      "comment" : "Tip of the day body, id 0050",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen Sie Cursor-Boost unter „Einstellungen > Profile > Farben“ an, damit alle Farben gedämpfter wirken, außer dem Cursor. Verwenden Sie einen leuchtend weißen Cursor, damit er richtig heraussticht!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adjust Cursor Boost in “Settings > Profiles > Colors” to make all colors more muted, except the cursor. Use a bright white cursor and it pops!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el realce del cursor en “Ajustes > Perfiles > Colores” para atenuar todos los colores excepto el del cursor. ¡Usa un cursor blanco brillante y destacará!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le renforcement du curseur dans « Réglages > Profils > Couleurs » pour atténuer toutes les couleurs, sauf celle du curseur. Avec un curseur blanc éclatant, il ressort bien !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola l’intensificazione del cursore in “Impostazioni > Profili > Colori” per attenuare tutti i colori tranne quello del cursore. Usa un cursore bianco brillante e risalterà!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > カラー」でカーソルブーストを調整すると、カーソル以外のすべての色を控えめにできます。明るい白のカーソルを使えば、くっきりと際立ちます!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“설정 > 프로파일 > 색상”에서 커서 부스트를 조정하면 커서를 제외한 모든 색상을 차분하게 만들 수 있습니다. 밝은 흰색 커서를 사용하면 눈에 확 띕니다!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o Realce do cursor em “Ajustes > Perfis > Cores” para deixar todas as cores mais suaves, exceto o cursor. Use um cursor branco brilhante e ele se destaca!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте «Усиление курсора» в «Настройки > Профили > Цвета», чтобы сделать все цвета более приглушёнными, кроме курсора. Используйте ярко-белый курсор, и он будет выделяться!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç dışındaki tüm renkleri daha soluk yapmak için “Ayarlar > Profiller > Renkler” bölümünde “İmleç vurgusu”nu ayarlayın. Parlak beyaz bir imleç kullanın, öne çıksın!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 配置文件 > 颜色”中调整光标增强功能，使所有颜色变暗，仅保留光标为亮色。若使用明亮的白色光标，会非常显眼！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 描述檔 > 顏色」中調整「游標增強」，可讓游標以外的所有顏色變得更柔和。搭配亮白色的游標會特別醒目！"
          }
        }
      }
    },
