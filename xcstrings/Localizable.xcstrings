    "APIScriptLauncher.MigrationFallback" : {
      "comment" : "Script Console diagnostic when migrating a script to the uv Python runtime fails and it falls back to the old runtime; %1$@ is the script name and %2$@ is the error",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ konnte nicht auf die uv-Python-Laufzeitumgebung migriert werden (%2$@). Es wurde stattdessen mit der vorhandenen Laufzeitumgebung gestartet.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not migrate “%1$@” to the uv Python runtime (%2$@). It launched on the existing runtime instead.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo migrar “%1$@” al entorno de ejecución de Python de uv (%2$@). Se inició en el entorno de ejecución existente.\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de migrer « %1$@ » vers l’environnement d’exécution Python uv (%2$@). Il a été lancé sur l’environnement existant à la place.\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile migrare “%1$@” all’ambiente di esecuzione Python di uv (%2$@). È stato avviato invece nell’ambiente di esecuzione esistente.\n"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」をuv Pythonランタイムに移行できませんでした（%2$@）。代わりに既存のランタイムで起動しました。\n"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”을(를) uv Python 런타임으로 마이그레이션할 수 없습니다(%2$@). 대신 기존 런타임에서 실행했습니다.\n"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível migrar “%1$@” para o runtime Python do uv (%2$@). Ele foi iniciado no runtime existente.\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось перенести «%1$@» на среду выполнения Python uv (%2$@). Вместо этого он был запущен в существующей среде выполнения.\n"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” uv Python çalışma zamanına taşınamadı (%2$@). Bunun yerine mevcut çalışma zamanında başlatıldı.\n"
          }
        },
        "zh-Hans" : {
