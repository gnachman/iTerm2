    "ClaudeHealthMonitor.RemoteNotInstalledTitle" : {
      "comment" : "Body of the prompt offering to install the Claude Code hook on a remote host where claude is running; the value is the host",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code běží na hostiteli %@, ale hook iTerm2 tam není nainstalován, takže jeho stav se nezobrazí v nástroji Stav relace. Nainstalovat jej?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kører på %@, men hooket fra iTerm2 er ikke installeret der, så dens status vises ikke i værktøjet Sessionsstatus. Vil du installere det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code läuft auf %@, aber der Hook von iTerm2 ist dort nicht installiert, daher erscheint sein Status nicht im Werkzeug „Sitzungsstatus“. Jetzt installieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Claude Code is running on %@, but iTerm2’s hook isn’t installed there, so its status won’t appear in the Session Status tool. Install it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code se está ejecutando en %@, pero el hook de iTerm2 no está instalado allí, por lo que su estado no aparecerá en la herramienta Estado de la sesión. ¿Instalarlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code on käynnissä palvelimella %@, mutta iTerm2:n koukkua ei ole asennettu sinne, joten sen tila ei näy istunnon tila -työkalussa. Asennetaanko se?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code s’exécute sur %@, mais le hook d’iTerm2 n’y est pas installé, son état n’apparaîtra donc pas dans l’outil État des sessions. L’installer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code è in esecuzione su %@, ma l’hook di iTerm2 non è installato lì, quindi il suo stato non apparirà nello strumento Stato sessione. Installarlo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でClaude Codeが実行されていますが、iTerm2のフックがそこにインストールされていないため、そのステータスはSession Statusツールに表示されません。インストールしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Claude Code가 실행 중이지만 그곳에 iTerm2 훅이 설치되어 있지 않아 세션 상태 도구에 상태가 표시되지 않습니다. 설치하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kjører på %@, men iTerm2s hook er ikke installert der, så statusen vises ikke i verktøyet Øktstatus. Vil du installere den?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code draait op %@, maar de hook van iTerm2 is daar niet geïnstalleerd, dus de status verschijnt niet in de tool Sessiestatus. Wil je de hook installeren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code działa na hoście %@, ale hak iTerm2 nie jest tam zainstalowany, więc jego stan nie pojawi się w narzędziu „Stan sesji”. Zainstalować go?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code está em execução em %@, mas o hook do iTerm2 não está instalado lá, então seu status não aparecerá na ferramenta Status da sessão. Instalá-lo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code работает на %@, но хук iTerm2 там не установлен, поэтому его статус не будет отображаться в инструменте «Статус сессии». Установить его?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code beží na hostiteľovi %@, ale hook iTerm2 tam nie je nainštalovaný, preto sa jeho stav nezobrazí v nástroji Stav relácie. Nainštalovať ho?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code teče v gostitelju %@, vendar tam kavelj iTerm2 ni nameščen, zato se njegovo stanje ne bo prikazalo v orodju Stanje seje. Ga namestiti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code körs på %@, men iTerm2:s hook är inte installerad där, så statusen visas inte i verktyget Sessionsstatus. Vill du installera den?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code %@ ana makinesinde çalışıyor, ancak iTerm2’nin kancası orada yüklü değil; bu yüzden durumu Oturum Durumu aracında görünmeyecek. Yüklensin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code đang chạy trên %@, nhưng hook của iTerm2 chưa được cài đặt ở đó, nên trạng thái của nó sẽ không xuất hiện trong công cụ Trạng thái phiên. Cài đặt?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 正在 %@ 上运行，但那里未安装 iTerm2 的钩子，因此其状态不会显示在“会话状态”工具中。要安装吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 正在 %@ 上執行，但該處未安裝 iTerm2 的 hook，因此其狀態不會顯示在「工作階段狀態」工具中。要安裝嗎？"
          }
        }
      }
    },
