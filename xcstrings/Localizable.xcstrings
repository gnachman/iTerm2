    "AdvancedSetting.oscColorReport16Bits" : {
      "comment" : "Advanced setting: oscColorReport16Bits",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16-Bit-Farbwerte für OSC 4 und 10 bis 19 melden.\nUmgeht einen Fehler in älteren Versionen von vim, bei denen 8-Bit-Werte nicht korrekt verarbeitet werden konnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Report 16-bit color values to OSC 4 and 10 through 19.\nWorks around a bug in older vim where they could not properly parse 8-bit values."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4および10〜19に対して16ビットのカラー値を報告する。\n古いvimが8ビット値を正しく解析できないバグの回避策です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 4 및 10~19에 16비트 색상 값을 리포팅.\n8비트 값을 제대로 파싱하지 못하는 이전 vim의 버그를 우회합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar valores de cor de 16 bits para OSC 4 e 10 a 19.\nContorna um bug em versões antigas do vim onde não conseguiam analisar corretamente valores de 8 bits."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщать 16-битные значения цвета в ответ на OSC 4 и с 10 по 19.\nОбходит ошибку в старых версиях vim, которые не могли корректно разбирать 8-битные значения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 16 位颜色值报告给 OSC 4 和 10-19。\n解决了旧版 vim 中的一个问题，因为该版本无法正确解析 8 位值。"
          }
        }
      }
    },
    "AdvancedSetting.p3" : {
      "comment" : "Advanced setting: p3",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3 als Standardfarbraum verwenden? Bei „Nein“ wird sRGB verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use P3 as default color space? If No, sRGB will be used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのカラースペースとしてP3を使用するか？「いいえ」の場合はsRGBが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P3를 기본 색 공간으로 사용하겠습니까? 아니요인 경우 sRGB가 사용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar P3 como espaço de cor padrão? Se Não, será usado o sRGB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать P3 как цветовое пространство по умолчанию? Если нет, будет использоваться sRGB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 P3 作为默认颜色空间？如果否，则使用 sRGB。"
          }
        }
      }
    },
    "AdvancedSetting.paneTitleBarBackgroundColor" : {
      "comment" : "Advanced setting: paneTitleBarBackgroundColor",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Hintergrundfarbe für Bereichstitelleisten. Leer lassen, um die Standardfarbe zu verwenden.\nDies sollte eine Farbe im HTML-Stil sein, zum Beispiel #aabbcc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom background color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペインのタイトルバーのカスタム背景色。デフォルトの色を使用するには空欄のままにしてください。\n#aabbccのようなHTML形式の色を指定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널 제목 막대의 사용자 지정 배경색. 기본 색상을 사용하려면 비워 두십시오.\nHTML 스타일 색상(예: #aabbcc)이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de fundo personalizada para as barras de título dos painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский цвет фона для заголовков панелей. Оставьте пустым, чтобы использовать цвет по умолчанию.\nЦвет должен быть в HTML-формате, например #aabbcc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗格标题栏的自定义背景颜色。留空则使用默认颜色。\n应为 HTML 风格的颜色，如 #aabbcc。"
          }
        }
      }
    },
