        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để kéo hình ảnh hoặc văn bản đã chọn, bạn phải giữ ⌘. Điều này ngăn kéo nhầm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动图片或选中文本时，必须按住⌘键。这可以防止意外拖动。"
