          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere numarası başlık çubuğu aksesuarında gösterilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị số cửa sổ trong phụ kiện thanh tiêu đề?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标题栏附件中显示窗口编号？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在標題列附屬項目中顯示視窗編號？"
          }
        }
      }
    },
    "AdvancedSetting.useSystemCursorWhenPossible" : {
