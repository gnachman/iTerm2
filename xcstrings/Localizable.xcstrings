    "MultiClient.NoWritableDirectory" : {
      "comment" : "Error shown when neither support directory is writable",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weder ~/Library/Application Support/iTerm2 noch ~/.iterm2 sind beschreibbare Verzeichnisse. Dies verhindert, dass der Server zur Sitzungswiederherstellung ausgeführt wird. Bitte beheben Sie das Problem und starten Sie iTerm2 neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Neither ~/Library/Application Support/iTerm2 nor ~/.iterm2 are writable directories. This prevents the session restoration server from running. Please correct the problem and restart iTerm2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni ~/Library/Application Support/iTerm2 ni ~/.iterm2 son directorios con permiso de escritura. Esto impide que se ejecute el servidor de restauración de sesiones. Corrige el problema y reinicia iTerm2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni ~/Library/Application Support/iTerm2 ni ~/.iterm2 ne sont des répertoires accessibles en écriture. Cela empêche l’exécution du serveur de restauration de sessions. Veuillez corriger le problème et redémarrer iTerm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Né ~/Library/Application Support/iTerm2 né ~/.iterm2 sono directory scrivibili. Questo impedisce l’esecuzione del server di ripristino delle sessioni. Correggi il problema e riavvia iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/Library/Application Support/iTerm2も~/.iterm2も書き込み可能なディレクトリではありません。これにより、セッション復元サーバーを実行できません。問題を修正してiTerm2を再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/Library/Application Support/iTerm2와 ~/.iterm2 모두 쓰기 가능한 디렉토리가 아닙니다. 이 때문에 세션 복원 서버를 실행할 수 없습니다. 문제를 해결한 후 iTerm2를 재시작하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem ~/Library/Application Support/iTerm2 nem ~/.iterm2 são diretórios graváveis. Isso impede a execução do servidor de restauração de sessões. Corrija o problema e reinicie o iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни ~/Library/Application Support/iTerm2, ни ~/.iterm2 не являются доступными для записи каталогами. Это мешает работе сервера восстановления сессий. Пожалуйста, устраните проблему и перезапустите iTerm2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/Library/Application Support/iTerm2 ve ~/.iterm2 dizinlerinin hiçbiri yazılabilir değil. Bu, oturum geri yükleme sunucusunun çalışmasını engeller. Lütfen sorunu düzeltip iTerm2’yi yeniden başlatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "neither ~/Library/Application Support/iTerm2 nor ~/.iterm2 都是可写入的目录。这导致会话恢复服务器无法运行。请修复问题并重新启动 iTerm2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/Library/Application Support/iTerm2 與 ~/.iterm2 都不是可寫入的目錄。這會使工作階段還原伺服器無法執行。請修正問題後重新啟動 iTerm2。"
          }
        }
      }
    },
