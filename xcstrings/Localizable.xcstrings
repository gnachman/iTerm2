    "ClaudeCode.DisableAPIBody" : {
      "comment" : "Explanation shown when asking whether to disable the Python API during uninstall",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Installationsprogramm hat die Python-API von iTerm2 aktiviert. Andere Skripte oder Integrationen verwenden sie möglicherweise bereits. Soll sie aktiviert bleiben oder abgeschaltet werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The installer enabled iTerm2’s Python API. Other scripts or integrations may be using it now. Leave it enabled, or turn it off?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El instalador activó la API de Python de iTerm2. Es posible que otros scripts o integraciones la estén usando ahora. ¿Quieres dejarla activada o desactivarla?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d’installation a activé l’API Python d’iTerm2. D’autres scripts ou intégrations peuvent l’utiliser actuellement. La laisser activée ou la désactiver ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di installazione ha abilitato l’API Python di iTerm2. Altri script o integrazioni potrebbero usarla ora. Vuoi lasciarla abilitata o disabilitarla?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストーラーはiTerm2のPython APIを有効にしました。現在、他のスクリプトや連携機能がこれを使用している可能性があります。有効のままにしますか、それともオフにしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치 프로그램이 iTerm2의 Python API를 활성화했습니다. 지금 다른 스크립트나 통합 기능에서 이를 사용하고 있을 수 있습니다. 활성화된 상태로 두겠습니까, 아니면 끄겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O instalador ativou a Python API do iTerm2. Outros scripts ou integrações podem estar usando-a agora. Deixar ativada, ou desativá-la?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установщик включил Python API iTerm2. Сейчас его могут использовать другие скрипты или интеграции. Оставить включённым или отключить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleyici iTerm2’nin Python API’sini etkinleştirmişti. Diğer betikler veya entegrasyonlar şu anda bunu kullanıyor olabilir. Etkin kalsın mı, yoksa kapatılsın mı?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序启用了 iTerm2 的 Python API。其他脚本或集成现在可能正在使用它。保持启用，还是将其关闭？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝程式已啟用 iTerm2 的 Python API。其他腳本或整合功能現在可能正在使用它。要保持啟用，還是將其關閉？"
          }
        }
      }
    },
