    "LaunchExperience.PasteBehaviorChangeMessage" : {
      "comment" : "Message explaining that iTerm2 no longer warns before multi-line pastes",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 už před vložením více řádků nevaruje, pokud nejste na výzvě příkazového řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 advarer ikke længere før indsætning af flere linjer, medmindre du står ved shell-prompten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 warnt nicht mehr vor einem mehrzeiligen Einfügen, es sei denn, Sie befinden sich an der Shell-Eingabeaufforderung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 no longer warns before a multi-line paste, unless you are at the shell prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ya no avisa antes de un pegado de varias líneas, a menos que estés en el prompt del shell."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 ei enää varoita usean rivin sijoituksesta, ellet ole komentotulkin kehotteessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 n’avertit plus avant un collage de plusieurs lignes, sauf si vous êtes à l’invite du shell."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 non avvisa più prima di un incolla su più righe, a meno che tu non sia al prompt della shell."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は、シェルプロンプトにいる場合を除き、複数行のペースト前に警告を表示しなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 iTerm2는 셸 프롬프트에 있을 때를 제외하고는 여러 줄을 붙여넣기 전에 경고하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 advarer ikke lenger før innliming av flere linjer, med mindre du står på ledeteksten i skallet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 waarschuwt niet meer voordat je meerdere regels plakt, tenzij je je bij de shell-prompt bevindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 nie ostrzega już przed wklejeniem wielu wierszy, chyba że jesteś przy znaku zachęty powłoki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 não avisa mais antes de uma colagem de várias linhas, a menos que você esteja no prompt do shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 больше не предупреждает перед многострочной вставкой, если вы не находитесь в строке приглашения оболочки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
