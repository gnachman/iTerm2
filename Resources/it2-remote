#!/bin/sh
# Runs the it2 CLI on a remote host, from a stable path on PATH.
#
# iTerm2 uploads this wrapper to ~/.iterm2/bin/it2 and the interpreter it names to
# ~/.iterm2/it2.<hash>.py, the same path the shell-integration scripts materialize the
# embedded copy to, so the two mechanisms agree. A real executable rather than the shell
# function the
# scripts define, because that function only exists in an interactive
# shell: a Claude Code hook runs through `sh -c` and an agent's Bash tool does too, and
# neither would see it.
#
# IT2_PY is injected per connection and names the copy that matches THIS iTerm2. The
# fallback is substituted at build time with the hash of the bundled it2.py, so the
# wrapper still works in a shell that did not get the injected environment.
exec python3 "${IT2_PY:-$HOME/.iterm2/it2.9ec2bce60a6b86bf.py}" "$@"
