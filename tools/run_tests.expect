#!/usr/bin/expect --

if {$argc < 1} {
    puts "Usage: run_tests.expect \[-parallel\] <test-name> ..."
    puts "Example: run_tests.expect ModernTests/iTermScriptFunctionCallTest/testSignature"
    puts ""
    puts "  -parallel   Run test classes across several worker processes."
    puts "              Faster (roughly 90s -> 55s for the whole suite), but"
    puts "              xcodebuild then prints only the NAME of a failing test:"
    puts "              no file, no line, no assertion message. Use it for a"
    puts "              quick check when you do not expect failures, and re-run"
    puts "              without it to find out why something failed."
    puts ""
    puts "              With -parallel and no test name, the whole suite runs."
    exit 1
}

# -parallel anywhere in the arguments; everything else is a test name.
set parallel NO
set test_names {}
foreach arg $argv {
    if {$arg eq "-parallel" || $arg eq "--parallel"} {
        set parallel YES
    } else {
        lappend test_names $arg
    }
}

# No -only-testing flags at all means the whole suite, which is the point of
# passing -parallel by itself.
set only_testing_flags {}
foreach test_name $test_names {
    lappend only_testing_flags -only-testing:$test_name
}
# If xcodebuild prints nothing for this long, the run is treated as hung: what
# each test host was doing is saved by report_test_stall.sh and the run is
# killed. Override with RUN_TESTS_STALL_SECONDS (0 disables). The regular
# suite's slowest tests take seconds; the live harness scripts (run_ai_live.sh
# and friends) raise this because a single live test can wait minutes.
set stall_seconds 300
if {[info exists env(RUN_TESTS_STALL_SECONDS)]} {
    set stall_seconds $env(RUN_TESTS_STALL_SECONDS)
}
if {$stall_seconds > 0} {
    set timeout $stall_seconds
} else {
    set timeout -1
}
set script_dir [file dirname [file normalize [info script]]]

if {[info exists env(SIGNED)] && $env(SIGNED) eq "1"} {
    set signing_flags {}
} else {
    set signing_flags {CODE_SIGN_IDENTITY= CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO}
}

# Defensively clear the AI live harness config file unless our parent
# tells us not to. The file is meaningful only during run_ai_live.sh;
# for plain ModernTests it's stale state (left over from a SIGKILL'd
# previous run, etc.) that would cause AILiveHarness to think we want
# a live-API run. run_ai_live.sh exports ITERM2_AI_LIVE_KEEP_CONFIG=1
# before invoking this script so its freshly-written config survives.
if {!([info exists env(ITERM2_AI_LIVE_KEEP_CONFIG)] && $env(ITERM2_AI_LIVE_KEEP_CONFIG) eq "1")} {
    # Delete the config at the path the harness actually reads: the repo root
    # (AILiveHarness.configFilePath()). The previous version cleared
    # $TMPDIR/iterm2-ai-live.json, but the harness reads a different file, so the
    # defense never fired - a stale config (even from another worktree, back when
    # it lived in shared /tmp) silently turned the live harness on during plain
    # tests. Scoping the delete to this repo root closes that gap.
    if {![catch {exec git rev-parse --show-toplevel} repo_root]} {
        file delete -force [file join [string trim $repo_root] .iterm2-ai-live.json]
    }
}

proc kill_tree {pid} {
    catch {
        set children [exec pgrep -P $pid]
        foreach child [split $children "\n"] {
            set child [string trim $child]
            if {$child ne ""} {
                kill_tree $child
            }
        }
    }
    catch {exec kill -9 $pid}
}

# The tests that reported a result (passed, failed or skipped: a skipped test
# counts as executed), read from xcodebuild's one-line-per-test results. A run
# that executed no tests proves nothing, and xcodebuild reports success when a
# name matches nothing, so the eof handler fails such a run.
set executed_count 0
set unparsed_names {}
array set executed_classes {}
array set executed_methods {}

proc note_test_result {line} {
    global executed_count unparsed_names executed_classes executed_methods
    regsub -all {\x1b\[[0-9;]*[A-Za-z]} $line {} line
    set line [string trimright $line "\r\n"]
    # A line that names a test and ends with its duration is a result, whatever
    # the status wording ("passed", "failed", "skipped", "recorded an expected
    # failure", ...), so statuses are not enumerated. For example:
    # Serial:   Test Case '-[ModernTests.FooTests testBar]' passed (0.001 seconds).
    # Parallel: Test case 'FooTests.testBar()' passed on 'Clone 1 of ...' (0.001 seconds)
    # The match is anchored on the trailing duration, so an apostrophe in the
    # parallel destination name does not break it.
    if {![regexp {^Test [Cc]ase '([^']*)' .+ \([0-9.]+ seconds\)\.?$} $line -> name]} {
        return
    }
    incr executed_count
    set ident {[A-Za-z_][A-Za-z0-9_]*}
    if {[regexp "^-\\\[(?:$ident\\.)?($ident) ($ident)\\\]\$" $name -> class method] ||
        [regexp "^(?:$ident\\.)?($ident)\\.($ident)\\(\\)\$" $name -> class method]} {
        set executed_classes($class) 1
        set executed_methods($class/$method) 1
    } elseif {[llength $unparsed_names] < 5} {
        lappend unparsed_names $name
    }
}

# The names given on the command line (Target/Class or Target/Class/method)
# for which no test reported a result.
proc names_that_ran_nothing {} {
    global test_names executed_classes executed_methods
    set result {}
    foreach test_name $test_names {
        set parts [split $test_name /]
        set class [lindex $parts 1]
        set method [lindex $parts 2]
        regsub {\(\)$} $method {} method
        if {$class eq ""} {
            # A whole target: covered by the check that something ran.
            continue
        }
        if {$method eq ""} {
            if {![info exists executed_classes($class)]} {
                lappend result $test_name
            }
        } elseif {![info exists executed_methods($class/$method)]} {
            lappend result $test_name
        }
    }
    return $result
}

spawn xcodebuild test -project iTerm2.xcodeproj -scheme ModernTests {*}$only_testing_flags -parallel-testing-enabled $parallel {*}$signing_flags
set spawned_pid [exp_pid]

proc cleanup_and_exit {code} {
    global spawned_pid
    kill_tree $spawned_pid
    exit $code
}

trap {
    send_user "\n\n*** Interrupted, cleaning up ***\n\n"
    cleanup_and_exit 1
} {SIGINT SIGTERM}

expect {
    "Program crashed" {
        send_user "\n\n*** Detected interactive debug prompt, killing process ***\n\n"
        wait
        cleanup_and_exit 1
    }
    -re "\[^\n\]*\n" {
        # Consume output a line at a time so the timeout measures time since the
        # last line rather than since the run started.
        note_test_result $expect_out(0,string)
        exp_continue
    }
    timeout {
        set report [file join [pwd] tmp "test-stall-[clock format [clock seconds] -format %Y%m%d-%H%M%S].txt"]
        send_user "\n\n*** No test output for $stall_seconds seconds. The run looks hung. ***\n"
        catch {exec [file join $script_dir report_test_stall.sh] $report} summary
        send_user "$summary\n\n*** Killing the run. ***\n\n"
        # Test hosts aren't children of xcodebuild, so kill_tree misses them. Only
        # this checkout's, so a run in another worktree is left alone.
        catch {exec pkill -9 -f "[pwd]/Build/.*/iTerm2.app/Contents/MacOS/iTerm2 -suite iterm2-tests"}
        cleanup_and_exit 1
    }
    eof {
        catch wait result
        set code [lindex $result 3]
        if {$code != 0} {
            kill_tree $spawned_pid
            if {$parallel eq "YES"} {
                send_user "\n*** Tests failed. A parallel run reports only the test NAME;\n"
                send_user "*** re-run without -parallel to see the assertion and its line. ***\n\n"
            }
            exit $code
        }
        if {$executed_count == 0} {
            send_user "\n*** FAILED: the run executed no tests. Check the test names; a name that\n"
            send_user "*** matches nothing runs nothing, and xcodebuild still reports success. ***\n\n"
            exit 1
        }
        if {[llength $unparsed_names] > 0} {
            send_user "\n*** Could not tell which test names ran: a result line named a test in an\n"
            send_user "*** unexpected form (for example [lindex $unparsed_names 0]), so the check\n"
            send_user "*** that every given name ran something was skipped. ***\n\n"
        } else {
            set missing [names_that_ran_nothing]
            if {[llength $missing] > 0} {
                send_user "\n*** FAILED: these test names matched no test, so nothing ran for them:\n"
                foreach name $missing {
                    send_user "***   $name\n"
                }
                send_user "*** Check the names. $executed_count test(s) ran for the others. ***\n\n"
                exit 1
            }
        }
        exit 0
    }
}
