#!/usr/bin/expect --

if {$argc < 1} {
    puts "Usage: run_tests.expect \[-parallel\] <test-name> ..."
    puts "Example: run_tests.expect ModernTests/iTermScriptFunctionCallTest/testSignature"
    puts ""
    puts "  -parallel   Run test classes across several worker processes."
    puts "              Faster (roughly 90s -> 55s for the whole suite), but"
    puts "              xcodebuild then prints only the NAME of a failing test:"
    puts "              no file, no line, no assertion message. Use it for a"
    puts "              quick check when you do not expect failures, and re-run"
    puts "              without it to find out why something failed."
    puts ""
    puts "              With -parallel and no test name, the whole suite runs."
    exit 1
}

# -parallel anywhere in the arguments; everything else is a test name.
set parallel NO
set test_names {}
foreach arg $argv {
    if {$arg eq "-parallel" || $arg eq "--parallel"} {
        set parallel YES
    } else {
        lappend test_names $arg
    }
}

# No -only-testing flags at all means the whole suite, which is the point of
# passing -parallel by itself.
set only_testing_flags {}
foreach test_name $test_names {
    lappend only_testing_flags -only-testing:$test_name
}
set timeout -1

if {[info exists env(SIGNED)] && $env(SIGNED) eq "1"} {
    set signing_flags {}
} else {
    set signing_flags {CODE_SIGN_IDENTITY= CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO}
}

# Defensively clear the AI live harness config file unless our parent
# tells us not to. The file is meaningful only during run_ai_live.sh;
# for plain ModernTests it's stale state (left over from a SIGKILL'd
# previous run, etc.) that would cause AILiveHarness to think we want
# a live-API run. run_ai_live.sh exports ITERM2_AI_LIVE_KEEP_CONFIG=1
# before invoking this script so its freshly-written config survives.
if {!([info exists env(ITERM2_AI_LIVE_KEEP_CONFIG)] && $env(ITERM2_AI_LIVE_KEEP_CONFIG) eq "1")} {
    # Delete the config at the path the harness actually reads: the repo root
    # (AILiveHarness.configFilePath()). The previous version cleared
    # $TMPDIR/iterm2-ai-live.json, but the harness reads a different file, so the
    # defense never fired - a stale config (even from another worktree, back when
    # it lived in shared /tmp) silently turned the live harness on during plain
    # tests. Scoping the delete to this repo root closes that gap.
    if {![catch {exec git rev-parse --show-toplevel} repo_root]} {
        file delete -force [file join [string trim $repo_root] .iterm2-ai-live.json]
    }
}

proc kill_tree {pid} {
    catch {
        set children [exec pgrep -P $pid]
        foreach child [split $children "\n"] {
            set child [string trim $child]
            if {$child ne ""} {
                kill_tree $child
            }
        }
    }
    catch {exec kill -9 $pid}
}

spawn xcodebuild test -project iTerm2.xcodeproj -scheme ModernTests {*}$only_testing_flags -parallel-testing-enabled $parallel {*}$signing_flags
set spawned_pid [exp_pid]

proc cleanup_and_exit {code} {
    global spawned_pid
    kill_tree $spawned_pid
    exit $code
}

trap {
    send_user "\n\n*** Interrupted, cleaning up ***\n\n"
    cleanup_and_exit 1
} {SIGINT SIGTERM}

expect {
    "Program crashed" {
        send_user "\n\n*** Detected interactive debug prompt, killing process ***\n\n"
        wait
        cleanup_and_exit 1
    }
    eof {
        catch wait result
        set code [lindex $result 3]
        if {$code != 0} {
            kill_tree $spawned_pid
            if {$parallel eq "YES"} {
                send_user "\n*** Tests failed. A parallel run reports only the test NAME;\n"
                send_user "*** re-run without -parallel to see the assertion and its line. ***\n\n"
            }
        }
        exit $code
    }
}
