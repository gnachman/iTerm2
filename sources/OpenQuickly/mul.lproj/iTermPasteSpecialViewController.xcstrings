    "FKu-pE-gGN.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Both DOS and UNIX newlines are generally not used as input. CR is standard.\"; ObjectID = \"FKu-pE-gGN\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els salts de línia de DOS i UNIX no se solen fer servir com a entrada. CR és l’estàndard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konce řádků DOS i UNIX se jako vstup obvykle nepoužívají. Standardem je CR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både DOS- og UNIX-linjeskift bruges normalt ikke som input. CR er standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sowohl DOS- als auch UNIX-Zeilenumbrüche werden im Allgemeinen nicht als Eingabe verwendet. CR ist der Standard."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές γραμμής DOS και UNIX δεν χρησιμοποιούνται συνήθως ως είσοδος. Το CR είναι το πρότυπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los saltos de línea de DOS y UNIX no suelen usarse como entrada. CR es el estándar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS- ja UNIX-rivinvaihtoja ei yleensä käytetä syötteenä. CR on vakio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retours à la ligne DOS et UNIX ne sont généralement pas utilisés en entrée. CR est la norme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS और UNIX न्यूलाइन आम तौर पर इनपुट के रूप में उपयोग नहीं की जातीं। CR मानक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi redovi iz DOS-a i UNIX-a općenito se ne koriste kao ulaz. CR je standard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DOS és a UNIX újsor általában nem használatos bemenetként. A CR a szabványos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris baru DOS maupun UNIX umumnya tidak digunakan sebagai input. CR adalah standarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I caratteri di a capo DOS e UNIX in genere non vengono usati come input. CR è lo standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOSおよびUNIXの改行は通常、入力には使用されません。CRが標準です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 및 UNIX 줄바꿈은 일반적으로 입력으로 사용되지 않습니다. CR이 표준입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris baharu DOS dan UNIX biasanya tidak digunakan sebagai input. CR ialah standard."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både DOS- og UNIX-linjeskift brukes vanligvis ikke som inndata. CR er standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS- en UNIX-regeleindes worden doorgaans niet als invoer gebruikt. CR is de standaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki nowego wiersza z systemów DOS i UNIX zwykle nie są używane jako wejście. Standardem jest CR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As quebras de linha DOS e UNIX geralmente não são usadas como entrada. CR é o padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atât liniile noi DOS, cât și cele UNIX nu sunt folosite în general ca intrare. CR este standardul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как правило, ни DOS-, ни UNIX-переводы строк не используются в качестве ввода. Стандартом является CR."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové riadky DOS aj UNIX sa vo vstupe vo všeobecnosti nepoužívajú. Štandardom je CR."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi vrstici DOS in UNIX se običajno ne uporabljata kot vnos. Standard je CR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radbrytningar i DOS och UNIX används vanligtvis inte som indata. CR är standard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โดยทั่วไปไม่ใช้การขึ้นบรรทัดใหม่แบบ DOS และ UNIX เป็นข้อมูลเข้า CR คือมาตรฐาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS ve UNIX satır sonları genellikle girdi olarak kullanılmaz. Standart olan CR’dir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символи нового рядка DOS і UNIX зазвичай не використовуються як ввід. Стандарт: CR."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký tự xuống dòng kiểu DOS và UNIX thường không dùng làm đầu vào. CR là chuẩn."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS和UNIX换行符通常不用于输入。标准为CR。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 和 UNIX 换行符通常不用于输入。CR 是标准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 與 UNIX 換行符號通常不用於輸入，標準為 CR。"
          }
        }
      }
    },
