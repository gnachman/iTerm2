    "5Lu-I0-zTV.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Requires Shell Integration for prompt detection\"; ObjectID = \"5Lu-I0-zTV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detekce výzvy vyžaduje integraci shellu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræver shell-integration til registrering af prompt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert Shell-Integration zur Erkennung der Eingabeaufforderung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Requires Shell Integration for prompt detection"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere la integración con el shell para detectar el prompt"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edellyttää komentotulkki-integraatiota kehotteen tunnistamiseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite l’intégration du shell pour détecter l’invite"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede l’integrazione shell per rilevare il prompt"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプト検出にはシェル統合が必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트를 감지하려면 셸 통합이 필요함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krever skallintegrering for å oppdage ledetekst"
          }
        },
        "nl" : {
          "stringUnit" : {
