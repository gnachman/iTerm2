            "value" : "Escapar tabuladores con ^V"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escapoi sarkaimet ^V:llä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échapper les tabulations avec ^V"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैब को ^V से एस्केप करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escape tabulatore s ^V"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulátorok escape-elése ^V-vel"
          }
