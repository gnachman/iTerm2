          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konce řádků DOS i UNIX se jako vstup obvykle nepoužívají. Standardem je CR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både DOS- og UNIX-linjeskift bruges normalt ikke som input. CR er standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sowohl DOS- als auch UNIX-Zeilenumbrüche werden im Allgemeinen nicht als Eingabe verwendet. CR ist der Standard."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές γραμμής DOS και UNIX δεν χρησιμοποιούνται συνήθως ως είσοδος. Το CR είναι το πρότυπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los saltos de línea de DOS y UNIX no suelen usarse como entrada. CR es el estándar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS- ja UNIX-rivinvaihtoja ei yleensä käytetä syötteenä. CR on vakio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retours à la ligne DOS et UNIX ne sont généralement pas utilisés en entrée. CR est la norme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS और UNIX न्यूलाइन आम तौर पर इनपुट के रूप में उपयोग नहीं की जातीं। CR मानक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi redovi iz DOS-a i UNIX-a općenito se ne koriste kao ulaz. CR je standard."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DOS és a UNIX újsor általában nem használatos bemenetként. A CR a szabványos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris baru DOS maupun UNIX umumnya tidak digunakan sebagai input. CR adalah standarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I caratteri di a capo DOS e UNIX in genere non vengono usati come input. CR è lo standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOSおよびUNIXの改行は通常、入力には使用されません。CRが標準です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 및 UNIX 줄바꿈은 일반적으로 입력으로 사용되지 않습니다. CR이 표준입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baris baharu DOS dan UNIX biasanya tidak digunakan sebagai input. CR ialah standard."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både DOS- og UNIX-linjeskift brukes vanligvis ikke som inndata. CR er standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS- en UNIX-regeleindes worden doorgaans niet als invoer gebruikt. CR is de standaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki nowego wiersza z systemów DOS i UNIX zwykle nie są używane jako wejście. Standardem jest CR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As quebras de linha DOS e UNIX geralmente não são usadas como entrada. CR é o padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atât liniile noi DOS, cât și cele UNIX nu sunt folosite în general ca intrare. CR este standardul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как правило, ни DOS-, ни UNIX-переводы строк не используются в качестве ввода. Стандартом является CR."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové riadky DOS aj UNIX sa vo vstupe vo všeobecnosti nepoužívajú. Štandardom je CR."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novi vrstici DOS in UNIX se običajno ne uporabljata kot vnos. Standard je CR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radbrytningar i DOS och UNIX används vanligtvis inte som indata. CR är standard."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โดยทั่วไปไม่ใช้การขึ้นบรรทัดใหม่แบบ DOS และ UNIX เป็นข้อมูลเข้า CR คือมาตรฐาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS ve UNIX satır sonları genellikle girdi olarak kullanılmaz. Standart olan CR’dir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символи нового рядка DOS і UNIX зазвичай не використовуються як ввід. Стандарт: CR."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký tự xuống dòng kiểu DOS và UNIX thường không dùng làm đầu vào. CR là chuẩn."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS和UNIX换行符通常不用于输入。标准为CR。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 和 UNIX 换行符通常不用于输入。CR 是标准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 與 UNIX 換行符號通常不用於輸入，標準為 CR。"
          }
        }
      }
    },
    "ILq-w8-PQn.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Tab, line feed, form feed, and carriage return are the only “safe” control codes.\"; ObjectID = \"ILq-w8-PQn\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tabulador, l’avanç de línia, l’avanç de pàgina i el retorn de carro són els únics codis de control “segurs”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jediné „bezpečné“ řídicí kódy jsou tabulátor, posun o řádek, posun o stránku a návrat vozíku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulator, linjeskift (LF), sideskift og vognretur er de eneste “sikre” kontrolkoder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulator, Zeilenvorschub, Seitenvorschub und Wagenrücklauf sind die einzigen „sicheren“ Steuerzeichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα tab, line feed, form feed και carriage return είναι οι μόνοι «ασφαλείς» κωδικοί ελέγχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tab, line feed, form feed, and carriage return are the only “safe” control codes."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, line feed, form feed, and carriage return are the only “safe” control codes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, line feed, form feed, and carriage return are the only “safe” control codes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulador, avance de línea, avance de página y retorno de carro son los únicos códigos de control “seguros”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarkain, rivinsyöttö, sivunvaihto ja rivinpalautus ovat ainoat ”turvalliset” ohjauskoodit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tabulation, le saut de ligne, le saut de page et le retour chariot sont les seuls codes de contrôle « sûrs »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टैब, लाइन फ़ीड, फ़ॉर्म फ़ीड और कैरिज रिटर्न ही एकमात्र “सुरक्षित” कंट्रोल कोड हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulator, pomak retka, pomak stranice i povratak na početak retka jedini su “sigurni” kontrolni kodovi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tabulátor, a soremelés, a lapdobás és a kocsivissza az egyetlen „biztonságos” vezérlőkód."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, line feed, form feed, dan carriage return adalah satu-satunya kode kontrol yang “aman”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, avanzamento riga, avanzamento pagina e ritorno a capo sono gli unici codici di controllo “sicuri”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブ、ラインフィード、フォームフィード、キャリッジリターンのみが「安全な」制御コードです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭, 줄바꿈(LF), 폼 피드, 캐리지 리턴만 “안전한” 제어 코드입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, suapan baris, suapan borang dan pulangan pembawa ialah satu-satunya kod kawalan yang “selamat”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulator, linjemating, sidemating og vognretur er de eneste «trygge» kontrollkodene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, regelinvoer, paginadoorvoer en regelterugloop zijn de enige ‘veilige’ besturingscodes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulator, wysuw wiersza, wysuw strony i powrót karetki to jedyne „bezpieczne” kody sterujące."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulação, avanço de linha, avanço de página e retorno de carro são os únicos códigos de controle “seguros”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, avans de linie, avans de pagină și retur de car sunt singurele coduri de control „sigure”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единственные «безопасные» управляющие коды: табуляция, перевод строки, перевод страницы и возврат каретки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulátor, posun riadka, posun strany a návrat vozíka sú jediné „bezpečné“ riadiace kódy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabulator, pomik vrstice, pomik strani in vrnitev na začetek vrstice so edini »varni« krmilni znaki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabb, radmatning, sidmatning och vagnretur är de enda ”säkra” kontrolltecknen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, line feed, form feed และ carriage return เป็นรหัสควบคุมเพียงชนิดเดียวที่ “ปลอดภัย”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme, satır besleme, sayfa besleme ve satır başı yalnızca “güvenli” denetim kodlarıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Табуляція, переведення рядка, переведення сторінки та повернення каретки є єдиними «безпечними» керівними кодами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab, line feed, form feed và carriage return là các mã điều khiển “an toàn” duy nhất."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制表符、换行符、换页符和回车符是仅有的“安全”控制码。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制表符、换行符、换页符和回车符是仅有的“安全”控制码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab、換行、換頁和歸位字元是僅有的「安全」控制碼。"
          }
        }
      }
    },
