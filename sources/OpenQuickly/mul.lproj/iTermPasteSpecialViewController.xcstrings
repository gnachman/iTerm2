        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requer Shell Integration para detecção de prompt"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для определения приглашения требуется интеграция с оболочкой"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zistenie výzvy je potrebná integrácia shellu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za zaznavanje ukaznega poziva je potrebna integracija lupine"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver skalintegrering för att identifiera prompten"
          }
        },
        "tr" : {
