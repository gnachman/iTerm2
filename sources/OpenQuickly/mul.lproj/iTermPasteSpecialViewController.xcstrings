    "C2O-DY-y76.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Converts various forms of quotation marks and dashes to their ASCII equivalents.\"; ObjectID = \"C2O-DY-y76\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converteix diverses formes de cometes i guions als seus equivalents ASCII."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Převede různé formy uvozovek a pomlček na jejich ekvivalenty v ASCII."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konverterer forskellige former for anførselstegn og tankestreger til ASCII-ækvivalenter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandelt verschiedene Formen von Anführungszeichen und Gedankenstrichen in ihre ASCII-Entsprechungen um."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετατρέπει διάφορες μορφές εισαγωγικών και παύλων στα αντίστοιχα ASCII."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converts various forms of quotation marks and dashes to their ASCII equivalents."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converts various forms of quotation marks and dashes to their ASCII equivalents."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converts various forms of quotation marks and dashes to their ASCII equivalents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte varias formas de comillas y guiones a sus equivalentes ASCII."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuntaa erilaiset lainausmerkit ja ajatusviivat ASCII-vastineikseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertit diverses formes de guillemets et de tirets en leurs équivalents ASCII."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उद्धरण चिह्नों और डैश के विभिन्न रूपों को उनके ASCII समतुल्य में बदलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretvara različite oblike navodnika i crtica u njihove ASCII ekvivalente."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az idézőjelek és gondolatjelek különféle formáit az ASCII-megfelelőjükre alakítja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengonversi berbagai bentuk tanda kutip dan tanda hubung menjadi padanan ASCII-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte varie forme di virgolette e trattini nei corrispondenti caratteri ASCII."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さまざまな形式の引用符やダッシュをASCII相当の文字に変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다양한 형태의 따옴표와 대시를 해당하는 ASCII 문자로 변환합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menukar pelbagai bentuk tanda petikan dan sempang kepada setara ASCII."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konverterer ulike former for anførselstegn og streker til ASCII-ekvivalentene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet verschillende vormen van aanhalingstekens en streepjes om naar hun ASCII-equivalent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamienia różne formy cudzysłowów i myślników na ich odpowiedniki ASCII."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte várias formas de aspas e traços para seus equivalentes ASCII."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convertește diverse forme de ghilimele și liniuțe în echivalentele lor ASCII."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преобразует различные виды кавычек и тире в их эквиваленты ASCII."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevádza rôzne formy úvodzoviek a pomlčiek na ich ekvivalenty v ASCII."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretvori različne oblike narekovajev in pomišljajev v enakovredne znake ASCII."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konverterar olika former av citattecken och tankstreck till deras ASCII-motsvarigheter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปลงเครื่องหมายอัญประกาศและเครื่องหมายขีดรูปแบบต่างๆ เป็นอักขระ ASCII ที่เทียบเท่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeşitli tırnak işareti ve tire biçimlerini ASCII karşılıklarına dönüştürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетворює різні види лапок і тире на їхні ASCII-відповідники."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển nhiều dạng dấu ngoặc kép và dấu gạch ngang sang ký tự ASCII tương đương."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将各种形式的引号和破折号转换为对应的ASCII字符。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将各种形式的引号和破折号转换为 ASCII 等价形式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將各種形式的引號和破折號轉換為對應的 ASCII 字元。"
          }
        }
      }
    },
