    "FKu-pE-gGN.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Both DOS and UNIX newlines are generally not used as input. CR is standard.\"; ObjectID = \"FKu-pE-gGN\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konce řádků DOS i UNIX se jako vstup obvykle nepoužívají. Standardem je CR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både DOS- og UNIX-linjeskift bruges normalt ikke som input. CR er standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sowohl DOS- als auch UNIX-Zeilenumbrüche werden im Allgemeinen nicht als Eingabe verwendet. CR ist der Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Both DOS and UNIX newlines are generally not used as input. CR is standard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los saltos de línea de DOS y UNIX no suelen usarse como entrada. CR es el estándar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS- ja UNIX-rivinvaihtoja ei yleensä käytetä syötteenä. CR on vakio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les retours à la ligne DOS et UNIX ne sont généralement pas utilisés en entrée. CR est la norme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I caratteri di a capo DOS e UNIX in genere non vengono usati come input. CR è lo standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOSおよびUNIXの改行は通常、入力には使用されません。CRが標準です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS 및 UNIX 줄바꿈은 일반적으로 입력으로 사용되지 않습니다. CR이 표준입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både DOS- og UNIX-linjeskift brukes vanligvis ikke som inndata. CR er standard."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DOS- en UNIX-regeleindes worden doorgaans niet als invoer gebruikt. CR is de standaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki nowego wiersza z systemów DOS i UNIX zwykle nie są używane jako wejście. Standardem jest CR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As quebras de linha DOS e UNIX geralmente não são usadas como entrada. CR é o padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как правило, ни DOS-, ни UNIX-переводы строк не используются в качестве ввода. Стандартом является CR."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové riadky DOS aj UNIX sa vo vstupe vo všeobecnosti nepoužívajú. Štandardom je CR."
