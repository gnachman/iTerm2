    "6tG-RX-FWF.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"This is enabled when the running app has sent an escape code to turn on “bracketed paste mode.” The pasted string will be “bracketed” by escape codes indicating the text within is from a paste operation.\"; ObjectID = \"6tG-RX-FWF\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’activa quan l’app en execució ha enviat un codi d’escapament per activar el “mode d’enganxament delimitat”. El text enganxat quedarà “delimitat” per codis d’escapament que indiquen que el contingut prové d’una operació d’enganxament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne se, když spuštěná aplikace odeslala escape kód pro zapnutí „režimu vkládání v závorkách“. Vkládaný řetězec bude „uzavřen v závorkách“ escape kódy, které označují, že text uvnitř pochází z operace vložení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiveres, når den kørende app har sendt en escapekode for at slå “grupperet indsætning” til. Den indsatte streng “grupperes” af escapekoder, som angiver, at teksten stammer fra en indsætning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Option wird aktiviert, wenn die laufende Anwendung eine Escape-Sequenz gesendet hat, um den „Bracketed Paste Mode“ einzuschalten. Die eingefügte Zeichenfolge wird durch Escape-Sequenzen „geklammert“, die anzeigen, dass der enthaltene Text aus einem Einfügevorgang stammt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιείται όταν η εφαρμογή που εκτελείται έχει στείλει κωδικό διαφυγής για ενεργοποίηση της «παρενθετικής επικόλλησης». Η συμβολοσειρά που επικολλάται θα «περικλείεται» σε κωδικούς διαφυγής που δείχνουν ότι το κείμενο προέρχεται από επικόλληση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is enabled when the running app has sent an escape code to turn on “bracketed paste mode.” The pasted string will be “bracketed” by escape codes indicating the text within is from a paste operation."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is enabled when the running app has sent an escape code to turn on “bracketed paste mode.” The pasted string will be “bracketed” by escape codes indicating the text within is from a paste operation."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is enabled when the running app has sent an escape code to turn on “bracketed paste mode.” The pasted string will be “bracketed” by escape codes indicating the text within is from a paste operation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activa cuando la app en ejecución ha enviado un código de escape para activar el “modo de pegado entre delimitadores”. El texto pegado quedará “delimitado” por códigos de escape que indican que el contenido procede de una operación de pegado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on käytössä, kun käynnissä oleva sovellus on lähettänyt escape-koodin, joka ottaa käyttöön ”sulkeistetun sijoituksen tilan”. Sijoitettava merkkijono ”sulkeistetaan” escape-koodeilla, jotka ilmaisevat, että teksti tulee sijoituksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé quand l’app en cours d’exécution a envoyé un code d’échappement activant le « mode de collage délimité ». La chaîne collée sera « délimitée » par des codes d’échappement indiquant que le texte provient d’une opération de collage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह तब सक्षम होता है जब चल रहे ऐप ने “ब्रैकेटेड पेस्ट मोड” चालू करने के लिए एस्केप कोड भेजा हो। पेस्ट किया गया स्ट्रिंग एस्केप कोड से “ब्रैकेट” किया जाएगा, जो बताता है कि भीतर का टेक्स्ट पेस्ट ऑपरेशन से आया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućeno kada je aplikacija koja se izvodi poslala escape kod za uključivanje “moda lijepljenja u zagradama”. Zalijepljeni niz bit će “u zagradama” označen escape kodovima koji pokazuju da tekst unutar potječe iz operacije lijepljenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez akkor engedélyezett, ha a futó alkalmazás escape-kódot küldött a „zárójeles beillesztési mód” bekapcsolásához. A beillesztett karakterláncot escape-kódok „zárójelezik”, jelezve, hogy a bennük lévő szöveg beillesztésből származik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini aktif saat app yang berjalan telah mengirim kode escape untuk menyalakan “mode tempel berkurung”. String yang ditempel akan “dikurung” oleh kode escape yang menandakan bahwa teks di dalamnya berasal dari operasi tempel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si attiva quando l’app in esecuzione ha inviato un codice di escape per attivare la “modalità incolla delimitato”. Il testo incollato sarà “delimitato” da codici di escape che indicano che il contenuto proviene da un’operazione di incolla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のアプリが「Bracketed Paste Mode」をオンにするエスケープコードを送信すると有効になります。貼り付けられた文字列は、その内容が貼り付け操作によるものであることを示すエスケープコードで「囲まれ」ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 앱이 “브래킷 붙여넣기 모드”를 켜는 이스케이프 코드를 보낸 경우 켜집니다. 붙여넣은 문자열은 그 안의 텍스트가 붙여넣기 작업에서 왔음을 나타내는 이스케이프 코드로 “감싸집니다.”"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini didayakan apabila app yang sedang berjalan telah menghantar kod escape untuk mengaktifkan “mod tampal berkurungan”. Rentetan yang ditampal akan “dikurung” oleh kod escape yang menunjukkan teks di dalamnya datang daripada operasi tampal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er aktivert når programmet som kjører har sendt en escape-kode for å slå på «avgrenset innliming». Teksten som limes inn, blir «avgrenset» av escape-koder som viser at teksten kommer fra en innliming."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is ingeschakeld wanneer de actieve app een escapecode heeft verstuurd om de ‘modus voor geaccoladeerd plakken’ in te schakelen. De geplakte tekst wordt ‘omgeven’ door escapecodes die aangeven dat de tekst afkomstig is van een plakactie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączone, gdy działająca aplikacja wysłała sekwencję ucieczki włączającą „tryb wklejania w nawiasach”. Wklejany ciąg zostanie ujęty w sekwencje ucieczki wskazujące, że tekst pochodzi z operacji wklejania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto é ativado quando o app em execução envia um código de escape para ativar o “modo de colagem entre delimitadores.” O texto colado será “delimitado” por códigos de escape que indicam que o conteúdo vem de uma operação de colagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este activată când aplicația în rulare a trimis un cod escape pentru a activa „modul de lipire delimitată”. Șirul lipit va fi „delimitat” de coduri escape care indică faptul că textul dintre ele provine dintr-o operație de lipire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта функция включается, когда запущенное приложение отправило escape-код для включения режима «вставки в скобках». Вставляемая строка будет «обёрнута» escape-кодами, указывающими, что этот текст получен в результате операции вставки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne sa, keď spustená apka odošle escape kód na zapnutie „režimu vkladania so zátvorkami“. Vložený reťazec bude „uzavretý“ escape kódmi, ktoré označujú, že text vo vnútri pochádza z operácie vloženia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je omogočeno, ko je zagnana aplikacija poslala ubežno kodo za vklop »načina lepljenja v oklepajih«. Prilepljeni niz bo »v oklepajih« ubežnih kod, ki označujejo, da je besedilo znotraj iz operacije lepljenja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiveras när det körande programmet har skickat en escapekod för att slå på ”läget för inklistring inom hakparentes”. Den inklistrade strängen omges då av escapekoder som anger att texten kommer från en inklistring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานเมื่อแอปที่กำลังทำงานส่งรหัส Escape เพื่อเปิด “โหมดการวางแบบมีวงเล็บกำกับ” สตริงที่วางจะถูก “กำกับ” ด้วยรหัส Escape ที่ระบุว่าข้อความภายในมาจากการวาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek, çalışan uygulama “ayraçlı yapıştırma modunu” açan bir kaçış kodu gönderdiğinde etkinleşir. Yapıştırılan dize, içindeki metnin bir yapıştırma işleminden geldiğini belirten kaçış kodlarıyla “ayraçlanır”."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вмикається, коли запущена програма надіслала escape-код для ввімкнення «режиму вставлення в дужках». Вставлений рядок буде «взято в дужки» escape-кодами, які вказують, що текст усередині походить від операції вставлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn này được bật khi ứng dụng đang chạy đã gửi mã thoát để bật “chế độ dán có đánh dấu”. Chuỗi được dán sẽ được “đánh dấu” bằng các mã thoát cho biết văn bản bên trong đến từ thao tác dán."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当正在运行的App发送转义码以打开“括号粘贴模式”时启用此项。粘贴的字符串将由转义码“括起”，表示其中的文本来自粘贴操作。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当运行中的应用发送转义码开启“括号粘贴模式”时，此选项可用。粘贴的文本前后会添加转义码，让应用知道这段内容来自粘贴操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當執行中的 App 傳送跳脫碼開啟「括號貼上模式」時，此選項才可使用。貼上的字串前後會加上跳脫碼，表示其中的文字來自貼上操作。"
          }
        }
      }
    },
    "8UF-96-NRu.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Escape tabs with ^V\"; ObjectID = \"8UF-96-NRu\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
