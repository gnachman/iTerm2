    "fuh-hu-cy4.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You may be charged by your AI provider for each token sent or received.\"; ObjectID = \"fuh-hu-cy4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytovatel AI vám může účtovat poplatek za každý odeslaný nebo přijatý token."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din AI-udbyder kan opkræve betaling for hvert token, der sendes eller modtages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr KI-Anbieter kann Ihnen für jedes gesendete oder empfangene Token Kosten berechnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο πάροχος AI ενδέχεται να σας χρεώνει για κάθε token που αποστέλλεται ή λαμβάνεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You may be charged by your AI provider for each token sent or received."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu proveedor de IA puede cobrarte por cada token enviado o recibido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-palveluntarjoajasi voi veloittaa sinua jokaisesta lähetetystä tai vastaanotetusta tokenista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fournisseur d’IA peut vous facturer chaque jeton envoyé ou reçu."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš pružatelj AI usluge može vam naplatiti svaki poslani ili primljeni token."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AI-szolgáltató díjat számíthat fel minden elküldött vagy fogadott tokenért."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo provider IA potrebbe addebitarti ogni token inviato o ricevuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプロバイダーによって、送受信したトークンごとに課金される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 제공업체가 송수신하는 토큰마다 요금을 부과할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-leverandøren din kan ta betalt for hver token som sendes eller mottas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je AI-aanbieder kan kosten in rekening brengen voor elk verzonden of ontvangen token."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca AI może naliczać opłaty za każdy wysłany lub odebrany token."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu provedor de IA pode cobrar por cada token enviado ou recebido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furnizorul dvs. de AI vă poate taxa pentru fiecare token trimis sau primit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш поставщик ИИ может взимать плату за каждый отправленный или полученный токен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš poskytovateľ AI vám môže účtovať poplatok za každý odoslaný alebo prijatý token."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš ponudnik AI vam lahko zaračuna vsak poslani ali prejeti žeton."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din AI-leverantör kan ta betalt för varje token som skickas eller tas emot."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ sağlayıcınız gönderilen veya alınan her token için sizden ücret alabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà cung cấp AI của bạn có thể tính phí cho mỗi token được gửi hoặc nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你发送或接收的每个令牌都可能产生 AI 提供者费用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你傳送或接收的每個詞元，AI 供應商都可能向你收費。"
          }
        }
      }
    },
