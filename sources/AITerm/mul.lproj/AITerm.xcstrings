    "fuh-hu-cy4.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You may be charged by your AI provider for each token sent or received.\"; ObjectID = \"fuh-hu-cy4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr KI-Anbieter kann Ihnen für jedes gesendete oder empfangene Token Kosten berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You may be charged by your AI provider for each token sent or received."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプロバイダーによって、送受信したトークンごとに課金される場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu provedor de IA pode cobrar por cada token enviado ou recebido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш поставщик ИИ может взимать плату за каждый отправленный или полученный токен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你发送或接收的每个令牌都可能产生 AI 提供者费用。"
          }
        }
      }
    },
