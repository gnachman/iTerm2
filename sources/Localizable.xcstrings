        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」をホットキーとして使用してもよろしいですか? これはよく使われるキー操作のようです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza de que deseja usar “%@” como atalho? Isto parece uma combinação de teclas de uso comum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите использовать «%@» в качестве горячей клавиши? Это похоже на часто используемое сочетание клавиш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您确定要将“%@”设为热键吗？这看起来是一个常用的按键。"
          }
        }
      }
    },
