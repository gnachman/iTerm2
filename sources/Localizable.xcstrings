    "Tip.0084.Body" : {
      "comment" : "Tip of the day body, id 0084",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessern Sie Ihre Befehlszeile mit dem „Auto-Composer“, der die Befehlszeile durch ein natives Steuerelement zur einfacheren Nutzung ersetzt. Erfordert Shell-Integration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Improve your command line with the “auto composer”, which replaces the command line with a native control for ease of use. Requires shell integration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「オートコンポーザー」でコマンドラインを改善しましょう。コマンドラインをネイティブのコントロールに置き換え、使いやすくします。シェル統合が必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprimore sua linha de comando com o “auto compositor”, que substitui a linha de comando por um controle nativo para facilitar o uso. Requer o Shell Integration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшите работу с командной строкой с помощью «автокомпозера», который заменяет командную строку нативным элементом управления для удобства использования. Требует интеграции с оболочкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“自动 composer”改进你的命令行，该工具用原生控件替代命令行，便于使用。需要shell集成功能。"
          }
        }
      }
    },
