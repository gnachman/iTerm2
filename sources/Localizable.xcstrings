          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでiTerm2 Buddyを開き、「スキャン」をタップしてください。次に、下のペアリングコードを表示してカメラを向けてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu iPhone, abra o iTerm2 Buddy e toque em Escanear. Depois revele o código de pareamento abaixo e aponte a câmera para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вашем iPhone откройте iTerm2 Buddy и нажмите «Сканировать». Затем откройте код сопряжения ниже и наведите на него камеру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
