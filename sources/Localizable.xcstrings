    "SemanticHistory.CoprocessCaveat" : {
      "comment" : "Explanation of the coprocess semantic history action",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Coprocess wird ausgeführt, wenn Sie Semantic History auf einem beliebigen Dateinamen aktivieren. Verwenden Sie \\1 für den Dateinamen, \\2 für die Zeilennummer, \\3 für den Text vor dem Klick, \\4 für den Text nach dem Klick und \\5 für das Arbeitsverzeichnis (pwd). "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Coprocess runs when you activate Semantic History on any filename. Use \\1 for filename, \\2 for line number, \\3 for text before click, \\4 for text after click, \\5 for pwd. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のファイル名でSemantic Historyを起動すると、Coprocessが実行されます。ファイル名には\\1、行番号には\\2、クリック前のテキストには\\3、クリック後のテキストには\\4、作業ディレクトリには\\5を使用してください。 "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O coprocesso é executado quando você ativa o Semantic History em qualquer nome de arquivo. Use \\1 para o nome do arquivo, \\2 para o número da linha, \\3 para o texto antes do clique, \\4 para o texto após o clique, \\5 para o pwd. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопроцесс запускается при активации Semantic History для любого имени файла. Используйте \\1 для имени файла, \\2 для номера строки, \\3 для текста перед щелчком, \\4 для текста после щелчка, \\5 для рабочей папки. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何文件名上激活语义历史记录时运行协同进程。使用 \\1 表示文件名，\\2 表示行号，\\3 表示点按前的文本，\\4 表示点按后的文本，\\5 表示当前目录。"
          }
        }
      }
    },
