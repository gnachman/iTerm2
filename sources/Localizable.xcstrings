    "Tip.0118.Body" : {
      "comment" : "Tip of the day body, id 0118",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können ein Profil als Webbrowser konfigurieren! Stellen Sie unter „Einstellungen > Profile > Allgemein“ den „Profiltyp“ auf „Webbrowser“. Tastenkombinationen, intelligente Auswahl und der Passwort-Manager funktionieren auch in Browser-Sitzungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can configure a profile to be a web browser! In “Settings > Profiles > General”, set “Profile Type” to “Web Browser”. Key bindings, smart selection, and the password manager all work in browser sessions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルをウェブブラウザとして設定できます！「設定 > プロファイル > 一般」で「プロファイルタイプ」を「ウェブブラウザ」に設定してください。キーバインド、スマート選択、パスワードマネージャーはすべてブラウザセッションでも動作します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode configurar um perfil para ser um navegador da web! Em “Settings > Profiles > General”, defina “Profile Type” como “Web Browser”. Atalhos de teclado, seleção inteligente e o cofre de senhas funcionam todos em sessões de navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете настроить профиль так, чтобы он работал как веб-браузер! В разделе «Настройки > Профили > Общие» установите для параметра «Тип профиля» значение «Веб-браузер». Привязки клавиш, умный выбор и менеджер паролей работают и в сеансах браузера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以配置配置文件为网页浏览器！在“设置 > 配置文件 > 通用”中，将“配置文件类型”设置为“网页浏览器”。按键绑定、智能选取以及密码管理器均可在浏览器会话中正常使用。"
          }
        }
      }
    },
