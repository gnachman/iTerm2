    "StatusBarSwiftyString.DetailedDescription" : {
      "comment" : "Detailed description of the interpolated string status bar component",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt das Ergebnis der Auswertung einer Zeichenfolge mit eingebetteten Ausdrücken an, die Sitzungsvariablen oder die Ausgabe registrierter Skriptfunktionen enthalten können"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the evaluation of a string with inline expressions which may include session variables or the output of registered scripting functions"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション変数や登録済みのスクリプト関数の出力を含めることができるインライン式を持つ文字列の評価結果を表示します"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o resultado da avaliação de uma string com expressões inline que podem incluir variáveis de sessão ou a saída de funções de script registradas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает результат вычисления строки со встроенными выражениями, которые могут включать переменные сессии или результат работы зарегистрированных функций сценариев"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示对包含内联表达式的字符串求值的结果，这些表达式可能包含会话变量或已注册脚本函数的输出"
          }
        }
      }
    },
