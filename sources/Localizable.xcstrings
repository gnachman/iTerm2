      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Anzahl von Zeichen vor und nach der Klickposition, die beim Anwenden von Wortauswahl-Regex-Mustern durchsucht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum number of characters before and after the click location to search when applying word selection regex patterns."
