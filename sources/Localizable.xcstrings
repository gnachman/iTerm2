    "Tip.0006.Body" : {
      "comment" : "Tip of the day body, id 0006",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren Sie eine Auswahl mit ⌥⌘C, um Stile wie Farben und Schriftarten einzuschließen. Sie können dies unter „Einstellungen > Erweitert“ zur Standardaktion für „Kopieren“ machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copy a selection with ⌥⌘C to include styles such as colors and fonts. You can make this the default action for Copy in “Settings > Advanced.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘C で選択範囲をコピーすると、色やフォントなどのスタイルも含められます。「設定 > 詳細」でこれをコピーのデフォルト動作にすることもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie uma seleção com ⌥⌘C para incluir estilos como cores e fontes. Você pode tornar esta a ação padrão para Copiar em “Ajustes > Avançado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте выделение с помощью ⌥⌘C, чтобы сохранить стили, такие как цвета и шрифты. Вы можете сделать это действием по умолчанию для команды «Копировать» в «Настройки > Дополнительно»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ⌥⌘C 复制选中的内容，可包含颜色、字体等样式。你可以在“设置 > 高级”中将此设为复制的默认操作。"
          }
        }
      }
    },
