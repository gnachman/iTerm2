    "AdvancedSetting.alertsIndicateShortcuts" : {
      "comment" : "Advanced setting: alertsIndicateShortcuts",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltflächen in modalen Warnmeldungen zeigen Tastaturkürzel an.\nVermissen Sie Windows 95? Ich schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buttons in modal alerts indicate keyboard shortcuts.\nDo you miss Windows 95? I do."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーダルアラートのボタンにキーボードショートカットを表示する。\nWindows 95が懐かしいですか？私は懐かしいです。"
          }
        },
        "pt-BR" : {
