      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie Tastenkombinationen aus zwei Tastenanschlägen mithilfe eines „Leaders“: einem speziellen Tastendruck, der einer benutzerdefinierten Tastenzuordnung vorausgeht."
          }
