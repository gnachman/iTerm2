    "Tip.0022.Body" : {
      "comment" : "Tip of the day body, id 0022",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Shell-Integration können Sie sich benachrichtigen lassen (⌥⌘A), wenn ein lange laufender Befehl abgeschlossen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Shell Integration feature lets you ask to be alerted (⌥⌘A) when a long-running command completes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合機能を使うと、長時間実行しているコマンドが完了したときにアラートを受け取るよう設定できます(⌥⌘A)。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
