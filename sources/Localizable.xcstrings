      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Funktion „Semantischer Verlauf“ können Sie bei gedrückter ⌘-Taste auf eine Datei oder URL klicken, um sie zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “Semantic History” feature allows you to ⌘-click on a file or URL to open it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「セマンティックヒストリー」機能を使うと、ファイルやURLを⌘クリックして開くことができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O recurso “Semantic History” permite clicar com ⌘ em um arquivo ou URL para abri-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
