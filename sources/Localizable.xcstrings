      }
    },
    "AdvancedSetting.hideStuckTooltips" : {
      "comment" : "Advanced setting: hideStuckTooltips",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängende Tooltips ausblenden.\nWenn Sie iTerm2 mit einer Hotkey-Taste ausblenden, während ein Tooltip gerade ausgeblendet wird, bleibt er aufgrund eines Betriebssystemfehlers hängen. Umgehen Sie dies mit einem unschönen Hack, indem Sie diese Funktion aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide stuck tooltips.\nWhen you hide iTerm2 using a hotkey while a tooltip is fading out it gets stuck because of an OS bug. Work around it with a nasty hack by enabling this feature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固まったツールチップを非表示にします。\nツールチップがフェードアウト中にホットキーで iTerm2 を非表示にすると、OS のバグによりツールチップが固まってしまいます。この機能を有効にすると、強引なハックでこれを回避します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar dicas travadas.\nQuando você oculta o iTerm2 usando uma hotkey enquanto uma dica está desaparecendo, ela fica travada por causa de um bug do sistema. Contorne isso com um hack desagradável ativando este recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать зависшие подсказки.\nКогда вы скрываете iTerm2 горячей клавишей во время затухания подсказки, она зависает из-за ошибки ОС. Обойдите это неприятным хаком, включив эту функцию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏卡住的工具提示。\n当工具提示正在消失时通过热键隐藏iTerm2，由于操作系统缺陷会导致工具提示卡住。可通过启用此功能来作为变通方案。"
          }
        }
      }
    },
    "AdvancedSetting.highVisibility" : {
      "comment" : "Advanced setting: highVisibility",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "High-Contrast-Modi maximieren die Sichtbarkeit.\nWenn aktiviert, legt das dunkle High-Contrast-Design mehr Wert auf Sichtbarkeit als auf Optik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "High Contrast modes maximize visibility.\nWhen enabled, the dark high-contrast theme emphasizes visibility over beauty."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイコントラストモードで視認性を最大化します。\n有効にすると、ダークハイコントラストテーマは美しさよりも視認性を重視します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modos de Alto Contraste maximizam a visibilidade.\nQuando ativado, o tema escuro de alto contraste enfatiza a visibilidade em vez da beleza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режимы High Contrast максимизируют видимость.\nПри включении тёмная тема высокой контрастности делает упор на видимость, а не на красоту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高对比度模式可提升可见度。\n启用后，深色高对比度主题会更注重显示效果而非美观性。"
          }
        }
      }
    },
    "AdvancedSetting.horizontalScrollingSensitivity" : {
      "comment" : "Advanced setting: horizontalScrollingSensitivity",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfindlichkeit des Mausrads für horizontales Scrollen.\nVerwenden Sie 0, um es zu deaktivieren. Der Wert sollte zwischen 0 und 1 liegen. Änderungen an dieser Einstellung wirken sich nur auf neue Sitzungen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensitivity of mouse wheel for horizontal scrolling.\nUse 0 to disable. Value should be between 0 and 1. Changes to this setting only affect new sessions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水平スクロールに対するマウスホイールの感度。\n無効にするには 0 を指定してください。値は 0 から 1 の間で指定します。この設定への変更は新しいセッションにのみ影響します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensibilidade da roda do mouse para rolagem horizontal.\nUse 0 para desativar. O valor deve estar entre 0 e 1. Alterações neste ajuste só afetam novas sessões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чувствительность колеса мыши для горизонтальной прокрутки.\nИспользуйте 0, чтобы отключить. Значение должно быть между 0 и 1. Изменения этой настройки влияют только на новые сессии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠标滚轮用于水平滚动的灵敏度。\n设为0可禁用该功能。数值应在0到1之间。此设置仅对新建会话生效。"
          }
        }
      }
    },
    "AdvancedSetting.hotKeyDoubleTapMaxDelay" : {
      "comment" : "Advanced setting: hotKeyDoubleTapMaxDelay",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die maximal zulässige Zeit zwischen dem Drücken einer Modifizierertaste bei einem Modifizierer-Doppeltipp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The maximum amount of time allowed between presses of a modifier key when performing a modifier double-tap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーのダブルタップを行う際に、修飾キーの押下間で許容される最大の時間。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo máximo permitido entre pressionamentos de uma tecla modificadora ao realizar um toque duplo de modificador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное время между нажатиями клавиши-модификатора при двойном нажатии модификатора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "执行修饰键双击操作时，两次按下修饰键之间允许的最大时间间隔。"
          }
        }
      }
    },
    "AdvancedSetting.hotKeyDoubleTapMinDelay" : {
      "comment" : "Advanced setting: hotKeyDoubleTapMinDelay",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die minimal erforderliche Zeit zwischen dem Drücken einer Modifizierertaste bei einem Modifizierer-Doppeltipp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The minimum amount of time required between presses of a modifier key when performing a modifier double-tap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーのダブルタップを行う際に、修飾キーの押下間で必要な最小の時間。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo mínimo necessário entre pressionamentos de uma tecla modificadora ao realizar um toque duplo de modificador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимальное время, требуемое между нажатиями клавиши-модификатора при двойном нажатии модификатора."
          }
        },
        "zh-Hans" : {
