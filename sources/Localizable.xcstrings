    },
    "AdvancedSetting.timeoutForStringEvaluation" : {
      "comment" : "Advanced setting: timeoutForStringEvaluation",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout (Sekunden) für die Auswertung von RPCs.\nDies gilt für den Aufruf von Funktionen, die von Skripten registriert wurden, wenn die Swift-Syntax für Inline-Ausdrücke verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timeout (seconds) for evaluating RPCs.\nThis applies to invoking functions registered by scripts when using the Swift syntax for inline expressions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPCを評価する際のタイムアウト（秒）。\nこれは、インライン式にSwift構文を使用する際にスクリプトが登録した関数を呼び出す場合に適用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo limite (segundos) para avaliar RPCs.\nIsso se aplica à invocação de funções registradas por scripts ao usar a sintaxe Swift para expressões inline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тайм-аут (в секундах) для вычисления RPC.\nПрименяется при вызове функций, зарегистрированных скриптами, если используется синтаксис Swift для встроенных выражений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评估RPCs的超时时间（秒）。  \n此规则适用于使用Swift内联表达式语法时由脚本注册的函数调用。"
          }
        }
      }
    },
    "AdvancedSetting.timeToWaitForEmojiPanel" : {
      "comment" : "Advanced setting: timeToWaitForEmojiPanel",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange in Sekunden auf das Öffnen des Emoji-Fensters gewartet werden soll?\nSchwebende Hotkey-Fenster passen ihre Ebene an, wenn das Emoji-Fenster geöffnet ist. Falls es sehr langsam ist, müssen Sie diesen Wert eventuell erhöhen, damit es nicht hinter einem schwebenden Hotkey-Fenster erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long to wait for the emoji panel to open in seconds?\nFloating hotkey windows adjust their level when the emoji panel is open. If it’s really slow you might need to increase this value to prevent it from appearing beneath a floating hotkey window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絵文字パネルが開くまで何秒待ちますか？\nフローティングホットキーウィンドウは、絵文字パネルが開いている間そのレベルを調整します。動作が非常に遅い場合、フローティングホットキーウィンドウの下に表示されるのを防ぐため、この値を増やす必要があるかもしれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo esperar para o painel de emoji abrir, em segundos?\nJanelas de hotkey flutuantes ajustam seu nível quando o painel de emoji está aberto. Se estiver muito lento, talvez você precise aumentar este valor para evitar que ele apareça atrás de uma janela de hotkey flutuante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько секунд ждать открытия панели эмодзи?\nПлавающие окна горячих клавиш меняют свой уровень, когда панель эмодзи открыта. Если это происходит очень медленно, может понадобиться увеличить это значение, чтобы панель не оказалась под плавающим окном горячих клавиш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表情符号面板打开所需的等待时间（秒）。  \n浮动热键窗口在表情符号面板打开时会调整层级。如果操作非常慢，可能需要提高此值以避免其在浮动热键窗口下方显示。"
          }
        }
      }
    },
    "AdvancedSetting.tmuxIncludeClientNameInWindowTitle" : {
      "comment" : "Advanced setting: tmuxIncludeClientNameInWindowTitle",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll bei Verwendung der tmux-Integration der tmux-Client-Name (in der Regel der Name der verbindenden Sitzung oder der Hostname) in Klammern im Fenstertitel erscheinen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using tmux integration, should the tmux client name (typically the name of the attaching session or the host name) appear in brackets in the window title?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux統合を使用する場合、tmuxクライアント名（通常は接続先セッション名またはホスト名）をウィンドウタイトルに角括弧で表示しますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar a integração com tmux, o nome do cliente tmux (normalmente o nome da sessão que se conecta ou o nome do host) deve aparecer entre colchetes no título da janela?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать ли имя клиента tmux (обычно это имя подключаемого сеанса или имя хоста) в квадратных скобках в заголовке окна при использовании интеграции с tmux?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用tmux集成时，tmux客户端名称（通常是连接会话或主机名）是否应出现在窗口标题的方括号中？"
          }
        }
