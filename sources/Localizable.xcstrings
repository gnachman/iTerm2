        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулярные выражения умного выделения можно редактировать в «Настройки > Профили > Дополнительные > Умное выделение»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以在“Settings > Profiles > Advanced > Smart Selection”中编辑智能选取的正则表达式。"
