    "AdvancedSetting.detectParagraphDirection" : {
      "comment" : "Advanced setting: detectParagraphDirection",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibrichtung von Absätzen automatisch anhand des ersten stark richtungsbestimmenden Zeichens erkennen?\nErfordert aktivierte Unterstützung für Rechts-nach-links-Text."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Auto-detect paragraph writing direction based on the first strong directional character?\nRequires right-to-left text support to be enabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段落の最初の強い方向性文字に基づいて、段落の書字方向を自動検出しますか?\n右から左のテキストサポートを有効にする必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectar automaticamente a direção de escrita do parágrafo com base no primeiro caractere direcional forte?\nRequer que o suporte a texto da direita para a esquerda esteja ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически определять направление письма абзаца по первому символу с выраженным направлением?\nТребует включённой поддержки текста справа налево."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据第一个强方向字符自动检测段落书写方向？\n需要启用从右到左文本支持。"
          }
        }
      }
    },
    "AdvancedSetting.detectPasswordInput" : {
      "comment" : "Advanced setting: detectPasswordInput",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbol am Cursor bei einer Passwortabfrage anzeigen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show key at cursor at password prompt?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードプロンプトでカーソル位置にキーを表示しますか?"
          }
