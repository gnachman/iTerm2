{
  "sourceLanguage": "en",
  "strings": {
    "ChatInputView_Heading_AttachFiles_FORMAT": {
      "comment": "Alert heading for attached dropped files in handleTextViewFileDrop",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@files@"
          },
          "substitutions": {
            "files": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Attach File?"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Attach Files?"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "ChatWindowController_ConfirmDeleteChats_FORMAT": {
      "comment": "Confirmation shown in deleteChats",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@chats@"
          },
          "substitutions": {
            "chats": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Are you sure you want to delete this chat? This action cannot be undone."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Are you sure you want to delete %lld chats? This action cannot be undone."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
