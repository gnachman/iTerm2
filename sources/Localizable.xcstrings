    "PTYSession.UnsafeBadgeFormat" : {
      "comment" : "Warning that a badge format was rejected because it contained a function call",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung hat versucht, das Badge auf einen Wert zu setzen, der einen Funktionsaufruf auslösen würde. Aus Sicherheitsgründen ist dies nicht zulässig, und das Badge wurde nicht aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The application attempted to set the badge to a value that would invoke a function call. For security reasons, this is not allowed and the badge was not updated."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーションが関数呼び出しを実行する値にバッジを設定しようとしました。セキュリティ上の理由からこれは許可されておらず、バッジは更新されませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo tentou definir o selo com um valor que invocaria uma chamada de função. Por motivos de segurança, isso não é permitido e o selo não foi atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение попыталось установить для значка значение, которое вызвало бы вызов функции. В целях безопасности это не разрешено, и значок не был обновлён."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用试图将角标设置为会触发函数调用的值。出于安全原因，此操作不被允许，角标未更新。"
          }
        }
      }
    },
