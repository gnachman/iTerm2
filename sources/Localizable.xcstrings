    "Tip.0086.Body" : {
      "comment" : "Tip of the day body, id 0086",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie mit „Codecierge“, einer Funktion im Werkzeugkasten, Terminalziele fest und erreichen Sie sie. Sie werden dabei anhand Ihrer Terminalaktivität Schritt für Schritt begleitet. Für diese Funktion ist ein OpenAI-API-Schlüssel erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set and achieve terminal goals with “Codecierge”, a Toolbelt feature that guides you step-by-step based on your terminal activity. An OpenAI API key is necessary for this feature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Codecierge」を使うと、ターミナルでの目標を設定して達成できます。これはターミナルでの操作に基づいて段階的に案内してくれるツールベルトの機能です。この機能にはOpenAI APIキーが必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina e alcance metas no terminal com o “Concierge de código”, um recurso da Caixa de ferramentas que orienta você passo a passo com base na sua atividade no terminal. Uma chave de API da OpenAI é necessária para esse recurso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте и достигайте целей в терминале с помощью «Codecierge», инструмента панели инструментов, который пошагово направляет вас на основе вашей активности в терминале. Для этой функции необходим ключ API OpenAI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Codecierge”是一个工具包功能，根据你的终端活动逐步指导你实现终端目标。此功能需要OpenAI API密钥。"
          }
        }
      }
    },
