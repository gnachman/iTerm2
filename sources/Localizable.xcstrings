    "Companion.ShowCode.Body" : {
      "comment" : "Explanatory paragraph on the show-pairing-code screen",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie auf Ihrem iPhone iTerm2 Buddy und tippen Sie auf Scannen. Zeigen Sie dann den Kopplungscode unten an und richten Sie die Kamera darauf."
          }
        },
        "en" : {
          "stringUnit" : {
