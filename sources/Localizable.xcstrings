    "AdvancedSetting.activeUpdateCadence" : {
      "comment" : "Advanced setting: activeUpdateCadence",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Bildwiederholrate (FPS), wenn die adaptive Bildwiederholrate deaktiviert ist.\nHinweis: Dieser Wert wird auf ARM-Macs für Displays mit mindestens 120 Hz verdoppelt. Änderungen an dieser Einstellung wirken sich nicht auf bestehende Sitzungen aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum frame rate (FPS) when adaptive framerate is disabled.\nNote: this is doubled on ARM Macs for displays that support at least 120hz. Modifications to this setting will not affect existing sessions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートが無効な場合の最大フレームレート（FPS）。\n注: 120Hz以上に対応したディスプレイを使用しているARM Macでは、この値は2倍になります。この設定を変更しても、既存のセッションには影響しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de quadros máxima (FPS) quando a taxa de quadros adaptativa está desativada.\nObservação: isso é dobrado em Macs ARM para telas compatíveis com pelo menos 120 Hz. As alterações a esta configuração não afetam as sessões existentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная частота кадров (FPS) при отключённой адаптивной частоте кадров.\nПримечание: на компьютерах Mac с ARM это значение удваивается для дисплеев с поддержкой не менее 120 Гц. Изменения этого параметра не затрагивают уже открытые сессии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应帧率被禁用时的最大帧率（FPS）。\n注意：对于支持至少 120hz 显示器的 ARM Mac 设备，此值会翻倍。对该设置的修改不会影响现有会话"
          }
        }
      }
    },
    "AdvancedSetting.adaptiveFrameRateThroughputThreshold" : {
      "comment" : "Advanced setting: adaptiveFrameRateThroughputThreshold",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsatzschwelle für die adaptive Bildwiederholrate.\nWenn mehr als diese Anzahl an Bytes pro Sekunde empfangen wird, wird die niedrigere Bildwiederholrate von 30 fps verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Throughput threshold for adaptive frame rate.\nIf more than this many bytes per second are received, use the lower frame rate of 30 fps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートのスループットしきい値。\n1秒あたりに受信するバイト数がこの値を超えた場合、より低い30 fpsのフレームレートを使用する。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de taxa de transferência para a taxa de quadros adaptativa.\nSe forem recebidos mais bytes por segundo do que este valor, use a taxa de quadros mais baixa de 30 fps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порог пропускной способности для адаптивной частоты кадров.\nЕсли скорость приёма данных превышает это значение байт в секунду, используется более низкая частота кадров 30 fps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自适应帧率的吞吐量阈值。\n如果每秒接收的字节数超过此值，则使用较低的 30 fps 帧率"
          }
        }
      }
    },
    "AdvancedSetting.adblockListURL" : {
      "comment" : "Advanced setting: adblockListURL",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL für die Werbeblocker-Filterliste\nDies sollte eine JSON-Datei im WebKit-Content-Blocker-Format sein. Die Liste wird automatisch alle 24 Stunden heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "URL for ad blocking filter list\nThis should be a JSON file in WebKit content blocker format. The list is downloaded automatically every 24 hours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告ブロックフィルターリストのURL\nWebKitコンテンツブロッカー形式のJSONファイルである必要があります。このリストは24時間ごとに自動的にダウンロードされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL da lista de filtros de bloqueio de anúncios\nDeve ser um arquivo JSON no formato de bloqueador de conteúdo do WebKit. A lista é transferida automaticamente a cada 24 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL списка фильтров для блокировки рекламы.\nЭто должен быть файл JSON в формате блокировщика содержимого WebKit. Список автоматически загружается каждые 24 часа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "广告拦截过滤器列表的 URL。\n这应该是一个 WebKit 内容拦截器格式的 JSON 文件。该列表每 24 小时自动下载一次"
          }
        }
      }
    },
    "AdvancedSetting.addDynamicTagToDynamicProfiles" : {
      "comment" : "Advanced setting: addDynamicTagToDynamicProfiles",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt dynamischen Profilen ein Tag „Dynamic“ hinzu.\nWenn aktiviert, erhalten dynamische Profile ein Tag „Dynamic“, mit dem sie gefiltert oder identifiziert werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a 'Dynamic' tag to dynamic profiles.\nWhen enabled, dynamic profiles will have a 'Dynamic' tag added to them, which can be used to filter or identify them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動的プロファイルに「Dynamic」タグを追加する。\n有効にすると、動的プロファイルに「Dynamic」タグが追加され、フィルタリングや識別に利用できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar uma tag “Dynamic” aos perfis dinâmicos.\nQuando ativado, os perfis dinâmicos terão uma tag “Dynamic” adicionada, que pode ser usada para filtrá-los ou identificá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавлять тег «Dynamic» к динамическим профилям.\nПри включении к динамическим профилям добавляется тег «Dynamic», который можно использовать для их фильтрации или идентификации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在动态配置文件中添加‘动态’标签。\n启用后，动态配置文件将添加‘动态’标签，可用于过滤或识别它们"
          }
        }
      }
    },
    "AdvancedSetting.addTabButtonUsesCurrentProfile" : {
      "comment" : "Advanced setting: addTabButtonUsesCurrentProfile",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll die Schaltfläche „Neuer Tab“ in der Tableiste das Profil der aktuellen Sitzung verwenden?\nWenn aktiviert, öffnet ein Klick auf die Schaltfläche „+“ einen neuen Tab mit dem Profil der aktuellen Sitzung anstelle des Standardprofils."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Should the “new tab” button in the tab bar use the current session’s profile?\nWhen enabled, clicking the “+” button opens a new tab with the current session’s profile instead of the default profile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーの「新規タブ」ボタンは現在のセッションのプロファイルを使用しますか？\n有効にすると、「+」ボタンをクリックした際にデフォルトのプロファイルではなく、現在のセッションのプロファイルで新規タブが開きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão de “nova aba” na barra de abas deve usar o perfil da sessão atual?\nQuando ativado, clicar no botão “+” abre uma nova aba com o perfil da sessão atual em vez do perfil padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должна ли кнопка «новая вкладка» на панели вкладок использовать профиль текущей сессии?\nПри включении нажатие кнопки «+» открывает новую вкладку с профилем текущей сессии вместо профиля по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否应让标签页栏中的“新标签页”按钮使用当前会话的配置文件？\n如果启用，点击“+”按钮将打开一个使用当前会话配置文件的标签页，而非默认配置文件。"
          }
        }
      }
    },
