            "state" : "translated",
            "value" : "使用您的字体中的框图字符，而非iTerm2的自定义绘图代码。\n更改此设置后必须重启iTerm2。"
          }
        }
      }
    },
    "AdvancedSetting.disableDECRQCRA" : {
      "comment" : "Advanced setting: disableDECRQCRA",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DECRQCRA deaktivieren?\nMit dieser Steuersequenz kann eine im Terminal laufende Anwendung dessen Inhalt lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable DECRQCRA?\nThis control sequence allows an app running in the terminal to read its contents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DECRQCRA を無効にしますか?\nこの制御シーケンスにより、ターミナルで実行中のアプリがその内容を読み取れるようになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar DECRQCRA?\nEsta sequência de controle permite que um app em execução no terminal leia seu conteúdo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить DECRQCRA?\nЭта управляющая последовательность позволяет приложению, работающему в терминале, читать его содержимое."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用DECRQCRA功能？\n此控制序列允许在终端中运行的应用读取其内容。"
          }
        }
      }
    },
