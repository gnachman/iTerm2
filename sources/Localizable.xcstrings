        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在评估调用“%2$@”时发生超时（%1$@秒）。该超时发生在对%3$@的以下参数进行评估时：%4$@"
          }
        }
      }
    },
