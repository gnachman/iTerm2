    "Tip.0032.Body" : {
      "comment" : "Tip of the day body, id 0032",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der visuelle Signalton den gesamten Bildschirm aufblitzen lassen soll, anstatt ein Glockensymbol anzuzeigen, können Sie das unter „Einstellungen > Erweitert“ aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you want the visual bell to flash the whole screen instead of show a bell icon, you can turn that on in “Settings > Advanced.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアルベルでベルのアイコンを表示する代わりに画面全体を点滅させたい場合は、「設定 > 詳細」でオンにできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você quiser que a campainha visual pisque a tela inteira em vez de mostrar um ícone de campainha, pode ativar isso em “Ajustes > Avançado”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы хотите, чтобы визуальный сигнал вспышкой заполнял весь экран вместо показа значка колокольчика, включите это в «Настройки > Дополнительные»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您希望视觉角标在整个屏幕上闪烁，而不是显示角标图标，可以在“设置 > 高级”中开启此功能。"
          }
        }
      }
