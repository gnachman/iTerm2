          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão Diff está aguardando alterações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс Diff ожидает изменений."
          }
        },
        "zh-Hans" : {
