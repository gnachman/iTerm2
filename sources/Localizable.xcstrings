    "KeysPreferences.HotkeyPanelExplanation" : {
      "comment" : "Explanation shown in the hotkey window configuration panel",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Bedienfeld hilft Ihnen, ein neues Profil zu konfigurieren, das an eine von Ihnen zugewiesene Tastenkombination gebunden wird. Das Drücken des Hotkeys (auch wenn iTerm2 nicht aktiv ist) schaltet ein spezielles Fenster um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This panel helps you configure a new profile that will be bound to a keystroke you assign. Pressing the hotkey (even when iTerm2 is not active) will toggle a special window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパネルでは、割り当てたキーストロークにバインドされる新しいプロファイルを設定できます。ホットキーを押すと（iTerm2がアクティブでない場合でも）、特別なウインドウが表示または非表示になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este painel ajuda você a configurar um novo perfil que será associado a uma tecla que você atribuir. Pressionar a hotkey (mesmo quando o iTerm2 não está ativo) alternará uma janela especial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта панель помогает настроить новый профиль, который будет привязан к назначенному вами сочетанию клавиш. Нажатие горячей клавиши (даже если iTerm2 неактивен) переключает специальное окно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此面板可帮助你配置一个绑定到你指定的按键的新配置文件。按下热键（即使 iTerm2 未处于活跃状态）将切换一个特殊窗口。"
          }
        }
      }
    },
