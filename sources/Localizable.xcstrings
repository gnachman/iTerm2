    "PseudoTerminal.TabTitleContextMistake" : {
      "comment" : "Warning shown when a tab title interpolated string references session variables incorrectly",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese interpolierte Zeichenfolge wird im Kontext des Tabs ausgewertet, nicht im Kontext der Sitzung. Um auf Variablen der aktuellen Sitzung zuzugreifen, verwenden Sie currentSession.sessionVariableNameHere"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This interpolated string is evaluated in the tab’s context, not the session’s context. To access variables in the current session, use currentSession.sessionVariableNameHere"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この補間文字列はセッションのコンテキストではなく、タブのコンテキストで評価されます。現在のセッションの変数にアクセスするには、currentSession.sessionVariableNameHere を使用してください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta string interpolada é avaliada no contexto da aba, não no contexto da sessão. Para acessar variáveis na sessão atual, use currentSession.sessionVariableNameHere"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта интерполированная строка вычисляется в контексте вкладки, а не в контексте сеанса. Чтобы обратиться к переменным текущего сеанса, используйте currentSession.sessionVariableNameHere"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插值字符串在标签页上下文中被计算，而非会话上下文。要访问当前会话中的变量，请使用 currentSession.sessionVariableNameHere"
          }
        }
      }
    },
    "PseudoTerminal.TabTitleHelp" : {
      "comment" : "Explanatory text in the set-tab-title dialog",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dieses Feld leer ist, übernimmt der Tab den Titel der aktiven Sitzung. Variablen und Funktionsaufrufe in \\(…) werden durch ihre Auswertung ersetzt. Diese interpolierte Zeichenfolge wird im Kontext des Tabs ausgewertet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If this is empty, the tab takes the active session’s title. Variables and function calls enclosed in \\(…) will be replaced with their evaluation. This interpolated string is evaluated in the tab’s context."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これが空の場合、タブはアクティブなセッションのタイトルを使用します。\\(…) で囲まれた変数や関数呼び出しは、その評価結果に置き換えられます。この補間文字列はタブのコンテキストで評価されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver vazio, a aba assume o título da sessão ativa. Variáveis e chamadas de função entre \\(…) serão substituídas por seu resultado. Esta string interpolada é avaliada no contexto da aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это поле пустое, вкладка принимает заголовок активного сеанса. Переменные и вызовы функций, заключённые в \\(…), будут заменены результатом их вычисления. Эта интерполированная строка вычисляется в контексте вкладки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若留空，标签页将采用活动会话的标题。用 \\(…) 括起来的变量和函数调用将被替换为其计算结果。此插值字符串将在标签页的上下文中求值。"
          }
        }
      }
    },
