          "stringUnit" : {
            "state" : "translated",
            "value" : "スムーズなカーソルスライドアニメーションにおける、セル単位での最大水平移動距離。\nこれより大きなカーソル移動はアニメーションしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distância horizontal máxima em células para a animação suave de deslize do cursor.\nMovimentos do cursor maiores que isto não serão animados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальное горизонтальное расстояние в ячейках для плавной анимации скольжения курсора.\nПеремещения курсора, превышающие это значение, не будут анимироваться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
