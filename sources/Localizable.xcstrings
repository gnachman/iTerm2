    "Profiles.Window.SpacesWarning" : {
      "comment" : "Warning explaining how to configure Spaces so new windows can open in a specific space.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit ein neues Fenster in einem bestimmten Space geöffnet wird, stellen Sie sicher, dass Spaces in den Systemeinstellungen aktiviert und so konfiguriert ist, dass mit ^ Zifferntasten direkt zu einem Space gewechselt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To have a new window open in a specific space, make sure that Spaces is enabled in System Preferences and that it is configured to switch directly to a space with ^ Number Keys."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新規ウインドウを特定のスペースで開くには、システム環境設定でSpacesが有効になっており、^ 数字キーで直接スペースに切り替わるよう設定されていることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que uma nova janela abra em um espaço específico, verifique se os Espaços estão ativados nas Preferências do Sistema e configurados para alternar diretamente para um espaço com as teclas ^ Número."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы новое окно открывалось в определённом пространстве, убедитесь, что функция Spaces включена в Системных настройках и настроена на переключение непосредственно в пространство с помощью ^ Number Keys."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要让新窗口在特定空间中打开，请确保“系统设置”中启用了“空间”，并且配置为使用 ^ 数字键直接切换空间。"
          }
        }
      }
    },
    "Profiles.Window.TabTitleContextMistake" : {
