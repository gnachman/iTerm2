        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sublinhar hyperlinks OSC 8"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подчёркивать гиперссылки OSC 8"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSC 8超链接下的划线。"
          }
        }
      }
    },
    "AdvancedSetting.updateScreenParamsDelay" : {
      "comment" : "Advanced setting: updateScreenParamsDelay",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung nach Änderung der Bildschirmanzahl/-auflösung bis zur Aktualisierung (Sekunden).\nDies umgeht Betriebssystemfehler, bei denen es nach einer Bildschirmänderung eine gewisse Zeit dauert, bevor Fenster gefahrlos in der Größe geändert werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Delay after changing number of screens/resolution until refresh (seconds).\nThis works around OS bugs where it takes some time after a screen change before it is safe to resize windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面数や解像度を変更してから再描画するまでの遅延（秒）。\nこれは、画面変更後にウィンドウのサイズ変更が安全になるまで時間がかかるというOSのバグを回避するためのものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atraso após alterar o número de telas/resolução até a atualização (segundos).\nIsso contorna erros do sistema em que leva algum tempo após uma mudança de tela antes de ser seguro redimensionar janelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержка после изменения количества экранов или разрешения до обновления (в секундах).\nЭто обходит ошибки ОС, из-за которых после изменения экрана требуется время, прежде чем можно безопасно изменять размер окон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改屏幕数/分辨率后的刷新延迟时间（秒）。  \n针对操作系统中的漏洞，屏幕更换后需要一段时间才能安全调整窗口大小。"
          }
        }
      }
    },
    "AdvancedSetting.URLCharacterSet" : {
      "comment" : "Advanced setting: URLCharacterSet",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht alphanumerische Zeichen, die für die Semantic History als Teil einer URL oder eines Dateinamens gelten.\nBuchstaben und Zahlen gelten immer als Teil der URL. Diese nicht alphanumerischen Zeichen werden zusätzlich verwendet, um zu bestimmen, wo eine URL beginnt und endet. Sie müssen iTerm2 neu starten, damit Änderungen an dieser Einstellung wirksam werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Non-alphanumeric characters considered part of a URL or file name for Semantic History.\nLetters and numbers are always considered part of the URL. These non-alphanumeric characters are used in addition for the purposes of figuring out where a URL begins and ends. You must restart iTerm2 for changes to this setting to take effect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セマンティックヒストリーでURLまたはファイル名の一部とみなす英数字以外の文字。\n文字と数字は常にURLの一部とみなされます。これらの英数字以外の文字は、URLの開始位置と終了位置を判断するために追加で使用されます。この設定の変更を反映させるにはiTerm2を再起動する必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres não alfanuméricos considerados parte de uma URL ou nome de arquivo para o Semantic History.\nLetras e números são sempre considerados parte da URL. Estes caracteres não alfanuméricos são usados adicionalmente para determinar onde uma URL começa e termina. Você precisa reiniciar o iTerm2 para que as alterações desta configuração tenham efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неалфавитно-цифровые символы, которые считаются частью URL-адреса или имени файла для функции «Смысловая история».\nБуквы и цифры всегда считаются частью URL-адреса. Эти неалфавитно-цифровые символы дополнительно используются для определения начала и конца URL-адреса. Чтобы изменения этого параметра вступили в силу, перезапустите iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非字母数字字符被视为URL或文件名的一部分，用于语义历史功能。  \n字母和数字始终视为URL的一部分。这些非字母数字字符还用于确定URL的起始和结束位置。必须重启iTerm2才能使此设置生效。"
          }
        }
      }
    },
    "AdvancedSetting.URLCharacterSetExclusions" : {
      "comment" : "Advanced setting: URLCharacterSetExclusions",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen, die niemals als Teil einer URL gelten.\nDie Zeichen in dieser Zeichenfolge dürfen niemals in einer URL vorkommen; wird eines davon erkannt, markiert es den Anfang oder das Ende einer URL."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Characters never considered part of a URL.\nThe characters in this string may never occur in a URL; when one is seen that delineates the beginning or end of a URL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URLの一部として決してみなされない文字。\nこの文字列に含まれる文字はURL中に現れることがないため、見つかった場合はURLの開始または終了の区切りとみなされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caracteres nunca considerados parte de uma URL.\nOs caracteres nesta string nunca podem ocorrer em uma URL; quando um deles aparece, ele delimita o início ou o fim de uma URL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символы, которые никогда не считаются частью URL-адреса.\nСимволы в этой строке никогда не встречаются в URL-адресе; когда такой символ обнаружен, он обозначает начало или конец URL-адреса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永远不会被视为URL字符的字符。  \n该字符串中的字符可能永远不会出现在URL中；当出现此类字符时，表示URL的起始或结束。"
          }
        }
      }
    },
    "AdvancedSetting.urlHandlerCommand" : {
      "comment" : "Advanced setting: urlHandlerCommand",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl, der beim Öffnen einer angeklickten URL ausgeführt wird, statt das Betriebssystem darum zu bitten, sie zu öffnen.\nWenn nicht leer, läuft dieser Befehl als stille Hintergrundaufgabe über /bin/sh -c, sobald Sie eine URL anklicken (einschließlich OSC-8-Hyperlinks und automatisch erkannter URLs), die iTerm2 andernfalls an das System übergeben würde. Dies ist eine interpolierte Zeichenfolge; verwenden Sie \\(url) für die URL und \\(background) dafür, ob ein Öffnen im Hintergrund angefordert wurde (1, wenn beim Klicken die Wahltaste gedrückt gehalten wurde, sonst 0). Der Befehl ist dafür verantwortlich, die URL nach Belieben zu öffnen (z. B. „open -g \\(url)“, um im Hintergrund zu öffnen). Wenn leer, werden URLs normal geöffnet. iTerm2-interne Schemata (iterm2:), einem Profil zugeordnete URL-Schemata und Dateilinks der Semantic History sind davon nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to run when opening a clicked URL, instead of asking the OS to open it.\nWhen non-empty, this command runs as a silent background task via /bin/sh -c whenever you click a URL (including OSC 8 hyperlinks and auto-detected URLs) that iTerm2 would otherwise hand to the system. This is an interpolated string; use \\(url) for the URL and \\(background) for whether a background open was requested (1 if you held option while clicking, otherwise 0). The command is responsible for opening the URL however it likes (e.g., “open -g \\(url)” to open in the background). When empty, URLs open normally. iTerm2-internal schemes (iterm2:), URL schemes bound to a profile, and Semantic History file links are not affected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリックしたURLを開く際に、OSに開かせる代わりに実行するコマンド。\n空でない場合、iTerm2がシステムに渡すはずだったURL（OSC 8ハイパーリンクや自動検出されたURLを含む）をクリックするたびに、このコマンドが/bin/sh -c経由でサイレントなバックグラウンドタスクとして実行されます。これは補間文字列であり、URLには\\(url)を、バックグラウンドで開くことが要求されたかどうか（クリック時にoptionキーを押していた場合は1、それ以外は0）には\\(background)を使用します。このコマンドは、好きな方法でURLを開く責任を負います（例えば、バックグラウンドで開くには「open -g \\(url)」など）。空の場合、URLは通常どおり開きます。iTerm2内部のスキーム（iterm2:）、プロファイルに紐付けられたURLスキーム、およびセマンティックヒストリーのファイルリンクには影響しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando a executar ao abrir uma URL clicada, em vez de pedir ao sistema para abri-la.\nQuando não vazio, este comando é executado como uma tarefa silenciosa em segundo plano via /bin/sh -c sempre que você clica em uma URL (incluindo hyperlinks OSC 8 e URLs detectadas automaticamente) que o iTerm2 normalmente entregaria ao sistema. Esta é uma string interpolada; use \\(url) para a URL e \\(background) para indicar se uma abertura em segundo plano foi solicitada (1 se você segurou option ao clicar, caso contrário 0). O comando é responsável por abrir a URL como preferir (por exemplo, “open -g \\(url)” para abrir em segundo plano). Quando vazio, as URLs abrem normalmente. Esquemas internos do iTerm2 (iterm2:), esquemas de URL vinculados a um perfil e links de arquivos do Semantic History não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда, которая выполняется при открытии URL по клику, вместо того чтобы поручать это ОС.\nЕсли задано, эта команда выполняется как тихая фоновая задача через /bin/sh -c при каждом клике по URL (включая гиперссылки OSC 8 и автоматически распознанные URL), который иначе iTerm2 передал бы системе. Это интерполированная строка; используйте \\(url) для URL и \\(background) для указания, был ли запрошен фоновый режим открытия (1, если при клике удерживалась клавиша Option, иначе 0). Команда сама отвечает за то, как открыть URL (например, «open -g \\(url)» откроет его в фоновом режиме). Если поле пустое, URL открываются как обычно. Это не затрагивает внутренние схемы iTerm2 (iterm2:), схемы URL, привязанные к профилю, и ссылки на файлы Semantic History."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击URL后运行的命令，而非让操作系统打开它。  \n当该值为非空时，每次点击URL（包括OSC 8超链接和自动检测到的URL）都会通过 /bin/sh -c 作为静默后台任务运行此命令。这是插值字符串；使用 \\(url) 表示URL，\\(background) 表示是否请求后台打开（按选项键点击时为1，否则为0）。该命令可按照任意方式打开URL（例如“open -g \\(url)”在后台打开）。当为空时，URL正常打开。iTerm2内部协议、绑定到配置文件的URL协议以及语义历史文件链接不受影响。"
          }
        }
      }
    },
    "AdvancedSetting.useAdaptiveFrameRate" : {
      "comment" : "Advanced setting: useAdaptiveFrameRate",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptive Bildwiederholrate verwenden.\nBei geringem Durchsatz wird der Bildschirm mit 60 Bildern pro Sekunde aktualisiert. Bei höherem Durchsatz sinkt sie auf eine konfigurierbare Rate (standardmäßig 15 fps)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use adaptive framerate.\nWhen throughput is low, the screen will update at 60 frames per second. When throughput is higher, it will drop to a configurable rate (15 fps by default)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アダプティブフレームレートを使用します。\nスループットが低い場合、画面は毎秒60フレームで更新されます。スループットが高い場合は、設定可能なレート（デフォルトは15fps）まで低下します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar taxa de quadros adaptável.\nQuando a vazão é baixa, a tela será atualizada a 60 quadros por segundo. Quando a vazão é maior, ela cairá para uma taxa configurável (15 fps por padrão)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать адаптивную частоту кадров.\nПри низкой пропускной способности экран будет обновляться с частотой 60 кадров в секунду. При более высокой пропускной способности частота снизится до настраиваемого значения (по умолчанию 15 кадров в секунду)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用自适应帧率。  \n当吞吐量较低时，屏幕以每秒60帧更新；当吞吐量较高时，可降至可配置速率（默认15 fps）。"
          }
        }
      }
    },
    "AdvancedSetting.useBlackFillerColorForTmuxInFullScreen" : {
      "comment" : "Advanced setting: useBlackFillerColorForTmuxInFullScreen",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwarz für den Füllbereich in tmux-Fenstern im Vollbildmodus verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use black for filler area in tmux windows in full screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーン時のtmuxウィンドウの余白部分に黒を使用します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar preto para a área de preenchimento em janelas do tmux em tela cheia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать чёрный цвет для заполняющей области в окнах tmux в полноэкранном режиме."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
