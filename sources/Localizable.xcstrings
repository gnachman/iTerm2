    "NaggingController.MouseReportingFrustration" : {
      "comment" : "Prompt asking whether to disable mouse reporting when it blocks selection",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieht so aus, als würden Sie versuchen, etwas in die Zwischenablage zu kopieren, aber die Mausberichterstattung hat die Auswahl verhindert. Mausberichterstattung deaktivieren?"
