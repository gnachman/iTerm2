    "Tip.0069.Body" : {
      "comment" : "Tip of the day body, id 0069",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in 3.1: Sie können mehrere Hotkey-Fenster verwenden. Jedes Profil kann einen oder mehrere Hotkeys besitzen."
          }
        },
        "en" : {
          "stringUnit" : {
