    "PTYSession.SusLocaleWarning" : {
      "comment" : "Warning that a profile’s locale does not use UTF-8 while the profile does",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung! Dieses Profil verwendet ein benutzerdefiniertes Gebietsschema, das nicht UTF-8 als Zeichenkodierung nutzt, aber Ihr Profil verwendet *tatsächlich* UTF-8. Dies kann dazu führen, dass Fehlermeldungen und Nicht-ASCII-Text falsch dargestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning! This profile uses a custom locale that doesn't use UTF-8 as its character encoding, but your profile *is* using UTF-8. This can cause error messages and non-ASCII text to appear wrong."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！このプロファイルは文字エンコーディングにUTF-8を使用しないカスタムロケールを使用していますが、あなたのプロファイルは*実際に*UTF-8を使用しています。これにより、エラーメッセージや非ASCII文字が正しく表示されないことがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso! Este perfil usa uma configuração regional personalizada que não usa UTF-8 como codificação de caracteres, mas seu perfil *está* usando UTF-8. Isso pode fazer com que mensagens de erro e texto não ASCII apareçam incorretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание! Этот профиль использует собственную локаль, которая не использует UTF-8 в качестве кодировки символов, но ваш профиль *использует* UTF-8. Это может привести к неправильному отображению сообщений об ошибках и текста, не входящего в ASCII."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此配置文件使用的自定义语言环境不使用 UTF-8 作为字符编码，但你的配置文件*确实*使用 UTF-8。这可能导致错误消息和非 ASCII 文本显示异常。"
          }
        }
      }
    },
