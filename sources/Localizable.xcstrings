        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストボードにコピーしようとしているようですが、マウスレポートが有効なため選択できないようです。マウスレポートを無効にしますか?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está tentando copiar para a área de transferência, mas o relatório do mouse impediu a seleção. Desativar o relatório do mouse?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы пытаетесь скопировать текст в буфер обмена, но отчёты о мыши мешают сделать выделение. Отключить отчёты о мыши?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来你想拷贝到剪贴板，但鼠标报告功能阻止了选区操作。要停用鼠标报告吗？"
          }
        }
