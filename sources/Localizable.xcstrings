            "state" : "translated",
            "value" : "Larguras de aba desiguais permitidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешена неравномерная ширина вкладок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
