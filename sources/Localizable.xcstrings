    "Tip.0074.Body" : {
      "comment" : "Tip of the day body, id 0074",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probieren Sie die Designs „Minimal“ und „Kompakt“ aus, um optische Unordnung zu reduzieren. Sie können dies unter „Einstellungen > Erscheinungsbild > Allgemein“ einstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try the “Minimal” and “Compact” themes to reduce visual clutter. You can set it in “Settings > Appearance > General.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視覚的な煩雑さを減らすには、「ミニマル」や「コンパクト」テーマを試してみてください。「設定 > 外観 > 一般」で設定できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente os temas “Minimalista” e “Compacto” para reduzir a poluição visual. Você pode defini-los em “Ajustes > Aparência > Geral”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте темы «Минимальная» и «Компактная», чтобы уменьшить визуальный беспорядок. Настроить это можно в «Настройки > Внешний вид > Общие»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试使用“极简”和“紧凑”主题以减少视觉干扰。您可以在“设置 > 外观 > 通用”中进行配置。"
          }
        }
      }
    },
