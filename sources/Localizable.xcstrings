          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A campainha está tocando muito. Deseja suprimir toda a saída até as coisas se acalmarem?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звонок звучит слишком часто. Подавить весь вывод, пока всё не успокоится?"
