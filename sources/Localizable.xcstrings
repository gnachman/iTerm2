      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie ausgeprägt sollen Split-Pane-Trennlinien im Design „Minimal“ sein?\nWert zwischen 0 und 1, wobei 0 unsichtbar und 1 sehr ausgeprägt ist"
