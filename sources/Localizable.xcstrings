    "Tip.0123.Body" : {
      "comment" : "Tip of the day body, id 0123",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie über die SSH-Integration verbunden sind, verwenden Sie „Shell > ssh > Dateien herunterladen“, um Dateien vom entfernten Host zu durchsuchen und herunterzuladen, ohne eine neue Verbindung zu öffnen. Dateien auf SSH-Hosts erscheinen auch in Dialogen zum Öffnen/Speichern von Dateien!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When connected via SSH Integration, use “Shell > ssh > Download Files” to browse and download files from the remote host without opening a new connection. Files on SSH hosts also appear in file open/save dialogs!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH統合で接続している場合、「シェル > ssh > ファイルをダウンロード」を使うと、新しい接続を開かずにリモートホストのファイルを参照・ダウンロードできます。SSHホスト上のファイルは、ファイルを開く/保存するダイアログにも表示されます！"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando conectado via SSH Integration, use “Shell > ssh > Download Files” para navegar e transferir arquivos do host remoto sem abrir uma nova conexão. Arquivos em hosts SSH também aparecem nas caixas de diálogo de abrir/salvar arquivos!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При подключении через интеграцию с SSH используйте «Оболочка > ssh > Скачать файлы», чтобы просматривать и скачивать файлы с удалённого узла без открытия нового соединения. Файлы на SSH-узлах также отображаются в диалогах открытия и сохранения файлов!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当通过SSH集成连接时，使用“Shell > ssh > 下载文件”功能可以在不打开新连接的情况下浏览和下载远程主机上的文件。SSH主机上的文件也会出现在文件打开/保存对话框中！"
          }
        }
      }
    },
