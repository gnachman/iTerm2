    "WorkgroupDetail.WhatIsExplanation" : {
      "comment" : "Explanatory markdown shown when the user asks what a Workgroup is",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine **Arbeitsgruppe** verwandelt eine einzelne Sitzung in eine koordinierte Gruppe zusammengehöriger Sitzungen, jede mit eigenem Befehl und eigener Symbolleiste; die vollständige Beschreibung finden Sie in der [Dokumentation zu Arbeitsgruppen](https://iterm2.com/documentation-workgroups.html)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A **Workgroup** turns a single session into a coordinated set of related sessions, each with its own command and toolbar; see the [Workgroups documentation](https://iterm2.com/documentation-workgroups.html) for the full story."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ワークグループ**は、単一のセッションを、それぞれ独自のコマンドとツールバーを持つ一連の関連セッションへとまとめます。詳しくは[ワークグループのドキュメント](https://iterm2.com/documentation-workgroups.html)をご覧ください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um **grupo de trabalho** transforma uma única sessão em um conjunto coordenado de sessões relacionadas, cada uma com seu próprio comando e barra de ferramentas; consulte a [documentação de grupos de trabalho](https://iterm2.com/documentation-workgroups.html) para a história completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Рабочая группа** превращает один сеанс в согласованный набор связанных сеансов, каждый из которых имеет свою команду и панель инструментов; подробности см. в [документации о рабочих группах](https://iterm2.com/documentation-workgroups.html)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个**工作组**可以将单个会话转换为一组相关的会话，每个会话都有自己的命令和工具栏；详情请参阅[工作组文档](https://iterm2.com/documentation-workgroups.html))。"
          }
        }
      }
    },
