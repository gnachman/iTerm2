    "AdvancedSetting.badgeMaxHeightFraction" : {
      "comment" : "Advanced setting: badgeMaxHeightFraction",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Höhe des Badges\nAls Anteil der Höhe des Terminals, zwischen 0 und 1,0. Dies ist der Standardwert, wenn ein Profil keine Einstellung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum height of the badge\nAs a fraction of the height of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジの最大高さ\nターミナルの高さに対する割合で指定します (0 から 1.0)。プロファイルに設定がない場合のデフォルト値です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altura máxima do selo\nComo uma fração da altura do terminal, entre 0 e 1.0. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная высота плашки\nВ виде доли высоты терминала, от 0 до 1,0. Это значение по умолчанию, если оно не задано в профиле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角标的最大高度\n以终端高度的百分比表示，范围为0到1.0。若配置文件未设置该值，则采用此默认值。"
          }
        }
      }
    },
    "AdvancedSetting.badgeMaxWidthFraction" : {
      "comment" : "Advanced setting: badgeMaxWidthFraction",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Breite des Badges\nAls Anteil der Breite des Terminals, zwischen 0 und 1,0. Dies ist der Standardwert, wenn ein Profil keine Einstellung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum width of the badge\nAs a fraction of the width of the terminal, between 0 and 1.0. This is the default value if a profile does not have a setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジの最大幅\nターミナルの幅に対する割合で指定します (0 から 1.0)。プロファイルに設定がない場合のデフォルト値です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura máxima do selo\nComo uma fração da largura do terminal, entre 0 e 1.0. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимальная ширина плашки\nВ виде доли ширины терминала, от 0 до 1,0. Это значение по умолчанию, если оно не задано в профиле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角标的最大宽度\n以终端宽度的百分比表示，范围为0到1.0。若配置文件未设置该值，则采用此默认值。"
          }
        }
      }
    },
    "AdvancedSetting.badgeRightMargin" : {
      "comment" : "Advanced setting: badgeRightMargin",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardwert für den rechten Rand des Badges\nWie viel Platz zwischen dem rechten Rand des Badges und dem rechten Rand des Terminals gelassen werden soll. Kann durch eine Profileinstellung überschrieben werden. Dies ist der Standardwert, wenn ein Profil keine Einstellung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default value for right margin for the badge\nHow much space to leave between the right edge of the badge and the right edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジの右マージンのデフォルト値\nバッジの右端とターミナルの右端の間に空ける余白の量です。プロファイルの設定で上書きできます。プロファイルに設定がない場合のデフォルト値です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor padrão para a margem direita do selo\nQuanto espaço deixar entre a borda direita do selo e a borda direita do terminal. Pode ser substituído por um ajuste de perfil. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение по умолчанию для правого отступа плашки\nКакое расстояние оставлять между правым краем плашки и правым краем терминала. Может быть переопределено настройкой профиля. Это значение по умолчанию, если оно не задано в профиле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角标右边缘的默认间距\n即角标与终端右侧边缘之间的空间距离。可通过配置文件设置调整，若配置文件未设置，则采用此默认值。"
          }
        }
      }
    },
    "AdvancedSetting.badgeTopMargin" : {
      "comment" : "Advanced setting: badgeTopMargin",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardwert für den oberen Rand des Badges\nWie viel Platz zwischen dem oberen Rand des Badges und dem oberen Rand des Terminals gelassen werden soll. Kann durch eine Profileinstellung überschrieben werden. Dies ist der Standardwert, wenn ein Profil keine Einstellung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Default value for the top margin for the badge\nHow much space to leave between the top edge of the badge and the top edge of the terminal. Can be overridden by a profile setting. This is the default value if a profile does not have a setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッジの上マージンのデフォルト値\nバッジの上端とターミナルの上端の間に空ける余白の量です。プロファイルの設定で上書きできます。プロファイルに設定がない場合のデフォルト値です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valor padrão para a margem superior do selo\nQuanto espaço deixar entre a borda superior do selo e a borda superior do terminal. Pode ser substituído por um ajuste de perfil. Este é o valor padrão se um perfil não tiver um ajuste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значение по умолчанию для верхнего отступа плашки\nКакое расстояние оставлять между верхним краем плашки и верхним краем терминала. Может быть переопределено настройкой профиля. Это значение по умолчанию, если оно не задано в профиле."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "徽章顶部边缘的默认值  \n徽章顶部边缘与终端顶部边缘之间的间距。可通过配置文件设置覆盖此值。若未配置配置文件，则采用默认值。"
          }
        }
      }
    },
    "AdvancedSetting.bellRateLimit" : {
      "comment" : "Advanced setting: bellRateLimit",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestzeit zwischen Signalton oder Bildschirmblitz bei einem Klingelzeichen, in Sekunden.\nWenn das Zeitintervall zwischen Klingelzeichen kürzer als dieser Wert ist, wird es ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Minimum time between beeping or flashing screen on bell, in seconds.\nIf the time interval between bells is less than this amount of time, it will be ignored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベル時にビープ音を鳴らしたり画面を点滅させたりする間隔の最小時間 (秒単位)。\nベルの間隔がこの時間より短い場合、無視されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo mínimo entre bipes ou piscadas da tela na campainha, em segundos.\nSe o intervalo de tempo entre campainhas for menor que este período, ela será ignorada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимальное время между звуковым сигналом или миганием экрана при сигнале колокольчика, в секундах.\nЕсли интервал между сигналами меньше этого значения, он будет проигнорирован."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "铃声或屏幕闪烁之间的最小时间（秒）。  \n若铃声间隔小于此值，则会被忽略。"
          }
        }
      }
    },
    "AdvancedSetting.bootstrapDaemon" : {
      "comment" : "Advanced setting: bootstrapDaemon",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass Sitzungen ein Ab- und wieder Anmelden überstehen.\nDies bricht den „auth sufficient pam_tid.so“-Hack, den manche Leute verwenden, damit sudo sich per Touch ID authentifizieren kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow sessions to survive logging out and back in.\nThis breaks the “auth sufficient pam_tid.so” hack some people use to allow sudo to authenticate with Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウトして再度ログインしてもセッションを保持できるようにします。\nこれにより、一部のユーザーが sudo を Touch ID で認証させるために使っている「auth sufficient pam_tid.so」というハックが機能しなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que sessões sobrevivam ao logout e login novamente.\nIsso quebra o truque “auth sufficient pam_tid.so” que algumas pessoas usam para permitir que o sudo autentique com Touch ID."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить сессиям переживать выход из системы и повторный вход.\nЭто нарушает хак «auth sufficient pam_tid.so», которым некоторые пользуются, чтобы разрешить sudo аутентификацию по Touch ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许会话在登出后重新登录时继续运行。  \n此设置可解除部分用户使用的“auth sufficient pam_tid.so”技巧，该技巧用于允许sudo通过Touch ID认证。"
          }
        }
      }
    },
    "AdvancedSetting.bordersOnlyInLightMode" : {
      "comment" : "Advanced setting: bordersOnlyInLightMode",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undurchsichtige Fenster haben nur im hellen Modus einen Rahmen.\nDiese Einstellung ändert „Rahmen um Fenster anzeigen“. Rahmen bei undurchsichtigen Fenstern im dunklen Modus sehen unschön aus, und das Betriebssystem zeichnet ohnehin einen brauchbaren Rahmen. Aktivieren Sie dies, wenn Sie Schwierigkeiten haben, sie zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opaque windows have a border only in light mode.\nThis setting modifies “Show border around windows”. Borders in opaque windows in dark mode are ugly and the OS draws one that is pretty serviceable. Enable this if you have trouble seeing them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明なウィンドウは、ライトモードのときのみ境界線を表示します。\nこの設定は「ウィンドウの周囲に境界線を表示」を変更します。ダークモードの不透明なウィンドウの境界線は見た目が悪く、OS が描画するもので十分実用的です。境界線が見えにくい場合はこれを有効にしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas opacas têm borda apenas no modo claro.\nEste ajuste modifica “Mostrar borda ao redor das janelas”. Bordas em janelas opacas no modo escuro são feias e o sistema desenha uma que é bastante útil. Ative isto se tiver dificuldade em vê-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непрозрачные окна имеют рамку только в светлом режиме.\nЭта настройка изменяет «Показывать рамку вокруг окон». Рамки у непрозрачных окон в тёмном режиме выглядят некрасиво, а ОС и так рисует вполне приемлемую рамку. Включите это, если вам трудно их разглядеть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不透明窗口在亮色模式下仅有边框。  \n此设置修改“显示窗口边框”选项。暗色模式下的不透明窗口边框会显得丑陋，操作系统会自动绘制一个美观的边框。若难以看到边框，可启用此选项。"
          }
        }
      }
    },
