    "TmuxController.NotUTF8Message" : {
      "comment" : "Error explaining that tmux must be run in UTF-8 mode",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux befindet sich nicht im UTF-8-Modus. Bitte übergeben Sie das Kommandozeilenargument -u an tmux oder ändern Sie Ihre Umgebungsvariable LANG so, dass sie mit „.UTF-8“ endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "tmux is not in UTF-8 mode. Please pass the -u command line argument to tmux or change your LANG environment variable to end with “.UTF-8”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxがUTF-8モードになっていません。tmuxに-uコマンドライン引数を渡すか、LANG環境変数の末尾を「.UTF-8」に変更してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tmux não está no modo UTF-8. Passe o argumento de linha de comando -u para o tmux ou altere sua variável de ambiente LANG para terminar com “.UTF-8”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux работает не в режиме UTF-8. Передайте tmux аргумент командной строки -u или измените переменную окружения LANG так, чтобы она заканчивалась на «.UTF-8»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 未处于 UTF-8 模式。请向 tmux 传递 -u 命令行参数，或将你的 LANG 环境变量改为以“.UTF-8”结尾。"
          }
        }
      }
    },
