          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar “Buscar URLs”, estender os resultados através de fronteiras suaves como divisores de painel do tmux."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании «Найти URL» расширять результаты через мягкие границы, такие как разделители панелей tmux."
          }
