    "PTYSession.SlowTmuxResponseBody" : {
      "comment" : "Warning that tmux is slow to respond and how to adjust the line terminator setting",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es dauert lange, bis tmux antwortet. Wenn es sich um ein altes oder ungewöhnliches System handelt, erwartet es zum Beenden von Befehlen möglicherweise einen Zeilenumbruch (Newline) statt eines Wagenrücklaufs (Carriage Return). Sie können das von der tmux-Integration verwendete Zeilenende in den Einstellungen anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's taking a long time for tmux to respond. If this is a old or funky system it might expect newline rather than carriage return to end commands. You can adjust the line terminator used by tmux integration in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxの応答に時間がかかっています。古い、あるいは癖のあるシステムでは、コマンドの終端にキャリッジリターンではなく改行を必要とする場合があります。tmux統合で使用する行末文字は設定で調整できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tmux está demorando muito para responder. Se este for um sistema antigo ou peculiar, ele pode esperar um caractere de nova linha em vez de retorno de carro para encerrar comandos. Você pode ajustar o terminador de linha usado pela integração do tmux nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux слишком долго не отвечает. Если это старая или нестандартная система, она может ожидать перевод строки вместо возврата каретки для завершения команд. Символ окончания строки, используемый интеграцией с tmux, можно изменить в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux 响应时间过长。如果这是较旧或异常的系统，它可能期望用换行符而非回车符结束命令。你可以在设置中调整 tmux 集成使用的行终止符。"
          }
        }
      }
    },
    "PTYSession.SlowTmuxResponseHeading" : {
      "comment" : "Heading for a warning that tmux is slow to respond",
      "extractionState" : "stale",
      "localizations" : {
