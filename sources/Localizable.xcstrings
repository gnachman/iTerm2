          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura mínima da aba ao usar larguras de abas desiguais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимальная ширина вкладки при использовании неравномерной ширины вкладок."
          }
