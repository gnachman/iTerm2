    "Tip.0068.Body" : {
      "comment" : "Tip of the day body, id 0068",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu in 3.1: Sie können Ihr Hotkey-Fenster so konfigurieren, dass es über den Vollbildfenstern anderer Apps erscheint. Aktivieren Sie „Schwebendes Fenster“ unter „Einstellungen > Profile > Tasten > Hotkey-Fenster anpassen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New in 3.1: You can configure your hotkey window to appear over other apps’ full screen windows. Turn on “Floating Window” in “Settings > Profiles > Keys > Customize Hotkey Window.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1の新機能: ホットキーウィンドウを他のアプリのフルスクリーンウィンドウの上に表示するよう設定できます。「設定 > プロファイル > キー > ホットキーウィンドウをカスタマイズ」で「フローティングウィンドウ」をオンにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novidade na 3.1: você pode configurar sua janela de atalho para aparecer sobre as janelas de tela cheia de outros apps. Ative “Janela flutuante” em “Ajustes > Perfis > Teclas > Personalizar janela de atalho”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое в 3.1: вы можете настроить окно горячих клавиш так, чтобы оно появлялось поверх полноэкранных окон других приложений. Включите «Плавающее окно» в «Настройки > Профили > Клавиши > Настроить окно горячих клавиш»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3.1新功能：你可以将热键窗口配置为在其他应用程序全屏窗口上方显示。在“设置 > 配置文件 > 按键 > 自定义热键窗口”中开启“浮动窗口”选项。"
          }
        }
      }
    },
