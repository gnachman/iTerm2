            "value" : "Adicione estes ajustes ao perfil chamado “%1$@” em “%2$@”:\n%3$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте следующие настройки в профиль с именем «%1$@» в «%2$@»:\n%3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
