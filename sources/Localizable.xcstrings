    "AdvancedSetting.viewManPageCommand" : {
      "comment" : "Advanced setting: viewManPageCommand",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl zum Anzeigen von Man-Pages.\nWird verwendet, wenn Sie die Man-Page-Schaltfläche auf der Touch Bar drücken. %@ wird durch den Befehl ersetzt. Beenden Sie den Befehl mit &, um zu verhindern, dass sich ein iTerm2-Fenster öffnet (z. B. wenn Sie einen externen Viewer starten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Command to view man pages.\nUsed when you press the man page button on the touch bar. %@ is replaced with the command. End the command with & to avoid opening an iTerm2 window (e.g., if you're launching an external viewer)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "manページを表示するためのコマンド。\nTouch Barのmanページボタンを押したときに使用されます。%@はコマンドに置き換えられます。iTerm2のウィンドウが開かないようにするには、コマンドの末尾に&を付けてください（外部ビューアーを起動する場合など）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando para visualizar páginas de manual.\nUsado quando você pressiona o botão de página de manual na touch bar. %@ é substituído pelo comando. Termine o comando com & para evitar abrir uma janela do iTerm2 (por exemplo, se você estiver iniciando um visualizador externo)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда для просмотра man-страниц.\nИспользуется при нажатии кнопки man-страницы на Touch Bar. %@ заменяется командой. Завершите команду знаком &, чтобы избежать открытия окна iTerm2 (например, если вы запускаете внешнюю программу просмотра)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看 man 页面命令。\n当点击触摸栏上的 man 页面按钮时使用。%@ 被替换为命令，以 & 结束命令可避免打开 iTerm2 窗口（例如，如果正在启动外部查看器）。"
          }
        }
      }
    },
