    "AdvancedSetting.autologAppends" : {
      "comment" : "Advanced setting: autologAppends",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Sitzungsprotokollierung hängt an vorhandene Dateien an.\nWenn auf „Nein“ gesetzt, wird die Datei stattdessen überschrieben."
          }
        },
        "en" : {
