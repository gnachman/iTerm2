    "AdvancedSetting.translateScreenToXterm" : {
      "comment" : "Advanced setting: translateScreenToXterm",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screen unterstützen\nInsbesondere behebt dies, dass Kursivschrift invertierten Text ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Support TERM=screen\nMost notably, this fixes italics replacing inverse text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TERM=screenをサポート\n特に、イタリック体が反転表示の代わりに使われる問題を修正します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suportar TERM=screen\nMais notavelmente, isso corrige o itálico substituindo o texto invertido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержка TERM=screen\nВ первую очередь это исправляет замену инверсного текста курсивом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持TERM=screen  \n最显著的是，这解决了反斜线文本的斜体问题。"
          }
        }
      }
    },
    "AdvancedSetting.triggerRadius" : {
      "comment" : "Advanced setting: triggerRadius",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der Bildschirmzeilen, die gegen die regulären Ausdrücke der Trigger abgeglichen werden.\nReguläre Ausdrücke von Triggern werden gegen die letzte logische Textzeile abgeglichen, wenn ein Zeilenumbruch empfangen wird. Es wird eine Suche durchgeführt, um den Anfang der Zeile zu finden. Da sehr lange Zeilen Leistungsprobleme verursachen würden, ist die Suche (und damit der Abgleich des regulären Ausdrucks, das Hervorheben usw.) auf diese Anzahl von Bildschirmzeilen begrenzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Number of screen lines to match against trigger regular expressions.\nTrigger regular expressions are matched against the last logical line of text when a newline is received. A search is performed to find the start of the line. Since very long lines would cause performance problems, the search (and consequently the regular expression match, highlighting, and so on) is limited to this many screen lines."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーの正規表現と照合する画面行数。\n改行を受け取ると、トリガーの正規表現は最後の論理行のテキストと照合されます。行の先頭を見つけるために検索が行われます。非常に長い行はパフォーマンスの問題を引き起こすため、この検索（したがって正規表現の照合、ハイライト表示なども含む）は指定した画面行数までに制限されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de linhas de tela a comparar com as expressões regulares de gatilho.\nAs expressões regulares de gatilho são comparadas com a última linha lógica de texto quando uma quebra de linha é recebida. Uma busca é realizada para encontrar o início da linha. Como linhas muito longas causariam problemas de desempenho, a busca (e consequentemente a correspondência da expressão regular, o realce e assim por diante) é limitada a esta quantidade de linhas de tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество экранных строк, которые нужно сопоставлять с регулярными выражениями триггеров.\nРегулярные выражения триггеров сопоставляются с последней логической строкой текста при получении символа новой строки. Выполняется поиск начала строки. Поскольку очень длинные строки могут привести к проблемам с производительностью, поиск (а вместе с ним и сопоставление регулярного выражения, подсветка и так далее) ограничен этим числом экранных строк."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与触发正则表达式匹配的屏幕行数。  \n当收到换行符时，触发正则表达式会匹配最后逻辑文本行。进行搜索以定位行的开始位置。由于非常长的行会导致性能问题，搜索（以及相应的正则表达式匹配、高亮显示等）限制在这几行屏幕内。"
          }
        }
      }
    },
