    "LastPass.CannotFindCLIMessage" : {
      "comment" : "Alert body when the LastPass CLI cannot be found",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die LastPass-Integration zu verwenden, muss iTerm2 wissen, wo sich die CLI-App namens „lpass“ befindet. Wählen Sie „Suchen“, um den Speicherort anzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
