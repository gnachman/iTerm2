    "Tip.0057.Body" : {
      "comment" : "Tip of the day body, id 0057",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Bearbeiten > Auswahl berücksichtigt weiche Grenzen“, damit Trennlinien geteilter Bereiche in Programmen wie vi, emacs und tmux erkannt werden, sodass Sie mehrere Textzeilen auswählen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on “Edit > Selection Respects Soft Boundaries” to recognize split pane dividers in programs like vi, emacs, and tmux so you can select multiple lines of text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「編集 > 選択範囲でソフト境界を考慮」をオンにすると、vi、emacs、tmuxなどのプログラムで分割ペインの区切りを認識できるようになり、複数行のテキストを選択できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Editar > A seleção respeita limites flexíveis” para reconhecer divisórias de painéis em programas como vi, emacs e tmux, permitindo selecionar várias linhas de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Правка > Выделение учитывает мягкие границы», чтобы распознавать разделители панелей в таких программах, как vi, emacs и tmux, и выделять несколько строк текста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“编辑 > 选择遵循软边界”以识别 vi、emacs 和 tmux 等程序中的分屏窗格分隔线，从而可以选择多行文本。"
          }
        }
      }
    },
