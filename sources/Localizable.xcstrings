    "AIManualModels.ToggleEconomyModel" : {
      "comment" : "Tooltip for the toggle economy model button",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparmodell umschalten. Ein günstigeres Modell, das für häufige Hintergrundaufgaben wie Sicherheitsprüfungen von Befehlen und die Erkennung von Bildschirm-Leerlauf verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toggle Economy Model. A cheaper model used for frequent background jobs like command-safety checks and screen-idle detection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エコノミーモデルを切り替えます。コマンドの安全性チェックや画面のアイドル検出など、頻繁に実行されるバックグラウンド処理に使用される、より安価なモデルです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternar modelo econômico. Um modelo mais barato usado em tarefas frequentes em segundo plano, como verificações de segurança de comandos e detecção de tela ociosa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключить статус «экономичная модель». Более дешёвая модель, используемая для частых фоновых задач, таких как проверка безопасности команд и определение простоя экрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换经济模型。一种更便宜的模型，用于频繁的后台任务，例如命令安全检查与屏幕空闲检测。"
          }
        }
      }
    },
