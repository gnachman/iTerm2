    "AdvancedSetting.hdrCursor" : {
      "comment" : "Advanced setting: hdrCursor",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR-Cursor\nExperimentell. Unausgereift. Sollte wahrscheinlich nicht verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
