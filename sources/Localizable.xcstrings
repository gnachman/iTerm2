    "ShortcutInput.AccidentalConfirmHotkey" : {
      "comment" : "Confirmation when a chosen hotkey looks like a common keystroke; the placeholder is the shortcut",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie „%@“ als Hotkey verwenden möchten? Dies sieht nach einem häufig verwendeten Tastendruck aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Are you sure you want to use “%@” as a hotkey? This looks like a commonly used keystroke."
