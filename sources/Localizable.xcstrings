    "UvMigration.CompatibilityNote" : {
      "comment" : "Trailing note in the startup warning shown when migration bumps a script’s pinned Python version",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python-Versionen sind zwischen Releases nicht immer kompatibel, daher benötigt ein aktualisiertes Skript möglicherweise kleine Änderungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Python versions are not always compatible across releases, so a bumped script may need small changes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pythonのバージョンはリリース間で必ずしも互換性があるとは限らないため、バージョンが上がったスクリプトには軽微な変更が必要になる場合があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As versões do Python nem sempre são compatíveis entre lançamentos, então um script atualizado pode precisar de pequenas alterações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версии Python не всегда совместимы между релизами, поэтому обновлённому скрипту могут потребоваться небольшие изменения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python版本在不同版本间并不总是兼容，因此升级后的脚本可能需要一些小修改。"
          }
        }
      }
    },
    "UvMigration.MultipleScriptsLead" : {
      "comment" : "Lead sentence of the startup warning shown when several scripts’ Python versions were bumped; a bulleted list of the scripts follows",
