    "SuppressedAlerts.Explanation" : {
      "comment" : "Explanatory text at the top of the suppressed-alerts panel",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Warnungen werden automatisch beantwortet, da Sie sich entschieden haben, Ihre Antwort zu speichern. Wählen Sie eine aus und klicken Sie auf „Nicht mehr unterdrücken“, um wieder gefragt zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These alerts are being answered automatically because you chose to remember your response. Select one and click Un-suppress to be asked again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアラートは、応答を記憶させる設定にしたため自動的に応答されています。項目を選択して「抑制を解除」をクリックすると、再び確認されるようになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes alertas estão sendo respondidos automaticamente porque você escolheu memorizar sua resposta. Selecione um e clique em Cancelar supressão para ser perguntado novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На эти оповещения даются автоматические ответы, потому что вы решили запомнить свой выбор. Выберите одно из них и нажмите «Отменить подавление», чтобы снова получать запрос."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些提醒会被自动应答，因为你选择了记住你的答复。请选择其中一个，然后点按“取消屏蔽”以再次询问。"
          }
        }
      }
    },
