    "Tip.0056.Body" : {
      "comment" : "Tip of the day body, id 0056",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kontrollkästchen „Sofort“ in einem Trigger kann dieser bereits ausgelöst werden, während sich der Cursor noch in derselben Zeile wie der zu Ihrem regulären Ausdruck passende Text befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The “instant” checkbox in a Trigger allows it to fire while the cursor is on the same line as the text that matches your regular expression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガーの「即時」チェックボックスをオンにすると、正規表現に一致するテキストと同じ行にカーソルがある間もトリガーを発火させられます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caixa de seleção “instantâneo” em um gatilho permite que ele seja acionado enquanto o cursor está na mesma linha do texto que corresponde à sua expressão regular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Флажок «мгновенно» в триггере позволяет ему срабатывать, пока курсор находится на той же строке, что и текст, соответствующий регулярному выражению."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Trigger 中的“即时”复选框允许在光标位于与正则表达式匹配的文本同一行时触发。"
          }
        }
      }
    },
