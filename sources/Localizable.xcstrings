    "ProfilesColors.ThemeOverridesMode" : {
      "comment" : "Warning shown when the theme overrides the system light/dark mode setting",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr aktuelles Thema überschreibt die Einstellung für den hellen und dunklen Systemmodus, daher findet kein Farbwechsel statt. Sie können dies unter Einstellungen > Erscheinungsbild > Allgemein > Thema ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your current theme overrides the system light and dark mode setting, so color switching will not occur. You can change it in Settings > Appearance > General > Theme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のテーマはシステムのライト/ダークモード設定を上書きしているため、色の切り替えは行われません。「設定 > 外観 > 一般 > テーマ」で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu tema atual substitui a configuração de modo claro e escuro do sistema, portanto não haverá troca de cores. Você pode alterá-lo em Ajustes > Aparência > Geral > Tema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая тема переопределяет системную настройку светлого и тёмного режима, поэтому переключение цветов происходить не будет. Это можно изменить в разделе Настройки > Внешний вид > Общие > Тема."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前主题会覆盖系统的浅色与深色模式设置，因此不会切换颜色。可在“设置”>“外观”>“通用”>“主题”中更改。"
