    "AdvancedSetting.findURLsRespectsSoftBoundaries" : {
      "comment" : "Advanced setting: findURLsRespectsSoftBoundaries",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
