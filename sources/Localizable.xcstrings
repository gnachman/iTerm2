    "AdvancedSetting.allowIdempotentTriggers" : {
      "comment" : "Advanced setting: allowIdempotentTriggers",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idempotente Trigger in interaktiven Anwendungen regelmäßig auswerten, auch wenn Trigger in interaktiven Anwendungen deaktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Evaluate idempotent triggers periodically in interactive apps, even when triggers in interactive apps are disabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対話型アプリでトリガーが無効になっている場合でも、冪等なトリガーを対話型アプリ内で定期的に評価する。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaliar gatilhos idempotentes periodicamente em apps interativos, mesmo quando gatilhos em apps interativos estão desativados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Периодически выполнять идемпотентные триггеры в интерактивных приложениях, даже если триггеры в интерактивных приложениях отключены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在交互式应用中定期评估幂等触发器，即使交互式应用中的触发器被禁用也是如此。"
          }
        }
      }
    },
    "AdvancedSetting.allowInteractiveSwipeBetweenTabs" : {
      "comment" : "Advanced setting: allowInteractiveSwipeBetweenTabs",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interaktives Wischen mit zwei Fingern zwischen Tabs erlauben?\nDie Systemeinstellung Trackpad > Weitere Gesten > Zwischen Seiten wischen steuert dies global. Wenn „Mit zwei Fingern wischen“ aktiviert ist, können Sie diese Einstellung auf „Nein“ setzen, um das Wischen zwischen Tabs in iTerm2 zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow two-finger interactive swipe between tabs?\nThe system preference Trackpad > More Gestures > Swipe between pages controls this globally. When “swipe with two fingers” is enabled, you can change this setting to “No” to prevent swiping between tabs in iTerm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブ間の2本指によるインタラクティブなスワイプを許可しますか？\nシステム環境設定の「トラックパッド > その他のジェスチャ > 2本指でのページ間のスワイプ」がこれをグローバルに制御します。「2本指でスワイプ」が有効な場合、この設定を「いいえ」にすることで、iTerm2内でのタブ間のスワイプを防ぐことができます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir deslize interativo com dois dedos entre abas?\nA preferência do sistema Trackpad > Mais gestos > Passar entre páginas controla isso globalmente. Quando “passar com dois dedos” está ativado, você pode alterar este ajuste para “Não” para impedir o deslize entre abas no iTerm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить интерактивное переключение между вкладками жестом смахивания двумя пальцами?\nЭто глобально управляется системной настройкой Трекпад > Другие жесты > Смахивание между страницами. Если включён режим «смахивание двумя пальцами», вы можете установить для этого параметра значение «Нет», чтобы запретить смахивание между вкладками в iTerm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否允许用双指在标签页间滑动？\n系统偏好设置“触控板 > 更多手势 > 页面间滑动”全局控制此功能。当“用双指滑动”被启用时，可以将此设置改为“否”，以防止在iTerm2中进行标签页间滑动。"
          }
        }
      }
    },
    "AdvancedSetting.allowLiveResize" : {
