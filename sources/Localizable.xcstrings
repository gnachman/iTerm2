    "PasswordManager.RenameCouldNotReadPassword" : {
      "comment" : "Error shown when a rename is aborted because the current password could not be read",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Passwort konnte nicht gelesen werden, daher wurde das Konto nicht umbenannt. Das Umbenennen dieses Kontos würde es neu erstellen, wodurch das Passwort verloren ginge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read the current password, so the account was not renamed. Renaming this account recreates it, which would lose the password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のパスワードを読み取れなかったため、アカウント名は変更されませんでした。このアカウント名を変更するとアカウントが再作成され、パスワードが失われます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a senha atual, então a conta não foi renomeada. Renomear esta conta a recria, o que faria perder a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать текущий пароль, поэтому учётная запись не была переименована. Переименование этой учётной записи приводит к её пересозданию, что привело бы к потере пароля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取当前密码，因此账户未被重命名。重命名该账户会重新创建它，从而丢失密码。"
          }
        }
      }
    },
