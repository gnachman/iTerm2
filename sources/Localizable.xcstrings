    "PasteboardReporter.ConfirmEnableBody" : {
      "comment" : "Warning body shown before enabling clipboard reporting",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Melden des Inhalts der Zwischenablage an Apps, die innerhalb von iTerm2 ausgeführt werden, kann vertrauliche Informationen wie Passwörter offenlegen. Überlegen Sie sich gut, ob Sie dies aktivieren möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reporting the content of the clipboard to apps running inside iTerm2 may expose sensitive information such as passwords. Think carefully before enabling this."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードの内容をiTerm2内で実行されているアプリに報告すると、パスワードなどの機密情報が漏洩する可能性があります。有効にする前によく検討してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relatar o conteúdo da área de transferência para apps em execução dentro do iTerm2 pode expor informações confidenciais, como senhas. Pense bem antes de ativar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передача содержимого буфера обмена приложениям, запущенным внутри iTerm2, может раскрыть конфиденциальную информацию, например пароли. Хорошо подумайте, прежде чем включать эту функцию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将剪贴板内容报告给在 iTerm2 内运行的应用可能会暴露密码等敏感信息。启用前请慎重考虑。"
          }
        }
      }
    },
