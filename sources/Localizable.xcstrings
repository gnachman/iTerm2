    "Tip.0120.Body" : {
      "comment" : "Tip of the day body, id 0120",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markieren Sie einen JSON-Textblock und wählen Sie „Bearbeiten > Auswahl ersetzen > Mit formatiertem JSON ersetzen“, um ihn lesbar zu machen. Perfekt zum Debuggen von API-Antworten und Protokolldateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select a block of JSON text and choose “Edit > Replace Selection > Replace with Pretty-Printed JSON” to make it readable. Perfect for debugging API responses and log files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSONテキストのブロックを選択し、「編集 > 選択範囲を置換 > 整形されたJSONに置換」を選ぶと読みやすくなります。APIレスポンスやログファイルのデバッグに最適です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um bloco de texto JSON e escolha “Edit > Replace Selection > Replace with Pretty-Printed JSON” para torná-lo legível. Perfeito para depurar respostas de API e arquivos de log."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделите блок текста JSON и выберите «Правка > Заменить выделенное > Заменить отформатированным JSON», чтобы сделать его удобочитаемым. Отлично подходит для отладки ответов API и файлов журналов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一段JSON文本，然后选择“编辑 > 替换选中内容 > 用格式化JSON替换”，使其更易于阅读。非常适合调试API响应和日志文件。"
          }
        }
      }
    },
