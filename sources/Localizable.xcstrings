    "ClaudeCode.HookMalformed" : {
      "comment" : "Detail shown when the Claude Code settings file is not valid JSON",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json konnte nicht als JSON geparst werden. Öffnen Sie sie in einem Texteditor und prüfen Sie sie auf Syntaxfehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "~/.claude/settings.json couldn’t be parsed as JSON. Open it in a text editor and check it for syntax errors."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.jsonをJSONとして解析できませんでした。テキストエディタで開いて構文エラーを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível analisar ~/.claude/settings.json como JSON. Abra-o em um editor de texto e verifique se há erros de sintaxe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось разобрать ~/.claude/settings.json как JSON. Откройте файл в текстовом редакторе и проверьте синтаксис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json 无法被解析为 JSON。请在文本编辑器中打开并检查语法错误。"
          }
        }
      }
    },
    "ClaudeCode.HookRemovalFailedBody" : {
      "comment" : "Body shown when hook removal failed, asking whether to continue uninstalling",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sollen die Arbeitsgruppe und die Trigger trotzdem entfernt werden? cc-status läuft weiter, bis Sie das zugrunde liegende Problem beheben und es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ Continue removing the workgroup and triggers anyway? cc-status will keep running until you fix the underlying issue and try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ それでもワークグループとトリガーの削除を続けますか？根本的な問題を修正して再試行するまで、cc-statusは動作し続けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Continuar removendo o grupo de trabalho e os gatilhos mesmo assim? O cc-status continuará em execução até você corrigir o problema subjacente e tentar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Всё равно продолжить удаление рабочей группы и триггеров? cc-status будет продолжать работать, пока вы не устраните проблему и не повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 继续移除工作组 和触发器？cc-status 将继续运行，直到你修复根本问题并重试。"
          }
        }
      }
    },
