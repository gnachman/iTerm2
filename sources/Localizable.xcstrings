        }
      }
    },
    "Tip.0081.Body" : {
      "comment" : "Tip of the day body, id 0081",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Composer unterstützt mehrere Cursor. Außerdem können Sie nur einen einzelnen Befehl aus einer Liste senden, wodurch Sie eine Befehlsliste bequem Schritt für Schritt durchgehen können. Klicken Sie auf die Hilfe-Schaltfläche im Composer, um mehr zu erfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The composer supports multiple cursors. It also has the ability to send just one command out of a list, making it easy to walk through a list of commands one-by-one. Click the help button in the composer for details."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンポーザーは複数カーソルに対応しています。また、リストの中から1つのコマンドだけを送信する機能もあり、コマンドのリストを1つずつ順に実行するのが簡単になります。詳細はコンポーザーのヘルプボタンをクリックしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Compositor suporta múltiplos cursores. Ele também é capaz de enviar apenas um comando de uma lista, facilitando percorrer uma lista de comandos um a um. Clique no botão de ajuda no Compositor para mais detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Композер поддерживает несколько курсоров. Он также умеет отправлять только одну команду из списка, что упрощает пошаговое выполнение списка команд. Нажмите кнопку справки в Композере, чтобы узнать подробности."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composer 支持多个光标，还能从列表中选择单个命令发送，便于逐一处理命令列表。如需了解详情，请点击 Composer 中的帮助按钮。"
          }
        }
      }
    },
    "Tip.0081.Title" : {
