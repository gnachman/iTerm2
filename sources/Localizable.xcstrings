    "Tip.0033.Body" : {
      "comment" : "Tip of the day body, id 0033",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie mit der rechten Maustaste auf einen Tab, um dessen Farbe zu ändern, nachfolgende Tabs zu schließen oder alle anderen Tabs zu schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Right click on a tab to change its color, close tabs after it, or to close all other tabs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブを右クリックすると、色を変更したり、それ以降のタブを閉じたり、他のすべてのタブを閉じたりできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em uma aba para mudar sua cor, fechar as abas seguintes ou fechar todas as outras abas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните правой кнопкой мыши по вкладке, чтобы изменить её цвет, закрыть вкладки после неё или закрыть все остальные вкладки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签页上右键点击可更改其颜色，点击后关闭该标签页，或同时关闭所有其他标签页。"
          }
        }
      }
    },
