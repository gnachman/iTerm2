    "TmuxGateway.Tmux21QuirkError" : {
      "comment" : "Error shown when tmux 2.1 or earlier refuses to create a window pane with a missing working directory",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler: %1$@.\n\ntmux 2.1 und früher verweigert die Erstellung eines neuen Fensterbereichs mit einem nicht vorhandenen anfänglichen Arbeitsverzeichnis.\n\nInfo:\n%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Error: %1$@.\n\nTmux 2.1 and earlier will refuse to create a new window pane with a nonexistent initial working directory.\n\nInfo:\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エラー: %1$@\n\ntmux 2.1以前では、存在しない初期作業ディレクトリで新しいウィンドウペインを作成することはできません。\n\n情報:\n%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro: %1$@.\n\nO tmux 2.1 e anteriores se recusam a criar um novo painel de janela com um diretório de trabalho inicial inexistente.\n\nInfo:\n%2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка: %1$@.\n\nTmux 2.1 и более ранних версий отказывается создавать новую панель окна с несуществующим исходным рабочим каталогом.\n\nСведения:\n%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错误：%1$@。\n\nTmux 2.1及更早版本会拒绝创建初始工作目录不存在的新窗口窗格。\n\n信息：\n%2$@"
          }
        }
      }
    },
