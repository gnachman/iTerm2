    "SessionLauncher.IllegalUsernameMessage" : {
      "comment" : "Warning message when an SSH username contains a disallowed character. %@ is the username.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SSH-Benutzername „%@“ enthielt ein nicht erlaubtes Zeichen. Die Menge der erlaubten Zeichen ist aus Sicherheitsgründen eingeschränkt. Sie können sie unter Einstellungen > Erweitert > Gültige Zeichen in SSH-Benutzernamen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The SSH user name “%@” contained a disallowed character. The set of allowed characters is limited for security reasons. You can modify it in Settings > Advanced > Valid characters in SSH user names."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSHユーザー名「%@」に、許可されていない文字が含まれていました。セキュリティ上の理由により、使用できる文字の範囲は制限されています。設定 > 詳細 > 「SSHユーザー名で使用できる文字」で変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuário SSH “%@” continha um caractere não permitido. O conjunto de caracteres permitidos é limitado por motivos de segurança. Você pode modificá-lo em Ajustes > Avançado > Caracteres válidos em nomes de usuário SSH."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя SSH «%@» содержит недопустимый символ. Набор разрешённых символов ограничен из соображений безопасности. Его можно изменить в разделе Settings > Advanced > Valid characters in SSH user names."
          }
        },
