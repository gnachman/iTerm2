    "Tip.0071.Body" : {
      "comment" : "Tip of the day body, id 0071",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können eine Sitzung mit „Sitzung > Sitzung vergraben“ „vergraben“. Sie bleibt verborgen, bis Sie sie über „Sitzung > Vergrabene Sitzungen > Ihre Sitzung“ wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can “bury” a session with “Session > Bury Session.” It remains hidden until you restore it by selecting it from “Session > Buried Sessions > Your session.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「セッション > セッションを埋める」でセッションを「埋める」ことができます。「セッション > 埋めたセッション > (該当セッション)」から選択して復元するまで、非表示のままになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode “enterrar” uma sessão com “Sessão > Enterrar sessão”. Ela permanece oculta até você restaurá-la selecionando-a em “Sessão > Sessões enterradas > Sua sessão”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете «скрыть» сессию с помощью «Сессия > Скрыть сессию». Она останется скрытой, пока вы не восстановите её, выбрав в «Сессия > Скрытые сессии > Ваша сессия»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以使用“会话 > 隐藏会话”功能将会话“隐藏”。在从“会话 > 隐藏会话 > 您的会话”中恢复之前，该会话会保持隐藏状态。"
          }
        }
      }
    },
