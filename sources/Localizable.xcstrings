    "StatusBarGit.DebugInfoFormat" : {
      "comment" : "Body of the git status bar debug info alert; placeholders are directory, cadence, enabled flag, seconds since last poll, repo state, and extra debug info",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzeichnis: %1$@\nAbfrageintervall: %2$@ Sek.\nAbfrage aktiviert: %3$@\nLetzte Abfrage vor %4$@ Sekunden\nRepository-Status: %5$@\n%6$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Directory: %1$@\nPolling cadence: %2$@ sec\nPolling enabled: %3$@\nLast polled %4$@ seconds ago\nRepo state: %5$@\n%6$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディレクトリ: %1$@\nポーリング間隔: %2$@ 秒\nポーリング有効: %3$@\n前回のポーリングから %4$@ 秒経過\nリポジトリの状態: %5$@\n%6$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diretório: %1$@\nCadência de sondagem: %2$@ s\nSondagem ativada: %3$@\nÚltima sondagem há %4$@ segundos\nEstado do repositório: %5$@\n%6$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каталог: %1$@\nЧастота опроса: %2$@ с\nОпрос включён: %3$@\nПоследний опрос: %4$@ с назад\nСостояние репозитория: %5$@\n%6$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目录: %1$@\n轮询频率: %2$@ 秒\n启用轮询: %3$@\n上次轮询时间: %4$@ 秒前\n仓库状态: %5$@\n%6$@"
          }
        }
      }
    },
