    "BrowserGateway.InvalidCodeSignature" : {
      "comment" : "Error shown when the browser plugin fails code signature verification",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Code-Signatur des Plugins unter %@ ist ungültig. Laden Sie es erneut herunter und stellen Sie sicher, dass Ihr Antivirenprogramm es nicht unter Quarantäne stellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The code signature of the plugin at %@ is invalid. Download it again, and ensure your anti-virus does not quarantine it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にあるプラグインのコード署名が無効です。もう一度ダウンロードし、ウイルス対策ソフトによって隔離されないようにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura de código do plugin em %@ é inválida. Transfira-o novamente e certifique-se de que seu antivírus não o coloque em quarentena."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись кода плагина по пути %@ недействительна. Загрузите его снова и убедитесь, что антивирус не помещает его в карантин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件在%@的代码签名无效。重新下载，并确保您的反病毒软件不会将其隔离。"
          }
        }
