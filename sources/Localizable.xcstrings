    "Tip.0035.Body" : {
      "comment" : "Tip of the day body, id 0035",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie in den Tag eines Profils einen Schrägstrich einfügen, wird dadurch implizit eine Hierarchie festgelegt. Diese sehen Sie im Profile-Menü als verschachtelte Untermenüs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you put a slash in a profile’s tag, that implicitly defines a hierarchy. You can see it in the Profiles menu as nested submenus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルのタグにスラッシュを入れると、暗黙的に階層が定義されます。これはプロファイルメニューに入れ子になったサブメニューとして表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você colocar uma barra na tag de um perfil, isso define implicitamente uma hierarquia. Você pode vê-la no menu Perfis como submenus aninhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вставить в тег профиля косую черту, это неявно задаёт иерархию. Её можно увидеть в меню «Профили» в виде вложенных подменю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在配置文件的标签中加上斜杠，则隐含了层级关系。在“Profiles”菜单中可以看到嵌套的子菜单。"
          }
        }
      }
    },
    "Tip.0035.Title" : {
