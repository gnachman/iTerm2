    "LocalePrompt.Message" : {
      "comment" : "Explanation shown when no valid UNIX locale exists for the user’s language and country",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die aktuelle Sprache und das Land Ihres Computers existiert kein gültiges UNIX-Gebietsschema. Dies kann dazu führen, dass Kommandozeilen-Apps sich fehlerhaft verhalten. Bitte wählen Sie eines aus der folgenden Liste aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No valid UNIX locale exists for your computer’s current language and country. This may cause command-line apps to misbehave. Please select one from the list below."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのコンピュータの現在の言語と国に対応する有効なUNIXロケールが存在しません。これによりコマンドラインアプリが正しく動作しないことがあります。以下のリストから1つ選択してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe nenhum locale UNIX válido para o idioma e o país atuais do seu computador. Isso pode fazer com que apps de linha de comando se comportem mal. Selecione um na lista abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для текущего языка и страны вашего компьютера не существует допустимой локали UNIX. Это может привести к некорректной работе приложений командной строки. Выберите локаль из списка ниже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的电脑当前语言和国家/地区不存在有效的 UNIX locale。这可能导致命令行应用行为异常。请从下方列表中选择一个。"
          }
        }
      }
