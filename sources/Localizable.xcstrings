    "Tip.0061.Body" : {
      "comment" : "Tip of the day body, id 0061",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wussten Sie schon? Wenn der Signalton zu häufig ertönt, werden Sie gefragt, ob Sie ihn vorübergehend stummschalten möchten. iTerm2 legt Wert auf Ihren Komfort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Did you know? If the bell rings too often, you’ll be asked if you’d like to silence it temporarily. iTerm2 cares about your comfort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご存じでしたか?ベルが頻繁に鳴りすぎると、一時的に消音するかどうか尋ねられます。iTerm2はあなたの快適さを大切にしています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sabia? Se a campainha tocar com muita frequência, será perguntado se você deseja silenciá-la temporariamente. O iTerm2 se importa com o seu conforto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А вы знали? Если звуковой сигнал звучит слишком часто, вам предложат временно его отключить. iTerm2 заботится о вашем комфорте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你知道吗？如果铃声响得太频繁，系统会询问你是否希望暂时关闭它。iTerm2注重你的使用体验。"
          }
        }
      }
    },
    "Tip.0061.Title" : {
