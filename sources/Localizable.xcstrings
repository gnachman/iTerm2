    "ProfilesSession.ProgressBarHeightTooTall" : {
      "comment" : "Message shown when the progress bar height is clamped to the top margin height",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Höhe der Fortschrittsanzeige darf die Höhe des oberen Rands nicht überschreiten. Sie können dies unter **Einstellungen > Erscheinungsbild > Bereiche > Oberer und unterer Rand** anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The progress bar height cannot exceed the top margin’s height. You can adjust it in **Settings > Appearance > Panes > Top & Bottom Margins**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プログレスバーの高さは、上部マージンの高さを超えることはできません。**設定 > 外観 > ペイン > 上下マージン** で調整できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A altura da barra de progresso não pode exceder a altura da margem superior. Você pode ajustá-la em **Ajustes > Aparência > Painéis > Margens superior e inferior**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота индикатора выполнения не может превышать высоту верхнего поля. Это можно настроить в разделе **Настройки > Внешний вид > Панели > Верхнее и нижнее поля**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条的高度不能超过顶部边缘的高度。你可以在**设置 > 外观 > 窗格 > 顶部和底部边缘**中调整它。"
          }
        }
      }
    },
