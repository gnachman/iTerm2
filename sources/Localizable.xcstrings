    "SpecialExceptions.PreviewAsciiError" : {
      "comment" : "Preview message shown when the start code point is in the ASCII range",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Start muss mindestens U+80 sein. ASCII unterstützt keine speziellen Ausnahmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start must be at least U+80. ASCII doesn’t support special exceptions."
