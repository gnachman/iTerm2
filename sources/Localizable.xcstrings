      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal-Renderer im Leerlauf deaktivieren, um CPU-Auslastung zu sparen?\nErfordert Metal-Renderer"
