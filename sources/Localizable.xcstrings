    "AdvancedSetting.allowSendingFunctionKeysToCocoa" : {
      "comment" : "Advanced setting: allowSendingFunctionKeysToCocoa",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben, dass Funktionstasten vom macOS-Texteingabesystem verarbeitet werden.\nDies unterstützt die Verwendung von Funktionstasten mit Modifikatoren als Compose-/Tottasten in benutzerdefinierten Tastaturbelegungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow function keys to be handled by macOS text input system.\nThis supports using function keys with modifiers as compose/dead keys in custom keyboard layouts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファンクションキーをmacOSのテキスト入力システムで処理できるようにする。\nこれにより、カスタムキーボードレイアウトで修飾キー付きのファンクションキーをコンポーズ/デッドキーとして使用できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que teclas de função sejam tratadas pelo sistema de entrada de texto do macOS.\nIsso possibilita usar teclas de função com modificadores como teclas de composição/mortas em layouts de teclado personalizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить обработку функциональных клавиш системой ввода текста macOS.\nЭто поддерживает использование функциональных клавиш с модификаторами в качестве составных/мёртвых клавиш в пользовательских раскладках клавиатуры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否允许功能键由macOS文本输入系统处理？\n这支持在自定义键盘布局中将功能键与修饰符组合使用为撰写/死亡键。"
          }
        }
      }
    },
