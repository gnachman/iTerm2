    "AdvancedSetting.paneTitleBarBackgroundColor" : {
      "comment" : "Advanced setting: paneTitleBarBackgroundColor",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefinierte Hintergrundfarbe für Bereichstitelleisten. Leer lassen, um die Standardfarbe zu verwenden.\nDies sollte eine Farbe im HTML-Stil sein, zum Beispiel #aabbcc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custom background color for pane title bars. Leave empty to use default color.\nThis should be an HTML-style color, like #aabbcc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペインのタイトルバーのカスタム背景色。デフォルトの色を使用するには空欄のままにしてください。\n#aabbccのようなHTML形式の色を指定してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cor de fundo personalizada para as barras de título dos painéis. Deixe vazio para usar a cor padrão.\nDeve ser uma cor no estilo HTML, como #aabbcc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользовательский цвет фона для заголовков панелей. Оставьте пустым, чтобы использовать цвет по умолчанию.\nЦвет должен быть в HTML-формате, например #aabbcc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗格标题栏的自定义背景颜色。留空则使用默认颜色。\n应为 HTML 风格的颜色，如 #aabbcc。"
          }
        }
      }
    },
