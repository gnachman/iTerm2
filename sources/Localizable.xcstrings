    "AdvancedSetting.sessionEndMessageDividerCharacter" : {
      "comment" : "Advanced setting: sessionEndMessageDividerCharacter",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichen für Trennlinien in Meldungen zum Sitzungsende. Leer lassen, um den sicheren Standard (BrokenPipeDivider-Bild) zu verwenden. Beispiele: ━ ─ ═ ╌ ┄"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Character to use for divider lines in session end messages. Leave empty to use secure default (BrokenPipeDivider image). Examples: ━ ─ ═ ╌ ┄"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション終了メッセージの区切り線に使用する文字。空欄の場合は安全なデフォルト（BrokenPipeDivider画像）を使用します。例：━ ─ ═ ╌ ┄"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caractere a usar nas linhas divisórias das mensagens de fim de sessão. Deixe vazio para usar o padrão seguro (imagem BrokenPipeDivider). Exemplos: ━ ─ ═ ╌ ┄"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символ для линий-разделителей в сообщениях о завершении сеанса. Оставьте пустым, чтобы использовать безопасное значение по умолчанию (изображение BrokenPipeDivider). Примеры: ━ ─ ═ ╌ ┄"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话结束消息中用于分隔线的字符。留空则使用默认安全分隔符（BrokenPipeDivider图像）。示例： ━ ─ ═ ╌ ┄"
          }
        }
      }
    },
