    },
    "ProfilesTerminal.UTF8MismatchWarning" : {
      "comment" : "Warning shown when a custom locale does not use UTF-8 but the profile does",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtung! Dieses Profil verwendet ein benutzerdefiniertes Gebietsschema, das nicht UTF-8 als Zeichenkodierung verwendet, Ihr Profil verwendet jedoch *tatsächlich* UTF-8. Dies kann dazu führen, dass Fehlermeldungen und Nicht-ASCII-Text falsch angezeigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning! This profile uses a custom locale that doesn't use UTF-8 as its character encoding, but your profile *is* using UTF-8. This can cause error messages and non-ASCII text to appear wrong."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告! このプロファイルは文字エンコーディングにUTF-8を使用しないカスタムロケールを使用していますが、プロファイル自体は*UTF-8を使用しています*。これにより、エラーメッセージや非ASCII文字が正しく表示されないことがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso! Este perfil usa uma localidade personalizada que não usa UTF-8 como codificação de caracteres, mas seu perfil *está* usando UTF-8. Isso pode fazer com que mensagens de erro e texto não ASCII apareçam incorretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внимание! Этот профиль использует особую локаль, которая не использует UTF-8 в качестве кодировки символов, однако в самом профиле UTF-8 *действительно* используется. Это может привести к неверному отображению сообщений об ошибках и текста, отличного от ASCII."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告！此配置文件使用的自定义语言环境不使用 UTF-8 作为字符编码，但你的配置文件*确实*使用 UTF-8。这可能导致错误消息和非 ASCII 文本显示异常。"
          }
        }
      }
    },
    "ProfilesTerminal.WrongEncodingHeading" : {
      "comment" : "Heading for the wrong-encoding warning",
      "extractionState" : "stale",
      "localizations" : {
