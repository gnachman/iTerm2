      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um wie viel soll der Kontrast für Text in Tabs im Design „Minimal“ erhöht werden?\nWählen Sie einen Wert größer als 1, um den Kontrast zu erhöhen. Werte zwischen 0 und 1 haben weniger Kontrast als der Standard."
          }
