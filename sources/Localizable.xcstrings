        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При последнем запуске iTerm2 не удалось восстановить некоторые окна. Повторить попытку?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
