    "RemotePreferences.SyncDataFilesPrompt" : {
      "comment" : "Prompt asking whether to also sync data files to the settings folder; %@ is the folder path",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 kann außerdem Ihre Schnipsel, globalen Notizen und Sitzungssymbol-Anpassungen im Einstellungsordner „%@“ aufbewahren, damit sie zwischen Rechnern synchronisiert werden. Notizen und Schnipsel können vertrauliche Texte wie Passwörter oder Tokens enthalten. Sollen auch diese synchronisiert werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 can also keep your snippets, global notes, and session icon customizations in the settings folder “%@” so they sync across machines. Notes and snippets can contain sensitive text such as passwords or tokens. Sync them too?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 では、スニペット、グローバルメモ、セッションアイコンのカスタマイズも設定フォルダ「%@」に保存し、複数のマシン間で同期することができます。メモやスニペットにはパスワードやトークンなどの機密情報が含まれる場合があります。これらも同期しますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 também pode manter seus Fragmentos, notas globais e personalizações de ícone de sessão na pasta de ajustes “%@” para que sejam sincronizados entre máquinas. Notas e Fragmentos podem conter texto sensível, como senhas ou tokens. Sincronizá-los também?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 также может хранить ваши сниппеты, глобальные заметки и настройки значков сеансов в папке настроек «%@», чтобы синхронизировать их между компьютерами. Заметки и сниппеты могут содержать конфиденциальные данные, такие как пароли или токены. Синхронизировать их тоже?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 还可以将你的代码片段、全局笔记和会话图标自定义项保存在设置文件夹“%@”中，以便在机器之间同步。笔记和代码片段可能包含密码或令牌等敏感文本。也同步它们？"
          }
        }
      }
    },
