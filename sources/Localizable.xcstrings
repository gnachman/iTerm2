      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führen Sie mit „Sequenz“-Tastenzuordnungen eine Reihe von Aktionen der Reihe nach mit einer einzigen Tastenkombination aus."
          }
        },
