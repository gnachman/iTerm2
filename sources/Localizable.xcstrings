    "AdvancedSetting.remapModifiersWithoutEventTap" : {
      "comment" : "Advanced setting: remapModifiersWithoutEventTap",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbelegen von Modifizierertasten für Systemtastenkombinationen deaktivieren.\nDadurch entfällt die Abfrage der Bedienungshilfen-Berechtigung. Das Umbelegen von Systemtastenkombinationen wie Cmd-Tab funktioniert dadurch nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable remapping modifiers for system shortcuts.\nThis prevents asking for accessibility permission. It breaks remapping system shortcuts like cmd-tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムショートカットの修飾キー再マッピングを無効にする。\nこれによりアクセシビリティ権限の要求を防げます。ただし、cmd-tabのようなシステムショートカットの再マッピングが機能しなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar o remapeamento de modificadores para atalhos do sistema.\nIsto evita solicitar permissão de acessibilidade. Isto quebra o remapeamento de atalhos do sistema como cmd-tab."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключить переназначение модификаторов для системных сочетаний клавиш.\nЭто предотвращает запрос разрешения специальных возможностей. При этом перестаёт работать переназначение системных сочетаний клавиш, например cmd-tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用系统快捷键的映射转换。\n这可以防止请求无障碍权限，同时会破坏如cmd-tab这样的快捷键映射功能。"
          }
        }
      }
    },
    "AdvancedSetting.rememberTmuxWindowSizes" : {
      "comment" : "Advanced setting: rememberTmuxWindowSizes",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstergrößen bei der tmux-Integration merken?\nErfordert tmux 2.9 oder höher. Die erweiterte Einstellung „Variable Fenstergröße“ muss aktiviert sein."
          }
        },
        "en" : {
