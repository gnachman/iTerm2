    "ProfileDocument.RenamedPrompt" : {
      "comment" : "Prompt asking which profile to open when a shortcut refers to a renamed profile",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie das Profil öffnen, das früher %1$@ hieß und jetzt %2$@ heißt (auf das sich diese Tastenkombination bezieht), oder das Profil, das derzeit den Namen %3$@ trägt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Would you like to open the profile formerly named %1$@ that is now called %2$@ (which this shortcut refers to), or the profile that currently has the name %3$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前は%1$@という名前で、現在は%2$@という名前になっているプロファイル（このショートカットが参照しているもの）を開きますか、それとも現在%3$@という名前のプロファイルを開きますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deseja abrir o perfil que antes se chamava %1$@ e agora se chama %2$@ (ao qual este atalho se refere), ou o perfil que atualmente tem o nome %3$@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыть профиль, ранее называвшийся %1$@, который теперь называется %2$@ (на него ссылается этот ярлык), или профиль, который в настоящее время называется %3$@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您希望打开之前名为 %1$@、现在称为 %2$@ 的配置文件（此快捷键所指向的），还是当前名为 %3$@ 的配置文件？"
          }
        }
