    "Tip.0030.Body" : {
      "comment" : "Tip of the day body, id 0030",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können die regulären Ausdrücke der Intelligenten Auswahl unter „Einstellungen > Profile > Erweitert > Intelligente Auswahl“ bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can edit Smart Selection regular expressions in “Settings > Profiles > Advanced > Smart Selection.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 > プロファイル > 詳細 > スマート選択」で、スマート選択の正規表現を編集できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode editar as expressões regulares da Seleção inteligente em “Ajustes > Perfis > Avançado > Seleção inteligente”."
