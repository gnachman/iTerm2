{
  "sourceLanguage" : "en",
  "strings" : {
    "About.BackersHeading" : {
      "comment" : "About window heading. Keep the <a href=...> HTML tags and the URLs. ‘Patreon’ and ‘GitHub Sponsors’ are brand names, keep them. Only translate the prose ‘iTerm2 is supported by these backers on’ and ‘and’.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 wird von diesen Unterstützern auf <a href=\"https://patreon.com/gnachman\">Patreon</a> und <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a> unterstützt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iTerm2 is supported by these backers on <a href=\"https://patreon.com/gnachman\">Patreon</a> and <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2は<a href=\"https://patreon.com/gnachman\">Patreon</a>と<a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>の以下の支援者にサポートされています"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iTerm2 conta com estes apoiadores no <a href=\"https://patreon.com/gnachman\">Patreon</a> e no <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 поддерживают эти спонсоры на <a href=\"https://patreon.com/gnachman\">Patreon</a> и <a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2由<a href=\"https://patreon.com/gnachman\">Patreon</a>和<a href=\"https://github.com/sponsors/gnachman\">GitHub Sponsors</a>的赞助者支持"
          }
        }
      }
    },
