    "ShellIntegration.AboutBody" : {
      "comment" : "Body text explaining what shell integration provides",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Shell-Integrationsfunktionen wie Befehlsverlauf, Letzte Verzeichnisse, Ausgabe des letzten Befehls auswählen und Automatischer Profilwechsel zu nutzen, muss Ihre Shell richtig konfiguriert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To use shell integration features such as Command History, Recent Directories, Select Output of Last Command, and Automatic Profile Switching, your shell must be properly configured."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンド履歴、最近使用したディレクトリ、直前のコマンドの出力を選択、自動プロファイル切り替えなどのShell Integration機能を使用するには、シェルが正しく設定されている必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar recursos do Shell Integration, como Histórico de comandos, Diretórios recentes, Selecionar a saída do último comando e Troca automática de perfil, seu shell precisa estar configurado corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать функции интеграции с оболочкой, такие как история команд, недавние папки, выбор вывода последней команды и автоматическое переключение профилей, ваша оболочка должна быть правильно настроена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用 Shell 集成功能（如命令历史、最近的目录、选择最后一条命令的输出以及自动配置文件切换），你的 shell 必须正确配置。"
          }
        }
      }
    },
