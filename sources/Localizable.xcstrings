          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーのコンポーネント「%1$@」(%2$@) が失敗しました。\n\nこの関数呼び出しでエラーが発生しました:\n\n%3$@\n\nエラー内容:\n\n%4$@\n\n%5$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O componente da barra de status “%1$@” (%2$@) falhou.\n\nEsta chamada de função teve um erro:\n\n%3$@\n\nO erro foi:\n\n%4$@\n\n%5$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбой компонента строки состояния «%1$@» (%2$@).\n\nПри вызове этой функции произошла ошибка:\n\n%3$@\n\nОшибка:\n\n%4$@\n\n%5$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状态栏组件“%1$@” (%2$@) 失败。\n\n此函数调用出现错误：\n\n%3$@\n\n错误内容：\n\n%4$@\n\n%5$@"
