    "NaggingController.ArrangementProfileCorrupted" : {
      "comment" : "Announcement that a saved arrangement’s profile is missing due to a known bug",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil dieser Anordnung fehlt. Dies könnte an einem Fehler in iTerm2 Version 3.5.7 liegen, der dazu führte, dass Profile in gespeicherten Anordnungen beschädigt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This arrangement’s profile is missing. This could be due to a bug in iTerm2 version 3.5.7, which caused profiles to be corrupted in saved arrangements."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアレンジメントのプロファイルが見つかりません。これはiTerm2バージョン3.5.7のバグが原因で、保存されたアレンジメント内のプロファイルが破損した可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil desta disposição está ausente. Isso pode ser devido a um bug na versão 3.5.7 do iTerm2, que fazia com que os perfis ficassem corrompidos em disposições salvas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль этой раскладки отсутствует. Это может быть связано с ошибкой в iTerm2 версии 3.5.7, из-за которой профили в сохранённых раскладках повреждались."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此窗口布局对应的配置文件缺失。这可能是 iTerm2 3.5.7 版的一个 bug 所致，该版本会导致已保存布局中的配置文件损坏。"
          }
        }
      }
    },
