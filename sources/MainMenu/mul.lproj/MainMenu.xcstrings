    "YHP-Qx-eCZ.title" : {
      "comment" : "Class = \"NSMenuItem\"; title = \"Warn Before Pasting One Line Ending in a Newline at Shell Prompt\"; ObjectID = \"YHP-Qx-eCZ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varovat před vložením jednoho řádku zakončeného novým řádkem na výzvě shellu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar før indsætning af én linje, der slutter med linjeskift, ved shell-prompt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor dem Einfügen einer Zeile mit abschließendem Zeilenumbruch an der Shell-Eingabeaufforderung warnen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προειδοποίηση πριν από επικόλληση μίας γραμμής που τελειώνει σε νέα γραμμή στη γραμμή προτροπής"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warn Before Pasting One Line Ending in a Newline at Shell Prompt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar antes de pegar una línea que termina en salto de línea en el prompt del shell"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoita ennen yhden rivinvaihtoon päättyvän rivin sijoitusta komentokehotteeseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertir avant de coller une ligne se terminant par un retour à la ligne à l’invite du shell"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozori prije lijepljenja jednog retka koji završava novim retkom na odzivniku ljuske"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyelmeztetés újsorral végződő egyetlen sor beillesztése előtt a shell promptnál"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa prima di incollare una riga che termina con un a capo nel prompt della shell"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルプロンプトで改行付きの1行を貼り付ける前に警告"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 프롬프트에서 줄바꿈으로 끝나는 한 줄을 붙여넣기 전에 경고"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar før innliming av én linje som slutter med linjeskift i ledeteksten"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuw vóór plakken van één regel die eindigt op een nieuwe regel bij shell-prompt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzegaj przed wklejeniem jednego wiersza zakończonego znakiem nowego wiersza przy znaku zachęty powłoki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisar antes de colar uma linha que termina com nova linha no prompt do shell"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertizați înainte de lipirea unei linii terminate cu linie nouă la promptul shellului"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждать перед вставкой однострочного текста, заканчивающегося переводом строки, в командной строке оболочки"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorniť pred vložením jedného riadka zakončeného novým riadkom vo výzve shellu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozori pred lepljenjem ene vrstice, ki se konča z novo vrstico, pri ukaznem pozivu lupine"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varna före inklistring av en rad som slutar med radbrytning vid skalprompten"
