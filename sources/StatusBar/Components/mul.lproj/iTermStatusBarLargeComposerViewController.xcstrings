{
  "sourceLanguage" : "en",
  "strings" : {
    "d6h-kf-O57.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"AI completion enabled: all text sent to AI\"; ObjectID = \"d6h-kf-O57\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Vervollständigung aktiviert: Der gesamte Text wird an die KI gesendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI completion enabled: all text sent to AI"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autocompletado con IA activado: todo el texto se envía a la IA"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complétion IA activée : tout le texte est envoyé à l’IA"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamento IA abilitato: tutto il testo viene inviato all’IA"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI補完が有効: すべてのテキストがAIに送信されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 완성 켜짐: 모든 텍스트가 AI로 전송됨"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-aanvulling ingeschakeld: alle tekst wordt naar de AI gestuurd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzupełnianie AI włączone: cały tekst jest wysyłany do AI"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenchimento por IA ativado: todo o texto é enviado à IA"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автодополнение ИИ включено: весь текст отправляется в ИИ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YZ tamamlama etkin: tüm metin YZ’ye gönderilir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã bật hoàn thành bằng AI: toàn bộ văn bản được gửi đến AI"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 补全已启用：所有文本都会发送给 AI"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 補全已啟用：所有文字都會傳送給 AI"
          }
        }
      }
    },
    "Due-Dn-30r.ibShadowedToolTip" : {
