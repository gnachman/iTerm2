{
  "sourceLanguage" : "en",
  "strings" : {
    "0yl-ll-bce.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Drag a component from the menu to Active Components to add it to your status bar.\"; ObjectID = \"0yl-ll-bce\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením součásti z nabídky do části Aktivní součásti ji přidáte do stavového řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk en komponent fra menuen til Aktive komponenter for at føje den til din statuslinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie eine Komponente aus dem Menü zu „Aktive Komponenten“, um sie zur Statusleiste hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag a component from the menu to Active Components to add it to your status bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un componente del menú a Componentes activos para añadirlo a tu barra de estado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää komponentti tilapalkkiin vetämällä se valikosta Aktiivisiin osiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un composant du menu vers Composants actifs pour l’ajouter à votre barre d’état."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite komponentu iz izbornika u Aktivne komponente da biste je dodali na traku statusa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzzon egy összetevőt a menüből az Aktív összetevők közé, hogy hozzáadja az állapotsorhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un componente dal menu in Componenti attivi per aggiungerlo alla barra di stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューからコンポーネントを「アクティブなコンポーネント」にドラッグすると、ステータスバーに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴에서 구성요소를 활성 구성요소로 드래그하여 상태 막대에 추가하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en komponent fra menyen til Aktive komponenter for å legge den til i statuslinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een onderdeel uit het menu naar Actieve onderdelen om het aan je statusbalk toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij składnik z menu do sekcji Aktywne składniki, aby dodać go do paska stanu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste um componente do menu para Componentes ativos a fim de adicioná-lo à sua barra de status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите компонент из меню в «Активные компоненты», чтобы добавить его в строку состояния."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím komponentu z menu do časti „Aktívne komponenty“ ho pridáte na stavovú lištu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povlecite komponento iz menija med Aktivne komponente, da jo dodate v vrstico stanja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en komponent från menyn till Aktiva komponenter för att lägga till den i statusfältet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durum çubuğunuza eklemek için menüden bir bileşeni Etkin Bileşenler’e sürükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo một thành phần từ menu vào Thành phần đang hoạt động để thêm vào thanh trạng thái của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将组件从菜单拖到“活动组件”，即可将其添加到你的状态栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將元件從選單拖到「使用中的元件」，即可將其加入你的狀態列。"
          }
        }
      }
    },
    "5a8-iM-Enf.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Prefer tight packing to stable positioning\"; ObjectID = \"5a8-iM-Enf\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upřednostnit těsné zarovnání před stabilní pozicí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foretræk tæt pakning frem for stabil placering"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enge Anordnung gegenüber stabiler Positionierung bevorzugen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prefer tight packing to stable positioning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferir el empaquetado compacto a la posición estable"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suosi tiivistä pakkausta vakaan sijoittelun sijaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préférer un agencement compact à un positionnement stable"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radije zbijeno slaganje nego stabilan položaj"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tömör elrendezés előnyben részesítése a stabil pozícióval szemben"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci la disposizione compatta alla posizione stabile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定した配置よりも詰め込み配置を優先"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정적인 위치보다 빽빽한 배치 우선"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foretrekk tett pakking framfor stabil plassering"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef de voorkeur aan compacte plaatsing boven vaste posities"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferuj ścisłe upakowanie zamiast stabilnego położenia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferir empacotamento compacto ao posicionamento estável"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочитать плотную упаковку стабильному расположению"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprednostniť tesné usporiadanie pred stabilnou polohou"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raje gosto pakiranje kot stabilen položaj"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Föredra tät packning framför stabil positionering"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kararlı konum yerine sıkı yerleşimi tercih et"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ưu tiên xếp sát hơn vị trí ổn định"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先紧凑排列而非稳定定位"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先緊湊排列而非穩定定位"
          }
        }
      }
    },
