    "kXu-5A-6d1.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"The tight packing algorithm allows more status bar components to be visible at a time but they tend to jump around more.\"; ObjectID = \"kXu-5A-6d1\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritmus těsného zarovnání umožňuje zobrazit najednou více součástí stavového řádku, ale ty mají větší tendenci poskakovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritmen med tæt pakning gør det muligt at se flere statuslinjekomponenter ad gangen, men de har tendens til at hoppe mere rundt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Algorithmus für enge Anordnung ermöglicht es, mehr Statusleistenkomponenten gleichzeitig anzuzeigen, allerdings springen sie dabei stärker hin und her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The tight packing algorithm allows more status bar components to be visible at a time but they tend to jump around more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El algoritmo de empaquetado compacto permite que se vean más componentes de la barra de estado a la vez, pero tienden a moverse más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiivis pakkausalgoritmi mahdollistaa useamman tilapalkin osan näkymisen kerrallaan, mutta ne hyppivät herkemmin paikasta toiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’agencement compact permet d’afficher davantage de composants de la barre d’état à la fois, mais ils ont tendance à bouger davantage."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritam zbijenog slaganja omogućuje da je istodobno vidljivo više komponenti trake statusa, ali one se češće pomiču."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tömör elrendezési algoritmus több állapotsor-összetevőt tesz egyszerre láthatóvá, de azok hajlamosabbak ugrálni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’algoritmo di disposizione compatta permette di vedere più componenti della barra di stato contemporaneamente, ma tendono a spostarsi di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詰め込み配置アルゴリズムでは、一度に表示できるステータスバーコンポーネントの数が増えますが、位置が変動しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빽빽한 배치 알고리즘을 사용하면 한 번에 더 많은 상태 막대 구성요소를 표시할 수 있지만, 구성요소의 위치가 더 자주 바뀌는 경향이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritmen for tett pakking gjør at flere statuslinjekomponenter kan være synlige samtidig, men de har en tendens til å hoppe mer rundt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met het algoritme voor compacte plaatsing zijn er tegelijk meer statusbalkonderdelen zichtbaar, maar ze verspringen vaker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algorytm ścisłego upakowania pozwala pokazać jednocześnie więcej składników paska stanu, ale częściej zmieniają one położenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O algoritmo de empacotamento compacto permite que mais componentes da barra de status fiquem visíveis ao mesmo tempo, mas eles tendem a se mover mais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алгоритм плотной упаковки позволяет одновременно отображать больше компонентов строки состояния, но они чаще смещаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritmus tesného usporiadania umožňuje zobraziť naraz viac komponentov stavovej lišty, ale tie sa viac presúvajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritem gostega pakiranja omogoča, da je hkrati vidnih več komponent vrstice stanja, vendar se te bolj premikajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algoritmen för tät packning gör att fler statusfältskomponenter syns samtidigt, men de tenderar att hoppa runt mer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıkı yerleşim algoritması aynı anda daha fazla durum çubuğu bileşeninin görünmesini sağlar, ancak bileşenler daha çok yer değiştirme eğilimindedir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuật toán xếp sát cho phép hiển thị nhiều thành phần thanh trạng thái hơn cùng lúc nhưng chúng dễ nhảy vị trí hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧凑排列算法可以同时显示更多状态栏组件，但它们更容易跳动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊湊排列演算法可同時顯示更多狀態列元件，但它們較容易跳動。"
          }
        }
      }
    },
