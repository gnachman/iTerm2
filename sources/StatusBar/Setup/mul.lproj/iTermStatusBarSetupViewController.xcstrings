        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar componentes con valores vacíos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista osat, joiden arvot ovat tyhjiä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer les composants dont la valeur est vide"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukloni komponente s praznim vrijednostima"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üres értékű összetevők eltávolítása"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi i componenti con valori vuoti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値が空のコンポーネントを削除"
          }
        },
        "ko" : {
          "stringUnit" : {
