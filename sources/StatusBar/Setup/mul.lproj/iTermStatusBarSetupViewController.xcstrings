{
  "sourceLanguage" : "en",
  "strings" : {
    "0yl-ll-bce.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Drag a component from the menu to Active Components to add it to your status bar.\"; ObjectID = \"0yl-ll-bce\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie eine Komponente aus dem Menü zu „Aktive Komponenten“, um sie zur Statusleiste hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag a component from the menu to Active Components to add it to your status bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un componente del menú a Componentes activos para añadirlo a tu barra de estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un composant du menu vers Composants actifs pour l’ajouter à votre barre d’état."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un componente dal menu in Componenti attivi per aggiungerlo alla barra di stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューからコンポーネントを「アクティブなコンポーネント」にドラッグすると、ステータスバーに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴에서 구성요소를 활성 구성요소로 드래그하여 상태 막대에 추가하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste um componente do menu para Componentes ativos a fim de adicioná-lo à sua barra de status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите компонент из меню в «Активные компоненты», чтобы добавить его в строку состояния."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将组件从菜单拖到“活动组件”，即可将其添加到你的状态栏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將元件從選單拖到「使用中的元件」，即可將其加入你的狀態列。"
          }
        }
      }
    },
    "5a8-iM-Enf.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Prefer tight packing to stable positioning\"; ObjectID = \"5a8-iM-Enf\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enge Anordnung gegenüber stabiler Positionierung bevorzugen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prefer tight packing to stable positioning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferir el empaquetado compacto a la posición estable"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préférer un agencement compact à un positionnement stable"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci la disposizione compatta alla posizione stabile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定した配置よりも詰め込み配置を優先"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정적인 위치보다 빽빽한 배치 우선"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferir empacotamento compacto ao posicionamento estável"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочитать плотную упаковку стабильному расположению"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先紧凑排列而非稳定定位"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先緊湊排列而非穩定定位"
          }
        }
      }
    },
