    "ZqX-2h-twi.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Draws a thin line between the status bar and the terminal content.\"; ObjectID = \"ZqX-2h-twi\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslí tenkou čáru mezi stavovým řádkem a obsahem terminálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner en tynd linje mellem statuslinjen og terminalens indhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet eine dünne Linie zwischen der Statusleiste und dem Terminalinhalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draws a thin line between the status bar and the terminal content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja una línea fina entre la barra de estado y el contenido de la terminal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtää ohuen viivan tilapalkin ja päätteen sisällön väliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine une ligne fine entre la barre d’état et le contenu du terminal."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crta tanku liniju između trake statusa i sadržaja terminala."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vékony vonalat rajzol az állapotsor és a terminál tartalma közé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna una linea sottile tra la barra di stato e il contenuto del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステータスバーとターミナルの内容の間に細い線を描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상태 막대와 터미널 내용 사이에 가는 선을 그립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner en tynn linje mellom statuslinjen og terminalinnholdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent een dunne lijn tussen de statusbalk en de terminalinhoud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje cienką linię między paskiem stanu a zawartością terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha uma linha fina entre a barra de status e o conteúdo do terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует тонкую линию между строкой состояния и содержимым терминала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakreslí tenkú čiaru medzi stavovou lištou a obsahom terminálu."
          }
        },
        "sl" : {
          "stringUnit" : {
