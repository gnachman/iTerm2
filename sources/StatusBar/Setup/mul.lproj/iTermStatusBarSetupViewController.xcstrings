        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпочитать плотную упаковку стабильному расположению"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优先紧凑排列而非稳定定位"
          }
