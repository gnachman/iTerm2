    "eaY-DS-MPQ.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Remove components with empty values\"; ObjectID = \"eaY-DS-MPQ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit součásti s prázdnými hodnotami"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern komponenter med tomme værdier"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komponenten mit leeren Werten entfernen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove components with empty values"
