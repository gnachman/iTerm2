    "HuW-TG-xrj.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"To help manage a large number of tabs, you can now combine tabs into collapsible groups. The tab bar now scrolls instead of showing an overflow menu, too.\"; ObjectID = \"HuW-TG-xrj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Umgang mit einer großen Anzahl von Tabs zu erleichtern, können Sie Tabs jetzt zu einklappbaren Gruppen zusammenfassen. Außerdem lässt sich die Tableiste jetzt scrollen, statt ein Überlaufmenü anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To help manage a large number of tabs, you can now combine tabs into collapsible groups. The tab bar now scrolls instead of showing an overflow menu, too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多数のタブを管理しやすくするため、タブを折りたたみ可能なグループにまとめられるようになりました。また、タブバーはオーバーフローメニューを表示する代わりにスクロールするようになりました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ajudar a gerenciar um grande número de abas, agora você pode combinar abas em grupos recolhíveis. A barra de abas agora rola em vez de mostrar um menu de excedentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы упростить работу с большим количеством вкладок, теперь их можно объединять в сворачиваемые группы. Кроме того, панель вкладок теперь прокручивается, а не показывает меню переполнения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了便于管理大量标签页，现在可以将标签页合并为可折叠的标签页组。标签页栏也会自动滚动，而不是显示溢出菜单。"
          }
        }
      }
    },
