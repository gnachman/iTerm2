    "d4H-cG-h3K.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"The new Screenshots feature simplifies creating a PNG of your terminal content. It supports redactions and highlights. Use <a href=\\\"iterm2whatsnew:screenshot\\\">Session > Make Screenshot</a> to activate it.\"; ObjectID = \"d4H-cG-h3K\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová funkce Snímky obrazovky usnadňuje vytvoření PNG z obsahu terminálu. Podporuje redakce a zvýraznění. Aktivujete ji příkazem <a href=\"iterm2whatsnew:screenshot\">Relace > Pořídit snímek obrazovky</a>."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nye funktion Skærmbilleder gør det nemt at lave en PNG af dit terminalindhold. Den understøtter censurering og fremhævning. Brug <a href=\"iterm2whatsnew:screenshot\">Session > Tag skærmbillede</a> for at aktivere den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Funktion Screenshots vereinfacht das Erstellen einer PNG-Datei Ihres Terminal-Inhalts. Sie unterstützt Schwärzungen und Hervorhebungen. Verwenden Sie <a href=\"iterm2whatsnew:screenshot\">Sitzung > Screenshot erstellen</a>, um sie zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η νέα δυνατότητα Στιγμιότυπα οθόνης απλοποιεί τη δημιουργία ενός PNG από το περιεχόμενο του τερματικού σας. Υποστηρίζει απαλείψεις και επισημάνσεις. Χρησιμοποιήστε το <a href=\"iterm2whatsnew:screenshot\">Συνεδρία > Λήψη στιγμιότυπου οθόνης</a> για να την ενεργοποιήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The new Screenshots feature simplifies creating a PNG of your terminal content. It supports redactions and highlights. Use <a href=\"iterm2whatsnew:screenshot\">Session > Make Screenshot</a> to activate it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva función Capturas de pantalla simplifica la creación de un PNG del contenido de tu terminal. Admite censuras y resaltados. Usa <a href=\"iterm2whatsnew:screenshot\">Sesión > Hacer captura de pantalla</a> para activarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi Kuvakaappaukset-ominaisuus helpottaa PNG-kuvan luomista päätteesi sisällöstä. Se tukee sensurointia ja korostuksia. Ota se käyttöön valitsemalla <a href=\"iterm2whatsnew:screenshot\">Istunto > Ota kuvakaappaus</a>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle fonctionnalité Captures d’écran simplifie la création d’un PNG du contenu de votre terminal. Elle prend en charge le caviardage et la mise en évidence. Utilisez <a href=\"iterm2whatsnew:screenshot\">Session > Capturer l’écran</a> pour l’activer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई स्क्रीनशॉट सुविधा आपके टर्मिनल की सामग्री का PNG बनाना आसान करती है। यह रिडैक्शन और हाइलाइट का समर्थन करती है। इसे सक्रिय करने के लिए <a href=\"iterm2whatsnew:screenshot\">सत्र > स्क्रीनशॉट लें</a> का उपयोग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova značajka Snimke zaslona pojednostavljuje izradu PNG-a sadržaja vašeg terminala. Podržava zacrnjivanja i isticanja. Aktivirajte je s <a href=\"iterm2whatsnew:screenshot\">Sesija > Snimi zaslon</a>."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új Képernyőképek funkció leegyszerűsíti a terminál tartalmáról készített PNG létrehozását. Támogatja a kitakarásokat és a kiemeléseket. Az aktiváláshoz használja a <a href=\"iterm2whatsnew:screenshot\">Munkamenet > Képernyőkép készítése</a> parancsot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitur Tangkapan Layar yang baru menyederhanakan pembuatan PNG dari konten terminal Anda. Fitur ini mendukung penyamaran dan sorotan. Gunakan <a href=\"iterm2whatsnew:screenshot\">Sesi > Buat Tangkapan Layar</a> untuk mengaktifkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuova funzione Screenshot semplifica la creazione di un PNG del contenuto del terminale. Supporta oscuramenti ed evidenziazioni. Usa <a href=\"iterm2whatsnew:screenshot\">Sessione > Crea screenshot</a> per attivarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい「スクリーンショット」機能を使うと、ターミナルの内容のPNG画像を簡単に作成できます。編集（黒塗り）やハイライトにも対応しています。有効にするには<a href=\"iterm2whatsnew:screenshot\">セッション > スクリーンショットを作成</a>を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 스크린샷 기능으로 터미널 내용을 PNG로 쉽게 만들 수 있습니다. 가리기 및 강조 표시를 지원합니다. 사용하려면 <a href=\"iterm2whatsnew:screenshot\">세션 > 스크린샷 찍기</a>를 선택하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciri Tangkapan Skrin yang baharu memudahkan pembuatan PNG kandungan terminal anda. Ia menyokong penghitaman dan serlahan. Gunakan <a href=\"iterm2whatsnew:screenshot\">Sesi > Buat Tangkapan Skrin</a> untuk mengaktifkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nye skjermbildefunksjonen gjør det enkelt å lage en PNG av terminalinnholdet. Den støtter sladding og utheving. Bruk <a href=\"iterm2whatsnew:screenshot\">«Økt > Ta skjermbilde…»</a> for å aktivere den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de nieuwe functie Schermafbeeldingen maak je eenvoudig een PNG van je terminalinhoud. Ze ondersteunt onleesbaar maken en markeringen. Gebruik <a href=\"iterm2whatsnew:screenshot\">Sessie > Maak schermafbeelding</a> om de functie te activeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowa funkcja Zrzuty ekranu upraszcza tworzenie pliku PNG z zawartości terminala. Obsługuje zaczernienia i wyróżnienia. Użyj <a href=\"iterm2whatsnew:screenshot\">Sesja > Zrób zrzut ekranu</a>, aby ją włączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo recurso Capturas de tela simplifica a criação de um PNG do conteúdo do seu terminal. Ele oferece suporte a ocultações e destaques. Use <a href=\"iterm2whatsnew:screenshot\">Sessão > Criar captura de tela</a> para ativá-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noua funcție Capturi de ecran simplifică crearea unui PNG cu conținutul terminalului. Acceptă cenzurări și evidențieri. Folosiți <a href=\"iterm2whatsnew:screenshot\">Sesiune > Faceți o captură de ecran…</a> pentru a o activa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая функция «Снимки экрана» упрощает создание PNG-файла с содержимым терминала. Она поддерживает скрытие данных и выделения. Используйте <a href=\"iterm2whatsnew:screenshot\">Сеанс > Сделать снимок экрана</a>, чтобы активировать её."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová funkcia Snímky obrazovky zjednodušuje vytvorenie PNG z obsahu terminálu. Podporuje redigovanie a zvýraznenie. Aktivujete ju cez <a href=\"iterm2whatsnew:screenshot\">Relácia > Vytvoriť snímku obrazovky</a>."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova funkcija Posnetki zaslona poenostavi ustvarjanje slike PNG z vsebino terminala. Podpira zakritja in označbe. Aktivirate jo z <a href=\"iterm2whatsnew:screenshot\">Seja > Naredi posnetek zaslona</a>."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nya funktionen Skärmavbilder gör det enkelt att skapa en PNG av terminalens innehåll. Den stöder censurering och markeringar. Använd <a href=\"iterm2whatsnew:screenshot\">Session > Ta skärmavbild</a> för att aktivera den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni Ekran Görüntüleri özelliği, terminal içeriğinizin PNG’sini oluşturmayı kolaylaştırır. Karartma ve vurgulamayı destekler. Etkinleştirmek için <a href=\"iterm2whatsnew:screenshot\">Oturum > Ekran Görüntüsü Oluştur</a> komutunu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нова функція «Знімки екрана» спрощує створення PNG вмісту вашого терміналу. Вона підтримує затирання й підсвічування. Щоб увімкнути її, скористайтеся <a href=\"iterm2whatsnew:screenshot\">«Сеанс > Зробити знімок екрана…»</a>."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng Ảnh chụp màn hình mới giúp việc tạo PNG từ nội dung terminal của bạn trở nên đơn giản hơn. Nó hỗ trợ che thông tin và đánh dấu nổi bật. Dùng <a href=\"iterm2whatsnew:screenshot\">Phiên > Chụp ảnh màn hình</a> để kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的“截屏”功能简化了将终端内容保存为 PNG 的操作。它支持遮盖和高亮。使用<a href=\"iterm2whatsnew:screenshot\">会话 > 截屏</a>来激活它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全新的「螢幕截圖」功能簡化了將終端機內容製作成 PNG 的流程。它支援遮蔽和醒目標示。使用<a href=\"iterm2whatsnew:screenshot\">工作階段 > 製作螢幕截圖</a>來啟用它。"
          }
        }
      }
    },
