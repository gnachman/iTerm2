    "HuW-TG-xrj.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"To help manage a large number of tabs, you can now combine tabs into collapsible groups. The tab bar now scrolls instead of showing an overflow menu, too.\"; ObjectID = \"HuW-TG-xrj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abyste snáze zvládali velký počet panelů, můžete je nyní spojovat do sbalitelných skupin. Řádek panelů se také nově posouvá, místo aby zobrazoval nabídku přetečení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at gøre det lettere at håndtere mange faner kan du nu kombinere faner i sammenfoldelige grupper. Fanelinjen ruller nu også i stedet for at vise en overløbsmenu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den Umgang mit einer großen Anzahl von Tabs zu erleichtern, können Sie Tabs jetzt zu einklappbaren Gruppen zusammenfassen. Außerdem lässt sich die Tableiste jetzt scrollen, statt ein Überlaufmenü anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να διαχειρίζεστε πιο εύκολα μεγάλο αριθμό καρτελών, μπορείτε πλέον να συνδυάζετε καρτέλες σε ομάδες που συμπτύσσονται. Επίσης, η γραμμή καρτελών πλέον κυλά αντί να εμφανίζει μενού υπερχείλισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To help manage a large number of tabs, you can now combine tabs into collapsible groups. The tab bar now scrolls instead of showing an overflow menu, too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ayudarte a gestionar un gran número de pestañas, ahora puedes combinarlas en grupos plegables. Además, la barra de pestañas ahora se desplaza en lugar de mostrar un menú de desbordamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuren välilehtimäärän hallintaa helpottaaksesi voit nyt yhdistää välilehtiä kutistettaviksi ryhmiksi. Välilehtipalkki myös vierittyy nyt ylivuotovalikon näyttämisen sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour mieux gérer un grand nombre d’onglets, vous pouvez désormais les regrouper en groupes repliables. La barre d’onglets défile maintenant au lieu d’afficher un menu de débordement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत सारे टैब सँभालने में मदद के लिए अब आप टैब को संक्षिप्त किए जा सकने वाले समूह में जोड़ सकते हैं। साथ ही, टैब बार अब ओवरफ़्लो मेन्यू दिखाने के बजाय स्क्रोल होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za lakše upravljanje velikim brojem kartica sada ih možete spojiti u grupe koje se mogu sažeti. Traka s karticama sada se i listanjem pomiče umjesto da prikazuje izbornik prelijevanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lapok nagy számának kezeléséhez a lapokat mostantól összecsukható csoportokba vonhatja. A lapsor ezentúl görget a túlcsorduló lapok menüjének megjelenítése helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membantu mengelola banyak tab, Anda kini dapat menggabungkan tab ke dalam grup yang dapat diciutkan. Bar tab kini juga dapat digulir, bukan menampilkan menu luapan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aiutarti a gestire un gran numero di pannelli, ora puoi riunirli in gruppi comprimibili. Inoltre la barra dei pannelli ora scorre invece di mostrare un menu di overflow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多数のタブを管理しやすくするため、タブを折りたたみ可能なグループにまとめられるようになりました。また、タブバーはオーバーフローメニューを表示する代わりにスクロールするようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "많은 탭을 관리하기 쉽도록 이제 탭을 접을 수 있는 그룹으로 묶을 수 있습니다. 또한 탭 막대는 이제 오버플로 메뉴를 표시하는 대신 스크롤됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membantu mengurus sejumlah besar tab, anda kini boleh menggabungkan tab ke dalam kumpulan yang boleh diruntuhkan. Bar tab juga kini boleh diskrol dan tidak lagi menunjukkan menu limpahan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å hjelpe deg med å holde orden på mange faner kan du nå slå faner sammen i sammenleggbare grupper. Fanelinjen ruller nå også i stedet for å vise en overflytsmeny."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om veel tabbladen beter te beheren, kun je tabbladen nu combineren in inklapbare groepen. De tabbladbalk scrolt nu ook in plaats van een overloopmenu te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby łatwiej zarządzać dużą liczbą kart, możesz teraz łączyć karty w zwijane grupy. Pasek kart przewija się teraz zamiast pokazywać menu przepełnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ajudar a gerenciar um grande número de abas, agora você pode combinar abas em grupos recolhíveis. A barra de abas agora rola em vez de mostrar um menu de excedentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a gestiona mai ușor un număr mare de file, acum le puteți combina în grupuri restrângibile. De asemenea, bara filelor se derulează acum, în loc să afișeze un meniu de depășire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы упростить работу с большим количеством вкладок, теперь их можно объединять в сворачиваемые группы. Кроме того, панель вкладок теперь прокручивается, а не показывает меню переполнения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na lepšiu správu veľkého počtu tabov môžete taby teraz spájať do zbaliteľných skupín. Lišta s tabmi sa tiež rolovaním posúva, namiesto zobrazenia menu s prebytočnými tabmi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za lažje upravljanje velikega števila zavihkov jih zdaj lahko združite v zložljive skupine. Vrstica z zavihki se zdaj tudi pomika, namesto da bi prikazovala meni s preostalimi zavihki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att hjälpa dig hantera många flikar kan du nu kombinera flikar i hopfällbara grupper. Flikfältet rullar nu också i stället för att visa en överflödesmeny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok sayıda sekmeyi yönetmenize yardımcı olmak için artık sekmeleri daraltılabilir gruplar halinde birleştirebilirsiniz. Ayrıca sekme çubuğu artık taşma menüsü göstermek yerine kayıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб легше керувати великою кількістю вкладок, їх тепер можна обʼєднувати у згорнуті групи. Також панель вкладок тепер прокручується замість показу меню переповнення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để giúp quản lý số lượng lớn tab, giờ đây bạn có thể gộp các tab thành các nhóm có thể thu gọn. Thanh tab cũng cuộn thay vì hiển thị menu tràn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了便于管理大量标签页，现在可以将标签页合并为可折叠的标签页组。标签页栏也会自动滚动，而不是显示溢出菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了方便管理大量標籤頁，現在可以將標籤頁合併成可摺疊的群組。標籤頁列現在也會捲動，而不是顯示溢位選單。"
          }
        }
      }
    },
