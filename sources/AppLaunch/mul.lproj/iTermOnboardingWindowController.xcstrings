    "Lvg-vI-G64.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"The Claude Code integration organizes multiple related sessions—such as code review and reading diffs—into a customizable UI. It also exposes Claude’s status so you can easily find instances that are blocked on your attention. <a href=\\\"iterm2whatsnew:claudecode\\\">Try it now!</a>\"; ObjectID = \"Lvg-vI-G64\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Claude Code-Integration organisiert mehrere zusammengehörige Sitzungen, etwa für Code-Reviews und das Lesen von Diffs, in einer anpassbaren Oberfläche. Außerdem zeigt sie Claudes Status an, sodass Sie leicht Instanzen finden können, die auf Ihre Aufmerksamkeit warten. <a href=\"iterm2whatsnew:claudecode\">Jetzt ausprobieren!</a>"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Claude Code integration organizes multiple related sessions—such as code review and reading diffs—into a customizable UI. It also exposes Claude’s status so you can easily find instances that are blocked on your attention. <a href=\"iterm2whatsnew:claudecode\">Try it now!</a>"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code連携は、コードレビューや差分の確認など、複数の関連セッションをカスタマイズ可能なUIにまとめます。また、Claudeの状態を表示するので、あなたの対応が必要なインスタンスを簡単に見つけられます。<a href=\"iterm2whatsnew:claudecode\">今すぐ試す!</a>"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A integração com o Claude Code organiza várias sessões relacionadas (como revisão de código e leitura de diffs) em uma interface personalizável. Ela também mostra o status do Claude para que você encontre facilmente as instâncias que aguardam sua atenção. <a href=\"iterm2whatsnew:claudecode\">Experimente agora!</a>"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интеграция с Claude Code объединяет несколько связанных сеансов (например, просмотр кода и чтение различий) в единый настраиваемый интерфейс. Она также показывает статус Claude, чтобы вам было проще найти экземпляры, ожидающие вашего внимания. <a href=\"iterm2whatsnew:claudecode\">Попробуйте прямо сейчас!</a>"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 集成将多个相关会话（如代码审查和阅读差异）组织到可自定义的界面中。它还会显示 Claude 的状态，让你轻松找到需要你处理的实例。<a href=\"iterm2whatsnew:claudecode\">立即试用！</a>"
          }
        }
      }
    },
