    "3ik-Ec-g95.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Downloads the latest version. Runs curl | bash\"; ObjectID = \"3ik-Ec-g95\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt die neueste Version herunter. Führt curl | bash aus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Downloads the latest version. Runs curl | bash"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新バージョンをダウンロードします。curl | bashを実行します"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa a versão mais recente. Executa curl | bash"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает последнюю версию. Выполняет curl | bash"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载最新版本。运行 curl | bash"
          }
        }
      }
    },
