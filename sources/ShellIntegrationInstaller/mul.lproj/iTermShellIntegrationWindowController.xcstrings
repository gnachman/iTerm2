    "3ik-Ec-g95.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Downloads the latest version. Runs curl | bash\"; ObjectID = \"3ik-Ec-g95\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henter den nyeste version. Kører curl | bash"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt die neueste Version herunter. Führt curl | bash aus"
          }
        },
        "en" : {
