    "UYA-J9-ck1.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"How would you like to install Shell Integration?\\n\\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you.\"; ObjectID = \"UYA-J9-ck1\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com vols instal·lar la integració amb l’intèrpret d’ordres?\n\nEn aquest procés es modificaran els scripts d’inici del teu intèrpret d’ordres. Aquest instal·lador introduirà les ordres a la finestra del terminal per tu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak chcete nainstalovat integraci shellu?\n\nPři tomto postupu budou upraveny spouštěcí skripty vašeho shellu. Instalátor za vás zadá příkazy do okna terminálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan vil du installere shell-integration?\n\nI denne proces ændres din shells startinstrukser. Installationsprogrammet skriver kommandoer i terminalvinduet for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie möchten Sie die Shell-Integration installieren?\n\nBei diesem Vorgang werden die Startskripte Ihrer Shell geändert. Dieses Installationsprogramm gibt die Befehle für Sie im Terminalfenster ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς θέλετε να εγκαταστήσετε την ενσωμάτωση κελύφους;\n\nΣε αυτή τη διαδικασία θα τροποποιηθούν τα σκριπτ εκκίνησης του κελύφους σας. Αυτό το πρόγραμμα εγκατάστασης θα πληκτρολογήσει εντολές στο παράθυρο του τερματικού για λογαριασμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How would you like to install Shell Integration?\n\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How would you like to install Shell Integration?\n\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How would you like to install Shell Integration?\n\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How would you like to install Shell Integration?\n\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How would you like to install Shell Integration?\n\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How would you like to install Shell Integration?\n\nIn this process, your shell’s startup scripts will be modified. This installer will enter commands in the terminal window for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo quieres instalar la integración con el shell?\n\nEn este proceso se modificarán los scripts de inicio de tu shell. Este instalador introducirá los comandos en la ventana de la terminal por ti."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo quieres instalar la integración con el shell?\n\nEn este proceso se modificarán los scripts de inicio de tu shell. Este instalador ingresará los comandos en la ventana de la terminal por ti."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo quieres instalar la integración con el shell?\n\nEn este proceso se modificarán los scripts de inicio de tu shell. Este instalador ingresará los comandos en la ventana de la terminal por ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten haluat asentaa komentotulkki-integraation?\n\nTässä prosessissa komentotulkkisi käynnistysskriptejä muokataan. Tämä asennusohjelma syöttää komennot päätteen ikkunaan puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment souhaitez-vous installer l’intégration du shell ?\n\nDans ce processus, les scripts de démarrage de votre shell seront modifiés. Ce programme d’installation saisira des commandes dans la fenêtre du terminal à votre place."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment souhaitez-vous installer l’intégration de la coque logicielle?\n\nDans ce processus, les scripts de démarrage de votre coque logicielle seront modifiés. Ce programme d’installation entrera des commandes dans la fenêtre du terminal à votre place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप शेल इंटीग्रेशन कैसे इंस्टॉल करना चाहेंगे?\n\nइस प्रक्रिया में आपके शेल की स्टार्टअप स्क्रिप्ट बदली जाएँगी। यह इंस्टॉलर आपके लिए टर्मिनल विंडो में कमांड दर्ज करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako želite instalirati integraciju ljuske?\n\nTijekom ovog postupka izmijenit će se startne skripte vaše ljuske. Instalacijski program upisat će naredbe u prozor terminala umjesto vas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogyan szeretné telepíteni a shellintegrációt?\n\nA folyamat során a shell indítószkriptjei módosulnak. A telepítő a parancsokat Ön helyett beírja a terminálablakba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana Anda ingin memasang Integrasi Shell?\n\nDalam proses ini, skrip startup shell Anda akan dimodifikasi. Penginstal ini akan memasukkan perintah di jendela terminal untuk Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come vuoi installare l’integrazione shell?\n\nDurante questo processo gli script di avvio della tua shell verranno modificati. Questo programma di installazione inserirà i comandi nella finestra del terminale al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合をどのようにインストールしますか？\n\nこの処理では、シェルの起動スクリプトが変更されます。このインストーラーがターミナルウィンドウにコマンドを入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합을 어떻게 설치하겠습니까?\n\n이 과정에서 셸의 시동 스크립트가 수정됩니다. 이 설치 프로그램이 터미널 윈도우에 명령을 대신 입력합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimanakah anda mahu memasang Integrasi Cangkerang?\n\nDalam proses ini, skrip permulaan cangkerang anda akan diubah suai. Pemasang ini akan memasukkan perintah dalam tetingkap terminal untuk anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan vil du installere skallintegrering?\n\nI denne prosessen endres oppstartsskriptene til skallet ditt. Installasjonsprogrammet skriver inn kommandoer i terminalvinduet for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe wil je shell-integratie installeren?\n\nBij dit proces worden de opstartscripts van je shell aangepast. Dit installatieprogramma voert commando’s voor je in het terminalvenster in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak chcesz zainstalować integrację z powłoką?\n\nW trakcie tego procesu zostaną zmodyfikowane skrypty startowe Twojej powłoki. Instalator wpisze za Ciebie polecenia w oknie terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como você gostaria de instalar a Shell Integration?\n\nNesse processo, os scripts de inicialização do seu shell serão modificados. Este instalador digitará os comandos na janela do terminal para você."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como gostaria de instalar a Shell Integration?\n\nNeste processo, os scripts de inicialização da sua shell serão modificados. Este instalador introduzirá os comandos na janela do terminal por si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum doriți să instalați integrarea shell?\n\nÎn acest proces, scripturile de pornire ale shellului dvs. vor fi modificate. Acest instalator va introduce comenzi în fereastra de terminal în locul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как вы хотите установить Shell-интеграцию?\n\nВ ходе этого процесса будут изменены стартовые скрипты вашего shell. Этот установщик будет вводить команды в окне терминала за вас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako chcete nainštalovať integráciu shellu?\n\nPočas tohto procesu sa upravia spúšťacie skripty vášho shellu. Inštalátor zadá príkazy do okna terminálu za vás."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako želite namestiti integracijo lupine?\n\nPri tem bodo spremenjeni zagonski skripti vaše lupine. Namestitveni program bo namesto vas vnesel ukaze v okno terminala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur vill du installera skalintegrering?\n\nUnder processen ändras skalets startskript. Installationsprogrammet skriver kommandon i terminalfönstret åt dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณต้องการติดตั้งการผสานรวมเชลล์อย่างไร\n\nในขั้นตอนนี้ สคริปต์เริ่มต้นของเชลล์จะถูกแก้ไข ตัวติดตั้งนี้จะป้อนคำสั่งในหน้าต่างเทอร์มินัลให้คุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonunu nasıl yüklemek istersiniz?\n\nBu işlemde kabuğunuzun başlangıç betikleri değiştirilecektir. Bu yükleyici komutları sizin yerinize terminal penceresine girecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як інсталювати інтеграцію з командним процесором?\n\nУ цьому процесі буде змінено скрипти запуску вашого командного процесора. Інсталятор вводитиме команди у вікні термінала замість вас."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn muốn cài đặt tích hợp shell bằng cách nào?\n\nTrong quá trình này, các tập lệnh khởi động của shell sẽ bị sửa đổi. Trình cài đặt sẽ nhập lệnh vào cửa sổ terminal giúp bạn."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想如何安装Shell集成？\n\n此过程会修改你的shell启动脚本。安装器会替你在终端窗口中输入命令。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想如何安裝 Shell 整合？\n\n在此過程中，你的 shell 啟動腳本將會被修改。此安裝程式會為你在終端機視窗中輸入指令。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想如何安装 Shell 集成？\n\n在此过程中，你的 Shell 启动脚本将被修改。此安装程序会为你将命令输入到终端窗口中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想如何安裝 Shell 整合？\n\n在此過程中，你的 shell 啟動腳本將會被修改。此安裝程式會為你在終端機視窗中輸入指令。"
          }
        }
      }
    },
