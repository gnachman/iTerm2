    "WeK-Fh-3OJ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Create a new tab to try it out.\\n\\nFor best results, install shell integration on all hosts you ssh in to.\"; ObjectID = \"WeK-Fh-3OJ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en ny fane for at prøve det.\n\nFor de bedste resultater skal du installere shell-integration på alle værter, du logger ind på via ssh."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie einen neuen Tab, um es auszuprobieren.\n\nFür beste Ergebnisse installieren Sie die Shell-Integration auf allen Hosts, mit denen Sie sich per SSH verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create a new tab to try it out.\n\nFor best results, install shell integration on all hosts you ssh in to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una pestaña nueva para probarlo.\n\nPara obtener los mejores resultados, instala la integración con el shell en todos los hosts a los que te conectes por ssh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un nouvel onglet pour l’essayer.\n\nPour de meilleurs résultats, installez l’intégration du shell sur tous les hôtes auxquels vous vous connectez en ssh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nuovo pannello per provarla.\n\nPer risultati ottimali, installa l’integrazione shell su tutti gli host a cui ti colleghi in ssh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいタブを作成して試してみてください。\n\n最良の結果を得るには、SSHで接続するすべてのホストにシェル統合をインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 탭을 만들어 사용해 보십시오.\n\n최상의 결과를 얻으려면 ssh로 접속하는 모든 호스트에 셸 통합을 설치하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprett en ny fane for å prøve det ut.\n\nFor best resultat bør du installere skallintegrering på alle verter du logger inn på med ssh."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een nieuw tabblad om het uit te proberen.\n\nVoor het beste resultaat installeer je shell-integratie op alle hosts waarmee je via ssh verbinding maakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz nową kartę, aby to wypróbować.\n\nAby uzyskać najlepsze rezultaty, zainstaluj integrację z powłoką na wszystkich hostach, z którymi łączysz się przez ssh."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma nova aba para testar.\n\nPara obter os melhores resultados, instale a Shell Integration em todos os hosts nos quais você entra via ssh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте новую вкладку, чтобы опробовать это.\n\nДля лучшего результата установите shell-интеграцию на всех хостах, к которым вы подключаетесь по ssh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa en ny flik för att prova.\n\nFör bästa resultat, installera skalintegrering på alla värdar du ansluter till med ssh."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denemek için yeni bir sekme oluşturun.\n\nEn iyi sonuç için kabuk entegrasyonunu ssh ile bağlandığınız tüm ana makinelere yükleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo một tab mới để dùng thử.\n\nĐể có kết quả tốt nhất, hãy cài đặt tích hợp shell trên mọi máy chủ mà bạn ssh vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新建一个标签页试用。\n\n为获得最佳效果，请在你要 ssh 登录的所有主机上安装 Shell 集成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增一個標籤頁來試用。\n\n為獲得最佳效果，請在你以 ssh 登入的所有主機上安裝 Shell 整合。"
          }
        }
      }
    },
    "wl0-hO-Vi5.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Shell Integration consists of scripts that help your shell communicate with iTerm2 so it can track the commands you’re running, your current directory, and other state. \"; ObjectID = \"wl0-hO-Vi5\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-integration består af instrukser, der hjælper din shell med at kommunikere med iTerm2, så den kan holde styr på de kommandoer, du kører, din aktuelle mappe og andre tilstande. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Shell-Integration besteht aus Skripten, die Ihrer Shell helfen, mit iTerm2 zu kommunizieren, damit die ausgeführten Befehle, Ihr aktuelles Verzeichnis und weitere Zustände nachverfolgt werden können. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shell Integration consists of scripts that help your shell communicate with iTerm2 so it can track the commands you’re running, your current directory, and other state. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La integración con el shell consiste en scripts que ayudan a tu shell a comunicarse con iTerm2 para que pueda registrar los comandos que ejecutas, tu directorio actual y otros estados. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intégration du shell se compose de scripts qui aident votre shell à communiquer avec iTerm2 afin qu’il puisse suivre les commandes que vous exécutez, votre répertoire actuel et d’autres états. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’integrazione shell è composta da script che aiutano la tua shell a comunicare con iTerm2, in modo che possa tenere traccia dei comandi che esegui, della directory corrente e di altri stati. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合は、シェルがiTerm2と通信できるようにするスクリプト群で構成されており、実行中のコマンドや現在のディレクトリなどの状態を追跡できるようにします。 "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합은 셸이 iTerm2와 통신하도록 돕는 스크립트로 구성되어 있어, 실행 중인 명령, 현재 디렉토리 및 기타 상태를 추적할 수 있습니다. "
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skallintegrering består av skript som hjelper skallet ditt med å kommunisere med iTerm2, slik at den kan holde styr på kommandoene du kjører, gjeldende mappe og annen tilstand. "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-integratie bestaat uit scripts waarmee je shell met iTerm2 kan communiceren, zodat iTerm2 de commando’s die je uitvoert, je huidige map en andere status kan bijhouden. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integracja z powłoką to skrypty, które pomagają powłoce komunikować się z iTerm2, dzięki czemu może śledzić uruchamiane polecenia, bieżący katalog i inny stan. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Shell Integration consiste em scripts que ajudam o seu shell a se comunicar com o iTerm2 para que ele possa rastrear os comandos que você está executando, o seu diretório atual e outros estados. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-интеграция состоит из скриптов, которые помогают вашему shell взаимодействовать с iTerm2, чтобы отслеживать выполняемые вами команды, текущий каталог и другое состояние. "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalintegrering består av skript som hjälper ditt skal att kommunicera med iTerm2 så att det kan hålla reda på de kommandon du kör, din aktuella katalog och annat tillstånd. "
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu, kabuğunuzun iTerm2 ile iletişim kurmasına yardımcı olan betiklerden oluşur; böylece iTerm2 çalıştırdığınız komutları, geçerli dizininizi ve diğer durumları izleyebilir. "
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tích hợp shell gồm các tập lệnh giúp shell của bạn giao tiếp với iTerm2 để iTerm2 có thể theo dõi các lệnh bạn đang chạy, thư mục hiện tại và các trạng thái khác. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 集成包含帮助你的 Shell 与 iTerm2 通信的脚本，使其能够跟踪你正在运行的命令、当前目录以及其他状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 整合包含協助你的 shell 與 iTerm2 通訊的腳本，使其能夠追蹤你正在執行的指令、目前的目錄以及其他狀態。 "
          }
        }
      }
    },
