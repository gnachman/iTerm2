    "cyF-wg-XYY.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Utilities include scripts to download files, display images inline, and more. \"; ObjectID = \"cyF-wg-XYY\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælpeprogrammer omfatter instrukser til at hente arkiver, vise billeder i teksten og meget mere. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu den Dienstprogrammen gehören Skripte zum Herunterladen von Dateien, zur Inline-Anzeige von Bildern und mehr. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Utilities include scripts to download files, display images inline, and more. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las utilidades incluyen scripts para descargar archivos, mostrar imágenes en línea y más. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilitaires comprennent des scripts pour télécharger des fichiers, afficher des images en ligne, et plus encore. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le utilità includono script per scaricare file, mostrare immagini in linea e altro. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーティリティには、ファイルのダウンロード、画像のインライン表示などを行うスクリプトが含まれます。 "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유틸리티에는 파일 다운로드, 인라인 이미지 표시 등을 위한 스크립트가 포함되어 있습니다. "
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøyene inkluderer skript for å laste ned filer, vise bilder i teksten og mer. "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hulpprogramma’s bevatten scripts om bestanden te downloaden, afbeeldingen inline weer te geven en meer. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
