    "w9k-Lv-5eU.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This will run the following command:\\n\\ncurl -L https://iterm2.com/shell_integration/v2/install_shell_integration_and_utilities.sh | bash\"; ObjectID = \"w9k-Lv-5eU\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’executarà l’ordre següent:\n\ncurl -L https://iterm2.com/shell_integration/v2/install_shell_integration_and_utilities.sh | bash"
          }
        },
        "cs" : {
