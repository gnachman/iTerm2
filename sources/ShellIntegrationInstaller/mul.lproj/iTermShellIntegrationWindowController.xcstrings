    "cyF-wg-XYY.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Utilities include scripts to download files, display images inline, and more. \"; ObjectID = \"cyF-wg-XYY\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu den Dienstprogrammen gehören Skripte zum Herunterladen von Dateien, zur Inline-Anzeige von Bildern und mehr. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Utilities include scripts to download files, display images inline, and more. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーティリティには、ファイルのダウンロード、画像のインライン表示などを行うスクリプトが含まれます。 "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os utilitários incluem scripts para baixar arquivos, exibir imagens em linha e muito mais. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утилиты включают скрипты для загрузки файлов, встроенного отображения изображений и не только. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实用工具包括用于下载文件、内联显示图像等的脚本。"
          }
        }
      }
    },
