    "WeK-Fh-3OJ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Create a new tab to try it out.\\n\\nFor best results, install shell integration on all hosts you ssh in to.\"; ObjectID = \"WeK-Fh-3OJ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una pestanya nova per provar-ho.\n\nPer obtenir els millors resultats, instal·la la integració amb l’intèrpret d’ordres a tots els hosts als quals et connectes per ssh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzkoušejte ji vytvořením nového panelu.\n\nPro nejlepší výsledky nainstalujte integraci shellu na všechny hostitele, ke kterým se připojujete přes ssh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en ny fane for at prøve det.\n\nFor de bedste resultater skal du installere shell-integration på alle værter, du logger ind på via ssh."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie einen neuen Tab, um es auszuprobieren.\n\nFür beste Ergebnisse installieren Sie die Shell-Integration auf allen Hosts, mit denen Sie sich per SSH verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε μια νέα καρτέλα για να το δοκιμάσετε.\n\nΓια καλύτερα αποτελέσματα, εγκαταστήστε την ενσωμάτωση κελύφους σε όλους τους υπολογιστές υπηρεσίας στους οποίους συνδέεστε μέσω ssh."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create a new tab to try it out.\n\nFor best results, install shell integration on all hosts you ssh in to."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a new tab to try it out.\n\nFor best results, install shell integration on all hosts you ssh in to."
