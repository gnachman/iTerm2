    "5dO-zM-mKW.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space.\"; ObjectID = \"5dO-zM-mKW\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Skript muss auf eine „vollständige Umgebung“ aktualisiert werden, um Abhängigkeiten hinzuzufügen. Dabei wird eine Kopie der Python-Laufzeitumgebung erstellt, es wird jedoch kein zusätzlicher Speicherplatz benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este script debe actualizarse a un “entorno completo” para poder añadir dependencias. Al hacerlo se crea una copia del entorno de ejecución de Python, pero no se usará espacio adicional en disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce script doit être converti en « environnement complet » pour pouvoir ajouter des dépendances. Cela crée une copie de l’environnement d’exécution Python, sans utiliser d’espace disque supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungere dipendenze, questo script deve essere aggiornato a un “ambiente completo”. In questo modo viene creata una copia dell’ambiente di esecuzione Python, ma non verrà usato spazio aggiuntivo su disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依存関係を追加するには、このスクリプトを「フル環境」にアップグレードする必要があります。アップグレードするとPythonランタイムのコピーが作成されますが、追加のディスク容量は使用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종속성을 추가하려면 이 스크립트를 “전체 환경“으로 업그레이드해야 합니다. 업그레이드하면 Python 런타임의 복사본이 만들어지지만 추가 디스크 공간은 사용하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit script moet worden bijgewerkt naar een ‘volledige omgeving’ om afhankelijkheden toe te voegen. Daarbij wordt een kopie van de Python-runtime gemaakt, maar er wordt geen extra schijfruimte gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby dodać zależności, ten skrypt trzeba uaktualnić do „pełnego środowiska”. Spowoduje to utworzenie kopii środowiska uruchomieniowego Pythona, ale nie zajmie dodatkowego miejsca na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este script precisa ser atualizado para um “ambiente completo” para adicionar dependências. Isso cria uma cópia do runtime do Python, mas não usará espaço em disco adicional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для добавления зависимостей этот скрипт необходимо обновить до «полного окружения». Это создаст копию среды выполнения Python, но не потребует дополнительного места на диске."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriptet måste uppgraderas till en ”fullständig miljö” för att kunna lägga till beroenden. Då skapas en kopia av Python-körmiljön, men ingen extra diskplats används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağımlılık eklemek için bu betiğin “Tam Ortam” seçeneğine yükseltilmesi gerekir. Bu işlem Python çalışma zamanının bir kopyasını oluşturur ancak ek disk alanı kullanmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập lệnh này phải được nâng cấp lên “môi trường đầy đủ” để thêm các phụ thuộc. Việc này tạo một bản sao của môi trường chạy Python nhưng sẽ không dùng thêm dung lượng đĩa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此脚本必须升级为“完整环境”才能添加依赖。升级会拷贝一份 Python 运行时，但不会占用额外磁盘空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須將此腳本升級為「完整環境」才能加入相依項目。升級會複製一份 Python 執行環境，但不會佔用額外的磁碟空間。"
          }
        }
      }
    },
