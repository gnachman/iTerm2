    "5dO-zM-mKW.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space.\"; ObjectID = \"5dO-zM-mKW\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest script s’ha d’actualitzar a un “entorn complet” per poder afegir dependències. Fer-ho crea una còpia de l’entorn d’execució de Python, però no fa servir espai addicional al disc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby bylo možné přidávat závislosti, je nutné tento skript aktualizovat na „plné prostředí“. Tím se vytvoří kopie běhového prostředí Pythonu, ale nezabere žádné další místo na disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne instruks skal opgraderes til et “fuldt miljø” for at kunne tilføje afhængigheder. Det opretter en kopi af Python-kørselsmiljøet, men bruger ikke ekstra diskplads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Skript muss auf eine „vollständige Umgebung“ aktualisiert werden, um Abhängigkeiten hinzuzufügen. Dabei wird eine Kopie der Python-Laufzeitumgebung erstellt, es wird jedoch kein zusätzlicher Speicherplatz benötigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το σκριπτ πρέπει να αναβαθμιστεί σε «πλήρες περιβάλλον» για να προστεθούν εξαρτήσεις. Έτσι δημιουργείται ένα αντίγραφο του περιβάλλοντος εκτέλεσης της Python, αλλά δεν θα χρησιμοποιηθεί επιπλέον χώρος στον δίσκο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This script must be upgraded to a “full environment“ to add dependencies. Doing so makes a copy of the Python runtime but will not use any additional disk space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este script debe actualizarse a un “entorno completo” para poder añadir dependencias. Al hacerlo se crea una copia del entorno de ejecución de Python, pero no se usará espacio adicional en disco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripti on päivitettävä ”täyteen ympäristöön”, jotta riippuvuuksia voi lisätä. Tällöin Python-suoritusympäristöstä tehdään kopio, mutta se ei käytä ylimääräistä levytilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce script doit être converti en « environnement complet » pour pouvoir ajouter des dépendances. Cela crée une copie de l’environnement d’exécution Python, sans utiliser d’espace disque supplémentaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिपेंडेंसी जोड़ने के लिए इस स्क्रिप्ट को “पूर्ण एनवायरन्मेंट” में अपग्रेड करना होगा। ऐसा करने से Python रनटाइम की एक कॉपी बनती है, लेकिन डिस्क पर अतिरिक्त जगह नहीं लगेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova skripta mora se nadograditi na “puno okruženje” da bi se mogle dodati ovisnosti. Time se izrađuje kopija okruženja za izvođenje Pythona, ali se ne troši dodatni prostor na disku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt a szkriptet a „Teljes környezet” módra kell frissíteni a függőségek hozzáadásához. Ez lemásolja a Python futtatókörnyezetet, de nem használ további lemezterületet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrip ini harus ditingkatkan ke “lingkungan penuh” untuk menambahkan dependensi. Ini membuat salinan runtime Python tetapi tidak akan menggunakan ruang disk tambahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungere dipendenze, questo script deve essere aggiornato a un “ambiente completo”. In questo modo viene creata una copia dell’ambiente di esecuzione Python, ma non verrà usato spazio aggiuntivo su disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依存関係を追加するには、このスクリプトを「フル環境」にアップグレードする必要があります。アップグレードするとPythonランタイムのコピーが作成されますが、追加のディスク容量は使用されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종속성을 추가하려면 이 스크립트를 “전체 환경“으로 업그레이드해야 합니다. 업그레이드하면 Python 런타임의 복사본이 만들어지지만 추가 디스크 공간은 사용하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrip ini mesti dinaik taraf kepada “persekitaran penuh” untuk menambah kebergantungan. Berbuat demikian akan membuat salinan masa jalan Python tetapi tidak akan menggunakan sebarang ruang cakera tambahan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette skriptet må oppgraderes til et «fullstendig miljø» for å kunne legge til avhengigheter. Da lages det en kopi av Python-kjøremiljøet, men det bruker ikke ekstra diskplass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit script moet worden bijgewerkt naar een ‘volledige omgeving’ om afhankelijkheden toe te voegen. Daarbij wordt een kopie van de Python-runtime gemaakt, maar er wordt geen extra schijfruimte gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby dodać zależności, ten skrypt trzeba uaktualnić do „pełnego środowiska”. Spowoduje to utworzenie kopii środowiska uruchomieniowego Pythona, ale nie zajmie dodatkowego miejsca na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este script precisa ser atualizado para um “ambiente completo” para adicionar dependências. Isso cria uma cópia do runtime do Python, mas não usará espaço em disco adicional."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest script trebuie actualizat la un „mediu complet” pentru a adăuga dependențe. Astfel se creează o copie a mediului de rulare Python, dar nu se va folosi spațiu suplimentar pe disc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для добавления зависимостей этот скрипт необходимо обновить до «полного окружения». Это создаст копию среды выполнения Python, но не потребует дополнительного места на диске."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby bolo možné pridať závislosti, tento skript sa musí povýšiť na „plné prostredie“. Vytvorí sa tým kópia behového prostredia Python, ale nezaberie sa žiadne ďalšie miesto na disku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta skript je treba nadgraditi v »polno okolje«, da lahko dodate odvisnosti. S tem se ustvari kopija izvajalnega okolja Python, vendar ne bo porabljen dodaten prostor na disku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriptet måste uppgraderas till en ”fullständig miljö” för att kunna lägga till beroenden. Då skapas en kopia av Python-körmiljön, men ingen extra diskplats används."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องอัปเกรดสคริปต์นี้เป็น “สภาพแวดล้อมแบบเต็ม” จึงจะเพิ่มส่วนที่ต้องพึ่งพาได้ การทำเช่นนี้จะสร้างสำเนารันไทม์ Python แต่จะไม่ใช้พื้นที่ดิสก์เพิ่มเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağımlılık eklemek için bu betiğin “Tam Ortam” seçeneğine yükseltilmesi gerekir. Bu işlem Python çalışma zamanının bir kopyasını oluşturur ancak ek disk alanı kullanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб додавати залежності, цей скрипт слід оновити до «повного середовища». Це створить копію середовища виконання Python, але не займе додаткового місця на диску."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập lệnh này phải được nâng cấp lên “môi trường đầy đủ” để thêm các phụ thuộc. Việc này tạo một bản sao của môi trường chạy Python nhưng sẽ không dùng thêm dung lượng đĩa."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须将此脚本升级为“完整环境”才能添加依赖项。升级会复制一份Python运行时环境，但不会占用额外的磁盘空间。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此脚本必须升级为“完整环境”才能添加依赖。升级会拷贝一份 Python 运行时，但不会占用额外磁盘空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須將此腳本升級為「完整環境」才能加入相依項目。升級會複製一份 Python 執行環境，但不會佔用額外的磁碟空間。"
          }
        }
      }
    },
