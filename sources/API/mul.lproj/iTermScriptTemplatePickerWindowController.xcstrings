        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olyan szkript, amely az iterm2 könyvtáron kívül más PyPI-csomagoktól is függ. Ehhez a szkripthez egy saját pyenv jön létre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno script che dipende da pacchetti PyPI diversi dalla libreria iterm2. Per questo script verrà creato un pyenv privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iterm2ライブラリ以外のPyPIパッケージに依存するスクリプトです。このスクリプト専用のpyenvが作成されます。"
