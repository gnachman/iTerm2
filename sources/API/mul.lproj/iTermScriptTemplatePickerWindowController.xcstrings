    "0PH-7V-7pR.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"A simple script that doesn't have any dependencies besides the iterm2 library.\"; ObjectID = \"0PH-7V-7pR\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein einfaches Skript, das außer der iterm2-Bibliothek keine weiteren Abhängigkeiten hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A simple script that doesn't have any dependencies besides the iterm2 library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script sencillo que no tiene más dependencias que la biblioteca iterm2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script simple qui n’a aucune dépendance en dehors de la bibliothèque iterm2."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno script semplice che non ha dipendenze oltre alla libreria iterm2."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iterm2ライブラリ以外に依存関係のないシンプルなスクリプトです。"
