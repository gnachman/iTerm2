        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iterm2 라이브러리 외에는 종속성이 없는 간단한 스크립트입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um script simples que não tem nenhuma dependência além da biblioteca iterm2."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простой скрипт, у которого нет других зависимостей, кроме библиотеки iterm2."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个除了 iterm2 库外不依赖任何其他内容的简单脚本。"
