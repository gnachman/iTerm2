    "mIg-Ye-rwA.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"A script that depends on PyPI packages other than the iterm2 library. A private pyenv will be created for this script.\"; ObjectID = \"mIg-Ye-rwA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skript, který závisí na balíčcích z PyPI jiných než knihovna iterm2. Pro tento skript se vytvoří soukromé pyenv."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En instruks, der afhænger af andre PyPI-pakker end iterm2-biblioteket. Der oprettes et privat pyenv til denne instruks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Skript, das von PyPI-Paketen abhängt, die über die iterm2-Bibliothek hinausgehen. Für dieses Skript wird eine private pyenv erstellt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα σκριπτ που εξαρτάται από πακέτα PyPI εκτός από τη βιβλιοθήκη iterm2. Θα δημιουργηθεί ένα ιδιωτικό pyenv για αυτό το σκριπτ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A script that depends on PyPI packages other than the iterm2 library. A private pyenv will be created for this script."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script que depende de paquetes de PyPI distintos de la biblioteca iterm2. Se creará un pyenv privado para este script."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripti, joka riippuu muista PyPI-paketeista kuin iterm2-kirjastosta. Skriptille luodaan oma pyenv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un script qui dépend de paquets PyPI autres que la bibliothèque iterm2. Un pyenv privé sera créé pour ce script."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
