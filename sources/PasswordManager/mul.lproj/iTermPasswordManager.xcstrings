    "zCR-Gt-cR9.title" : {
      "comment" : "Class = \"NSMenuItem\"; title = \"Require Authentication Once per Launch and after Screen Locks\"; ObjectID = \"zCR-Gt-cR9\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigeix autenticació un cop per execució i després del bloqueig de pantalla"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžadovat ověření jednou za spuštění a po zamknutí obrazovky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræv godkendelse én gang pr. start og efter skærmlåsning"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizierung einmal pro Programmstart und nach Bildschirmsperre erforderlich"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαίτηση ελέγχου ταυτότητας μία φορά ανά εκκίνηση και μετά το κλείδωμα της οθόνης"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Require Authentication Once per Launch and after Screen Locks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir autenticación una vez por inicio y tras el bloqueo de pantalla"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaadi todennus kerran käynnistyksen aikana ja näytön lukituksen jälkeen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiger l’authentification une fois par lancement et après le verrouillage de l’écran"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रति लॉन्च एक बार और स्क्रीन लॉक होने के बाद प्रमाणीकरण आवश्यक करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtijevaj autentifikaciju jednom po pokretanju i nakon zaključavanja zaslona"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitelesítés kérése indításonként egyszer és a képernyő zárolása után"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajibkan Autentikasi Sekali per Peluncuran dan setelah Layar Terkunci"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi autenticazione una volta per avvio e dopo il blocco dello schermo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動ごとに一度、および画面ロック後に認証を要求"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행할 때마다 한 번 및 화면 잠금 후 인증 요구"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlukan Pengesahan Sekali Setiap Pelancaran dan selepas Skrin Dikunci"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krev autentisering én gang per oppstart og etter skjermlås"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereis authenticatie eenmaal per start en na het vergrendelen van het scherm"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagaj uwierzytelnienia raz na uruchomienie i po zablokowaniu ekranu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir autenticação uma vez por inicialização e após bloqueio da tela"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitați autentificarea o dată la fiecare lansare și după blocarea ecranului"
