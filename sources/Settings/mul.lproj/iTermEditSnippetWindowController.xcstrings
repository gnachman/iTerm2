    "kno-Mp-5uL.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Use / in tag names to create folders in Edit > Snippets menu\"; ObjectID = \"kno-Mp-5uL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie „/“ in Tag-Namen, um im Menü „Bearbeiten“ > „Snippets“ Ordner zu erstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use / in tag names to create folders in Edit > Snippets menu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグ名に「/」を使うと、編集 > スニペットメニューにフォルダを作成できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그 이름에 /를 사용하면 편집 > 스니펫 메뉴에 폴더가 만들어집니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use / nos nomes das etiquetas para criar pastas no menu Editar > Fragmentos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте «/» в именах тегов для создания папок в меню «Правка» > «Сниппеты»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签名称中使用 / 可在“编辑 > 代码片段”菜单中创建文件夹"
          }
        }
      }
    },
