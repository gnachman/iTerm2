    "kno-Mp-5uL.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Use / in tag names to create folders in Edit > Snippets menu\"; ObjectID = \"kno-Mp-5uL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug / i tagnavne til at oprette mapper i menuen Rediger > Tekststykker"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie „/“ in Tag-Namen, um im Menü „Bearbeiten“ > „Snippets“ Ordner zu erstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use / in tag names to create folders in Edit > Snippets menu"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa / en los nombres de etiqueta para crear carpetas en el menú Edición > Fragmentos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez / dans les noms de tags pour créer des dossiers dans le menu Édition > Extraits"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa / nei nomi dei tag per creare cartelle nel menu Modifica > Frammenti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグ名に「/」を使うと、編集 > スニペットメニューにフォルダを作成できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "태그 이름에 /를 사용하면 편집 > 스니펫 메뉴에 폴더가 만들어집니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik / in tagnamen om mappen te maken in het menu Wijzig > Fragmenten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj / w nazwach tagów, aby tworzyć foldery w menu Edycja > Fragmenty kodu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use / nos nomes das etiquetas para criar pastas no menu Editar > Fragmentos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте «/» в именах тегов для создания папок в меню «Правка» > «Сниппеты»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd / i taggnamn för att skapa mappar i menyn Redigera > Textsnuttar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzen > Parçacıklar menüsünde klasör oluşturmak için etiket adlarında / kullanın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng / trong tên thẻ để tạo thư mục trong menu Sửa > Đoạn mã"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在标签名称中使用 / 可在“编辑 > 代码片段”菜单中创建文件夹"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在標籤名稱中使用 / 可在「編輯 > 片段」選單中建立檔案夾"
          }
        }
      }
    },
