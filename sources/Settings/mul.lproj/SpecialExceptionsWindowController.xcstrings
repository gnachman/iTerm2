    "50c-TU-qXa.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Special Exceptions override fonts for specific Unicode ranges or scripts.\"; ObjectID = \"50c-TU-qXa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spezielle Ausnahmen überschreiben Schriftarten für bestimmte Unicode-Bereiche oder Schriftsysteme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Special Exceptions override fonts for specific Unicode ranges or scripts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excepciones especiales reemplazan los tipos de letra para intervalos o escrituras Unicode concretos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exceptions spéciales remplacent les polices pour certaines plages ou écritures Unicode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le eccezioni speciali sostituiscono i font per specifici intervalli o sistemi di scrittura Unicode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特別な例外は、特定のUnicode範囲またはスクリプトのフォントを上書きします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특별 예외는 특정 유니코드 범위나 문자 체계에 대해 서체를 재정의합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exceções especiais substituem fontes para intervalos ou sistemas de escrita Unicode específicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Специальные исключения переопределяют шрифты для определённых диапазонов Unicode или письменностей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel İstisnalar, belirli Unicode aralıkları veya yazı sistemleri için fontları geçersiz kılar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特殊例外会覆盖特定 Unicode 范围或文字的字体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特殊例外會覆寫特定 Unicode 範圍或文字系統的字體。"
          }
        }
      }
    },
