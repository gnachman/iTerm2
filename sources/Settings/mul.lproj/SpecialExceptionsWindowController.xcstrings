            "value" : "Erityispoikkeukset ohittavat fontit tietyille Unicode-alueille tai kirjoitusjärjestelmille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exceptions spéciales remplacent les polices pour certaines plages ou écritures Unicode."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exceptions spéciales remplacent les polices pour certaines plages ou écritures Unicode."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विशेष अपवाद विशिष्ट Unicode श्रेणियों या लिपियों के लिए फ़ॉन्ट को ओवरराइड करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posebne iznimke nadjačavaju fontove za određene raspone ili pisma u Unicodeu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A különleges kivételek felülbírálják a betűtípusokat adott Unicode-tartományokhoz vagy írásrendszerekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengecualian Khusus menimpa font untuk rentang atau skrip Unicode tertentu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le eccezioni speciali sostituiscono i font per specifici intervalli o sistemi di scrittura Unicode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特別な例外は、特定のUnicode範囲またはスクリプトのフォントを上書きします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특별 예외는 특정 유니코드 범위나 문자 체계에 대해 서체를 재정의합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengecualian Khas menggantikan fon untuk julat atau skrip Unicode tertentu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spesielle unntak overstyrer fonter for bestemte Unicode-områder eller skriftsystemer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speciale uitzonderingen vervangen lettertypen voor specifieke Unicode-bereiken of -schriften."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyjątki specjalne zastępują czcionki dla określonych zakresów lub pism Unicode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exceções especiais substituem fontes para intervalos ou sistemas de escrita Unicode específicos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
