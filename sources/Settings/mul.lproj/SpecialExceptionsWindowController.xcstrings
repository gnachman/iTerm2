    "50c-TU-qXa.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Special Exceptions override fonts for specific Unicode ranges or scripts.\"; ObjectID = \"50c-TU-qXa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spezielle Ausnahmen überschreiben Schriftarten für bestimmte Unicode-Bereiche oder Schriftsysteme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Special Exceptions override fonts for specific Unicode ranges or scripts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特別な例外は、特定のUnicode範囲またはスクリプトのフォントを上書きします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exceções especiais substituem fontes para intervalos ou sistemas de escrita Unicode específicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Специальные исключения переопределяют шрифты для определённых диапазонов Unicode или письменностей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特殊例外会覆盖特定 Unicode 范围或文字的字体。"
          }
        }
      }
    },
