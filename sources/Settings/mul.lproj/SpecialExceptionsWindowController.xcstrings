    "50c-TU-qXa.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Special Exceptions override fonts for specific Unicode ranges or scripts.\"; ObjectID = \"50c-TU-qXa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les excepcions especials substitueixen els tipus de lletra per a intervals o escriptures Unicode concrets."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvláštní výjimky přepisují písma pro určité rozsahy nebo písma (skripty) Unicode."
