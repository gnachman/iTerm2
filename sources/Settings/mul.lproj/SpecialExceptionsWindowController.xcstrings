          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excepțiile speciale înlocuiesc fonturile pentru anumite intervale Unicode sau scrieri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
