          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li nastaveno, okno Otevřít rychle lze otevřít i tehdy, když je aktivní jiná aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er angivet, kan vinduet Åbn hurtigt åbnes, selv når en anden app er aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, kann das Fenster „Schnell öffnen“ auch geöffnet werden, wenn eine andere App aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When set, the Open Quickly window can be opened even when another app is active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la ventana Abrir rápidamente se puede abrir incluso cuando hay otra app activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on asetettu, Avaa nopeasti -ikkuna voidaan avata, vaikka jokin toinen sovellus olisi aktiivinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, la fenêtre d’ouverture rapide peut s’ouvrir même quand une autre app est active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, la finestra Apertura rapida può essere aperta anche quando un’altra app è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを設定すると、他のアプリがアクティブな場合でも「クイックオープン」ウィンドウを開くことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정하면 다른 앱이 활성 상태일 때도 빠르게 열기 윈도우를 열 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, kan Åpne hurtig-vinduet åpnes selv når en annen app er aktiv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingesteld, kan het venster Open snel worden geopend, ook als een andere app actief is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, okno Szybkiego otwierania można otworzyć nawet wtedy, gdy aktywna jest inna aplikacja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando definido, a janela Abrir rapidamente pode ser aberta mesmo quando outro app estiver ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, окно «Быстрое открытие» можно открыть, даже когда активно другое приложение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, okno Rýchlo otvoriť sa dá otvoriť aj vtedy, keď je aktívna iná aplikácia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to nastavljeno, lahko okno Hitro odpri odprete tudi, kadar je aktivna druga aplikacija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på kan fönstret Öppna snabbt öppnas även när en annan app är aktiv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlıysa Hızlı Aç penceresi, başka bir uygulama etkinken bile açılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đặt, cửa sổ Mở nhanh có thể được mở ngay cả khi ứng dụng khác đang hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置后，即使其他应用处于活动状态，也可以打开“快速打开”窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定後，即使其他 App 正在使用中，也能打開「快速打開」視窗。"
          }
        }
      }
    },
