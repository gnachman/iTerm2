    "GVg-ue-xgc.ibShadowedToolTip" : {
      "comment" : "Class = \"NSView\"; ibShadowedToolTip = \"This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center.\"; ObjectID = \"GVg-ue-xgc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Visualisierung zeigt den Farbton und die Sättigung der ANSI-Farben, ohne Schwarz und Weiß. Der Farbton wird durch den Winkel und die Sättigung durch den Abstand vom Zentrum angegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この可視化は、黒と白を除くANSIカラーの色相と彩度を示します。色相は角度で、彩度は中心からの距離で表されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시각화는 검은색과 흰색을 제외한 ANSI 색상의 색조와 채도를 보여 줍니다. 색조는 각도로, 채도는 중심으로부터의 거리로 나타냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta visualização mostra o matiz e a croma das cores ANSI, excluindo preto e branco. O matiz é dado pelo ângulo e a croma pela distância do centro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта визуализация показывает тон и насыщенность цветов ANSI, исключая чёрный и белый. Тон задаётся углом, а насыщенность задаётся расстоянием от центра."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此可视化显示 ANSI 颜色的色相和色度（不包括黑色和白色）。色相由角度表示，色度由与中心的距离表示。"
          }
        }
      }
    },
    "gXM-xm-pfL.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"No data is sent to third parties without your explicit permission.\"; ObjectID = \"gXM-xm-pfL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Ihre ausdrückliche Zustimmung werden keine Daten an Dritte gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No data is sent to third parties without your explicit permission."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明示的な許可なしにデータが第三者へ送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 명시적인 허락 없이는 어떤 데이터도 제3자에게 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
