    "LsQ-19-iaj.ibShadowedToolTip" : {
      "comment" : "Class = \"NSImageView\"; ibShadowedToolTip = \"The prompt must contain the substring \\\\(ai.prompt). The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\\\(ai.prompt).\"; ObjectID = \"LsQ-19-iaj\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Prompt muss die Teilzeichenfolge \\(ai.prompt) enthalten. Die von Ihnen eingegebene Abfrage ersetzt sie, wenn mit der KI kommuniziert wird. Beispiel: „Schreibe einen Unix-Befehl, um \\(ai.prompt)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The prompt must contain the substring \\(ai.prompt). The query you enter will replace it when speaking to the AI. For example: “Write a unix command to \\(ai.prompt)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトには部分文字列\\(ai.prompt)を含める必要があります。入力したクエリがAIに話しかける際にこれを置き換えます。例:「\\(ai.prompt)を行うUnixコマンドを書いて」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O prompt deve conter a substring \\(ai.prompt). A consulta que você digitar irá substituí-la ao falar com a IA. Por exemplo: “Escreva um comando unix para \\(ai.prompt)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсказка должна содержать подстроку \\(ai.prompt). Заданный вами запрос заменит её при обращении к ИИ. Например: «Напишите команду unix, чтобы \\(ai.prompt)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示符必须包含子字符串 \\(ai.prompt)。你输入的查询将在与 AI 对话时替换它。例如：“写一条 unix 命令 \\(ai.prompt)。"
          }
        }
      }
    },
