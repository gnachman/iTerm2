            "value" : "Använd \\0 för träffen, \\1…\\9 för träffgrupper, \\d för katalog, \\u för användare och \\h för värd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ \\0 สำหรับรายการที่ตรงกัน, \\1…\\9 สำหรับกลุ่มที่ตรงกัน, \\d สำหรับไดเรกทอรี, \\u สำหรับผู้ใช้, \\h สำหรับโฮสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleşme için \\0, eşleşme grupları için \\1…\\9, dizin için \\d, kullanıcı için \\u, ana makine için \\h kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте \\0 для збігу, \\1…\\9 для груп збігу, \\d для каталогу, \\u для користувача, \\h для вузла."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng \\0 cho kết quả khớp, \\1…\\9 cho các nhóm khớp, \\d cho thư mục, \\u cho người dùng, \\h cho máy chủ."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 \\0 表示匹配项，\\1…\\9 表示匹配组，\\d 表示目录，\\u 表示用户，\\h 表示主机。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 \\0 代表符合項目，\\1…\\9 代表符合群組，\\d 代表目錄，\\u 代表用户，\\h 代表主機。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
