    "5337.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"Inactive sessions get dimmed to help find the active session.\"; ObjectID = \"5337\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions inactives s’atenuen per ajudar a trobar la sessió activa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktivní relace se ztlumí, aby bylo snazší najít aktivní relaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive sessioner dæmpes, så det er nemmere at finde den aktive session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive Sitzungen werden abgedunkelt, um das Auffinden der aktiven Sitzung zu erleichtern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ανενεργές συνεδρίες θαμπώνουν ώστε να είναι πιο εύκολο να βρείτε την ενεργή συνεδρία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones inactivas se atenúan para ayudar a encontrar la sesión activa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones inactivas se atenúan para ayudar a encontrar la sesión activa."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones inactivas se atenúan para ayudar a encontrar la sesión activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei-aktiiviset istunnot himmennetään, jotta aktiivinen istunto löytyy helpommin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions inactives sont atténuées pour aider à repérer la session active."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions inactives sont atténuées pour aider à repérer la session active."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्रिय सत्र ढूँढने में मदद के लिए निष्क्रिय सत्र धुंधले कर दिए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktivne sesije se zatamnjuju kako bi se lakše pronašla aktivna sesija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az inaktív munkamenetek elhalványulnak, hogy könnyebb legyen megtalálni az aktívat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi yang tidak aktif diredupkan untuk membantu menemukan sesi yang aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni inattive vengono attenuate per aiutarti a trovare quella attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非アクティブなセッションは暗くなり、アクティブなセッションを見つけやすくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 세션을 쉽게 찾을 수 있도록 비활성 세션을 흐리게 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi tidak aktif dimalapkan untuk membantu mencari sesi aktif."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive økter dimmes slik at det er lettere å finne den aktive økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactieve sessies worden gedimd, zodat je de actieve sessie makkelijker vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieaktywne sesje są przyciemniane, aby łatwiej było znaleźć aktywną sesję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões inativas são escurecidas para ajudar a encontrar a sessão ativa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões inativas são escurecidas para ajudar a encontrar a sessão ativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiunile inactive sunt estompate pentru a ajuta la găsirea sesiunii active."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неактивные сеансы затемняются, чтобы было легче найти активный сеанс."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktívne relácie sa stlmia, aby bolo ľahšie nájsť aktívnu reláciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktivne seje so zatemnjene, da je aktivno sejo lažje najti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktiva sessioner tonas ned så att det blir lättare att hitta den aktiva sessionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชั่นที่ไม่ได้ใช้งานจะมืดลงเพื่อช่วยให้หาเซสชั่นที่ใช้งานอยู่ได้ง่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin oturumu bulmaya yardımcı olmak için etkin olmayan oturumlar soluklaştırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неактивні сеанси затемнюються, щоб легше було знайти активний."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các phiên không hoạt động được làm mờ để giúp tìm phiên đang hoạt động."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不活跃的会话会被调暗，以便找到活跃的会话。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非使用中的工作階段會變暗，以便找出使用中的工作階段。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
