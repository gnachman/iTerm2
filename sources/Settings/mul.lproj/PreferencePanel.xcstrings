    "tyx-QN-l9J.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If this is on then transparency can be toggled window-by-window under View>Use Transparency\"; ObjectID = \"tyx-QN-l9J\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, průhlednost lze přepínat pro každé okno zvlášť v nabídce „Zobrazení > Použít průhlednost“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er slået til, kan gennemsigtighed slås til og fra vindue for vindue under Oversigt > Brug gennemsigtighed"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, kann die Transparenz für jedes Fenster einzeln unter Ansicht>Transparenz verwenden umgeschaltet werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If this is on then transparency can be toggled window-by-window under View>Use Transparency"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la transparencia se puede alternar ventana por ventana en Visualización > Usar transparencia"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on päällä, läpinäkyvyyden voi kytkeä ikkunakohtaisesti kohdasta Näytä > Käytä läpinäkyvyyttä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, la transparence peut être activée fenêtre par fenêtre via Présentation > Utiliser la transparence"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attiva, la trasparenza può essere attivata finestra per finestra da Vista > Usa trasparenza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、「表示」>「透明度を使用」で透明度をウィンドウごとに切り替えられます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 보기 > 투명도 사용에서 윈도우별로 투명도를 켜거나 끌 수 있습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, kan gjennomsiktighet slås av/på per vindu under «Vis > Bruk gjennomsiktighet»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, kan transparantie per venster worden in- of uitgeschakeld via Weergave > Gebruik transparantie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, przezroczystość można przełączać dla każdego okna osobno w Widok > Użyj przezroczystości"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, a transparência pode ser alternada janela por janela em Visualizar > Usar transparência"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, прозрачность можно переключать отдельно для каждого окна в меню Вид > Использовать прозрачность"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, priehľadnosť sa dá prepínať pre každé okno zvlášť v menu „Zobraziť > Použiť priehľadnosť“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to vklopljeno, je mogoče prosojnost preklapljati za posamezno okno v »Prikaz > Uporabi prosojnost«"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är på kan transparens slås på eller av fönster för fönster under Innehåll > Använd transparens"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu açıksa saydamlık, Görüntü > Saydamlık Kullan altından pencere pencere açılıp kapatılabilir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bật, độ trong suốt có thể được bật/tắt cho từng cửa sổ trong Xem > Dùng độ trong suốt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，可以在“显示 > 使用透明度”下按窗口切换透明度"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，可以在「顯示方式 > 使用透明度」下逐一視窗切換透明度"
          }
        }
      }
    },
