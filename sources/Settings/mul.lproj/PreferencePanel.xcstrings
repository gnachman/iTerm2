    "9Ds-KM-wpJ.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence.\"; ObjectID = \"9Ds-KM-wpJ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplaçament alternatiu del ratolí és una funció que envia tecles de fletxa en resposta a la roda de desplaçament o als gests de desplaçament. S’activa i es desactiva mitjançant una seqüència de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativní posouvání myší je funkce, která v reakci na kolečko myši nebo gesta posouvání odesílá šipky. Přepíná se řídicí sekvencí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulning er en funktion, der sender piletaster som svar på rullehjul/rullebevægelser. Den slås til og fra med en kontrolsekvens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alternatives Scrollen mit der Maus“ ist eine Funktion, die bei Mausrad-/Scrollgesten Pfeiltasten sendet. Sie wird über eine Steuersequenz umgeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εναλλακτική κύλιση ποντικιού είναι μια λειτουργία που στέλνει πλήκτρα βέλους ως απόκριση σε τροχό κύλισης ή χειρονομίες κύλισης. Εναλλάσσεται με μια ακολουθία ελέγχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del ratón es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del mouse es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del mouse es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoinen hiirivieritys on toiminto, joka lähettää nuolinäppäimiä vierityspyörän tai vierityselekien perusteella. Se kytketään päälle ja pois ohjaussarjalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Il est activé et désactivé par une séquence de contrôle."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Il est activé et désactivé par une séquence de contrôle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक माउस स्क्रोल एक सुविधा है जो स्क्रोल व्हील/स्क्रोल जेस्चर के जवाब में ऐरो कीज़ भेजती है। इसे कंट्रोल सीक्वेंस से टॉगल किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativno listanje mišem je značajka koja šalje tipke sa strelicama kao odgovor na kotačić miša/geste listanja. Uključuje se kontrolnom sekvencom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alternatív egérgörgetés olyan funkció, amely nyílbillentyűket küld a görgetőkerék vagy a görgetési kézmozdulatok hatására. Vezérlőszekvencia kapcsolja be és ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulir Tetikus Alternatif adalah fitur yang mengirim tombol panah sebagai respons terhadap roda gulir/gestur gulir. Fitur ini dinyalakan/dimatikan oleh urutan kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scorrimento alternativo del mouse è una funzione che invia i tasti freccia in risposta alla rotellina o ai gesti di scorrimento. Viene attivata da una sequenza di controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、スクロールホイールやスクロールジェスチャに応じて矢印キーを送信する機能です。制御シーケンスで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 마우스 스크롤은 스크롤 휠/스크롤 제스처에 반응하여 화살표 키를 보내는 기능입니다. 제어 시퀀스로 켜고 끌 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrol Tetikus Alternatif ialah ciri yang menghantar kekunci anak panah sebagai tindak balas kepada roda skrol/gerak isyarat skrol. Ia ditogol oleh jujukan kawalan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulling er en funksjon som sender piltaster som svar på rullehjul og rullebevegelser. Den slås av/på med en kontrollsekvens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatief muisscrollen is een functie die pijltoetsen verstuurt als reactie op het scrollwiel of scrolgebaren. Het wordt met een besturingsreeks in- of uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatywne przewijanie myszą to funkcja, która wysyła klawisze strzałek w odpowiedzi na kółko myszy lub gesty przewijania. Jest przełączana sekwencją sterującą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem/gestos de rolagem. É alternada por uma sequência de controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A deslocação alternativa do rato é uma funcionalidade que envia teclas de seta em resposta à roda de deslocação/gestos de deslocação. É alternada por uma sequência de controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derularea alternativă cu mausul este o funcție care trimite taste săgeată ca răspuns la rotița de derulare/gesturile de derulare. Se comută printr-o secvență de control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Альтернативная прокрутка мышью» — это функция, которая отправляет клавиши со стрелками в ответ на прокрутку колёсика мыши или жесты прокрутки. Она переключается управляющей последовательностью."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatívne rolovanie myšou je funkcia, ktorá v reakcii na kolieskovú myš alebo gestá rolovania odosiela šípky. Prepína sa riadiacou sekvenciou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadomestno pomikanje z miško je funkcija, ki ob pomikanju s kolescem ali s potezami pošilja puščične tipke. Vklopi in izklopi se s krmilnim zaporedjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrullning är en funktion som skickar piltangenter som svar på rullhjul och rullningsgester. Den slås på och av med en styrsekvens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเลื่อนเมาส์สำรองเป็นคุณสมบัติที่ส่งปุ่มลูกศรเพื่อตอบสนองต่อล้อเลื่อนหรือท่าทางการเลื่อน โดยเปิด/ปิดด้วยลำดับควบคุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif Fare Kaydırma, kaydırma tekerleği/kaydırma hareketlerine karşılık olarak ok tuşları gönderen bir özelliktir. Bir denetim dizisiyle açılıp kapatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альтернативне прокручування мишею надсилає клавіші зі стрілками у відповідь на колесо прокручування або жести прокручування. Його вмикає й вимикає керівна послідовність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn chuột thay thế là tính năng gửi phím mũi tên khi cuộn bằng con lăn hoặc cử chỉ cuộn. Tính năng này được bật/tắt bằng một chuỗi điều khiển."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项功能，会根据滚轮/滚动手势发送箭头键。它由控制序列来切换。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替代滑鼠捲動是一項功能，會在使用滾輪或捲動手勢時傳送方向鍵。可透過控制序列切換。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能，由控制序列切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替代滑鼠捲動是一項功能，會在使用滾輪或捲動手勢時傳送方向鍵。可透過控制序列切換。"
          }
        }
      }
    },
