    "bEQ-f0-BMG.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When relaunching, restore windows on to the same Space that they were on before. If disabled, windows will be restored into the current Space.\"; ObjectID = \"bEQ-f0-BMG\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při opětovném spuštění obnovit okna na stejné ploše, na které byla dříve. Je-li vypnuto, okna se obnoví na aktuální ploše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved start igen gendannes vinduer på det samme skrivebord, som de var på før. Hvis det er slået fra, gendannes vinduerne på det aktuelle skrivebord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Neustart werden Fenster auf demselben Schreibtisch wiederhergestellt, auf dem sie sich zuvor befanden. Wenn deaktiviert, werden Fenster auf dem aktuellen Schreibtisch wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When relaunching, restore windows on to the same Space that they were on before. If disabled, windows will be restored into the current Space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al reiniciar, restaura las ventanas en el mismo espacio en el que estaban antes. Si está desactivado, las ventanas se restaurarán en el espacio actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleenkäynnistettäessä ikkunat palautetaan samalle työpöydälle, jolla ne olivat aiemmin. Jos tämä ei ole käytössä, ikkunat palautetaan nykyiselle työpöydälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du relancement, restaurer les fenêtres dans le même espace qu’avant. Si cette option est désactivée, les fenêtres sont restaurées dans l’espace actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando riapri l’app, ripristina le finestre nello stesso spazio in cui si trovavano prima. Se è disattivata, le finestre vengono ripristinate nello spazio corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動時、ウィンドウは以前と同じスペースに復元されます。無効にすると、ウィンドウは現在のスペースに復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 실행할 때 윈도우를 이전에 있던 데스크탑에 복원합니다. 끄면 윈도우가 현재 데스크탑에 복원됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved ny start gjenopprettes vinduene i det samme arbeidsområdet som de var i tidligere. Hvis dette er deaktivert, gjenopprettes vinduene i gjeldende arbeidsområde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet vensters bij het opnieuw starten terug op dezelfde Space als waarop ze eerder stonden. Als dit is uitgeschakeld, worden vensters teruggezet op de huidige Space."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po ponownym uruchomieniu przywróć okna na to samo biurko, na którym były wcześniej. Gdy opcja jest wyłączona, okna zostaną przywrócone na bieżące biurko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao reiniciar, restaurar as janelas no mesmo Espaço em que estavam antes. Se desativado, as janelas serão restauradas no Espaço atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При повторном запуске восстанавливать окна на том же рабочем столе, на котором они были раньше. Если это отключено, окна будут восстановлены на текущем рабочем столе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri opätovnom spustení obnoviť okná na tej istej ploche, na ktorej boli predtým. Ak je vypnuté, okná sa obnovia na aktuálnej ploche."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob ponovnem zagonu obnovi okna na istem namizju Space, kot so bila prej. Če je onemogočeno, bodo okna obnovljena na trenutnem namizju Space."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid omstart återställs fönstren till samma Space som de låg i tidigare. Om det är avaktiverat återställs fönstren till det aktuella Space."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden başlatırken pencereleri daha önce bulundukları alana geri yükler. Devre dışıysa pencereler geçerli alana geri yüklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi mở lại, khôi phục các cửa sổ về cùng không gian mà chúng ở trước đó. Nếu tắt, các cửa sổ sẽ được khôi phục vào không gian hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新启动时，将窗口恢复到它们之前的同一空间。关闭后，窗口将恢复到当前空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新開啟時，將視窗回復到它們先前所在的同一個空間。停用時，視窗會回復到目前的空間。"
          }
        }
      }
    },
