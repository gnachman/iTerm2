    "GD3-XJ-mYL.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If disabled, then triple click selects one line as it appears onscreen.\"; ObjectID = \"GD3-XJ-mYL\";",
