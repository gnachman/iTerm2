    "6320.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"How much of the background image is visible through the background color.\"; ObjectID = \"6320\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určuje, jak velká část obrázku na pozadí je vidět přes barvu pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor meget af baggrundsbilledet der er synligt gennem baggrundsfarven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel des Hintergrundbilds durch die Hintergrundfarbe sichtbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How much of the background image is visible through the background color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto de la imagen de fondo es visible a través del color de fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka suuri osa taustakuvasta näkyy taustavärin läpi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part de l’image d’arrière-plan visible à travers la couleur d’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanta parte dell’immagine di sfondo è visibile attraverso il colore di sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景色を通して背景画像がどれだけ見えるか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경 색상을 통해 배경 이미지가 얼마나 보이는지 설정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mye av bakgrunnsbildet som er synlig gjennom bakgrunnsfargen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel van de achtergrondafbeelding zichtbaar is door de achtergrondkleur heen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ile obraz tła jest widoczny przez kolor tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto da imagem de fundo fica visível através da cor de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько фоновое изображение видно сквозь цвет фона."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do akej miery je obrázok na pozadí viditeľný cez farbu pozadia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koliko slike ozadja je vidno skozi barvo ozadja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur mycket av bakgrundsbilden som syns genom bakgrundsfärgen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan resminin arka plan rengi üzerinden ne kadarının görüneceğini belirler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức độ hiển thị của ảnh nền qua màu nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景颜色下背景图像的可见程度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景圖像透過背景顏色的可見程度。"
          }
        }
      }
    },
