    "RBx-qn-HNB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated.\"; ObjectID = \"RBx-qn-HNB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, l’animació del cursor només es produeix en mode de pantalla alternativa. Si està desactivat, els moviments del cursor sempre s’animen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, animace kurzoru probíhá jen v režimu alternativní obrazovky. Je-li vypnuto, pohyby kurzoru se animují vždy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, animeres markøren kun i alternativ skærmtilstand. Når det er slået fra, animeres markørbevægelser altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, erfolgt die Cursor-Animation nur im Alternate-Screen-Modus. Wenn deaktiviert, werden Cursorbewegungen immer animiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, η κίνηση του δρομέα γίνεται μόνο σε λειτουργία εναλλακτικής οθόνης. Όταν είναι απενεργοποιημένο, οι μετακινήσεις του δρομέα έχουν πάντα κίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la animación del cursor solo se produce en modo de pantalla alternativa. Si está desactivado, los movimientos del cursor siempre se animan."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la animación del cursor sólo se produce en modo de pantalla alternativa. Si está desactivado, los movimientos del cursor siempre se animan."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la animación del cursor sólo se produce en modo de pantalla alternativa. Si está desactivado, los movimientos del cursor siempre se animan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, kohdistimen animaatio tapahtuu vain vaihtoehtoisen näytön tilassa. Kun se ei ole käytössä, kohdistimen liikkeet animoidaan aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, l’animation du curseur n’a lieu qu’en mode écran alternatif. Si elle est désactivée, les déplacements du curseur sont toujours animés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, l’animation du curseur n’a lieu qu’en mode écran alternatif. Si elle est désactivée, les déplacements du curseur sont toujours animés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, कर्सर एनिमेशन केवल वैकल्पिक स्क्रीन मोड में होता है। अक्षम होने पर कर्सर की गतिविधियाँ हमेशा एनिमेट होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je omogućeno, animacija kursora događa se samo u modu alternativnog zaslona. Kad je onemogućeno, pomaci kursora uvijek su animirani."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a kurzoranimáció csak alternatív képernyő módban jelenik meg. Ha le van tiltva, a kurzormozgások mindig animáltak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, animasi kursor hanya terjadi dalam mode layar alternatif. Jika dinonaktifkan, perpindahan kursor selalu dianimasikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, l’animazione del cursore avviene solo in modalità schermo alternativo. Se è disattivato, i movimenti del cursore sono sempre animati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、カーソルのアニメーションは代替スクリーンモードでのみ発生します。無効にすると、カーソルの移動は常にアニメーションされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 대체 화면 모드에서만 커서 애니메이션이 표시됩니다. 끄면 커서 이동이 항상 애니메이션으로 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, animasi kursor hanya berlaku dalam mod skrin alternatif. Apabila dinyahdayakan, pergerakan kursor sentiasa dianimasikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, skjer markøranimasjonen bare i alternativ skjermmodus. Når det er av, animeres markørbevegelser alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, wordt de cursor alleen geanimeerd in de modus voor het alternatieve scherm. Als het is uitgeschakeld, worden cursorbewegingen altijd geanimeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, animacja kursora występuje tylko w trybie ekranu alternatywnego. Gdy jest wyłączona, ruchy kursora są zawsze animowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, a animação do cursor só ocorre no modo de tela alternativa. Quando desativado, os movimentos do cursor são sempre animados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, a animação do cursor só ocorre no modo de ecrã alternativo. Quando desativado, os movimentos do cursor são sempre animados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, animația cursorului apare doar în modul ecran alternativ. Când este dezactivată, mișcările cursorului sunt mereu animate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, анимация курсора происходит только в альтернативном режиме экрана. Если отключено, перемещения курсора анимируются всегда."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, animácia kurzora sa vykoná iba v režime alternatívnej obrazovky. Keď je vypnuté, pohyby kurzora sa animujú vždy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, se kazalec animira samo v načinu nadomestnega zaslona. Ko je onemogočeno, se premiki kazalca vedno animirajo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på sker marköranimering bara i alternativt skärmläge. När det är av animeras markörrörelser alltid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ ภาพเคลื่อนไหวของเคอร์เซอร์จะเกิดขึ้นเฉพาะในโหมดหน้าจอสำรอง เมื่อปิดใช้ การเคลื่อนเคอร์เซอร์จะมีภาพเคลื่อนไหวเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde imleç animasyonu yalnızca alternatif ekran modunda gerçekleşir. Devre dışıyken imleç hareketleri her zaman animasyonlu olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, анімація курсора відбувається лише в режимі альтернативного екрана. Якщо вимкнено, переміщення курсора анімуються завжди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, hiệu ứng con trỏ chỉ xảy ra ở chế độ màn hình thay thế. Khi tắt, các chuyển động của con trỏ luôn có hiệu ứng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，光标动画仅在备用屏幕模式下出现。停用后，光标移动始终带有动画。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，游標動畫僅在替代螢幕模式下出現。停用後，游標移動一律帶有動畫。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，光标动画仅在备用屏幕模式下发生。关闭后，光标移动始终带有动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，游標動畫僅在替代螢幕模式下出現。停用後，游標移動一律帶有動畫。"
          }
        }
      }
    },
    "rcS-Ls-100.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal.\"; ObjectID = \"rcS-Ls-100\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embolcalla l’ordre en el teu intèrpret d’ordres d’inici de sessió perquè els dotfiles s’executin primer i l’ordre vegi el mateix $PATH i les mateixes variables exportades que tindries en un terminal interactiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Příkaz se zabalí do vašeho přihlašovacího shellu, takže se nejprve spustí konfigurační soubory a váš příkaz uvidí stejnou proměnnou $PATH a exportované proměnné, jaké byste měli v interaktivním terminálu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakker kommandoen ind i din loginshell, så dotfiles køres først, og din kommando ser den samme $PATH og de samme eksporterede variabler, som du ville have i en interaktiv terminal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umschließt den Befehl mit Ihrer Login-Shell, so dass zuerst die Dotfiles ausgeführt werden und Ihr Befehl denselben $PATH und dieselben exportierten Variablen sieht, die Sie in einem interaktiven Terminal hätten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τυλίγει την εντολή στο κέλυφος εισόδου σας, ώστε να εκτελούνται πρώτα τα dotfiles και η εντολή σας να βλέπει το ίδιο $PATH και τις ίδιες εξαγόμενες μεταβλητές που θα είχατε σε ένα διαδραστικό τερματικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envuelve el comando en tu shell de inicio de sesión para que los dotfiles se ejecuten primero y tu comando vea el mismo $PATH y las mismas variables exportadas que tendrías en una terminal interactiva."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envuelve el comando en tu shell de inicio de sesión para que los dotfiles se ejecuten primero y tu comando vea el mismo $PATH y las mismas variables exportadas que tendrías en una terminal interactiva."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envuelve el comando en tu shell de inicio de sesión para que los dotfiles se ejecuten primero y tu comando vea el mismo $PATH y las mismas variables exportadas que tendrías en una terminal interactiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kietoo komennon kirjautumiskomentotulkkiisi, jolloin asetustiedostot suoritetaan ensin ja komentosi näkee saman $PATH-muuttujan ja viedyt muuttujat kuin interaktiivisessa päätteessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enveloppe la commande dans votre shell de connexion afin que les dotfiles s’exécutent d’abord et que votre commande voie le même $PATH et les mêmes variables exportées que dans un terminal interactif."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enveloppe la commande dans votre coque logicielle de connexion afin que les dotfiles s’exécutent d’abord et que votre commande voie le même $PATH et les mêmes variables exportées que dans un terminal interactif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमांड को आपके लॉगिन शेल में लपेटता है ताकि डॉटफ़ाइल पहले चलें और आपकी कमांड को वही $PATH और एक्सपोर्ट किए गए वैरिएबल दिखें जो इंटरैक्टिव टर्मिनल में होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omata naredbu u vašu ljusku za prijavu tako da se dotfileovi izvrše prvi, a vaša naredba vidi isti $PATH i izvezene varijable kao u interaktivnom terminalu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parancsot a bejelentkezési shellbe csomagolja, így a dotfile-ok futnak le először, és a parancs ugyanazt a $PATH értéket és exportált változókat látja, mint egy interaktív terminálban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membungkus perintah dalam shell login Anda sehingga dotfile berjalan lebih dulu dan perintah Anda melihat $PATH dan variabel yang diekspor yang sama seperti di terminal interaktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include il comando nella tua shell di login, così i dotfile vengono eseguiti per primi e il comando vede lo stesso $PATH e le stesse variabili esportate che avresti in un terminale interattivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドをログインシェルでラップすることで、dotfileが先に実行され、対話型ターミナルと同じ$PATHやエクスポートされた変数をコマンドが認識できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 로그인 셸로 감싸서 dotfile이 먼저 실행되고, 대화형 터미널에서와 같은 $PATH 및 내보낸 변수를 명령이 볼 수 있게 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membungkus perintah dalam cangkerang log masuk anda supaya dotfile dijalankan dahulu dan perintah anda melihat $PATH dan pemboleh ubah yang dieksport yang sama seperti dalam terminal interaktif."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakker kommandoen inn i påloggingsskallet ditt slik at punktfiler kjøres først og kommandoen ser samme $PATH og eksporterte variabler som i en interaktiv terminal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpakt het commando in je inlogshell, zodat dotfiles eerst worden uitgevoerd en je commando dezelfde $PATH en geëxporteerde variabelen ziet als in een interactieve terminal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakowuje polecenie w Twoją powłokę logowania, aby najpierw uruchomiły się pliki dotfiles, a polecenie widziało ten sam $PATH i wyeksportowane zmienne, co w interaktywnym terminalu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envolve o comando no seu shell de login para que os dotfiles sejam executados primeiro e seu comando veja o mesmo $PATH e as mesmas variáveis exportadas que você teria em um terminal interativo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envolve o comando na sua shell de início de sessão para que os dotfiles sejam executados primeiro e o seu comando veja o mesmo $PATH e as mesmas variáveis exportadas que teria num terminal interativo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încadrează comanda în shellul dvs. de login, astfel încât fișierele dotfile să ruleze primele, iar comanda dvs. să vadă același $PATH și aceleași variabile exportate ca într-un terminal interactiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оборачивает команду в оболочку входа, чтобы сначала выполнялись dotfiles и ваша команда видела те же $PATH и экспортированные переменные, что и в интерактивном терминале."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabalí príkaz do vášho prihlasovacieho shellu, aby sa najprv spustili dotfiles a príkaz videl rovnakú premennú $PATH a exportované premenné ako v interaktívnom termináli."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovije ukaz v vašo prijavno lupino, tako da se najprej izvedejo dotfiles in ukaz vidi isti $PATH in izvožene spremenljivke kot v interaktivnem terminalu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omsluter kommandot i ditt inloggningsskal så att punktfiler körs först och kommandot ser samma $PATH och exporterade variabler som i en interaktiv terminal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ครอบคำสั่งไว้ในเชลล์สำหรับเข้าสู่ระบบของคุณ เพื่อให้ dotfile ทำงานก่อน และคำสั่งของคุณเห็น $PATH และตัวแปรที่ส่งออกเหมือนกับในเทอร์มินัลแบบโต้ตอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komutu oturum açma kabuğunuza sarar; böylece nokta dosyaları önce çalışır ve komutunuz etkileşimli bir terminalde sahip olacağınız $PATH ile dışa aktarılmış değişkenleri görür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обгортає команду у ваш командний процесор входу, щоб спершу виконувалися dotfiles, а команда бачила ті самі $PATH і експортовані змінні, що й в інтерактивному терміналі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bọc lệnh trong shell đăng nhập của bạn để các dotfile chạy trước và lệnh của bạn thấy cùng $PATH và các biến đã xuất như trong terminal tương tác."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将命令包裹在你的登录shell中，使dotfile先运行，命令也能看到与交互式终端中相同的 $PATH 和已导出的变量。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指令包裝在登入 shell 中，讓 dotfiles 先執行，使你的指令看到與互動式終端機中相同的 $PATH 和匯出變數。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将命令包装在登录 Shell 中，以便先运行 dotfiles，让你的命令看到与交互式终端中相同的 $PATH 和导出变量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指令包裝在登入 shell 中，讓 dotfiles 先執行，使你的指令看到與互動式終端機中相同的 $PATH 和匯出變數。"
          }
        }
      }
    },
