          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácia môže spôsobiť zmenu veľkosti okna, aj keď je v nevybranom tabe alebo rozdelenom paneli"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
