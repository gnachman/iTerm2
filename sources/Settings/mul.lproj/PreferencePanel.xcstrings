    "4896.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"This boosts the contrast of text when its color is close to that of the background color by moving the text color towards black or white.\"; ObjectID = \"4896\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmenta el contrast del text quan el seu color és proper al del fons, desplaçant el color del text cap al negre o el blanc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvyšuje kontrast textu, když je jeho barva blízká barvě pozadí, posunutím barvy textu k černé nebo bílé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette øger tekstens kontrast, når dens farve ligger tæt på baggrundsfarven, ved at flytte tekstfarven mod sort eller hvid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies erhöht den Kontrast des Textes, wenn seine Farbe der Hintergrundfarbe ähnelt, indem die Textfarbe in Richtung Schwarz oder Weiß verschoben wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυξάνει την αντίθεση του κειμένου όταν το χρώμα του είναι κοντά στο χρώμα φόντου, μετακινώντας το χρώμα του κειμένου προς το μαύρο ή το λευκό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This boosts the contrast of text when its color is close to that of the background color by moving the text color towards black or white."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This boosts the contrast of text when its colour is close to that of the background colour by moving the text colour towards black or white."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This boosts the contrast of text when its colour is close to that of the background colour by moving the text colour towards black or white."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This boosts the contrast of text when its colour is close to that of the background colour by moving the text colour towards black or white."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This boosts the contrast of text when its colour is close to that of the background colour by moving the text colour towards black or white."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This boosts the contrast of text when its color is close to that of the background color by moving the text color towards black or white."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta el contraste del texto cuando su color es cercano al del fondo, desplazando el color del texto hacia negro o blanco."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta el contraste del texto cuando su color es cercano al del fondo, desplazando el color del texto hacia negro o blanco."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta el contraste del texto cuando su color es cercano al del fondo, desplazando el color del texto hacia negro o blanco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä lisää tekstin kontrastia, kun sen väri on lähellä taustaväriä, siirtämällä tekstin väriä kohti mustaa tai valkoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmente le contraste du texte lorsque sa couleur est proche de celle de l’arrière-plan, en la rapprochant du noir ou du blanc."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmente le contraste du texte lorsque sa couleur est proche de celle de l’arrière-plan, en la rapprochant du noir ou du blanc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब टेक्स्ट का रंग बैकग्राउंड रंग के करीब हो, तो यह टेक्स्ट रंग को काले या सफ़ेद की ओर ले जाकर कंट्रास्ट बढ़ाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo pojačava kontrast teksta kad je njegova boja bliska boji pozadine, pomicanjem boje teksta prema crnoj ili bijeloj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Növeli a szöveg kontrasztját, ha a színe közel esik a háttér színéhez, a szöveg színét feketéhez vagy fehérhez közelítve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini meningkatkan kontras teks saat warnanya mendekati warna latar belakang dengan menggeser warna teks ke arah hitam atau putih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta il contrasto del testo quando il suo colore è vicino a quello dello sfondo, spostando il colore del testo verso il nero o il bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは、テキストの色が背景色に近い場合に、テキストの色を黒または白に近づけることでコントラストを高めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 색상이 배경 색상과 비슷할 때 텍스트 색상을 검은색이나 흰색 쪽으로 옮겨 텍스트의 대비를 높입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini meningkatkan kontras teks apabila warnanya hampir dengan warna latar belakang dengan menggerakkan warna teks ke arah hitam atau putih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette øker kontrasten i teksten når fargen ligger nær bakgrunnsfargen, ved å flytte tekstfargen mot svart eller hvitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verhoogt het contrast van tekst wanneer de kleur dicht bij de achtergrondkleur ligt, door de tekstkleur naar zwart of wit te verschuiven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiększa kontrast tekstu, gdy jego kolor jest zbliżony do koloru tła, przesuwając kolor tekstu w stronę czerni lub bieli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aumenta o contraste do texto quando a cor dele está próxima da cor do plano de fundo, movendo a cor do texto em direção ao preto ou ao branco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto aumenta o contraste do texto quando a cor dele está próxima da cor do plano de fundo, movendo a cor do texto em direção ao preto ou ao branco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mărește contrastul textului când culoarea sa este apropiată de cea a fundalului, deplasând culoarea textului spre negru sau alb."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это повышает контраст текста, когда его цвет близок к цвету фона, смещая цвет текста в сторону чёрного или белого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýši kontrast textu, keď je jeho farba blízka farbe pozadia, posunutím farby textu k čiernej alebo bielej."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To poveča kontrast besedila, kadar je njegova barva blizu barvi ozadja, tako da barvo besedila premakne proti črni ali beli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta ökar textens kontrast när dess färg ligger nära bakgrundsfärgen genom att flytta textfärgen mot svart eller vitt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มความเปรียบต่างของข้อความเมื่อสีใกล้เคียงกับสีพื้นหลัง โดยเลื่อนสีข้อความไปทางสีดำหรือสีขาว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin rengi arka plan rengine yakın olduğunda, metin rengini siyaha veya beyaza doğru kaydırarak kontrastı artırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підвищує контрастність тексту, коли його колір близький до кольору тла, зсуваючи колір тексту до чорного або білого."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng độ tương phản của văn bản khi màu của nó gần với màu nền, bằng cách dịch màu văn bản về phía đen hoặc trắng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当文本颜色与背景色相近时，将文本颜色向黑色或白色调整，以提高文本对比度。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當文字顏色接近背景顏色時，將文字顏色向黑色或白色調整，以提高文字對比度。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当文本颜色接近背景颜色时，通过将文本颜色移向黑色或白色来提高对比度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當文字顏色接近背景顏色時，將文字顏色向黑色或白色調整，以提高文字對比度。"
          }
        }
      }
    },
