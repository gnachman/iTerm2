    "Nhj-1F-dbm.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect.\"; ObjectID = \"Nhj-1F-dbm\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, ⇧ + šipka rozšíří existující výběr. Pokud žádný výběr není, nemá to účinek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, udvider skift+piletast en eksisterende markering. Hvis der ikke er nogen markering, har det ingen virkning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, erweitert Umschalt+Pfeiltaste eine bestehende Auswahl. Wenn keine Auswahl vorhanden ist, hat dies keine Wirkung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, Mayúsculas+flecha ampliará una selección existente. Si no hay selección, no tiene efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, vaihto+nuolinäppäin laajentaa olemassa olevaa valintaa. Jos valintaa ei ole, sillä ei ole vaikutusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, Maj+flèche étend la sélection existante. S’il n’y a pas de sélection, cela n’a aucun effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, Maiuscole+freccia estende una selezione esistente. Se non c’è alcuna selezione, non ha effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすると、shift+矢印キーで既存の選択範囲を拡張できます。選択範囲がない場合、これは効果がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 Shift+화살표 키로 기존 선택 영역을 확장합니다. 선택 영역이 없으면 아무 효과가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, utvider Skift+piltast en eksisterende markering. Hvis det ikke finnes noen markering, har det ingen effekt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, breidt Shift+pijltoets een bestaande selectie uit. Als er geen selectie is, heeft het geen effect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, Shift + klawisz strzałki rozszerza istniejące zaznaczenie. Jeśli nie ma zaznaczenia, nie ma to żadnego skutku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando isto estiver ativado, Shift+seta estenderá uma seleção existente. Se não houver seleção, isso não terá efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это включено, shift+стрелка будет расширять существующее выделение. Если выделения нет, это не имеет эффекта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, Shift+šípka rozšíri existujúci výber. Ak nie je nič vybrané, nemá to žiadny účinok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, Shift + puščična tipka razširi obstoječi izbor. Če izbora ni, nima učinka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på utökar skift+piltangent en befintlig markering. Om det inte finns någon markering har det ingen effekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu etkinken Shift+ok tuşu mevcut bir seçimi genişletir. Seçim yoksa etkisi olmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, Shift+phím mũi tên sẽ mở rộng vùng chọn hiện có. Nếu không có vùng chọn, tùy chọn này không có tác dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Shift+方向键将扩展现有选区。如果没有选区，则无效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，Shift+方向鍵會延伸現有的選取範圍。若沒有選取範圍，則不會有任何效果。"
          }
        }
      }
    },
