          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är på försöker ändringar av typsnittsstorleken behålla sessionens mått."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเปิดใช้ การเปลี่ยนขนาดแบบอักษรจะพยายามคงขนาดของเซสชั่นไว้"
