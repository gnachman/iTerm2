    "XaQ-Gu-7BD.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This build is in the nightly build channel. It cannot update to beta or release builds.\"; ObjectID = \"XaQ-Gu-7BD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build befindet sich im Nightly-Build-Kanal. Er kann nicht auf Beta- oder Release-Builds aktualisiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
