    },
    "7KN-d8-slG.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Show per-pane title bars even if there is only one pane\"; ObjectID = \"7KN-d8-slG\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazovat záhlaví podoken i při jediném podokně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis titellinjer for hver rude, selv om der kun er én rude"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titelleisten pro Bereich anzeigen, auch wenn nur ein Bereich vorhanden ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show per-pane title bars even if there is only one pane"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar barras de título por panel aunque solo haya un panel"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä paneelikohtaiset otsikkopalkit, vaikka paneeleja on vain yksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher une barre de titre par volet même s’il n’y a qu’un volet"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra barre del titolo per riquadro anche con un solo riquadro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペインが1つしかない場合でもペインごとのタイトルバーを表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널이 하나뿐이어도 패널별 제목 막대 보기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis tittellinjer for hver rute selv om det bare er én rute"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon titelbalken per paneel, ook als er maar één paneel is"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż paski tytułu dla każdego panelu, nawet jeśli jest tylko jeden panel"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar barras de título por painel mesmo que haja apenas um painel"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать заголовки панелей, даже если панель только одна"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť lišty s názvom pre jednotlivé panely, aj keď je iba jeden panel"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži naslovne vrstice za posamezna podokna tudi, če je samo eno podokno"
