    "mOt-Fp-WpW.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"Controls the opacity of faint (dim) text produced by SGR 2. Lower values make faint text fade further toward the background; at 1, it has no effect.\"; ObjectID = \"mOt-Fp-WpW\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuert die Deckkraft von blassem (gedimmtem) Text, der durch SGR 2 erzeugt wird. Niedrigere Werte lassen blassen Text stärker in den Hintergrund übergehen; bei 1 hat es keine Wirkung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Controls the opacity of faint (dim) text produced by SGR 2. Lower values make faint text fade further toward the background; at 1, it has no effect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SGR 2によって生成される淡い(dim)テキストの不透明度を調整します。値を小さくすると、淡いテキストは背景色に向かってさらに薄くなります。1の場合は効果がありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla a opacidade do texto tênue (esmaecido) produzido por SGR 2. Valores mais baixos fazem o texto tênue esmaecer mais em direção ao plano de fundo; em 1, não tem efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет непрозрачностью тусклого (приглушённого) текста, создаваемого SGR 2. Меньшие значения делают тусклый текст более похожим на фон; при значении 1 эффект отсутствует."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制 SGR 2 产生的暗淡文本的不透明度。值越低，暗淡文本越向背景淡出；为 1 时无效果。"
          }
        }
      }
    },
    "NbC-dp-wjc.title" : {
