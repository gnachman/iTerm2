    "cgK-BO-rKa.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work.\"; ObjectID = \"cgK-BO-rKa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, l’informe del ratolí té prioritat sobre el lliscament per canviar de pestanya. Desactiva-ho si el lliscament per canviar de pestanya de vegades no funciona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, hlášení myši má přednost před přepínáním panelů přejetím. Vypněte to, pokud přepínání panelů přejetím občas nefunguje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, har rapportering af mus forrang over skub for at skifte fane. Slå det fra, hvis skub for at skifte fane nogle gange ikke virker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, hat die Mausberichterstattung Vorrang vor dem Wischen zum Wechseln der Tabs. Deaktivieren Sie dies, wenn das Wischen zum Wechseln der Tabs manchmal nicht funktioniert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, η αναφορά ποντικιού έχει προτεραιότητα έναντι της σάρωσης για εναλλαγή καρτελών. Απενεργοποιήστε το αν η σάρωση για εναλλαγή καρτελών δεν λειτουργεί μερικές φορές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el informe del ratón tiene prioridad sobre deslizar para cambiar de pestaña. Desactívalo si deslizar para cambiar de pestaña a veces no funciona."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el reporte del mouse tiene prioridad sobre deslizar para cambiar de pestaña. Desactívalo si deslizar para cambiar de pestaña a veces no funciona."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el reporte del mouse tiene prioridad sobre deslizar para cambiar de pestaña. Desactívalo si deslizar para cambiar de pestaña a veces no funciona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, hiiren raportointi on tärkeämpi kuin pyyhkäisy välilehden vaihtamiseksi. Poista tämä käytöstä, jos välilehden vaihtaminen pyyhkäisemällä ei toimi aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, le signalement de la souris est prioritaire sur le balayage pour changer d’onglet. Désactivez-la si le balayage pour changer d’onglet ne fonctionne parfois pas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, le signalement de la souris est prioritaire sur le balayage pour changer d’onglet. Désactivez-la si le balayage pour changer d’onglet ne fonctionne parfois pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर, माउस रिपोर्टिंग को टैब बदलने के लिए स्वाइप से ऊपर प्राथमिकता मिलती है। अगर टैब बदलने के लिए स्वाइप कभी-कभी काम नहीं करता, तो इसे अक्षम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je omogućeno, izvještavanje o mišu ima prednost pred prelaskom prstom za promjenu kartice. Onemogućite ovo ako prelazak prstom za promjenu kartice ponekad ne radi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez engedélyezve van, az egérjelentés elsőbbséget élvez a lapváltó csúsztatással szemben. Tiltsa le, ha a lapváltó csúsztatás néha nem működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, pelaporan tetikus lebih diutamakan daripada gesek untuk berpindah tab. Nonaktifkan ini jika gesek untuk berpindah tab terkadang tidak berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è attiva, la segnalazione del mouse ha la precedenza sul passaggio da un pannello all’altro con lo scorrimento. Disattivala se questo scorrimento a volte non funziona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、マウスレポートがタブを切り替えるスワイプよりも優先されます。タブ切り替えのスワイプが時々効かない場合はこれを無効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 마우스 리포팅이 탭 전환 쓸어넘기기보다 우선합니다. 쓸어넘겨 탭을 전환하는 기능이 가끔 작동하지 않으면 이 옵션을 끄십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, pelaporan tetikus diutamakan berbanding leret untuk menukar tab. Nyahdayakan ini jika leret untuk menukar tab kadangkala tidak berfungsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, har museregistrering forrang over sveip for å bytte fane. Deaktiver dette hvis sveip for å bytte fane noen ganger ikke fungerer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, heeft muisrapportage voorrang op vegen om van tabblad te wisselen. Schakel dit uit als vegen om van tabblad te wisselen soms niet werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, raportowanie myszy ma priorytet nad przeciągnięciem w celu przełączania kart. Wyłącz ją, jeśli przeciągnięcie w celu przełączania kart czasem nie działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o relato de mouse tem prioridade sobre o deslizar para trocar de aba. Desative isto se o deslizar para trocar de aba às vezes não funcionar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o relato do rato tem prioridade sobre o deslizar para mudar de separador. Desative isto se o deslizar para mudar de separador às vezes não funcionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, raportarea mausului are prioritate față de glisarea pentru comutarea filelor. Dezactivați-o dacă glisarea pentru comutarea filelor uneori nu funcționează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, отчёты о мыши имеют приоритет над свайпом для переключения вкладок. Отключите этот параметр, если свайп для переключения вкладок иногда не работает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, hlásenie myši má prednosť pred potiahnutím prstom na prepnutie tabov. Vypnite to, ak potiahnutie prstom na prepnutie tabov niekedy nefunguje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to omogočeno, ima poročanje miške prednost pred potegom za preklop zavihkov. Onemogočite to, če poteg za preklop zavihkov včasih ne deluje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är aktiverat har musrapportering företräde framför svepning för att byta flik. Avaktivera det om svepning för att byta flik ibland inte fungerar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ การรายงานเมาส์จะมีความสำคัญกว่าการปัดเพื่อสลับแถบ ปิดใช้ตัวเลือกนี้หากการปัดเพื่อสลับแถบใช้งานไม่ได้เป็นบางครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinken fare raporlama, sekme değiştirmek için kaydırma hareketinden önceliklidir. Sekme değiştirmek için kaydırma hareketi bazen çalışmıyorsa bunu devre dışı bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, звітування про мишу має пріоритет над проведенням для перемикання вкладок. Вимкніть, якщо проведення для перемикання вкладок іноді не працює."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, báo cáo chuột được ưu tiên hơn thao tác vuốt để chuyển tab. Hãy tắt mục này nếu đôi khi vuốt để chuyển tab không hoạt động."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，鼠标报告的优先级高于轻扫切换标签页。如果轻扫切换标签页有时不起作用，请停用此项。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用時，滑鼠回報的優先順序高於滑動切換分頁。如果滑動切換分頁有時無法運作，請停用此選項。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，鼠标报告优先于滑动切换标签页。如果滑动切换标签页有时不生效，请关闭此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用時，滑鼠回報的優先順序高於滑動切換標籤頁。如果滑動切換標籤頁有時無法運作，請停用此選項。"
          }
        }
      }
    },
