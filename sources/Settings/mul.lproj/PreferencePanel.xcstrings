        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar título de janela personalizado para novas janelas que usam este perfil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свой заголовок окна для новых окон этого профиля"
          }
        },
        "sk" : {
