        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre d’état affiche le contenu de celle de tmux, pas les composants natifs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
