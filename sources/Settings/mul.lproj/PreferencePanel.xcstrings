    "evF-qt-9wo.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"This dims all colors except that of the cursor. A pure white cursor with Smart Cursor Color off is recommended when using cursor boost.\"; ObjectID = \"evF-qt-9wo\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies dunkelt alle Farben außer der des Cursors ab. Bei Verwendung des Cursor-Boosts wird ein reinweißer Cursor mit deaktivierter intelligenter Cursorfarbe empfohlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This dims all colors except that of the cursor. A pure white cursor with Smart Cursor Color off is recommended when using cursor boost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはカーソルの色を除くすべての色を暗くします。カーソルブーストを使用する場合は、スマートカーソルカラーをオフにした純白のカーソルを推奨します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서를 제외한 모든 색상을 흐리게 합니다. 커서 부스트를 사용할 때는 스마트 커서 색상을 끄고 순백색 커서를 사용하는 것이 좋습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto escurece todas as cores exceto a do cursor. Recomenda-se um cursor branco puro com a Cor inteligente do cursor desativada ao usar o realce do cursor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это затемняет все цвета, кроме цвета курсора. При отключённом умном цвете курсора рекомендуется использовать чисто белый курсор при усилении курсора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会调暗除光标颜色外的所有颜色。使用光标增强时，建议使用纯白光标并关闭智能光标颜色。"
          }
        }
      }
    },
