    "JXG-G1-APa.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, large cursor movements get an animation to help your eye follow the cursor.\"; ObjectID = \"JXG-G1-APa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, erhalten große Cursor-Bewegungen eine Animation, die dem Auge hilft, dem Cursor zu folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、カーソルの大きな移動にアニメーションが付き、目でカーソルを追いやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 커서가 크게 이동할 때 애니메이션이 적용되어 커서를 눈으로 쉽게 따라갈 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar o seu olho a acompanhar o cursor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, крупные перемещения курсора сопровождаются анимацией, помогающей взгляду следовать за курсором."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，大幅光标移动会带有动画，帮助你的视线跟随光标。"
          }
        }
      }
    },
