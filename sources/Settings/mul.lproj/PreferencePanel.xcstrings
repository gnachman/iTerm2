    "6387.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"This may be a security risk in an untrusted environment, especially if the terminal can set the title.\"; ObjectID = \"6387\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nedůvěryhodném prostředí to může být bezpečnostní riziko, zvlášť pokud terminál může nastavit název."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan være en sikkerhedsrisiko i et miljø, du ikke stoler på, især hvis terminalen kan angive titlen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann in einer nicht vertrauenswürdigen Umgebung ein Sicherheitsrisiko darstellen, besonders wenn das Terminal den Titel festlegen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This may be a security risk in an untrusted environment, especially if the terminal can set the title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto puede suponer un riesgo de seguridad en un entorno no confiable, especialmente si la terminal puede establecer el título."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä voi olla tietoturvariski epäluotettavassa ympäristössä, etenkin jos pääte voi asettaa otsikon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut présenter un risque de sécurité dans un environnement non fiable, surtout si le terminal peut définir le titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo può essere un rischio per la sicurezza in un ambiente non attendibile, soprattutto se il terminale può impostare il titolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは、特にターミナルがタイトルを設定できる場合、信頼できない環境ではセキュリティ上のリスクになる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 없는 환경에서는 보안 위험이 될 수 있으며, 특히 터미널이 제목을 설정할 수 있는 경우에 그렇습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan være en sikkerhetsrisiko i et miljø du ikke stoler på, særlig hvis terminalen kan angi tittelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan een beveiligingsrisico zijn in een onbetrouwbare omgeving, vooral als de terminal de titel kan instellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W niezaufanym środowisku może to stanowić zagrożenie dla bezpieczeństwa, zwłaszcza jeśli terminal może ustawiać tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto pode representar um risco de segurança em um ambiente não confiável, especialmente se o terminal puder definir o título."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это может представлять угрозу безопасности в недоверенной среде, особенно если терминал может задавать заголовок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nedôveryhodnom prostredí to môže byť bezpečnostné riziko, najmä ak terminál dokáže nastaviť názov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je lahko varnostno tveganje v nezaupanja vrednem okolju, še posebej če lahko terminal nastavi naslov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kan vara en säkerhetsrisk i en miljö som du inte litar på, särskilt om terminalen kan ange titeln."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, güvenilmeyen bir ortamda, özellikle terminal başlığı ayarlayabiliyorsa, güvenlik riski olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này có thể gây rủi ro bảo mật trong môi trường không tin cậy, đặc biệt nếu terminal có thể đặt tiêu đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这在不受信任的环境中可能存在安全风险，尤其是终端可以设置标题时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不受信任的環境中，這可能有安全風險，尤其是終端機可設定標題時。"
          }
        }
      }
    },
