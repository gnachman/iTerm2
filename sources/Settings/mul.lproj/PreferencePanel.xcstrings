          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트 모드에서 윈도우 주위에 두꺼운 테두리"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borda espessa ao redor das janelas no modo claro"
          }
        },
        "ru" : {
          "stringUnit" : {
