    "fwj-4Y-nja.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Enable this to make non-default background colors always opaque. This is useful when using Powerline in a translucent window.\"; ObjectID = \"fwj-4Y-nja\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte, aby barvy pozadí jiné než výchozí byly vždy neprůhledné. To je užitečné při použití Powerline v průsvitném okně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå dette til for altid at gøre baggrundsfarver, der ikke er standard, uigennemsigtige. Det er nyttigt, når Powerline bruges i et gennemsigtigt vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie dies, damit vom Standard abweichende Hintergrundfarben immer deckend sind. Das ist nützlich bei Verwendung von Powerline in einem durchscheinenden Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable this to make non-default background colors always opaque. This is useful when using Powerline in a translucent window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo para que los colores de fondo no predeterminados sean siempre opacos. Es útil al usar Powerline en una ventana translúcida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota tämä käyttöön, jos haluat muiden kuin oletustaustavärien olevan aina läpinäkymättömiä. Tämä on hyödyllistä käytettäessä Powerlinea läpikuultavassa ikkunassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette option pour que les couleurs d’arrière-plan autres que celle par défaut soient toujours opaques. C’est utile avec Powerline dans une fenêtre translucide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita questa opzione per rendere sempre opachi i colori di sfondo non predefiniti. È utile quando usi Powerline in una finestra traslucida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすると、デフォルト以外の背景色は常に不透明になります。半透明のウィンドウでPowerlineを使用する場合に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값이 아닌 배경 색상을 항상 불투명하게 하려면 이 설정을 켜십시오. 반투명 윈도우에서 Powerline을 사용할 때 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver dette for at bakgrunnsfarger som ikke er standard alltid skal være ugjennomsiktige. Dette er nyttig når du bruker Powerline i et gjennomsiktig vindu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel dit in om achtergrondkleuren die niet de standaardkleur zijn altijd ondoorzichtig te maken. Dit is handig als je Powerline gebruikt in een doorschijnend venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz, aby kolory tła inne niż domyślne były zawsze nieprzezroczyste. Przydatne przy używaniu Powerline w półprzezroczystym oknie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative isto para tornar as cores de plano de fundo não padrão sempre opacas. Isto é útil ao usar o Powerline em uma janela translúcida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите это, чтобы нестандартные цвета фона всегда были непрозрачными. Это полезно при использовании Powerline в полупрозрачном окне."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite, aby farby pozadia iné ako predvolené boli vždy nepriehľadné. Je to užitočné pri používaní Powerline v priesvitnom okne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogočite to, da bodo barve ozadja, ki niso privzete, vedno neprosojne. To je uporabno pri uporabi Powerline v prosojnem oknu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera detta för att alltid göra bakgrundsfärger som inte är förval ogenomskinliga. Det är användbart när du använder Powerline i ett genomskinligt fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olmayan arka plan renklerini her zaman opak yapmak için bunu etkinleştirin. Saydam bir pencerede Powerline kullanırken kullanışlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật mục này để các màu nền không mặc định luôn mờ đục. Hữu ích khi dùng Powerline trong cửa sổ trong mờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用此选项可使非默认背景颜色始终不透明。在透明窗口中使用 Powerline 时很有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，非預設的背景顏色一律不透明。在半透明視窗中使用 Powerline 時很有用。"
          }
        }
      }
    },
