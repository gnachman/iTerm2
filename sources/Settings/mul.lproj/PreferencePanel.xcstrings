    "4540.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"\\\"Zoom\\\" is the green button, except on OS 10.10 where you must hold Option while pressing the green button.\"; ObjectID = \"4540\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Přepnout velikost“ je zelené tlačítko, kromě OS 10.10, kde je při klikání na zelené tlačítko nutné držet Option."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Zoom” er den grønne knap, undtagen i OS 10.10, hvor du skal holde Alternativ nede, mens du trykker på den grønne knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zoomen“ ist die grüne Schaltfläche, außer unter OS 10.10, wo Sie beim Klicken auf die grüne Schaltfläche die Option-Taste gedrückt halten müssen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"Zoom\" is the green button, except on OS 10.10 where you must hold Option while pressing the green button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Zoom” es el botón verde, excepto en OS 10.10, donde debes mantener pulsada Opción mientras pulsas el botón verde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Zoomaa” on vihreä painike, paitsi OS 10.10:ssä, jossa optio-näppäintä on pidettävä painettuna vihreää painiketta painettaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Réduire/agrandir » correspond au bouton vert, sauf sur OS 10.10 où vous devez maintenir Option enfoncée en cliquant sur le bouton vert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Zoom” è il pulsante verde, tranne che su OS 10.10, dove devi tenere premuto Opzione mentre premi il pulsante verde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ズーム」は緑色のボタンです。ただしOS 10.10では、緑色のボタンを押しながらOptionキーを押す必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"확대/축소\"는 초록색 버튼입니다. 단, OS 10.10에서는 Option 키를 누른 채로 초록색 버튼을 눌러야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Zoom» er den grønne knappen, bortsett fra i OS 10.10, der du må holde inne Tilvalg mens du trykker på den grønne knappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Vergroot/verklein’ is de groene knop, behalve in OS 10.10, waar je Option ingedrukt moet houden terwijl je op de groene knop klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zmień rozmiar” to zielony przycisk, z wyjątkiem systemu OS 10.10, w którym podczas klikania zielonego przycisku trzeba przytrzymać Option."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Zoom” é o botão verde, exceto no OS 10.10, onde você deve manter Option pressionada ao pressionar o botão verde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Zoom» — это зелёная кнопка, за исключением OS 10.10, где нужно удерживать Option при нажатии зелёной кнопки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zmeniť veľkosť“ je zelené tlačidlo, okrem OS 10.10, kde musíte pri stlačení zeleného tlačidla držať kláves Option."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Povečaj« je zeleni gumb, razen v sistemu OS 10.10, kjer morate med klikom na zeleni gumb držati tipko Option."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Zooma” är den gröna knappen, utom i OS 10.10 där du måste hålla ned alternativtangenten när du trycker på den gröna knappen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Büyüt” yeşil düğmedir; OS 10.10’da yeşil düğmeye basarken Option tuşunu basılı tutmanız gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Thu/Phóng” là nút màu xanh lục, trừ trên OS 10.10, nơi bạn phải giữ Option khi bấm nút màu xanh lục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
