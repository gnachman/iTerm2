    "6Fq-pl-5nd.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Use ligatures for non-ASCII text\"; ObjectID = \"6Fq-pl-5nd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza lligadures per al text no ASCII"
          }
