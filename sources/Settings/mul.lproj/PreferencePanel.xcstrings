    "elQ-vX-kkH.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Avoid repainting while cursor is hidden to reduce flicker while scrolling\"; ObjectID = \"elQ-vX-kkH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuzeichnen bei ausgeblendetem Cursor vermeiden, um Scroll-Flackern zu reduzieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロール中のちらつきを軽減するため、カーソルが非表示の間は再描画を避ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 시 깜박임을 줄이기 위해 커서가 숨겨져 있는 동안 다시 그리지 않기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar redesenhar enquanto o cursor está oculto para reduzir a cintilação ao rolar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не перерисовывать при скрытом курсоре, уменьшая мерцание при прокрутке"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标隐藏时避免重绘以减少滚动闪烁"
          }
        }
      }
    },
