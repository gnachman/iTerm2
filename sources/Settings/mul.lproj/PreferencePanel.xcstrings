    "1l0-rC-jJI.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Locked panes cannot be moved by dragging and require confirmation to close.\"; ObjectID = \"1l0-rC-jJI\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les subfinestres bloquejades no es poden moure arrossegant-les i cal confirmar-ne el tancament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknutá podokna nelze přesouvat přetažením a zavření vyžaduje potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låste ruder kan ikke flyttes ved at trække, og lukning kræver bekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrte Bereiche können nicht per Ziehen verschoben werden und erfordern eine Bestätigung zum Schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλειδωμένα πλαίσια δεν μπορούν να μετακινηθούν με μεταφορά και απαιτούν επιβεβαίωση για το κλείσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Locked panes cannot be moved by dragging and require confirmation to close."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked panes cannot be moved by dragging and require confirmation to close."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked panes cannot be moved by dragging and require confirmation to close."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked panes cannot be moved by dragging and require confirmation to close."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked panes cannot be moved by dragging and require confirmation to close."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked panes cannot be moved by dragging and require confirmation to close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paneles bloqueados no se pueden mover arrastrando y requieren confirmación para cerrarse."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paneles bloqueados no se pueden mover arrastrando y requieren confirmación para cerrarse."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los paneles bloqueados no se pueden mover arrastrando y requieren confirmación para cerrarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukittuja paneeleja ei voi siirtää vetämällä, ja niiden sulkeminen vaatii vahvistuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volets verrouillés ne peuvent pas être déplacés par glisser-déposer et nécessitent une confirmation pour être fermés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les volets verrouillés ne peuvent pas être déplacés par glisser-déposer et nécessitent une confirmation pour être fermés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक किए गए पेन को ड्रैग करके मूव नहीं किया जा सकता और उन्हें बंद करने के लिए पुष्टि आवश्यक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaključana okna ne mogu se premještati povlačenjem, a za zatvaranje je potrebna potvrda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zárolt paneleket nem lehet húzással mozgatni, és bezárásukhoz megerősítés szükséges."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel yang dikunci tidak dapat dipindahkan dengan menyeret dan memerlukan konfirmasi untuk ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I riquadri bloccati non possono essere spostati trascinandoli e richiedono conferma per essere chiusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされたペインはドラッグで移動できず、閉じるには確認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠긴 패널은 드래그하여 이동할 수 없으며 닫을 때 확인이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anak tetingkap yang dikunci tidak boleh dialihkan dengan menyeret dan memerlukan pengesahan untuk ditutup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låste ruter kan ikke flyttes ved å dra, og krever bekreftelse for å lukkes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendelde panelen kunnen niet worden verplaatst door te slepen en vereisen bevestiging om te sluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowanych paneli nie można przenosić przeciąganiem, a ich zamknięcie wymaga potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painéis bloqueados não podem ser movidos arrastando e exigem confirmação para fechar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os painéis bloqueados não podem ser movidos ao arrastar e exigem confirmação para fechar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panourile blocate nu pot fi mutate prin tragere și necesită confirmare pentru a fi închise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные панели нельзя перемещать перетаскиванием, и для их закрытия требуется подтверждение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknuté panely nie je možné presúvať potiahnutím a ich zatvorenie vyžaduje potvrdenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaklenjenih podoken ni mogoče premikati z vlečenjem, za zapiranje pa je potrebna potrditev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låsta paneler kan inte flyttas genom att dras och kräver bekräftelse för att stängas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บานหน้าต่างที่ล็อคไว้จะย้ายด้วยการลากไม่ได้ และต้องยืนยันก่อนปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli bölmeler sürüklenerek taşınamaz ve kapatmak için onay gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замкнені панелі не можна переміщувати перетягуванням, а для їх закриття потрібне підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khung bị khóa không thể di chuyển bằng cách kéo và cần xác nhận để đóng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已锁定的窗格无法通过拖移来移动，关闭时需要确认。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已鎖定的窗格無法拖移，且關閉時需要確認。"
