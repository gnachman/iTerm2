    "X0w-pC-g9j.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Enables the specified color for bold text. Also has the side-effect of using the bright version of ANSI colors for bold text in a ”normal“ ANSI color.\"; ObjectID = \"X0w-pC-g9j\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne zadanou barvu pro tučný text. Vedlejším účinkem je také použití jasné verze barev ANSI pro tučný text v „normální“ barvě ANSI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverer den angivne farve for fed tekst. Har også den bivirkning, at den lyse version af ANSI-farver bruges til fed tekst i en “normal” ANSI-farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert die angegebene Farbe für fett formatierten Text. Hat außerdem den Nebeneffekt, dass für fett formatierten Text in einer „normalen“ ANSI-Farbe die helle Version der ANSI-Farben verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enables the specified color for bold text. Also has the side-effect of using the bright version of ANSI colors for bold text in a ”normal“ ANSI color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el color especificado para el texto en negrita. También tiene el efecto secundario de usar la versión brillante de los colores ANSI para el texto en negrita con un color ANSI “normal”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottaa käyttöön määritetyn värin lihavoidulle tekstille. Sivuvaikutuksena lihavoitu teksti ”normaalilla” ANSI-värillä käyttää ANSI-värin kirkasta versiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active la couleur indiquée pour le texte en gras. A aussi pour effet secondaire d’utiliser la version vive des couleurs ANSI pour le texte en gras dans une couleur ANSI « normale »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita il colore specificato per il testo in grassetto. Ha anche l’effetto collaterale di usare la versione brillante dei colori ANSI per il testo in grassetto con un colore ANSI “normale”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太字テキストに指定した色を有効にします。また、太字テキストが「通常」のANSI色である場合に、ANSI色の明るいバージョンを使用するという副作用もあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼드체 텍스트에 지정한 색상을 사용합니다. 또한 ”일반“ ANSI 색상의 볼드체 텍스트에 밝은 ANSI 색상을 사용하는 부수 효과도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverer den angitte fargen for fet tekst. Har også den bivirkningen at den lyse versjonen av ANSI-fargene brukes for fet tekst i en «normal» ANSI-farge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt de opgegeven kleur voor vetgedrukte tekst in. Heeft als bijeffect dat de heldere versie van ANSI-kleuren wordt gebruikt voor vetgedrukte tekst in een ‘normale’ ANSI-kleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza określony kolor pogrubionego tekstu. Ma też efekt uboczny: dla pogrubionego tekstu w „normalnym” kolorze ANSI używana jest jasna wersja kolorów ANSI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa a cor especificada para texto em negrito. Também tem o efeito colateral de usar a versão brilhante das cores ANSI para texto em negrito em uma cor ANSI “normal”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает указанный цвет для жирного текста. Также побочным эффектом является использование яркой версии цветов ANSI для жирного текста, использующего «обычный» цвет ANSI."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne zadanú farbu pre tučný text. Vedľajším účinkom je aj použitie jasnej verzie farieb ANSI pre tučný text v „normálnej“ farbe ANSI."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči navedeno barvo za krepko besedilo. Ima tudi stranski učinek, da se za krepko besedilo v »običajni« barvi ANSI uporabi svetla različica barv ANSI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverar den angivna färgen för fet text. Har också den bieffekten att den ljusa versionen av ANSI-färger används för fet text i en ”normal” ANSI-färg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalın metin için belirtilen rengi etkinleştirir. Ayrıca “normal” bir ANSI renginde kalın metin için ANSI renklerinin parlak sürümünü kullanma yan etkisi vardır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật màu được chỉ định cho văn bản đậm. Cũng có tác dụng phụ là dùng phiên bản sáng của màu ANSI cho văn bản đậm có màu ANSI “thường”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为粗体文本启用指定颜色。还有一个副作用：在“标准”ANSI 颜色中使用亮色版 ANSI 颜色显示粗体文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為粗體文字啟用指定的顏色。副作用是，對「標準」ANSI 顏色的粗體文字會使用 ANSI 顏色的亮色版本。"
          }
        }
      }
    },
