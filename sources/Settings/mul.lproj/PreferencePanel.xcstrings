    "HqN-xF-ITg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you prefer not to use it for horizontal scrolling. Alternate mouse scroll takes priority over swipe to switch tabs.\"; ObjectID = \"HqN-xF-ITg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatives Mausrad-Scrollen ist eine Funktion, die als Reaktion auf Mausrad-/Scroll-Gesten Pfeiltasten sendet. Aktivieren Sie dies, wenn Sie es nicht für horizontales Scrollen verwenden möchten. Alternatives Mausrad-Scrollen hat Vorrang vor dem Wischen zum Wechseln der Tabs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you prefer not to use it for horizontal scrolling. Alternate mouse scroll takes priority over swipe to switch tabs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、マウスホイール/スクロールジェスチャに応じて矢印キーを送信する機能です。水平スクロールに使用したくない場合は、これを有効にしてください。代替マウススクロールは、スワイプによるタブ切り替えよりも優先されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda/gestos de rolagem. Ative isto se preferir não usá-la para rolagem horizontal. A rolagem alternativa do mouse tem prioridade sobre o deslize para trocar de aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альтернативная прокрутка мышью отправляет клавиши со стрелками в ответ на события колеса мыши или жесты прокрутки. Включите это, если не хотите использовать её для горизонтальной прокрутки. Альтернативная прокрутка мышью имеет приоритет над жестом переключения вкладок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能。如果你不希望它用于水平滚动，请启用此选项。备用鼠标滚动优先于滑动切换标签页。"
          }
        }
      }
    },
