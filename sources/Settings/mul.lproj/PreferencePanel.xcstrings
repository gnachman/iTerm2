            "state" : "translated",
            "value" : "Saat menempelkan nama file yang dijatuhkan, apit dengan tanda kutip ganda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando incolli il nome di un file rilasciato, racchiudilo tra virgolette doppie"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドロップされたファイル名を貼り付けるときに二重引用符で囲む"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드롭한 파일 이름을 붙여넣을 때 큰따옴표로 감싸기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila menampal nama fail yang dijatuhkan, bungkus dalam tanda petikan berganda"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved innliming av et sluppet filnavn, sett det i dobbelte anførselstegn"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet bij het plakken van een neergezette bestandsnaam deze tussen dubbele aanhalingstekens"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wklejaniu upuszczonej nazwy pliku ujmij ją w cudzysłów"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar um nome de arquivo arrastado, colocá-lo entre aspas duplas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar um nome de ficheiro largado, colocá-lo entre aspas duplas"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lipirea unui nume de fișier tras, încadrați-l între ghilimele duble"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При вставке перетащенного имени файла заключать его в двойные кавычки"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vkladaní názvu pusteného súboru ho uzavrieť do dvojitých úvodzoviek"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri lepljenju spuščenega imena datoteke ga postavi v dvojne narekovaje"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätt filnamnet inom dubbla citattecken när ett släppt filnamn klistras in"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อวางชื่อไฟล์ที่ลากมาวาง ให้ครอบด้วยเครื่องหมายคำพูดคู่"
          }
        },
        "tr" : {
          "stringUnit" : {
