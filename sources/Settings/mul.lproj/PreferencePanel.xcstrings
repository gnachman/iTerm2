          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドはナイトリービルドチャンネルです。ベータ版やリリース版に更新することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드는 나이틀리 빌드 채널에 있습니다. 베타 또는 정식 빌드로 업데이트할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binaan ini berada dalam saluran binaan nightly. Ia tidak boleh dikemas kini kepada binaan beta atau keluaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne versjonen er i kanalen for nightly-bygg. Den kan ikke oppdateres til beta- eller utgivelsesbygg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze build zit in het nightly-buildkanaal. Er kan niet worden bijgewerkt naar beta- of definitieve builds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kompilacja pochodzi z kanału kompilacji nightly. Nie można jej uaktualnić do kompilacji beta ani wydań stabilnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este build está no canal de builds nightly. Não é possível atualizar para builds beta ou de lançamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilação está no canal de compilações nightly. Não é possível atualizar para compilações beta ou de lançamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această versiune se află în canalul de versiuni nightly. Nu poate fi actualizată la versiuni beta sau finale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка относится к ночному каналу обновлений. Она не может обновиться до бета- или релизных сборок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto zostava je v kanáli nočných zostáv (nightly). Nemôže sa aktualizovať na beta ani vydané zostavy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta različica je v kanalu nočnih različic. Ne more se posodobiti na različice beta ali izdane različice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen finns i kanalen för nattliga versioner. Den kan inte uppdateras till beta- eller officiella versioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิลด์นี้อยู่ในช่องทางบิลด์ nightly ไม่สามารถอัปเดตเป็นบิลด์เบต้าหรือบิลด์จริงได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yapı nightly yapı kanalında. Beta veya sürüm yapılarına güncellenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця збірка належить до каналу нічних збірок. Її не можна оновити до бета-збірок або випусків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng này thuộc kênh bản dựng hằng đêm. Nó không thể cập nhật lên bản beta hoặc bản phát hành."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本位于nightly构建通道，无法更新到测试版或正式版。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本屬於 nightly 組建頻道，無法更新至 Beta 或正式版組建。"
          }
