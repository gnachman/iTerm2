    "xxq-Mn-NRG.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it.\"; ObjectID = \"xxq-Mn-NRG\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vkládání v závorkách říká kompatibilním aplikacím, že text byl vložen operací vložení, a ne napsán. Některé programy toho využívají ke zvláštnímu zacházení s vloženým textem, například nepoužijí automatické odsazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupperet indsætning fortæller kompatible apps, at tekst blev indsat med en indsætning og ikke ved at blive skrevet. Nogle programmer bruger det til at behandle indsætninger specielt, f.eks. ved ikke at indrykke automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste Bracketing teilt kompatiblen Apps mit, dass Text durch einen Einfügevorgang und nicht durch Tippen eingefügt wurde. Manche Programme nutzen dies, um eingefügten Text speziell zu behandeln, etwa indem sie ihn nicht automatisch einrücken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pegado entre delimitadores indica a las apps compatibles que el texto se insertó mediante una operación de pegado y no escribiéndolo. Algunos programas lo usan para tratar los pegados de forma especial, por ejemplo, sin aplicar sangría automática."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulkeistettu sijoitus kertoo yhteensopiville sovelluksille, että teksti lisättiin sijoittamalla eikä kirjoittamalla. Jotkin ohjelmat käsittelevät sijoitukset tämän perusteella erikoisesti, esimerkiksi jättämällä sisennyksen automaattisesti tekemättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage délimité indique aux apps compatibles que le texte a été inséré par un collage et non saisi au clavier. Certains programmes s’en servent pour traiter les collages différemment, par exemple en n’appliquant pas l’indentation automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’incolla delimitato segnala alle app compatibili che il testo è stato inserito con un’operazione di incolla anziché digitato. Alcuni programmi lo usano per trattare in modo speciale il testo incollato, ad esempio non applicando il rientro automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストブラケッティングは、テキストがタイピングではなく貼り付け操作によって挿入されたことを対応アプリに伝えます。一部のプログラムはこれを利用して、自動インデントを行わないなど、貼り付けを特別に扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브래킷 붙여넣기는 텍스트가 타이핑이 아니라 붙여넣기로 입력되었음을 호환 앱에 알려 줍니다. 일부 프로그램은 이를 이용해 붙여넣은 텍스트를 자동 들여쓰기하지 않는 등 특별하게 처리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgrenset innliming forteller kompatible apper at teksten ble satt inn ved innliming og ikke ved skriving. Noen programmer bruker dette til å behandle innliming spesielt, for eksempel ved å ikke rykke inn automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geaccoladeerd plakken (bracketed paste) laat compatibele apps weten dat tekst is ingevoegd met een plakactie en niet is getypt. Sommige programma’s gebruiken dit om geplakte tekst anders te behandelen, bijvoorbeeld door die niet automatisch te laten inspringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklejanie w nawiasach informuje zgodne aplikacje, że tekst został wstawiony przez wklejenie, a nie wpisany. Niektóre programy używają tego do specjalnego traktowania wklejanego tekstu, np. bez automatycznego wcięcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bracketing de colagem informa aos apps compatíveis que o texto foi inserido por uma operação de colagem em vez de digitação. Alguns programas usam isto para tratar colagens de forma especial, por exemplo, não as indentando automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скобочная вставка сообщает совместимым приложениям, что текст был вставлен операцией вставки, а не набран вручную. Некоторые программы используют это, чтобы обрабатывать вставленный текст особым образом, например не применяя к нему автоматический отступ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vkladanie so zátvorkami oznamuje kompatibilným aplikáciám, že text bol vložený operáciou vloženia, a nie napísaný. Niektoré programy to využívajú na osobitné spracovanie vloženého textu, napríklad bez automatického odsadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepljenje v oklepajih združljivim aplikacijam sporoči, da je bilo besedilo vstavljeno z lepljenjem in ne s tipkanjem. Nekateri programi to uporabijo za poseben pristop do lepljenja, na primer brez samodejnega zamika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklistring inom hakparentes talar om för kompatibla appar att texten infogades genom inklistring och inte genom att skrivas. Vissa program använder detta för att behandla inklistringar särskilt, till exempel genom att inte dra in texten automatiskt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayraçlı yapıştırma, uyumlu uygulamalara metnin yazılarak değil yapıştırma işlemiyle eklendiğini bildirir. Bazı programlar bunu, yapıştırılan metni otomatik girintilememek gibi özel şekilde işlemek için kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán có đánh dấu cho các ứng dụng tương thích biết văn bản được chèn bằng thao tác dán chứ không phải gõ. Một số chương trình dùng điều này để xử lý riêng khi dán, chẳng hạn không tự động thụt lề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴括号告知兼容的应用，文本是通过粘贴操作而非键入插入的。某些程序会借此特殊处理粘贴内容，例如不自动缩进。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "括號貼上會告知相容的 App，文字是透過貼上操作而非鍵入插入的。某些程式會藉此特別處理貼上的內容，例如不自動縮排。"
          }
        }
      }
    },
