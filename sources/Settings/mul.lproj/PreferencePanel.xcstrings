    "hpW-Cl-kBV.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Let macOS decide the position of new windows and use size from profile\"; ObjectID = \"hpW-Cl-kBV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechat macOS určit pozici nových oken a použít velikost z profilu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad macOS bestemme placeringen af nye vinduer, og brug størrelsen fra profilen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS die Position neuer Fenster entscheiden lassen und Größe aus dem Profil verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Let macOS decide the position of new windows and use size from profile"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar que macOS decida la posición de las ventanas nuevas y usar el tamaño del perfil"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anna macOS:n päättää uusien ikkunoiden sijainti ja käytä profiilin kokoa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser macOS décider de la position des nouvelles fenêtres et utiliser la taille du profil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che macOS decida la posizione delle nuove finestre e usa le dimensioni del profilo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウィンドウの位置はmacOSに任せ、サイズはプロファイルから使用する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 윈도우의 위치는 macOS가 결정하고 크기는 프로파일 설정 사용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macOS bestemme plasseringen av nye vinduer og bruk størrelsen fra profilen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat macOS de positie van nieuwe vensters bepalen en gebruik de grootte uit het profiel"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól systemowi macOS wybierać pozycję nowych okien i używaj rozmiaru z profilu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixar o macOS decidir a posição das novas janelas e usar o tamanho do perfil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволить macOS решать положение новых окон и использовать размер из профиля"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechať macOS rozhodnúť o polohe nových okien a použiť veľkosť z profilu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naj macOS določi položaj novih oken, velikost pa se uporabi iz profila"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt macOS bestämma positionen för nya fönster och använd storleken från profilen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni pencerelerin konumuna macOS karar versin ve boyutu profilden kullan"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để macOS quyết định vị trí của cửa sổ mới và dùng kích thước từ hồ sơ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 macOS 决定新窗口位置并使用配置文件中的大小"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 macOS 決定新視窗的位置，並使用描述檔中的大小"
          }
        }
      }
    },
    "HqN-xF-ITg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you prefer not to use it for horizontal scrolling. Alternate mouse scroll takes priority over swipe to switch tabs.\"; ObjectID = \"HqN-xF-ITg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativní posouvání myší je funkce, která v reakci na kolečko myši nebo gesta posouvání odesílá šipky. Zapněte to, pokud ji nechcete používat pro vodorovné posouvání. Alternativní posouvání myší má přednost před přejetím pro přepnutí panelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulning er en funktion, der sender piletaster som svar på rullehjul/rullebevægelser. Slå dette til, hvis du helst ikke vil bruge den til vandret rulning. Alternativ musrulning har forrang over stryg for at skifte fane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatives Mausrad-Scrollen ist eine Funktion, die als Reaktion auf Mausrad-/Scroll-Gesten Pfeiltasten sendet. Aktivieren Sie dies, wenn Sie es nicht für horizontales Scrollen verwenden möchten. Alternatives Mausrad-Scrollen hat Vorrang vor dem Wischen zum Wechseln der Tabs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you prefer not to use it for horizontal scrolling. Alternate mouse scroll takes priority over swipe to switch tabs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del ratón es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Actívalo si prefieres no usarlo para el desplazamiento horizontal. El desplazamiento alternativo del ratón tiene prioridad sobre deslizar para cambiar de pestaña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoinen hiirivieritys on toiminto, joka lähettää nuolinäppäimiä vierityspyörän tai vierityselekien perusteella. Ota tämä käyttöön, jos et halua käyttää sitä vaakavieritykseen. Vaihtoehtoinen hiirivieritys on etusijalla välilehden vaihtamiseen pyyhkäisemällä nähden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Activez cette option si vous préférez ne pas l’utiliser pour le défilement horizontal. Le défilement alternatif de la souris a priorité sur le balayage pour changer d’onglet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scorrimento alternativo del mouse è una funzione che invia i tasti freccia in risposta alla rotellina o ai gesti di scorrimento. Abilitalo se preferisci non usarlo per lo scorrimento orizzontale. Lo scorrimento alternativo del mouse ha la precedenza sullo scorrimento per cambiare pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、マウスホイール/スクロールジェスチャに応じて矢印キーを送信する機能です。水平スクロールに使用したくない場合は、これを有効にしてください。代替マウススクロールは、スワイプによるタブ切り替えよりも優先されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 마우스 스크롤은 스크롤 휠/스크롤 제스처에 반응하여 화살표 키를 보내는 기능입니다. 가로 스크롤에는 이 기능을 사용하고 싶지 않다면 이 설정을 켜십시오. 대체 마우스 스크롤은 쓸어넘겨 탭 전환하기보다 우선합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulling er en funksjon som sender piltaster som svar på rullehjul og rullebevegelser. Aktiver dette hvis du heller vil slippe å bruke den til horisontal rulling. Alternativ musrulling har forrang over sveiping for å bytte fane."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatief muisscrollen is een functie die pijltoetsen verstuurt als reactie op het scrollwiel of scrolgebaren. Schakel dit in als je het liever niet gebruikt voor horizontaal scrollen. Alternatief muisscrollen heeft voorrang op vegen om van tabblad te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatywne przewijanie myszą to funkcja, która wysyła klawisze strzałek w odpowiedzi na kółko myszy lub gesty przewijania. Włącz tę opcję, jeśli wolisz nie używać go do przewijania poziomego. Alternatywne przewijanie myszą ma priorytet nad przesunięciem do przełączania kart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda/gestos de rolagem. Ative isto se preferir não usá-la para rolagem horizontal. A rolagem alternativa do mouse tem prioridade sobre o deslize para trocar de aba."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альтернативная прокрутка мышью отправляет клавиши со стрелками в ответ на события колеса мыши или жесты прокрутки. Включите это, если не хотите использовать её для горизонтальной прокрутки. Альтернативная прокрутка мышью имеет приоритет над жестом переключения вкладок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatívne rolovanie myšou je funkcia, ktorá v reakcii na kolieskovú myš alebo gestá rolovania odosiela šípky. Zapnite túto možnosť, ak ho nechcete používať na vodorovné rolovanie. Alternatívne rolovanie myšou má prednosť pred potiahnutím na prepínanie tabov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadomestno pomikanje z miško je funkcija, ki ob pomikanju s kolescem ali s potezami pošilja puščične tipke. Omogočite to, če je ne želite uporabljati za vodoravno pomikanje. Nadomestno pomikanje z miško ima prednost pred potegom za preklapljanje zavihkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrullning är en funktion som skickar piltangenter som svar på rullhjul och rullningsgester. Aktivera detta om du inte vill använda den för horisontell rullning. Alternativ musrullning har företräde framför svep för att byta flik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif Fare Kaydırma, kaydırma tekerleği/kaydırma hareketlerine karşılık olarak ok tuşları gönderen bir özelliktir. Yatay kaydırma için kullanmak istemiyorsanız bunu etkinleştirin. Alternatif fare kaydırma, sekme değiştirmek için kaydırma hareketinden önceliklidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn chuột thay thế là tính năng gửi phím mũi tên khi cuộn bằng con lăn hoặc cử chỉ cuộn. Bật tùy chọn này nếu bạn không muốn dùng nó để cuộn ngang. Cuộn chuột thay thế được ưu tiên hơn vuốt để chuyển tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能。如果你不希望它用于水平滚动，请启用此选项。备用鼠标滚动优先于滑动切换标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替代滑鼠捲動是一項功能，會在使用滾輪或捲動手勢時傳送方向鍵。若不想將其用於水平捲動，請啟用此選項。替代滑鼠捲動的優先順序高於以掃過手勢切換標籤頁。"
          }
        }
      }
    },
