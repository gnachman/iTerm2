    "ehw-7A-A75.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing.\"; ObjectID = \"ehw-7A-A75\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto tlačítkem lze ručně vyhledat plug-in prohlížeče. Pokud jej nelze najít automaticky nebo pokud je s plug-inem něco v nepořádku a automatická identifikace nefunguje, použijte je k opravě problému nebo ke zjištění, proč selhává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug denne knap til manuelt at finde browserpluginet. Hvis det ikke kan findes automatisk, eller hvis der er noget galt med pluginet, så automatisk identifikation ikke virker, kan du bruge den til at løse problemet eller finde ud af, hvorfor det mislykkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie diese Schaltfläche, um das Browser-Plugin manuell zu suchen. Falls es nicht automatisch gefunden werden kann oder ein Problem mit dem Plugin die automatische Erkennung verhindert, können Sie damit das Problem beheben oder herausfinden, warum es fehlschlägt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este botón para localizar manualmente el plugin del navegador. Si no se encuentra automáticamente, o si algo falla en el plugin e impide que funcione la identificación automática, úsalo para solucionar el problema o saber por qué falla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tätä painiketta selaimen liitännäisen paikantamiseen käsin. Jos sitä ei löydy automaattisesti tai jokin liitännäisessä estää automaattisen tunnistuksen toiminnan, korjaa ongelma tai selvitä sen syy tämän avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce bouton pour localiser manuellement le module du navigateur. S’il est introuvable automatiquement, ou si un problème du module empêche l’identification automatique, utilisez-le pour résoudre le problème ou en comprendre la cause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa questo pulsante per individuare manualmente il plug-in del browser. Se non viene trovato automaticamente, o se un problema del plug-in impedisce l’identificazione automatica, usalo per risolvere il problema o scoprire perché non funziona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボタンを使うと、ブラウザプラグインの場所を手動で指定できます。自動的に見つからない場合や、プラグインに問題があり自動認識が機能しない場合は、これを使って問題を解決するか、失敗の原因を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버튼을 사용하여 브라우저 플러그인의 위치를 직접 찾을 수 있습니다. 플러그인을 자동으로 찾을 수 없거나 플러그인에 문제가 있어 자동 식별이 작동하지 않는 경우, 이 버튼으로 문제를 해결하거나 실패 원인을 알아볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk denne knappen til å finne nettlesertillegget manuelt. Hvis det ikke blir funnet automatisk, eller hvis noe er galt med tillegget slik at automatisk gjenkjenning ikke fungerer, kan du bruke dette til å løse problemet eller finne ut hvorfor det mislykkes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik deze knop om de browserplug-in handmatig te zoeken. Als deze niet automatisch kan worden gevonden, of als er iets mis is met de plug-in waardoor automatische herkenning niet werkt, kun je hiermee het probleem oplossen of zien waarom het misgaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj tego przycisku, aby ręcznie wskazać wtyczkę przeglądarki. Jeśli nie można jej znaleźć automatycznie lub jeśli coś jest nie tak z wtyczką i uniemożliwia automatyczne rozpoznanie, użyj go, aby naprawić problem lub dowiedzieć się, dlaczego nie działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este botão para localizar manualmente o plugin do navegador. Se ele não puder ser encontrado automaticamente, ou se algo estiver errado com o plugin que impeça o funcionamento da identificação automática, use isto para corrigir o problema ou descobrir por que está falhando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте эту кнопку, чтобы вручную указать расположение плагина браузера. Если он не может быть найден автоматически или что-то не так с плагином, мешающее автоматическому определению, используйте это, чтобы устранить проблему или узнать причину сбоя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto tlačidlom ručne vyhľadáte plugin prehliadača. Ak sa nenájde automaticky alebo ak s pluginom nie je niečo v poriadku a bráni to automatickej identifikácii, použite ho na odstránenie problému alebo zistenie, prečo zlyháva."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem gumbom ročno poiščete vtičnik brskalnika. Če ga ni mogoče najti samodejno ali če je z vtičnikom nekaj narobe in samodejna prepoznava ne deluje, ga uporabite za odpravo težave ali ugotovitev vzroka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd den här knappen för att leta upp webbläsarpluginet manuellt. Om det inte hittas automatiskt, eller om något är fel med pluginet så att automatisk identifiering inte fungerar, kan du använda den för att åtgärda problemet eller ta reda på varför det misslyckas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı eklentisini elle bulmak için bu düğmeyi kullanın. Otomatik olarak bulunamıyorsa veya eklentideki bir sorun otomatik tanımayı engelliyorsa, sorunu gidermek ya da nedenini öğrenmek için bunu kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng nút này để tự định vị trình cắm của trình duyệt. Nếu không thể tìm thấy tự động, hoặc nếu trình cắm có lỗi khiến việc nhận dạng tự động không hoạt động, hãy dùng nút này để khắc phục sự cố hoặc tìm hiểu nguyên nhân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按钮手动定位浏览器插件。如果无法自动找到它，或插件出现问题导致无法自动识别，请使用此选项修复问题或了解失败原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按鈕手動尋找瀏覽器外掛程式。如果無法自動找到，或外掛程式有問題導致無法自動辨識，請使用此功能修正問題或了解失敗原因。"
          }
        }
      }
    },
    "eid-kp-DfH.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth.\"; ObjectID = \"eid-kp-DfH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzory ve tvaru podtržítka a svislé čáry mohou vrhat jemný stín na znak pod kurzorem, což vytváří dojem hloubky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markører som understregning og lodret streg kan kaste en blød skygge på tegnet under markøren, så det får en fornemmelse af dybde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstrich- und vertikale Balken-Cursor können einen weichen Schlagschatten auf das Zeichen unter dem Cursor werfen, was ihm einen Eindruck von Tiefe verleiht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cursores de subrayado y de barra vertical pueden proyectar una sombra suave sobre el carácter que hay debajo del cursor, dándole sensación de profundidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleviivaus- ja pystyviivakohdistimet voivat heittää pehmeän varjon kohdistimen alla olevan merkin päälle, mikä antaa syvyysvaikutelman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les curseurs en trait de soulignement et en barre verticale peuvent projeter une ombre portée douce sur le caractère situé sous le curseur, lui donnant de la profondeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cursori a sottolineatura e a barra verticale possono proiettare una leggera ombra sul carattere sottostante, dandogli un senso di profondità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下線カーソルと縦棒カーソルは、カーソルの下にある文字に柔らかいドロップシャドウを落とすことができ、奥行きのある印象を与えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밑줄 커서와 세로 막대 커서는 커서 아래의 문자에 부드러운 그림자를 드리워 입체감을 줄 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understrekings- og loddrett strek-markører kan kaste en myk skygge på tegnet under markøren, slik at det får en følelse av dybde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderstreepte cursors en cursors in de vorm van een verticale streep kunnen een zachte slagschaduw werpen op het teken onder de cursor, waardoor het meer diepte krijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursory podkreślenia i pionowej kreski mogą rzucać miękki cień na znak pod kursorem, nadając mu wrażenie głębi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursores de sublinhado e de barra vertical podem projetar uma sombra suave sobre o caractere abaixo do cursor, dando a ele uma sensação de profundidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсоры-подчёркивания и вертикальные курсоры могут отбрасывать мягкую тень на символ под курсором, создавая ощущение глубины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzory podčiarknutia a zvislej čiary môžu vrhať jemný tieň na znak pod kurzorom, čím mu dodajú dojem hĺbky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazalca s podčrtajem in navpično črto lahko vržeta mehko senco na znak pod kazalcem, kar daje občutek globine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understrykningsmarkörer och vertikala stapelmarkörer kan kasta en mjuk skugga på tecknet under markören, vilket ger ett intryck av djup."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt çizgi ve dikey çubuk imleçler, imlecin altındaki karaktere yumuşak bir gölge düşürerek derinlik hissi verebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con trỏ gạch chân và thanh dọc có thể đổ bóng mờ lên ký tự bên dưới con trỏ, tạo cảm giác chiều sâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下划线光标和竖线光标可以给光标下方的字符投射柔和的阴影，使其具有立体感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底線與垂直線游標可以在游標下方的字元上投射柔和的陰影，使其更具立體感。"
          }
        }
      }
    },
    "EkI-wa-K9H.ibShadowedToolTip" : {
      "comment" : "Class = \"NSTextField\"; ibShadowedToolTip = \"The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents.\"; ObjectID = \"EkI-wa-K9H\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikátor průběhu je v horní části relace. Aby nepřekrýval obsah terminálu, nemůže přesáhnout výšku horního okraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremdriftslinjen placeres øverst i sessionen. Den kan ikke overstige den øverste margens højde, så den ikke overlapper terminalens indhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fortschrittsanzeige befindet sich oben in der Sitzung. Sie kann die Höhe des oberen Rands nicht überschreiten, um eine Überlappung mit dem Terminalinhalt zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de progreso va en la parte superior de la sesión. No puede superar la altura del margen superior para evitar solaparse con el contenido de la terminal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edistymispalkki sijaitsee istunnon yläreunassa. Se ei voi ylittää ylämarginaalin korkeutta, jotta se ei peitä päätteen sisältöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de progression se place en haut de la session. Elle ne peut pas dépasser la hauteur de la marge supérieure afin de ne pas recouvrir le contenu du terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra di avanzamento si trova in cima alla sessione. Non può superare l’altezza del margine superiore per evitare di sovrapporsi al contenuto del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プログレスバーはセッションの上部に表示されます。ターミナルの内容と重ならないよう、上部マージンの高さを超えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 막대는 세션 상단에 표시됩니다. 터미널 내용과 겹치지 않도록 상단 여백 높이를 초과할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremdriftslinjen ligger øverst i økten. Den kan ikke overstige høyden på toppmarginen, slik at den ikke overlapper terminalinnholdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De voortgangsbalk staat bovenaan de sessie. Hij kan niet hoger zijn dan de bovenmarge, zodat hij de inhoud van de terminal niet overlapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek postępu znajduje się na górze sesji. Nie może przekraczać wysokości górnego marginesu, aby nie zasłaniać zawartości terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra de progresso fica no topo da sessão. Ela não pode exceder a altura da margem superior para evitar sobreposição com o conteúdo do terminal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индикатор выполнения располагается в верхней части сессии. Он не может превышать высоту верхнего поля, чтобы не перекрывать содержимое терминала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikátor priebehu je v hornej časti relácie. Nemôže presiahnuť výšku horného okraja, aby neprekrýval obsah terminálu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrstica napredka je na vrhu seje. Ne more presegati višine zgornjega roba, da se ne prekriva z vsebino terminala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förloppsindikatorn placeras överst i sessionen. Den kan inte vara högre än den övre marginalen, så att den inte överlappar terminalens innehåll."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme çubuğu oturumun üstünde yer alır. Terminal içeriğiyle çakışmamak için üst kenar boşluğu yüksekliğini aşamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh tiến trình nằm ở đầu phiên. Nó không thể vượt quá chiều cao lề trên để tránh chồng lên nội dung terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条位于会话顶部。它不能超过上边距高度，以避免与终端内容重叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度列位於工作階段頂部。為避免與終端機內容重疊，其高度不能超過上邊界高度。"
          }
        }
      }
    },
