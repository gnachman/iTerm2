    "6279.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Items are added to the context menu when you right click on text matching this smart selection.\"; ObjectID = \"6279\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge werden dem Kontextmenü hinzugefügt, wenn Sie mit der rechten Maustaste auf Text klicken, der dieser intelligenten Auswahl entspricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
