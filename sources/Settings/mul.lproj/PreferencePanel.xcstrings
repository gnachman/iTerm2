    "Knh-H9-rWW.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"When enabled, everything you type in the Composer will be shared with your AI provider.\"; ObjectID = \"Knh-H9-rWW\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, tot el que escriguis al compositor d’ordres es compartirà amb el teu proveïdor d’IA."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, vše, co napíšete do editoru příkazů, bude sdíleno s vaším poskytovatelem AI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, deles alt, hvad du skriver i kommandoeditoren, med din AI-udbyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird alles, was Sie im Kompositionsfeld eingeben, mit Ihrem KI-Anbieter geteilt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, ό,τι πληκτρολογείτε στον συντάκτη εντολών θα κοινοποιείται στον πάροχο AI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, everything you type in the Composer will be shared with your AI provider."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, everything you type in the Composer will be shared with your AI provider."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, everything you type in the Composer will be shared with your AI provider."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, everything you type in the Composer will be shared with your AI provider."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, everything you type in the Composer will be shared with your AI provider."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, everything you type in the Composer will be shared with your AI provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, todo lo que escribas en el compositor se compartirá con tu proveedor de IA."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, todo lo que escribas en el compositor se compartirá con tu proveedor de IA."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, todo lo que escribas en el compositor se compartirá con tu proveedor de IA."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, kaikki komentoeditoriin kirjoittamasi jaetaan AI-palveluntarjoajasi kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, tout ce que vous saisissez dans le compositeur sera partagé avec votre fournisseur d’IA."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, tout ce que vous entrez dans le compositeur sera partagé avec votre fournisseur d’IA."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, आप कंपोज़र में जो कुछ भी टाइप करेंगे वह आपके AI प्रदाता के साथ साझा किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je omogućeno, sve što upišete u Uređivač naredbi dijelit će se s vašim AI pružateljem."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, minden, amit a Parancsszerkesztőben begépel, megosztásra kerül az AI-szolgáltatóval."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, semua yang Anda ketik di Penyusun Perintah akan dibagikan kepada penyedia AI Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, tutto ciò che scrivi nel compositore verrà condiviso con il tuo provider IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、コンポーザーに入力したすべての内容がAIプロバイダーと共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 컴포저에 입력한 모든 내용이 AI 제공업체와 공유됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, semua yang anda taip dalam Penyusun Perintah akan dikongsi dengan pembekal AI anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, deles alt du skriver i kommandoskriveren med KI-leverandøren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, wordt alles wat je in de opsteller typt gedeeld met je AI-aanbieder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, wszystko, co wpiszesz w Edytorze poleceń, będzie udostępniane Twojemu dostawcy AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, tudo o que você digitar no Compositor será compartilhado com seu provedor de IA."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, tudo o que escrever no Compositor será partilhado com o seu fornecedor de IA."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activat, tot ce tastați în Editorul de comenzi va fi partajat cu furnizorul dvs. de AI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, всё, что вы вводите в Композиторе, будет передаваться вашему поставщику ИИ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, všetko, čo napíšete do editora príkazov, sa zdieľa s vaším poskytovateľom AI."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, bo vse, kar vnesete v urejevalnik ukazov, deljeno z vašim ponudnikom AI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på delas allt du skriver i kommandoredigeraren med din AI-leverantör."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ ทุกสิ่งที่คุณพิมพ์ในตัวเขียนคำสั่งจะถูกแชร์กับผู้ให้บริการ AI ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, Oluşturucu alanına yazdığınız her şey YZ sağlayıcınızla paylaşılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, усе, що ви вводите в редакторі команд, буде передаватися вашому постачальнику ШІ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, mọi thứ bạn gõ trong Trình soạn lệnh sẽ được chia sẻ với nhà cung cấp AI của bạn."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，你在编写器中输入的所有内容都将与你的AI提供商共享。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，在編寫器中輸入的所有內容都會與 AI 供應商共享。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，你在 Composer 中输入的所有内容都会与 AI 提供者共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，在編寫器中輸入的所有內容都會與 AI 供應商共享。"
          }
        }
      }
    },
