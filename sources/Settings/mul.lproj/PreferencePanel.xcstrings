    "qis-Bi-1PH.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Select a profile on the left to access its settings.\"; ObjectID = \"qis-Bi-1PH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte vlevo profil, aby se zobrazilo jeho nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en profil til venstre for at se dens indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
