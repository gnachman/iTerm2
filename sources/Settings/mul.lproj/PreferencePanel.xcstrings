    "4570.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Smart window placement puts new windows where the most free space is available.\"; ObjectID = \"4570\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die intelligente Fensterplatzierung platziert neue Fenster dort, wo der meiste freie Platz verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Smart window placement puts new windows where the most free space is available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートウインドウ配置は、最も空きスペースがある場所に新しいウインドウを配置します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O posicionamento inteligente de janelas coloca as novas janelas onde há mais espaço livre disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умное размещение окон помещает новые окна там, где больше всего свободного места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能窗口放置会将新窗口放在可用空间最多的地方。"
          }
        }
      }
    },
