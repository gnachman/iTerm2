    "tXe-jL-3Kg.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"…even to views like Search or Composer\"; ObjectID = \"tXe-jL-3Kg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…i v zobrazeních, jako je Hledání nebo Editor příkazů"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…også i visninger som Søg eller Kommandoeditor"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…auch zu Ansichten wie Suche oder Composer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "…even to views like Search or Composer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…incluso en vistas como Buscar o Compositor"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…myös näkymissä kuten Haku tai Komentoeditori"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…même pour les vues comme Recherche ou Compositeur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…anche in viste come Cerca o Compositore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…検索やコンポーザーなどのビューにも"
          }
        },
        "ko" : {
          "stringUnit" : {
