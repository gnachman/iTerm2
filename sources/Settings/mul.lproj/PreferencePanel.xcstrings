    "Dt4-v9-hNo.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session.\"; ObjectID = \"Dt4-v9-hNo\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrabene Sitzungen erscheinen unter Sitzung > Vergrabene Sitzungen. Wenn diese Einstellung aktiviert ist, werden Fenstergrößen beim Verbinden mit einer bestehenden tmux-Sitzung wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示セッションは「セッション」>「非表示セッション」に表示されます。この設定を有効にすると、既存のtmuxセッションへアタッチする際にウィンドウサイズが復元されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões ocultas aparecem em Sessão > Sessões ocultas. Quando este ajuste está ativado, os tamanhos das janelas são restaurados ao anexar a uma sessão tmux existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похороненные сессии отображаются в меню «Сессия» > «Похороненные сессии». Когда эта настройка включена, размеры окон восстанавливаются при подключении к существующей сессии tmux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的会话显示在“会话 > 隐藏的会话”下。启用此设置后，附加到现有 tmux 会话时会恢复窗口大小。"
          }
        }
      }
    },
