          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विंडो शीर्षक बार में एक आइकॉन सक्षम करता है जो वर्तमान वर्किंग डाइरेक्टरी दर्शाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje ikonu u traci naslova prozora koja predstavlja trenutni radni direktorij."
          }
