    "X0w-pC-g9j.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Enables the specified color for bold text. Also has the side-effect of using the bright version of ANSI colors for bold text in a ”normal“ ANSI color.\"; ObjectID = \"X0w-pC-g9j\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert die angegebene Farbe für fett formatierten Text. Hat außerdem den Nebeneffekt, dass für fett formatierten Text in einer „normalen“ ANSI-Farbe die helle Version der ANSI-Farben verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enables the specified color for bold text. Also has the side-effect of using the bright version of ANSI colors for bold text in a ”normal“ ANSI color."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太字テキストに指定した色を有効にします。また、太字テキストが「通常」のANSI色である場合に、ANSI色の明るいバージョンを使用するという副作用もあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa a cor especificada para texto em negrito. Também tem o efeito colateral de usar a versão brilhante das cores ANSI para texto em negrito em uma cor ANSI “normal”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает указанный цвет для жирного текста. Также побочным эффектом является использование яркой версии цветов ANSI для жирного текста, использующего «обычный» цвет ANSI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为粗体文本启用指定颜色。还有一个副作用：在“标准”ANSI 颜色中使用亮色版 ANSI 颜色显示粗体文本。"
          }
        }
      }
    },
