    "5zv-42-e9U.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode).\"; ObjectID = \"5zv-42-e9U\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, els moviments grans del cursor s’animen per ajudar a seguir-lo amb la vista. Només s’activen en aplicacions interactives (és a dir, en mode de pantalla alternativa)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, velké pohyby kurzoru se animují, aby oko snáze kurzor sledovalo. Zapnuty jsou jen v interaktivních aplikacích (tj. v režimu alternativní obrazovky)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, får store markørbevægelser en animation, så øjet kan følge markøren. De er kun slået til i interaktive programmer (dvs. i alternativ skærmtilstand)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden große Cursorbewegungen animiert, damit Ihr Auge dem Cursor leichter folgen kann. Dies ist nur in interaktiven Anwendungen aktiviert (d. h. im Alternate-Screen-Modus)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, οι μεγάλες μετακινήσεις του δρομέα εμφανίζονται με κίνηση που βοηθά το μάτι να τον ακολουθήσει. Ενεργοποιούνται μόνο σε διαδραστικές εφαρμογές (δηλαδή σε λειτουργία εναλλακτικής οθόνης)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos grandes del cursor se animan para ayudar a seguirlo con la vista. Solo se activan en aplicaciones interactivas (es decir, en modo de pantalla alternativa)."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos grandes del cursor se animan para ayudar a seguirlo con la vista. Sólo se activan en aplicaciones interactivas (es decir, en modo de pantalla alternativa)."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos grandes del cursor se animan para ayudar a seguirlo con la vista. Sólo se activan en aplicaciones interactivas (es decir, en modo de pantalla alternativa)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, suuret kohdistimen liikkeet animoidaan, jotta kohdistimen seuraaminen silmällä on helpompaa. Ne ovat käytössä vain interaktiivisissa sovelluksissa (eli vaihtoehtoisen näytön tilassa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les grands déplacements du curseur sont animés pour aider l’œil à le suivre. Ils ne sont activés que dans les applications interactives (c’est-à-dire en mode écran alternatif)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les grands déplacements du curseur sont animés pour aider l’œil à le suivre. Ils ne sont activés que dans les applications interactives (c’est-à-dire en mode écran alternatif)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर कर्सर की बड़ी गतिविधियों में एनिमेशन दिखता है, ताकि आपकी नज़र कर्सर का पीछा कर सके। ये केवल इंटरैक्टिव ऐप्लिकेशन में (यानी वैकल्पिक स्क्रीन मोड में) सक्षम होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je omogućeno, veliki pomaci kursora dobivaju animaciju koja pomaže oku da prati kursor. Omogućeni su samo u interaktivnim aplikacijama (tj. u modu alternativnog zaslona)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a nagy kurzormozgások animációt kapnak, hogy a szem könnyebben követhesse a kurzort. Csak interaktív alkalmazásokban (azaz alternatív képernyő módban) működnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, perpindahan kursor yang besar diberi animasi agar mata mudah mengikuti kursor. Ini hanya aktif di aplikasi interaktif (yaitu, dalam mode layar alternatif)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, i grandi spostamenti del cursore vengono animati per aiutare l’occhio a seguirlo. Sono attivi solo nelle app interattive (cioè in modalità schermo alternativo)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、大きなカーソル移動に目で追いやすくするアニメーションが付きます。これはインタラクティブなアプリケーション（つまり代替画面モード）でのみ有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 커서가 크게 이동할 때 애니메이션이 적용되어 커서를 눈으로 쉽게 따라갈 수 있습니다. 대화형 앱(즉, 대체 화면 모드)에서만 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, pergerakan kursor yang besar mendapat animasi untuk membantu mata anda mengikuti kursor. Ia hanya didayakan dalam aplikasi interaktif (iaitu, dalam mod skrin alternatif)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, får store markørbevegelser en animasjon som hjelper øyet å følge markøren. De er bare aktivert i interaktive apper (dvs. i alternativ skjermmodus)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, krijgen grote cursorbewegingen een animatie, zodat je de cursor makkelijker met je ogen volgt. Dit geldt alleen in interactieve apps (dus in de modus voor het alternatieve scherm)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, duże ruchy kursora są animowane, aby oko łatwiej za nim podążało. Działa tylko w aplikacjach interaktywnych (tj. w trybie ekranu alternatywnego)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar seu olhar a acompanhar o cursor. Eles são ativados apenas em aplicativos interativos (ou seja, no modo de tela alternativa)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar o olhar a acompanhar o cursor. São ativados apenas em aplicações interativas (ou seja, no modo de ecrã alternativo)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, mișcările mari ale cursorului sunt animate pentru a ajuta ochiul să urmărească cursorul. Sunt activate doar în aplicațiile interactive (adică în modul ecran alternativ)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, большие перемещения курсора сопровождаются анимацией, помогающей взгляду следить за курсором. Это работает только в интерактивных приложениях (то есть в режиме альтернативного экрана)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, veľké pohyby kurzora sa animujú, aby ich oko ľahšie sledovalo. Zapnuté sú iba v interaktívnych aplikáciách (t. j. v režime alternatívnej obrazovky)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, se veliki premiki kazalca animirajo, da oko lažje sledi kazalcu. Omogočeni so samo v interaktivnih aplikacijah (to je v načinu nadomestnega zaslona)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på animeras stora markörrörelser så att ögat lättare följer markören. De är bara aktiva i interaktiva program (dvs. i alternativt skärmläge)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ การเคลื่อนเคอร์เซอร์ไกลๆ จะมีภาพเคลื่อนไหวเพื่อช่วยให้สายตาตามเคอร์เซอร์ได้ โดยจะทำงานเฉพาะในแอปแบบโต้ตอบ (คือในโหมดหน้าจอสำรอง)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, büyük imleç hareketleri gözünüzün imleci izlemesine yardımcı olmak için animasyonla gösterilir. Yalnızca etkileşimli uygulamalarda (yani alternatif ekran modunda) etkindir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, великі переміщення курсора анімуються, щоб оку було легше стежити за курсором. Це працює лише в інтерактивних програмах (тобто в режимі альтернативного екрана)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các chuyển động lớn của con trỏ có hiệu ứng để giúp mắt bạn theo dõi con trỏ. Chúng chỉ được bật trong ứng dụng tương tác (tức là ở chế độ màn hình thay thế)."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，光标大幅移动时会显示动画，帮助你的视线跟随光标。仅在交互式App中启用（即处于备用屏幕模式时）。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，大幅度的游標移動會帶有動畫，幫助視線跟隨游標。僅在互動式 App 中啟用（即替代螢幕模式）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，大幅光标移动会带有动画，帮助你的视线跟随光标。它们仅在交互式应用中启用（即备用屏幕模式）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，大幅度的游標移動會帶有動畫，幫助視線跟隨游標。僅在互動式 App 中啟用（即替代螢幕模式）。"
          }
        }
      }
    },
