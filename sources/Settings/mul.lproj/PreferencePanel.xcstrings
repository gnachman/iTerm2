    "3cq-GS-KuB.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This setting also enables ligature support in the GPU renderer.\"; ObjectID = \"3cq-GS-KuB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavení také zapíná podporu ligatur ve vykreslovacím modulu GPU."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling slår også understøttelse af ligaturer til i GPU-gengivelsesmotoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung aktiviert auch die Ligatur-Unterstützung im GPU-Renderer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting also enables ligature support in the GPU renderer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ajuste también activa la compatibilidad con ligaduras en el renderizador de GPU."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä asetus ottaa ligatuurituen käyttöön myös GPU-renderöijässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce réglage active aussi la prise en charge des ligatures dans le moteur de rendu GPU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa impostazione abilita anche il supporto delle legature nel motore di rendering GPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定は、GPUレンダラーでの合字サポートも有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 GPU 렌더러에서의 합자 지원도 켭니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne innstillingen aktiverer også ligaturstøtte i GPU-gjengiveren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze instelling schakelt ook ondersteuning voor ligaturen in de GPU-weergavemodule in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustawienie włącza też obsługę ligatur w mechanizmie renderowania GPU."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ajuste também ativa o suporte a ligaduras no renderizador GPU."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот параметр также включает поддержку лигатур в GPU-рендерере."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavenie zapína podporu ligatúr aj vo vykresľovacom module GPU."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta nastavitev omogoči tudi podporo za ligature v upodabljalniku GPU."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här inställningen aktiverar också stöd för ligaturer i GPU-renderaren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayar, GPU işleyicide bitişik harf desteğini de etkinleştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt này cũng bật hỗ trợ chữ ghép trong trình kết xuất GPU."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置还会在 GPU 渲染器中启用连字支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定也會在 GPU 繪製器中啟用連字支援。"
          }
        }
      }
    },
