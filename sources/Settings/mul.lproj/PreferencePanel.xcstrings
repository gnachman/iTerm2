    "GVg-ue-xgc.ibShadowedToolTip" : {
      "comment" : "Class = \"NSView\"; ibShadowedToolTip = \"This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center.\"; ObjectID = \"GVg-ue-xgc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta visualització mostra el to i la cromaticitat dels colors ANSI, excloent-hi el negre i el blanc. El to ve donat per l’angle i la cromaticitat per la distància al centre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato vizualizace zobrazuje odstín a sytost barev ANSI kromě černé a bílé. Odstín udává úhel a sytost vzdálenost od středu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne visualisering viser farvetone og kromaticitet for ANSI-farverne, undtagen sort og hvid. Farvetonen angives af vinklen og kromaticiteten af afstanden fra midten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Visualisierung zeigt den Farbton und die Sättigung der ANSI-Farben, ohne Schwarz und Weiß. Der Farbton wird durch den Winkel und die Sättigung durch den Abstand vom Zentrum angegeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η απεικόνιση δείχνει την απόχρωση και τη χρωματικότητα των χρωμάτων ANSI, εξαιρουμένων του μαύρου και του λευκού. Η απόχρωση δίνεται από τη γωνία και η χρωματικότητα από την απόσταση από το κέντρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This visualisation shows the hue and chroma of the ANSI colours, excluding black and white. Hue is given by the angle and Chroma by the distance from centre."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This visualization shows the hue and chroma of the ANSI colours, excluding black and white. Hue is given by the angle and Chroma by the distance from centre."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This visualisation shows the hue and chroma of the ANSI colours, excluding black and white. Hue is given by the angle and Chroma by the distance from centre."
          }
