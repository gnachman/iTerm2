    "U4H-3c-nZg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Some programs (such as vim and emacs) want to put the numeric keypad in \\\"application\\\" mode. Turn this off if you always want it to act as a numeric keypad.\"; ObjectID = \"U4H-3c-nZg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns programes (com vim i emacs) volen posar el teclat numèric en mode “aplicació”. Desactiva-ho si vols que sempre actuï com a teclat numèric."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé programy (například vim a emacs) chtějí přepnout numerickou klávesnici do režimu „aplikace“. Vypněte to, pokud chcete, aby vždy fungovala jako numerická klávesnice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle programmer (f.eks. vim og emacs) vil sætte det numeriske tastatur i “program”-tilstand. Slå dette fra, hvis det altid skal fungere som et numerisk tastatur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Programme (wie vim und emacs) möchten den Nummernblock in den „Anwendungsmodus“ versetzen. Schalten Sie dies aus, wenn er sich immer wie ein normaler Nummernblock verhalten soll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένα προγράμματα (όπως το vim και το emacs) θέλουν να θέσουν το αριθμητικό πληκτρολόγιο σε λειτουργία «εφαρμογής». Απενεργοποιήστε το αν θέλετε να λειτουργεί πάντα ως αριθμητικό πληκτρολόγιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos programas (como vim y emacs) quieren poner el teclado numérico en modo “aplicación”. Desactívalo si quieres que siempre actúe como teclado numérico."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos programas (como vim y emacs) quieren poner el teclado numérico en modo “aplicación”. Desactívalo si quieres que siempre actúe como teclado numérico."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos programas (como vim y emacs) quieren poner el teclado numérico en modo “aplicación”. Desactívalo si quieres que siempre actúe como teclado numérico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin ohjelmat (kuten vim ja emacs) haluavat asettaa numeronäppäimistön ”sovellus”-tilaan. Poista tämä käytöstä, jos haluat sen toimivan aina numeronäppäimistönä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains programmes (comme vim et emacs) veulent placer le pavé numérique en mode « application ». Désactivez cette option si vous voulez qu’il agisse toujours comme un pavé numérique."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains programmes (comme vim et emacs) veulent placer le pavé numérique en mode « application ». Désactivez cette option si vous voulez qu’il agisse toujours comme un pavé numérique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ प्रोग्राम (जैसे vim और emacs) न्यूमेरिक कीपैड को “ऐप्लिकेशन” मोड में रखना चाहते हैं। यदि आप चाहते हैं कि वह हमेशा न्यूमेरिक कीपैड की तरह काम करे, तो इसे बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neki programi (poput vima i emacsa) žele postaviti numeričku tipkovnicu u mod “aplikacije”. Isključite ovo ako želite da uvijek radi kao numerička tipkovnica."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyes programok (például a vim és az emacs) „alkalmazás” módba akarják állítani a numerikus billentyűzetet. Kapcsolja ki, ha azt szeretné, hogy mindig numerikus billentyűzetként viselkedjen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa program (seperti vim dan emacs) ingin menempatkan tombol angka dalam mode “aplikasi”. Matikan ini jika Anda ingin tombol tersebut selalu berfungsi sebagai tombol angka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni programmi (come vim ed emacs) vogliono mettere il tastierino numerico in modalità “applicazione”. Disattivalo se vuoi che agisca sempre come tastierino numerico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vimやemacsなどの一部のプログラムは、テンキーを「アプリケーション」モードにしようとします。常にテンキーとして動作させたい場合はこれをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 프로그램(vim, emacs 등)은 숫자 키패드를 \"애플리케이션\" 모드로 전환하려고 합니다. 항상 숫자 키패드로 동작하게 하려면 이 옵션을 끄십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesetengah program (seperti vim dan emacs) mahu meletakkan pad kekunci angka dalam mod “aplikasi”. Matikan ini jika anda mahu ia sentiasa bertindak sebagai pad kekunci angka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen programmer (som vim og emacs) vil sette det numeriske tastaturet i «applikasjonsmodus». Slå dette av hvis du alltid vil at det skal fungere som numerisk tastatur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige programma’s (zoals vim en emacs) willen het numerieke toetsenblok in de ‘applicatiemodus’ zetten. Schakel dit uit als je wilt dat het altijd als numeriek toetsenblok werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre programy (takie jak vim i emacs) chcą przełączyć klawiaturę numeryczną w tryb „aplikacji”. Wyłącz tę opcję, jeśli klawiatura ma zawsze działać jako numeryczna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns programas (como vim e emacs) querem colocar o teclado numérico no modo “aplicativo”. Desative isto se você quiser que ele sempre funcione como um teclado numérico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns programas (como vim e emacs) querem colocar o teclado numérico no modo “aplicação”. Desative isto se quiser que funcione sempre como teclado numérico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unele programe (precum vim și emacs) vor să treacă tastatura numerică în modul „aplicație”. Dezactivați aceasta dacă doriți ca ea să acționeze mereu ca tastatură numerică."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые программы (например, vim и emacs) переводят цифровую клавиатуру в режим «приложения». Отключите этот параметр, если хотите, чтобы она всегда работала как обычная цифровая клавиатура."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré programy (napríklad vim a emacs) chcú prepnúť numerickú klávesnicu do režimu „aplikácia“. Vypnite, ak chcete, aby vždy fungovala ako numerická klávesnica."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekateri programi (kot sta vim in emacs) želijo številsko tipkovnico preklopiti v »aplikacijski« način. To izklopite, če želite, da vedno deluje kot številska tipkovnica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa program (som vim och emacs) vill sätta det numeriska tangentbordet i programläge (”application”). Stäng av detta om du alltid vill att det ska fungera som ett numeriskt tangentbord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บางโปรแกรม (เช่น vim และ emacs) ต้องการให้ปุ่มตัวเลขอยู่ในโหมด “แอปพลิเคชัน” ปิดตัวเลือกนี้หากคุณต้องการให้ทำงานเป็นปุ่มตัวเลขเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı programlar (vim ve emacs gibi) sayısal tuş takımını “uygulama” moduna almak ister. Her zaman sayısal tuş takımı gibi davranmasını istiyorsanız bunu kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі програми (як-от vim і emacs) хочуть перевести цифрову клавіатуру в режим «програми». Вимкніть це, якщо хочете, щоб вона завжди працювала як цифрова клавіатура."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số chương trình (như vim và emacs) muốn đặt bàn phím số ở chế độ “ứng dụng”. Hãy tắt tùy chọn này nếu bạn luôn muốn nó hoạt động như bàn phím số."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些程序（如vim和emacs）会要求将数字小键盘置于“应用程序”模式。如果你希望它始终作为数字小键盘使用，请关闭此选项。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些程式（例如 vim 與 emacs）會要求將數字小鍵盤切換為「應用程式」模式。如希望它一律作為數字小鍵盤，請關閉此選項。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些程序（如 vim 和 emacs）希望将数字小键盘置于“应用”模式。如果你希望它始终作为数字小键盘使用，请关闭此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些程式（例如 vim 與 emacs）會要求將數字小鍵盤切換為「應用程式」模式。若希望它一律作為數字小鍵盤，請關閉此選項。"
          }
        }
      }
    },
    "U5a-PY-hD8.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used.\"; ObjectID = \"U5a-PY-hD8\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, els indicadors de marca utilitzen els colors ANSI vermell, groc i blau. Si no, s’utilitzen els colors per omissió fixats al codi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, indikátory značek používají barvy ANSI červenou, žlutou a modrou. Jinak se použijí pevně dané výchozí barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, bruger mærkeindikatorer ANSI-farverne rød, gul og blå. Ellers bruges de fastkodede standardfarver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden die ANSI-Farben Rot, Gelb und Blau für Markierungsindikatoren verwendet. Andernfalls werden die fest codierten Standardfarben verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, οι ενδείξεις σημαδιών χρησιμοποιούν τα χρώματα ANSI κόκκινο, κίτρινο και μπλε. Διαφορετικά, χρησιμοποιούνται τα προεπιλεγμένα χρώματα που είναι ενσωματωμένα στον κώδικα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, ANSI red, yellow, and blue colours are used by mark indicators. Otherwise, the hardcoded default colours are used."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, ANSI red, yellow, and blue colours are used by mark indicators. Otherwise, the hardcoded default colours are used."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, ANSI red, yellow, and blue colours are used by mark indicators. Otherwise, the hardcoded default colours are used."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, ANSI red, yellow, and blue colours are used by mark indicators. Otherwise, the hardcoded default colours are used."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los indicadores de marca usan los colores ANSI rojo, amarillo y azul. Si no, se usan los colores predeterminados fijos en el código."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los indicadores de marca usan los colores ANSI rojo, amarillo y azul. Si no, se usan los colores predeterminados fijos en el código."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los indicadores de marca usan los colores ANSI rojo, amarillo y azul. Si no, se usan los colores predeterminados fijos en el código."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, merkkien ilmaisimet käyttävät ANSI-värejä punainen, keltainen ja sininen. Muuten käytetään kiinteitä oletusvärejä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les indicateurs de marque utilisent les couleurs ANSI rouge, jaune et bleu. Sinon, les couleurs par défaut codées en dur sont utilisées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les indicateurs de marque utilisent les couleurs ANSI rouge, jaune et bleu. Sinon, les couleurs par défaut codées en dur sont utilisées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, मार्क संकेतक ANSI लाल, पीले और नीले रंग का उपयोग करते हैं। अन्यथा कोड में तय किए गए डिफ़ॉल्ट रंग उपयोग होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je omogućeno, pokazatelji oznaka koriste ANSI crvenu, žutu i plavu boju. Inače se koriste ugrađene standardne boje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a jelölőindikátorok az ANSI piros, sárga és kék színt használják. Ellenkező esetben a beépített alapértelmezett színeket használják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, warna ANSI merah, kuning, dan biru digunakan oleh indikator tanda. Jika tidak, warna default yang tertanam dalam kode yang digunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, gli indicatori dei contrassegni usano i colori ANSI rosso, giallo e blu. Altrimenti vengono usati i colori predefiniti fissi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、マークインジケータにANSIの赤、黄、青の色が使用されます。無効の場合は、ハードコードされたデフォルトの色が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 마크 표시기에 ANSI 빨간색, 노란색, 파란색이 사용됩니다. 그렇지 않으면 하드코딩된 기본 색상이 사용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, warna ANSI merah, kuning dan biru digunakan oleh penunjuk tanda. Jika tidak, warna lalai yang dikodkan keras digunakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, brukes ANSI-fargene rød, gul og blå av merkeindikatorene. Ellers brukes de faste standardfargene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, gebruiken markeringsindicatoren de ANSI-kleuren rood, geel en blauw. Anders worden de vaste standaardkleuren gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, wskaźniki znaczników używają kolorów ANSI: czerwonego, żółtego i niebieskiego. W przeciwnym razie używane są domyślne kolory wpisane na stałe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os indicadores de marca usam as cores ANSI vermelho, amarelo e azul. Caso contrário, são usadas as cores padrão fixas no código."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os indicadores de marca usam as cores ANSI vermelho, amarelo e azul. Caso contrário, são usadas as cores predefinidas fixas no código."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activat, indicatoarele de marcaje folosesc culorile ANSI roșu, galben și albastru. Altfel, se folosesc culorile implicite fixe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, для индикаторов меток используются красный, жёлтый и синий цвета ANSI. В противном случае используются встроенные цвета по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, indikátory značiek používajú farby ANSI červenú, žltú a modrú. Inak sa použijú pevne zadané predvolené farby."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, označevalniki označb uporabljajo barve ANSI rdečo, rumeno in modro. Sicer se uporabijo trdo kodirane privzete barve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på använder märkesindikatorerna ANSI-färgerna rött, gult och blått. Annars används de hårdkodade förvalda färgerna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ ตัวบ่งชี้เครื่องหมายจะใช้สี ANSI แดง เหลือง และน้ำเงิน มิฉะนั้นจะใช้สีเริ่มต้นที่กำหนดตายตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde işaret göstergeleri ANSI kırmızı, sarı ve mavi renkleri kullanır. Aksi halde koda gömülü varsayılan renkler kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, індикатори позначок використовують кольори ANSI: червоний, жовтий і синій. Інакше використовуються жорстко задані типові кольори."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các chỉ báo dấu dùng màu ANSI đỏ, vàng và xanh lam. Nếu không, sẽ dùng các màu mặc định được mã hóa cứng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，标记指示器使用ANSI红色、黄色和蓝色。否则使用硬编码的默认颜色。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，標記指示器會使用 ANSI 紅色、黃色與藍色。否則使用寫死的預設顏色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，标记指示器使用 ANSI 红色、黄色和蓝色。否则使用硬编码的默认颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，標記指示器會使用 ANSI 紅色、黃色與藍色。否則使用寫死的預設顏色。"
          }
        }
      }
    },
