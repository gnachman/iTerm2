    "JXG-G1-APa.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, large cursor movements get an animation to help your eye follow the cursor.\"; ObjectID = \"JXG-G1-APa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, els moviments grans del cursor s’animen per ajudar a seguir-lo amb la vista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, velké pohyby kurzoru se animují, aby oko snáze kurzor sledovalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, får store markørbevægelser en animation, så øjet kan følge markøren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, erhalten große Cursor-Bewegungen eine Animation, die dem Auge hilft, dem Cursor zu folgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, οι μεγάλες μετακινήσεις του δρομέα εμφανίζονται με κίνηση που βοηθά το μάτι να τον ακολουθήσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos grandes del cursor se animan para ayudar a seguirlo con la vista."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos grandes del cursor se animan para ayudar a seguirlo con la vista."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos grandes del cursor se animan para ayudar a seguirlo con la vista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, suuret kohdistimen liikkeet animoidaan, jotta kohdistimen seuraaminen silmällä on helpompaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les grands déplacements du curseur sont animés pour aider l’œil à le suivre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les grands déplacements du curseur sont animés pour aider l’œil à le suivre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर कर्सर की बड़ी गतिविधियों में एनिमेशन दिखता है, ताकि आपकी नज़र कर्सर का पीछा कर सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je omogućeno, veliki pomaci kursora dobivaju animaciju koja pomaže oku da prati kursor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a nagy kurzormozgások animációt kapnak, hogy a szem könnyebben követhesse a kurzort."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, perpindahan kursor yang besar diberi animasi agar mata mudah mengikuti kursor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, i grandi spostamenti del cursore vengono animati per aiutare l’occhio a seguirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、カーソルの大きな移動にアニメーションが付き、目でカーソルを追いやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 커서가 크게 이동할 때 애니메이션이 적용되어 커서를 눈으로 쉽게 따라갈 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, pergerakan kursor yang besar mendapat animasi untuk membantu mata anda mengikuti kursor."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, får store markørbevegelser en animasjon som hjelper øyet å følge markøren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, krijgen grote cursorbewegingen een animatie, zodat je de cursor makkelijker met je ogen volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, duże ruchy kursora są animowane, aby oko łatwiej za nim podążało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar o seu olho a acompanhar o cursor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar o olhar a acompanhar o cursor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, mișcările mari ale cursorului sunt animate pentru a ajuta ochiul să urmărească cursorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, крупные перемещения курсора сопровождаются анимацией, помогающей взгляду следовать за курсором."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, veľké pohyby kurzora sa animujú, aby ich oko ľahšie sledovalo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, se veliki premiki kazalca animirajo, da oko lažje sledi kazalcu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på animeras stora markörrörelser så att ögat lättare följer markören."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ การเคลื่อนเคอร์เซอร์ไกลๆ จะมีภาพเคลื่อนไหวเพื่อช่วยให้สายตาตามเคอร์เซอร์ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, büyük imleç hareketleri gözünüzün imleci izlemesine yardımcı olmak için animasyonla gösterilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, великі переміщення курсора анімуються, щоб оку було легше стежити за курсором."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các chuyển động lớn của con trỏ có hiệu ứng để giúp mắt bạn theo dõi con trỏ."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，光标大幅移动时会显示动画，帮助你的视线跟随光标。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，大幅度的游標移動會帶有動畫，幫助視線跟隨游標。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，大幅光标移动会带有动画，帮助你的视线跟随光标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，大幅度的游標移動會帶有動畫，幫助視線跟隨游標。"
          }
        }
      }
    },
