    "IPS-cD-eC7.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Enable “zero data retention” (send whole conversation every time)\"; ObjectID = \"IPS-cD-eC7\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnout „nulovou retenci dat“ (pokaždé odeslat celou konverzaci)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå “nul dataopbevaring” til (send hele samtalen hver gang)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Keine Datenspeicherung“ aktivieren (gesamte Unterhaltung jedes Mal senden)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable “zero data retention” (send whole conversation every time)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar “retención cero de datos” (enviar toda la conversación cada vez)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön ”nolla datan säilytys” (lähetä koko keskustelu joka kerta)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer la « rétention zéro des données » (envoyer toute la conversation à chaque fois)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita “zero data retention” (invia ogni volta l’intera conversazione)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ゼロデータ保持」を有効にする(毎回会話全体を送信)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“제로 데이터 보존” 켜기(매번 전체 대화 보내기)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver «null datalagring» (send hele samtalen hver gang)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel ‘zero data retention’ in (verstuur elke keer het hele gesprek)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz „zerowe przechowywanie danych” (za każdym razem wysyłaj całą rozmowę)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar “retenção zero de dados” (enviar toda a conversa a cada vez)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить «нулевое хранение данных» (отправлять весь разговор каждый раз)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnúť „nulové uchovávanie dát“ (zakaždým odoslať celú konverzáciu)"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči »ničelno hrambo podatkov« (vsakič pošlji celoten pogovor)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera ”noll datalagring” (skicka hela konversationen varje gång)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sıfır veri saklama” özelliğini etkinleştir (her seferinde tüm konuşmayı gönder)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật “không lưu giữ dữ liệu” (gửi toàn bộ cuộc trò chuyện mỗi lần)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用“零数据保留” （每次发送整个对话）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用「零資料保留」（每次傳送整個對話）"
          }
        }
      }
    },
