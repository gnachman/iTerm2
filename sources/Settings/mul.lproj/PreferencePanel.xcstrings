          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al portapapeles mediante un código de escape supone un riesgo de seguridad si se ejecutan aplicaciones no confiables."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al portapapeles mediante un código de escape supone un riesgo de seguridad si se ejecutan aplicaciones no confiables."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al portapapeles mediante un código de escape supone un riesgo de seguridad si se ejecutan aplicaciones no confiables."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leikepöydän käyttö escape-koodilla on tietoturvariski, jos suoritat epäluotettavia sovelluksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au presse-papiers par séquence d’échappement présente un risque de sécurité si vous exécutez des applications non fiables."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au presse-papiers par séquence d’échappement présente un risque de sécurité si vous exécutez des applications non fiables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अविश्वसनीय ऐप्लिकेशन चलाने पर एस्केप कोड के ज़रिए क्लिपबोर्ड ऐक्सेस सुरक्षा जोखिम पैदा करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup memorijskom pretincu putem escape koda predstavlja sigurnosni rizik ako se pokreću nepouzdane aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vágólaphoz escape-kódon keresztül való hozzáférés biztonsági kockázatot jelent, ha nem megbízható alkalmazásokat futtat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses papan klip melalui kode escape menimbulkan risiko keamanan jika menjalankan aplikasi yang tidak tepercaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso agli Appunti tramite un codice di escape rappresenta un rischio per la sicurezza se esegui app non attendibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エスケープコード経由のクリップボードアクセスは、信頼できないアプリケーションを実行している場合セキュリティ上のリスクとなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 없는 앱을 실행하는 경우 이스케이프 코드를 통한 클립보드 접근은 보안 위험이 될 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses papan klip melalui kod escape menimbulkan risiko keselamatan jika menjalankan aplikasi yang tidak dipercayai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til utklippstavlen via en escape-kode utgjør en sikkerhetsrisiko hvis du kjører apper du ikke stoler på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot het klembord via een escapereeks is een beveiligingsrisico als je onbetrouwbare apps uitvoert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do schowka przez kod ucieczki stanowi zagrożenie dla bezpieczeństwa, jeśli uruchamiasz niezaufane aplikacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à área de transferência por um código de escape representa um risco de segurança ao executar aplicativos não confiáveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao clipboard por um código de escape representa um risco de segurança ao executar aplicações não fiáveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la clipboard printr-un cod escape reprezintă un risc de securitate dacă rulați aplicații nesigure."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к буферу обмена через escape-код представляет угрозу безопасности при запуске недоверенных приложений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup k schránke cez escape kód predstavuje bezpečnostné riziko pri spúšťaní nedôveryhodných aplikácií."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop do odložišča prek ubežne kode pomeni varnostno tveganje pri izvajanju nezaupanja vrednih aplikacij."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till urklipp via en escapekod innebär en säkerhetsrisk om du kör program som du inte litar på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเข้าถึงคลิปบอร์ดผ่านรหัส escape เป็นความเสี่ยงด้านความปลอดภัยหากเรียกใช้แอปที่ไม่น่าเชื่อถือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaçış kodu üzerinden pano erişimi, güvenilmeyen uygulamalar çalıştırılıyorsa güvenlik riski oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до буфера обміну через escape-код становить ризик для безпеки, якщо запускаються ненадійні програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truy cập bảng nhớ tạm qua mã thoát gây rủi ro bảo mật nếu chạy các ứng dụng không tin cậy."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果运行不受信任的App，通过转义码访问剪贴板会带来安全风险。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如執行不受信任的 App，透過跳脫碼存取剪貼簿會有安全風險。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果运行不受信任的应用，通过转义码访问剪贴板会带来安全风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
