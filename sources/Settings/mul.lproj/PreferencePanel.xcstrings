    "b5z-Sg-ADk.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Always open at least one terminal window at startup\"; ObjectID = \"b5z-Sg-ADk\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při spuštění vždy otevřít alespoň jedno okno terminálu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn altid mindst ét terminalvindue ved start"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Start immer mindestens ein Terminalfenster öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Always open at least one terminal window at startup"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir siempre al menos una ventana de terminal al iniciar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa käynnistyksessä aina vähintään yksi päätteen ikkuna"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours ouvrir au moins une fenêtre de terminal au démarrage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri sempre almeno una finestra di terminale all’avvio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時に少なくとも1つのターミナルウィンドウを開く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시동 시 항상 하나 이상의 터미널 윈도우 열기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne alltid minst ett terminalvindu ved oppstart"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open bij het opstarten altijd minstens één terminalvenster"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze otwieraj co najmniej jedno okno terminala przy uruchomieniu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre abrir pelo menos uma janela de terminal ao iniciar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда открывать хотя бы одно окно терминала при запуске"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri spustení vždy otvoriť aspoň jedno okno terminálu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob zagonu vedno odpri vsaj eno okno terminala"
