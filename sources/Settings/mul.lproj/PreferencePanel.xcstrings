    "6Pr-69-fM1.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Enables an icon in the window title bar that represents the current working directory.\"; ObjectID = \"6Pr-69-fM1\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí v záhlaví okna ikonu představující aktuální pracovní adresář."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverer et symbol i vinduets titellinje, der repræsenterer den aktuelle arbejdsmappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert ein Symbol in der Fenstertitelleiste, das das aktuelle Arbeitsverzeichnis darstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enables an icon in the window title bar that represents the current working directory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa un icono en la barra de título de la ventana que representa el directorio de trabajo actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää ikkunan otsikkopalkissa kuvakkeen, joka edustaa nykyistä työhakemistoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active dans la barre de titre de la fenêtre une icône représentant le répertoire de travail actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita un’icona nella barra del titolo della finestra che rappresenta la directory di lavoro corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の作業ディレクトリを表すアイコンをウィンドウのタイトルバーに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 작업 디렉토리를 나타내는 아이콘을 윈도우 제목 막대에 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverer et symbol i vindusstittellinjen som representerer gjeldende arbeidsmappe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt een symbool in de titelbalk van het venster in dat de huidige werkmap voorstelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza na pasku tytułu okna ikonę reprezentującą bieżący katalog roboczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa um ícone na barra de título da janela que representa o diretório de trabalho atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает значок в заголовке окна, отображающий текущий рабочий каталог."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapne na lište s názvom okna ikonu predstavujúcu aktuálny pracovný adresár."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogoči ikono v naslovni vrstici okna, ki predstavlja trenutni delovni imenik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverar en symbol i fönstrets titelfält som representerar aktuell arbetskatalog."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencere başlık çubuğunda geçerli çalışma dizinini temsil eden bir simgeyi etkinleştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật một biểu tượng trong thanh tiêu đề cửa sổ đại diện cho thư mục làm việc hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在窗口标题栏中启用表示当前工作目录的图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在視窗標題列中啟用代表目前工作目錄的圖像。"
          }
        }
      }
    },
    "6Qn-Rd-R1m.ibShadowedToolTip" : {
