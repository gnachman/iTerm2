    "aev-dz-zJQ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Use \\\\0 for match, \\\\1…\\\\9 for match groups, \\\\d for directory, \\\\u for user, \\\\h for host.\"; ObjectID = \"aev-dz-zJQ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir \\0 per a la coincidència, \\1…\\9 per als grups de coincidència, \\d per al directori, \\u per a l’usuari i \\h per al host."
