        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer \\n plutôt que \\r pour terminer les commandes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia \\n anziché \\r per terminare i comandi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドを終了するために\\rではなく\\nを送信する"
