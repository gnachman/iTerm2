    "Dt4-v9-hNo.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order.\"; ObjectID = \"Dt4-v9-hNo\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l’àrab, l’hebreu i altres escriptures de dreta a esquerra en el seu ordre visual correcte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí arabštinu, hebrejštinu a další písma psaná zprava doleva ve správném vizuálním pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser arabisk, hebraisk og andre skriftsystemer, der læses fra højre mod venstre, i den rigtige visuelle rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Arabisch, Hebräisch und andere rechtsläufige Schriften in der richtigen visuellen Reihenfolge an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει αραβικά, εβραϊκά και άλλες γραφές από δεξιά προς τα αριστερά στη σωστή οπτική σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el árabe, el hebreo y otras escrituras de derecha a izquierda en su orden visual correcto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el árabe, el hebreo y otras escrituras de derecha a izquierda en su orden visual correcto."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el árabe, el hebreo y otras escrituras de derecha a izquierda en su orden visual correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää arabian, heprean ja muut oikealta vasemmalle kirjoitettavat kirjoitusjärjestelmät oikeassa visuaalisessa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l’arabe, l’hébreu et les autres écritures de droite à gauche dans leur ordre visuel correct."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l’arabe, l’hébreu et les autres écritures de droite à gauche dans leur ordre visuel correct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अरबी, हिब्रू और अन्य दाएँ-से-बाएँ लिपियों को उनके सही दृश्य क्रम में दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikazuje arapsko, hebrejsko i druga pisma s desna na lijevo ispravnim vizualnim redoslijedom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az arab, héber és más jobbról balra író szkripteket a helyes vizuális sorrendben jeleníti meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan skrip Arab, Ibrani, dan skrip kanan-ke-kiri lainnya dalam urutan visual yang benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra arabo, ebraico e altre scritture da destra a sinistra nel corretto ordine visivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラビア語、ヘブライ語など、右から左に書く文字を正しい表示順で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아랍어, 히브리어 등 오른쪽에서 왼쪽으로 쓰는 문자를 올바른 시각적 순서로 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memaparkan tulisan Arab, Ibrani dan tulisan kanan-ke-kiri lain mengikut susunan visual yang betul."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser arabisk, hebraisk og andre høyre-til-venstre-skrifter i riktig visuell rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont Arabische, Hebreeuwse en andere van rechts naar links geschreven talen in de juiste visuele volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla pismo arabskie, hebrajskie i inne pisane od prawej do lewej w poprawnej kolejności wizualnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibe árabe, hebraico e outras escritas da direita para a esquerda na ordem visual correta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apresenta árabe, hebraico e outras escritas da direita para a esquerda na ordem visual correta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează araba, ebraica și alte scripturi de la dreapta la stânga în ordinea vizuală corectă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображает арабский, иврит и другие письменности с направлением справа налево в правильном визуальном порядке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje arabské, hebrejské a ďalšie písma písané sprava doľava v správnom vizuálnom poradí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže arabsko, hebrejsko in druge pisave od desne proti levi v pravilnem vizualnem vrstnem redu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar arabiska, hebreiska och andra skriftspråk som läses från höger till vänster i rätt visuell ordning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงภาษาอาหรับ ฮีบรู และอักษรเขียนจากขวาไปซ้ายอื่นๆ ตามลำดับการมองเห็นที่ถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arapça, İbranice ve diğer sağdan sola yazılan betikleri doğru görsel sırada gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує арабське, єврейське й інше письмо справа наліво в правильному візуальному порядку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị tiếng Ả Rập, tiếng Do Thái và các chữ viết từ phải sang trái khác theo đúng thứ tự hiển thị."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按正确的视觉顺序显示阿拉伯语、希伯来语和其他从右到左书写的文字。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以正確的視覺順序顯示阿拉伯文、希伯來文及其他由右至左書寫的文字。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
