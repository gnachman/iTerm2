        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当所有窗口都是热键窗口时才从 Dock 中排除"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當所有視窗都是全域快速鍵視窗時才從 Dock 中排除"
