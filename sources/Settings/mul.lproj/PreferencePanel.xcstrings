    "JdL-vz-9Vf.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"“Undo” can revive a closed session for up to this many seconds:\"; ObjectID = \"JdL-vz-9Vf\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Odvolat akci“ může obnovit zavřenou relaci nejdéle po tento počet sekund:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Fortryd” kan genoplive en lukket session i op til så mange sekunder:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, in denen „Rückgängig“ eine geschlossene Sitzung wiederherstellen kann:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Deshacer” puede revivir una sesión cerrada durante hasta esta cantidad de segundos:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Peru” voi herättää suljetun istunnon henkiin enintään näin monen sekunnin ajan:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Annuler » peut rétablir une session fermée jusqu’à ce nombre de secondes :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secondi entro cui “Annulla” può riaprire una sessione chiusa:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「元に戻す」で閉じたセッションを復元できる最大秒数："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“실행 취소”로 닫힌 세션을 되살릴 수 있는 최대 시간(초):"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Angre» kan gjenopprette en lukket økt i opptil så mange sekunder:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Herstel’ kan een gesloten sessie tot dit aantal seconden terughalen:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Cofnij” może przywrócić zamkniętą sesję przez maksymalnie tyle sekund:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “Desfazer” pode reviver uma sessão fechada por até este número de segundos:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отмена» может восстановить закрытый сеанс в течение указанного числа секунд:"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Odvolať“ dokáže obnoviť zatvorenú reláciu najviac tento počet sekúnd:"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Razveljavi« lahko obudi zaprto sejo do toliko sekund:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Ångra” kan återuppliva en stängd session i upp till så här många sekunder:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Geri Al” kapatılmış bir oturumu en fazla şu kadar saniye boyunca geri getirebilir:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hoàn tác” có thể hồi sinh một phiên đã đóng trong tối đa số giây này:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“撤销”可恢复已关闭会话的最长秒数："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「還原」可重新開啟已關閉工作階段的最長秒數："
          }
        }
      }
    },
