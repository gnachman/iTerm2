    "KWy-PJ-O0E.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Brightens text for \\\"normal\\\" ANSI colors. Does not affect \\\"bright\\\" ANSI colors, 8-bit colors, 24-bit colors, or the default foreground color.\"; ObjectID = \"KWy-PJ-O0E\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aclareix el text dels colors ANSI “normals”. No afecta els colors ANSI “brillants”, els colors de 8 bits, els de 24 bits ni el color de primer pla per omissió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zesvětluje text u „normálních“ barev ANSI. Netýká se „jasných“ barev ANSI, 8bitových barev, 24bitových barev ani výchozí barvy popředí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør teksten lysere for “normale” ANSI-farver. Påvirker ikke “lyse” ANSI-farver, 8-bit-farver, 24-bit-farver eller standardfarven for forgrund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hellt Text für „normale“ ANSI-Farben auf. Wirkt sich nicht auf „helle“ ANSI-Farben, 8-Bit-Farben, 24-Bit-Farben oder die Standard-Vordergrundfarbe aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φωτίζει το κείμενο για τα «κανονικά» χρώματα ANSI. Δεν επηρεάζει τα «φωτεινά» χρώματα ANSI, τα χρώματα 8 bit, τα χρώματα 24 bit ή το προεπιλεγμένο χρώμα προσκηνίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Brightens text for \"normal\" ANSI colors. Does not affect \"bright\" ANSI colors, 8-bit colors, 24-bit colors, or the default foreground color."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightens text for \"normal\" ANSI colours. Does not affect \"bright\" ANSI colours, 8-bit colours, 24-bit colours, or the default foreground colour."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightens text for \"normal\" ANSI colours. Does not affect \"bright\" ANSI colours, 8-bit colours, 24-bit colours, or the default foreground colour."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightens text for \"normal\" ANSI colours. Does not affect \"bright\" ANSI colours, 8-bit colours, 24-bit colours, or the default foreground colour."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightens text for \"normal\" ANSI colours. Does not affect \"bright\" ANSI colours, 8-bit colours, 24-bit colours, or the default foreground colour."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightens text for \"normal\" ANSI colors. Does not affect \"bright\" ANSI colors, 8-bit colors, 24-bit colors, or the default foreground color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aclara el texto de los colores ANSI “normales”. No afecta a los colores ANSI “brillantes”, a los colores de 8 bits, a los de 24 bits ni al color de primer plano predeterminado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aclara el texto de los colores ANSI “normales”. No afecta a los colores ANSI “brillantes”, a los colores de 8 bits, a los de 24 bits ni al color de primer plano predeterminado."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aclara el texto de los colores ANSI “normales”. No afecta a los colores ANSI “brillantes”, a los colores de 8 bits, a los de 24 bits ni al color de primer plano predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaalentaa ”normaalien” ANSI-värien tekstiä. Ei vaikuta ”kirkkaisiin” ANSI-väreihin, 8-bittisiin väreihin, 24-bittisiin väreihin eikä oletusedustaväriin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éclaircit le texte des couleurs ANSI « normales ». N’affecte pas les couleurs ANSI « vives », les couleurs 8 bits, les couleurs 24 bits ni la couleur de premier plan par défaut."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éclaircit le texte des couleurs ANSI « normales ». N’affecte pas les couleurs ANSI « vives », les couleurs 8 bits, les couleurs 24 bits ni la couleur de premier plan par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“सामान्य” ANSI रंगों के टेक्स्ट को चमकीला बनाता है। “ब्राइट” ANSI रंगों, 8-बिट रंगों, 24-बिट रंगों या डिफ़ॉल्ट फ़ोरग्राउंड रंग पर कोई असर नहीं पड़ता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posvjetljuje tekst “normalnih” ANSI boja. Ne utječe na “svijetle” ANSI boje, 8-bitne boje, 24-bitne boje ni standardnu boju prednjeg plana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kivilágosítja a „normál” ANSI-színek szövegét. Nem érinti a „világos” ANSI-színeket, a 8 bites és a 24 bites színeket, sem az alapértelmezett előtérszínt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencerahkan teks untuk warna ANSI “normal”. Tidak memengaruhi warna ANSI “terang”, warna 8-bit, warna 24-bit, atau warna latar depan default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schiarisce il testo dei colori ANSI “normali”. Non riguarda i colori ANSI “brillanti”, i colori a 8 bit, i colori a 24 bit né il colore di primo piano predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「通常」のANSIカラーのテキストを明るくします。「明るい」ANSIカラー、8ビットカラー、24ビットカラー、デフォルトの前景色には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"일반\" ANSI 색상의 텍스트를 밝게 합니다. \"밝은\" ANSI 색상, 8비트 색상, 24비트 색상 또는 기본 전경 색상에는 영향을 주지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencerahkan teks untuk warna ANSI “biasa”. Tidak menjejaskan warna ANSI “cerah”, warna 8-bit, warna 24-bit atau warna latar depan lalai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør teksten lysere for «normale» ANSI-farger. Påvirker ikke «lyse» ANSI-farger, 8-biters farger, 24-biters farger eller standard forgrunnsfarge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt tekst helderder voor ‘normale’ ANSI-kleuren. Heeft geen invloed op ‘heldere’ ANSI-kleuren, 8-bits kleuren, 24-bits kleuren of de standaard voorgrondkleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozjaśnia tekst w „normalnych” kolorach ANSI. Nie dotyczy „jasnych” kolorów ANSI, kolorów 8-bitowych, kolorów 24-bitowych ani domyślnego koloru pierwszego planu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareia o texto para as cores ANSI “normais”. Não afeta as cores ANSI “brilhantes”, cores de 8 bits, cores de 24 bits ou a cor de primeiro plano padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clareia o texto das cores ANSI “normais”. Não afeta as cores ANSI “brilhantes”, as cores de 8 bits, as cores de 24 bits nem a cor de primeiro plano predefinida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminează textul pentru culorile ANSI „normale”. Nu afectează culorile ANSI „strălucitoare”, culorile pe 8 biți, culorile pe 24 de biți sau culoarea implicită de prim-plan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осветляет текст для «обычных» цветов ANSI. Не влияет на «яркие» цвета ANSI, 8-битные цвета, 24-битные цвета или цвет переднего плана по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjasní text „normálnych“ farieb ANSI. Neovplyvňuje „jasné“ farby ANSI, 8-bitové farby, 24-bitové farby ani predvolenú farbu popredia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posvetli besedilo za »običajne« barve ANSI. Ne vpliva na »svetle« barve ANSI, 8-bitne barve, 24-bitne barve ali privzeto barvo ospredja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör texten ljusare för ”normala” ANSI-färger. Påverkar inte ”ljusa” ANSI-färger, 8-bitarsfärger, 24-bitarsfärger eller förvald förgrundsfärg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ข้อความของสี ANSI “ปกติ” สว่างขึ้น ไม่มีผลกับสี ANSI “สว่าง” สี 8 บิต สี 24 บิต หรือสีพื้นหน้าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Normal” ANSI renkleri için metni parlaklaştırır. “Parlak” ANSI renklerini, 8 bit renkleri, 24 bit renkleri veya varsayılan ön plan rengini etkilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підсвічує текст «звичайних» кольорів ANSI. Не стосується «яскравих» кольорів ANSI, 8-бітних кольорів, 24-бітних кольорів і типового кольору переднього плану."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm sáng văn bản cho các màu ANSI “thường”. Không ảnh hưởng đến các màu ANSI “sáng”, màu 8 bit, màu 24 bit hay màu tiền cảnh mặc định."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高“普通”ANSI颜色的文本亮度。不影响“明亮”ANSI颜色、8位颜色、24位颜色或默认前景色。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提亮「標準」ANSI 顏色的文字。不影響「亮色」ANSI 顏色、8 位元顏色、24 位元顏色或預設前景顏色。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提亮“标准”ANSI 颜色的文本。不影响“亮色”ANSI 颜色、8 位颜色、24 位颜色或默认前景颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提亮「標準」ANSI 顏色的文字。不影響「亮色」ANSI 顏色、8 位元顏色、24 位元顏色或預設前景顏色。"
          }
        }
      }
