    "XaQ-Gu-7BD.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This build is in the nightly build channel. It cannot update to beta or release builds.\"; ObjectID = \"XaQ-Gu-7BD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto sestavení je v kanálu nočních sestavení. Nelze jej aktualizovat na sestavení beta ani vydaná sestavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne build tilhører nightly-kanalen. Den kan ikke opdateres til beta- eller officielle versioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build befindet sich im Nightly-Build-Kanal. Er kann nicht auf Beta- oder Release-Builds aktualisiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This build is in the nightly build channel. It cannot update to beta or release builds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilación está en el canal de compilaciones nightly. No puede actualizarse a compilaciones beta ni finales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä versio kuuluu nightly-versioiden kanavaan. Sitä ei voi päivittää beta- tai julkaisuversioihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version fait partie du canal des versions nightly. Elle ne peut pas être mise à jour vers une version bêta ou finale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa build appartiene al canale delle build notturne. Non può essere aggiornata a build beta o definitive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドはナイトリービルドチャンネルです。ベータ版やリリース版に更新することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드는 나이틀리 빌드 채널에 있습니다. 베타 또는 정식 빌드로 업데이트할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne versjonen er i kanalen for nightly-bygg. Den kan ikke oppdateres til beta- eller utgivelsesbygg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze build zit in het nightly-buildkanaal. Er kan niet worden bijgewerkt naar beta- of definitieve builds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kompilacja pochodzi z kanału kompilacji nightly. Nie można jej uaktualnić do kompilacji beta ani wydań stabilnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este build está no canal de builds nightly. Não é possível atualizar para builds beta ou de lançamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка относится к ночному каналу обновлений. Она не может обновиться до бета- или релизных сборок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto zostava je v kanáli nočných zostáv (nightly). Nemôže sa aktualizovať na beta ani vydané zostavy."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta različica je v kanalu nočnih različic. Ne more se posodobiti na različice beta ali izdane različice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här versionen finns i kanalen för nattliga versioner. Den kan inte uppdateras till beta- eller officiella versioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yapı nightly yapı kanalında. Beta veya sürüm yapılarına güncellenemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản dựng này thuộc kênh bản dựng hằng đêm. Nó không thể cập nhật lên bản beta hoặc bản phát hành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此构建处于 nightly 构建通道，无法更新到 beta 或 release 构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本屬於 nightly 組建頻道，無法更新至 Beta 或正式版組建。"
          }
        }
      }
