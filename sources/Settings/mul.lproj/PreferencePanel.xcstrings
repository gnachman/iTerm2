    "5zv-42-e9U.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode).\"; ObjectID = \"5zv-42-e9U\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden große Cursorbewegungen animiert, damit Ihr Auge dem Cursor leichter folgen kann. Dies ist nur in interaktiven Anwendungen aktiviert (d. h. im Alternate-Screen-Modus)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, large cursor movements get an animation to help your eye follow the cursor. They are enabled only in interactive application (i.e., in alternate screen mode)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、大きなカーソル移動に目で追いやすくするアニメーションが付きます。これはインタラクティブなアプリケーション（つまり代替画面モード）でのみ有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 커서가 크게 이동할 때 애니메이션이 적용되어 커서를 눈으로 쉽게 따라갈 수 있습니다. 대화형 앱(즉, 대체 화면 모드)에서만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, grandes movimentos do cursor recebem uma animação para ajudar seu olhar a acompanhar o cursor. Eles são ativados apenas em aplicativos interativos (ou seja, no modo de tela alternativa)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, большие перемещения курсора сопровождаются анимацией, помогающей взгляду следить за курсором. Это работает только в интерактивных приложениях (то есть в режиме альтернативного экрана)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，大幅光标移动会带有动画，帮助你的视线跟随光标。它们仅在交互式应用中启用（即备用屏幕模式）。"
          }
        }
      }
    },
