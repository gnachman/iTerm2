    "6Fq-pl-5nd.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm.\"; ObjectID = \"6Fq-pl-5nd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ho actives, s’habilitaran les lligadures opcionals d’aquest tipus de lletra. Obliga l’iTerm2 a utilitzar un algorisme de renderització de text més lent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud to zapnete, povolí se volitelné ligatury tohoto písma. iTerm2 bude nucen použít pomalejší algoritmus vykreslování textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du slår dette til, aktiveres valgfrie ligaturer i denne skrift. Det tvinger iTerm2 til at bruge en langsommere algoritme til tekstgengivelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie dies aktivieren, werden optionale Ligaturen dieser Schrift aktiviert. Dadurch wird iTerm2 gezwungen, einen langsameren Algorithmus zur Textdarstellung zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το ενεργοποιήσετε, θα ενεργοποιηθούν τα προαιρετικά συμπλέγματα αυτής της γραμματοσειράς. Αναγκάζει το iTerm2 να χρησιμοποιεί πιο αργό αλγόριθμο απόδοσης κειμένου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, optional ligatures in this font will be enabled. It forces iTerm2 to use a slower text rendering algorithm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo activas, se habilitarán las ligaduras opcionales de este tipo de letra. Obliga a iTerm2 a usar un algoritmo de renderizado de texto más lento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo activas, se habilitarán las ligaduras opcionales de este tipo de letra. Obliga a iTerm2 a usar un algoritmo de renderizado de texto más lento."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo activas, se habilitarán las ligaduras opcionales de este tipo de letra. Obliga a iTerm2 a usar un algoritmo de renderizado de texto más lento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos otat tämän käyttöön, tämän fontin valinnaiset ligatuurit otetaan käyttöön. Se pakottaa iTerm2:n käyttämään hitaampaa tekstin renderöintialgoritmia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous activez cette option, les ligatures facultatives de cette police seront activées. Cela force iTerm2 à utiliser un algorithme de rendu du texte plus lent."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous activez cette option, les ligatures facultatives de cette police seront activées. Cela force iTerm2 à utiliser un algorithme de rendu du texte plus lent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे चालू करने पर इस फ़ॉन्ट के वैकल्पिक संयुक्ताक्षर सक्षम हो जाएँगे। इससे iTerm2 को धीमा टेक्स्ट रेंडरिंग एल्गोरिदम उपयोग करना पड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako ovo uključite, omogućit će se neobavezne ligature u ovom fontu. To prisiljava iTerm2 na sporiji algoritam renderiranja teksta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha bekapcsolja, a betűtípus opcionális ligatúrái engedélyezve lesznek. Ez arra kényszeríti az iTerm2-t, hogy lassabb szövegrenderelő algoritmust használjon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda menyalakan ini, ligatur opsional di font ini akan diaktifkan. Ini memaksa iTerm2 menggunakan algoritme perenderan teks yang lebih lambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo attivi, verranno abilitate le legature opzionali di questo font. Obbliga iTerm2 a usare un algoritmo di rendering del testo più lento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これをオンにすると、このフォントのオプションの合字が有効になります。これによりiTerm2は低速なテキスト描画アルゴリズムの使用を強制されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 이 서체의 선택적 합자가 활성화됩니다. 이 경우 iTerm2가 더 느린 텍스트 렌더링 알고리즘을 사용하게 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda menghidupkan ini, ligatur pilihan dalam fon ini akan didayakan. Ia memaksa iTerm2 menggunakan algoritma pemaparan teks yang lebih perlahan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du slår dette på, aktiveres valgfrie ligaturer i denne fonten. Det tvinger iTerm2 til å bruke en tregere algoritme for tekstgjengivelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit inschakelt, worden de optionele ligaturen van dit lettertype gebruikt. iTerm2 gebruikt dan een trager algoritme voor tekstweergave."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli włączysz tę opcję, zostaną włączone opcjonalne ligatury tej czcionki. Wymusza to na iTerm2 użycie wolniejszego algorytmu renderowania tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você ativar isto, as ligaduras opcionais desta fonte serão ativadas. Isto força o iTerm2 a usar um algoritmo de renderização de texto mais lento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativar isto, as ligaduras opcionais deste tipo de letra serão ativadas. Isto força o iTerm2 a usar um algoritmo de renderização de texto mais lento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă activați aceasta, ligaturile opționale ale acestui font vor fi activate. Obligă iTerm2 să folosească un algoritm de randare a textului mai lent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включить этот параметр, в этом шрифте будут включены необязательные лигатуры. Это заставляет iTerm2 использовать более медленный алгоритм отрисовки текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak to zapnete, povolia sa voliteľné ligatúry tohto písma. Aplikácia iTerm2 tak musí použiť pomalší algoritmus vykresľovania textu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če to vklopite, bodo omogočene izbirne ligature v tej pisavi. iTerm2 bo prisiljen uporabiti počasnejši algoritem upodabljanja besedila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du slår på detta aktiveras valfria ligaturer i det här typsnittet. Det tvingar iTerm2 att använda en långsammare algoritm för textrendering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเปิดตัวเลือกนี้ ลิเกเจอร์เพิ่มเติมของแบบอักษรนี้จะถูกเปิดใช้ ซึ่งบังคับให้ iTerm2 ใช้อัลกอริทึมเรนเดอร์ข้อความที่ช้ากว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu açarsanız bu fontun isteğe bağlı bitişik harfleri etkinleşir. iTerm2’yi daha yavaş bir metin işleme algoritması kullanmaya zorlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнути це, буде задіяно необовʼязкові лігатури цього шрифту. Це змушує iTerm2 використовувати повільніший алгоритм рендерингу тексту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bật, các chữ ghép tùy chọn trong phông chữ này sẽ được bật. Điều này buộc iTerm2 dùng thuật toán kết xuất văn bản chậm hơn."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后，将启用此字体的可选连字。这会迫使iTerm2使用较慢的文本渲染算法。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，會啟用此字體的選用連字。這會強制 iTerm2 使用較慢的文字繪製演算法。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，将启用此字体的可选连字。它会强制 iTerm2 使用较慢的文本渲染算法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，會啟用此字體的選用連字。這會強制 iTerm2 使用較慢的文字繪製演算法。"
