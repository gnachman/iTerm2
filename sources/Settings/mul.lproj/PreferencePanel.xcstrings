    "q57-nJ-Jbz.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Can the session title be changed by control sequence? Note that this is only enabled if Session or Profile & Session are selected in the title menu above.\"; ObjectID = \"q57-nJ-Jbz\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann der Sitzungstitel durch eine Steuersequenz geändert werden? Beachten Sie, dass dies nur aktiviert ist, wenn oben im Titelmenü „Sitzung“ oder „Profil & Sitzung“ ausgewählt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Can the session title be changed by control sequence? Note that this is only enabled if Session or Profile & Session are selected in the title menu above."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションタイトルを制御シーケンスで変更できるようにしますか?これは、上のタイトルメニューで「セッション」または「プロファイルとセッション」が選択されている場合にのみ有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 시퀀스로 세션 제목을 변경할 수 있게 하겠습니까? 위의 제목 메뉴에서 세션 또는 프로파일 및 세션을 선택한 경우에만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O título da sessão pode ser alterado por sequência de controle? Observe que isto só é ativado se Sessão ou Perfil e sessão estiverem selecionados no menu de título acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Может ли заголовок сессии изменяться управляющей последовательностью? Обратите внимание: это доступно, только если в меню заголовка выше выбрано «Сессия» или «Профиль и сессия»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话标题可以被控制序列更改吗？请注意，只有在上面标题菜单中选择了“会话”或“配置文件与会话”时才启用。"
          }
        }
      }
    },
