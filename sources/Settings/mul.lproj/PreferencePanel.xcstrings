    "ZG1-dm-1gD.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu.\"; ObjectID = \"ZG1-dm-1gD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Terminalanwendungen, die Mausberichte verwenden, ermöglicht diese Option, dass ein Rechtsklick (oder ein Zwei-Finger-Tipp auf einem Trackpad) gemeldet wird, anstatt das Kontextmenü zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスレポートを使用するターミナルアプリケーションの場合、これをオンにすると、コンテキストメニューを開く代わりに右クリック（またはトラックパッドの2本指タップ）を報告できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅을 사용하는 터미널 앱에서 이 옵션을 켜면 오른쪽 클릭(또는 트랙패드에서 두 손가락 탭) 시 컨텍스트 메뉴를 여는 대신 클릭이 앱에 보고됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos de terminal que usam relatório de mouse, ativar isto permite que o clique com o botão direito (ou o toque com dois dedos no trackpad) seja relatado em vez de abrir o menu de contexto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для приложений терминала, использующих отчёты о мыши, включение этого параметра позволяет сообщать о щелчке правой кнопкой (или касании двумя пальцами трекпада) вместо открытия контекстного меню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端应用，开启此选项后，右键点按（或触控板双指轻点）会被报告给应用，而不是打开上下文菜单。"
          }
        }
      }
    },
