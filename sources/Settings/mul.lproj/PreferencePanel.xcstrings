        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukladať riadky do histórie rolovania, keď je prítomná stavová lišta aplikácie"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
