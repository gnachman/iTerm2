        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raztegni zavihke čez celotno vrstico"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sträck ut flikarna så att de fyller fältet"
