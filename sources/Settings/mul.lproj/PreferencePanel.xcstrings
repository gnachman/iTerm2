    "6407.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If enabled, option-click sends arrow keys to move the cursor's position. If Shell Integration is installed then it does not take effect at the command line.\"; ObjectID = \"6407\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, kliknutí se ⌥ odešle šipky pro přesun kurzoru. Pokud je nainstalována integrace shellu, na příkazovém řádku to nemá účinek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er slået til, sender alternativ-klik piletaster for at flytte markørens position. Hvis shell-integration er installeret, har det ingen virkning på kommandolinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, sendet ein Option-Klick Pfeiltasten, um die Cursorposition zu verschieben. Wenn Shell Integration installiert ist, wirkt sich dies nicht auf die Befehlszeile aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, option-click sends arrow keys to move the cursor's position. If Shell Integration is installed then it does not take effect at the command line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, Opción-clic envía teclas de flecha para mover la posición del cursor. Si la integración con el shell está instalada, no tiene efecto en la línea de comandos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on käytössä, optio-klikkaus lähettää nuolinäppäimiä kohdistimen siirtämiseksi. Jos komentotulkki-integraatio on asennettu, tämä ei toimi komentorivillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, Option-clic envoie des touches fléchées pour déplacer le curseur. Si l’intégration du shell est installée, elle n’a pas d’effet sur la ligne de commande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, Opzione-clic invia i tasti freccia per spostare la posizione del cursore. Se l’integrazione shell è installata, non ha effetto sulla riga di comando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、オプションクリックでカーソル位置を移動する矢印キーが送信されます。シェル統合がインストールされている場合、コマンドラインでは効果がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 Option-클릭 시 화살표 키를 보내 커서 위치를 이동합니다. 셸 통합이 설치되어 있으면 명령행에서는 적용되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, sender Tilvalg-klikk piltaster for å flytte markørens plassering. Hvis skallintegrering er installert, har det ingen effekt på kommandolinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, verstuurt Option-klik pijltoetsen om de cursor te verplaatsen. Als Shell-integratie is geïnstalleerd, werkt dit niet op de opdrachtregel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ta opcja jest włączona, kliknięcie z klawiszem Option wysyła klawisze strzałek, aby przesunąć kursor. Jeśli zainstalowana jest integracja z powłoką, nie działa to w wierszu poleceń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, o Option-clique envia as teclas de seta para mover a posição do cursor. Se a Shell Integration estiver instalada, isto não terá efeito na linha de comando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, option-клик отправляет клавиши со стрелками для перемещения курсора. Если установлена Интеграция с оболочкой, это не действует в командной строке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, kliknutie s klávesom Option odošle šípky na presun pozície kurzora. Ak je nainštalovaná integrácia shellu, v príkazovom riadku sa to neprejaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je omogočeno, klik s tipko Option pošlje puščične tipke za premik položaja kazalca. Če je nameščena integracija lupine, to v ukazni vrstici ne deluje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är på skickar alternativ-klick piltangenter för att flytta markören. Om skalintegrering är installerad har det ingen effekt på kommandoraden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirilirse Option-tıklama, imlecin konumunu taşımak için ok tuşları gönderir. Kabuk Entegrasyonu yüklüyse komut satırında etkili olmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bật, Option-bấm sẽ gửi phím mũi tên để di chuyển vị trí con trỏ. Nếu đã cài Tích hợp shell thì tùy chọn này không có tác dụng tại dòng lệnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Option-点按会发送方向键来移动光标位置。如果安装了 Shell 集成，则在命令行中不生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，Option-按一下會傳送方向鍵來移動游標位置。若已安裝 Shell 整合，則在命令列中不會生效。"
          }
        }
      }
    },
