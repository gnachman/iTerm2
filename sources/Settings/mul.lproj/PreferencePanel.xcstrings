            "value" : "Étirer les onglets pour remplir la barre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allunga i pannelli per riempire la barra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブをバーいっぱいに引き伸ばす"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭을 막대 너비에 맞게 늘이기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strekk fanene til å fylle linjen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rek tabbladen uit tot de balk gevuld is"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozciągaj karty, aby wypełniły pasek"
