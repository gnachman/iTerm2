    "5049.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Selects whether to install the beta or release build when updating.\"; ObjectID = \"5049\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určuje, zda se při aktualizaci nainstaluje beta nebo vydaná verze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælger, om betaversionen eller den officielle version skal installeres ved opdatering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, ob beim Aktualisieren die Beta- oder die Release-Version installiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selects whether to install the beta or release build when updating."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona si instalar la versión beta o la versión final al actualizar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsee, asennetaanko päivitettäessä beta- vai julkaisuversio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit d’installer la version bêta ou la version finale lors d’une mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona se installare la versione beta o quella definitiva durante l’aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新時にベータ版とリリース版のどちらをインストールするかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트할 때 베타 빌드와 정식 빌드 중 무엇을 설치할지 선택합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger om beta- eller utgivelsesversjonen skal installeres ved oppdatering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt of bij het bijwerken de betaversie of de definitieve versie wordt geïnstalleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Określa, czy podczas uaktualniania instalować wersję beta, czy wydanie stabilne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleciona se deve instalar a versão beta ou a versão de lançamento ao atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяет, устанавливать бета-версию или стабильную сборку при обновлении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určuje, či sa pri aktualizácii nainštaluje beta alebo vydaná verzia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbere, ali se ob posodobitvi namesti beta ali izdana različica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljer om betaversionen eller den officiella versionen ska installeras vid uppdatering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncelleme yapılırken beta mı yoksa sürüm yapısının mı yükleneceğini seçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn cài đặt bản beta hay bản phát hành khi cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择更新时安装 beta 还是正式版构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇更新時要安裝 Beta 版或正式版。"
          }
        }
      }
    },
