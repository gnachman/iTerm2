    "6366.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session.\"; ObjectID = \"6366\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrabané relace se zobrazují v nabídce „Relace > Zahrabané relace“. Když je toto nastavení zapnuto, při připojení k existující relaci tmux se obnoví velikosti oken."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begravede sessioner vises under Session > Begravede sessioner. Når denne indstilling er slået til, gendannes vinduesstørrelser, når der tilknyttes en eksisterende tmux-session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrabene Sitzungen erscheinen unter Sitzung > Vergrabene Sitzungen. Wenn diese Einstellung aktiviert ist, werden die Fenstergrößen beim Verbinden mit einer bestehenden tmux-Sitzung wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones enterradas aparecen en Sesión > Sesiones enterradas. Cuando este ajuste está activado, los tamaños de las ventanas se restauran al conectarse a una sesión de tmux existente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haudatut istunnot näkyvät kohdassa Istunto > Haudatut istunnot. Kun tämä asetus on käytössä, ikkunoiden koot palautetaan liitettäessä olemassa olevaan tmux-istuntoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions enfouies apparaissent sous Session > Sessions enfouies. Lorsque ce réglage est activé, la taille des fenêtres est restaurée à l’attachement à une session tmux existante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni sepolte compaiono in Sessione > Sessioni sepolte. Quando questa impostazione è attiva, le dimensioni delle finestre vengono ripristinate al collegamento a una sessione tmux esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋められたセッションは「セッション > 埋められたセッション」に表示されます。この設定を有効にすると、既存のtmuxセッションにアタッチする際にウィンドウサイズが復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨둔 세션은 세션 > 숨겨둔 세션 아래에 나타납니다. 이 설정을 켜면 기존 tmux 세션에 연결할 때 윈도우 크기가 복원됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begravde økter vises under «Økt > Begravde økter». Når denne innstillingen er aktivert, gjenopprettes vindusstørrelser ved tilkobling til en eksisterende tmux-økt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begraven sessies verschijnen onder ‘Sessie > Begraven sessies’. Als deze instelling is ingeschakeld, worden vensterformaten hersteld bij het koppelen aan een bestaande tmux-sessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakopane sesje pojawiają się w menu Sesja > Zakopane sesje. Gdy to ustawienie jest włączone, rozmiary okien są przywracane po podłączeniu do istniejącej sesji tmux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões ocultas aparecem em Sessão > Sessões ocultas. Quando este ajuste está ativado, os tamanhos das janelas são restaurados ao anexar a uma sessão tmux existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые сессии отображаются в меню Сессия > Скрытые сессии. Если этот параметр включён, размеры окон восстанавливаются при подключении к существующей сессии tmux."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochované relácie sa zobrazia v menu „Relácia > Pochované relácie“. Keď je toto nastavenie zapnuté, veľkosti okien sa pri pripojení k existujúcej relácii tmux obnovia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokopane seje se prikažejo v meniju Seja > Pokopane seje. Ko je ta nastavitev omogočena, se velikosti oken obnovijo ob priklopu na obstoječo sejo tmux."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begravda sessioner visas under Session > Begravda sessioner. När den här inställningen är på återskapas fönsterstorlekarna när du kopplar till en befintlig tmux-session."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gömülü oturumlar Oturum > Gömülü Oturumlar altında görünür. Bu ayar etkinken, mevcut bir tmux oturumuna bağlanırken pencere boyutları geri yüklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các phiên đã chôn xuất hiện trong Phiên > Phiên đã chôn. Khi cài đặt này được bật, kích thước cửa sổ được khôi phục khi gắn vào một phiên tmux hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的会话显示在“会话 > 隐藏的会话”下。启用此设置后，附加到现有 tmux 会话时会恢复窗口大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已埋藏的工作階段會顯示在「工作階段 > 已埋藏的工作階段」下。啟用此設定後，附加到現有 tmux 工作階段時會回復視窗大小。"
          }
        }
      }
    },
    "6367.title" : {
