          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cursores de subrayado y de barra vertical pueden proyectar una sombra suave sobre el carácter que hay debajo del cursor, dándole sensación de profundidad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cursores de subrayado y de barra vertical pueden proyectar una sombra suave sobre el carácter que hay debajo del cursor, dándole sensación de profundidad."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cursores de subrayado y de barra vertical pueden proyectar una sombra suave sobre el carácter que hay debajo del cursor, dándole sensación de profundidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleviivaus- ja pystyviivakohdistimet voivat heittää pehmeän varjon kohdistimen alla olevan merkin päälle, mikä antaa syvyysvaikutelman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les curseurs en trait de soulignement et en barre verticale peuvent projeter une ombre portée douce sur le caractère situé sous le curseur, lui donnant de la profondeur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les curseurs en trait de soulignement et en barre verticale peuvent projeter une ombre portée douce sur le caractère situé sous le curseur, lui donnant de la profondeur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अंडरलाइन और वर्टिकल बार कर्सर, कर्सर के नीचे के कैरेक्टर पर हल्की छाया डाल सकते हैं, जिससे उसमें गहराई का एहसास होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursori u obliku podcrtavanja i okomite crte mogu baciti blagu sjenu na znak ispod kursora, čime dobiva dojam dubine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az aláhúzásos és a függőleges vonalas kurzor lágy árnyékot vethet a kurzor alatti karakterre, mélységérzetet adva neki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursor garis bawah dan bilah vertikal dapat memberikan bayangan lembut pada karakter di bawah kursor, sehingga tampak lebih berdimensi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I cursori a sottolineatura e a barra verticale possono proiettare una leggera ombra sul carattere sottostante, dandogli un senso di profondità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下線カーソルと縦棒カーソルは、カーソルの下にある文字に柔らかいドロップシャドウを落とすことができ、奥行きのある印象を与えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밑줄 커서와 세로 막대 커서는 커서 아래의 문자에 부드러운 그림자를 드리워 입체감을 줄 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursor garis bawah dan bar menegak boleh memancarkan bayang lembut pada aksara di bawah kursor, memberikan kesan kedalaman."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understrekings- og loddrett strek-markører kan kaste en myk skygge på tegnet under markøren, slik at det får en følelse av dybde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderstreepte cursors en cursors in de vorm van een verticale streep kunnen een zachte slagschaduw werpen op het teken onder de cursor, waardoor het meer diepte krijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursory podkreślenia i pionowej kreski mogą rzucać miękki cień na znak pod kursorem, nadając mu wrażenie głębi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursores de sublinhado e de barra vertical podem projetar uma sombra suave sobre o caractere abaixo do cursor, dando a ele uma sensação de profundidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cursores de sublinhado e de barra vertical podem projetar uma sombra suave sobre o caráter abaixo do cursor, dando-lhe uma sensação de profundidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursoarele de tip subliniere și bară verticală pot proiecta o umbră fină pe caracterul de sub cursor, oferindu-i senzația de profunzime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсоры-подчёркивания и вертикальные курсоры могут отбрасывать мягкую тень на символ под курсором, создавая ощущение глубины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzory podčiarknutia a zvislej čiary môžu vrhať jemný tieň na znak pod kurzorom, čím mu dodajú dojem hĺbky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kazalca s podčrtajem in navpično črto lahko vržeta mehko senco na znak pod kazalcem, kar daje občutek globine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Understrykningsmarkörer och vertikala stapelmarkörer kan kasta en mjuk skugga på tecknet under markören, vilket ger ett intryck av djup."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เคอร์เซอร์แบบขีดล่างและแบบแถบแนวตั้งสามารถทอดเงาอ่อนๆ ลงบนอักขระใต้เคอร์เซอร์ เพื่อให้ดูมีมิติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt çizgi ve dikey çubuk imleçler, imlecin altındaki karaktere yumuşak bir gölge düşürerek derinlik hissi verebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Курсори підкреслення та вертикальної смуги можуть відкидати мʼяку тінь на символ під курсором, надаючи йому відчуття глибини."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con trỏ gạch chân và thanh dọc có thể đổ bóng mờ lên ký tự bên dưới con trỏ, tạo cảm giác chiều sâu."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下划线和竖条光标可以在光标下方的字符上投下柔和的阴影，使其更有层次感。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底線與垂直線游標可以在游標下方的字元上投射柔和的陰影，使其更具立體感。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下划线光标和竖线光标可以给光标下方的字符投射柔和的阴影，使其具有立体感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "底線與垂直線游標可以在游標下方的字元上投射柔和的陰影，使其更具立體感。"
          }
        }
      }
    },
    "EkI-wa-K9H.ibShadowedToolTip" : {
      "comment" : "Class = \"NSTextField\"; ibShadowedToolTip = \"The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents.\"; ObjectID = \"EkI-wa-K9H\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de progrés va a la part superior de la sessió. No pot superar l’alçada del marge superior per evitar solapar-se amb el contingut del terminal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikátor průběhu je v horní části relace. Aby nepřekrýval obsah terminálu, nemůže přesáhnout výšku horního okraje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremdriftslinjen placeres øverst i sessionen. Den kan ikke overstige den øverste margens højde, så den ikke overlapper terminalens indhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fortschrittsanzeige befindet sich oben in der Sitzung. Sie kann die Höhe des oberen Rands nicht überschreiten, um eine Überlappung mit dem Terminalinhalt zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μπάρα προόδου εμφανίζεται στο πάνω μέρος της συνεδρίας. Δεν μπορεί να υπερβαίνει το ύψος του πάνω περιθωρίου, ώστε να μην επικαλύπτει το περιεχόμενο του τερματικού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The progress bar goes at the top of the session. It cannot exceed the top margin height to avoid overlapping terminal contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de progreso va en la parte superior de la sesión. No puede superar la altura del margen superior para evitar solaparse con el contenido de la terminal."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de progreso va en la parte superior de la sesión. No puede superar la altura del margen superior para evitar solaparse con el contenido de la terminal."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de progreso va en la parte superior de la sesión. No puede superar la altura del margen superior para evitar solaparse con el contenido de la terminal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edistymispalkki sijaitsee istunnon yläreunassa. Se ei voi ylittää ylämarginaalin korkeutta, jotta se ei peitä päätteen sisältöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de progression se place en haut de la session. Elle ne peut pas dépasser la hauteur de la marge supérieure afin de ne pas recouvrir le contenu du terminal."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de progression se place en haut de la session. Elle ne peut pas dépasser la hauteur de la marge supérieure afin de ne pas recouvrir le contenu du terminal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोग्रेस बार सत्र के शीर्ष पर रहता है। टर्मिनल सामग्री से ओवरलैप न हो, इसलिए यह ऊपरी मार्जिन की ऊँचाई से अधिक नहीं हो सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traka napretka nalazi se pri vrhu sesije. Ne može premašiti visinu gornje margine kako se ne bi preklapala sa sadržajem terminala."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folyamatjelző sáv a munkamenet tetején helyezkedik el. Nem haladhatja meg a felső margó magasságát, hogy ne fedje át a terminál tartalmát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bar progres berada di bagian atas sesi. Tingginya tidak dapat melebihi tinggi margin atas agar tidak menutupi isi terminal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra di avanzamento si trova in cima alla sessione. Non può superare l’altezza del margine superiore per evitare di sovrapporsi al contenuto del terminale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プログレスバーはセッションの上部に表示されます。ターミナルの内容と重ならないよう、上部マージンの高さを超えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 막대는 세션 상단에 표시됩니다. 터미널 내용과 겹치지 않도록 상단 여백 높이를 초과할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bar kemajuan berada di bahagian atas sesi. Ia tidak boleh melebihi tinggi jidar atas untuk mengelakkan bertindih dengan kandungan terminal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremdriftslinjen ligger øverst i økten. Den kan ikke overstige høyden på toppmarginen, slik at den ikke overlapper terminalinnholdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De voortgangsbalk staat bovenaan de sessie. Hij kan niet hoger zijn dan de bovenmarge, zodat hij de inhoud van de terminal niet overlapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek postępu znajduje się na górze sesji. Nie może przekraczać wysokości górnego marginesu, aby nie zasłaniać zawartości terminala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra de progresso fica no topo da sessão. Ela não pode exceder a altura da margem superior para evitar sobreposição com o conteúdo do terminal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra de progresso fica no topo da sessão. Não pode exceder a altura da margem superior para evitar sobreposição com o conteúdo do terminal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara de progres se află în partea de sus a sesiunii. Nu poate depăși înălțimea marginii de sus, pentru a evita suprapunerea peste conținutul terminalului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индикатор выполнения располагается в верхней части сессии. Он не может превышать высоту верхнего поля, чтобы не перекрывать содержимое терминала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indikátor priebehu je v hornej časti relácie. Nemôže presiahnuť výšku horného okraja, aby neprekrýval obsah terminálu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrstica napredka je na vrhu seje. Ne more presegati višine zgornjega roba, da se ne prekriva z vsebino terminala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förloppsindikatorn placeras överst i sessionen. Den kan inte vara högre än den övre marginalen, så att den inte överlappar terminalens innehåll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถบความคืบหน้าอยู่ด้านบนของเซสชั่น และสูงได้ไม่เกินความสูงของขอบด้านบนเพื่อไม่ให้ทับเนื้อหาของเทอร์มินัล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme çubuğu oturumun üstünde yer alır. Terminal içeriğiyle çakışmamak için üst kenar boşluğu yüksekliğini aşamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Індикатор перебігу розміщується вгорі сеансу. Він не може перевищувати висоту верхнього поля, щоб не перекривати вміст термінала."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh tiến trình nằm ở đầu phiên. Nó không thể vượt quá chiều cao lề trên để tránh chồng lên nội dung terminal."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条位于会话顶部。其高度不能超过顶部边距高度，以免与终端内容重叠。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度列位於工作階段頂部。為避免與終端機內容重疊，其高度不能超過上邊界高度。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度条位于会话顶部。它不能超过上边距高度，以避免与终端内容重叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進度列位於工作階段頂部。為避免與終端機內容重疊，其高度不能超過上邊界高度。"
          }
        }
      }
    },
