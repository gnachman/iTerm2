    "mOt-Fp-WpW.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"Controls the opacity of faint (dim) text produced by SGR 2. Lower values make faint text fade further toward the background; at 1, it has no effect.\"; ObjectID = \"mOt-Fp-WpW\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řídí neprůhlednost slabého (ztlumeného) textu vytvářeného sekvencí SGR 2. Nižší hodnoty způsobí, že slabý text více zmizí do pozadí; při hodnotě 1 nemá žádný účinek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer uigennemsigtigheden af svag (dæmpet) tekst frembragt af SGR 2. Lavere værdier får svag tekst til at falde yderligere ud mod baggrunden. Ved 1 har det ingen effekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuert die Deckkraft von blassem (gedimmtem) Text, der durch SGR 2 erzeugt wird. Niedrigere Werte lassen blassen Text stärker in den Hintergrund übergehen; bei 1 hat es keine Wirkung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Controls the opacity of faint (dim) text produced by SGR 2. Lower values make faint text fade further toward the background; at 1, it has no effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla la opacidad del texto tenue (atenuado) producido por SGR 2. Los valores más bajos hacen que el texto tenue se difumine más hacia el fondo; con 1, no tiene efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säätää SGR 2:n tuottaman himmeän tekstin peittävyyttä. Pienemmät arvot haalistavat himmeää tekstiä enemmän taustaa kohti; arvolla 1 sillä ei ole vaikutusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôle l’opacité du texte atténué produit par SGR 2. Des valeurs plus basses estompent davantage le texte atténué vers l’arrière-plan ; à 1, il n’y a aucun effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l’opacità del testo tenue (attenuato) prodotto da SGR 2. Valori più bassi fanno sfumare di più il testo tenue verso lo sfondo; con 1 non ha alcun effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SGR 2によって生成される淡い(dim)テキストの不透明度を調整します。値を小さくすると、淡いテキストは背景色に向かってさらに薄くなります。1の場合は効果がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SGR 2로 생성된 흐린(dim) 텍스트의 불투명도를 조절합니다. 값이 낮을수록 흐린 텍스트가 배경 쪽으로 더 옅어지며, 1이면 효과가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styrer ugjennomsiktigheten til svak (dempet) tekst produsert av SGR 2. Lavere verdier får svak tekst til å tone lenger mot bakgrunnen; ved 1 har det ingen effekt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt de dekking van vage (gedimde) tekst die door SGR 2 wordt geproduceerd. Lagere waarden laten vage tekst verder vervagen naar de achtergrond; bij 1 heeft het geen effect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steruje kryciem tekstu przyciemnionego (przygaszonego) wytwarzanego przez SGR 2. Niższe wartości powodują, że tekst przyciemniony bardziej zanika w kierunku tła; przy 1 nie ma efektu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla a opacidade do texto tênue (esmaecido) produzido por SGR 2. Valores mais baixos fazem o texto tênue esmaecer mais em direção ao plano de fundo; em 1, não tem efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Управляет непрозрачностью тусклого (приглушённого) текста, создаваемого SGR 2. Меньшие значения делают тусклый текст более похожим на фон; при значении 1 эффект отсутствует."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Určuje nepriehľadnosť slabého (stlmeného) textu vytvoreného sekvenciou SGR 2. Nižšie hodnoty spôsobia, že slabý text viac zbledne smerom k pozadiu; pri hodnote 1 nemá žiadny účinok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadzoruje neprosojnost medlega (zatemnjenega) besedila, ustvarjenega s SGR 2. Nižje vrednosti medlo besedilo bolj zbledijo proti ozadju; pri 1 ni učinka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr opaciteten för dämpad text som skapas av SGR 2. Lägre värden får dämpad text att tona ut mer mot bakgrunden; vid 1 har den ingen effekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SGR 2 ile üretilen soluk (kısık) metnin opaklığını denetler. Düşük değerler soluk metni arka plana doğru daha fazla soldurur; 1 değerinde etkisi yoktur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều khiển độ mờ đục của văn bản mờ (nhạt) do SGR 2 tạo ra. Giá trị thấp hơn làm văn bản mờ phai dần về phía nền; ở mức 1 thì không có tác dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制 SGR 2 产生的暗淡文本的不透明度。值越低，暗淡文本越向背景淡出；为 1 时无效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制 SGR 2 所產生暗淡（變暗）文字的不透明度。值越低，暗淡文字越向背景淡出；為 1 時無效果。"
          }
        }
      }
    },
