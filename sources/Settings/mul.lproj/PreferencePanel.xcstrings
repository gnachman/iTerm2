    "8OW-y4-gl0.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"…but only if it would cause the window to go off-screen\"; ObjectID = \"8OW-y4-gl0\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…però només si farà que la finestra quedi fora de la pantalla"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ale jen pokud by okno jinak přesáhlo obrazovku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…men kun hvis det ville få vinduet til at komme uden for skærmen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… aber nur, wenn das Fenster dadurch außerhalb des Bildschirms liegen würde"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…αλλά μόνο αν θα έβγαινε το παράθυρο εκτός οθόνης"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "…but only if it would cause the window to go off-screen"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…but only if it would cause the window to go off-screen"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…but only if it would cause the window to go off-screen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…but only if it would cause the window to go off-screen"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…but only if it would cause the window to go off-screen"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…but only if it would cause the window to go off-screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…pero solo si hiciera que la ventana quedara fuera de la pantalla"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…pero sólo si hiciera que la ventana quedara fuera de la pantalla"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…pero sólo si hiciera que la ventana quedara fuera de la pantalla"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mutta vain jos se saisi ikkunan siirtymään näytön ulkopuolelle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mais seulement si la fenêtre sortirait de l’écran"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mais seulement si la fenêtre sortirait de l’écran"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…लेकिन केवल तभी जब इससे विंडो स्क्रीन से बाहर चली जाए"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ali samo ako bi prozor otišao izvan zaslona"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…de csak ha ettől az ablak kilógna a képernyőről"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…tetapi hanya jika akan membuat jendela keluar dari layar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ma solo se la finestra uscirebbe dallo schermo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ただしウィンドウが画面外に出てしまう場合のみ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…단, 윈도우가 화면 밖으로 벗어나는 경우에만"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…tetapi hanya jika ia menyebabkan tetingkap keluar daripada skrin"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…men bare hvis det ville ført til at vinduet havner utenfor skjermen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…maar alleen als het venster daardoor buiten het scherm zou vallen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ale tylko jeśli spowodowałoby to wyjście okna poza ekran"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mas apenas se isso fizer a janela sair da tela"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mas apenas se isso fizer a janela sair do ecrã"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…dar numai dacă fereastra ar ieși în afara ecranului"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…но только если это привело бы к выходу окна за пределы экрана"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ale iba ak by okno zašlo mimo obrazovky"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… vendar samo, če bi okno zaradi tega zašlo z zaslona"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…men bara om det skulle få fönstret att hamna utanför skärmen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…แต่เฉพาะเมื่อจะทำให้หน้าต่างอยู่นอกหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ancak yalnızca pencerenin ekran dışına çıkmasına neden olacaksa"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…але лише якщо це призведе до виходу вікна за межі екрана"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…nhưng chỉ khi nó khiến cửa sổ ra ngoài màn hình"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…但仅当会导致窗口超出屏幕时"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…但僅限會導致視窗移出螢幕時"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…但仅当会导致窗口移出屏幕时"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…但僅限會導致視窗移出螢幕時"
          }
        }
      }
    },
