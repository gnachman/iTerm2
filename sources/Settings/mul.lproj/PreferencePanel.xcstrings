            "state" : "translated",
            "value" : "Estirar las pestañas para llenar la barra"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venytä välilehdet täyttämään palkki"
          }
        },
        "fr" : {
