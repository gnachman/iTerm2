          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 왼쪽 Option 키를 변경할 수 있음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps podem alterar a tecla option esquerda"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
