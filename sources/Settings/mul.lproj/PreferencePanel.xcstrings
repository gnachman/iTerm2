    "3PU-hM-DSB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence.\"; ObjectID = \"3PU-hM-DSB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativní posouvání myší je funkce, která v reakci na kolečko myši nebo gesta posouvání odesílá klávesy se šipkami. Zapíná se a vypíná řídicí sekvencí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulning er en funktion, der sender piletaster som svar på rullehjul eller rullebevægelser. Den slås til og fra af en kontrolsekvens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alternatives Scrollen mit der Maus“ ist eine Funktion, die bei Mausrad-/Scrollgesten Pfeiltasten sendet. Sie wird über eine Steuersequenz umgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del ratón es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoinen hiirivieritys lähettää nuolinäppäimiä vierityspyörän tai vieritysliikkeiden seurauksena. Se kytketään ohjaussarjalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Il est activé et désactivé par une séquence de contrôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scorrimento alternativo del mouse è una funzione che invia i tasti freccia in risposta alla rotellina o ai gesti di scorrimento. Viene attivato da una sequenza di controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、スクロールホイールやスクロールジェスチャに応じて矢印キーを送信する機能です。制御シーケンスで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 마우스 스크롤은 스크롤 휠/스크롤 제스처에 반응하여 화살표 키를 보내는 기능입니다. 제어 시퀀스로 켜고 끌 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulling sender piltaster som svar på rullehjul og rullebevegelser. Den slås av og på med en kontrollsekvens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatief muisscrollen is een functie die pijltjestoetsen verstuurt als reactie op het scrollwiel of scrolgebaren. Het wordt in- en uitgeschakeld met een besturingsreeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatywne przewijanie myszą to funkcja wysyłająca klawisze strzałek w odpowiedzi na kółko przewijania lub gesty przewijania. Włącza się ją sekwencją sterującą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem/gestos de rolagem. É alternada por uma sequência de controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Альтернативная прокрутка мышью» — это функция, которая отправляет клавиши со стрелками в ответ на прокрутку колёсика мыши или жесты прокрутки. Она переключается управляющей последовательностью."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatívne rolovanie myšou je funkcia, ktorá v reakcii na koliesko myši alebo gestá rolovania odosiela šípky. Zapína sa a vypína riadiacou sekvenciou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadomestno pomikanje z miško je funkcija, ki ob pomikanju s kolescem ali kretnjami pošilja tipke s puščicami. Vklopi in izklopi se s krmilnim zaporedjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrullning är en funktion som skickar piltangenter som svar på rullningshjul eller rullningsgester. Den slås på och av med en styrsekvens."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif Fare Kaydırma, kaydırma tekerleği veya kaydırma hareketlerine yanıt olarak ok tuşları gönderen bir özelliktir. Bir denetim dizisiyle açılıp kapatılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn chuột thay thế là tính năng gửi phím mũi tên khi cuộn bằng con lăn hoặc cử chỉ cuộn. Tính năng này được bật/tắt bằng một chuỗi điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能，由控制序列切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替代滑鼠捲動功能會在滾輪或捲動手勢時傳送方向鍵，並由控制序列切換。"
          }
        }
      }
    },
