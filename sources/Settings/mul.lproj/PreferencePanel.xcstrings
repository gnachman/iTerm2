    "fRb-hJ-joB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"You probably don't want this; most systems use ^? (ASCII 127) for backspace. Changing this setting affects the key mappings in the table above.\"; ObjectID = \"fRb-hJ-joB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das wollen Sie wahrscheinlich nicht; die meisten Systeme verwenden ^? (ASCII 127) für die Rücktaste. Das Ändern dieser Einstellung wirkt sich auf die Tastenzuordnungen in der obigen Tabelle aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You probably don't want this; most systems use ^? (ASCII 127) for backspace. Changing this setting affects the key mappings in the table above."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくこれは望まないでしょう。ほとんどのシステムでは、バックスペースに^? (ASCII 127)を使用します。この設定を変更すると、上の表のキーマッピングに影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 필요하지 않을 가능성이 높습니다. 대부분의 시스템은 백스페이스에 ^?(ASCII 127)를 사용합니다. 이 설정을 변경하면 위 표의 키 매핑에 영향을 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você provavelmente não quer isto; a maioria dos sistemas usa ^? (ASCII 127) para o backspace. Alterar este ajuste afeta os mapeamentos de teclas na tabela acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вероятно, вам это не нужно; в большинстве систем для backspace используется ^? (ASCII 127). Изменение этой настройки влияет на привязки клавиш в таблице выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不需要这个；大多数系统使用 ^?（ASCII 127）作为退格键。更改此设置会影响上表中的按键映射。"
          }
        }
      }
    },
    "FSW-rl-pkB.headerCell.title" : {
