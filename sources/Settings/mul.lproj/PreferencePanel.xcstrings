    "3245.ibShadowedToolTip" : {
      "comment" : "Class = \"NSTokenField\"; ibShadowedToolTip = \"Tags with slashes create a hierarchy which you can navigate in the Profiles menu or in the tags list adjacent to lists of profiles.\"; ObjectID = \"3245\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Štítky s lomítky vytvářejí hierarchii, ve které se můžete pohybovat v nabídce Profily nebo v seznamu štítků vedle seznamů profilů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags med skråstreger opretter et hierarki, som du kan navigere i via menuen Profiler eller i taglisten ved siden af profillister."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags mit Schrägstrichen erstellen eine Hierarchie, die Sie im Menü „Profile“ oder in der Tag-Liste neben den Profillisten durchsuchen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tags with slashes create a hierarchy which you can navigate in the Profiles menu or in the tags list adjacent to lists of profiles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas con barras crean una jerarquía que puedes recorrer en el menú Perfiles o en la lista de etiquetas junto a las listas de perfiles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinoviivoja sisältävät tunnisteet muodostavat hierarkian, jossa voit liikkua Profiilit-valikossa tai profiililuetteloiden vieressä olevassa tunnisteluettelossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tags contenant des barres obliques créent une hiérarchie que vous pouvez parcourir dans le menu Profils ou dans la liste des tags à côté des listes de profils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tag con barre creano una gerarchia che puoi esplorare nel menu Profili o nell’elenco dei tag accanto agli elenchi di profili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スラッシュを含むタグは階層を作成し、プロファイルメニューやプロファイル一覧に隣接するタグリストで移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬래시가 포함된 태그는 계층 구조를 만들며, 프로파일 메뉴나 프로파일 목록 옆의 태그 목록에서 탐색할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiketter med skråstreker danner et hierarki som du kan navigere i Profiler-menyen eller i etikettlisten ved siden av profillistene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags met schuine strepen vormen een hiërarchie die je kunt doorlopen in het menu Profielen of in de lijst met tags naast de profiellijsten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagi z ukośnikami tworzą hierarchię, po której możesz nawigować w menu Profile lub na liście tagów obok list profili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tags com barras criam uma hierarquia que você pode navegar no menu Perfis ou na lista de tags ao lado das listas de perfis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теги с косой чертой создают иерархию, по которой можно перемещаться в меню «Профили» или в списке тегов рядом со списками профилей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagy s lomkami vytvárajú hierarchiu, v ktorej sa môžete pohybovať v menu Profily alebo v zozname tagov vedľa zoznamov profilov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznake s poševnicami ustvarijo hierarhijo, po kateri se lahko pomikate v meniju Profili ali na seznamu oznak ob seznamih profilov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taggar med snedstreck skapar en hierarki som du kan navigera i menyn Profiler eller i taglistan bredvid profillistorna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eğik çizgili etiketler, Profiller menüsünde veya profil listelerinin yanındaki etiket listesinde gezebileceğiniz bir hiyerarşi oluşturur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thẻ có dấu gạch chéo tạo thành cấu trúc phân cấp mà bạn có thể duyệt trong menu Hồ sơ hoặc trong danh sách thẻ cạnh danh sách hồ sơ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带斜杠的标签可创建层级结构，你可以在配置文件菜单或配置文件列表旁的标签列表中导航。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "含有斜線的標籤會建立階層，你可以在「描述檔」選單或描述檔列表旁的標籤列表中瀏覽。"
          }
        }
      }
    },
