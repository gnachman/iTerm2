    "fXR-fI-xdt.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Automatically enter copy mode on Shift+Arrow key with selection\"; ObjectID = \"fXR-fI-xdt\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky vstoupit do režimu kopírování při Shift+šipka s výběrem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå automatisk til kopieringstilstand med Skift+piletast og en markering"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Umschalt+Pfeiltaste mit Auswahl automatisch den Kopiermodus aktivieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatically enter copy mode on Shift+Arrow key with selection"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar automáticamente en el modo de copia con Mayúsculas+flecha y una selección"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirry automaattisesti kopiointitilaan vaihto+nuolinäppäimellä ja valinnalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer automatiquement en mode copie avec Maj+flèche et une sélection"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra automaticamente in modalità copia con Maiuscole+freccia in presenza di una selezione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択状態でShift+矢印キーを押すと自動的にコピーモードに入る"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 영역이 있을 때 Shift+화살표 키를 누르면 자동으로 복사 모드 시작"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå automatisk til kopieringsmodus med Skift+piltast når tekst er markert"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga automatisch naar de kopieermodus bij Shift+pijltoets met een selectie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie wchodź w tryb kopiowania po Shift+strzałka z zaznaczeniem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar automaticamente no modo de cópia ao usar Shift+seta com seleção"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически входить в режим копирования при Shift+стрелка с выделением"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky vstúpiť do režimu kopírovania pri Shift+šípka s výberom"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodejno vstopi v način kopiranja ob Shift+puščica z izborom"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå automatiskt till kopieringsläge vid skift+piltangent med markering"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçim varken Shift+Ok tuşunda otomatik olarak kopyalama moduna gir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động vào chế độ sao chép khi nhấn Shift+phím mũi tên với vùng chọn đang có"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Shift+方向键选中时自动进入拷贝模式"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 Shift+方向鍵選取時自動進入拷貝模式"
          }
        }
      }
    },
