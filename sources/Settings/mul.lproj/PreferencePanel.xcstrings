    "Rug-jx-jJP.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile.\"; ObjectID = \"Rug-jx-jJP\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan està seleccionat, el macOS col·loca les finestres al seu criteri. La mida de la finestra prové de les files i columnes especificades al perfil d’origen de la finestra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li vybráno, macOS umisťuje okna podle vlastního uvážení. Velikost okna vychází z počtu řádků a sloupců zadaného v profilu, ze kterého okno vzniklo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er valgt, placerer macOS vinduer, som det passer. Vinduets størrelse kommer fra de rækker og kolonner, der er angivet i vinduets oprindelsesprofil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ausgewählt, positioniert macOS Fenster nach eigenem Ermessen. Die Fenstergröße ergibt sich aus den Zeilen und Spalten, die im ursprünglichen Profil des Fensters angegeben sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι επιλεγμένο, το macOS τοποθετεί τα παράθυρα κατά το δοκούν. Το μέγεθος του παραθύρου προκύπτει από τις γραμμές και τις στήλες που ορίζονται στο προφίλ προέλευσης του παραθύρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When selected, macOS positions windows according to its whims. The window size comes from the rows and columns specified in the window’s originating profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está seleccionado, macOS coloca las ventanas a su antojo. El tamaño de la ventana procede de las filas y columnas especificadas en el perfil de origen de la ventana."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está seleccionado, macOS coloca las ventanas a su antojo. El tamaño de la ventana procede de las filas y columnas especificadas en el perfil de origen de la ventana."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está seleccionado, macOS coloca las ventanas a su antojo. El tamaño de la ventana procede de las filas y columnas especificadas en el perfil de origen de la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on valittu, macOS sijoittaa ikkunat oman mielensä mukaan. Ikkunan koko määräytyy ikkunan lähtöprofiiliin määritettyjen rivien ja sarakkeiden mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est sélectionnée, macOS positionne les fenêtres à sa guise. La taille de la fenêtre provient des rangées et colonnes indiquées dans le profil d’origine de la fenêtre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est sélectionnée, macOS positionne les fenêtres à sa guise. La taille de la fenêtre provient des rangées et colonnes indiquées dans le profil d’origine de la fenêtre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने जाने पर macOS अपनी मर्ज़ी से विंडो रखता है। विंडो का आकार विंडो की मूल प्रोफ़ाइल में बताई गई पंक्तियों और कॉलम से आता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je odabrano, macOS postavlja prozore po vlastitom nahođenju. Veličina prozora dolazi iz redaka i stupaca određenih u profilu iz kojeg prozor potječe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ki van választva, a macOS saját szeszélye szerint helyezi el az ablakokat. Az ablak mérete az ablak származási profiljában megadott sorokból és oszlopokból adódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dipilih, macOS menempatkan jendela sesuai kehendaknya sendiri. Ukuran jendela berasal dari baris dan kolom yang ditentukan di profil asal jendela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è selezionato, macOS posiziona le finestre a suo piacimento. La dimensione della finestra deriva dalle righe e dalle colonne specificate nel profilo di origine della finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択すると、macOSが独自の判断でウィンドウを配置します。ウィンドウサイズは、そのウィンドウの元のプロファイルで指定された行数と列数から決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택하면 macOS가 임의로 윈도우의 위치를 정합니다. 윈도우 크기는 해당 윈도우를 만든 프로파일에 지정된 행과 열 수에 따라 결정됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila dipilih, macOS meletakkan tetingkap mengikut kehendaknya. Saiz tetingkap datang daripada baris dan lajur yang ditentukan dalam profil asal tetingkap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er valgt, plasserer macOS vinduene etter eget forgodtbefinnende. Vindusstørrelsen kommer fra radene og kolonnene som er angitt i vinduets opprinnelige profil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is geselecteerd, plaatst macOS vensters naar eigen inzicht. Het formaat van het venster volgt uit de rijen en kolommen in het profiel waaruit het venster afkomstig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest zaznaczona, macOS rozmieszcza okna według własnego uznania. Rozmiar okna wynika z wierszy i kolumn określonych w profilu, z którego pochodzi okno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selecionado, o macOS posiciona as janelas conforme sua vontade. O tamanho da janela vem das linhas e colunas especificadas no perfil de origem da janela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando selecionado, o macOS posiciona as janelas conforme lhe aprouver. O tamanho da janela vem das linhas e colunas especificadas no perfil de origem da janela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este selectat, macOS poziționează ferestrele după bunul plac. Dimensiunea ferestrei provine din rândurile și coloanele specificate în profilul de origine al ferestrei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выбрано, macOS будет располагать окна по своему усмотрению. Размер окна определяется строками и столбцами, заданными в исходном профиле окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je vybraté, macOS rozmiestňuje okná podľa vlastného uváženia. Veľkosť okna vychádza z riadkov a stĺpcov určených v profile, z ktorého okno vzniklo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to izbrano, macOS okna postavlja po svoji presoji. Velikost okna izhaja iz števila vrstic in stolpcev, določenih v profilu, iz katerega je okno nastalo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är valt placerar macOS fönstren efter eget behag. Fönsterstorleken kommer från de rader och kolumner som anges i fönstrets ursprungsprofil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือกตัวเลือกนี้ macOS จะวางตำแหน่งหน้าต่างตามความเหมาะสมของระบบ ขนาดหน้าต่างมาจากจำนวนแถวและคอลัมน์ที่ระบุไว้ในโปรไฟล์ต้นทางของหน้าต่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçildiğinde macOS pencereleri kendi keyfine göre konumlandırır. Pencere boyutu, pencerenin kaynak profilinde belirtilen satır ve sütunlardan gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли вибрано, macOS розміщує вікна на власний розсуд. Розмір вікна визначається рядками й стовпцями, указаними в профілі, з якого створено вікно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chọn, macOS đặt vị trí cửa sổ theo ý nó. Kích thước cửa sổ lấy từ số dòng và cột được chỉ định trong hồ sơ gốc của cửa sổ."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中后，macOS会按自己的方式放置窗口。窗口大小取决于窗口来源描述文件中指定的行数和列数。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取後，macOS 會依自己的喜好擺放視窗。視窗大小來自視窗來源描述檔中指定的列數與欄數。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中后，macOS 会按自己的意愿放置窗口。窗口大小来自窗口来源配置文件中指定的行列数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取後，macOS 會依自己的喜好擺放視窗。視窗大小來自視窗來源描述檔中指定的列數與欄數。"
          }
        }
      }
    },
