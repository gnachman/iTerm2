    "5154.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When using a program like tmux, which shows a status bar at the bottom of the screen, history is not normally saved. This allows such history to be saved but with a performance penalty.\"; ObjectID = \"5154\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Verwendung eines Programms wie tmux, das am unteren Bildschirmrand eine Statusleiste anzeigt, wird der Verlauf normalerweise nicht gespeichert. Dies ermöglicht das Speichern dieses Verlaufs, jedoch mit Leistungseinbußen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using a program like tmux, which shows a status bar at the bottom of the screen, history is not normally saved. This allows such history to be saved but with a performance penalty."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxのように画面下部にステータスバーを表示するプログラムを使用している場合、通常は履歴が保存されません。これにより、パフォーマンスは低下しますがそのような履歴を保存できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 하단에 상태 막대를 표시하는 tmux 같은 프로그램을 사용할 때는 보통 기록이 저장되지 않습니다. 이 옵션을 켜면 이러한 기록을 저장할 수 있지만 성능이 저하됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar um programa como o tmux, que mostra uma barra de status na parte inferior da tela, o histórico normalmente não é salvo. Isto permite salvar esse histórico, mas com perda de desempenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании программы наподобие tmux, показывающей строку состояния внизу экрана, история обычно не сохраняется. Этот параметр позволяет сохранять такую историю, но снижает производительность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 等屏幕底部显示状态栏的程序时，通常不保存历史。此选项允许保存此类历史，但会有性能损失。"
          }
        }
      }
    },
    "5155.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Save lines to scrollback when an app status bar is present\"; ObjectID = \"5155\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen im Scrollback speichern, wenn eine App-Statusleiste vorhanden ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save lines to scrollback when an app status bar is present"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのステータスバーが存在する場合に行をスクロールバックに保存"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 상태 막대가 있을 때 행을 스크롤백에 저장"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar linhas no histórico de rolagem com barra de status de app"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять строки в историю при наличии строки состояния приложения"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在应用状态栏时将行存储到回滚缓冲区"
          }
        }
      }
    },
    "5319.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen.\"; ObjectID = \"5319\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Vollbildfenster wechseln animiert auf einen eigenen Schreibtisch. Nicht native Vollbildfenster erweitern sich schnell, um den Bildschirm des Fensters auszufüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネイティブフルスクリーンウインドウは、専用のデスクトップへアニメーションして移動します。非ネイティブフルスクリーンウインドウは、すぐにウインドウの画面いっぱいに拡大します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네이티브 전체 화면 윈도우는 애니메이션과 함께 별도의 데스크탑으로 이동합니다. 비네이티브 전체 화면 윈도우는 윈도우가 있는 화면을 채우도록 빠르게 확장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas em tela cheia nativas são animadas para a própria mesa. Janelas em tela cheia não nativas expandem rapidamente para preencher a tela da janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стандартные полноэкранные окна с анимацией разворачиваются на отдельный рабочий стол. Нестандартные полноэкранные окна быстро расширяются, заполняя экран."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生全屏幕窗口会动画进入自己的桌面。非原生全屏幕窗口会快速扩展以填满窗口所在的屏幕。"
          }
        }
      }
    },
