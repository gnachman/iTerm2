      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivat per l’opció “⌘-clic obre nom d’arxiu/URL” a la configuració del punter"
          }
        },
        "cs" : {
          "stringUnit" : {
