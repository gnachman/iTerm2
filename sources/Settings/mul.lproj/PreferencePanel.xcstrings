    "Ids-PU-lco.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"The following tags are recognized: <u>, <i>, and <b>. You can also use &lt; and &amp;.\"; ObjectID = \"Ids-PU-lco\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznávají se tyto značky: <u>, <i> a <b>. Můžete také použít &lt; a &amp;."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følgende tags genkendes: <u>, <i> og <b>. Du kan også bruge &lt; og &amp;."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Tags werden erkannt: <u>, <i> und <b>. Sie können auch &lt; und &amp; verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The following tags are recognized: <u>, <i>, and <b>. You can also use &lt; and &amp;."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reconocen las siguientes etiquetas: <u>, <i> y <b>. También puedes usar &lt; y &amp;."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraavat tunnisteet tunnistetaan: <u>, <i> ja <b>. Voit käyttää myös &lt; ja &amp;."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les balises suivantes sont reconnues : <u>, <i> et <b>. Vous pouvez aussi utiliser &lt; et &amp;."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono riconosciuti i tag seguenti: <u>, <i> e <b>. Puoi usare anche &lt; e &amp;."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のタグが認識されます: <u>、<i>、<b>。&lt;と&amp;も使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식되는 태그는 <u>, <i>, <b>입니다. &lt; 및 &amp;도 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følgende koder gjenkjennes: <u>, <i> og <b>. Du kan også bruke &lt; og &amp;."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volgende tags worden herkend: <u>, <i> en <b>. Je kunt ook &lt; en &amp; gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawane są następujące znaczniki: <u>, <i> i <b>. Możesz też użyć &lt; i &amp;."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As seguintes tags são reconhecidas: <u>, <i> e <b>. Você também pode usar &lt; e &amp;."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознаются следующие теги: <u>, <i> и <b>. Также можно использовать &lt; и &amp;."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznávajú sa tieto značky: <u>, <i> a <b>. Môžete použiť aj &lt; a &amp;."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepoznane so naslednje oznake: <u>, <i> in <b>. Uporabite lahko tudi &lt; in &amp;."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följande taggar känns igen: <u>, <i> och <b>. Du kan också använda &lt; och &amp;."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu etiketler tanınır: <u>, <i> ve <b>. Ayrıca &lt; ve &amp; da kullanabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thẻ sau được nhận dạng: <u>, <i> và <b>. Bạn cũng có thể dùng &lt; và &amp;."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持以下标签：<u>、<i> 和 <b>。你也可以使用 &lt; 和 &amp;。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可辨識下列標籤：<u>、<i> 與 <b>。也可以使用 &lt; 與 &amp;。"
          }
        }
      }
    },
