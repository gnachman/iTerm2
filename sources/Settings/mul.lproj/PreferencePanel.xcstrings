    "ttF-JA-0vc.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped.\"; ObjectID = \"ttF-JA-0vc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, les apps poden fer que aquesta tecla d’opció enviï Esc+ mitjançant DECSET 1036. Tingues en compte que en alguns teclats externs les tecles d’opció esquerra i dreta estan intercanviades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, aplikace mohou způsobit, že tato klávesa Option odešle Esc+ pomocí DECSET 1036. Na některých externích klávesnicích jsou levá a pravá klávesa Option zaměněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, kan apps få denne alternativtast til at sende Esc+ med DECSET 1036. Bemærk, at venstre og højre alternativtast på nogle eksterne tastaturer er byttet om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, können Apps diese Wahltaste veranlassen, mit DECSET 1036 Esc+ zu senden. Beachten Sie, dass bei manchen externen Tastaturen die linke und rechte Wahltaste vertauscht sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, οι εφαρμογές μπορούν να κάνουν αυτό το πλήκτρο Option να στέλνει Esc+ μέσω του DECSET 1036. Σημειώστε ότι σε ορισμένα εξωτερικά πληκτρολόγια τα αριστερά και δεξιά πλήκτρα Option είναι αντεστραμμένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las apps pueden hacer que esta tecla Opción envíe Esc+ mediante DECSET 1036. Ten en cuenta que en algunos teclados externos las teclas Opción izquierda y derecha están intercambiadas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las apps pueden hacer que esta tecla Opción envíe Esc+ mediante DECSET 1036. Ten en cuenta que en algunos teclados externos las teclas Opción izquierda y derecha están intercambiadas."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las apps pueden hacer que esta tecla Opción envíe Esc+ mediante DECSET 1036. Ten en cuenta que en algunos teclados externos las teclas Opción izquierda y derecha están intercambiadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, sovellukset voivat saada tämän optionäppäimen lähettämään Esc+ DECSET 1036:lla. Huomaa, että joissakin ulkoisissa näppäimistöissä vasen ja oikea optionäppäin on vaihdettu keskenään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les apps peuvent faire envoyer Esc+ à cette touche Option avec DECSET 1036. Notez que sur certains claviers externes, les touches Option gauche et droite sont inversées."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les apps peuvent faire envoyer Esc+ à cette touche Option avec DECSET 1036. Notez que sur certains claviers externes, les touches Option gauche et droite sont inversées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, ऐप DECSET 1036 से इस ऑप्शन की को Esc+ भेजने के लिए प्रेरित कर सकते हैं। ध्यान दें कि कुछ बाहरी कीबोर्ड पर बाईं और दाईं ऑप्शन कीज़ आपस में बदली होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je omogućeno, aplikacije mogu uzrokovati da ova tipka Option šalje Esc+ pomoću DECSET 1036. Imajte na umu da su na nekim vanjskim tipkovnicama lijeva i desna tipka Option zamijenjene."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez engedélyezve van, az alkalmazások elérhetik, hogy ez az Option billentyű Esc+ jelet küldjön a DECSET 1036 használatával. Egyes külső billentyűzeteken a bal és a jobb Option billentyű fel van cserélve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, app dapat membuat tombol option ini mengirim Esc+ menggunakan DECSET 1036. Perhatikan bahwa pada beberapa papan ketik eksternal, tombol option kiri dan kanan tertukar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è attiva, le app possono far sì che questo tasto Opzione invii Esc+ tramite DECSET 1036. Nota che su alcune tastiere esterne i tasti Opzione sinistro e destro sono invertiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、アプリはDECSET 1036を使用してこのOptionキーにEsc+を送信させることができます。一部の外部キーボードでは左右のOptionキーが入れ替わっていることに注意してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 앱이 DECSET 1036을 사용하여 이 Option 키가 Esc+를 보내도록 할 수 있습니다. 일부 외장 키보드에서는 왼쪽과 오른쪽 Option 키가 바뀌어 있을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, app boleh menyebabkan kekunci option ini menghantar Esc+ menggunakan DECSET 1036. Perhatikan bahawa pada sesetengah papan kekunci luaran, kekunci option kiri dan kanan ditukar ganti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, kan apper få denne Tilvalg-tasten til å sende Esc+ med DECSET 1036. Merk at på noen eksterne tastaturer er venstre og høyre Tilvalg-tast byttet om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, kunnen apps ervoor zorgen dat deze Option-toets Esc+ verstuurt met DECSET 1036. Op sommige externe toetsenborden zijn de linker en rechter Option-toets verwisseld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, aplikacje mogą sprawić, że ten klawisz Option będzie wysyłał Esc+ za pomocą DECSET 1036. Pamiętaj, że w niektórych zewnętrznych klawiaturach lewy i prawy klawisz Option są zamienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os apps podem fazer esta tecla option enviar Esc+ usando DECSET 1036. Observe que em alguns teclados externos as teclas option esquerda e direita ficam invertidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as aplicações podem fazer com que esta tecla option envie Esc+ através de DECSET 1036. Tenha em atenção que em alguns teclados externos as teclas option esquerda e direita estão trocadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, aplicațiile pot determina această tastă Opțiune să trimită Esc+ folosind DECSET 1036. Rețineți că la unele tastaturi externe tastele Opțiune din stânga și din dreapta sunt inversate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, приложения могут заставить эту клавишу Option отправлять Esc+ с помощью DECSET 1036. Обратите внимание, что на некоторых внешних клавиатурах левая и правая клавиши Option могут быть переставлены местами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, aplikácie môžu pomocou DECSET 1036 spôsobiť, že tento kláves Option odošle Esc+. Upozorňujeme, že na niektorých externých klávesniciach sú ľavý a pravý kláves Option vymenené."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to omogočeno, lahko aplikacije povzročijo, da ta tipka Option pošlje Esc+ prek DECSET 1036. Upoštevajte, da sta na nekaterih zunanjih tipkovnicah leva in desna tipka Option zamenjani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är aktiverat kan appar få den här alternativtangenten att skicka Esc+ med DECSET 1036. Observera att vänster och höger alternativtangent är ombytta på vissa externa tangentbord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ แอปสามารถทำให้ปุ่ม Option นี้ส่ง Esc+ โดยใช้ DECSET 1036 โปรดทราบว่าในแป้นพิมพ์ภายนอกบางรุ่น ปุ่ม Option ซ้ายและขวาสลับกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinken uygulamalar bu Option tuşunun DECSET 1036 ile Esc+ göndermesini sağlayabilir. Bazı harici klavyelerde sol ve sağ Option tuşlarının yer değiştirdiğini unutmayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, програми можуть змусити цю клавішу Option надсилати Esc+ через DECSET 1036. Зауважте, що на деяких зовнішніх клавіатурах ліву й праву клавіші Option поміняно місцями."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, ứng dụng có thể khiến phím Option này gửi Esc+ bằng DECSET 1036. Lưu ý trên một số bàn phím ngoài, phím Option trái và phải bị đổi chỗ."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，App可通过DECSET 1036使此Option键发送Esc+。请注意，在某些外接键盘上，左右Option键是互换的。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，App 可以透過 DECSET 1036 讓此 Option 鍵傳送 Esc+。請注意，某些外接鍵盤上的左右 Option 鍵是對調的。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，应用可以通过 DECSET 1036 让此 Option 键发送 Esc+。请注意，在某些外接键盘上左右 Option 键是互换的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，App 可以透過 DECSET 1036 讓此 Option 鍵傳送 Esc+。請注意，某些外接鍵盤上的左右 Option 鍵是對調的。"
          }
        }
      }
    },
    "TV9-TP-w7T.title" : {
