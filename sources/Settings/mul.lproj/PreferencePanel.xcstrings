    "UGZ-Vx-hCx.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Apps can change right option key\"; ObjectID = \"UGZ-Vx-hCx\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps können die rechte Wahltaste ändern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps can change right option key"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリは右のOptionキーを変更できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 오른쪽 Option 키를 변경할 수 있음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps podem alterar a tecla option direita"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения могут изменять правую клавишу Option"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用可以更改右 Option 键"
          }
        }
      }
    },
    "UGZ-Vx-hCx.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped.\"; ObjectID = \"UGZ-Vx-hCx\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, können Apps diese Wahltaste veranlassen, mit DECSET 1036 Esc+ zu senden. Beachten Sie, dass bei manchen externen Tastaturen die linke und rechte Wahltaste vertauscht sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, apps can cause this option key to send Esc+ using DECSET 1036. Note that on some external keyboards left and right option keys are swapped."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、アプリはDECSET 1036を使用してこのOptionキーにEsc+を送信させることができます。一部の外部キーボードでは左右のOptionキーが入れ替わっていることに注意してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 앱이 DECSET 1036을 사용하여 이 Option 키가 Esc+를 보내도록 할 수 있습니다. 일부 외장 키보드에서는 왼쪽과 오른쪽 Option 키가 바뀌어 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os apps podem fazer esta tecla option enviar Esc+ usando DECSET 1036. Observe que em alguns teclados externos as teclas option esquerda e direita ficam invertidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, приложения могут заставить эту клавишу Option отправлять Esc+ с помощью DECSET 1036. Обратите внимание, что на некоторых внешних клавиатурах левая и правая клавиши Option могут быть переставлены местами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，应用可以通过 DECSET 1036 让此 Option 键发送 Esc+。请注意，在某些外接键盘上左右 Option 键是互换的。"
          }
        }
      }
    },
