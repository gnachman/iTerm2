    "ydH-wX-BJI.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"When pasting a dropped filename, wrap it in double quotes\"; ObjectID = \"ydH-wX-BJI\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při vkládání názvu přetaženého souboru jej uzavřít do dvojitých uvozovek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et droppet arkivnavn indsættes, sættes det i dobbelte anførselstegn"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Einfügen eines abgelegten Dateinamens diesen in doppelte Anführungszeichen setzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When pasting a dropped filename, wrap it in double quotes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pegar el nombre de un archivo soltado, ponerlo entre comillas dobles"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun sijoitetaan pudotetun tiedoston nimi, laita se kaksoislainausmerkkeihin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du collage d’un nom de fichier déposé, l’entourer de guillemets doubles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando incolli il nome di un file rilasciato, racchiudilo tra virgolette doppie"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドロップされたファイル名を貼り付けるときに二重引用符で囲む"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드롭한 파일 이름을 붙여넣을 때 큰따옴표로 감싸기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
