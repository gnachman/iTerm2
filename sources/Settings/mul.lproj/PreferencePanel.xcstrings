    "YoO-mR-uX5.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, terminals are rendered using the GPU. This improves performance.\"; ObjectID = \"YoO-mR-uX5\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Terminals mit der GPU gerendert. Dies verbessert die Leistung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、ターミナルはGPUを使用して描画されます。これによりパフォーマンスが向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 GPU를 사용하여 터미널을 렌더링합니다. 이렇게 하면 성능이 향상됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os terminais são renderizados usando a GPU. Isto melhora o desempenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, терминалы отрисовываются с использованием GPU. Это повышает производительность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，终端使用 GPU 渲染。这可以提高性能。"
          }
        }
      }
    },
