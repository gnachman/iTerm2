    "ZG1-dm-1gD.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu.\"; ObjectID = \"ZG1-dm-1gD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicacions de terminal que utilitzen l’informe del ratolí, en activar això el clic amb el botó dret (o el toc amb dos dits en un trackpad) s’informa a l’app en lloc d’obrir el menú contextual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U terminálových aplikací používajících hlášení myši zapnutí umožní hlásit kliknutí pravým tlačítkem (nebo klepnutí dvěma prsty na trackpadu) místo otevření kontextové nabídky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminalprogrammer, der bruger musrapportering, gør dette det muligt at rapportere højreklik (eller tryk med to fingre på en trackpad) i stedet for at åbne lokalmenuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Terminalanwendungen, die Mausberichte verwenden, ermöglicht diese Option, dass ein Rechtsklick (oder ein Zwei-Finger-Tipp auf einem Trackpad) gemeldet wird, anstatt das Kontextmenü zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για εφαρμογές τερματικού που χρησιμοποιούν αναφορά ποντικιού, η ενεργοποίηση αυτής της επιλογής επιτρέπει την αναφορά του δεξιού κλικ (ή του πατήματος με δύο δάχτυλα σε trackpad) αντί για το άνοιγμα του μενού περιβάλλοντος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows right click (or two finger tap on a trackpad) to be reported instead of opening the context menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicaciones de terminal que usan el informe del ratón, al activar esto el clic derecho (o el toque con dos dedos en un trackpad) se informa a la app en lugar de abrir el menú contextual."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicaciones de terminal que usan el reporte del mouse, al activar esto el clic derecho (o el toque con dos dedos en un trackpad) se informa a la app en lugar de abrir el menú contextual."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicaciones de terminal que usan el reporte del mouse, al activar esto el clic derecho (o el toque con dos dedos en un trackpad) se informa a la app en lugar de abrir el menú contextual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätesovelluksille, jotka käyttävät hiiren raportointia: kun tämä on päällä, klikkaus hiiren oikealla painikkeella (tai kahden sormen napautus ohjauslevyllä) raportoidaan sen sijaan, että kontekstivalikko avautuisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les applications de terminal qui utilisent le signalement de la souris, activer cette option permet de signaler le clic droit (ou le toucher à deux doigts sur un trackpad) au lieu d’ouvrir le menu contextuel."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les applications de terminal qui utilisent le signalement de la souris, activer cette option permet de signaler le clic droit (ou le toucher à deux doigts sur un pavé tactile) au lieu d’ouvrir le menu contextuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माउस रिपोर्टिंग का उपयोग करने वाले टर्मिनल ऐप्लिकेशन के लिए, इसे चालू करने पर राइट-क्लिक (या ट्रैकपैड पर दो उँगलियों से टैप) संदर्भ मेन्यू खोलने के बजाय रिपोर्ट किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za terminalske aplikacije koje koriste izvještavanje o mišu, uključivanjem ovoga desni klik (ili dodir s dva prsta na trackpadu) prijavljuje se aplikaciji umjesto otvaranja kontekstnog izbornika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egérjelentést használó terminálalkalmazásoknál ennek bekapcsolásakor a jobb gombos kattintás (vagy a kétujjas koppintás az érintőpadon) jelentésként az alkalmazásnak kerül átadásra, a helyi menü megnyitása helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk aplikasi terminal yang menggunakan pelaporan tetikus, menyalakan ini memungkinkan klik kanan (atau ketukan dua jari di trackpad) dilaporkan alih-alih membuka menu konteks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per le app da terminale che usano la segnalazione del mouse, attivandolo il clic destro (o il tocco con due dita sul trackpad) viene segnalato invece di aprire il menu contestuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスレポートを使用するターミナルアプリケーションの場合、これをオンにすると、コンテキストメニューを開く代わりに右クリック（またはトラックパッドの2本指タップ）を報告できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅을 사용하는 터미널 앱에서 이 옵션을 켜면 오른쪽 클릭(또는 트랙패드에서 두 손가락 탭) 시 컨텍스트 메뉴를 여는 대신 클릭이 앱에 보고됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagi aplikasi terminal yang menggunakan pelaporan tetikus, menghidupkan ini membolehkan klik kanan (atau ketik dua jari pada trackpad) dilaporkan dan bukannya membuka menu konteks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminalapper som bruker museraportering gjør dette at høyreklikk (eller trykk med to fingre på en styreflate) rapporteres i stedet for å åpne kontekstmenyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor terminalapps die muisrapportage gebruiken: als je dit inschakelt, wordt een rechtsklik (of tik met twee vingers op een trackpad) doorgegeven in plaats van dat het contextmenu opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W aplikacjach terminalowych korzystających z raportowania myszy włączenie tej opcji sprawia, że kliknięcie prawym przyciskiem (lub stuknięcie dwoma palcami na gładziku) jest przekazywane aplikacji zamiast otwierać menu kontekstowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos de terminal que usam relatório de mouse, ativar isto permite que o clique com o botão direito (ou o toque com dois dedos no trackpad) seja relatado em vez de abrir o menu de contexto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicações de terminal que usam comunicação do rato, ativar isto permite que o clique com o botão direito (ou o toque com dois dedos no trackpad) seja comunicado em vez de abrir o menu de contexto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru aplicațiile de terminal care folosesc raportarea mausului, activarea aceasta permite raportarea clicului dreapta (sau a atingerii cu două degete pe un trackpad) în loc de deschiderea meniului contextual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для приложений терминала, использующих отчёты о мыши, включение этого параметра позволяет сообщать о щелчке правой кнопкой (или касании двумя пальцами трекпада) вместо открытия контекстного меню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri terminálových aplikáciách, ktoré používajú hlásenie myši, zapnutie tejto možnosti umožní hlásiť kliknutie pravým tlačidlom (alebo klepnutie dvoma prstami na trackpade) namiesto otvorenia kontextového menu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri terminalskih aplikacijah, ki uporabljajo poročanje miške, vklop te možnosti omogoči, da se desni klik (ali dotik z dvema prstoma na sledilni ploščici) sporoči aplikaciji namesto odprtja kontekstnega menija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För terminalprogram som använder musrapportering gör detta att högerklick (eller tryck med två fingrar på en styrplatta) rapporteras i stället för att kontextmenyn öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับแอปเทอร์มินัลที่ใช้การรายงานเมาส์ การเปิดตัวเลือกนี้จะรายงานการคลิกขวา (หรือการแตะสองนิ้วบนแทร็กแพด) แทนการเปิดเมนูบริบท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare raporlaması kullanan terminal uygulamalarında, bunu açmak sağ tıklamanın (veya izleme dörtgeninde iki parmakla dokunmanın) bağlam menüsünü açmak yerine bildirilmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для термінальних програм, що використовують звітування про мишу, ввімкнення дозволяє передавати програмі клацання правою кнопкою (або дотик двома пальцями на трекпаді) замість відкриття контекстного меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với các ứng dụng terminal dùng báo cáo chuột, bật tùy chọn này cho phép báo cáo bấm chuột phải (hoặc chạm hai ngón trên bàn di chuột) thay vì mở menu ngữ cảnh."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端App，打开此选项后，右键点按（或触控板上的双指轻点）会被报告，而不是打开上下文菜单。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於使用滑鼠報告的終端機 App，開啟此選項後，按一下右鍵（或在觸控式軌跡板上以雙指輕點）會報告給 App，而不是開啟快速選單。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端应用，开启此选项后，右键点按（或触控板双指轻点）会被报告给应用，而不是打开上下文菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於使用滑鼠回報的終端機 App，開啟此選項後，按一下右鍵（或在觸控式軌跡板上以雙指輕點）會回報給 App，而不是打開快速選單。"
          }
        }
      }
    },
