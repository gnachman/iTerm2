    "SsU-mJ-KFc.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You will always be prompted before data is shared.\"; ObjectID = \"SsU-mJ-KFc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre se’t preguntarà abans de compartir dades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před sdílením dat se vždy zobrazí dotaz."
          }
