    "xtn-fq-1gQ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"These settings define the default permissions for new chats.\"; ObjectID = \"xtn-fq-1gQ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato nastavení určují výchozí oprávnění pro nové chaty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse indstillinger definerer standardtilladelserne for nye chats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen legen die Standardberechtigungen für neue Chats fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These settings define the default permissions for new chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos ajustes definen los permisos predeterminados de los chats nuevos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä asetukset määrittävät uusien keskustelujen oletusluvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages définissent les autorisations par défaut des nouveaux chats."
