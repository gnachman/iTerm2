    "6366.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session.\"; ObjectID = \"6366\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrabene Sitzungen erscheinen unter Sitzung > Vergrabene Sitzungen. Wenn diese Einstellung aktiviert ist, werden die Fenstergrößen beim Verbinden mit einer bestehenden tmux-Sitzung wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Buried sessions appear under Session > Buried Sessions. When this setting is enabled, window sizes are restored when attaching to an existing tmux session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋められたセッションは「セッション > 埋められたセッション」に表示されます。この設定を有効にすると、既存のtmuxセッションにアタッチする際にウィンドウサイズが復元されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨둔 세션은 세션 > 숨겨둔 세션 아래에 나타납니다. 이 설정을 켜면 기존 tmux 세션에 연결할 때 윈도우 크기가 복원됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessões ocultas aparecem em Sessão > Sessões ocultas. Quando este ajuste está ativado, os tamanhos das janelas são restaurados ao anexar a uma sessão tmux existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрытые сессии отображаются в меню Сессия > Скрытые сессии. Если этот параметр включён, размеры окон восстанавливаются при подключении к существующей сессии tmux."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏的会话显示在“会话 > 隐藏的会话”下。启用此设置后，附加到现有 tmux 会话时会恢复窗口大小。"
          }
        }
      }
    },
    "6367.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Automatically bury the tmux client session after connecting\"; ObjectID = \"6367\";",
