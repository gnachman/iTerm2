    "fwC-LQ-VKF.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Allow control sequences to enable or disable cursor blink?\"; ObjectID = \"fwC-LQ-VKF\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols permetre que les seqüències de control activin o desactivin el parpelleig del cursor?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit řídicím sekvencím zapínat a vypínat blikání kurzoru?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad, at kontrolsekvenser slår markørens blink til eller fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuersequenzen erlauben, das Blinken des Cursors zu aktivieren oder zu deaktivieren?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να επιτρέπεται στις ακολουθίες ελέγχου να ενεργοποιούν ή να απενεργοποιούν το αναβόσβημα του δρομέα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que las secuencias de control activen o desactiven el parpadeo del cursor?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que las secuencias de control activen o desactiven el parpadeo del cursor?"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que las secuencias de control activen o desactiven el parpadeo del cursor?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallitaanko ohjaussarjojen ottaa kohdistimen vilkkuminen käyttöön tai poistaa se käytöstä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les séquences de contrôle à activer ou désactiver le clignotement du curseur ?"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les séquences de contrôle à activer ou désactiver le clignotement du curseur?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या कंट्रोल सीक्वेंस को कर्सर ब्लिंक चालू या बंद करने की अनुमति दें?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozvoliti kontrolnim sekvencama da omoguće ili onemoguće treptanje kursora?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezi a vezérlőszekvenciáknak a kurzorvillogás be- és kikapcsolását?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan urutan kontrol menyalakan atau mematikan kedipan kursor?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire alle sequenze di controllo di abilitare o disabilitare il lampeggiamento del cursore?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制御シーケンスによるカーソル点滅の有効/無効化を許可しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 시퀀스로 커서 깜빡임을 켜거나 끌 수 있게 하겠습니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan jujukan kawalan mendayakan atau menyahdayakan kelipan kursor?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal kontrollsekvenser kunne slå markørblinking på eller av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogen besturingsreeksen het knipperen van de cursor in- of uitschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy pozwalać sekwencjom sterującym na włączanie lub wyłączanie migania kursora?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que sequências de controle ativem ou desativem o piscar do cursor?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que as sequências de controlo ativem ou desativem o piscar do cursor?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți secvențelor de control să activeze sau să dezactiveze clipirea cursorului?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить управляющим последовательностям включать и выключать мигание курсора?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť riadiacim sekvenciám zapnúť alebo vypnúť blikanie kurzora?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj krmilna zaporedja omogočijo ali onemogočijo utripanje kazalca?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåta att styrsekvenser slår på eller av markörens blinkning?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้ลำดับควบคุมเปิดหรือปิดการกะพริบของเคอร์เซอร์หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim dizileri imlecin yanıp sönmesini etkinleştirip devre dışı bırakabilsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити керівним послідовностям вмикати або вимикати мерехтіння курсора?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép chuỗi điều khiển bật hoặc tắt nhấp nháy con trỏ?"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否允许控制序列启用或停用光标闪烁？"
          }
        },
        "zh-HK" : {
