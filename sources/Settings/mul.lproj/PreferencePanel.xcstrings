    "aev-dz-zJQ.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Use \\\\0 for match, \\\\1…\\\\9 for match groups, \\\\d for directory, \\\\u for user, \\\\h for host.\"; ObjectID = \"aev-dz-zJQ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte \\0 pro shodu, \\1…\\9 pro skupiny shody, \\d pro adresář, \\u pro uživatele, \\h pro hostitele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug \\0 for forekomsten, \\1…\\9 for forekomstgrupper, \\d for mappen, \\u for brugeren og \\h for værten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie \\0 für die Übereinstimmung, \\1…\\9 für Übereinstimmungsgruppen, \\d für Verzeichnis, \\u für Benutzer, \\h für Host."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use \\0 for match, \\1…\\9 for match groups, \\d for directory, \\u for user, \\h for host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa \\0 para la coincidencia, \\1…\\9 para los grupos de coincidencia, \\d para el directorio, \\u para el usuario y \\h para el host."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä \\0 osumalle, \\1…\\9 osumaryhmille, \\d hakemistolle, \\u käyttäjälle ja \\h palvelimelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez \\0 pour la correspondance, \\1…\\9 pour les groupes de correspondance, \\d pour le répertoire, \\u pour l’utilisateur, \\h pour l’hôte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa \\0 per la corrispondenza, \\1…\\9 per i gruppi di corrispondenza, \\d per la directory, \\u per l’utente, \\h per l’host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致には\\0を、一致グループには\\1…\\9を、ディレクトリには\\dを、ユーザーには\\uを、ホストには\\hを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치 항목은 \\0, 일치 그룹은 \\1…\\9, 디렉토리는 \\d, 사용자는 \\u, 호스트는 \\h를 사용하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk \\0 for treff, \\1…\\9 for treffgrupper, \\d for mappe, \\u for bruker og \\h for vert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik \\0 voor de overeenkomst, \\1…\\9 voor overeenkomstgroepen, \\d voor de map, \\u voor de gebruiker en \\h voor de host."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj \\0 dla dopasowania, \\1…\\9 dla grup dopasowania, \\d dla katalogu, \\u dla użytkownika, \\h dla hosta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use \\0 para a correspondência, \\1…\\9 para grupos de correspondência, \\d para o diretório, \\u para o usuário, \\h para o host."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте \\0 для совпадения, \\1…\\9 для групп совпадения, \\d для каталога, \\u для пользователя, \\h для хоста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použite \\0 pre zhodu, \\1…\\9 pre skupiny zhody, \\d pre adresár, \\u pre užívateľa a \\h pre hostiteľa."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabite \\0 za ujemanje, \\1…\\9 za skupine ujemanja, \\d za imenik, \\u za uporabnika in \\h za gostitelja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd \\0 för träffen, \\1…\\9 för träffgrupper, \\d för katalog, \\u för användare och \\h för värd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleşme için \\0, eşleşme grupları için \\1…\\9, dizin için \\d, kullanıcı için \\u, ana makine için \\h kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng \\0 cho kết quả khớp, \\1…\\9 cho các nhóm khớp, \\d cho thư mục, \\u cho người dùng, \\h cho máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 \\0 表示匹配项，\\1…\\9 表示匹配组，\\d 表示目录，\\u 表示用户，\\h 表示主机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 \\0 代表符合項目，\\1…\\9 代表符合群組，\\d 代表目錄，\\u 代表使用者，\\h 代表主機。"
          }
        }
      }
    },
