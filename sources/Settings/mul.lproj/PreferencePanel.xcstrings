    "8RE-RE-YOM.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen.\"; ObjectID = \"8RE-RE-YOM\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan l’ordre que ha produït la sortida és parcialment invisible, aquesta opció mostra l’última línia de l’indicador d’ordres i l’ordre que ha produït la sortida a la part superior de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je příkaz, který vytvořil výstup, částečně neviditelný, tato volba zobrazí v horní části obrazovky poslední řádek výzvy a příkaz, který výstup vytvořil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når kommandoen, der frembragte output, delvist er skjult, viser denne indstilling den sidste linje af prompten og kommandoen, der frembragte outputtet, øverst på skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Befehl, der die Ausgabe erzeugt hat, teilweise unsichtbar ist, zeigt diese Option die letzte Zeile der Eingabeaufforderung und den Befehl, der die Ausgabe erzeugt hat, oben auf dem Bildschirm an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν η εντολή που παρήγαγε έξοδο είναι εν μέρει αόρατη, αυτή η επιλογή εμφανίζει την τελευταία γραμμή της γραμμής προτροπής και την εντολή που παρήγαγε την έξοδο στο πάνω μέρος της οθόνης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el comando que produjo la salida está parcialmente oculto, esta opción muestra la última línea del prompt y el comando que produjo la salida en la parte superior de la pantalla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el comando que produjo la salida está parcialmente oculto, esta opción muestra la última línea del prompt y el comando que produjo la salida en la parte superior de la pantalla."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el comando que produjo la salida está parcialmente oculto, esta opción muestra la última línea del prompt y el comando que produjo la salida en la parte superior de la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun komento, joka tuotti tulosteen, on osittain näkymättömissä, tämä valinta näyttää näytön yläreunassa komentokehotteen viimeisen rivin ja tulosteen tuottaneen komennon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la commande ayant produit la sortie est partiellement invisible, cette option affiche en haut de l’écran la dernière ligne de l’invite et la commande ayant produit la sortie."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la commande ayant produit la sortie est partiellement invisible, cette option affiche en haut de l’écran la dernière ligne de l’invite et la commande ayant produit la sortie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आउटपुट देने वाली कमांड आंशिक रूप से अदृश्य हो, तो यह विकल्प स्क्रीन के शीर्ष पर प्रॉम्प्ट की अंतिम लाइन और आउटपुट देने वाली कमांड दिखाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je naredba koja je proizvela izlaz djelomično nevidljiva, ova opcija prikazuje zadnji redak odzivnika i naredbu koja je proizvela izlaz pri vrhu zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a kimenetet előállító parancs részben nem látható, ez a beállítás a képernyő tetején megjeleníti a prompt utolsó sorát és a kimenetet előállító parancsot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat perintah yang menghasilkan output sebagian tidak terlihat, opsi ini menampilkan baris terakhir prompt dan perintah yang menghasilkan output di bagian atas layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il comando che ha prodotto l’output è parzialmente invisibile, questa opzione mostra l’ultima riga del prompt e il comando che ha prodotto l’output in cima allo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出力を生成したコマンドが部分的に見えない場合、このオプションはプロンプトの最後の行と、出力を生成したコマンドを画面の上部に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출력을 생성한 명령이 일부 보이지 않을 때, 이 옵션은 프롬프트의 마지막 줄과 출력을 생성한 명령을 화면 상단에 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila perintah yang menghasilkan output sebahagiannya tidak kelihatan, pilihan ini menunjukkan baris terakhir gesaan dan perintah yang menghasilkan output di bahagian atas skrin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når kommandoen som ga utdata er delvis usynlig, viser dette alternativet den siste linjen i ledeteksten og kommandoen som ga utdata øverst på skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het commando dat uitvoer heeft geproduceerd gedeeltelijk onzichtbaar is, toont deze optie de laatste regel van de prompt en het commando dat de uitvoer heeft geproduceerd bovenaan het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy polecenie, które wygenerowało dane wyjściowe, jest częściowo niewidoczne, ta opcja pokazuje na górze ekranu ostatni wiersz znaku zachęty i polecenie, które wygenerowało dane wyjściowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o comando que produziu a saída está parcialmente invisível, esta opção mostra a última linha do prompt e o comando que produziu a saída na parte superior da tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o comando que produziu a saída está parcialmente invisível, esta opção mostra a última linha do prompt e o comando que produziu a saída na parte superior do ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când comanda care a produs ieșirea este parțial invizibilă, această opțiune afișează ultima linie a promptului și comanda care a produs ieșirea în partea de sus a ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда команда, создавшая вывод, частично невидима, этот параметр показывает последнюю строку приглашения и команду, создавшую вывод, в верхней части экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je príkaz, ktorý vytvoril výstup, čiastočne neviditeľný, táto možnosť zobrazí v hornej časti obrazovky posledný riadok výzvy a príkaz, ktorý výstup vytvoril."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadar je ukaz, ki je ustvaril izhod, delno nevidno, ta možnost na vrhu zaslona prikaže zadnjo vrstico ukaznega poziva in ukaz, ki je ustvaril izhod."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När kommandot som gav utdata är delvis osynligt visar det här alternativet promptens sista rad och kommandot som gav utdata högst upp på skärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อคำสั่งที่สร้างข้อมูลออกมองเห็นไม่ครบ ตัวเลือกนี้จะแสดงบรรทัดสุดท้ายของพร้อมท์และคำสั่งที่สร้างข้อมูลออกไว้ที่ด้านบนของหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıktıyı üreten komut kısmen görünmez olduğunda, bu seçenek istemin son satırını ve çıktıyı üreten komutu ekranın üstünde gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли команду, що видала вивід, частково не видно, цей параметр показує останній рядок запрошення та команду, що видала вивід, угорі екрана."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi lệnh tạo ra đầu ra bị khuất một phần, tùy chọn này hiển thị dòng cuối của dấu nhắc và lệnh đã tạo ra đầu ra ở đầu màn hình."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当产生输出的命令部分不可见时，此选项会在屏幕顶部显示提示符的最后一行以及产生该输出的命令。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當產生輸出的指令部分不可見時，此選項會在螢幕頂部顯示提示符號的最後一行，以及產生該輸出的指令。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当产生输出的命令部分不可见时，此选项会在屏幕顶部显示提示符的最后一行和产生输出的命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當產生輸出的指令部分不可見時，此選項會在螢幕頂部顯示提示符號的最後一行，以及產生該輸出的指令。"
          }
        }
      }
    },
