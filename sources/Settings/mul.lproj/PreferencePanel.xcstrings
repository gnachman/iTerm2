    "iWk-HJ-EKg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Available for bash, fish, nu, tcsh, xonsh and zsh. This is an alternative to installing shell integration via other methods (such as the iTerm2 > Install Shell Integration menu item).\"; ObjectID = \"iWk-HJ-EKg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K dispozici pro bash, fish, nu, tcsh, xonsh a zsh. Je to alternativa k instalaci integrace shellu jinými způsoby (například položkou nabídky iTerm2 > Nainstalovat integraci shellu)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findes til bash, fish, nu, tcsh, xonsh og zsh. Det er et alternativ til at installere shell-integration på andre måder (f.eks. menupunktet iTerm2 > Installer shell-integration)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbar für bash, fish, nu, tcsh, xonsh und zsh. Dies ist eine Alternative zur Installation der Shell-Integration über andere Methoden (wie den Menüpunkt iTerm2 > Shell-Integration installieren)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Available for bash, fish, nu, tcsh, xonsh and zsh. This is an alternative to installing shell integration via other methods (such as the iTerm2 > Install Shell Integration menu item)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible para bash, fish, nu, tcsh, xonsh y zsh. Es una alternativa a instalar la integración con el shell por otros métodos (como el elemento de menú iTerm2 > Instalar integración con el shell)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatavilla komentotulkeille bash, fish, nu, tcsh, xonsh ja zsh. Tämä on vaihtoehto komentotulkki-integraation asentamiselle muilla tavoilla (kuten valikkokohdalla iTerm2 > Asenna komentotulkki-integraatio)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible pour bash, fish, nu, tcsh, xonsh et zsh. C’est une alternative à l’installation de l’intégration du shell par d’autres méthodes (comme l’élément de menu iTerm2 > Installer l’intégration du shell)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibile per bash, fish, nu, tcsh, xonsh e zsh. È un’alternativa all’installazione dell’integrazione shell con altri metodi (come la voce di menu iTerm2 > Installa integrazione shell)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bash、fish、nu、tcsh、xonsh、zshで利用できます。これは、シェル統合を他の方法(iTerm2 > Install Shell Integrationメニュー項目など)でインストールする場合の代替手段です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bash, fish, nu, tcsh, xonsh 및 zsh에서 사용할 수 있습니다. 다른 방법(예: iTerm2 > 셸 통합 설치 메뉴 항목)으로 셸 통합을 설치하는 대신 사용할 수 있는 방법입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgjengelig for bash, fish, nu, tcsh, xonsh og zsh. Dette er et alternativ til å installere skallintegrering på andre måter (for eksempel menyvalget «iTerm2 > Installer skallintegrering»)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschikbaar voor bash, fish, nu, tcsh, xonsh en zsh. Dit is een alternatief voor het installeren van shell-integratie op andere manieren (zoals het menuonderdeel iTerm2 > Installeer shell-integratie)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępne dla bash, fish, nu, tcsh, xonsh i zsh. Jest to alternatywa dla instalowania integracji z powłoką innymi metodami (np. pozycją menu iTerm2 > Zainstaluj integrację z powłoką)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponível para bash, fish, nu, tcsh, xonsh e zsh. Esta é uma alternativa à instalação da Shell Integration por outros métodos (como o item de menu iTerm2 > Instalar Shell Integration)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступно для bash, fish, nu, tcsh, xonsh и zsh. Это альтернатива установке интеграции с оболочкой другими способами (например, через пункт меню «iTerm2» > «Установить интеграцию с оболочкой»)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupné pre bash, fish, nu, tcsh, xonsh a zsh. Je to alternatíva k inštalácii integrácie shellu inými spôsobmi (napríklad položkou menu iTerm2 > Inštalovať integráciu shellu)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na voljo za bash, fish, nu, tcsh, xonsh in zsh. To je alternativa namestitvi integracije lupine z drugimi metodami (na primer z menijskim elementom iTerm2 > Namesti integracijo lupine)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillgängligt för bash, fish, nu, tcsh, xonsh och zsh. Det här är ett alternativ till att installera skalintegrering på andra sätt (till exempel menyobjektet iTerm2 > Installera skalintegrering)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bash, fish, nu, tcsh, xonsh ve zsh için kullanılabilir. Kabuk entegrasyonunu başka yöntemlerle (iTerm2 > Kabuk Entegrasyonunu Yükle menü öğesi gibi) yüklemeye alternatiftir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có sẵn cho bash, fish, nu, tcsh, xonsh và zsh. Đây là cách thay thế cho việc cài đặt tích hợp shell bằng các phương pháp khác (như mục menu iTerm2 > Cài đặt tích hợp shell)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 bash、fish、nu、tcsh、xonsh 和 zsh。这是通过其他方式（如“iTerm2 > 安装 Shell 集成”菜单项）安装 Shell 集成的替代方法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於 bash、fish、nu、tcsh、xonsh 和 zsh。這是透過其他方式（例如「iTerm2 > 安裝 Shell 整合」選單項目）安裝 Shell 整合的替代方法。"
          }
        }
      }
    },
