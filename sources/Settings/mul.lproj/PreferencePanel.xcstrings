    "Heb-gk-qk8.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"To ensure privacy, the AI features in iTerm2 require the installation of a plugin.\"; ObjectID = \"Heb-gk-qk8\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Privatsphäre zu gewährleisten, erfordern die KI-Funktionen in iTerm2 die Installation eines Plugins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To ensure privacy, the AI features in iTerm2 require the installation of a plugin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーを確保するため、iTerm2のAI機能を使用するにはプラグインのインストールが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 정보 보호를 위해 iTerm2의 AI 기능을 사용하려면 플러그인을 설치해야 합니다."
          }
