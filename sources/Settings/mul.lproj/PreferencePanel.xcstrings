    "9Nh-nh-0mQ.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"…but only if all windows are hotkey windows\"; ObjectID = \"9Nh-nh-0mQ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ale jen pokud jsou všechna okna okny horké klávesy"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…men kun hvis alle vinduer er genvejstastvinduer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… aber nur, wenn alle Fenster Hotkey-Fenster sind"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "…but only if all windows are hotkey windows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…pero solo si todas las ventanas son ventanas de tecla rápida"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mutta vain jos kaikki ikkunat ovat pikanäppäinikkunoita"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mais seulement si toutes les fenêtres sont des fenêtres à raccourci global"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ma solo se tutte le finestre sono finestre ad abbreviazione globale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ただしすべてのウィンドウがホットキーウィンドウの場合のみ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…단, 모든 윈도우가 단축키 윈도우인 경우에만"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…men bare hvis alle vinduer er hurtigtastvinduer"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…maar alleen als alle vensters sneltoetsvensters zijn"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ale tylko jeśli wszystkie okna są oknami klawisza skrótu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mas apenas se todas as janelas forem janelas de hotkey"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…но только если все окна являются окнами горячих клавиш"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ale iba ak sú všetky okná oknami aktivačnej skratky"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… vendar samo, če so vsa okna okna hitre tipke"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…men bara om alla fönster är snabbtangentsfönster"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ancak yalnızca tüm pencereler kısayol tuşu pencereleriyse"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…nhưng chỉ khi tất cả cửa sổ là cửa sổ phím nóng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…但仅当所有窗口都是热键窗口时"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…但僅限所有視窗都是全域快速鍵視窗時"
          }
        }
      }
    },
