    "CRE-cb-4lA.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong.\"; ObjectID = \"CRE-cb-4lA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Sitzung sofort nach dem Start endet und diese Einstellung aktiviert ist, bleibt sie geöffnet, damit Sie sehen können, was schiefgelaufen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが開始直後に終了し、この設定が有効になっている場合、何が問題だったか確認できるように開いたままにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se uma sessão terminar imediatamente após iniciar e este ajuste estiver ativado, mantê-la aberta para que você possa ver o que deu errado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сессия завершается сразу после запуска и этот параметр включён, оставлять её открытой, чтобы вы могли увидеть, что пошло не так."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果会话在启动后立即结束且此设置已启用，则保持其打开，以便你查看出了什么问题。"
          }
        }
      }
    },
