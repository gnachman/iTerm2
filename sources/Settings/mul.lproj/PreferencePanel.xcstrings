    "iuq-9l-xMR.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled the 256-color mode colors (aside from the 16 ANSI colors) will be selected to visually match well with the 8 \\\"normal\\\" ANSI colors. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset.\"; ObjectID = \"iuq-9l-xMR\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, els colors del mode de 256 colors (a part dels 16 colors ANSI) se seleccionaran perquè combinin visualment amb els 8 colors ANSI “normals”. Si no, es fa servir el cub RGB estàndard. Els canvis en aquesta opció tenen efecte en crear sessions noves o en restablir les existents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, barvy 256barevného režimu (kromě 16 barev ANSI) se zvolí tak, aby vizuálně dobře ladily s 8 „normálními“ barvami ANSI. Jinak se použije standardní kostka RGB. Změny tohoto nastavení se projeví při vytvoření nových relací nebo resetování stávajících."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, vælges farverne i 256-farvetilstand (bortset fra de 16 ANSI-farver) så de visuelt passer godt sammen med de 8 “normale” ANSI-farver. Ellers bruges den almindelige RGB-terning. Ændringer af denne indstilling træder i kraft, når der oprettes nye sessioner, eller eksisterende sessioner nulstilles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden die Farben des 256-Farben-Modus (abgesehen von den 16 ANSI-Farben) so ausgewählt, dass sie optisch gut zu den 8 „normalen“ ANSI-Farben passen. Andernfalls wird der Standard-RGB-Würfel verwendet. Änderungen an dieser Einstellung wirken sich beim Erstellen neuer Sitzungen oder beim Zurücksetzen bestehender Sitzungen aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, τα χρώματα της λειτουργίας 256 χρωμάτων (εκτός από τα 16 χρώματα ANSI) επιλέγονται ώστε να ταιριάζουν οπτικά με τα 8 «κανονικά» χρώματα ANSI. Διαφορετικά, χρησιμοποιείται ο τυπικός κύβος RGB. Οι αλλαγές σε αυτή τη ρύθμιση ισχύουν όταν δημιουργούνται νέες συνεδρίες ή επαναφέρονται οι υπάρχουσες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled the 256-color mode colors (aside from the 16 ANSI colors) will be selected to visually match well with the 8 \"normal\" ANSI colors. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled the 256-colour mode colours (aside from the 16 ANSI colours) will be selected to visually match well with the 8 \"normal\" ANSI colours. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled the 256-colour mode colours (aside from the 16 ANSI colours) will be selected to visually match well with the 8 \"normal\" ANSI colours. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled the 256-colour mode colours (aside from the 16 ANSI colours) will be selected to visually match well with the 8 \"normal\" ANSI colours. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled the 256-colour mode colours (aside from the 16 ANSI colours) will be selected to visually match well with the 8 \"normal\" ANSI colours. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled the 256-color mode colors (aside from the 16 ANSI colors) will be selected to visually match well with the 8 \"normal\" ANSI colors. Otherwise, the standard RGB cube is used. Changes to this setting take effect when new sessions are created or existing sessions are reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los colores del modo de 256 colores (aparte de los 16 colores ANSI) se seleccionarán para combinar visualmente con los 8 colores ANSI “normales”. Si no, se usa el cubo RGB estándar. Los cambios en este ajuste surten efecto al crear sesiones nuevas o al restablecer las existentes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los colores del modo de 256 colores (aparte de los 16 colores ANSI) se seleccionarán para combinar visualmente con los 8 colores ANSI “normales”. Si no, se usa el cubo RGB estándar. Los cambios en esta configuración surten efecto al crear sesiones nuevas o al restablecer las existentes."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los colores del modo de 256 colores (aparte de los 16 colores ANSI) se seleccionarán para combinar visualmente con los 8 colores ANSI “normales”. Si no, se usa el cubo RGB estándar. Los cambios en esta configuración surten efecto al crear sesiones nuevas o al restablecer las existentes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, 256 värin tilan värit (16 ANSI-väriä lukuun ottamatta) valitaan niin, että ne sopivat visuaalisesti yhteen 8 ”normaalin” ANSI-värin kanssa. Muuten käytetään tavallista RGB-kuutiota. Tämän asetuksen muutokset tulevat voimaan, kun luodaan uusia istuntoja tai nollataan olemassa olevia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les couleurs du mode 256 couleurs (hors les 16 couleurs ANSI) sont choisies pour s’accorder visuellement avec les 8 couleurs ANSI « normales ». Sinon, le cube RVB standard est utilisé. Les modifications de ce réglage prennent effet à la création de nouvelles sessions ou à la réinitialisation des sessions existantes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les couleurs du mode 256 couleurs (hors les 16 couleurs ANSI) sont choisies pour s’accorder visuellement avec les 8 couleurs ANSI « normales ». Sinon, le cube RVB standard est utilisé. Les modifications de ce réglage prennent effet à la création de nouvelles sessions ou à la réinitialisation des sessions existantes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, 256-रंग मोड के रंग (16 ANSI रंगों को छोड़कर) 8 “सामान्य” ANSI रंगों से दिखने में अच्छी तरह मेल खाने के लिए चुने जाएँगे। अन्यथा, मानक RGB क्यूब उपयोग होता है। इस सेटिंग में बदलाव नए सत्र बनाने या मौजूदा सत्र रीसेट करने पर प्रभावी होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je omogućeno, boje načina rada s 256 boja (osim 16 ANSI boja) birat će se tako da se vizualno dobro slažu s 8 “normalnih” ANSI boja. Inače se koristi standardna RGB kocka. Promjene ove postavke stupaju na snagu kada se stvore nove sesije ili resetiraju postojeće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez engedélyezve van, a 256 színes mód színei (a 16 ANSI-színen kívül) úgy lesznek kiválasztva, hogy vizuálisan jól illeszkedjenek a 8 „normál” ANSI-színhez. Ellenkező esetben a szabványos RGB-kocka van használatban. A beállítás módosításai új munkamenetek létrehozásakor vagy meglévők alaphelyzetbe állításakor lépnek érvénybe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, warna mode 256 warna (selain 16 warna ANSI) akan dipilih agar serasi secara visual dengan 8 warna ANSI “normal”. Jika tidak, kubus RGB standar yang digunakan. Perubahan pengaturan ini berlaku saat sesi baru dibuat atau sesi yang ada diatur ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è attiva, i colori della modalità a 256 colori (esclusi i 16 colori ANSI) vengono scelti in modo da armonizzarsi visivamente con gli 8 colori ANSI “normali”. In caso contrario viene usato il cubo RGB standard. Le modifiche a questa impostazione hanno effetto quando vengono create nuove sessioni o reimpostate quelle esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、256色モードの色(16のANSIカラーを除く)は、8つの「通常」ANSIカラーと視覚的に調和するように選択されます。無効の場合は、標準のRGBキューブが使用されます。この設定の変更は、新しいセッションが作成されたとき、または既存のセッションがリセットされたときに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 256색 모드 색상(16개 ANSI 색상 제외)이 8개의 \"일반\" ANSI 색상과 시각적으로 잘 어울리도록 선택됩니다. 그렇지 않으면 표준 RGB 큐브가 사용됩니다. 이 설정의 변경 사항은 새로운 세션을 만들거나 기존 세션을 재설정할 때 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, warna mod 256 warna (selain 16 warna ANSI) akan dipilih supaya sepadan dengan baik secara visual dengan 8 warna ANSI “biasa”. Jika tidak, kubus RGB standard digunakan. Perubahan pada seting ini berkuat kuasa apabila sesi baharu dibuat atau sesi sedia ada di-reset."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, velges fargene i 256-fargemodus (bortsett fra de 16 ANSI-fargene) slik at de passer visuelt godt til de 8 «normale» ANSI-fargene. Ellers brukes standard RGB-kube. Endringer i denne innstillingen trer i kraft når nye økter opprettes eller eksisterende økter nullstilles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, worden de kleuren van de 256-kleurenmodus (behalve de 16 ANSI-kleuren) zo gekozen dat ze er visueel goed bij passen naast de 8 ‘normale’ ANSI-kleuren. Anders wordt de standaard RGB-kubus gebruikt. Wijzigingen in deze instelling worden van kracht wanneer nieuwe sessies worden gemaakt of bestaande sessies opnieuw worden ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, kolory trybu 256 kolorów (poza 16 kolorami ANSI) są dobierane tak, aby wizualnie dobrze pasowały do 8 „normalnych” kolorów ANSI. W przeciwnym razie używana jest standardowa kostka RGB. Zmiany tego ustawienia zaczynają działać po utworzeniu nowych sesji lub zresetowaniu istniejących."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as cores do modo de 256 cores (além das 16 cores ANSI) serão selecionadas para combinar visualmente bem com as 8 cores ANSI “normais”. Caso contrário, é usado o cubo RGB padrão. As alterações neste ajuste entram em vigor quando novas sessões são criadas ou sessões existentes são redefinidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as cores do modo de 256 cores (além das 16 cores ANSI) serão selecionadas para combinar visualmente bem com as 8 cores ANSI “normais”. Caso contrário, é usado o cubo RGB predefinido. As alterações a esta definição entram em vigor quando são criadas novas sessões ou quando as sessões existentes são repostas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, culorile modului de 256 de culori (în afară de cele 16 culori ANSI) sunt alese astfel încât să se potrivească vizual cu cele 8 culori ANSI „normale”. În caz contrar, se folosește cubul RGB standard. Modificările acestei configurări au efect când se creează sesiuni noi sau când sesiunile existente sunt resetate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, цвета режима 256 цветов (кроме 16 цветов ANSI) будут подобраны так, чтобы визуально сочетаться с 8 «обычными» цветами ANSI. В противном случае используется стандартный RGB-куб. Изменения этой настройки вступают в силу при создании новых сессий или сбросе существующих."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, farby v 256-farebnom režime (okrem 16 farieb ANSI) sa vyberú tak, aby vizuálne dobre zodpovedali 8 „normálnym“ farbám ANSI. Inak sa použije štandardná kocka RGB. Zmeny tohto nastavenia sa prejavia pri vytvorení nových relácií alebo resetovaní existujúcich."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to omogočeno, bodo barve 256-barvnega načina (poleg 16 barv ANSI) izbrane tako, da se vizualno dobro ujemajo z 8 »običajnimi« barvami ANSI. Sicer se uporabi standardna kocka RGB. Spremembe te nastavitve začnejo veljati ob ustvarjanju novih sej ali ponastavitvi obstoječih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är aktiverat väljs färgerna i 256-färgsläget (förutom de 16 ANSI-färgerna) så att de visuellt passar väl ihop med de 8 ”normala” ANSI-färgerna. Annars används den vanliga RGB-kuben. Ändringar av den här inställningen börjar gälla när nya sessioner skapas eller befintliga sessioner nollställs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ สีในโหมด 256 สี (นอกเหนือจากสี ANSI 16 สี) จะถูกเลือกให้เข้ากับสี ANSI “ปกติ” 8 สีได้ดี มิฉะนั้นจะใช้ลูกบาศก์ RGB มาตรฐาน การเปลี่ยนแปลงการตั้งค่านี้จะมีผลเมื่อสร้างเซสชั่นใหม่หรือรีเซ็ตเซสชั่นที่มีอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinken 256 renk modundaki renkler (16 ANSI rengi hariç), 8 “normal” ANSI rengiyle görsel olarak iyi uyuşacak şekilde seçilir. Aksi halde standart RGB küpü kullanılır. Bu ayardaki değişiklikler yeni oturumlar oluşturulduğunda veya mevcut oturumlar sıfırlandığında etkili olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, кольори 256-кольорового режиму (окрім 16 кольорів ANSI) добираються так, щоб візуально гармоніювати з 8 «звичайними» кольорами ANSI. Інакше використовується стандартний куб RGB. Зміни цього параметра діють, коли створюються нові сеанси або наявні скидаються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các màu của chế độ 256 màu (ngoài 16 màu ANSI) sẽ được chọn để hài hòa về thị giác với 8 màu ANSI “thường”. Nếu không, khối RGB chuẩn sẽ được dùng. Thay đổi cài đặt này có hiệu lực khi tạo phiên mới hoặc đặt lại phiên hiện có."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，256色模式的颜色（16种ANSI颜色除外）将被选为在视觉上与8种“普通”ANSI颜色相匹配。否则，使用标准RGB立方体。对此设置的更改会在创建新会话或还原现有会话时生效。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，256 色模式的顏色（16 種 ANSI 顏色除外）會選擇與 8 種「一般」ANSI 顏色在視覺上相配的顏色。否則使用標準 RGB 立方體。此設定的變更會在建立新工作階段或重設現有工作階段時生效。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，256 色模式的颜色（16 种 ANSI 颜色之外）将被选择为与 8 种“标准”ANSI 颜色视觉上匹配。否则使用标准 RGB 立方体。此设置的更改在创建新会话或重置现有会话时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，256 色模式的顏色（16 種 ANSI 顏色除外）會選擇與 8 種「一般」ANSI 顏色在視覺上相配的顏色。否則使用標準 RGB 立方體。此設定的變更會在建立新工作階段或重置現有工作階段時生效。"
          }
        }
      }
    },
