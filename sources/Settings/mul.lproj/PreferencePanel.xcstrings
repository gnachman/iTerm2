    "ehw-7A-A75.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing.\"; ObjectID = \"ehw-7A-A75\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir aquest botó per localitzar manualment el connector del navegador. Si no es troba automàticament, o si hi ha algun problema amb el connector que impedeix que la identificació automàtica funcioni, fes-lo servir per solucionar el problema o saber per què falla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto tlačítkem lze ručně vyhledat plug-in prohlížeče. Pokud jej nelze najít automaticky nebo pokud je s plug-inem něco v nepořádku a automatická identifikace nefunguje, použijte je k opravě problému nebo ke zjištění, proč selhává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug denne knap til manuelt at finde browserpluginet. Hvis det ikke kan findes automatisk, eller hvis der er noget galt med pluginet, så automatisk identifikation ikke virker, kan du bruge den til at løse problemet eller finde ud af, hvorfor det mislykkes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie diese Schaltfläche, um das Browser-Plugin manuell zu suchen. Falls es nicht automatisch gefunden werden kann oder ein Problem mit dem Plugin die automatische Erkennung verhindert, können Sie damit das Problem beheben oder herausfinden, warum es fehlschlägt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε αυτό το κουμπί για να εντοπίσετε χειροκίνητα την προσθήκη του προγράμματος περιήγησης. Αν δεν μπορεί να βρεθεί αυτόματα, ή αν κάποιο πρόβλημα στην προσθήκη εμποδίζει την αυτόματη αναγνώριση, χρησιμοποιήστε το για να διορθώσετε το πρόβλημα ή να μάθετε γιατί αποτυγχάνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this button to manually locate the browser plugin. If it can’t be found automatically, or if something is wrong with the plugin that prevents automatic identification from working, use this to fix the problem or learn why it is failing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este botón para localizar manualmente el plugin del navegador. Si no se encuentra automáticamente, o si algo falla en el plugin e impide que funcione la identificación automática, úsalo para solucionar el problema o saber por qué falla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este botón para localizar manualmente el plugin del navegador. Si no se encuentra automáticamente, o si algo falla en el plugin e impide que funcione la identificación automática, úsalo para solucionar el problema o saber por qué falla."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa este botón para localizar manualmente el plugin del navegador. Si no se encuentra automáticamente, o si algo falla en el plugin e impide que funcione la identificación automática, úsalo para solucionar el problema o saber por qué falla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tätä painiketta selaimen liitännäisen paikantamiseen käsin. Jos sitä ei löydy automaattisesti tai jokin liitännäisessä estää automaattisen tunnistuksen toiminnan, korjaa ongelma tai selvitä sen syy tämän avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce bouton pour localiser manuellement le module du navigateur. S’il est introuvable automatiquement, ou si un problème du module empêche l’identification automatique, utilisez-le pour résoudre le problème ou en comprendre la cause."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce bouton pour localiser manuellement le module du navigateur. S’il est introuvable automatiquement, ou si un problème du module empêche l’identification automatique, utilisez-le pour résoudre le problème ou en comprendre la cause."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़र प्लग-इन को मैन्युअली ढूँढने के लिए इस बटन का उपयोग करें। अगर वह अपने आप नहीं मिलता, या प्लग-इन में कोई गड़बड़ी है जिससे स्वचालित पहचान काम नहीं करती, तो समस्या ठीक करने या विफलता का कारण जानने के लिए इसका उपयोग करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomoću ovog gumba ručno pronađite plugin preglednika. Ako se ne može pronaći automatski ili ako nešto nije u redu s pluginom pa automatsko prepoznavanje ne radi, upotrijebite ga da riješite problem ili saznate zašto ne uspijeva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel a gombbal manuálisan megkeresheti a böngészőplugint. Ha automatikusan nem található, vagy ha a plugin hibája miatt az automatikus azonosítás nem működik, ezzel megoldhatja a problémát, vagy megtudhatja a hiba okát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan tombol ini untuk menemukan plugin browser secara manual. Jika tidak dapat ditemukan secara otomatis, atau jika ada masalah pada plugin yang mencegah identifikasi otomatis berfungsi, gunakan ini untuk memperbaiki masalah atau mengetahui penyebab kegagalannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa questo pulsante per individuare manualmente il plug-in del browser. Se non viene trovato automaticamente, o se un problema del plug-in impedisce l’identificazione automatica, usalo per risolvere il problema o scoprire perché non funziona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボタンを使うと、ブラウザプラグインの場所を手動で指定できます。自動的に見つからない場合や、プラグインに問題があり自動認識が機能しない場合は、これを使って問題を解決するか、失敗の原因を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버튼을 사용하여 브라우저 플러그인의 위치를 직접 찾을 수 있습니다. 플러그인을 자동으로 찾을 수 없거나 플러그인에 문제가 있어 자동 식별이 작동하지 않는 경우, 이 버튼으로 문제를 해결하거나 실패 원인을 알아볼 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan butang ini untuk mengesan pemalam pelayar secara manual. Jika ia tidak dapat ditemui secara automatik, atau jika ada masalah pada pemalam yang menghalang pengenalpastian automatik berfungsi, gunakan ini untuk membetulkan masalah atau mengetahui sebab ia gagal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk denne knappen til å finne nettlesertillegget manuelt. Hvis det ikke blir funnet automatisk, eller hvis noe er galt med tillegget slik at automatisk gjenkjenning ikke fungerer, kan du bruke dette til å løse problemet eller finne ut hvorfor det mislykkes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik deze knop om de browserplug-in handmatig te zoeken. Als deze niet automatisch kan worden gevonden, of als er iets mis is met de plug-in waardoor automatische herkenning niet werkt, kun je hiermee het probleem oplossen of zien waarom het misgaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj tego przycisku, aby ręcznie wskazać wtyczkę przeglądarki. Jeśli nie można jej znaleźć automatycznie lub jeśli coś jest nie tak z wtyczką i uniemożliwia automatyczne rozpoznanie, użyj go, aby naprawić problem lub dowiedzieć się, dlaczego nie działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este botão para localizar manualmente o plugin do navegador. Se ele não puder ser encontrado automaticamente, ou se algo estiver errado com o plugin que impeça o funcionamento da identificação automática, use isto para corrigir o problema ou descobrir por que está falhando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use este botão para localizar manualmente o plugin do navegador. Se não puder ser encontrado automaticamente, ou se algo estiver errado com o plugin que impeça o funcionamento da identificação automática, use isto para corrigir o problema ou descobrir porque está a falhar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți acest buton pentru a localiza manual plug-inul de browser. Dacă nu poate fi găsit automat sau dacă ceva este în neregulă cu plug-inul și împiedică identificarea automată, folosiți-l pentru a remedia problema sau pentru a afla de ce eșuează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте эту кнопку, чтобы вручную указать расположение плагина браузера. Если он не может быть найден автоматически или что-то не так с плагином, мешающее автоматическому определению, используйте это, чтобы устранить проблему или узнать причину сбоя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týmto tlačidlom ručne vyhľadáte plugin prehliadača. Ak sa nenájde automaticky alebo ak s pluginom nie je niečo v poriadku a bráni to automatickej identifikácii, použite ho na odstránenie problému alebo zistenie, prečo zlyháva."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem gumbom ročno poiščete vtičnik brskalnika. Če ga ni mogoče najti samodejno ali če je z vtičnikom nekaj narobe in samodejna prepoznava ne deluje, ga uporabite za odpravo težave ali ugotovitev vzroka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd den här knappen för att leta upp webbläsarpluginet manuellt. Om det inte hittas automatiskt, eller om något är fel med pluginet så att automatisk identifiering inte fungerar, kan du använda den för att åtgärda problemet eller ta reda på varför det misslyckas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ปุ่มนี้เพื่อระบุตำแหน่งปลั๊กอินของเบราว์เซอร์ด้วยตนเอง หากหาไม่พบโดยอัตโนมัติ หรือหากปลั๊กอินมีปัญหาจนการระบุอัตโนมัติใช้ไม่ได้ ให้ใช้ปุ่มนี้เพื่อแก้ไขปัญหาหรือดูสาเหตุที่ไม่สำเร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarayıcı eklentisini elle bulmak için bu düğmeyi kullanın. Otomatik olarak bulunamıyorsa veya eklentideki bir sorun otomatik tanımayı engelliyorsa, sorunu gidermek ya da nedenini öğrenmek için bunu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скористайтеся цією кнопкою, щоб вручну знайти плагін браузера. Якщо його не вдається знайти автоматично або якщо з плагіном щось не так і це заважає автоматичному визначенню, скористайтеся нею, щоб усунути проблему або дізнатися причину збою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng nút này để tự định vị trình cắm của trình duyệt. Nếu không thể tìm thấy tự động, hoặc nếu trình cắm có lỗi khiến việc nhận dạng tự động không hoạt động, hãy dùng nút này để khắc phục sự cố hoặc tìm hiểu nguyên nhân."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按钮手动定位浏览器插件。如果无法自动找到，或者插件存在问题导致无法自动识别，可用它来修复问题或了解失败原因。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按鈕手動尋找瀏覽器外掛程式。如果無法自動找到，或外掛程式有問題導致無法自動識別，請使用此功能修正問題或了解失敗原因。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按钮手动定位浏览器插件。如果无法自动找到它，或插件出现问题导致无法自动识别，请使用此选项修复问题或了解失败原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此按鈕手動尋找瀏覽器外掛程式。如果無法自動找到，或外掛程式有問題導致無法自動辨識，請使用此功能修正問題或了解失敗原因。"
          }
        }
      }
    },
    "eid-kp-DfH.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth.\"; ObjectID = \"eid-kp-DfH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els cursors de subratllat i de barra vertical poden projectar una ombra suau sobre el caràcter que hi ha sota el cursor, donant-li sensació de profunditat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzory ve tvaru podtržítka a svislé čáry mohou vrhat jemný stín na znak pod kurzorem, což vytváří dojem hloubky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markører som understregning og lodret streg kan kaste en blød skygge på tegnet under markøren, så det får en fornemmelse af dybde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstrich- und vertikale Balken-Cursor können einen weichen Schlagschatten auf das Zeichen unter dem Cursor werfen, was ihm einen Eindruck von Tiefe verleiht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δρομείς υπογράμμισης και κάθετης γραμμής μπορούν να ρίχνουν απαλή σκιά στον χαρακτήρα κάτω από τον δρομέα, δίνοντάς του αίσθηση βάθους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underline and vertical bar cursors can cast a soft drop shadow onto the character beneath the cursor, giving it a sense of depth."
          }
        },
        "en-IN" : {
