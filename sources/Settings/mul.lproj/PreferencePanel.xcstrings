    "2qz-zW-laA.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When checked, removes items from the list whose value equals the default value.\"; ObjectID = \"2qz-zW-laA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està marcat, elimina de la llista els ítems amb un valor igual al valor per omissió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je volba zaškrtnutá, odebere ze seznamu položky, jejichž hodnota se rovná výchozí hodnotě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er markeret, fjernes emner fra listen, hvis værdi er lig med standardværdien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Einträge aus der Liste entfernt, deren Wert dem Standardwert entspricht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι επιλεγμένο, αφαιρεί από τη λίστα τα στοιχεία των οποίων η τιμή ισούται με την προεπιλεγμένη τιμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When checked, removes items from the list whose value equals the default value."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When ticked, removes items from the list whose value equals the default value."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When checked, removes items from the list whose value equals the default value."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When ticked, removes items from the list whose value equals the default value."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When ticked, removes items from the list whose value equals the default value."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When checked, removes items from the list whose value equals the default value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está marcado, elimina de la lista los ítems cuyo valor es igual al valor predeterminado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está marcado, elimina de la lista los elementos cuyo valor es igual al valor predeterminado."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está marcado, elimina de la lista los elementos cuyo valor es igual al valor predeterminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun valittuna, poistaa luettelosta kohteet, joiden arvo on sama kuin oletusarvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est cochée, supprime de la liste les éléments dont la valeur est égale à la valeur par défaut."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est cochée, supprime de la liste les éléments dont la valeur est égale à la valeur par défaut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुने होने पर, सूची से वे आइटम हटा देता है जिनका मान डिफ़ॉल्ट मान के बराबर है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je označeno, iz popisa se uklanjaju stavke čija je vrijednost jednaka standardnoj vrijednosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha be van jelölve, eltávolítja a listából azokat az elemeket, amelyek értéke megegyezik az alapértelmezett értékkel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika dicentang, item yang nilainya sama dengan nilai default dihapus dari daftar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se selezionata, rimuove dall’elenco gli elementi il cui valore è uguale a quello predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックすると、値がデフォルト値と等しい項目をリストから削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택하면 값이 기본값과 같은 항목을 목록에서 제거합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila ditandakan, mengeluarkan item daripada senarai yang nilainya sama dengan nilai lalai."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er valgt, fjernes objekter fra listen der verdien er lik standardverdien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is aangevinkt, worden onderdelen uit de lijst verwijderd waarvan de waarde gelijk is aan de standaardwaarde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zaznaczone, usuwa z listy elementy, których wartość jest równa wartości domyślnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando marcado, remove da lista os itens cujo valor é igual ao valor padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando marcado, remove da lista os itens cujo valor é igual ao valor predefinido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este bifat, elimină din listă articolele a căror valoare este egală cu valoarea implicită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, из списка удаляются элементы, значение которых совпадает со значением по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zaškrtnuté, odstráni zo zoznamu položky, ktorých hodnota sa rovná predvolenej hodnote."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je označeno, s seznama odstrani elemente, katerih vrednost je enaka privzeti vrednosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är markerat tas objekt vars värde är lika med förvalet bort från listan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเลือก จะเอารายการที่มีค่าเท่ากับค่าเริ่มต้นออกจากรายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretliyse, değeri varsayılan değere eşit olan öğeleri listeden kaldırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо позначено, вилучає зі списку елементи, значення яких дорівнює типовому."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chọn, xóa khỏi danh sách các mục có giá trị bằng giá trị mặc định."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选后，会从列表中移除值等于默认值的项目。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選後，會從列表中移除值等於預設值的項目。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中后，会从列表中移除值等于默认值的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選後，會從列表中移除值等於預設值的項目。"
          }
        }
      }
    },
