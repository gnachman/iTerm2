    "Ids-PU-lco.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"The following tags are recognized: <u>, <i>, and <b>. You can also use &lt; and &amp;.\"; ObjectID = \"Ids-PU-lco\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Tags werden erkannt: <u>, <i> und <b>. Sie können auch &lt; und &amp; verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The following tags are recognized: <u>, <i>, and <b>. You can also use &lt; and &amp;."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のタグが認識されます: <u>、<i>、<b>。&lt;と&amp;も使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식되는 태그는 <u>, <i>, <b>입니다. &lt; 및 &amp;도 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As seguintes tags são reconhecidas: <u>, <i> e <b>. Você também pode usar &lt; e &amp;."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознаются следующие теги: <u>, <i> и <b>. Также можно использовать &lt; и &amp;."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持以下标签：<u>、<i> 和 <b>。你也可以使用 &lt; 和 &amp;。"
          }
        }
      }
    },
