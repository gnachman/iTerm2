        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vylúčiť z Docku, iba ak sú všetky okná okná aktivačnej skratky"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izključi iz vrstice Dock samo, če so vsa okna okna hitre tipke"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utesluta från Dock bara om alla fönster är snabbtangentsfönster"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่แสดงใน Dock เฉพาะเมื่อทุกหน้าต่างเป็นหน้าต่างปุ่มลัดด่วน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca tüm pencereler kısayol tuşu penceresiyse Dock’tan hariç tut"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виключити з Dock, лише якщо всі вікна є вікнами гарячої клавіші"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ loại khỏi Dock nếu mọi cửa sổ đều là cửa sổ phím nóng"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当所有窗口都是热键窗口时才从程序坞中排除"
