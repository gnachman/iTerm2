    "XaQ-Gu-7BD.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This build is in the nightly build channel. It cannot update to beta or release builds.\"; ObjectID = \"XaQ-Gu-7BD\";",
