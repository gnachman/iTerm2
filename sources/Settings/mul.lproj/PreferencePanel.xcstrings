    "4Ha-Ub-4AS.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it.\"; ObjectID = \"4Ha-Ub-4AS\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enganxament delimitat indica a les apps compatibles que el text s’ha inserit mitjançant una operació d’enganxament i no escrivint-lo. Alguns programes ho utilitzen per tractar els enganxaments de manera especial, per exemple, sense aplicar sagnat automàtic."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vkládání v závorkách (bracketed paste) sděluje kompatibilním aplikacím, že text byl vložen operací vložení, a ne napsán. Některé programy toho využívají ke zvláštnímu zacházení s vloženým textem, například k vypnutí automatického odsazování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupperet indsætning fortæller kompatible apps, at tekst blev indsat med en indsætning i stedet for at blive skrevet. Nogle programmer bruger dette til at behandle indsætninger særligt, f.eks. ved ikke at indrykke automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bracketed Paste teilt kompatiblen Anwendungen mit, dass Text durch einen Einfügevorgang und nicht durch Tippen eingegeben wurde. Manche Programme behandeln eingefügten Text dadurch besonders, zum Beispiel indem sie die automatische Einrückung dafür deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η παρενθετική επικόλληση ενημερώνει τις συμβατές εφαρμογές ότι το κείμενο εισήχθη με επικόλληση και όχι με πληκτρολόγηση. Ορισμένα προγράμματα το χρησιμοποιούν για ειδικό χειρισμό των επικολλήσεων, π.χ. χωρίς αυτόματη εσοχή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pegado entre delimitadores indica a las apps compatibles que el texto se insertó mediante una operación de pegado y no escribiéndolo. Algunos programas lo usan para tratar los pegados de forma especial, por ejemplo, sin aplicar sangría automática."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pegado entre delimitadores indica a las apps compatibles que el texto se insertó mediante una operación de pegado y no escribiéndolo. Algunos programas lo usan para tratar los pegados de forma especial, por ejemplo, sin aplicar sangría automática."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pegado entre delimitadores indica a las apps compatibles que el texto se insertó mediante una operación de pegado y no escribiéndolo. Algunos programas lo usan para tratar los pegados de forma especial, por ejemplo, sin aplicar sangría automática."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulkeistettu sijoitus kertoo yhteensopiville sovelluksille, että teksti lisättiin sijoittamalla eikä kirjoittamalla. Jotkin ohjelmat käsittelevät sijoitukset tämän perusteella erikoisesti, esimerkiksi jättämällä sisennyksen automaattisesti tekemättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage délimité indique aux apps compatibles que le texte a été inséré par un collage et non saisi au clavier. Certains programmes s’en servent pour traiter les collages différemment, par exemple en n’appliquant pas l’indentation automatique."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage délimité indique aux apps compatibles que le texte a été inséré par un collage et non saisi au clavier. Certains programmes s’en servent pour traiter les collages différemment, par exemple en n’appliquant pas l’indentation automatique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रैकेटेड पेस्ट संगत ऐप को बताता है कि टेक्स्ट टाइप करके नहीं, बल्कि पेस्ट करके डाला गया है। कुछ प्रोग्राम इसका उपयोग पेस्ट को अलग तरह से संभालने के लिए करते हैं, जैसे उसे ऑटो-इंडेंट न करना।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijepljenje u zagradama kompatibilnim aplikacijama govori da je tekst umetnut lijepljenjem, a ne tipkanjem. Neki programi to koriste za posebno postupanje s lijepljenjem, na primjer da ga ne uvlače automatski."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A zárójeles beillesztés jelzi a kompatibilis alkalmazásoknak, hogy a szöveget beillesztés útján szúrták be, nem pedig gépeléssel. Néhány program ezt arra használja, hogy a beillesztést másképp kezelje, például nem húzza be automatikusan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel berkurung memberi tahu app yang kompatibel bahwa teks dimasukkan melalui operasi tempel, bukan diketik. Beberapa program menggunakannya untuk memperlakukan tempelan secara khusus, misalnya tidak membuat indentasi otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’incolla delimitato indica alle app compatibili che il testo è stato inserito con un’operazione di incolla e non digitandolo. Alcuni programmi lo usano per trattare l’incolla in modo speciale, ad esempio senza applicare il rientro automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストブラケッティングは、テキストがタイピングではなくペースト操作によって挿入されたことを対応アプリに伝えます。一部のプログラムはこれを利用して、自動インデントを行わないなどペーストを特別に扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브래킷 붙여넣기는 텍스트가 타이핑이 아니라 붙여넣기로 입력되었음을 호환 앱에 알려 줍니다. 일부 프로그램은 이를 이용해 붙여넣은 텍스트를 자동 들여쓰기하지 않는 등 특별하게 처리합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampal berkurungan memberitahu app yang serasi bahawa teks dimasukkan melalui operasi tampal dan bukan ditaip. Sesetengah program menggunakannya untuk melayan tampalan secara khas, seperti tidak mengindenkan secara automatik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgrenset innliming forteller kompatible apper at teksten ble satt inn ved innliming og ikke ved skriving. Noen programmer bruker dette til å behandle innliminger spesielt, for eksempel ved å ikke rykke inn automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geaccoladeerd plakken (bracketed paste) laat compatibele apps weten dat tekst is ingevoegd door te plakken en niet door te typen. Sommige programma’s behandelen geplakte tekst daardoor anders, bijvoorbeeld door niet automatisch in te springen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklejanie w nawiasach informuje zgodne aplikacje, że tekst został wstawiony przez wklejenie, a nie wpisany. Niektóre programy używają tego do specjalnego traktowania wklejanego tekstu, na przykład nie stosują automatycznych wcięć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bracketing de colagem informa aos apps compatíveis que o texto foi inserido por uma operação de colagem em vez de digitação. Alguns programas usam isto para tratar colagens de forma especial, por exemplo, não as indentando automaticamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bracketing de colagem informa as aplicações compatíveis de que o texto foi inserido por uma operação de colagem em vez de digitação. Alguns programas usam isto para tratar colagens de forma especial, por exemplo, não as indentando automaticamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lipirea delimitată indică aplicațiilor compatibile că textul a fost inserat printr-o operațiune de lipire, nu prin tastare. Unele programe folosesc aceasta pentru a trata lipirile în mod special, de exemplu fără indentare automată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скобочная вставка сообщает совместимым приложениям, что текст был вставлен, а не введён с клавиатуры. Некоторые программы используют это, чтобы обрабатывать вставленный текст особым образом, например не применяя к нему автоотступ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vkladanie so zátvorkami oznamuje kompatibilným aplikáciám, že text bol vložený operáciou vloženia, a nie napísaný. Niektoré programy to využívajú na osobitné spracovanie vloženého textu, napríklad bez automatického odsadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepljenje v oklepajih sporoči združljivim aplikacijam, da je bilo besedilo vstavljeno z lepljenjem in ne s tipkanjem. Nekateri programi to uporabijo za posebno obravnavo lepljenja, na primer da besedila ne zamaknejo samodejno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklistring inom hakparentes talar om för kompatibla appar att texten infogades genom inklistring och inte genom att skrivas. Vissa program använder detta för att hantera inklistring på ett särskilt sätt, t.ex. genom att inte använda automatisk indragning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การวางแบบมีวงเล็บกำกับจะบอกแอปที่รองรับว่าข้อความถูกแทรกด้วยการวาง ไม่ได้พิมพ์เอง บางโปรแกรมใช้ข้อมูลนี้เพื่อจัดการกับการวางเป็นพิเศษ เช่น ไม่เยื้องบรรทัดอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayraçlı yapıştırma, uyumlu uygulamalara metnin yazılarak değil yapıştırma işlemiyle eklendiğini bildirir. Bazı programlar bunu yapıştırılan metni özel olarak işlemek için kullanır; örneğin otomatik girinti uygulamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставлення в дужках повідомляє сумісним програмам, що текст вставлено операцією вставлення, а не набрано. Деякі програми використовують це, щоб особливо обробляти вставлення, наприклад не додавати автоматичний відступ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán có đánh dấu cho các ứng dụng tương thích biết rằng văn bản được chèn bằng thao tác dán chứ không phải gõ. Một số chương trình dùng điều này để xử lý việc dán theo cách đặc biệt, chẳng hạn không tự động thụt lề."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "括号粘贴会告知兼容的App：文本是通过粘贴操作插入的，而非键入。某些程序会借此特别处理粘贴内容，例如不自动缩进。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "括號貼上會告知相容的 App，文字是以貼上操作插入，而非鍵入。某些程式會藉此特別處理貼上的內容，例如不自動縮排。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴括号告知兼容的应用，文本是通过粘贴操作而非键入插入的。某些程序会借此特殊处理粘贴内容，例如不自动缩进。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "括號貼上會告知相容的 App，文字是以貼上操作插入，而非鍵入。某些程式會藉此特別處理貼上的內容，例如不自動縮排。"
          }
        }
      }
    },
