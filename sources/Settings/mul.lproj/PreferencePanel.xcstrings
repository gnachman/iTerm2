            "value" : "曖昧幅の文字を全角として扱う"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모호한 너비의 문자를 전각으로 처리"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
