          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phiên có thể khiến cửa sổ đổi kích thước dù nó nằm trong tab hoặc khung chia không được chọn"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
