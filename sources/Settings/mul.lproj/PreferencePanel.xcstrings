    "oZc-l2-yBR.placeholderString" : {
      "comment" : "Class = \"NSTextFieldCell\"; placeholderString = \"Interpolated string. If empty, use session title.\"; ObjectID = \"oZc-l2-yBR\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpolovaný řetězec. Je-li prázdný, použije se název relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpoleret streng. Hvis den er tom, bruges sessionens titel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpolierte Zeichenfolge. Wenn leer, wird der Sitzungstitel verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Interpolated string. If empty, use session title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadena interpolada. Si está vacía, se usa el título de la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpoloitu merkkijono. Jos tyhjä, käytetään istunnon otsikkoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaîne interpolée. Si vide, utilise le titre de la session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stringa interpolata. Se vuota, viene usato il titolo della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補間文字列。空の場合はセッションタイトルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보간 문자열. 비어 있으면 세션 제목을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpolert streng. Hvis tom, brukes øktens tittel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geïnterpoleerde tekenreeks. Als deze leeg is, wordt de sessietitel gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciąg interpolowany. Jeśli pusty, używany jest tytuł sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "String interpolada. Se vazio, usa o título da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интерполированная строка. Если пусто, используется заголовок сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpolovaný reťazec. Ak je prázdny, použije sa názov relácie."
          }
        },
        "sl" : {
