    "8jj-nE-deG.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For this setting to take effect you must disable \\\"Native full screen windows\\\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems.\"; ObjectID = \"8jj-nE-deG\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby toto nastavení mělo účinek, musíte v „Nastavení > Obecné“ vypnout „Nativní okna celé obrazovky“. Je-li toto nastavení zapnuto, řádek nabídek zůstane viditelný. Hodí se to u systémů s více monitory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at denne indstilling får virkning, skal du slå “Native vinduer i fuld skærm” fra i Indstillinger > Generelt. Hvis denne indstilling er slået til, forbliver menulinjen synlig. Det er nyttigt på systemer med flere skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit diese Einstellung wirksam wird, müssen Sie „Native Vollbildfenster“ unter Einstellungen > Allgemein deaktivieren. Wenn diese Einstellung aktiviert ist, bleibt die Menüleiste sichtbar. Dies ist nützlich für Systeme mit mehreren Monitoren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que este ajuste surta efecto, debes desactivar “Ventanas nativas en pantalla completa” en Ajustes > General. Si este ajuste está activado, la barra de menús seguirá visible. Es útil en sistemas con varios monitores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotta tämä asetus tulisi voimaan, sinun on poistettava käytöstä ”Natiivit koko näytön ikkunat” kohdassa Asetukset > Yleiset. Kun tämä asetus on käytössä, valikkorivi pysyy näkyvissä. Tästä on hyötyä usean näytön järjestelmissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que ce réglage prenne effet, vous devez désactiver « Fenêtres en plein écran natif » dans Réglages > Général. Si ce réglage est activé, la barre des menus reste visible. C’est utile avec plusieurs moniteurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché questa impostazione abbia effetto devi disabilitare “Finestre native a tutto schermo” in Impostazioni > Generali. Se questa impostazione è attiva, la barra dei menu resta visibile. È utile con sistemi a più monitor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定を有効にするには、設定 > 一般で「ネイティブフルスクリーンウィンドウ」を無効にする必要があります。この設定が有効な場合、メニューバーは表示されたままになります。これはマルチモニタ環境で便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정을 적용하려면 설정 > 일반에서 \"네이티브 전체 화면 윈도우\"를 꺼야 합니다. 이 설정이 켜져 있으면 메뉴 막대가 계속 보입니다. 여러 모니터를 사용하는 시스템에서 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at denne innstillingen skal tre i kraft, må du deaktivere «Innebygde fullskjermvinduer» i «Innstillinger > Generelt». Hvis denne innstillingen er aktivert, forblir menylinjen synlig. Dette er nyttig på systemer med flere skjermer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om deze instelling te laten werken, moet je ‘Native schermvullende vensters’ uitschakelen in ‘Instellingen > Algemeen’. Als deze instelling is ingeschakeld, blijft de menubalk zichtbaar. Handig bij systemen met meerdere beeldschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby to ustawienie zadziałało, musisz wyłączyć „Natywne okna pełnoekranowe” w menu Ustawienia > Ogólne. Gdy to ustawienie jest włączone, pasek menu pozostaje widoczny. Jest to przydatne w systemach z wieloma monitorami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que este ajuste tenha efeito, você deve desativar “Janelas em tela cheia nativas” em Ajustes > Geral. Se este ajuste estiver ativado, a barra de menus permanecerá visível. Isto é útil para sistemas com vários monitores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы этот параметр вступил в силу, нужно отключить «Полноэкранные окна» в разделе Настройки > Общие. Если этот параметр включён, строка меню будет оставаться видимой. Это полезно для систем с несколькими мониторами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby sa toto nastavenie prejavilo, musíte v časti „Nastavenia > Všeobecné“ vypnúť „Natívne okná na celej obrazovke“. Ak je toto nastavenie zapnuté, lišta menu zostane viditeľná. Hodí sa to pre systémy s viacerými monitormi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da ta nastavitev začne veljati, morate v Nastavitve > Splošno onemogočiti »Izvorna okna v celozaslonskem načinu«. Če je ta nastavitev omogočena, menijska vrstica ostane vidna. To je uporabno v sistemih z več monitorji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att den här inställningen ska gälla måste du avaktivera ”Inbyggda helskärmsfönster” i Inställningar > Allmänt. Om den här inställningen är på förblir menyraden synlig. Det är användbart på system med flera skärmar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarın etkili olması için Ayarlar > Genel bölümünde “Yerel tam ekran pencereler” seçeneğini devre dışı bırakmalısınız. Bu ayar etkinse menü çubuğu görünür kalır. Bu, çok monitörlü sistemlerde yararlıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để cài đặt này có hiệu lực, bạn phải tắt “Cửa sổ toàn màn hình gốc” trong Cài đặt > Chung. Nếu cài đặt này được bật, thanh menu sẽ vẫn hiển thị. Điều này hữu ích cho hệ thống nhiều màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使此设置生效，你必须停用“设置 > 通用”中的“原生全屏幕窗口”。启用此设置后，菜单栏将保持可见。这对多显示器系统很有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使此設定生效，必須停用「設定 > 一般」中的「原生全螢幕視窗」。啟用此設定後，選單列會保持顯示。這對多螢幕系統很有用。"
          }
        }
      }
    },
