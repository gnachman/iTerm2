        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur einmal pro Sitzung erzwingen, wenn sie zum ersten Mal den Tastaturfokus erhält"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιβολή μόνο μία φορά ανά συνεδρία, όταν λαμβάνει για πρώτη φορά εστίαση πληκτρολογίου"
