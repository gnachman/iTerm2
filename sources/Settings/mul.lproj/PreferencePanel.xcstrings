            "value" : "Kecualikan dari Dock hanya jika semua jendela adalah jendela tombol pintas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludi dal Dock solo se tutte le finestre sono finestre ad abbreviazione globale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのウィンドウがホットキーウィンドウの場合のみDockから除外"
