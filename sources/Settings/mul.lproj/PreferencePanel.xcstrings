    "CRE-cb-4lA.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong.\"; ObjectID = \"CRE-cb-4lA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una sessió acaba immediatament després d’iniciar-se i aquesta opció està activada, es manté oberta perquè puguis veure què ha anat malament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud relace skončí ihned po spuštění a toto nastavení je zapnuto, zůstane otevřená, abyste viděli, co se pokazilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en session slutter umiddelbart efter start, og denne indstilling er slået til, holdes den åben, så du kan se, hvad der gik galt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Sitzung sofort nach dem Start endet und diese Einstellung aktiviert ist, bleibt sie geöffnet, damit Sie sehen können, was schiefgelaufen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν μια συνεδρία τερματιστεί αμέσως μετά την εκκίνηση και αυτή η ρύθμιση είναι ενεργοποιημένη, παραμένει ανοιχτή ώστε να δείτε τι πήγε στραβά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una sesión termina inmediatamente después de iniciarse y este ajuste está activado, se mantiene abierta para que puedas ver qué salió mal."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una sesión termina inmediatamente después de iniciarse y esta configuración está activada, se mantiene abierta para que puedas ver qué salió mal."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una sesión termina inmediatamente después de iniciarse y esta configuración está activada, se mantiene abierta para que puedas ver qué salió mal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos istunto päättyy heti käynnistyksen jälkeen ja tämä asetus on käytössä, se pidetään auki, jotta näet mikä meni pieleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une session se termine immédiatement après son démarrage et que ce réglage est activé, la garder ouverte pour que vous puissiez voir ce qui a échoué."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une session se termine immédiatement après son démarrage et que ce réglage est activé, la garder ouverte pour que vous puissiez voir ce qui a échoué."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि कोई सत्र शुरू होते ही समाप्त हो जाए और यह सेटिंग सक्षम हो, तो उसे खुला रखा जाता है ताकि आप देख सकें कि क्या गड़बड़ हुई।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se sesija završi odmah nakon pokretanja i ova je postavka omogućena, ostaje otvorena kako biste vidjeli što je pošlo po zlu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a munkamenet közvetlenül az indítás után véget ér, és ez a beállítás engedélyezve van, nyitva marad, hogy láthassa, mi ment félre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika sesi berakhir segera setelah dimulai dan pengaturan ini diaktifkan, sesi tetap dibuka agar Anda dapat melihat apa yang salah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se una sessione termina subito dopo l’avvio e questa impostazione è attiva, viene tenuta aperta così puoi vedere cosa è andato storto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが開始直後に終了し、この設定が有効になっている場合、何が問題だったか確認できるように開いたままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정이 켜져 있으면 세션이 시작 직후 종료되었을 때 무엇이 잘못되었는지 볼 수 있도록 세션을 열어 둡니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika sesi tamat sejurus selepas bermula dan seting ini didayakan, biarkan ia terbuka supaya anda dapat melihat apa yang tidak kena."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en økt avsluttes rett etter start og denne innstillingen er aktivert, holdes den åpen slik at du kan se hva som gikk galt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een sessie direct na het starten eindigt en deze instelling is ingeschakeld, blijft de sessie open zodat je kunt zien wat er misging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli sesja kończy się natychmiast po uruchomieniu i to ustawienie jest włączone, pozostaje otwarta, aby można było zobaczyć, co poszło nie tak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se uma sessão terminar imediatamente após iniciar e este ajuste estiver ativado, mantê-la aberta para que você possa ver o que deu errado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se uma sessão terminar imediatamente após iniciar e esta definição estiver ativada, mantê-la aberta para que possa ver o que correu mal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă o sesiune se încheie imediat după pornire și această configurare este activată, sesiunea rămâne deschisă pentru a putea vedea ce nu a mers."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сессия завершается сразу после запуска и этот параметр включён, оставлять её открытой, чтобы вы могли увидеть, что пошло не так."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa relácia skončí hneď po spustení a toto nastavenie je zapnuté, zostane otvorená, aby ste videli, čo sa pokazilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se seja konča takoj po zagonu in je ta nastavitev omogočena, ostane odprta, da lahko vidite, kaj je šlo narobe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om en session avslutas direkt efter start och den här inställningen är på hålls den öppen så att du kan se vad som gick fel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเซสชั่นสิ้นสุดทันทีหลังเริ่มต้นและเปิดใช้การตั้งค่านี้ เซสชั่นจะยังคงเปิดอยู่เพื่อให้คุณดูได้ว่าเกิดอะไรผิดพลาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturum başladıktan hemen sonra sona erer ve bu ayar etkinse, neyin ters gittiğini görebilmeniz için açık tutulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо сеанс завершується одразу після запуску й цей параметр увімкнено, він залишається відкритим, щоб ви могли побачити, що пішло не так."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu phiên kết thúc ngay sau khi khởi động và cài đặt này được bật, phiên sẽ được giữ mở để bạn xem điều gì đã xảy ra."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果会话在启动后立即结束且已启用此设置，则保持其打开，以便你查看出了什么问题。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如工作階段在啟動後立即結束，且已啟用此設定，則保持其開啟，以便查看發生了什麼問題。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果会话在启动后立即结束且此设置已启用，则保持其打开，以便你查看出了什么问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若工作階段在啟動後立即結束，且已啟用此設定，則保持其打開，以便查看發生了什麼問題。"
          }
        }
      }
    },
