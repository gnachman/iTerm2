        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni definiscono le autorizzazioni predefinite per le nuove chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの設定は、新しいチャットのデフォルトの権限を定義します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 새로운 채팅의 기본 권한을 정의합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse innstillingene definerer standardtillatelsene for nye chatter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met deze instellingen bepaal je de standaardtoestemmingen voor nieuwe chats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia określają domyślne uprawnienia dla nowych czatów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes ajustes definem as permissões padrão para novos chats."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти настройки определяют разрешения по умолчанию для новых чатов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto nastavenia určujú predvolené povolenia pre nové chaty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te nastavitve določajo privzeta dovoljenja za nove klepete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här inställningarna definierar förvalda behörigheter för nya chattar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarlar yeni sohbetler için varsayılan izinleri tanımlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cài đặt này định nghĩa quyền mặc định cho cuộc trò chuyện mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
