            "state" : "translated",
            "value" : "Anima il cursore solo nelle app interattive"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対話型アプリでのみカーソルをアニメーションさせる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화형 앱에서만 커서 애니메이션"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
