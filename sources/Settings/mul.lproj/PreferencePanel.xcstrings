    "Nhj-1F-dbm.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect.\"; ObjectID = \"Nhj-1F-dbm\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan això està activat, Majúscules+tecla de fletxa amplia una selecció existent. Si no hi ha cap selecció, no té efecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, ⇧ + šipka rozšíří existující výběr. Pokud žádný výběr není, nemá to účinek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, udvider skift+piletast en eksisterende markering. Hvis der ikke er nogen markering, har det ingen virkning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, erweitert Umschalt+Pfeiltaste eine bestehende Auswahl. Wenn keine Auswahl vorhanden ist, hat dies keine Wirkung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, το Shift+πλήκτρο βέλους επεκτείνει μια υπάρχουσα επιλογή. Αν δεν υπάρχει επιλογή, δεν έχει αποτέλεσμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, Mayúsculas+flecha ampliará una selección existente. Si no hay selección, no tiene efecto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, Mayúsculas+flecha ampliará una selección existente. Si no hay selección, no tiene efecto."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, Mayúsculas+flecha ampliará una selección existente. Si no hay selección, no tiene efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, vaihto+nuolinäppäin laajentaa olemassa olevaa valintaa. Jos valintaa ei ole, sillä ei ole vaikutusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, Maj+flèche étend la sélection existante. S’il n’y a pas de sélection, cela n’a aucun effet."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, Maj+flèche étend la sélection existante. S’il n’y a pas de sélection, cela n’a aucun effet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सक्षम होने पर शिफ़्ट+ऐरो की मौजूदा चयन को बढ़ाएगी। चयन न होने पर इसका कोई असर नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je ovo omogućeno, Shift+strelica proširit će postojeći odabir. Ako nema odabira, nema učinka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez engedélyezve van, a Shift+nyíl billentyű kiterjeszti a meglévő kijelölést. Ha nincs kijelölés, nincs hatása."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, shift+tombol panah akan memperluas pilihan yang ada. Jika tidak ada pilihan, ini tidak berpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, Maiuscole+freccia estende una selezione esistente. Se non c’è alcuna selezione, non ha effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすると、shift+矢印キーで既存の選択範囲を拡張できます。選択範囲がない場合、これは効果がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 Shift+화살표 키로 기존 선택 영역을 확장합니다. 선택 영역이 없으면 아무 효과가 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila ini didayakan, Shift+kekunci anak panah akan melanjutkan pilihan sedia ada. Jika tiada pilihan, ini tidak berkesan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, utvider Skift+piltast en eksisterende markering. Hvis det ikke finnes noen markering, har det ingen effekt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, breidt Shift+pijltoets een bestaande selectie uit. Als er geen selectie is, heeft het geen effect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, Shift + klawisz strzałki rozszerza istniejące zaznaczenie. Jeśli nie ma zaznaczenia, nie ma to żadnego skutku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando isto estiver ativado, Shift+seta estenderá uma seleção existente. Se não houver seleção, isso não terá efeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando isto estiver ativado, Shift+seta estenderá uma seleção existente. Se não existir seleção, isso não terá efeito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activat, Shift+săgeată extinde o selecție existentă. Dacă nu există selecție, nu are efect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это включено, shift+стрелка будет расширять существующее выделение. Если выделения нет, это не имеет эффекта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, Shift+šípka rozšíri existujúci výber. Ak nie je nič vybrané, nemá to žiadny účinok."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, Shift + puščična tipka razširi obstoječi izbor. Če izbora ni, nima učinka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på utökar skift+piltangent en befintlig markering. Om det inte finns någon markering har det ingen effekt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ การกดปุ่ม Shift + ปุ่มลูกศรจะขยายส่วนที่เลือกอยู่ หากไม่มีส่วนที่เลือก จะไม่มีผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu etkinken Shift+ok tuşu mevcut bir seçimi genişletir. Seçim yoksa etkisi olmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, Shift+стрілка розширює наявний вибір. Якщо вибору немає, це не діє."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, Shift+phím mũi tên sẽ mở rộng vùng chọn hiện có. Nếu không có vùng chọn, tùy chọn này không có tác dụng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Shift加箭头键会扩展现有选择。如果没有选择，则不起作用。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，Shift+方向鍵會延伸現有的選取範圍。如沒有選取範圍，則不會有任何效果。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Shift+方向键将扩展现有选区。如果没有选区，则无效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，Shift+方向鍵會延伸現有的選取範圍。若沒有選取範圍，則不會有任何效果。"
          }
        }
      }
    },
