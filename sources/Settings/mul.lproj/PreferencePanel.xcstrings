    "5Xl-Cr-LpL.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Some crusty old systems expect newline rather than carraige return in in raw mode. The symptom is that tmux -CC just hangs. Most people should leave this off.\"; ObjectID = \"5Xl-Cr-LpL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé staré systémy v raw režimu očekávají nový řádek místo návratu vozíku. Příznakem je, že tmux -CC prostě zamrzne. Většina uživatelů by to měla nechat vypnuté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle gamle systemer forventer linjeskift i stedet for vognretur i rå tilstand. Symptomet er, at tmux -CC bare hænger. De fleste bør lade dette være slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche uralten Systeme erwarten im Raw-Modus einen Zeilenvorschub (Newline) statt eines Wagenrücklaufs (Carriage Return). Das Symptom ist, dass tmux -CC einfach hängen bleibt. Die meisten Anwender sollten dies deaktiviert lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some crusty old systems expect newline rather than carraige return in in raw mode. The symptom is that tmux -CC just hangs. Most people should leave this off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos sistemas antiguos esperan un salto de línea en lugar de un retorno de carro en modo raw. El síntoma es que tmux -CC se queda colgado. La mayoría de la gente debería dejar esto desactivado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin vanhat järjestelmät odottavat raw-tilassa rivinvaihtoa rivin alun palautuksen sijaan. Oireena on, että tmux -CC vain jumittuu. Useimpien kannattaa jättää tämä pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains vieux systèmes attendent un saut de ligne plutôt qu’un retour chariot en mode brut. Le symptôme est que tmux -CC se bloque. La plupart des utilisateurs devraient laisser cette option désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni vecchi sistemi si aspettano un ritorno a capo (newline) anziché un carriage return in modalità raw. Il sintomo è che tmux -CC si blocca. La maggior parte degli utenti dovrebbe lasciare questa opzione disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の古いシステムでは、rawモードでキャリッジリターンではなく改行を期待します。症状としてはtmux -CCが単にハングします。ほとんどの人はこれをオフのままにしておくべきです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 오래된 시스템은 raw 모드에서 캐리지 리턴 대신 줄바꿈을 기대합니다. 이 경우 tmux -CC가 그냥 멈추는 증상이 나타납니다. 대부분의 사용자는 이 옵션을 꺼 두어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen gamle systemer forventer linjeskift i stedet for vognretur i rå modus. Symptomet er at tmux -CC bare henger seg. De fleste bør la dette være av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige oude systemen verwachten in de onbewerkte modus een regeleinde in plaats van een regelterugloop. Het symptoom is dat tmux -CC blijft hangen. De meeste mensen laten dit uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre stare systemy oczekują w trybie surowym znaku nowego wiersza zamiast powrotu karetki. Objawem jest zawieszanie się tmux -CC. Większość osób powinna zostawić tę opcję wyłączoną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns sistemas antigos esperam newline em vez de carriage return no modo raw. O sintoma é que o tmux -CC simplesmente trava. A maioria das pessoas deve deixar isto desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые устаревшие системы ожидают в необработанном режиме перевод строки вместо возврата каретки. Симптом — то, что tmux -CC просто зависает. Большинству пользователей следует оставить этот параметр выключенным."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré staré systémy v režime raw očakávajú nový riadok namiesto návratu vozíka. Príznakom je, že tmux -CC sa jednoducho zasekne. Väčšina užívateľov by to mala nechať vypnuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekateri zastareli sistemi v surovem načinu pričakujejo znak za novo vrstico namesto vrnitve na začetek vrstice. Simptom je, da se tmux -CC samo zatakne. Večina uporabnikov naj to pusti izklopljeno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa gamla system förväntar sig radbrytning i stället för vagnretur i råläge. Symptomet är att tmux -CC bara hänger sig. De flesta bör låta detta vara av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı eski sistemler ham modda satır başı yerine satır sonu bekler. Belirtisi, tmux -CC’nin takılı kalmasıdır. Çoğu kullanıcı bunu kapalı bırakmalıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số hệ thống cũ mong đợi ký tự dòng mới thay vì ký tự xuống đầu dòng ở chế độ raw. Triệu chứng là tmux -CC bị treo. Hầu hết mọi người nên để tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些老旧系统在原始模式下期望换行符而非回车符。症状是 tmux -CC 卡住。大多数人应保持关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些老舊系統在原始模式下預期收到換行字元，而非歸位字元。症狀是 tmux -CC 卡住不動。大多數人應保持關閉。"
          }
        }
      }
    },
