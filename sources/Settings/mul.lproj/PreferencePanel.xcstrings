    "5154.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When using a program like tmux, which shows a status bar at the bottom of the screen, history is not normally saved. This allows such history to be saved but with a performance penalty.\"; ObjectID = \"5154\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při použití programu jako tmux, který dole na obrazovce zobrazuje stavový řádek, se historie obvykle neukládá. Toto nastavení umožní takovou historii ukládat, ale za cenu nižšího výkonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du bruger et program som tmux, der viser en statuslinje nederst på skærmen, gemmes historikken normalt ikke. Dette gør det muligt at gemme en sådan historik, men med en ydelsesforringelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Verwendung eines Programms wie tmux, das am unteren Bildschirmrand eine Statusleiste anzeigt, wird der Verlauf normalerweise nicht gespeichert. Dies ermöglicht das Speichern dieses Verlaufs, jedoch mit Leistungseinbußen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using a program like tmux, which shows a status bar at the bottom of the screen, history is not normally saved. This allows such history to be saved but with a performance penalty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un programa como tmux, que muestra una barra de estado en la parte inferior de la pantalla, normalmente no se guarda el historial. Esto permite guardarlo, pero con una penalización de rendimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun käytetään ohjelmaa kuten tmux, joka näyttää tilapalkin näytön alareunassa, historiaa ei yleensä tallenneta. Tämä sallii historian tallennuksen, mutta heikentää suorituskykyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un programme comme tmux, qui affiche une barre d’état en bas de l’écran, l’historique n’est normalement pas enregistré. Cette option permet de l’enregistrer, au prix d’une baisse de performances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un programma come tmux, che mostra una barra di stato in fondo allo schermo, di norma la cronologia non viene salvata. Questa opzione permette di salvarla, ma con un costo in prestazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmuxのように画面下部にステータスバーを表示するプログラムを使用している場合、通常は履歴が保存されません。これにより、パフォーマンスは低下しますがそのような履歴を保存できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 하단에 상태 막대를 표시하는 tmux 같은 프로그램을 사용할 때는 보통 기록이 저장되지 않습니다. 이 옵션을 켜면 이러한 기록을 저장할 수 있지만 성능이 저하됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du bruker et program som tmux, som viser en statuslinje nederst på skjermen, lagres vanligvis ikke historikken. Dette gjør at slik historikk kan lagres, men med lavere ytelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij een programma als tmux, dat onderaan het scherm een statusbalk toont, wordt de geschiedenis normaal niet bewaard. Hiermee kan die geschiedenis wel worden bewaard, ten koste van de prestaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W programach takich jak tmux, które pokazują pasek stanu u dołu ekranu, historia zwykle nie jest zapisywana. Ta opcja pozwala ją zapisywać kosztem wydajności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar um programa como o tmux, que mostra uma barra de status na parte inferior da tela, o histórico normalmente não é salvo. Isto permite salvar esse histórico, mas com perda de desempenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании программы наподобие tmux, показывающей строку состояния внизу экрана, история обычно не сохраняется. Этот параметр позволяет сохранять такую историю, но снижает производительность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri programe ako tmux, ktorý zobrazuje stavovú lištu v dolnej časti obrazovky, sa história zvyčajne neukladá. Toto umožní ukladať ju, ale s dopadom na výkon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri programu, kot je tmux, ki na dnu zaslona prikazuje vrstico stanja, se zgodovina običajno ne shranjuje. To omogoči shranjevanje take zgodovine, vendar z vplivom na zmogljivost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du använder ett program som tmux, som visar ett statusfält längst ned på skärmen, sparas historiken normalt inte. Det här gör att sådan historik kan sparas, men med sämre prestanda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tmux gibi ekranın altında durum çubuğu gösteren bir program kullanırken geçmiş normalde kaydedilmez. Bu seçenek geçmişin kaydedilmesini sağlar, ancak performans maliyeti vardır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi dùng chương trình như tmux, vốn hiển thị thanh trạng thái ở cuối màn hình, lịch sử thường không được lưu. Tùy chọn này cho phép lưu lịch sử đó nhưng làm giảm hiệu năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 等屏幕底部显示状态栏的程序时，通常不保存历史。此选项允许保存此类历史，但会有性能损失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 tmux 這類在螢幕底部顯示狀態列的程式時，通常不會儲存歷史記錄。此選項可儲存這類歷史記錄，但會影響效能。"
          }
        }
      }
    },
    "5155.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Save lines to scrollback when an app status bar is present\"; ObjectID = \"5155\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládat řádky do historie posouvání, když je přítomen stavový řádek aplikace"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem linjer i rullebufferen, når en app-statuslinje er til stede"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
