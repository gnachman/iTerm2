    "RBx-qn-HNB.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Animate cursor only in interactive apps\"; ObjectID = \"RBx-qn-HNB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor nur in interaktiven Apps animieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Animate cursor only in interactive apps"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対話型アプリでのみカーソルをアニメーションさせる"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animar o cursor apenas em apps interativos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимировать курсор только в интерактивных приложениях"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在交互式应用中为光标使用动画"
          }
        }
      }
    },
    "RBx-qn-HNB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated.\"; ObjectID = \"RBx-qn-HNB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, erfolgt die Cursor-Animation nur im Alternate-Screen-Modus. Wenn deaktiviert, werden Cursorbewegungen immer animiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, cursor animation only occurs in alternate screen mode. When disabled, cursor movements are always animated."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、カーソルのアニメーションは代替スクリーンモードでのみ発生します。無効にすると、カーソルの移動は常にアニメーションされます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, a animação do cursor só ocorre no modo de tela alternativa. Quando desativado, os movimentos do cursor são sempre animados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, анимация курсора происходит только в альтернативном режиме экрана. Если отключено, перемещения курсора анимируются всегда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，光标动画仅在备用屏幕模式下发生。关闭后，光标移动始终带有动画。"
          }
        }
      }
    },
    "rcS-Ls-100.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal.\"; ObjectID = \"rcS-Ls-100\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umschließt den Befehl mit Ihrer Login-Shell, so dass zuerst die Dotfiles ausgeführt werden und Ihr Befehl denselben $PATH und dieselben exportierten Variablen sieht, die Sie in einem interaktiven Terminal hätten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wraps the command in your login shell so dotfiles run first and your command sees the same $PATH and exported variables you’d have in an interactive terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドをログインシェルでラップすることで、dotfileが先に実行され、対話型ターミナルと同じ$PATHやエクスポートされた変数をコマンドが認識できるようにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envolve o comando no seu shell de login para que os dotfiles sejam executados primeiro e seu comando veja o mesmo $PATH e as mesmas variáveis exportadas que você teria em um terminal interativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оборачивает команду в оболочку входа, чтобы сначала выполнялись dotfiles и ваша команда видела те же $PATH и экспортированные переменные, что и в интерактивном терминале."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将命令包装在登录 Shell 中，以便先运行 dotfiles，让你的命令看到与交互式终端中相同的 $PATH 和导出变量。"
          }
        }
      }
    },
    "rcS-Ls-101.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Run command through your shell\"; ObjectID = \"rcS-Ls-101\";",
