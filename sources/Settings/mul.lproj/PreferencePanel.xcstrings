          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisz skrótu otwiera dedykowane okno z tym profilem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma hotkey abre uma janela dedicada com este perfil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Горячая клавиша открывает выделенное окно с этим профилем"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivačná skratka otvorí vyhradené okno s týmto profilom"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitra tipka odpre namensko okno s tem profilom"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En snabbtangent öppnar ett dedikerat fönster med den här profilen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kısayol tuşu bu profille özel bir pencere açar"
