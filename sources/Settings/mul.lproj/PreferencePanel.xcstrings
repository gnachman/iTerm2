    "wTp-Qf-YIk.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Maximize throughput at the cost of higher latency\"; ObjectID = \"wTp-Qf-YIk\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximalizovat propustnost za cenu vyšší latence"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimer gennemløb på bekostning af højere forsinkelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsatz maximieren auf Kosten einer höheren Latenz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximize throughput at the cost of higher latency"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximizar el rendimiento a costa de una mayor latencia"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimoi läpäisykyky suuremman viiveen kustannuksella"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximiser le débit au prix d’une latence plus élevée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Massimizza la velocità di elaborazione a costo di una latenza maggiore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイテンシを犠牲にしてスループットを最大化"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지연 시간이 길어지더라도 처리량 최대화"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimer gjennomstrømming på bekostning av høyere ventetid"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaliseer de doorvoer ten koste van een hogere latentie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalizuj przepustowość kosztem większego opóźnienia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximizar a taxa de transferência ao custo de maior latência"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимизировать пропускную способность за счёт увеличения задержки"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximalizovať priepustnosť na úkor vyššej latencie"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povečaj prepustnost za ceno daljše zakasnitve"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximera genomströmningen på bekostnad av högre latens"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek gecikme pahasına verimi en üst düzeye çıkar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tối đa hóa thông lượng với giá phải trả là độ trễ cao hơn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以更高延迟换取最大吞吐量"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以較高的延遲換取最大吞吐量"
          }
        }
      }
    },
    "WVK-xs-N2h.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, small horizontal cursor movements are animated. The box cursor animates only when GPU rendering is in use.\"; ObjectID = \"WVK-xs-N2h\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, malé vodorovné pohyby kurzoru se animují. Blokový kurzor se animuje jen při použití vykreslování pomocí GPU."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, animeres små vandrette markørbevægelser. Blokmarkøren animeres kun, når GPU-gengivelse bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn aktiviert, werden kleine horizontale Cursorbewegungen animiert. Der Blockcursor wird nur animiert, wenn GPU-Rendering verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, small horizontal cursor movements are animated. The box cursor animates only when GPU rendering is in use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los movimientos horizontales pequeños del cursor se animan. No disponible para cursores de bloque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, pienet vaakasuuntaiset kohdistimen liikkeet animoidaan. Laatikkokohdistin animoituu vain, kun GPU-renderöinti on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les petits déplacements horizontaux du curseur sont animés. Non disponible pour les curseurs bloc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, i piccoli movimenti orizzontali del cursore vengono animati. Il cursore a blocco si anima solo quando è in uso il rendering GPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有効にすると、小さな水平方向のカーソル移動がアニメーション化されます。ブロックカーソルは、GPUレンダリングを使用している場合にのみアニメーション化されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "켜면 커서의 작은 가로 이동에 애니메이션이 적용됩니다. 블록 커서는 GPU 렌더링을 사용할 때만 애니메이션이 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, animeres små horisontale markørbevegelser. Blokkmarkøren animeres bare når GPU-gjengivelse er i bruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, worden kleine horizontale cursorbewegingen geanimeerd. De blokcursor wordt alleen geanimeerd als GPU-weergave wordt gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, małe poziome ruchy kursora są animowane. Kursor blokowy jest animowany tylko wtedy, gdy używane jest renderowanie GPU."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando ativado, pequenos movimentos horizontais do cursor são animados. O cursor em bloco só é animado quando a renderização por GPU está em uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если этот параметр включён, небольшие горизонтальные перемещения курсора анимируются. Блочный курсор анимируется, только если используется рендеринг на GPU."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, malé vodorovné pohyby kurzora sa animujú. Blokový kurzor sa animuje iba pri použití vykresľovania GPU."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, se majhni vodoravni premiki kazalca animirajo. Kazalec v obliki bloka se animira samo, kadar je v uporabi upodabljanje z GPU."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på animeras små horisontella markörrörelser. Blockmarkören animeras bara när GPU-rendering används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde küçük yatay imleç hareketleri animasyonla gösterilir. Kutu imleci yalnızca GPU işleme kullanılırken canlandırılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các chuyển động ngang nhỏ của con trỏ có hiệu ứng. Con trỏ dạng khối chỉ có hiệu ứng khi dùng kết xuất GPU."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "启用后，小幅水平光标移动会带有动画。块状光标仅在使用 GPU 渲染时才会有动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，小幅度的水平游標移動會帶有動畫。方塊游標僅在使用 GPU 繪製時才有動畫。"
          }
        }
      }
    },
    "x0T-MM-6tL.title" : {
