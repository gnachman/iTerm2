            "value" : "預設停用非原生全螢幕視窗的透明度"
          }
        }
      }
    },
    "5759.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Save lines to scrollback in alternate screen mode\"; ObjectID = \"5759\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládat řádky do historie posouvání v režimu alternativní obrazovky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem linjer i rullebufferen i alternativ skærmtilstand"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen im alternativen Bildschirmmodus im Scrollback speichern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Save lines to scrollback in alternate screen mode"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar líneas en el historial de desplazamiento en modo de pantalla alternativa"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna rivit vierityshistoriaan vaihtoehtoisen näytön tilassa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer les lignes dans l’historique de défilement en mode écran alternatif"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva le righe nella cronologia di scorrimento in modalità schermo alternativo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替スクリーンモードでもスクロールバックに行を保存する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 화면 모드에서 스크롤백에 줄 저장"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre linjer i tilbakerulling i alternativ skjermmodus"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar regels in scrollback in de modus voor het alternatieve scherm"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj wiersze w buforze przewijania w trybie ekranu alternatywnego"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar linhas no histórico de rolagem no modo de tela alternativa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять строки в буфер прокрутки в режиме альтернативного экрана"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukladať riadky do histórie rolovania v režime alternatívnej obrazovky"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shrani vrstice v medpomnilnik za pomikanje v načinu nadomestnega zaslona"
          }
