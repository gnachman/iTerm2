    "vhk-ek-NHd.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile.\"; ObjectID = \"vhk-ek-NHd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, la mida i la ubicació de les finestres de terminal es registren en tancar-les. Després, en crear una finestra nova, es fa servir la geometria registrada en lloc de la mida especificada al perfil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, velikost a umístění oken terminálu se při jejich zavření zaznamenají. Při pozdějším vytváření nového okna se pak místo velikosti zadané v profilu použije zaznamenaná geometrie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, registreres terminalvinduers størrelse og placering, når vinduerne lukkes. Når du senere opretter et nyt vindue, bruges den registrerede geometri i stedet for størrelsen angivet i profilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Größe und Position der Terminalfenster beim Schließen der Fenster gespeichert. Beim Erstellen eines neuen Fensters wird später die gespeicherte Geometrie anstelle der im Profil festgelegten Größe verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, το μέγεθος και η θέση των παραθύρων τερματικού καταγράφονται κατά το κλείσιμο των παραθύρων. Αργότερα, κατά τη δημιουργία νέου παραθύρου, χρησιμοποιείται η καταγεγραμμένη γεωμετρία αντί για το μέγεθος που ορίζεται στο προφίλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the size and location of terminal windows are recorded when windows are closed. Later, when creating a new window, the recorded geometry is used instead of the size specified in the profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el tamaño y la ubicación de las ventanas de terminal se registran al cerrarlas. Después, al crear una ventana nueva, se usa la geometría registrada en lugar del tamaño especificado en el perfil."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el tamaño y la ubicación de las ventanas de terminal se registran al cerrarlas. Después, al crear una ventana nueva, se usa la geometría registrada en lugar del tamaño especificado en el perfil."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, el tamaño y la ubicación de las ventanas de terminal se registran al cerrarlas. Después, al crear una ventana nueva, se usa la geometría registrada en lugar del tamaño especificado en el perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, päätteen ikkunoiden koko ja sijainti tallennetaan ikkunoita suljettaessa. Myöhemmin uutta ikkunaa luotaessa käytetään tallennettua geometriaa profiilissa määritellyn koon sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, la taille et la position des fenêtres de terminal sont enregistrées à leur fermeture. Plus tard, à la création d’une nouvelle fenêtre, la géométrie enregistrée est utilisée à la place de la taille indiquée dans le profil."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, la taille et la position des fenêtres de terminal sont enregistrées à leur fermeture. Plus tard, à la création d’une nouvelle fenêtre, la géométrie enregistrée est utilisée à la place de la taille indiquée dans le profil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, विंडो बंद करते समय टर्मिनल विंडो का आकार और स्थान दर्ज किया जाता है। बाद में नई विंडो बनाते समय, प्रोफ़ाइल में बताए आकार की जगह दर्ज की गई ज्यामिति उपयोग होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je omogućeno, veličina i položaj prozora terminala bilježe se pri zatvaranju prozora. Kasnije se pri stvaranju novog prozora koristi zabilježena geometrija umjesto veličine navedene u profilu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez engedélyezve van, a terminálablakok mérete és helye rögzítésre kerül az ablakok bezárásakor. Később, új ablak létrehozásakor a profilban megadott méret helyett a rögzített geometria van használatban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, ukuran dan lokasi jendela terminal dicatat saat jendela ditutup. Kemudian, saat membuat jendela baru, geometri yang dicatat digunakan sebagai ganti ukuran yang ditentukan di profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è attiva, dimensioni e posizione delle finestre del terminale vengono registrate alla chiusura delle finestre. In seguito, quando crei una nuova finestra, viene usata la geometria registrata anziché le dimensioni specificate nel profilo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、ウィンドウを閉じたときにターミナルウィンドウのサイズと位置が記録されます。その後、新しいウィンドウを作成するときに、プロファイルで指定されたサイズの代わりに記録されたジオメトリが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 윈도우를 닫을 때 터미널 윈도우의 크기와 위치가 기록됩니다. 나중에 새로운 윈도우를 만들 때 프로파일에 지정된 크기 대신 기록된 크기와 위치를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, saiz dan lokasi tetingkap terminal direkodkan apabila tetingkap ditutup. Kemudian, apabila membuat tetingkap baharu, geometri yang direkodkan digunakan dan bukannya saiz yang dinyatakan dalam profil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, registreres størrelsen og plasseringen til terminalvinduer når vinduene lukkes. Når du senere oppretter et nytt vindu, brukes den registrerte geometrien i stedet for størrelsen som er angitt i profilen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, worden de grootte en positie van terminalvensters vastgelegd wanneer vensters worden gesloten. Bij het maken van een nieuw venster wordt later de vastgelegde geometrie gebruikt in plaats van de grootte uit het profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, rozmiar i położenie okien terminala są zapamiętywane przy ich zamykaniu. Później, przy tworzeniu nowego okna, używana jest zapamiętana geometria zamiast rozmiaru określonego w profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o tamanho e a localização das janelas de terminal são registrados ao fechar as janelas. Depois, ao criar uma nova janela, a geometria registrada é usada em vez do tamanho especificado no perfil."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o tamanho e a localização das janelas de terminal são registados ao fechar as janelas. Depois, ao criar uma nova janela, a geometria registada é usada em vez do tamanho especificado no perfil."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, dimensiunea și poziția ferestrelor de terminal sunt înregistrate la închiderea ferestrelor. Ulterior, la crearea unei ferestre noi, se folosește geometria înregistrată în loc de dimensiunea specificată în profil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, при закрытии окон терминала запоминаются их размер и положение. Впоследствии при создании нового окна используется сохранённая геометрия вместо размера, указанного в профиле."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, pri zatvorení okien terminálu sa zaznamená ich veľkosť a poloha. Pri vytvorení nového okna sa potom namiesto veľkosti určenej v profile použije zaznamenaná geometria."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to omogočeno, se velikost in položaj oken terminala zabeležita ob zapiranju oken. Pri ustvarjanju novega okna se nato namesto velikosti iz profila uporabi zabeležena geometrija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är aktiverat sparas terminalfönstrens storlek och position när fönstren stängs. Senare, när ett nytt fönster skapas, används den sparade geometrin i stället för storleken som anges i profilen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ ขนาดและตำแหน่งของหน้าต่างเทอร์มินัลจะถูกบันทึกไว้เมื่อปิดหน้าต่าง ต่อมาเมื่อสร้างหน้าต่างใหม่ จะใช้ขนาดและตำแหน่งที่บันทึกไว้แทนขนาดที่ระบุในโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinken terminal pencerelerinin boyutu ve konumu, pencereler kapatılırken kaydedilir. Daha sonra yeni bir pencere oluşturulurken profilde belirtilen boyut yerine kaydedilen geometri kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, розмір і розташування вікон термінала записуються під час закриття вікон. Пізніше, створюючи нове вікно, замість розміру з профілю використовується записана геометрія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, kích thước và vị trí của cửa sổ terminal được ghi lại khi đóng cửa sổ. Sau đó, khi tạo cửa sổ mới, hình học đã ghi sẽ được dùng thay cho kích thước chỉ định trong hồ sơ."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，关闭终端窗口时会记录其大小和位置。之后新建窗口时，将使用记录的几何尺寸，而不是描述文件中指定的大小。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，關閉視窗時會記錄終端機視窗的大小和位置。之後建立新視窗時，會使用記錄的幾何資料，而非描述檔中指定的大小。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，关闭窗口时会记录终端窗口的大小和位置。之后创建新窗口时，使用记录的几何信息而不是配置文件中指定的大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，關閉視窗時會記錄終端機視窗的大小和位置。之後建立新視窗時，會使用記錄的幾何資訊，而非描述檔中指定的大小。"
          }
        }
      }
    },
