    "hvf-jg-Y9k.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Your AI provider may charge for each token used.\"; ObjectID = \"hvf-jg-Y9k\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš poskytovatel AI může účtovat poplatek za každý použitý token."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din AI-udbyder kan opkræve betaling for hvert token, der bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr KI-Anbieter kann für jedes verwendete Token Kosten berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your AI provider may charge for each token used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu proveedor de IA puede cobrar por cada token utilizado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-palveluntarjoajasi voi veloittaa jokaisesta käytetystä tokenista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fournisseur d’IA peut facturer chaque jeton utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo fornitore di IA potrebbe addebitare ogni token utilizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご利用のAIプロバイダーは、使用したトークンごとに課金する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 제공업체가 사용한 토큰마다 요금을 부과할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-leverandøren din kan ta betalt for hver token som brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je AI-aanbieder kan kosten in rekening brengen voor elk gebruikt token."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój dostawca AI może naliczać opłaty za każdy użyty token."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu provedor de IA pode cobrar por cada token usado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш поставщик ИИ может взимать плату за каждый использованный токен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš poskytovateľ AI si môže účtovať poplatok za každý použitý token."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš ponudnik AI morda zaračuna vsak uporabljeni žeton."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din AI-leverantör kan ta betalt för varje token som används."
