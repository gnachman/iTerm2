    "bAl-3O-ik0.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen.\"; ObjectID = \"bAl-3O-ik0\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je příkaz, který vytvořil výstup, částečně neviditelný, tato volba zobrazí v horní části obrazovky poslední řádek výzvy a příkaz, který výstup vytvořil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når kommandoen, der frembragte output, er delvist usynlig, viser denne indstilling den sidste linje af prompten og kommandoen, der frembragte outputtet, øverst på skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Befehl, der die Ausgabe erzeugt hat, teilweise unsichtbar ist, zeigt diese Option die letzte Zeile der Eingabeaufforderung und den Befehl, der die Ausgabe erzeugt hat, oben auf dem Bildschirm an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the command that produced output is partially invisible, this option shows the  last line of the prompt and the command that produced the output at the top of the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el comando que produjo la salida está parcialmente oculto, esta opción muestra la última línea del prompt y el comando que produjo la salida en la parte superior de la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tulosteen tuottanut komento on osittain näkymättömissä, tämä asetus näyttää kehotteen viimeisen rivin ja tulosteen tuottaneen komennon näytön yläreunassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la commande ayant produit la sortie est partiellement invisible, cette option affiche en haut de l’écran la dernière ligne de l’invite et la commande ayant produit la sortie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il comando che ha prodotto l’output è parzialmente invisibile, questa opzione mostra l’ultima riga del prompt e il comando che ha prodotto l’output in cima allo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出力を生成したコマンドが部分的に見えない場合、このオプションを使うと画面の一番上にプロンプトの最後の行と出力を生成したコマンドが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출력을 생성한 명령이 일부 보이지 않을 때, 이 옵션은 프롬프트의 마지막 줄과 출력을 생성한 명령을 화면 상단에 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når kommandoen som ga utdata er delvis usynlig, viser dette valget den siste linjen i ledeteksten og kommandoen som ga utdata øverst på skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het commando dat uitvoer heeft geproduceerd gedeeltelijk onzichtbaar is, toont deze optie de laatste regel van de prompt en het commando dat de uitvoer heeft geproduceerd bovenaan het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy polecenie, które wygenerowało dane wyjściowe, jest częściowo niewidoczne, ta opcja pokazuje na górze ekranu ostatni wiersz znaku zachęty i polecenie, które wygenerowało dane wyjściowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o comando que produziu a saída está parcialmente invisível, esta opção mostra a última linha do prompt e o comando que produziu a saída na parte superior da tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда команда, породившая вывод, частично не видна, этот параметр показывает последнюю строку приглашения и команду, породившую вывод, в верхней части экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je príkaz, ktorý vytvoril výstup, čiastočne neviditeľný, táto možnosť zobrazí v hornej časti obrazovky posledný riadok výzvy a príkaz, ktorý vytvoril výstup."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je ukaz, ki je ustvaril izhod, delno nevideden, ta možnost na vrhu zaslona prikaže zadnjo vrstico ukaznega poziva in ukaz, ki je ustvaril izhod."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När kommandot som gav utdata är delvis osynligt visar det här alternativet den sista raden av prompten och kommandot som gav utdata högst upp på skärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıktıyı üreten komut kısmen görünmez olduğunda, bu seçenek istemin son satırını ve çıktıyı üreten komutu ekranın üstünde gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi lệnh tạo ra đầu ra bị che một phần, tùy chọn này hiển thị dòng cuối của dấu nhắc và lệnh tạo ra đầu ra ở đầu màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当产生输出的命令部分不可见时，此选项会在屏幕顶部显示提示符的最后一行和产生输出的命令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當產生輸出的指令部分不可見時，此選項會在螢幕頂部顯示提示符號的最後一行，以及產生輸出的指令。"
          }
        }
      }
    },
