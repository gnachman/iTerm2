    "5Es-9v-v1s.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Use “tmux” profile rather than profile of the connecting session\"; ObjectID = \"5Es-9v-v1s\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použít profil „tmux“ místo profilu připojující se relace"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug profilen “tmux” i stedet for profilen for den forbindende session"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil „tmux“ verwenden statt des Profils der verbindenden Sitzung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use “tmux” profile rather than profile of the connecting session"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar el perfil “tmux” en lugar del perfil de la sesión que se conecta"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä ”tmux”-profiilia yhdistävän istunnon profiilin sijaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le profil « tmux » plutôt que celui de la session de connexion"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il profilo “tmux” invece del profilo della sessione che si connette"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続元セッションのプロファイルではなく「tmux」プロファイルを使用"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결하는 세션의 프로파일 대신 “tmux” 프로파일 사용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk profilen «tmux» i stedet for profilen til økten som kobler til"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik het profiel ‘tmux’ in plaats van het profiel van de verbindende sessie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj profilu „tmux” zamiast profilu łączącej się sesji"
