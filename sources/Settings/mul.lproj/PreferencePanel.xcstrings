    "Heb-gk-qk8.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"To ensure privacy, the AI features in iTerm2 require the installation of a plugin.\"; ObjectID = \"Heb-gk-qk8\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli ochraně soukromí vyžadují funkce AI v iTerm2 instalaci plug-inu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at sikre anonymitet kræver AI-funktionerne i iTerm2, at et plugin installeres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Privatsphäre zu gewährleisten, erfordern die KI-Funktionen in iTerm2 die Installation eines Plugins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To ensure privacy, the AI features in iTerm2 require the installation of a plugin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantizar la privacidad, las funciones de IA de iTerm2 requieren instalar un plugin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksityisyyden varmistamiseksi iTerm2:n AI-toiminnot vaativat liitännäisen asentamisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour garantir la confidentialité, les fonctions d’IA d’iTerm2 nécessitent l’installation d’un module."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per garantire la privacy, le funzioni di IA di iTerm2 richiedono l’installazione di un plug-in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーを確保するため、iTerm2のAI機能を使用するにはプラグインのインストールが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 정보 보호를 위해 iTerm2의 AI 기능을 사용하려면 플러그인을 설치해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å sikre personvernet krever KI-funksjonene i iTerm2 at et tillegg installeres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om je privacy te waarborgen, vereisen de AI-functies in iTerm2 de installatie van een plug-in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zapewnić prywatność, funkcje AI w iTerm2 wymagają zainstalowania wtyczki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para garantir a privacidade, os recursos de IA no iTerm2 exigem a instalação de um plugin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для обеспечения конфиденциальности функции ИИ в iTerm2 требуют установки плагина."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zaistenie súkromia vyžadujú funkcie AI v iTerm2 inštaláciu pluginu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaradi zasebnosti funkcije AI v aplikaciji iTerm2 zahtevajo namestitev vtičnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att säkerställa integriteten kräver AI-funktionerna i iTerm2 att ett plugin installeras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizliliği sağlamak için iTerm2’deki YZ özellikleri bir eklentinin yüklenmesini gerektirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để đảm bảo quyền riêng tư, các tính năng AI trong iTerm2 yêu cầu cài đặt một trình cắm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为确保隐私，iTerm2 的 AI 功能需要安装插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為確保隱私權，iTerm2 中的 AI 功能需要安裝外掛程式。"
          }
        }
      }
    },
