    "WVK-xs-N2h.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, small horizontal cursor movements are animated. Not available for block cursors.\"; ObjectID = \"WVK-xs-N2h\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden kleine horizontale Cursorbewegungen animiert. Nicht verfügbar für Blockcursor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, small horizontal cursor movements are animated. Not available for block cursors."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、小さな水平方向のカーソル移動がアニメーション化されます。ブロックカーソルでは使用できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, pequenos movimentos horizontais do cursor são animados. Não disponível para cursores em bloco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, небольшие горизонтальные перемещения курсора анимируются. Недоступно для блочных курсоров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，小幅水平光标移动会带有动画。方块光标不可用。"
          }
        }
      }
    },
    "x0T-MM-6tL.title" : {
