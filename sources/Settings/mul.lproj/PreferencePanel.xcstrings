    "5144.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Draws a border around the window when the OS otherwise would not. This is effective in light mode or when the window contains a transparent pane.\"; ObjectID = \"5144\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreslí kolem okna okraj, když by to systém jinak neudělal. Účinné je to ve světlém režimu nebo když okno obsahuje průhledné podokno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner en kant rundt om vinduet, når styresystemet ellers ikke ville. Dette virker i lys tilstand, eller når vinduet indeholder en gennemsigtig rude."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet einen Rahmen um das Fenster, wenn das Betriebssystem dies sonst nicht tun würde. Dies ist im hellen Modus wirksam oder wenn das Fenster einen transparenten Bereich enthält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Draws a border around the window when the OS otherwise would not. This is effective in light mode or when the window contains a transparent pane."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja un borde alrededor de la ventana cuando el sistema operativo no lo haría. Es eficaz en modo claro o cuando la ventana contiene un panel transparente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtää ikkunan ympärille reunuksen, kun käyttöjärjestelmä ei muuten tekisi sitä. Tämä toimii vaaleassa tilassa tai kun ikkuna sisältää läpinäkyvän paneelin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine une bordure autour de la fenêtre lorsque le système ne le ferait pas. C’est efficace en mode clair ou lorsque la fenêtre contient un volet transparent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna un bordo attorno alla finestra quando il sistema operativo non lo farebbe. È efficace in modalità chiara o quando la finestra contiene un riquadro trasparente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSが通常描画しない場合でも、ウインドウの周囲に境界線を描画します。これはライトモードの場合や、ウインドウに透明なペインが含まれる場合に効果があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OS가 기본적으로 그리지 않는 경우에도 윈도우 주위에 테두리를 그립니다. 라이트 모드이거나 윈도우에 투명한 패널이 있을 때 효과적입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegner en kant rundt vinduet når operativsystemet ellers ikke ville gjort det. Dette virker i lys modus eller når vinduet inneholder en gjennomsiktig rute."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekent een rand om het venster als het besturingssysteem dat anders niet doet. Dit werkt goed in de lichte modus of als het venster een transparant paneel bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje obramowanie wokół okna, gdy system by go nie narysował. Działa w trybie jasnym lub gdy okno zawiera przezroczysty panel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha uma borda ao redor da janela quando o sistema operacional não o faria. Isto é eficaz no modo claro ou quando a janela contém um painel transparente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует рамку вокруг окна, когда система иначе не стала бы этого делать. Это полезно в светлом режиме или когда окно содержит прозрачную панель."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakreslí okolo okna okraj, keď by ho systém inak nezobrazil. Funguje vo svetlom režime alebo keď okno obsahuje priehľadný panel."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nariše obrobo okoli okna, kadar je sistem sicer ne bi. To je učinkovito v svetlem načinu ali kadar okno vsebuje prosojno podokno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritar en kant runt fönstret när operativsystemet annars inte skulle göra det. Detta fungerar bra i ljust läge eller när fönstret innehåller en transparent panel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşletim sistemi çizmediğinde pencerenin çevresine bir kenarlık çizer. Açık modda veya pencere saydam bir bölme içerdiğinde etkilidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẽ viền quanh cửa sổ khi hệ điều hành không tự vẽ. Hiệu quả ở chế độ sáng hoặc khi cửa sổ có khung trong suốt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在操作系统不绘制边框时为窗口绘制边框。在浅色模式或窗口包含透明窗格时有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在作業系統原本不會繪製邊框時，為視窗繪製邊框。在淺色模式下，或視窗包含透明窗格時有效。"
          }
        }
      }
    },
