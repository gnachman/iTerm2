    "rqn-Ng-qvq.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Send \\\\n rather than \\\\r to terminate commands\"; ObjectID = \"rqn-Ng-qvq\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K ukončení příkazů odesílat \\n místo \\r"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send \\n i stedet for \\r for at afslutte kommandoer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende \\n anstelle von \\r, um Befehle zu beenden"
