    "UWv-op-rJa.ibShadowedToolTip" : {
      "comment" : "Class = \"NSTextField\"; ibShadowedToolTip = \"In the Minimal theme, tabs can show a subtitle as a second line of text.\"; ObjectID = \"UWv-op-rJa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V motivu Minimalistický mohou panely zobrazovat podnadpis jako druhý řádek textu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temaet Minimal kan faner vise en undertitel som en ekstra tekstlinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Minimal-Thema können Tabs einen Untertitel als zweite Textzeile anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "In the Minimal theme, tabs can show a subtitle as a second line of text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el tema Minimalista, las pestañas pueden mostrar un subtítulo como segunda línea de texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimaalinen-teemassa välilehdet voivat näyttää alaotsikon toisena tekstirivinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le thème Minimal, les onglets peuvent afficher un sous-titre sur une seconde ligne de texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel tema Minimale, i pannelli possono mostrare un sottotitolo come seconda riga di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimalテーマでは、タブに2行目のテキストとしてサブタイトルを表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미니멀 테마에서는 탭의 두 번째 줄에 부제목을 표시할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Minimal-temaet kan faner vise en undertittel som en andre tekstlinje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het thema Minimaal kunnen tabbladen een ondertitel als tweede tekstregel tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W motywie Minimalny karty mogą pokazywać podtytuł jako drugi wiersz tekstu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tema Minimal, as abas podem mostrar um subtítulo como segunda linha de texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В теме «Минимальная» вкладки могут показывать подзаголовок в виде второй строки текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V téme Minimalistická môžu taby zobrazovať podnadpis ako druhý riadok textu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V temi Minimalna lahko zavihki prikažejo podnaslov kot drugo vrstico besedila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I temat Minimal kan flikar visa en undertitel som en andra textrad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal temada sekmeler, ikinci bir metin satırı olarak alt başlık gösterebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong chủ đề Tối giản, tab có thể hiển thị phụ đề ở dòng văn bản thứ hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在极简主题中，标签页可以在第二行显示副标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在極簡主題中，標籤頁可在第二行顯示副標題。"
          }
        }
      }
    },
