    "6279.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Items are added to the context menu when you right click on text matching this smart selection.\"; ObjectID = \"6279\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els ítems s’afegeixen al menú contextual quan fas clic amb el botó dret en un text que coincideix amb aquesta selecció intel·ligent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky se přidají do kontextové nabídky, když kliknete pravým tlačítkem na text odpovídající tomuto chytrému výběru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emner føjes til lokalmenuen, når du højreklikker på tekst, der matcher denne smarte markering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge werden dem Kontextmenü hinzugefügt, wenn Sie mit der rechten Maustaste auf Text klicken, der dieser intelligenten Auswahl entspricht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στοιχεία προστίθενται στο μενού περιβάλλοντος όταν κάνετε δεξί κλικ σε κείμενο που αντιστοιχεί σε αυτή την έξυπνη επιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items are added to the context menu when you right click on text matching this smart selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ítems se añaden al menú contextual cuando haces clic derecho en un texto que coincide con esta selección inteligente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos se agregan al menú contextual cuando haces clic derecho en un texto que coincide con esta selección inteligente."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos se agregan al menú contextual cuando haces clic derecho en un texto que coincide con esta selección inteligente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohteet lisätään kontekstivalikkoon, kun klikkaat hiiren oikealla painikkeella tähän älykkääseen valintaan osuvaa tekstiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments sont ajoutés au menu contextuel lorsque vous faites un clic droit sur du texte correspondant à cette sélection intelligente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments sont ajoutés au menu contextuel lorsque vous faites un clic droit sur du texte correspondant à cette sélection intelligente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्मार्ट चयन से मेल खाने वाले टेक्स्ट पर राइट-क्लिक करने पर आइटम संदर्भ मेन्यू में जोड़े जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavke se dodaju u kontekstni izbornik kad desnom tipkom kliknete na tekst koji se podudara s ovim pametnim odabirom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elemek akkor kerülnek a helyi menübe, ha jobb gombbal kattint az intelligens kijelölésnek megfelelő szövegre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item ditambahkan ke menu konteks saat Anda klik kanan pada teks yang cocok dengan pilihan pintar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi vengono aggiunti al menu contestuale quando fai clic con il tasto destro su un testo che corrisponde a questa selezione intelligente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマート選択に一致するテキストを右クリックすると、コンテキストメニューに項目が追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스마트 선택과 일치하는 텍스트를 오른쪽 클릭하면 컨텍스트 메뉴에 항목이 추가됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item ditambah pada menu konteks apabila anda klik kanan pada teks yang sepadan dengan pilihan pintar ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekter legges til i kontekstmenyen når du høyreklikker på tekst som samsvarer med denne smarte markeringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderdelen worden aan het contextmenu toegevoegd als je met de rechtermuisknop klikt op tekst die overeenkomt met deze slimme selectie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementy są dodawane do menu kontekstowego po kliknięciu prawym przyciskiem tekstu pasującego do tego inteligentnego zaznaczania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens são adicionados ao menu de contexto quando você clica com o botão direito em texto que corresponde a esta seleção inteligente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens são adicionados ao menu de contexto quando clica com o botão direito em texto que corresponde a esta seleção inteligente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Articolele sunt adăugate în meniul contextual când faceți clic dreapta pe un text care se potrivește cu această selecție inteligentă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункты добавляются в контекстное меню, когда вы щёлкаете правой кнопкой мыши по тексту, соответствующему этому умному выделению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky sa pridajú do kontextového menu, keď kliknete pravým tlačidlom na text zodpovedajúci tomuto inteligentnému výberu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementi se dodajo v kontekstni meni, ko z desno tipko kliknete besedilo, ki ustreza temu pametnemu izboru."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekt läggs till i kontextmenyn när du högerklickar på text som matchar den här smarta markeringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการจะถูกเพิ่มในเมนูบริบทเมื่อคุณคลิกขวาที่ข้อความที่ตรงกับการเลือกอัจฉริยะนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu akıllı seçimle eşleşen metne sağ tıkladığınızda öğeler bağlam menüsüne eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункти додаються до контекстного меню, коли ви клацаєте правою кнопкою на тексті, що відповідає цьому розумному вибору."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục được thêm vào menu ngữ cảnh khi bạn bấm chuột phải vào văn bản khớp với quy tắc chọn thông minh này."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在匹配此智能选择的文本上右键点按时，这些项目会添加到上下文菜单。"
