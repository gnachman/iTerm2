    "ydH-wX-BJI.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"When pasting a dropped filename, wrap it in double quotes\"; ObjectID = \"ydH-wX-BJI\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
