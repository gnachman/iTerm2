    "fXe-U0-Ddw.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Disabled by “⌘-Click Opens Filename/URL” setting in Pointer settings\"; ObjectID = \"fXe-U0-Ddw\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
