    "awA-hH-ziY.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For this setting to take effect you must disable \\\"Native full screen windows\\\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems.\"; ObjectID = \"awA-hH-ziY\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perquè aquesta opció tingui efecte, has de desactivar “Finestres natives en pantalla completa” a Configuració > General. Si aquesta opció està activada, la barra de menús continuarà visible. És útil en sistemes amb diversos monitors."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby se toto nastavení projevilo, musíte v části „Nastavení > Obecné“ vypnout „Nativní okna celé obrazovky“. Je-li toto nastavení zapnuto, řádek nabídek zůstane viditelný. To je užitečné u systémů s více monitory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at denne indstilling får effekt, skal du slå “Native vinduer i fuld skærm” fra i Indstillinger > Generelt. Når denne indstilling er slået til, forbliver menulinjen synlig. Det er nyttigt på systemer med flere skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit diese Einstellung wirksam wird, müssen Sie „Native Vollbildfenster“ unter Einstellungen > Allgemein deaktivieren. Wenn diese Einstellung aktiviert ist, bleibt die Menüleiste sichtbar. Dies ist nützlich für Systeme mit mehreren Bildschirmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να ισχύσει αυτή η ρύθμιση, πρέπει να απενεργοποιήσετε την επιλογή «Παράθυρα εγγενούς πλήρους οθόνης» στις Ρυθμίσεις > Γενικά. Αν αυτή η ρύθμιση είναι ενεργοποιημένη, η γραμμή μενού θα παραμένει ορατή. Είναι χρήσιμο σε συστήματα με πολλές οθόνες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this setting to take effect you must disable \"Native full screen windows\" in Settings > General. If this setting is enabled, the menu bar will remain visible. This is useful for multi-monitor systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que este ajuste surta efecto, debes desactivar “Ventanas nativas en pantalla completa” en Ajustes > General. Si este ajuste está activado, la barra de menús seguirá visible. Es útil en sistemas con varios monitores."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que esta configuración surta efecto, debes desactivar “Ventanas nativas en pantalla completa” en Configuración > General. Si esta configuración está activado, la barra de menús seguirá visible. Es útil en sistemas con varios monitores."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que esta configuración surta efecto, debes desactivar “Ventanas nativas en pantalla completa” en Configuración > General. Si esta configuración está activado, la barra de menús seguirá visible. Es útil en sistemas con varios monitores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämän asetuksen käyttöön tarvitaan, että poistat käytöstä asetuksen ”Natiivit koko näytön ikkunat” kohdassa Asetukset > Yleiset. Jos tämä asetus on käytössä, valikkorivi pysyy näkyvissä. Tämä on hyödyllistä usean näytön järjestelmissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que ce réglage prenne effet, vous devez désactiver « Fenêtres en plein écran natif » dans Réglages > Général. Si ce réglage est activé, la barre des menus reste visible. C’est utile avec plusieurs moniteurs."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que ce réglage prenne effet, vous devez désactiver « Fenêtres en plein écran natif » dans Réglages > Général. Si ce réglage est activé, la barre des menus reste visible. C’est utile avec plusieurs écrans."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सेटिंग को प्रभावी करने के लिए सेटिंग > सामान्य में “नेटिव फ़ुल स्क्रीन विंडो” अक्षम करना ज़रूरी है। यह सेटिंग सक्षम होने पर मेन्यू बार दिखाई देता रहेगा। यह एकाधिक मॉनिटर वाले सिस्टम के लिए उपयोगी है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da bi ova postavka imala učinak, morate onemogućiti “Izvorni prozori preko cijelog zaslona” u Postavke > Općenito. Ako je ova postavka omogućena, traka s izbornicima ostat će vidljiva. To je korisno na sustavima s više monitora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahhoz, hogy ez a beállítás érvénybe lépjen, le kell tiltania a „Natív teljes képernyős ablakok” beállítást a „Beállítások > Általános” helyen. Ha ez a beállítás engedélyezve van, a menüsor látható marad. Ez többmonitoros rendszereken hasznos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar pengaturan ini berlaku, Anda harus menonaktifkan “Jendela layar penuh native” di Pengaturan > Umum. Jika pengaturan ini diaktifkan, bar menu akan tetap terlihat. Ini berguna untuk sistem dengan beberapa monitor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché questa impostazione abbia effetto, devi disabilitare “Finestre native a tutto schermo” in Impostazioni > Generali. Se questa impostazione è attiva, la barra dei menu rimane visibile. È utile nei sistemi con più monitor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定を有効にするには、設定 > 一般で「ネイティブフルスクリーンウィンドウ」を無効にする必要があります。有効にすると、メニューバーが表示されたままになります。これはマルチモニター環境で便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정을 적용하려면 설정 > 일반에서 \"네이티브 전체 화면 윈도우\"를 꺼야 합니다. 이 설정을 켜면 메뉴 막대가 계속 표시됩니다. 여러 모니터를 사용하는 시스템에서 유용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supaya seting ini berkuat kuasa, anda mesti menyahdayakan “Tetingkap skrin penuh natif” dalam Seting > Umum. Jika seting ini didayakan, bar menu akan kekal kelihatan. Ini berguna untuk sistem berbilang monitor."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at denne innstillingen skal tre i kraft, må du deaktivere «Innebygde fullskjermvinduer» i «Innstillinger > Generelt». Hvis denne innstillingen er aktivert, forblir menylinjen synlig. Dette er nyttig på systemer med flere skjermer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om deze instelling te laten werken, moet je ‘Native schermvullende vensters’ uitschakelen in Instellingen > Algemeen. Als deze instelling is ingeschakeld, blijft de menubalk zichtbaar. Dit is handig bij systemen met meerdere beeldschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby to ustawienie zadziałało, wyłącz opcję „Natywne okna pełnoekranowe” w Ustawienia > Ogólne. Gdy to ustawienie jest włączone, pasek menu pozostaje widoczny. Jest to przydatne w systemach z wieloma monitorami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que este ajuste tenha efeito, você deve desativar “Janelas em tela cheia nativas” em Ajustes > Geral. Se este ajuste estiver ativado, a barra de menus permanecerá visível. Isto é útil para sistemas com vários monitores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que esta definição tenha efeito, tem de desativar “Janelas em ecrã completo nativas” em Definições > Geral. Se esta definição estiver ativada, a barra de menus permanecerá visível. Isto é útil para sistemas com vários monitores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru ca această configurare să aibă efect, trebuie să dezactivați „Ferestre native pe tot ecranul” în Configurări > General. Dacă această configurare este activată, bara de meniu rămâne vizibilă. Este utilă pe sistemele cu mai multe monitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы этот параметр вступил в силу, необходимо отключить «Нативные полноэкранные окна» в разделе Настройки > Основные. Если этот параметр включён, строка меню останется видимой. Это полезно для систем с несколькими мониторами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby toto nastavenie fungovalo, musíte vypnúť „Natívne okná na celej obrazovke“ v časti „Nastavenia > Všeobecné“. Ak je toto nastavenie zapnuté, lišta menu zostane viditeľná. Je to užitočné pri systémoch s viacerými monitormi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da bo ta nastavitev delovala, morate v »Nastavitve > Splošno« onemogočiti »Izvorna okna v celozaslonskem načinu«. Če je ta nastavitev omogočena, bo menijska vrstica ostala vidna. To je uporabno v sistemih z več monitorji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att den här inställningen ska fungera måste du avaktivera ”Inbyggda helskärmsfönster” i Inställningar > Allmänt. Om den här inställningen är aktiverad förblir menyraden synlig. Det är användbart på system med flera skärmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อให้การตั้งค่านี้มีผล คุณต้องปิดใช้ “หน้าต่างเต็มหน้าจอแบบเนทีฟ” ใน การตั้งค่า > ทั่วไป หากเปิดใช้การตั้งค่านี้ แถบเมนูจะยังคงแสดงอยู่ ซึ่งมีประโยชน์กับระบบที่มีหลายจอภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayarın etkili olması için Ayarlar > Genel bölümünde “Yerel tam ekran pencereler” seçeneğini devre dışı bırakmalısınız. Bu ayar etkinse menü çubuğu görünür kalır. Birden çok monitörlü sistemlerde kullanışlıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб цей параметр діяв, вимкніть «Нативні повноекранні вікна» в «Параметри > Загальні». Якщо цей параметр увімкнено, смуга меню залишатиметься видимою. Це корисно в системах із кількома моніторами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để cài đặt này có hiệu lực, bạn phải tắt “Cửa sổ toàn màn hình gốc” trong Cài đặt > Chung. Nếu cài đặt này được bật, thanh menu sẽ vẫn hiển thị. Điều này hữu ích với hệ thống nhiều màn hình."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使此设置生效，必须在“设置 > 通用”中停用“原生全屏幕窗口”。如果启用此设置，菜单栏会保持可见。这对多显示器系统很有用。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要使此設定生效，必須停用「設定 > 一般」中的「原生全螢幕視窗」。啟用此設定後，選單列會保持顯示。這對多螢幕系統很有用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使此设置生效，你必须停用“设置 > 通用”中的“原生全屏幕窗口”。启用此设置后，菜单栏将保持可见。这对多显示器系统很有用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使此設定生效，必須停用「設定 > 一般」中的「原生全螢幕視窗」。啟用此設定後，選單列會保持顯示。這對多螢幕系統很有用。"
          }
        }
      }
    },
    "ax2-RO-lUC.title" : {
