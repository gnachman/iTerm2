    "5126.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment.\"; ObjectID = \"5126\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si treballes sobretot en idiomes d’Àsia oriental, això pot ser útil. Per a la majoria d’usuaris, causa desalineació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud pracujete převážně ve východoasijských jazycích, může to být užitečné. Většině uživatelů to způsobuje nesprávné zarovnání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du hovedsageligt arbejder på østasiatiske sprog, kan dette være nyttigt. For de fleste brugere giver det forkert justering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie hauptsächlich in ostasiatischen Sprachen arbeiten, kann dies hilfreich sein. Für die meisten Benutzer führt es zu einer falschen Ausrichtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν εργάζεστε κυρίως σε γλώσσες της Ανατολικής Ασίας, αυτό μπορεί να βοηθήσει. Για τους περισσότερους χρήστες προκαλεί κακή στοίχιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you work mostly in East Asian languages this can be helpful. For most users, it causes misalignment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trabajas sobre todo en idiomas de Asia oriental, esto puede resultar útil. Para la mayoría de los usuarios, causa desalineación."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trabajas sobre todo en idiomas de Asia oriental, esto puede resultar útil. Para la mayoría de los usuarios, causa desalineación."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trabajas sobre todo en idiomas de Asia oriental, esto puede resultar útil. Para la mayoría de los usuarios, causa desalineación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä voi olla hyödyllinen, jos työskentelet pääasiassa itäaasialaisilla kielillä. Useimmilla käyttäjillä se aiheuttaa kohdistusvirheitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous travaillez surtout dans des langues d’Asie de l’Est, cela peut être utile. Pour la plupart des utilisateurs, cela provoque un désalignement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous travaillez surtout dans des langues d’Asie de l’Est, cela peut être utile. Pour la plupart des utilisateurs, cela provoque un désalignement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि आप ज़्यादातर पूर्वी एशियाई भाषाओं में काम करते हैं, तो यह उपयोगी हो सकता है। अधिकांश यूज़र के लिए इससे संरेखण बिगड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako uglavnom radite na istočnoazijskim jezicima, ovo može pomoći. Većini korisnika uzrokuje neporavnatost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha főként kelet-ázsiai nyelveken dolgozik, ez hasznos lehet. A legtöbb felhasználónál elcsúszást okoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Anda sebagian besar bekerja dalam bahasa Asia Timur, ini dapat membantu. Bagi kebanyakan pengguna, ini menyebabkan ketidaksejajaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lavori soprattutto in lingue dell’Asia orientale, questo può essere utile. Per la maggior parte degli utenti causa disallineamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主に東アジア言語で作業する場合に役立ちます。ほとんどのユーザーにとっては、位置ずれの原因になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주로 동아시아 언어로 작업하는 경우 유용할 수 있습니다. 대부분의 사용자에게는 정렬이 어긋나는 원인이 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda kebanyakannya bekerja dalam bahasa Asia Timur, ini mungkin membantu. Bagi kebanyakan pengguna, ini menyebabkan salah jajaran."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan være nyttig hvis du hovedsakelig jobber på østasiatiske språk. For de fleste brukere gir det feiljustering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je vooral in Oost-Aziatische talen werkt, kan dit handig zijn. Voor de meeste gebruikers veroorzaakt het uitlijningsproblemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli pracujesz głównie w językach wschodnioazjatyckich, może to być pomocne. U większości użytkowników powoduje niewyrównanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você trabalha principalmente com idiomas do Leste Asiático, isto pode ser útil. Para a maioria dos usuários, causa desalinhamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se trabalha principalmente com idiomas do Leste Asiático, isto pode ser útil. Para a maioria dos utilizadores, causa desalinhamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă lucrați mai ales în limbi est-asiatice, aceasta poate fi utilă. Pentru majoritatea utilizatorilor, provoacă nealiniere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы в основном работаете с восточноазиатскими языками, это может быть полезно. Для большинства пользователей это приводит к смещению текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak pracujete hlavne vo východoázijských jazykoch, môže to pomôcť. Pre väčšinu užívateľov spôsobuje nezarovnanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če delate predvsem v vzhodnoazijskih jezikih, je to lahko koristno. Pri večini uporabnikov povzroči neporavnanost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du huvudsakligen arbetar på östasiatiska språk kan detta vara till hjälp. För de flesta användare ger det felaktig justering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากคุณทำงานกับภาษาเอเชียตะวันออกเป็นหลัก ตัวเลือกนี้อาจมีประโยชน์ สำหรับผู้ใช้ส่วนใหญ่ ตัวเลือกนี้จะทำให้การจัดแนวเพี้ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağırlıklı olarak Doğu Asya dillerinde çalışıyorsanız bu yararlı olabilir. Çoğu kullanıcıda hizalama bozukluğuna neden olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви здебільшого працюєте східноазійськими мовами, це може бути корисним. Для більшості користувачів це спричиняє розбіжності вирівнювання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn chủ yếu làm việc bằng các ngôn ngữ Đông Á, tùy chọn này có thể hữu ích. Với đa số người dùng, nó gây lệch hàng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你主要使用东亚语言，这会有所帮助。对大多数用户来说，这会导致对不齐。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果主要使用東亞語言，這可能會有幫助。對大多數用户而言，這會造成對不齊。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你主要使用东亚语言，这可能有所帮助。对大多数用户而言，它会导致错位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果主要使用東亞語言，這可能會有幫助。對大多數使用者而言，這會造成對不齊。"
          }
        }
      }
    },
