    "Dt4-v9-hNo.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order.\"; ObjectID = \"Dt4-v9-hNo\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazí arabštinu, hebrejštinu a další písma psaná zprava doleva ve správném vizuálním pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser arabisk, hebraisk og andre skriftsystemer, der læses fra højre mod venstre, i den rigtige visuelle rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Arabisch, Hebräisch und andere rechtsläufige Schriften in der richtigen visuellen Reihenfolge an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Displays Arabic, Hebrew, and other right-to-left scripts in their correct visual order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el árabe, el hebreo y otras escrituras de derecha a izquierda en su orden visual correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää arabian, heprean ja muut oikealta vasemmalle kirjoitettavat kirjoitusjärjestelmät oikeassa visuaalisessa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l’arabe, l’hébreu et les autres écritures de droite à gauche dans leur ordre visuel correct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra arabo, ebraico e altre scritture da destra a sinistra nel corretto ordine visivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラビア語、ヘブライ語など、右から左に書く文字を正しい表示順で表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아랍어, 히브리어 등 오른쪽에서 왼쪽으로 쓰는 문자를 올바른 시각적 순서로 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser arabisk, hebraisk og andre høyre-til-venstre-skrifter i riktig visuell rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont Arabische, Hebreeuwse en andere van rechts naar links geschreven talen in de juiste visuele volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla pismo arabskie, hebrajskie i inne pisane od prawej do lewej w poprawnej kolejności wizualnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibe árabe, hebraico e outras escritas da direita para a esquerda na ordem visual correta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображает арабский, иврит и другие письменности с направлением справа налево в правильном визуальном порядке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje arabské, hebrejské a ďalšie písma písané sprava doľava v správnom vizuálnom poradí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaže arabsko, hebrejsko in druge pisave od desne proti levi v pravilnem vizualnem vrstnem redu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar arabiska, hebreiska och andra skriftspråk som läses från höger till vänster i rätt visuell ordning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arapça, İbranice ve diğer sağdan sola yazılan betikleri doğru görsel sırada gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
