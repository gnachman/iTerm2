    "fRb-hJ-joB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"You probably don't want this; most systems use ^? (ASCII 127) for backspace. Changing this setting affects the key mappings in the table above.\"; ObjectID = \"fRb-hJ-joB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravděpodobně to nechcete; většina systémů používá pro backspace ^? (ASCII 127). Změna tohoto nastavení ovlivní přiřazení kláves v tabulce výše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det vil du sandsynligvis ikke have. De fleste systemer bruger ^? (ASCII 127) til slet tilbage. Hvis du ændrer denne indstilling, påvirkes tastetildelingerne i tabellen ovenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das wollen Sie wahrscheinlich nicht; die meisten Systeme verwenden ^? (ASCII 127) für die Rücktaste. Das Ändern dieser Einstellung wirkt sich auf die Tastenzuordnungen in der obigen Tabelle aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You probably don't want this; most systems use ^? (ASCII 127) for backspace. Changing this setting affects the key mappings in the table above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probablemente no quieras esto; la mayoría de los sistemas usan ^? (ASCII 127) para el retroceso. Cambiar este ajuste afecta a las asignaciones de teclas de la tabla anterior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et luultavasti halua tätä; useimmat järjestelmät käyttävät askelpalauttimelle merkkiä ^? (ASCII 127). Tämän asetuksen muuttaminen vaikuttaa yllä olevan taulukon näppäinmäärityksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne le souhaitez probablement pas ; la plupart des systèmes utilisent ^? (ASCII 127) pour la touche Retour arrière. Modifier ce réglage affecte les associations de touches du tableau ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente non ti serve; la maggior parte dei sistemi usa ^? (ASCII 127) per backspace. La modifica di questa impostazione influisce sulle associazioni tasti nella tabella qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おそらくこれは望まないでしょう。ほとんどのシステムでは、バックスペースに^? (ASCII 127)を使用します。この設定を変更すると、上の表のキーマッピングに影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 필요하지 않을 가능성이 높습니다. 대부분의 시스템은 백스페이스에 ^?(ASCII 127)를 사용합니다. 이 설정을 변경하면 위 표의 키 매핑에 영향을 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil sannsynligvis ikke ha dette; de fleste systemer bruker ^? (ASCII 127) for rettetast. Endring av denne innstillingen påvirker tastetilordningene i tabellen ovenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wilt dit waarschijnlijk niet; de meeste systemen gebruiken ^? (ASCII 127) voor backspace. Als je deze instelling wijzigt, heeft dat invloed op de toetstoewijzingen in de bovenstaande tabel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawdopodobnie tego nie chcesz; większość systemów używa ^? (ASCII 127) dla Backspace. Zmiana tego ustawienia wpływa na przypisania klawiszy w tabeli powyżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você provavelmente não quer isto; a maioria dos sistemas usa ^? (ASCII 127) para o backspace. Alterar este ajuste afeta os mapeamentos de teclas na tabela acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вероятно, вам это не нужно; в большинстве систем для backspace используется ^? (ASCII 127). Изменение этой настройки влияет на привязки клавиш в таблице выше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravdepodobne to nechcete; väčšina systémov používa pre backspace ^? (ASCII 127). Zmena tohto nastavenia ovplyvní priradenia klávesov v tabuľke vyššie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tega verjetno ne želite; večina sistemov za backspace uporablja ^? (ASCII 127). Sprememba te nastavitve vpliva na dodelitve tipk v zgornji tabeli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vill förmodligen inte ha detta; de flesta system använder ^? (ASCII 127) för backsteg. Om du ändrar den här inställningen påverkas tangentkopplingarna i tabellen ovan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muhtemelen bunu istemezsiniz; çoğu sistem geri silme için ^? (ASCII 127) kullanır. Bu ayarı değiştirmek yukarıdaki tablodaki tuş atamalarını etkiler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có lẽ bạn không muốn điều này; hầu hết hệ thống dùng ^? (ASCII 127) cho backspace. Thay đổi cài đặt này ảnh hưởng đến các gán phím trong bảng ở trên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不需要这个；大多数系统使用 ^?（ASCII 127）作为退格键。更改此设置会影响上表中的按键映射。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能不需要這個；大多數系統使用 ^?（ASCII 127）作為倒退鍵。變更此設定會影響上表中的按鍵對應。"
          }
        }
      }
    },
