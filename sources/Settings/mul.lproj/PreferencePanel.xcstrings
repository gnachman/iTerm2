    "JdL-vz-9Vf.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"“Undo” can revive a closed session for up to this many seconds:\"; ObjectID = \"JdL-vz-9Vf\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Desfés” pot revifar una sessió tancada durant fins a aquest nombre de segons:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Odvolat akci“ může obnovit zavřenou relaci nejdéle po tento počet sekund:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Fortryd” kan genoplive en lukket session i op til så mange sekunder:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden, in denen „Rückgängig“ eine geschlossene Sitzung wiederherstellen kann:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Αναίρεση» μπορεί να επαναφέρει μια κλειστή συνεδρία για έως τόσα δευτερόλεπτα:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Undo” can revive a closed session for up to this many seconds:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Deshacer” puede revivir una sesión cerrada durante hasta esta cantidad de segundos:"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Deshacer” puede revivir una sesión cerrada durante hasta esta cantidad de segundos:"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Deshacer” puede revivir una sesión cerrada durante hasta esta cantidad de segundos:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Peru” voi herättää suljetun istunnon henkiin enintään näin monen sekunnin ajan:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Annuler » peut rétablir une session fermée jusqu’à ce nombre de secondes :"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Annuler » peut rétablir une session fermée jusqu’à ce nombre de secondes :"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“पहले जैसा करें” बंद किए गए सत्र को इतने सेकंड तक वापस ला सकता है :"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Poništi” može oživjeti zatvorenu sesiju najviše ovoliko sekundi:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Visszavonás” legfeljebb ennyi másodpercig állíthat vissza egy bezárt munkamenetet:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Urung” dapat menghidupkan kembali sesi yang ditutup hingga sejumlah detik ini:"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secondi entro cui “Annulla” può riaprire una sessione chiusa:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「元に戻す」で閉じたセッションを復元できる最大秒数："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“실행 취소”로 닫힌 세션을 되살릴 수 있는 최대 시간(초):"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Buat Asal” boleh menghidupkan semula sesi yang ditutup sehingga bilangan saat ini:"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Angre» kan gjenopprette en lukket økt i opptil så mange sekunder:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Herstel’ kan een gesloten sessie tot dit aantal seconden terughalen:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Cofnij” może przywrócić zamkniętą sesję przez maksymalnie tyle sekund:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “Desfazer” pode reviver uma sessão fechada por até este número de segundos:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O “Desfazer” pode reviver uma sessão fechada durante até este número de segundos:"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Infirmați” poate reînvia o sesiune închisă timp de până la atâtea secunde:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отмена» может восстановить закрытый сеанс в течение указанного числа секунд:"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Odvolať“ dokáže obnoviť zatvorenú reláciu najviac tento počet sekúnd:"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
