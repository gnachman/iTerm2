    "zI8-aW-nUw.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, and when the current display can use HDR (High Dynamic Range), the cursor is drawn at maximum brightness white, brighter than any white that normally appears in an application.\"; ObjectID = \"zI8-aW-nUw\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert und wenn das aktuelle Display HDR (High Dynamic Range) unterstützt, wird der Cursor in maximal hellem Weiß gezeichnet, heller als jedes Weiß, das normalerweise in einer Anwendung erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, and when the current display can use HDR (High Dynamic Range), the cursor is drawn at maximum brightness white, brighter than any white that normally appears in an application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、現在のディスプレイがHDR（High Dynamic Range）に対応している場合、カーソルは通常アプリケーションに表示される白よりも明るい、最大輝度の白で描画されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 현재 디스플레이가 HDR(High Dynamic Range)을 사용할 수 있을 때 커서를 최대 밝기의 흰색으로 그립니다. 이 흰색은 앱에 일반적으로 표시되는 어떤 흰색보다도 밝습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, e quando o monitor atual pode usar HDR (High Dynamic Range), o cursor é desenhado em branco de brilho máximo, mais brilhante do que qualquer branco que normalmente aparece em um aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён и текущий дисплей поддерживает HDR (расширенный динамический диапазон), курсор отрисовывается белым цветом максимальной яркости, ярче любого белого цвета, который обычно отображается в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用且当前显示器支持HDR（高动态范围）时，光标会以最大亮度白色显示，比应用程序中通常出现的任何白色更亮"
          }
        }
      }
    },
