    "GVg-ue-xgc.ibShadowedToolTip" : {
      "comment" : "Class = \"NSView\"; ibShadowedToolTip = \"This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center.\"; ObjectID = \"GVg-ue-xgc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato vizualizace zobrazuje odstín a sytost barev ANSI kromě černé a bílé. Odstín udává úhel a sytost vzdálenost od středu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne visualisering viser farvetone og kromaticitet for ANSI-farverne, undtagen sort og hvid. Farvetonen angives af vinklen og kromaticiteten af afstanden fra midten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Visualisierung zeigt den Farbton und die Sättigung der ANSI-Farben, ohne Schwarz und Weiß. Der Farbton wird durch den Winkel und die Sättigung durch den Abstand vom Zentrum angegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This visualization shows the hue and chroma of the ANSI colors, excluding black and white. Hue is given by the angle and Chroma by the distance from center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta visualización muestra el matiz y el croma de los colores ANSI, excluyendo el negro y el blanco. El matiz lo da el ángulo y el croma la distancia al centro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä visualisointi näyttää ANSI-värien sävyn ja kromaattisuuden mustaa ja valkoista lukuun ottamatta. Sävyn ilmaisee kulma ja kromaattisuuden etäisyys keskipisteestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette visualisation montre la teinte et la chroma des couleurs ANSI, hors noir et blanc. La teinte est donnée par l’angle et la chroma par la distance au centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa visualizzazione mostra tonalità e croma dei colori ANSI, esclusi nero e bianco. La tonalità è data dall’angolo e il croma dalla distanza dal centro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この可視化は、黒と白を除くANSIカラーの色相と彩度を示します。色相は角度で、彩度は中心からの距離で表されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시각화는 검은색과 흰색을 제외한 ANSI 색상의 색조와 채도를 보여 줍니다. 색조는 각도로, 채도는 중심으로부터의 거리로 나타냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne visualiseringen viser fargetone og kromatisitet for ANSI-fargene, unntatt svart og hvitt. Fargetonen angis av vinkelen og kromatisiteten av avstanden fra sentrum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze visualisatie toont de tint en chroma van de ANSI-kleuren, zonder zwart en wit. De tint wordt bepaald door de hoek en de chroma door de afstand tot het midden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wizualizacja pokazuje odcień i nasycenie kolorów ANSI, z wyłączeniem czerni i bieli. Odcień wyznacza kąt, a nasycenie odległość od środka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta visualização mostra o matiz e a croma das cores ANSI, excluindo preto e branco. O matiz é dado pelo ângulo e a croma pela distância do centro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта визуализация показывает тон и насыщенность цветов ANSI, исключая чёрный и белый. Тон задаётся углом, а насыщенность задаётся расстоянием от центра."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto vizualizácia zobrazuje odtieň a sýtosť farieb ANSI okrem čiernej a bielej. Odtieň určuje uhol a sýtosť vzdialenosť od stredu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta vizualizacija prikazuje odtenek in kromo barv ANSI, razen črne in bele. Odtenek določa kot, kroma pa razdalja od središča."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här visualiseringen visar nyans och kroma för ANSI-färgerna, exklusive svart och vitt. Nyansen anges av vinkeln och kroman av avståndet från mitten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu görselleştirme, siyah ve beyaz hariç ANSI renklerinin renk tonunu ve kromasını gösterir. Renk tonu açıyla, kroma merkezden uzaklıkla belirtilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình ảnh này cho thấy sắc độ và độ bão hòa của các màu ANSI, không gồm đen và trắng. Sắc độ được biểu diễn bằng góc và độ bão hòa bằng khoảng cách từ tâm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此可视化显示 ANSI 颜色的色相和色度（不包括黑色和白色）。色相由角度表示，色度由与中心的距离表示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此視覺化顯示 ANSI 顏色的色相與彩度（不含黑色與白色）。色相以角度表示，彩度以與中心的距離表示。"
          }
        }
      }
    },
    "gXM-xm-pfL.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"No data is sent to third parties without your explicit permission.\"; ObjectID = \"gXM-xm-pfL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez vašeho výslovného svolení se třetím stranám neodesílají žádná data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der sendes ingen data til tredjeparter uden din udtrykkelige tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Ihre ausdrückliche Zustimmung werden keine Daten an Dritte gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No data is sent to third parties without your explicit permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envían datos a terceros sin tu permiso explícito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietoja ei lähetetä kolmansille osapuolille ilman nimenomaista lupaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune donnée n’est envoyée à des tiers sans votre autorisation explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun dato viene inviato a terzi senza la tua esplicita autorizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明示的な許可なしにデータが第三者へ送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 명시적인 허락 없이는 어떤 데이터도 제3자에게 전송되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen data sendes til tredjeparter uten din uttrykkelige tillatelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder jouw uitdrukkelijke toestemming worden er geen gegevens naar derden gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadne dane nie są wysyłane stronom trzecim bez Twojej wyraźnej zgody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dado é enviado a terceiros sem a sua permissão explícita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные не передаются третьим лицам без вашего явного согласия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez vášho výslovného povolenia sa tretím stranám neodosielajú žiadne údaje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobeni podatki se ne pošljejo tretjim osebam brez vašega izrecnega dovoljenja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga data skickas till tredje part utan ditt uttryckliga tillstånd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık izniniz olmadan üçüncü taraflara hiçbir veri gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có dữ liệu nào được gửi đến bên thứ ba nếu bạn chưa cho phép rõ ràng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未经明确许可，不会向第三方发送数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未經你明確許可，不會向第三方傳送資料。"
          }
        }
      }
    },
    "H0w-Px-zqZ.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Treat ⌥ as Alt for special keys like arrows\"; ObjectID = \"H0w-Px-zqZ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Považovat ⌥ za Alt u speciálních kláves, například šipek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandl ⌥ som Alt til specialtaster som piletaster"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ bei Spezialtasten wie Pfeiltasten als Alt behandeln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Treat ⌥ as Alt for special keys like arrows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar ⌥ como Alt para teclas especiales como las flechas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsittele ⌥ Alt-näppäimenä erikoisnäppäimille, kuten nuolille"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traiter ⌥ comme Alt pour les touches spéciales comme les flèches"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratta ⌥ come Alt per i tasti speciali come le frecce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矢印キーなどの特殊キーでは⌥をAltとして扱う"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화살표 같은 특수 키에서 ⌥를 Alt로 취급"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandle ⌥ som Alt for spesialtaster som piler"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandel ⌥ als Alt voor speciale toetsen zoals pijltoetsen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traktuj ⌥ jak Alt w klawiszach specjalnych, takich jak strzałki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tratar ⌥ como Alt para teclas especiais como as setas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрабатывать ⌥ как Alt для специальных клавиш, например стрелок"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Považovať ⌥ za Alt pre špeciálne klávesy, napríklad šípky"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obravnavaj ⌥ kot Alt za posebne tipke, kot so puščice"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behandla ⌥ som Alt för specialtangenter som piltangenter"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oklar gibi özel tuşlar için ⌥ tuşunu Alt olarak ele al"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coi ⌥ như Alt cho các phím đặc biệt như phím mũi tên"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 ⌥ 视为 Alt（用于方向键等特殊按键）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 ⌥ 視為 Alt，用於方向鍵等特殊按鍵"
          }
        }
      }
    },
