    "SsU-mJ-KFc.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"You will always be prompted before data is shared.\"; ObjectID = \"SsU-mJ-KFc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před sdílením dat se vždy zobrazí dotaz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bliver altid spurgt, før data deles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden immer gefragt, bevor Daten weitergegeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You will always be prompted before data is shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre se te preguntará antes de compartir datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulta kysytään aina ennen tietojen jakamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une confirmation vous sera toujours demandée avant tout partage de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti verrà sempre chiesto prima che i dati vengano condivisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データが共有される前に、必ず確認が求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 공유하기 전에 항상 확인을 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du blir alltid spurt før data deles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt altijd gevraagd voordat gegevens worden gedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed udostępnieniem danych zawsze pojawi się pytanie o zgodę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sempre será consultado antes que os dados sejam compartilhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед тем как данные будут переданы, вам всегда будет предложено подтверждение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred zdieľaním dát sa vás vždy opýtame."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred deljenjem podatkov boste vedno vprašani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du tillfrågas alltid innan data delas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veriler paylaşılmadan önce size her zaman sorulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ luôn được hỏi trước khi dữ liệu được chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享数据前始终会提示你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享資料前一律會先提示。"
          }
        }
      }
    },
