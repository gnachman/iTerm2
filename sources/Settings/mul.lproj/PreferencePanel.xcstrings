        }
      }
    },
    "imM-Ma-mjV.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When locked, the terminal cannot change the title with a control sequence. This prevents changes you make in Session Name from being overridden.\"; ObjectID = \"imM-Ma-mjV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zamknuto, terminál nemůže měnit název pomocí řídicí sekvence. Tím se zabrání přepsání změn, které provedete v poli Název relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er låst, kan terminalen ikke ændre titlen med en kontrolsekvens. Det forhindrer, at ændringer, du foretager i Sessionsnavn, bliver overskrevet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn gesperrt, kann das Terminal den Titel nicht per Steuersequenz ändern. Dies verhindert, dass Änderungen, die Sie im Sitzungsnamen vornehmen, überschrieben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When locked, the terminal cannot change the title with a control sequence. This prevents changes you make in Session Name from being overridden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está bloqueado, la terminal no puede cambiar el título con una secuencia de control. Así se evita que se sobrescriban los cambios que hagas en Nombre de la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on lukittu, pääte ei voi muuttaa otsikkoa ohjaussarjalla. Tämä estää istunnon nimeen tekemiesi muutosten ylikirjoittamisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’il est verrouillé, le terminal ne peut pas modifier le titre avec une séquence de contrôle. Cela empêche que vos modifications dans Nom de la session soient écrasées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è bloccato, il terminale non può cambiare il titolo con una sequenza di controllo. Questo evita che le modifiche apportate in Nome della sessione vengano sovrascritte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされている場合、ターミナルは制御シーケンスでタイトルを変更できません。これにより、セッション名で行った変更が上書きされるのを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠그면 터미널이 제어 시퀀스로 제목을 변경할 수 없습니다. 이렇게 하면 세션 이름에서 변경한 내용이 덮어써지지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når tittelen er låst, kan ikke terminalen endre den med en kontrollsekvens. Dette hindrer at endringer du gjør i «Øktnavn» blir overstyrt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is vergrendeld, kan de terminal de titel niet wijzigen met een besturingsreeks. Zo worden wijzigingen die je in Sessienaam aanbrengt niet overschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest zablokowana, terminal nie może zmienić tytułu za pomocą sekwencji sterującej. Zapobiega to nadpisaniu zmian wprowadzonych w polu Nazwa sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando bloqueado, o terminal não pode alterar o título com uma sequência de controle. Isto evita que as alterações feitas em Nome da sessão sejam substituídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда заблокировано, терминал не может изменить заголовок управляющей последовательностью. Это предотвращает переопределение изменений, сделанных вами в «Имени сессии»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zamknuté, terminál nemôže zmeniť názov riadiacou sekvenciou. Tým sa zabráni prepísaniu zmien, ktoré urobíte v poli Názov relácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je zaklenjeno, terminal ne more spremeniti naslova s krmilnim zaporedjem. S tem preprečite, da bi bile spremembe, ki jih naredite v polju »Ime seje«, prepisane."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När den är låst kan terminalen inte ändra titeln med en styrsekvens. Det förhindrar att ändringar du gör i Sessionsnamn skrivs över."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitliyken terminal başlığı bir denetim dizisiyle değiştiremez. Bu, Oturum Adı alanında yaptığınız değişikliklerin ezilmesini önler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi khóa, terminal không thể thay đổi tiêu đề bằng chuỗi điều khiển. Điều này ngăn các thay đổi bạn thực hiện trong Tên phiên bị ghi đè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定时，终端不能通过控制序列更改标题。这可以防止你在“会话名称”中做的更改被覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定時，終端機無法透過控制序列變更標題。這可以防止你在「工作階段名稱」中所做的變更被覆寫。"
          }
        }
      }
    },
    "ioA-Y9-Zb4.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Status bar shows tmux status bar content, not native components\"; ObjectID = \"ioA-Y9-Zb4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
