    "4Ha-Ub-4AS.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it.\"; ObjectID = \"4Ha-Ub-4AS\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bracketed Paste teilt kompatiblen Anwendungen mit, dass Text durch einen Einfügevorgang und nicht durch Tippen eingegeben wurde. Manche Programme behandeln eingefügten Text dadurch besonders, zum Beispiel indem sie die automatische Einrückung dafür deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paste bracketing tells compatible apps that text was inserted by a paste operation rather than typing. Some programs use this to treat pastes specially, such as by not auto-indenting it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストブラケッティングは、テキストがタイピングではなくペースト操作によって挿入されたことを対応アプリに伝えます。一部のプログラムはこれを利用して、自動インデントを行わないなどペーストを特別に扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브래킷 붙여넣기는 텍스트가 타이핑이 아니라 붙여넣기로 입력되었음을 호환 앱에 알려 줍니다. 일부 프로그램은 이를 이용해 붙여넣은 텍스트를 자동 들여쓰기하지 않는 등 특별하게 처리합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bracketing de colagem informa aos apps compatíveis que o texto foi inserido por uma operação de colagem em vez de digitação. Alguns programas usam isto para tratar colagens de forma especial, por exemplo, não as indentando automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скобочная вставка сообщает совместимым приложениям, что текст был вставлен, а не введён с клавиатуры. Некоторые программы используют это, чтобы обрабатывать вставленный текст особым образом, например не применяя к нему автоотступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴括号告知兼容的应用，文本是通过粘贴操作而非键入插入的。某些程序会借此特殊处理粘贴内容，例如不自动缩进。"
          }
        }
      }
    },
