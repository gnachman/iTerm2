    "VFq-8R-NOg.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"…even for the currently running command\"; ObjectID = \"VFq-8R-NOg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…i pro právě spuštěný příkaz"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…også for den kommando, der kører lige nu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…auch für den aktuell laufenden Befehl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "…even for the currently running command"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…incluso para el comando que se está ejecutando actualmente"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…myös parhaillaan suoritettavalle komennolle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…même pour la commande en cours d’exécution"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…anche per il comando in esecuzione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…実行中のコマンドに対しても"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…현재 실행 중인 명령에도 적용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…selv for kommandoen som kjører nå"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ook voor het commando dat nu wordt uitgevoerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…nawet dla aktualnie uruchomionego polecenia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…mesmo para o comando em execução no momento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…даже для текущей выполняющейся команды"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…aj pre práve spustený príkaz"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… tudi za trenutno izvajani ukaz"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…även för kommandot som körs just nu"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…şu an çalışan komut için bile"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ngay cả với lệnh đang chạy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…即使对于当前正在运行的命令"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
