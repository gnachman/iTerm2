    "vNf-D5-cU4.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"The non-ASCII font affects all characters above code point 127.\"; ObjectID = \"vNf-D5-cU4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Písmo mimo ASCII ovlivňuje všechny znaky s kódovým bodem nad 127."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriften uden ASCII påvirker alle tegn over kodepunkt 127."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nicht-ASCII-Schrift wirkt sich auf alle Zeichen oberhalb von Codepunkt 127 aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The non-ASCII font affects all characters above code point 127."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tipo de letra no ASCII afecta a todos los caracteres por encima del punto de código 127."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei-ASCII-fontti vaikuttaa kaikkiin merkkeihin, joiden koodipiste on yli 127."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La police non ASCII s’applique à tous les caractères au-dessus du point de code 127."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il font non ASCII riguarda tutti i caratteri oltre il punto di codice 127."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非ASCIIフォントは、コードポイント127を超えるすべての文字に影響します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비ASCII 서체는 코드 포인트 127을 초과하는 모든 문자에 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke-ASCII-fonten gjelder alle tegn over kodepunkt 127."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het niet-ASCII-lettertype geldt voor alle tekens boven codepunt 127."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czcionka spoza ASCII dotyczy wszystkich znaków powyżej punktu kodowego 127."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte não ASCII afeta todos os caracteres acima do ponto de código 127."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шрифт для не-ASCII символов применяется ко всем символам с кодом выше 127."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Písmo mimo ASCII ovplyvňuje všetky znaky nad kódovým bodom 127."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisava, ki ni ASCII, vpliva na vse znake nad kodno točko 127."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typsnittet för icke-ASCII påverkar alla tecken över kodpunkt 127."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASCII olmayan font, kod noktası 127’nin üzerindeki tüm karakterleri etkiler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phông chữ không phải ASCII ảnh hưởng đến mọi ký tự có điểm mã trên 127."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非 ASCII 字体影响所有高于码点 127 的字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非 ASCII 字體會影響碼位 127 以上的所有字元。"
          }
        }
      }
    },
