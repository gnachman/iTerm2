    "6377.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If enabled, changes to font size will try to preserve session dimensions.\"; ObjectID = \"6377\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, els canvis de mida del tipus de lletra intentaran conservar les dimensions de la sessió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, změny velikosti písma se pokusí zachovat rozměry relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er slået til, forsøger ændringer af skriftstørrelsen at bevare sessionens dimensioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird bei Änderungen der Schriftgröße versucht, die Sitzungsabmessungen beizubehalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν είναι ενεργοποιημένο, οι αλλαγές στο μέγεθος γραμματοσειράς θα προσπαθούν να διατηρήσουν τις διαστάσεις της συνεδρίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los cambios en el tamaño del tipo de letra intentarán conservar las dimensiones de la sesión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los cambios en el tamaño del tipo de letra intentarán conservar las dimensiones de la sesión."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los cambios en el tamaño del tipo de letra intentarán conservar las dimensiones de la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on käytössä, fonttikoon muutokset yrittävät säilyttää istunnon mitat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les changements de taille de police tenteront de préserver les dimensions de la session."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les changements de taille de police tenteront de préserver les dimensions de la session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, फ़ॉन्ट आकार बदलने पर सत्र के आयाम बनाए रखने की कोशिश की जाएगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako je omogućeno, promjene veličine fonta pokušat će sačuvati dimenzije sesije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a betűméret módosítása megpróbálja megőrizni a munkamenet méreteit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, perubahan ukuran font akan berusaha mempertahankan dimensi sesi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, le modifiche alla dimensione del font cercheranno di mantenere le dimensioni della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、フォントサイズの変更時にセッションの寸法を維持しようとします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 서체 크기를 변경할 때 세션 크기를 유지하려고 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika didayakan, perubahan pada saiz fon akan cuba mengekalkan dimensi sesi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, prøver endringer i fontstørrelsen å beholde øktens dimensjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, proberen wijzigingen van de lettertypegrootte de afmetingen van de sessie te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ta opcja jest włączona, zmiany rozmiaru czcionki będą próbowały zachować wymiary sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, as alterações no tamanho da fonte tentarão preservar as dimensões da sessão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, as alterações no tamanho do tipo de letra tentarão preservar as dimensões da sessão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, modificările dimensiunii fontului vor încerca să păstreze dimensiunile sesiunii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
