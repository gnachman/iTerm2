    "5319.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen.\"; ObjectID = \"5319\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativní okna celé obrazovky se animovaně přesunou na vlastní plochu. Nenativní okna celé obrazovky rychle vyplní obrazovku okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native vinduer i fuld skærm animeres ind på deres eget skrivebord. Ikke-native vinduer i fuld skærm udvides hurtigt, så de udfylder vinduets skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native Vollbildfenster wechseln animiert auf einen eigenen Schreibtisch. Nicht native Vollbildfenster erweitern sich schnell, um den Bildschirm des Fensters auszufüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native full screen windows animate into their own desktop. Non-native full screen windows quickly expand to fill the window's screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas nativas en pantalla completa se animan hacia su propio escritorio. Las no nativas se expanden rápidamente para llenar la pantalla de la ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natiivit koko näytön ikkunat siirtyvät animoituna omalle työpöydälleen. Ei-natiivit koko näytön ikkunat laajenevat nopeasti täyttämään ikkunan näytön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres en plein écran natif s’animent vers leur propre bureau. Les fenêtres en plein écran non natif s’agrandissent rapidement pour remplir l’écran de la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre native a tutto schermo si animano verso la propria scrivania. Quelle non native si espandono rapidamente per riempire lo schermo della finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネイティブフルスクリーンウインドウは、専用のデスクトップへアニメーションして移動します。非ネイティブフルスクリーンウインドウは、すぐにウインドウの画面いっぱいに拡大します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네이티브 전체 화면 윈도우는 애니메이션과 함께 별도의 데스크탑으로 이동합니다. 비네이티브 전체 화면 윈도우는 윈도우가 있는 화면을 채우도록 빠르게 확장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innebygde fullskjermvinduer animeres inn på sitt eget skrivebord. Ikke-innebygde fullskjermvinduer utvides raskt for å fylle vinduets skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native schermvullende vensters worden met een animatie naar hun eigen bureaublad verplaatst. Niet-native schermvullende vensters vullen snel het scherm van het venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natywne okna pełnoekranowe są animowane do własnego biurka. Nienatywne okna pełnoekranowe szybko rozszerzają się, aby wypełnić ekran okna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas em tela cheia nativas são animadas para a própria mesa. Janelas em tela cheia não nativas expandem rapidamente para preencher a tela da janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стандартные полноэкранные окна с анимацией разворачиваются на отдельный рабочий стол. Нестандартные полноэкранные окна быстро расширяются, заполняя экран."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natívne okná na celej obrazovke sa animovane presunú na vlastnú plochu. Nenatívne okná na celej obrazovke sa rýchlo roztiahnu na obrazovku okna."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvorna okna v celozaslonskem načinu se animirano premaknejo na svoje namizje. Neizvorna okna v celozaslonskem načinu se hitro razširijo čez zaslon okna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inbyggda helskärmsfönster animeras in på sitt eget skrivbord. Icke-inbyggda helskärmsfönster expanderar snabbt för att fylla fönstrets skärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel tam ekran pencereler kendi masaüstlerine animasyonla geçer. Yerel olmayan tam ekran pencereler hızla genişleyerek pencerenin bulunduğu ekranı doldurur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ toàn màn hình gốc có hiệu ứng chuyển vào màn hình nền riêng. Cửa sổ toàn màn hình không gốc nhanh chóng mở rộng để lấp đầy màn hình của cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生全屏幕窗口会动画进入自己的桌面。非原生全屏幕窗口会快速扩展以填满窗口所在的屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生全螢幕視窗會以動畫進入自己的桌面。非原生全螢幕視窗則會快速展開以填滿視窗所在的螢幕。"
          }
        }
      }
    },
