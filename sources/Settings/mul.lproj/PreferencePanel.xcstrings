            "value" : "Domyślnie wyłącz przezroczystość w nienatywnych oknach pełnoekranowych"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar transparência para janelas em tela cheia não nativas por padrão"
          }
        },
        "ru" : {
