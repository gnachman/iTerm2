          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 종료, 재시동 및 로그아웃 시 모든 확인 끄기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver alle bekreftelser ved avslutning, omstart og utlogging av systemet"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel alle bevestigingen bij het afsluiten, herstarten en uitloggen van het systeem uit"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz wszystkie potwierdzenia przy wyłączaniu, ponownym uruchamianiu i wylogowaniu z systemu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar todas as confirmações ao desligar, reiniciar e encerrar a sessão do sistema"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не подтверждать выключение, перезагрузку и выход"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnúť všetky potvrdenia pri vypnutí, reštarte a odhlásení systému"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogoči vsa potrjevanja pri zaustavitvi, ponovnem zagonu in odjavi sistema"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaktivera alla bekräftelser vid avstängning, omstart och utloggning av systemet"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem kapatma, yeniden başlatma ve oturum kapatmadaki tüm onayları devre dışı bırak"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt mọi xác nhận khi tắt máy, khởi động lại và đăng xuất hệ thống"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统关机、重启和注销时停用所有确认"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用系統關機、重新啟動和登出時的所有確認"
          }
        }
      }
    },
