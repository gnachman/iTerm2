        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ini dihidupkan, kelutsinaran boleh ditogol tetingkap demi tetingkap di bawah Paparan > Gunakan Kelutsinaran"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
