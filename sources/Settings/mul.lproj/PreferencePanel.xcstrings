    "U4H-3c-nZg.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Some programs (such as vim and emacs) want to put the numeric keypad in \\\"application\\\" mode. Turn this off if you always want it to act as a numeric keypad.\"; ObjectID = \"U4H-3c-nZg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Programme (wie vim und emacs) möchten den Nummernblock in den „Anwendungsmodus“ versetzen. Schalten Sie dies aus, wenn er sich immer wie ein normaler Nummernblock verhalten soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some programs (such as vim and emacs) want to put the numeric keypad in \"application\" mode. Turn this off if you always want it to act as a numeric keypad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vimやemacsなどの一部のプログラムは、テンキーを「アプリケーション」モードにしようとします。常にテンキーとして動作させたい場合はこれをオフにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns programas (como vim e emacs) querem colocar o teclado numérico no modo “aplicativo”. Desative isto se você quiser que ele sempre funcione como um teclado numérico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые программы (например, vim и emacs) переводят цифровую клавиатуру в режим «приложения». Отключите этот параметр, если хотите, чтобы она всегда работала как обычная цифровая клавиатура."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些程序（如 vim 和 emacs）希望将数字小键盘置于“应用”模式。如果你希望它始终作为数字小键盘使用，请关闭此选项。"
          }
        }
      }
    },
    "U5a-PY-hD8.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used.\"; ObjectID = \"U5a-PY-hD8\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden die ANSI-Farben Rot, Gelb und Blau für Markierungsindikatoren verwendet. Andernfalls werden die fest codierten Standardfarben verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, ANSI red, yellow, and blue colors are used by mark indicators. Otherwise, the hardcoded default colors are used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、マークインジケータにANSIの赤、黄、青の色が使用されます。無効の場合は、ハードコードされたデフォルトの色が使用されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os indicadores de marca usam as cores ANSI vermelho, amarelo e azul. Caso contrário, são usadas as cores padrão fixas no código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, для индикаторов меток используются красный, жёлтый и синий цвета ANSI. В противном случае используются встроенные цвета по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，标记指示器使用 ANSI 红色、黄色和蓝色。否则使用硬编码的默认颜色。"
          }
        }
      }
    },
