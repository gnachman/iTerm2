    "6383.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Clipboard access via an escape code poses a security risk if running untrusted applications.\"; ObjectID = \"6383\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Zwischenablage über einen Escape-Code stellt ein Sicherheitsrisiko dar, wenn nicht vertrauenswürdige Anwendungen ausgeführt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clipboard access via an escape code poses a security risk if running untrusted applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エスケープコード経由のクリップボードアクセスは、信頼できないアプリケーションを実行している場合セキュリティ上のリスクとなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à área de transferência por um código de escape representa um risco de segurança ao executar aplicativos não confiáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к буферу обмена через escape-код представляет угрозу безопасности при запуске недоверенных приложений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果运行不受信任的应用，通过转义码访问剪贴板会带来安全风险。"
          }
        }
      }
    },
    "6384.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Applications in terminal may access clipboard\"; ObjectID = \"6384\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwendungen im Terminal dürfen auf die Zwischenablage zugreifen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applications in terminal may access clipboard"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナル内のアプリケーションがクリップボードにアクセスすることを許可する"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicativos no terminal podem acessar a área de transferência"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения в терминале могут получать доступ к буферу обмена"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端中的应用可以访问剪贴板"
          }
        }
      }
    },
    "6387.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"This may be a security risk in an untrusted environment, especially if the terminal can set the title.\"; ObjectID = \"6387\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann in einer nicht vertrauenswürdigen Umgebung ein Sicherheitsrisiko darstellen, besonders wenn das Terminal den Titel festlegen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This may be a security risk in an untrusted environment, especially if the terminal can set the title."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは、特にターミナルがタイトルを設定できる場合、信頼できない環境ではセキュリティ上のリスクになる可能性があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto pode representar um risco de segurança em um ambiente não confiável, especialmente se o terminal puder definir o título."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это может представлять угрозу безопасности в недоверенной среде, особенно если терминал может задавать заголовок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这在不受信任的环境中可能存在安全风险，尤其是终端可以设置标题时。"
          }
        }
      }
    },
