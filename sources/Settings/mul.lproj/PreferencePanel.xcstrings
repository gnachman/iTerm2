    "7dn-rM-ht2.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This will force iTerm2 to use the specified keyboard locale\\ninstead of the system keyboard.\"; ObjectID = \"7dn-rM-ht2\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això obligarà l’iTerm2 a utilitzar la configuració regional de teclat especificada\nen lloc del teclat del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 bude nucen použít zadané národní prostředí klávesnice\nmísto systémové klávesnice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tvinger iTerm2 til at bruge den angivne tastaturlandestandard\nfremfor systemets tastatur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies zwingt iTerm2, das angegebene Tastatur-Gebietsschema\nanstelle der Systemtastatur zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα αναγκάσει το iTerm2 να χρησιμοποιεί τις καθορισμένες τοπικές ρυθμίσεις πληκτρολογίου\nαντί για το πληκτρολόγιο του συστήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will force iTerm2 to use the specified keyboard locale\ninstead of the system keyboard."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will force iTerm2 to use the specified keyboard locale\ninstead of the system keyboard."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will force iTerm2 to use the specified keyboard locale\ninstead of the system keyboard."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will force iTerm2 to use the specified keyboard locale\ninstead of the system keyboard."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will force iTerm2 to use the specified keyboard locale\ninstead of the system keyboard."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will force iTerm2 to use the specified keyboard locale\ninstead of the system keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto obligará a iTerm2 a usar la configuración regional de teclado especificada\nen lugar del teclado del sistema."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto obligará a iTerm2 a usar la configuración regional de teclado especificada\nen lugar del teclado del sistema."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto obligará a iTerm2 a usar la configuración regional de teclado especificada\nen lugar del teclado del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä pakottaa iTerm2:n käyttämään määritettyä näppäimistön alueasetusta\njärjestelmän näppäimistön sijaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 utilisera les paramètres régionaux de clavier indiqués\nau lieu du clavier du système."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 utilisera les paramètres régionaux de clavier indiqués\nau lieu du clavier du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे iTerm2 सिस्टम कीबोर्ड के बजाय बताए गए\nकीबोर्ड लोकेल का उपयोग करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će prisiliti iTerm2 da koristi navedeni lokalitet tipkovnice\numjesto tipkovnice sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez arra kényszeríti az iTerm2-t, hogy a megadott billentyűzet-területi beállítást\nhasználja a rendszer billentyűzete helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memaksa iTerm2 menggunakan lokal papan ketik yang ditentukan\nalih-alih papan ketik sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo obbligherà iTerm2 a usare le impostazioni locali di tastiera specificate\ninvece della tastiera di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、iTerm2はシステムのキーボードの代わりに\n指定したキーボードロケールを使用するようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 iTerm2가 시스템 키보드 대신\n지정한 키보드 로케일을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memaksa iTerm2 menggunakan tempatan papan kekunci yang ditentukan\nbukan papan kekunci sistem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette tvinger iTerm2 til å bruke den angitte tastaturspråkinnstillingen\ni stedet for systemtastaturet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee gebruikt iTerm2 de opgegeven toetsenbordtaalversie\nin plaats van het toetsenbord van het systeem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to, że iTerm2 użyje określonych ustawień regionalnych klawiatury\nzamiast klawiatury systemowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto forçará o iTerm2 a usar o local de teclado especificado\nem vez do teclado do sistema."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto forçará o iTerm2 a usar a disposição de teclado especificada\nem vez do teclado do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta va obliga iTerm2 să folosească configurarea locală de tastatură specificată\nîn locul tastaturii sistemului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это заставит iTerm2 использовать указанную раскладку клавиатуры\nвместо системной клавиатуры."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikácia iTerm2 bude musieť použiť zadané miestne nastavenia klávesnice\nnamiesto systémovej klávesnice."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bo iTerm2 prisililo, da uporabi navedeno območno nastavitev tipkovnice\nnamesto sistemske tipkovnice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta tvingar iTerm2 att använda den angivna tangentbordsspråkinställningen\ni stället för systemets tangentbord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iTerm2 จะถูกบังคับให้ใช้ภาษาและภูมิภาคของแป้นพิมพ์ที่ระบุ\nแทนแป้นพิมพ์ของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, iTerm2’yi sistem klavyesi yerine belirtilen klavye yerel ayarını\nkullanmaya zorlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це змусить iTerm2 використовувати вказані регіональні параметри клавіатури\nзамість клавіатури системи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này sẽ buộc iTerm2 dùng thiết lập vùng bàn phím đã chỉ định\nthay vì bàn phím hệ thống."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将强制iTerm2使用指定的键盘区域设置\n而非系统键盘。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會強制 iTerm2 使用指定的鍵盤語系，\n而非系統鍵盤。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将强制 iTerm2 使用指定的键盘语言环境\n而非系统键盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會強制 iTerm2 使用指定的鍵盤語系，\n而非系統鍵盤。"
          }
        }
      }
    },
    "7EK-nW-yMU.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur.\"; ObjectID = \"7EK-nW-yMU\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan l’aparició de la barra de pestanyes fa que una finestra creixi, una part pot quedar fora de l’àrea principal de la pantalla (per exemple, sota el Dock). Quan aquesta opció està activada, la mida de la finestra es manté igual si fer-la créixer per encabir una barra de pestanyes provoqués que això passés."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se zobrazením řádku panelů okno zvětší, jeho část může přesáhnout hlavní oblast obrazovky (například pod Dock). Když je toto nastavení zapnuto, velikost okna zůstane stejná, pokud by jeho zvětšení kvůli řádku panelů k tomu vedlo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fanelinjen får et vindue til at vokse, kan en del af det flytte uden for skærmens hovedområde (f.eks. ind under Dock). Når denne indstilling er slået til, forbliver vinduets størrelse den samme, hvis en forøgelse for at give plads til en fanelinje ville medføre det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Erscheinen der Tableiste dazu führt, dass ein Fenster wächst, kann ein Teil davon außerhalb des sichtbaren Bildschirmbereichs liegen (zum Beispiel unter dem Dock). Wenn diese Einstellung aktiviert ist, bleibt die Fenstergröße unverändert, falls das Vergrößern zur Anzeige der Tableiste dazu führen würde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν η εμφάνιση της γραμμής καρτελών κάνει ένα παράθυρο να μεγαλώσει, μέρος του μπορεί να βρεθεί έξω από την κύρια περιοχή της οθόνης (για παράδειγμα, κάτω από το Dock). Όταν αυτή η ρύθμιση είναι ενεργοποιημένη, το μέγεθος του παραθύρου θα παραμένει ίδιο αν η μεγέθυνσή του για να χωρέσει μια γραμμή καρτελών θα προκαλούσε κάτι τέτοιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the appearance of the tab bar causes a window to grow, part of it may move outside the main area of the screen (for example, under the Dock). When this setting is enabled, the window’s size will remain the same if growing it to accommodate a tab bar would cause that to occur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la aparición de la barra de pestañas hace que una ventana crezca, parte de ella puede quedar fuera del área principal de la pantalla (por ejemplo, bajo el Dock). Cuando este ajuste está activado, el tamaño de la ventana se mantiene igual si agrandarla para alojar una barra de pestañas provocara que eso ocurra."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la aparición de la barra de pestañas hace que una ventana crezca, parte de ella puede quedar fuera del área principal de la pantalla (por ejemplo, bajo el Dock). Cuando esta configuración está activada, el tamaño de la ventana se mantiene igual si agrandarla para alojar una barra de pestañas provocara que eso ocurra."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la aparición de la barra de pestañas hace que una ventana crezca, parte de ella puede quedar fuera del área principal de la pantalla (por ejemplo, bajo el Dock). Cuando esta configuración está activada, el tamaño de la ventana se mantiene igual si agrandarla para alojar una barra de pestañas provocara que eso ocurra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun välilehtipalkin ilmestyminen kasvattaa ikkunaa, osa siitä voi siirtyä näytön pääalueen ulkopuolelle (esimerkiksi Dockin alle). Kun tämä asetus on käytössä, ikkunan koko pysyy samana, jos sen kasvattaminen välilehtipalkin tilaksi aiheuttaisi tämän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l’apparition de la barre d’onglets agrandit une fenêtre, une partie peut sortir de la zone principale de l’écran (par exemple, sous le Dock). Lorsque ce réglage est activé, la taille de la fenêtre reste inchangée si l’agrandir pour accueillir une barre d’onglets provoquait ce débordement."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l’apparition de la barre d’onglets agrandit une fenêtre, une partie peut sortir de la zone principale de l’écran (par exemple, sous le Dock). Lorsque ce réglage est activé, la taille de la fenêtre reste inchangée si l’agrandir pour accueillir une barre d’onglets provoquait ce débordement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब टैब बार दिखने से विंडो बड़ी हो जाती है, तो उसका कुछ भाग स्क्रीन के मुख्य क्षेत्र से बाहर (जैसे Dock के नीचे) जा सकता है। यह सेटिंग सक्षम होने पर, यदि टैब बार के लिए विंडो बड़ी करने से ऐसा होता है, तो विंडो का आकार वही रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad pojava trake s karticama uzrokuje rast prozora, dio prozora može završiti izvan glavnog područja zaslona (na primjer, ispod Docka). Kad je ova postavka omogućena, veličina prozora ostaje ista ako bi njegovo povećanje radi trake s karticama dovelo do toga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a lapsor megjelenése miatt az ablak megnő, egy része a képernyő fő területén kívülre kerülhet (például a Dock alá). Ha ez a beállítás engedélyezve van, az ablak mérete változatlan marad, ha a lapsor miatti növelés ezt okozná."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat tampilan bar tab membuat jendela membesar, sebagian jendela mungkin bergeser keluar dari area utama layar (misalnya, di bawah Dock). Jika pengaturan ini diaktifkan, ukuran jendela tetap sama jika memperbesarnya untuk menampung bar tab akan menyebabkan hal itu terjadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la comparsa della barra dei pannelli fa crescere una finestra, una parte di essa può finire fuori dall’area principale dello schermo (ad esempio sotto il Dock). Quando questa impostazione è attiva, la dimensione della finestra resta invariata se ingrandirla per far posto a una barra dei pannelli causerebbe questo problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タブバーの表示によってウィンドウが大きくなる場合、その一部が画面のメインエリアの外（Dockの下など）に移動することがあります。この設定を有効にすると、タブバーに合わせてウィンドウを大きくすることでこの現象が起きる場合、ウィンドウのサイズは変更されないままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭 막대가 나타나면서 윈도우가 커질 때 윈도우의 일부가 화면의 주 영역 밖(예: Dock 아래)으로 이동할 수 있습니다. 이 설정을 켜면, 탭 막대를 수용하려고 윈도우를 키웠을 때 그렇게 되는 경우 윈도우 크기를 그대로 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila penampilan bar tab menyebabkan tetingkap membesar, sebahagiannya mungkin bergerak keluar daripada kawasan utama skrin (contohnya, di bawah Dock). Apabila seting ini didayakan, saiz tetingkap akan kekal sama jika membesarkannya untuk menampung bar tab akan menyebabkan perkara itu berlaku."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fanelinjen får et vindu til å vokse, kan deler av det havne utenfor hovedområdet på skjermen (for eksempel under Dock). Når denne innstillingen er aktivert, beholder vinduet samme størrelse hvis det ville skjedd ved å gjøre det større for å gi plass til en fanelinje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het tonen van de tabbladbalk ervoor zorgt dat een venster groeit, kan een deel ervan buiten het hoofdgebied van het scherm komen (bijvoorbeeld onder het Dock). Als deze instelling is ingeschakeld, blijft het formaat van het venster gelijk wanneer vergroten voor een tabbladbalk daartoe zou leiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy wygląd paska kart powoduje powiększenie okna, jego część może znaleźć się poza głównym obszarem ekranu (na przykład pod Dockiem). Gdy to ustawienie jest włączone, rozmiar okna pozostanie bez zmian, jeśli jego powiększenie z powodu paska kart miałoby do tego doprowadzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o surgimento da barra de abas faz a janela crescer, parte dela pode se mover para fora da área principal da tela (por exemplo, sob o Dock). Quando este ajuste está ativado, o tamanho da janela permanecerá o mesmo se aumentá-la para acomodar uma barra de abas fizer com que isso ocorra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o surgimento da barra de separadores faz a janela crescer, parte dela pode deslocar-se para fora da área principal do ecrã (por exemplo, por baixo do Dock). Quando esta definição está ativada, o tamanho da janela permanecerá o mesmo se aumentá-la para acomodar uma barra de separadores fizer com que isso ocorra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când apariția barei filelor face ca o fereastră să crească, o parte din ea poate ajunge în afara zonei principale a ecranului (de exemplu, sub Dock). Când această configurare este activată, dimensiunea ferestrei rămâne aceeași dacă mărirea ei pentru a face loc unei bare a filelor ar duce la așa ceva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда появление панели вкладок приводит к увеличению окна, часть его может выйти за пределы основной области экрана (например, оказаться под Dock). Если этот параметр включён, размер окна останется прежним в случаях, когда его увеличение для размещения панели вкладок привело бы к этому."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď zobrazenie lišty s tabmi spôsobí zväčšenie okna, jeho časť môže presiahnuť hlavnú oblasť obrazovky (napríklad pod Dock). Keď je toto nastavenie zapnuté, veľkosť okna sa nezmení, ak by jeho zväčšenie kvôli lište s tabmi k tomu viedlo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadar se zaradi videza vrstice z zavihki okno poveča, se lahko del okna znajde zunaj glavnega območja zaslona (na primer pod vrstico Dock). Ko je ta nastavitev omogočena, velikost okna ostane enaka, če bi povečanje za vrstico z zavihki povzročilo kaj takega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När flikfältets utseende gör att ett fönster växer kan en del av det hamna utanför skärmens huvudområde (till exempel under Dock). När den här inställningen är på behåller fönstret sin storlek om en ökning för att rymma ett flikfält skulle få det att hända."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อรายการแถบทำให้หน้าต่างขยายขึ้น บางส่วนอาจเลื่อนออกนอกพื้นที่หลักของหน้าจอ (เช่น อยู่ใต้ Dock) เมื่อเปิดใช้การตั้งค่านี้ ขนาดของหน้าต่างจะคงเดิมหากการขยายเพื่อรองรับรายการแถบจะทำให้เกิดเหตุการณ์ดังกล่าว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekme çubuğunun görünmesi pencerenin büyümesine neden olduğunda, pencerenin bir kısmı ekranın ana alanının dışına (örneğin Dock’un altına) taşabilir. Bu ayar etkinken, sekme çubuğuna yer açmak için pencereyi büyütmek bunun olmasına yol açacaksa pencere boyutu aynı kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли поява панелі вкладок збільшує вікно, його частина може опинитися за межами основної області екрана (наприклад, під Dock). Коли цей параметр увімкнено, розмір вікна не змінюється, якщо збільшення для розміщення панелі вкладок призвело б до цього."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi thanh tab xuất hiện làm cửa sổ lớn thêm, một phần của nó có thể nằm ngoài vùng chính của màn hình (ví dụ, dưới Dock). Khi cài đặt này được bật, kích thước cửa sổ sẽ giữ nguyên nếu việc mở rộng để chứa thanh tab gây ra tình trạng đó."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当标签页栏的出现导致窗口变大时，窗口的一部分可能会移到屏幕主区域之外（例如移到程序坞下方）。启用此设置后，如果为容纳标签页栏而放大窗口会导致这种情况，则窗口大小将保持不变。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當分頁列的外觀使視窗變大時，視窗的一部分可能會移到螢幕主要區域之外（例如 Dock 下方）。啟用此設定後，如為容納分頁列而放大視窗會導致這種情況，視窗大小將維持不變。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当标签栏的外观导致窗口变大时，窗口的一部分可能会移出屏幕主区域（例如 Dock 下方）。启用此设置后，如果为容纳标签栏而扩大窗口会导致这种情况，则窗口大小保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當標籤頁列的外觀使視窗變大時，視窗的一部分可能會移到螢幕主要區域之外（例如 Dock 下方）。啟用此設定後，若為容納標籤頁列而放大視窗會導致這種情況，視窗大小將維持不變。"
          }
        }
      }
    },
