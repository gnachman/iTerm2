          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet bij het plakken van een neergezette bestandsnaam deze tussen dubbele aanhalingstekens"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy wklejaniu upuszczonej nazwy pliku ujmij ją w cudzysłów"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao colar um nome de arquivo arrastado, colocá-lo entre aspas duplas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При вставке перетащенного имени файла заключать его в двойные кавычки"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri vkladaní názvu pusteného súboru ho uzavrieť do dvojitých úvodzoviek"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
