    "Qz5-Ow-iQt.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline.\"; ObjectID = \"Qz5-Ow-iQt\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Shell-Integration aktiviert ist, verhindert dies, dass Eingabeaufforderungen mitten in einer Zeile beginnen, wenn der vorherige Befehl nicht mit einem Zeilenumbruch endete."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合が有効な場合、これにより、前のコマンドが改行で終わらなかったときにコマンドプロンプトが行の途中から始まるのを防ぎます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a Shell Integration estiver ativada, isto evita que os prompts de comando comecem no meio de uma linha quando o comando anterior não terminou com uma quebra de linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включена интеграция с оболочкой, это предотвращает начало приглашения командной строки в середине строки, если предыдущая команда не завершилась переводом строки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果启用了 Shell 集成，此选项可防止在上一条命令未以换行结束时，命令提示符从行中间开始。"
          }
        }
      }
    },
