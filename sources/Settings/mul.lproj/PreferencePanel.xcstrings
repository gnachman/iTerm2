    "eyh-Oh-a4E.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Remember the position of previously closed windows and use size from profile\"; ObjectID = \"eyh-Oh-a4E\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorda la posició de les finestres tancades anteriorment i fes servir la mida del perfil"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamatovat si pozici dříve zavřených oken a použít velikost z profilu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk placeringen af tidligere lukkede vinduer, og brug størrelsen fra profilen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position zuvor geschlossener Fenster merken und Größe aus dem Profil verwenden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απομνημόνευση της θέσης των παραθύρων που έκλεισαν προηγουμένως και χρήση του μεγέθους από το προφίλ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordar la posición de las ventanas cerradas anteriormente y usar el tamaño del perfil"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordar la posición de las ventanas cerradas anteriormente y usar el tamaño del perfil"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordar la posición de las ventanas cerradas anteriormente y usar el tamaño del perfil"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muista aiemmin suljettujen ikkunoiden sijainti ja käytä profiilin kokoa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoriser la position des fenêtres fermées précédemment et utiliser la taille du profil"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoriser la position des fenêtres fermées précédemment et utiliser la taille du profil"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले बंद की गई विंडो की स्थिति याद रखें और प्रोफ़ाइल का आकार उपयोग करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamti položaj prethodno zatvorenih prozora i koristi veličinu iz profila"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A korábban bezárt ablakok pozíciójának megjegyzése és a profil szerinti méret használata"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingat posisi jendela yang sebelumnya ditutup dan gunakan ukuran dari profil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda la posizione delle finestre chiuse in precedenza e usa le dimensioni del profilo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前に閉じたウィンドウの位置を記憶し、サイズはプロファイルから使用する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 닫은 윈도우의 위치를 기억하고 크기는 프로파일 설정 사용"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingat kedudukan tetingkap yang ditutup sebelum ini dan gunakan saiz daripada profil"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk posisjonen til tidligere lukkede vinduer og bruk størrelsen fra profilen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onthoud de positie van eerder gesloten vensters en gebruik de grootte uit het profiel"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamiętuj pozycję wcześniej zamkniętych okien i używaj rozmiaru z profilu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar a posição de janelas fechadas anteriormente e usar o tamanho do perfil"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar a posição das janelas fechadas anteriormente e usar o tamanho do perfil"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rețineți poziția ferestrelor închise anterior și folosiți dimensiunea din profil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запоминать положение ранее закрытых окон и использовать размер из профиля"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamätať si polohu predtým zatvorených okien a použiť veľkosť z profilu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomni si položaj prej zaprtih oken in uporabi velikost iz profila"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom ihåg positionen för tidigare stängda fönster och använd storleken från profilen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดจำตำแหน่งของหน้าต่างที่ปิดไปก่อนหน้านี้และใช้ขนาดจากโปรไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce kapatılan pencerelerin konumunu hatırla ve boyutu profilden kullan"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запамʼятовувати позицію раніше закритих вікон і використовувати розмір із профілю"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi nhớ vị trí của các cửa sổ đã đóng trước đó và dùng kích thước từ hồ sơ"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记住之前关闭的窗口的位置，并使用描述文件中的大小"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記住先前關閉視窗的位置，並使用描述檔中的大小"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
