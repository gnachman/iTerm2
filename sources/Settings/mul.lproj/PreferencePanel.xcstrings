    "3PU-hM-DSB.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence.\"; ObjectID = \"3PU-hM-DSB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplaçament alternatiu del ratolí és una funció que envia tecles de fletxa en resposta a la roda de desplaçament o als gestos de desplaçament. S’activa i es desactiva amb una seqüència de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativní posouvání myší je funkce, která v reakci na kolečko myši nebo gesta posouvání odesílá klávesy se šipkami. Zapíná se a vypíná řídicí sekvencí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulning er en funktion, der sender piletaster som svar på rullehjul eller rullebevægelser. Den slås til og fra af en kontrolsekvens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alternatives Scrollen mit der Maus“ ist eine Funktion, die bei Mausrad-/Scrollgesten Pfeiltasten sendet. Sie wird über eine Steuersequenz umgeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εναλλακτική κύλιση ποντικιού είναι μια λειτουργία που στέλνει πλήκτρα βελών ως απόκριση στον τροχό κύλισης ή στις χειρονομίες κύλισης. Εναλλάσσεται με μια ακολουθία ελέγχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del ratón es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del mouse es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo del mouse es una función que envía teclas de flecha en respuesta a la rueda de desplazamiento o a los gestos de desplazamiento. Se activa y desactiva mediante una secuencia de control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoinen hiirivieritys lähettää nuolinäppäimiä vierityspyörän tai vieritysliikkeiden seurauksena. Se kytketään ohjaussarjalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Il est activé et désactivé par une séquence de contrôle."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Il est activé et désactivé par une séquence de contrôle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक माउस स्क्रोल एक सुविधा है जो स्क्रॉल व्हील या स्क्रोल जेस्चर के जवाब में ऐरो कीज़ भेजती है। इसे कंट्रोल सीक्वेंस से टॉगल किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativno listanje mišem šalje tipke sa strelicama kao odgovor na kotačić miša ili geste listanja. Uključuje se i isključuje kontrolnom sekvencom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alternatív egérgörgetés olyan funkció, amely nyílbillentyűket küld a görgetőkerékre vagy görgetési kézmozdulatokra válaszul. Vezérlőszekvenciával kapcsolható be és ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulir Tetikus Alternatif adalah fitur yang mengirim tombol panah sebagai respons terhadap roda gulir atau gestur gulir. Fitur ini dinyalakan/dimatikan oleh urutan kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scorrimento alternativo del mouse è una funzione che invia i tasti freccia in risposta alla rotellina o ai gesti di scorrimento. Viene attivato da una sequenza di controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、スクロールホイールやスクロールジェスチャに応じて矢印キーを送信する機能です。制御シーケンスで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 마우스 스크롤은 스크롤 휠/스크롤 제스처에 반응하여 화살표 키를 보내는 기능입니다. 제어 시퀀스로 켜고 끌 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrol Tetikus Alternatif ialah ciri yang menghantar kekunci anak panah sebagai tindak balas kepada roda skrol/gerak isyarat skrol. Ia ditogol oleh jujukan kawalan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulling sender piltaster som svar på rullehjul og rullebevegelser. Den slås av og på med en kontrollsekvens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatief muisscrollen is een functie die pijltjestoetsen verstuurt als reactie op het scrollwiel of scrolgebaren. Het wordt in- en uitgeschakeld met een besturingsreeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatywne przewijanie myszą to funkcja wysyłająca klawisze strzałek w odpowiedzi na kółko przewijania lub gesty przewijania. Włącza się ją sekwencją sterującą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem/gestos de rolagem. É alternada por uma sequência de controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A deslocação alternativa do rato é uma funcionalidade que envia teclas de seta em resposta à roda de deslocação/gestos de deslocação. É alternada por uma sequência de controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derularea alternativă cu mausul este o funcție care trimite tastele săgeată ca răspuns la rotița de derulare sau la gesturile de derulare. Este comutată printr-o secvență de control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Альтернативная прокрутка мышью» — это функция, которая отправляет клавиши со стрелками в ответ на прокрутку колёсика мыши или жесты прокрутки. Она переключается управляющей последовательностью."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatívne rolovanie myšou je funkcia, ktorá v reakcii na koliesko myši alebo gestá rolovania odosiela šípky. Zapína sa a vypína riadiacou sekvenciou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadomestno pomikanje z miško je funkcija, ki ob pomikanju s kolescem ali kretnjami pošilja tipke s puščicami. Vklopi in izklopi se s krmilnim zaporedjem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrullning är en funktion som skickar piltangenter som svar på rullningshjul eller rullningsgester. Den slås på och av med en styrsekvens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเลื่อนเมาส์สำรองคือคุณสมบัติที่ส่งปุ่มลูกศรเมื่อใช้ล้อเลื่อนหรือท่าทางการเลื่อน เปิด/ปิดด้วยลำดับควบคุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif Fare Kaydırma, kaydırma tekerleği veya kaydırma hareketlerine yanıt olarak ok tuşları gönderen bir özelliktir. Bir denetim dizisiyle açılıp kapatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Альтернативне прокручування мишею надсилає клавіші зі стрілками у відповідь на колесо прокручування або жести прокручування. Вмикається керівною послідовністю."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn chuột thay thế là tính năng gửi phím mũi tên khi cuộn bằng con lăn hoặc cử chỉ cuộn. Tính năng này được bật/tắt bằng một chuỗi điều khiển."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项在响应滚轮或滚动手势时发送箭头键的功能，由控制序列切换。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
