            "value" : "Nabídka „Zobrazení > Použít průhlednost“ může toto nastavení dočasně přepsat pro jednotlivá okna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversigt > Brug gennemsigtighed kan midlertidigt tilsidesætte denne indstilling for det enkelte vindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansicht > Transparenz verwenden kann diese Einstellung vorübergehend pro Fenster überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "View > Use Transparency can override this setting temporarily per window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualización > Usar transparencia puede anular temporalmente este ajuste en cada ventana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä > Käytä läpinäkyvyyttä voi ohittaa tämän asetuksen tilapäisesti ikkunakohtaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présentation > Utiliser la transparence peut remplacer temporairement ce réglage pour une fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista > Usa trasparenza può sostituire temporaneamente questa impostazione per ogni finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「表示 > 透明度を使用」でウィンドウごとに一時的にこの設定を上書きできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보기 > 투명도 사용으로 윈도우별로 이 설정을 일시적으로 무시할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Vis > Bruk gjennomsiktighet» kan midlertidig overstyre denne innstillingen for hvert vindu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Weergave > Gebruik transparantie’ kan deze instelling tijdelijk per venster overschrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widok > Użyj przezroczystości może tymczasowo zastąpić to ustawienie dla poszczególnych okien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizar > Usar transparência pode substituir este ajuste temporariamente por janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Вид > Использовать прозрачность» может временно переопределить эту настройку для отдельного окна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zobraziť > Použiť priehľadnosť“ môže toto nastavenie dočasne prepísať pre jednotlivé okná."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaz > Uporabi prosojnost lahko to nastavitev začasno preglasi za posamezno okno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innehåll > Använd transparens kan tillfälligt åsidosätta den här inställningen per fönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntü > Saydamlık Kullan, bu ayarı pencere başına geçici olarak geçersiz kılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem > Dùng độ trong suốt có thể tạm thời ghi đè cài đặt này cho từng cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“显示 > 使用透明度”可以临时按窗口覆盖此设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「顯示方式 > 使用透明度」可逐一視窗暫時覆寫此設定。"
          }
        }
      }
    },
