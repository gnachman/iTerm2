        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esticar abas para preencher a barra"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Растягивать вкладки, чтобы заполнить панель"
