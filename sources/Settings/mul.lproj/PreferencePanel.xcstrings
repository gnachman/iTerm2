    "5Xl-Cr-LpL.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Some crusty old systems expect newline rather than carraige return in in raw mode. The symptom is that tmux -CC just hangs. Most people should leave this off.\"; ObjectID = \"5Xl-Cr-LpL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche uralten Systeme erwarten im Raw-Modus einen Zeilenvorschub (Newline) statt eines Wagenrücklaufs (Carriage Return). Das Symptom ist, dass tmux -CC einfach hängen bleibt. Die meisten Anwender sollten dies deaktiviert lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some crusty old systems expect newline rather than carraige return in in raw mode. The symptom is that tmux -CC just hangs. Most people should leave this off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の古いシステムでは、rawモードでキャリッジリターンではなく改行を期待します。症状としてはtmux -CCが単にハングします。ほとんどの人はこれをオフのままにしておくべきです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns sistemas antigos esperam newline em vez de carriage return no modo raw. O sintoma é que o tmux -CC simplesmente trava. A maioria das pessoas deve deixar isto desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые устаревшие системы ожидают в необработанном режиме перевод строки вместо возврата каретки. Симптом — то, что tmux -CC просто зависает. Большинству пользователей следует оставить этот параметр выключенным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些老旧系统在原始模式下期望换行符而非回车符。症状是 tmux -CC 卡住。大多数人应保持关闭。"
          }
        }
      }
    },
