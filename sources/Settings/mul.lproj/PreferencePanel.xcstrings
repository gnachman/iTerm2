    "cgK-BO-rKa.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work.\"; ObjectID = \"cgK-BO-rKa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, hat die Mausberichterstattung Vorrang vor dem Wischen zum Wechseln der Tabs. Deaktivieren Sie dies, wenn das Wischen zum Wechseln der Tabs manchmal nicht funktioniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, mouse reporting takes priority over swipe to switch tabs. Disable this if swiping to switch tabs sometimes doesn’t work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、マウスレポートがタブを切り替えるスワイプよりも優先されます。タブ切り替えのスワイプが時々効かない場合はこれを無効にしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o relato de mouse tem prioridade sobre o deslizar para trocar de aba. Desative isto se o deslizar para trocar de aba às vezes não funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, отчёты о мыши имеют приоритет над свайпом для переключения вкладок. Отключите этот параметр, если свайп для переключения вкладок иногда не работает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，鼠标报告优先于滑动切换标签页。如果滑动切换标签页有时不生效，请关闭此选项。"
          }
        }
      }
    },
