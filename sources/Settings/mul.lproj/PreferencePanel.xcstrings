            "value" : "Animar el cursor solo en apps interactivas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animoi kohdistin vain interaktiivisissa sovelluksissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animer le curseur uniquement dans les apps interactives"
          }
        },
        "it" : {
