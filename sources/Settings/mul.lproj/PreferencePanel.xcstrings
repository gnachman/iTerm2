    "9Ds-KM-wpJ.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence.\"; ObjectID = \"9Ds-KM-wpJ\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alternatives Scrollen mit der Maus“ ist eine Funktion, die bei Mausrad-/Scrollgesten Pfeiltasten sendet. Sie wird über eine Steuersequenz umgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. It is toggled by a control sequence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、スクロールホイールやスクロールジェスチャに応じて矢印キーを送信する機能です。制御シーケンスで切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 마우스 스크롤은 스크롤 휠/스크롤 제스처에 반응하여 화살표 키를 보내는 기능입니다. 제어 시퀀스로 켜고 끌 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem/gestos de rolagem. É alternada por uma sequência de controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Альтернативная прокрутка мышью» — это функция, которая отправляет клавиши со стрелками в ответ на прокрутку колёсика мыши или жесты прокрутки. Она переключается управляющей последовательностью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能，由控制序列切换。"
          }
        }
      }
    },
