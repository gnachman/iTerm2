    "zI8-aW-nUw.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, and when the current display can use HDR (High Dynamic Range), the cursor is drawn at maximum brightness white, brighter than any white that normally appears in an application.\"; ObjectID = \"zI8-aW-nUw\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto a aktuální displej podporuje HDR (High Dynamic Range), kurzor se vykreslí bílou barvou s maximálním jasem, jasnější než jakákoli bílá, která se v aplikaci běžně objevuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, og den aktuelle skærm kan bruge HDR (High Dynamic Range), tegnes markøren i hvid ved maksimal lysstyrke, lysere end nogen hvid, der normalt vises i et program."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert und wenn das aktuelle Display HDR (High Dynamic Range) unterstützt, wird der Cursor in maximal hellem Weiß gezeichnet, heller als jedes Weiß, das normalerweise in einer Anwendung erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, and when the current display can use HDR (High Dynamic Range), the cursor is drawn at maximum brightness white, brighter than any white that normally appears in an application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado y la pantalla actual admite HDR (alto rango dinámico), el cursor se dibuja en blanco al máximo brillo, más brillante que cualquier blanco que aparezca normalmente en una aplicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä ja nykyinen näyttö tukee HDR:ää (High Dynamic Range), kohdistin piirretään suurimmalla kirkkaudella valkoisena, kirkkaampana kuin mikään sovelluksessa normaalisti näkyvä valkoinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée et que l’écran actuel peut utiliser le HDR (High Dynamic Range), le curseur est dessiné en blanc à la luminosité maximale, plus vif que tout blanc apparaissant normalement dans une application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è attiva e lo schermo corrente supporta l’HDR (High Dynamic Range), il cursore viene disegnato con il bianco alla massima luminosità, più brillante di qualsiasi bianco che compare normalmente in un’applicazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、現在のディスプレイがHDR（High Dynamic Range）に対応している場合、カーソルは通常アプリケーションに表示される白よりも明るい、最大輝度の白で描画されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 현재 디스플레이가 HDR(High Dynamic Range)을 사용할 수 있을 때 커서를 최대 밝기의 흰색으로 그립니다. 이 흰색은 앱에 일반적으로 표시되는 어떤 흰색보다도 밝습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert og gjeldende skjerm støtter HDR (høyt dynamisk område), tegnes markøren i hvitt med maksimal lysstyrke, lysere enn noe hvitt som vanligvis vises i en app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld en het huidige beeldscherm HDR (High Dynamic Range) aankan, wordt de cursor getekend in wit op maximale helderheid, helderder dan elk wit dat normaal in een applicatie voorkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona i bieżący wyświetlacz obsługuje HDR (High Dynamic Range), kursor jest rysowany w bieli o maksymalnej jasności, jaśniejszej niż jakakolwiek biel, która normalnie pojawia się w aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, e quando o monitor atual pode usar HDR (High Dynamic Range), o cursor é desenhado em branco de brilho máximo, mais brilhante do que qualquer branco que normalmente aparece em um aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён и текущий дисплей поддерживает HDR (расширенный динамический диапазон), курсор отрисовывается белым цветом максимальной яркости, ярче любого белого цвета, который обычно отображается в приложении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté a aktuálny displej podporuje HDR (vysoký dynamický rozsah), kurzor sa vykreslí bielou farbou s maximálnym jasom, jasnejšou než akákoľvek biela, ktorá sa bežne zobrazuje v aplikácii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to omogočeno in če trenutni zaslon podpira HDR (visok dinamični razpon), je kazalec narisan v beli barvi z največjo svetlostjo, svetlejši od katere koli bele, ki se običajno pojavi v aplikaciji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är aktiverat och den aktuella skärmen kan använda HDR (High Dynamic Range) ritas markören i vitt med maximal ljusstyrka, ljusare än något vitt som normalt visas i ett program."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinken ve geçerli ekran HDR (Yüksek Dinamik Aralık) kullanabiliyorsa imleç, bir uygulamada normalde görünen her beyazdan daha parlak, azami parlaklıkta beyaz çizilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, và khi màn hình hiện tại hỗ trợ HDR (dải động cao), con trỏ được vẽ bằng màu trắng ở độ sáng tối đa, sáng hơn mọi màu trắng thường xuất hiện trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当启用且当前显示器支持HDR（高动态范围）时，光标会以最大亮度白色显示，比应用程序中通常出现的任何白色更亮"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用且目前顯示器支援 HDR（高動態範圍）時，游標會以最大亮度的白色繪製，比 App 中通常出現的任何白色都更亮。"
          }
        }
      }
    },
