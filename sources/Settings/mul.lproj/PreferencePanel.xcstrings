    "elQ-vX-kkH.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Avoid repainting while cursor is hidden to reduce flicker while scrolling\"; ObjectID = \"elQ-vX-kkH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita tornar a dibuixar mentre el cursor està ocult per reduir el parpelleig en desplaçar"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepřekreslovat, když je kurzor skrytý, aby se omezilo blikání při posouvání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undgå gentegning, mens markøren er skjult, for at reducere flimren under rulning"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuzeichnen bei ausgeblendetem Cursor vermeiden, um Scroll-Flackern zu reduzieren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποφυγή επανασχεδίασης όσο ο δρομέας είναι κρυμμένος, για μείωση του τρεμοπαίγματος κατά την κύλιση"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar volver a dibujar mientras el cursor está oculto para reducir el parpadeo al desplazar"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar volver a dibujar mientras el cursor está oculto para reducir el parpadeo al desplazar"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar volver a dibujar mientras el cursor está oculto para reducir el parpadeo al desplazar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vältä uudelleenpiirtoa kohdistimen ollessa kätkettynä, jotta vierityksen välkkyminen vähenee"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter de redessiner lorsque le curseur est masqué pour réduire le scintillement pendant le défilement"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter de redessiner lorsque le curseur est masqué pour réduire le scintillement pendant le défilement"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रोल करते समय झिलमिलाहट घटाने के लिए कर्सर छिपा होने पर दोबारा ड्रॉ करने से बचें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbjegavaj ponovno crtanje dok je kursor skriven kako bi se smanjilo treperenje pri listanju"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az újrarajzolás elkerülése, amíg a kurzor rejtett, a görgetés közbeni villogás csökkentéséhez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindari menggambar ulang saat kursor tersembunyi untuk mengurangi kedipan saat menggulir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita di ridisegnare mentre il cursore è nascosto per ridurre lo sfarfallio durante lo scorrimento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロール中のちらつきを軽減するため、カーソルが非表示の間は再描画を避ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 시 깜박임을 줄이기 위해 커서가 숨겨져 있는 동안 다시 그리지 않기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elakkan lukis semula semasa kursor disembunyikan untuk mengurangkan kerlipan semasa skrol"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå ny tegning mens markøren er skjult, for å redusere flimring ved rulling"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermijd opnieuw tekenen terwijl de cursor verborgen is om flikkeren tijdens het scrollen te verminderen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj ponownego rysowania, gdy kursor jest ukryty, aby zmniejszyć migotanie podczas przewijania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar redesenhar enquanto o cursor está oculto para reduzir a cintilação ao rolar"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar redesenhar enquanto o cursor está oculto para reduzir a cintilação durante a deslocação"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitați redesenarea cât timp cursorul este ascuns, pentru a reduce sclipirea la derulare"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не перерисовывать при скрытом курсоре, уменьшая мерцание при прокрутке"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevykresľovať znovu, kým je kurzor skrytý, aby sa znížilo blikanie pri rolovaní"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skritim kazalcem se izogibaj ponovnemu risanju, da zmanjšaš utripanje pri pomikanju"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvik att rita om medan markören är dold för att minska flimmer vid rullning"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลีกเลี่ยงการวาดซ้ำขณะซ่อนเคอร์เซอร์เพื่อลดการกะพริบขณะเลื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırırken titremeyi azaltmak için imleç gizliyken yeniden çizmeyi önle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не перемальовувати, поки курсор схований, щоб зменшити мерехтіння під час прокручування"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tránh vẽ lại khi con trỏ bị ẩn để giảm nhấp nháy khi cuộn"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标隐藏时避免重绘，以减少滚动时的闪烁"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標隱藏時避免重新繪製，以減少捲動時的閃爍"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标隐藏时避免重绘以减少滚动闪烁"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游標隱藏時避免重新繪製，以減少捲動時的閃爍"
          }
        }
      }
    },
