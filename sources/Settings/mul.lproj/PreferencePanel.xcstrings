    "imM-Ma-mjV.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When locked, the terminal cannot change the title with a control sequence. This prevents changes you make in Session Name from being overridden.\"; ObjectID = \"imM-Ma-mjV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn gesperrt, kann das Terminal den Titel nicht per Steuersequenz ändern. Dies verhindert, dass Änderungen, die Sie im Sitzungsnamen vornehmen, überschrieben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When locked, the terminal cannot change the title with a control sequence. This prevents changes you make in Session Name from being overridden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックされている場合、ターミナルは制御シーケンスでタイトルを変更できません。これにより、セッション名で行った変更が上書きされるのを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠그면 터미널이 제어 시퀀스로 제목을 변경할 수 없습니다. 이렇게 하면 세션 이름에서 변경한 내용이 덮어써지지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando bloqueado, o terminal não pode alterar o título com uma sequência de controle. Isto evita que as alterações feitas em Nome da sessão sejam substituídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда заблокировано, терминал не может изменить заголовок управляющей последовательностью. Это предотвращает переопределение изменений, сделанных вами в «Имени сессии»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定时，终端不能通过控制序列更改标题。这可以防止你在“会话名称”中做的更改被覆盖。"
          }
        }
      }
    },
    "ioA-Y9-Zb4.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Status bar shows tmux status bar content, not native components\"; ObjectID = \"ioA-Y9-Zb4\";",
