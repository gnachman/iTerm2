    "7a3-MN-oQK.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Remember the size and position of previously closed windows\"; ObjectID = \"7a3-MN-oQK\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamatovat si velikost a polohu dříve zavřených oken"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk størrelse og placering af tidligere lukkede vinduer"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe und Position zuvor geschlossener Fenster merken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remember the size and position of previously closed windows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordar el tamaño y la posición de las ventanas cerradas anteriormente"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muista aiemmin suljettujen ikkunoiden koko ja sijainti"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoriser la taille et la position des fenêtres fermées précédemment"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda dimensione e posizione delle finestre chiuse in precedenza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前に閉じたウィンドウのサイズと位置を記憶する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 닫은 윈도우의 크기와 위치 기억"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk størrelsen og plasseringen til vinduer som er lukket tidligere"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onthoud formaat en positie van eerder gesloten vensters"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamiętaj rozmiar i położenie ostatnio zamkniętych okien"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar o tamanho e a posição das janelas fechadas anteriormente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запоминать размер и положение ранее закрытых окон"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamätať si veľkosť a polohu predtým zatvorených okien"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomni si velikost in položaj nedavno zaprtih oken"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom ihåg storlek och position för tidigare stängda fönster"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce kapatılan pencerelerin boyutunu ve konumunu hatırla"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi nhớ kích thước và vị trí của các cửa sổ đã đóng trước đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记住先前关闭窗口的大小和位置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記住先前關閉之視窗的大小與位置"
          }
        }
      }
