    "fwC-LQ-VKF.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Allow control sequences to enable or disable cursor blink?\"; ObjectID = \"fwC-LQ-VKF\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit řídicím sekvencím zapínat a vypínat blikání kurzoru?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad, at kontrolsekvenser slår markørens blink til eller fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuersequenzen erlauben, das Blinken des Cursors zu aktivieren oder zu deaktivieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow control sequences to enable or disable cursor blink?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Permitir que las secuencias de control activen o desactiven el parpadeo del cursor?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sallitaanko ohjaussarjojen ottaa kohdistimen vilkkuminen käyttöön tai poistaa se käytöstä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les séquences de contrôle à activer ou désactiver le clignotement du curseur ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consentire alle sequenze di controllo di abilitare o disabilitare il lampeggiamento del cursore?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制御シーケンスによるカーソル点滅の有効/無効化を許可しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 시퀀스로 커서 깜빡임을 켜거나 끌 수 있게 하겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal kontrollsekvenser kunne slå markørblinking på eller av?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogen besturingsreeksen het knipperen van de cursor in- of uitschakelen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy pozwalać sekwencjom sterującym na włączanie lub wyłączanie migania kursora?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que sequências de controle ativem ou desativem o piscar do cursor?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить управляющим последовательностям включать и выключать мигание курсора?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť riadiacim sekvenciám zapnúť alebo vypnúť blikanie kurzora?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali naj krmilna zaporedja omogočijo ali onemogočijo utripanje kazalca?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåta att styrsekvenser slår på eller av markörens blinkning?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim dizileri imlecin yanıp sönmesini etkinleştirip devre dışı bırakabilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép chuỗi điều khiển bật hoặc tắt nhấp nháy con trỏ?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许控制序列启用或停用光标闪烁？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許控制序列啟用或停用游標閃爍？"
          }
        }
      }
    },
