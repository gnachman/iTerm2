    "DC1-eH-vx4.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Prevent the system from sleeping while a session has this setting on.\"; ObjectID = \"DC1-eH-vx4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que el sistema entri en repòs mentre una sessió tingui aquesta opció activada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bránit uspání systému, dokud má některá relace toto nastavení zapnuté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhindr systemet i at gå i dvale, mens en session har denne indstilling slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält das System wach, solange eine Sitzung dies aktiviert hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποτροπή αναστολής λειτουργίας του συστήματος όσο μια συνεδρία έχει ενεργοποιημένη αυτή τη ρύθμιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prevent the system from sleeping while a session has this setting on."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the system from sleeping while a session has this setting on."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the system from sleeping while a session has this setting on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the system from sleeping while a session has this setting on."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the system from sleeping while a session has this setting on."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the system from sleeping while a session has this setting on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar que el sistema entre en reposo mientras una sesión tenga este ajuste activado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar que el sistema entre en reposo mientras una sesión tenga esta configuración activada."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar que el sistema entre en reposo mientras una sesión tenga esta configuración activada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estä järjestelmää siirtymästä lepotilaan, kun jollakin istunnolla tämä asetus on päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêcher le système de se mettre en veille tant qu’une session a ce réglage activé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêcher le système de se mettre en veille tant qu’une session a ce réglage activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक किसी सत्र में यह सेटिंग चालू है, सिस्टम को स्लीप में जाने से रोकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spriječi spavanje sustava dok sesija ima ovu postavku uključenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer alvásának megakadályozása, amíg egy munkamenetben ez a beállítás be van kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cegah sistem tertidur saat sesi mengaktifkan pengaturan ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedisci al sistema di andare in stop mentre una sessione ha questa impostazione attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定がオンになっているセッションがある間、システムのスリープを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정이 켜진 세션이 있는 동안 시스템이 잠자기에 들어가지 않게 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halang sistem daripada tidur semasa sesi mempunyai seting ini dihidupkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindre at systemet går i dvale mens en økt har denne innstillingen aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorkom dat het systeem in slaap valt zolang een sessie deze instelling heeft ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie pozwalaj systemowi przechodzić w stan uśpienia, gdy sesja ma włączone to ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir que o sistema entre em repouso enquanto uma sessão tiver este ajuste ativado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impedir que o sistema entre em repouso enquanto uma sessão tiver esta definição ativada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Împiedicați adormirea sistemului cât timp o sesiune are această configurare activată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не давать системе засыпать, пока настройка включена для сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabrániť uspatiu systému, kým má nejaká relácia toto nastavenie zapnuté."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepreči spanje sistema, dokler ima seja vklopljeno to nastavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhindra att systemet går i vila medan en session har den här inställningen på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้องกันไม่ให้ระบบเข้าสู่โหมดพักเครื่องขณะที่เซสชั่นเปิดการตั้งค่านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturumda bu ayar açıkken sistemin uykuya geçmesini engelle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не дозволяти системі переходити в стан сну, поки в сеансі ввімкнено цей параметр."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngăn hệ thống chuyển sang chế độ ngủ khi có phiên bật cài đặt này."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话启用此设置期间，防止系统进入睡眠。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段開啟此設定時，防止系統進入睡眠狀態。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置此选项时，防止系统进入睡眠状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段開啟此設定時，防止系統進入睡眠狀態。"
          }
        }
      }
    },
