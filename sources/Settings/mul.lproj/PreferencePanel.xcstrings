    "6417.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Always open in a new window, never in a tab\"; ObjectID = \"6417\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre sempre en una finestra nova, mai en una pestanya"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy otevírat v novém okně, nikdy v panelu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn altid i et nyt vindue, aldrig i en fane"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer in einem neuen Fenster öffnen, nie in einem Tab"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άνοιγμα πάντα σε νέο παράθυρο, ποτέ σε καρτέλα"
          }
        },
        "en" : {
