    "3cq-GS-KuB.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This setting also enables ligature support in the GPU renderer.\"; ObjectID = \"3cq-GS-KuB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung aktiviert auch die Ligatur-Unterstützung im GPU-Renderer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting also enables ligature support in the GPU renderer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定は、GPUレンダラーでの合字サポートも有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 GPU 렌더러에서의 합자 지원도 켭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ajuste também ativa o suporte a ligaduras no renderizador GPU."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот параметр также включает поддержку лигатур в GPU-рендерере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设置还会在 GPU 渲染器中启用连字支持。"
          }
        }
      }
    },
