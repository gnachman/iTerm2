            "state" : "translated",
            "value" : "Älykäs ikkunoiden sijoittelu asettaa uudet ikkunat sinne, missä on eniten vapaata tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le placement intelligent place les nouvelles fenêtres là où il y a le plus d’espace libre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le placement intelligent place les nouvelles fenêtres là où il y a le plus d’espace libre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्मार्ट विंडो प्लेसमेंट नई विंडो को वहाँ रखता है जहाँ सबसे अधिक खाली जगह हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pametno postavljanje prozora smješta nove prozore tamo gdje ima najviše slobodnog prostora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az intelligens ablakelhelyezés oda teszi az új ablakokat, ahol a legtöbb szabad hely van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penempatan jendela pintar menempatkan jendela baru di tempat dengan ruang kosong terluas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il posizionamento intelligente delle finestre mette le nuove finestre dove c’è più spazio libero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートウインドウ配置は、最も空きスペースがある場所に新しいウインドウを配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 윈도우 배치는 빈 공간이 가장 많은 곳에 새로운 윈도우를 배치합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peletakan tetingkap pintar meletakkan tetingkap baharu di tempat yang paling banyak ruang kosong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart vindusplassering plasserer nye vinduer der det er mest ledig plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimme vensterplaatsing zet nieuwe vensters op de plek met de meeste vrije ruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inteligentne rozmieszczanie okien umieszcza nowe okna tam, gdzie jest najwięcej wolnego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O posicionamento inteligente de janelas coloca as novas janelas onde há mais espaço livre disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O posicionamento inteligente de janelas coloca as novas janelas onde existe mais espaço livre disponível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasarea inteligentă a ferestrelor așază ferestrele noi acolo unde este cel mai mult spațiu liber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умное размещение окон помещает новые окна там, где больше всего свободного места."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inteligentné umiestňovanie okien umiestni nové okná tam, kde je najviac voľného miesta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pametna postavitev oken postavi nova okna tja, kjer je največ prostega prostora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart fönsterplacering placerar nya fönster där det finns mest ledigt utrymme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การวางหน้าต่างอัจฉริยะจะวางหน้าต่างใหม่ในตำแหน่งที่มีพื้นที่ว่างมากที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı pencere yerleşimi, yeni pencereleri en fazla boş alanın bulunduğu yere yerleştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розумне розміщення вікон розміщує нові вікна там, де найбільше вільного місця."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị trí cửa sổ thông minh đặt cửa sổ mới ở nơi có nhiều không gian trống nhất."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能窗口位置会将新窗口放置在可用空间最大的位置。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智慧視窗配置會將新視窗放在可用空間最多的地方。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能窗口放置会将新窗口放在可用空间最多的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智慧視窗配置會將新視窗放在可用空間最多的地方。"
          }
        }
      }
    },
