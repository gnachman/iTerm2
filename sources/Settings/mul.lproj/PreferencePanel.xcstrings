    "WVK-xs-N2h.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, small horizontal cursor movements are animated.\"; ObjectID = \"WVK-xs-N2h\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
