    "U7X-fp-NxP.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Clicking on a command selects it to restrict Find and Filter\"; ObjectID = \"U7X-fp-NxP\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutím na příkaz se vybere, aby se omezilo hledání a filtrování"
          }
        },
        "da" : {
          "stringUnit" : {
