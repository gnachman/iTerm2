        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir do Dock apenas se todas as janelas forem janelas de hotkey"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir do Dock apenas se todas as janelas forem janelas de hotkey"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
