    "NtK-Fc-1Kb.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When “Force keyboard” is on, iTerm2 continuously forces the selected layout while it is active, so you cannot switch to another layout within a session. Turn this on to force the layout only once, the first time a newly created terminal receives keyboard focus, leaving you free to change it afterward.\"; ObjectID = \"NtK-Fc-1Kb\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zapnuto „Vynutit klávesnici“, iTerm2 po dobu aktivity průběžně vynucuje vybrané rozložení, takže v rámci relace nelze přepnout na jiné. Zapnutím tohoto nastavení se rozložení vynutí jen jednou, když nově vytvořený terminál poprvé získá fokus klávesnice, a poté je můžete libovolně změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når “Gennemtving tastatur” er slået til, gennemtvinger iTerm2 løbende det valgte layout, mens det er aktivt, så du ikke kan skifte til et andet layout i en session. Slå dette til for kun at gennemtvinge layoutet én gang, første gang en nyoprettet terminal får tastaturfokus, så du bagefter frit kan ændre det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Tastatur erzwingen“ aktiviert ist, erzwingt iTerm2 fortlaufend das ausgewählte Layout, solange es aktiv ist, sodass Sie innerhalb einer Sitzung nicht zu einem anderen Layout wechseln können. Aktivieren Sie dies, um das Layout nur einmal zu erzwingen, beim ersten Mal, wenn ein neu erstelltes Terminal den Tastaturfokus erhält. Danach können Sie es frei ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When “Force keyboard” is on, iTerm2 continuously forces the selected layout while it is active, so you cannot switch to another layout within a session. Turn this on to force the layout only once, the first time a newly created terminal receives keyboard focus, leaving you free to change it afterward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando “Forzar teclado” está activado, iTerm2 fuerza continuamente la disposición seleccionada mientras está activa, por lo que no puedes cambiar a otra disposición dentro de una sesión. Activa esto para forzar la disposición solo una vez, la primera vez que una terminal recién creada recibe el foco del teclado, dejándote libre para cambiarla después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun ”Pakota näppäimistö” on päällä, iTerm2 pakottaa valitun asettelun jatkuvasti sen ollessa aktiivinen, joten et voi vaihtaa toiseen asetteluun istunnon aikana. Ota tämä käyttöön, jos haluat pakottaa asettelun vain kerran, kun vasta luotu pääte saa ensimmäisen kerran näppäimistön kohdistuksen, jolloin voit vaihtaa sen sen jälkeen vapaasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Forcer le clavier » est activé, iTerm2 impose en continu la disposition choisie tant qu’il est actif, ce qui vous empêche d’en changer dans une session. Activez cette option pour n’imposer la disposition qu’une seule fois, la première fois qu’un terminal nouvellement créé reçoit le focus clavier, ce qui vous laisse libre de la modifier ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Forza tastiera” è attivo, iTerm2 forza continuamente il layout selezionato finché è attivo, quindi non puoi passare a un altro layout all’interno di una sessione. Attivalo per forzare il layout una sola volta, la prima volta che un terminale appena creato riceve il focus della tastiera, lasciandoti libero di cambiarlo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「キーボードを強制」がオンの場合、iTerm2は有効な間、選択したレイアウトを常に強制するため、セッション内で別のレイアウトに切り替えることができません。これをオンにすると、新しく作成されたターミナルが最初にキーボードフォーカスを受け取ったときに一度だけレイアウトを強制し、その後は自由に変更できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“키보드 강제”가 켜져 있으면 iTerm2가 활성 상태인 동안 선택한 레이아웃을 계속 강제하므로 세션 안에서 다른 레이아웃으로 전환할 수 없습니다. 이 옵션을 켜면 새로 만든 터미널이 처음 키보드 포커스를 받을 때 한 번만 레이아웃을 강제하므로, 이후에는 자유롭게 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når «Tving tastatur» er aktivert, tvinger iTerm2 hele tiden det valgte tastaturoppsettet mens den er aktiv, slik at du ikke kan bytte til et annet oppsett i en økt. Slå dette på for å tvinge oppsettet bare én gang, første gang en nyopprettet terminal får tastaturfokus, slik at du kan endre det etterpå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als ‘Forceer toetsenbord’ is ingeschakeld, forceert iTerm2 voortdurend de geselecteerde indeling zolang de sessie actief is, waardoor je binnen een sessie niet naar een andere indeling kunt wisselen. Schakel dit in om de indeling maar één keer te forceren, de eerste keer dat een nieuw gemaakte terminal toetsenbordfocus krijgt, zodat je daarna vrij bent om te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy opcja „Wymuś klawiaturę” jest włączona, iTerm2 stale wymusza wybrany układ, dopóki jest aktywny, więc nie możesz przełączyć się na inny układ w obrębie sesji. Włącz tę opcję, aby wymusić układ tylko raz, przy pierwszym uzyskaniu fokusu klawiatury przez nowo utworzony terminal, dzięki czemu później możesz go swobodnie zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando “Forçar teclado” está ativado, o iTerm2 força continuamente o layout selecionado enquanto está ativo, de modo que você não pode alternar para outro layout dentro de uma sessão. Ative isto para forçar o layout apenas uma vez, na primeira vez que um terminal recém-criado receber o foco do teclado, deixando você livre para alterá-lo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включена функция «Принудительная клавиатура», iTerm2 постоянно применяет выбранную раскладку, пока она активна, поэтому вы не можете переключиться на другую раскладку в рамках сессии. Включите это, чтобы принудительное применение раскладки происходило только один раз, при первом получении фокуса клавиатуры новым терминалом, после чего вы сможете изменить её."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté „Vynútiť klávesnicu“, iTerm2 počas aktivity nepretržite vynucuje vybrané rozloženie klávesnice, takže v rámci relácie nemôžete prepnúť na iné. Zapnutím sa rozloženie vynúti iba raz, keď novo vytvorený terminál prvýkrát získa fokus klávesnice, a potom ho môžete voľne zmeniť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je vklopljena možnost »Vsili tipkovnico«, iTerm2 med aktivnostjo nenehno vsiljuje izbrano razporeditev, zato znotraj seje ne morete preklopiti na drugo razporeditev. Vklopite to, če želite razporeditev vsiliti samo enkrat, ko novo ustvarjen terminal prvič prejme fokus tipkovnice, tako da jo lahko pozneje spremenite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ”Tvinga tangentbord” är på tvingar iTerm2 hela tiden den valda layouten medan den är aktiv, så du kan inte byta till en annan layout i en session. Slå på detta för att tvinga layouten bara en gång, första gången en nyskapad terminal får tangentbordsfokus, så att du sedan fritt kan ändra den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Klavyeyi zorla” açıkken iTerm2, etkin olduğu sürece seçili düzeni sürekli zorlar; bu yüzden bir oturum içinde başka bir düzene geçemezsiniz. Düzenin yalnızca bir kez, yeni oluşturulan bir terminal klavye odağını ilk aldığında zorlanması ve sonrasında değiştirmekte serbest olmanız için bunu açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi “Buộc dùng bàn phím” bật, iTerm2 liên tục buộc dùng bố cục đã chọn khi nó đang hoạt động, nên bạn không thể chuyển sang bố cục khác trong một phiên. Bật tùy chọn này để chỉ buộc bố cục một lần, lần đầu terminal mới tạo nhận tiêu điểm bàn phím, để bạn tự do thay đổi sau đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“强制键盘”后，iTerm2 在其活动期间持续强制所选布局，因此你无法在会话内切换到其他布局。开启此项可仅在新建终端首次获得键盘焦点时强制一次布局，之后你可以自由更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「強制使用鍵盤」時，iTerm2 在使用中會持續強制使用所選的鍵盤配置，因此無法在工作階段內切換到其他配置。開啟此項可僅在新建立的終端機首次取得鍵盤焦點時強制一次，之後即可自由變更。"
          }
        }
      }
    },
    "NtK-Fc-1Kc.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Only force once per session when it first receives keyboard focus\"; ObjectID = \"NtK-Fc-1Kc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynutit jen jednou za relaci při prvním získání fokusu klávesnice"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemtving kun én gang pr. session, når den første gang får tastaturfokus"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur einmal pro Sitzung erzwingen, wenn sie zum ersten Mal den Tastaturfokus erhält"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only force once per session when it first receives keyboard focus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar solo una vez por sesión, cuando recibe el foco del teclado por primera vez"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakota vain kerran istuntoa kohti, kun se saa ensimmäisen kerran näppäimistön kohdistuksen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne forcer qu’une fois par session, au premier focus clavier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza una sola volta per sessione, al primo focus della tastiera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが最初にキーボードフォーカスを受け取ったときに一度だけ強制する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 처음 키보드 포커스를 받을 때 세션당 한 번만 강제 적용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tving bare én gang per økt, første gang den får tastaturfokus"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forceer maar één keer per sessie, bij de eerste toetsenbordfocus"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuszaj tylko raz na sesję, gdy po raz pierwszy uzyska fokus klawiatury"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forçar apenas uma vez por sessão, quando ela receber o foco do teclado pela primeira vez"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применять принудительно только один раз за сессию, при первом получении фокуса клавиатуры"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynútiť iba raz za reláciu, keď prvýkrát získa fokus klávesnice"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsili samo enkrat na sejo, ko prvič prejme fokus tipkovnice"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvinga bara en gång per session när den först får tangentbordsfokus"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca oturum klavye odağını ilk aldığında bir kez zorla"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ buộc một lần mỗi phiên khi nhận tiêu điểm bàn phím lần đầu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当会话首次获得键盘焦点时强制一次"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個工作階段僅在首次取得鍵盤焦點時強制一次"
          }
        }
      }
    },
    "ntr-oS-YE8.title" : {
