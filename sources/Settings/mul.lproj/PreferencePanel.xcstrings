    "5331.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Dimming affects only text, not background.\"; ObjectID = \"5331\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztlumení se týká jen textu, ne pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dæmpning påvirker kun tekst, ikke baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abdunkelung betrifft nur den Text, nicht den Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dimming affects only text, not background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La atenuación solo afecta al texto, no al fondo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmennys vaikuttaa vain tekstiin, ei taustaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’atténuation n’affecte que le texte, pas l’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attenuazione riguarda solo il testo, non lo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この暗さの調整はテキストのみに影響し、背景には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐리게 하기가 배경에는 적용되지 않고 텍스트에만 적용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimming påvirker bare teksten, ikke bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmen werkt alleen op tekst, niet op de achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciemnianie dotyczy tylko tekstu, a nie tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escurecimento afeta apenas o texto, não o plano de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затемнение влияет только на текст, но не на фон."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlmenie ovplyvní iba text, nie pozadie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatemnitev vpliva samo na besedilo, ne na ozadje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedtoningen påverkar bara texten, inte bakgrunden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soluklaştırma yalnızca metni etkiler, arka planı etkilemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mờ chỉ ảnh hưởng văn bản, không ảnh hưởng nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调暗仅影响文本，不影响背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調暗僅影響文字，不影響背景。"
          }
        }
      }
    },
    "5337.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"Inactive sessions get dimmed to help find the active session.\"; ObjectID = \"5337\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktivní relace se ztlumí, aby bylo snazší najít aktivní relaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive sessioner dæmpes, så det er nemmere at finde den aktive session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive Sitzungen werden abgedunkelt, um das Auffinden der aktiven Sitzung zu erleichtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Inactive sessions get dimmed to help find the active session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones inactivas se atenúan para ayudar a encontrar la sesión activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei-aktiiviset istunnot himmennetään, jotta aktiivinen istunto löytyy helpommin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions inactives sont atténuées pour aider à repérer la session active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni inattive vengono attenuate per aiutarti a trovare quella attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非アクティブなセッションは暗くなり、アクティブなセッションを見つけやすくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 세션을 쉽게 찾을 수 있도록 비활성 세션을 흐리게 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktive økter dimmes slik at det er lettere å finne den aktive økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inactieve sessies worden gedimd, zodat je de actieve sessie makkelijker vindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieaktywne sesje są przyciemniane, aby łatwiej było znaleźć aktywną sesję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões inativas são escurecidas para ajudar a encontrar a sessão ativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неактивные сеансы затемняются, чтобы было легче найти активный сеанс."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktívne relácie sa stlmia, aby bolo ľahšie nájsť aktívnu reláciu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neaktivne seje so zatemnjene, da je aktivno sejo lažje najti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaktiva sessioner tonas ned så att det blir lättare att hitta den aktiva sessionen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin oturumu bulmaya yardımcı olmak için etkin olmayan oturumlar soluklaştırılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các phiên không hoạt động được làm mờ để giúp tìm phiên đang hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非活动会话会变暗，以帮助找到活动会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非使用中的工作階段會變暗，以便找出使用中的工作階段。"
          }
        }
      }
    },
