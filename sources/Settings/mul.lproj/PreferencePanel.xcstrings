    "GD3-XJ-mYL.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If disabled, then triple click selects one line as it appears onscreen.\"; ObjectID = \"GD3-XJ-mYL\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je vypnuto, trojí kliknutí vybere jeden řádek tak, jak je zobrazen na obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er slået fra, markerer tripelklik én linje, som den vises på skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, wählt ein Dreifachklick eine Zeile so aus, wie sie auf dem Bildschirm erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If disabled, then triple click selects one line as it appears onscreen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, el triple clic selecciona una línea tal como aparece en pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä ei ole käytössä, kolmoisklikkaus valitsee yhden rivin sellaisena kuin se näkyy näytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est désactivée, le triple clic sélectionne une ligne telle qu’elle apparaît à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è disattivato, il triplo clic seleziona una riga così com’è visualizzata sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無効にすると、トリプルクリックで画面表示どおりの1行が選択されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 세 번 클릭 시 화면에 보이는 대로 한 줄을 선택합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er av, markerer trippelklikk én linje slik den vises på skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is uitgeschakeld, selecteert een drievoudige klik één regel zoals die op het scherm verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ta opcja jest wyłączona, potrójne kliknięcie zaznacza jeden wiersz tak, jak jest widoczny na ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desativado, o clique triplo seleciona uma linha conforme aparece na tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если отключено, тройной щелчок выделяет одну строку в том виде, в котором она отображается на экране."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je vypnuté, trojité kliknutie vyberie jeden riadok tak, ako sa zobrazuje na obrazovke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je onemogočeno, trojni klik izbere eno vrstico, kot je prikazana na zaslonu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är av markerar trippelklick en rad som den visas på skärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devre dışıysa üçlü tıklama, ekranda göründüğü şekliyle tek bir satırı seçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu tắt, bấm ba lần sẽ chọn một dòng như hiển thị trên màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，三连按选择屏幕上显示的一行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，按三下會選取螢幕上顯示的一行。"
          }
        }
      }
    },
