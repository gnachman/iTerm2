    "QcY-Dm-Vmc.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"When set, the Open Quickly window can be opened even when another app is active.\"; ObjectID = \"QcY-Dm-Vmc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, la finestra d’Obre ràpidament es pot obrir fins i tot quan hi ha una altra app activa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li nastaveno, okno Otevřít rychle lze otevřít i tehdy, když je aktivní jiná aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er angivet, kan vinduet Åbn hurtigt åbnes, selv når en anden app er aktiv."
          }
