        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la transparencia se puede alternar ventana por ventana en Visualización > Usar transparencia"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la transparencia se puede alternar ventana por ventana en Visualización > Usar transparencia"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, la transparencia se puede alternar ventana por ventana en Visualización > Usar transparencia"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on päällä, läpinäkyvyyden voi kytkeä ikkunakohtaisesti kohdasta Näytä > Käytä läpinäkyvyyttä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, la transparence peut être activée fenêtre par fenêtre via Présentation > Utiliser la transparence"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, la transparence peut être activée fenêtre par fenêtre par Présentation > Utiliser la transparence"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर, दृश्य > ट्रांसपरेंसी का उपयोग करें से ट्रांसपरेंसी को विंडो-दर-विंडो टॉगल किया जा सकता है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako je ovo uključeno, prozirnost se može uključivati/isključivati za svaki prozor posebno u Prikaz > Koristi prozirnost"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ez be van kapcsolva, az átlátszóság ablakonként átkapcsolható a „Nézet > Átlátszóság használata” helyen"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ini menyala, transparansi dapat dinyalakan/dimatikan per jendela di Lihat > Gunakan Transparansi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attiva, la trasparenza può essere attivata finestra per finestra da Vista > Usa trasparenza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、「表示」>「透明度を使用」で透明度をウィンドウごとに切り替えられます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 보기 > 투명도 사용에서 윈도우별로 투명도를 켜거나 끌 수 있습니다"
