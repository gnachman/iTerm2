    "ZlO-15-adn.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this is enabled, dragging a file into the terminal pastes its path wrapped in double quotes so that spaces and special characters are preserved. When disabled, special characters in the path are escaped with backslashes instead.\"; ObjectID = \"ZlO-15-adn\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, přetažení souboru do terminálu vloží jeho cestu v dvojitých uvozovkách, aby se zachovaly mezery a speciální znaky. Je-li vypnuto, speciální znaky v cestě se místo toho uvozují zpětnými lomítky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, indsættes stien til et arkiv, der trækkes ind i terminalen, omgivet af dobbelte anførselstegn, så mellemrum og specialtegn bevares. Når det er slået fra, escapes specialtegn i stien i stedet med omvendte skråstreger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, wird beim Ziehen einer Datei in das Terminal ihr Pfad in doppelten Anführungszeichen eingefügt, damit Leerzeichen und Sonderzeichen erhalten bleiben. Wenn dies deaktiviert ist, werden Sonderzeichen im Pfad stattdessen mit Backslashes maskiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When this is enabled, dragging a file into the terminal pastes its path wrapped in double quotes so that spaces and special characters are preserved. When disabled, special characters in the path are escaped with backslashes instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, al arrastrar un archivo a la terminal se pega su ruta entre comillas dobles para conservar los espacios y los caracteres especiales. Si está desactivado, los caracteres especiales de la ruta se escapan con barras invertidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, tiedoston vetäminen päätteeseen sijoittaa sen polun kaksoislainausmerkkeihin, jotta välilyönnit ja erikoismerkit säilyvät. Kun tämä ei ole käytössä, polun erikoismerkit suojataan kenoviivoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, faire glisser un fichier dans le terminal colle son chemin entre guillemets doubles afin de préserver les espaces et les caractères spéciaux. Sinon, les caractères spéciaux du chemin sont échappés avec des barres obliques inverses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se questa opzione è attiva, trascinando un file nel terminale ne incolli il percorso tra virgolette doppie, in modo da preservare spazi e caratteri speciali. Se è disattivata, i caratteri speciali nel percorso vengono preceduti da una barra rovesciata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすると、ファイルをターミナルにドラッグしたときに、スペースや特殊文字が保持されるようにパスが二重引用符で囲まれて貼り付けられます。無効にすると、代わりにパス内の特殊文字がバックスラッシュでエスケープされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 켜면 파일을 터미널로 드래그할 때 공백과 특수 문자가 유지되도록 경로를 큰따옴표로 감싸서 붙여넣습니다. 끄면 대신 경로의 특수 문자를 백슬래시로 이스케이프합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, limes banen inn i dobbelte anførselstegn når du drar en fil inn i terminalen, slik at mellomrom og spesialtegn bevares. Når det er deaktivert, escapes spesialtegn i banen med omvendt skråstrek i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, wordt bij het slepen van een bestand naar de terminal het pad tussen dubbele aanhalingstekens geplakt, zodat spaties en speciale tekens behouden blijven. Als dit is uitgeschakeld, worden speciale tekens in het pad met backslashes geëscapet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, przeciągnięcie pliku do terminala wkleja jego ścieżkę w cudzysłowie, aby zachować spacje i znaki specjalne. Gdy jest wyłączona, znaki specjalne w ścieżce są poprzedzane ukośnikami odwrotnymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, arrastar um arquivo para o terminal cola seu caminho entre aspas duplas para que espaços e caracteres especiais sejam preservados. Quando desativado, os caracteres especiais do caminho são escapados com barras invertidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, при перетаскивании файла в терминал его путь вставляется в двойных кавычках, чтобы сохранить пробелы и специальные символы. Если параметр выключен, специальные символы в пути экранируются обратными косыми чертами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je táto možnosť zapnutá, pri potiahnutí súboru do terminálu sa jeho cesta vloží v dvojitých úvodzovkách, aby sa zachovali medzery a špeciálne znaky. Ak je vypnutá, špeciálne znaky v ceste sa namiesto toho uvedú spätnými lomkami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je to omogočeno, se pri povleku datoteke v terminal njena pot prilepi v dvojnih narekovajih, tako da se ohranijo presledki in posebni znaki. Če je onemogočeno, se posebni znaki v poti izognejo z obratnimi poševnicami."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är aktiverat klistras sökvägen in inom dubbla citattecken när du drar en fil till terminalen, så att mellanslag och specialtecken bevaras. När det är avaktiverat skyddas specialtecken i sökvägen med omvända snedstreck i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek etkinken, bir dosyayı terminale sürüklemek dosyanın yolunu çift tırnak içinde yapıştırır; böylece boşluklar ve özel karakterler korunur. Devre dışıyken yoldaki özel karakterler ters eğik çizgiyle kaçırılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, kéo một tệp vào terminal sẽ dán đường dẫn của tệp đó trong dấu ngoặc kép để giữ nguyên khoảng trắng và ký tự đặc biệt. Khi tắt, các ký tự đặc biệt trong đường dẫn sẽ được thoát bằng dấu gạch chéo ngược."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，将文件拖入终端时会把其路径用双引号括起来粘贴，以保留空格和特殊字符。禁用时，路径中的特殊字符会改用反斜杠转义。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，將檔案拖移到終端機時，會貼上以雙引號括住的路徑，以保留空格與特殊字元。停用時，路徑中的特殊字元會改以反斜線跳脫。"
          }
        }
      }
    },
