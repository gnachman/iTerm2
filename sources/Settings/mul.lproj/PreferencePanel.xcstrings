    "h9O-XG-Evs.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Disable all confirmations on system shutdown, restart, and log out\"; ObjectID = \"h9O-XG-Evs\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva totes les confirmacions en apagar, reiniciar i tancar la sessió del sistema"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnout všechna potvrzení při vypnutí, restartu a odhlášení systému"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå alle bekræftelser fra ved lukning, genstart og udlogning af systemet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Bestätigungen beim Herunterfahren, Neustarten und Abmelden des Systems deaktivieren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποίηση όλων των επιβεβαιώσεων κατά τον τερματισμό, την επανεκκίνηση και την αποσύνδεση του συστήματος"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disable all confirmations on system shutdown, restart, and log out"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable all confirmations on system shutdown, restart, and log out"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable all confirmations on system shutdown, restart, and log out"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable all confirmations on system shutdown, restart, and log out"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable all confirmations on system shutdown, restart, and log out"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disable all confirmations on system shutdown, restart, and log out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar todas las confirmaciones al apagar, reiniciar y cerrar sesión en el sistema"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar todas las confirmaciones al apagar, reiniciar y cerrar sesión en el sistema"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar todas las confirmaciones al apagar, reiniciar y cerrar sesión en el sistema"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista käytöstä kaikki vahvistukset järjestelmän sammutuksessa, uudelleenkäynnistyksessä ja uloskirjautumisessa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver toutes les confirmations à l’arrêt, au redémarrage et à la fermeture de session du système"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver toutes les confirmations à l’arrêt, au redémarrage et à la fermeture de session du système"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम शटडाउन, रीस्टार्ट और लॉग आउट पर सभी पुष्टिकरण अक्षम करें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogući sve potvrde pri gašenju, ponovnom pokretanju i odjavi sustava"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összes megerősítés letiltása leállításkor, újraindításkor és kijelentkezéskor"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktifkan semua konfirmasi saat mematikan, memulai ulang, dan keluar dari sistem"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabilita tutte le conferme allo spegnimento, al riavvio e alla disconnessione del sistema"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのシャットダウン、再起動、ログアウト時の確認をすべて無効にする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 종료, 재시동 및 로그아웃 시 모든 확인 끄기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyahdayakan semua pengesahan semasa sistem dimatikan, dimulakan semula dan log keluar"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiver alle bekreftelser ved avslutning, omstart og utlogging av systemet"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel alle bevestigingen bij het afsluiten, herstarten en uitloggen van het systeem uit"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz wszystkie potwierdzenia przy wyłączaniu, ponownym uruchamianiu i wylogowaniu z systemu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar todas as confirmações ao desligar, reiniciar e encerrar a sessão do sistema"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar todas as confirmações ao desligar, reiniciar e terminar sessão no sistema"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivați toate confirmările la oprirea, repornirea și delogarea din sistem"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не подтверждать выключение, перезагрузку и выход"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnúť všetky potvrdenia pri vypnutí, reštarte a odhlásení systému"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogoči vsa potrjevanja pri zaustavitvi, ponovnem zagonu in odjavi sistema"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaktivera alla bekräftelser vid avstängning, omstart och utloggning av systemet"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดใช้การยืนยันทั้งหมดเมื่อปิดเครื่อง เริ่มการทำงานใหม่ และออกจากระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem kapatma, yeniden başlatma ve oturum kapatmadaki tüm onayları devre dışı bırak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкнути всі підтвердження під час вимкнення, перезапуску та виходу із системи"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt mọi xác nhận khi tắt máy, khởi động lại và đăng xuất hệ thống"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用系统关机、重新启动和退出登录时的所有确认"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用系統關機、重新啟動和登出時的所有確認"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统关机、重启和注销时停用所有确认"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用系統關機、重新啟動和登出時的所有確認"
          }
        }
      }
    },
