    "r4L-CE-8Bh.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"⚠️ You may want a trigger to stop buffering\"; ObjectID = \"r4L-CE-8Bh\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Možná budete chtít spouštěč, který ukládání do vyrovnávací paměti zastaví"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Du vil måske have en udløser, der stopper bufferingen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Möglicherweise möchten Sie einen Trigger verwenden, um die Pufferung zu stoppen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⚠️ You may want a trigger to stop buffering"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Quizá quieras un disparador para detener el almacenamiento en búfer"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Kannattaa ehkä lisätä käynnistin puskuroinnin lopettamiseksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Vous voudrez peut-être un déclencheur pour arrêter la mise en tampon"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Potresti volere un attivatore per interrompere il buffering"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ バッファリングを停止するトリガーが必要な場合があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 버퍼링을 중지하는 트리거가 필요할 수 있습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Du bør kanskje ha en utløser som stopper bufring"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Misschien wil je een trigger om het bufferen te stoppen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Warto dodać wyzwalacz, aby zatrzymać buforowanie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Você pode querer um gatilho para parar de armazenar em buffer"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Возможно, вам понадобится триггер, чтобы остановить буферизацию"
