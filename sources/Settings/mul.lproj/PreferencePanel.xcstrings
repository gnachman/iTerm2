    "elQ-vX-kkH.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Avoid repainting while cursor is hidden to reduce flicker while scrolling\"; ObjectID = \"elQ-vX-kkH\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepřekreslovat, když je kurzor skrytý, aby se omezilo blikání při posouvání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undgå gentegning, mens markøren er skjult, for at reducere flimren under rulning"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuzeichnen bei ausgeblendetem Cursor vermeiden, um Scroll-Flackern zu reduzieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avoid repainting while cursor is hidden to reduce flicker while scrolling"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar volver a dibujar mientras el cursor está oculto para reducir el parpadeo al desplazar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vältä uudelleenpiirtoa kohdistimen ollessa kätkettynä, jotta vierityksen välkkyminen vähenee"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éviter de redessiner lorsque le curseur est masqué pour réduire le scintillement pendant le défilement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita di ridisegnare mentre il cursore è nascosto per ridurre lo sfarfallio durante lo scorrimento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロール中のちらつきを軽減するため、カーソルが非表示の間は再描画を避ける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 시 깜박임을 줄이기 위해 커서가 숨겨져 있는 동안 다시 그리지 않기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå ny tegning mens markøren er skjult, for å redusere flimring ved rulling"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermijd opnieuw tekenen terwijl de cursor verborgen is om flikkeren tijdens het scrollen te verminderen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj ponownego rysowania, gdy kursor jest ukryty, aby zmniejszyć migotanie podczas przewijania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar redesenhar enquanto o cursor está oculto para reduzir a cintilação ao rolar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не перерисовывать при скрытом курсоре, уменьшая мерцание при прокрутке"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevykresľovať znovu, kým je kurzor skrytý, aby sa znížilo blikanie pri rolovaní"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skritim kazalcem se izogibaj ponovnemu risanju, da zmanjšaš utripanje pri pomikanju"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvik att rita om medan markören är dold för att minska flimmer vid rullning"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırırken titremeyi azaltmak için imleç gizliyken yeniden çizmeyi önle"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tránh vẽ lại khi con trỏ bị ẩn để giảm nhấp nháy khi cuộn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
