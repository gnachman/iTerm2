    "6111.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu.\"; ObjectID = \"6111\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicacions de terminal que utilitzen l’informe del ratolí, en activar això el clic amb Control s’informa a l’app en lloc d’obrir el menú contextual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U terminálových aplikací používajících hlášení myši zapnutí umožní hlásit kliknutí s Control místo otevření kontextové nabídky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminalprogrammer, der bruger musrapportering, gør dette det muligt at rapportere ctrl-klik i stedet for at åbne lokalmenuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Terminalanwendungen, die Mausberichte verwenden, ermöglicht diese Option, dass ein Control-Klick gemeldet wird, anstatt das Kontextmenü zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για εφαρμογές τερματικού που χρησιμοποιούν αναφορά ποντικιού, η ενεργοποίηση αυτής της επιλογής επιτρέπει την αναφορά του κλικ με Control αντί για το άνοιγμα του μενού περιβάλλοντος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminal applications that use mouse reporting, turning this on allows control-click to be reported instead of opening the context menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicaciones de terminal que usan el informe del ratón, al activar esto el clic con Control se informa a la app en lugar de abrir el menú contextual."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicaciones de terminal que usan el reporte del mouse, al activar esto el clic con Control se informa a la app en lugar de abrir el menú contextual."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aplicaciones de terminal que usan el reporte del mouse, al activar esto el clic con Control se informa a la app en lugar de abrir el menú contextual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on päällä, päätesovelluksille, jotka käyttävät hiiren raportointia, ctrl-klikkaus raportoidaan sovellukselle sen sijaan, että kontekstivalikko avautuisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les applications de terminal qui utilisent le signalement de la souris, activer cette option permet de signaler le clic avec Contrôle au lieu d’ouvrir le menu contextuel."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les applications de terminal qui utilisent le signalement de la souris, activer cette option permet de signaler le clic avec Contrôle au lieu d’ouvrir le menu contextuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माउस रिपोर्टिंग का उपयोग करने वाले टर्मिनल ऐप्लिकेशन के लिए, इसे चालू करने पर कंट्रोल-क्लिक संदर्भ मेन्यू खोलने के बजाय रिपोर्ट किया जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za terminalske aplikacije koje koriste izvještavanje o mišu, uključivanjem ovoga Control-klik se prijavljuje aplikaciji umjesto otvaranja kontekstnog izbornika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egérjelentést használó terminálalkalmazásoknál ennek bekapcsolásakor a Control-kattintás jelentésként az alkalmazásnak kerül átadásra, a helyi menü megnyitása helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk aplikasi terminal yang menggunakan pelaporan tetikus, menyalakan ini memungkinkan klik Control dilaporkan alih-alih membuka menu konteks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per le app da terminale che usano la segnalazione del mouse, attivandolo il clic con Controllo viene segnalato all’app invece di aprire il menu contestuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスレポートを使用するターミナルアプリケーションでは、これをオンにするとコンテキストメニューを開く代わりにコントロールクリックが報告されるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 리포팅을 사용하는 터미널 앱에서 이 옵션을 켜면 Control-클릭 시 컨텍스트 메뉴를 여는 대신 클릭이 앱에 보고됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagi aplikasi terminal yang menggunakan pelaporan tetikus, menghidupkan ini membolehkan klik Control dilaporkan dan bukannya membuka menu konteks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For terminalapper som bruker museraportering gjør dette at Kontroll-klikk rapporteres i stedet for å åpne kontekstmenyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor terminalapps die muisrapportage gebruiken: als je dit inschakelt, wordt een klik met Control doorgegeven in plaats van dat het contextmenu opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W aplikacjach terminalowych korzystających z raportowania myszy włączenie tej opcji sprawia, że kliknięcie z klawiszem Control jest przekazywane aplikacji zamiast otwierać menu kontekstowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicativos de terminal que usam relato de mouse, ativar isto permite que o clique com Control seja relatado em vez de abrir o menu de contexto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aplicações de terminal que usam comunicação do rato, ativar isto permite que o clique com Control seja comunicado em vez de abrir o menu de contexto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru aplicațiile de terminal care folosesc raportarea mausului, activarea aceasta permite raportarea clicului cu Control în loc de deschiderea meniului contextual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для терминальных приложений, использующих отчёты о мыши, включение этой опции позволяет передавать control-клик приложению вместо открытия контекстного меню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri terminálových aplikáciách, ktoré používajú hlásenie myši, zapnutie tejto možnosti umožní hlásiť kliknutie s klávesom Control namiesto otvorenia kontextového menu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri terminalskih aplikacijah, ki uporabljajo poročanje miške, vklop te možnosti omogoči, da se klik s tipko Control sporoči aplikaciji namesto odprtja kontekstnega menija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För terminalprogram som använder musrapportering gör detta att kontroll-klick rapporteras i stället för att kontextmenyn öppnas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับแอปเทอร์มินัลที่ใช้การรายงานเมาส์ การเปิดตัวเลือกนี้จะรายงานการคลิกพร้อมปุ่ม Control แทนการเปิดเมนูบริบท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare raporlaması kullanan terminal uygulamalarında, bunu açmak Control-tıklamanın bağlam menüsünü açmak yerine uygulamaya bildirilmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для термінальних програм, що використовують звітування про мишу, ввімкнення дозволяє передавати програмі клацання з Control замість відкриття контекстного меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với các ứng dụng terminal dùng báo cáo chuột, bật tùy chọn này cho phép báo cáo thao tác bấm với Control thay vì mở menu ngữ cảnh."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端App，打开此选项后，Control点按会被报告给App，而不是打开上下文菜单。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於使用滑鼠報告的終端機 App，開啟此選項後，Control-按一下會報告給 App，而不是開啟快速選單。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于使用鼠标报告的终端应用，开启此选项后，控制点按会被报告给应用，而不是打开上下文菜单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於使用滑鼠回報的終端機 App，開啟此選項後，Control-按一下會回報給 App，而不是打開快速選單。"
          }
        }
      }
    },
