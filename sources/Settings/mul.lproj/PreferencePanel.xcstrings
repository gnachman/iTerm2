    "RBx-qn-HNB.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Animate cursor only in interactive apps\"; ObjectID = \"RBx-qn-HNB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animovat kurzor jen v interaktivních aplikacích"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animer kun markør i interaktive apps"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor nur in interaktiven Apps animieren"
          }
        },
        "en" : {
