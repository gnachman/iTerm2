          "stringUnit" : {
            "state" : "translated",
            "value" : "Orsaken till att detta är avaktiverat visas här"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun devre dışı olma nedeni buraya gelir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lý do mục này bị tắt hiển thị ở đây"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reason this is diabled goes here"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此項停用的原因置於此處"
