    "3cq-GS-KuB.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"This setting also enables ligature support in the GPU renderer.\"; ObjectID = \"3cq-GS-KuB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta opció també activa la compatibilitat amb lligadures al renderitzador de GPU."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavení také zapíná podporu ligatur ve vykreslovacím modulu GPU."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling slår også understøttelse af ligaturer til i GPU-gengivelsesmotoren."
          }
        },
        "de" : {
