    "wgv-Ah-fFr.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this option is off, double click selects a word as defined by “characters considered part of word for selection” in the General tab. When this option is on, double click uses smart selection to select file names, URLs, etc., using regular expressions defined in Profiles>Advanced>Smart Selection.\"; ObjectID = \"wgv-Ah-fFr\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aquesta opció està desactivada, el doble clic selecciona una paraula tal com es defineix a “Caràcters considerats part d’una paraula” a la pestanya General. Si està activada, el doble clic fa servir la selecció intel·ligent per seleccionar noms d’arxiu, URLs, etc., mitjançant les expressions regulars definides a Perfils > Avançat > Selecció intel·ligent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je tato volba vypnuta, dvojí kliknutí vybere slovo podle definice „znaky považované za součást slova při výběru“ na kartě Obecné. Když je zapnuta, dvojí kliknutí použije chytrý výběr k výběru názvů souborů, URL apod. pomocí regulárních výrazů definovaných v části „Profily > Pokročilé > Chytrý výběr“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når denne indstilling er slået fra, markerer dobbeltklik et ord som defineret af “tegn, der betragtes som en del af et ord ved markering” under Generelt. Når den er slået til, bruger dobbeltklik smart markering til at markere arkivnavne, URL’er osv. med de regulære udtryk, der er defineret i Profiler > Avanceret > Smart markering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option deaktiviert ist, wählt ein Doppelklick ein Wort aus, wie es durch „Als Teil eines Worts geltende Zeichen für die Auswahl“ im Tab Allgemein definiert ist. Wenn diese Option aktiviert ist, verwendet ein Doppelklick die intelligente Auswahl, um Dateinamen, URLs usw. mithilfe regulärer Ausdrücke auszuwählen, die unter Profile>Erweitert>Intelligente Auswahl definiert sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν αυτή η επιλογή είναι απενεργοποιημένη, το διπλό κλικ επιλέγει μια λέξη όπως ορίζεται από τους «χαρακτήρες που θεωρούνται μέρος λέξης για την επιλογή» στην καρτέλα Γενικά. Όταν είναι ενεργοποιημένη, το διπλό κλικ χρησιμοποιεί την έξυπνη επιλογή για να επιλέξει ονόματα αρχείων, URL κ.λπ., με τις κανονικές παραστάσεις που ορίζονται στις Προφίλ > Προηγμένα > Έξυπνη επιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When this option is off, double click selects a word as defined by “characters considered part of word for selection” in the General tab. When this option is on, double click uses smart selection to select file names, URLs, etc., using regular expressions defined in Profiles>Advanced>Smart Selection."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this option is off, double click selects a word as defined by “characters considered part of word for selection” in the General tab. When this option is on, double click uses smart selection to select file names, URLs, etc., using regular expressions defined in Profiles>Advanced>Smart Selection."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this option is off, double click selects a word as defined by “characters considered part of word for selection” in the General tab. When this option is on, double click uses smart selection to select file names, URLs, etc., using regular expressions defined in Profiles>Advanced>Smart Selection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
