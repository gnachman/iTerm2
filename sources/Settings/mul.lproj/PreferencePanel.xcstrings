    "Qz5-Ow-iQt.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline.\"; ObjectID = \"Qz5-Ow-iQt\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la integració amb l’intèrpret d’ordres està activada, això evita que els indicadors d’ordres comencin enmig d’una línia quan l’ordre anterior no ha acabat amb un salt de línia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuta integrace shellu, brání to tomu, aby výzvy příkazového řádku začínaly uprostřed řádku, když předchozí příkaz nekončil novým řádkem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Shell-integration er slået til, forhindrer dette, at kommandoprompter starter midt på en linje, når den forrige kommando ikke sluttede med et linjeskift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Shell-Integration aktiviert ist, verhindert dies, dass Eingabeaufforderungen mitten in einer Zeile beginnen, wenn der vorherige Befehl nicht mit einem Zeilenumbruch endete."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η ενσωμάτωση κελύφους είναι ενεργοποιημένη, αυτό αποτρέπει την έναρξη των γραμμών προτροπής στη μέση μιας γραμμής όταν η προηγούμενη εντολή δεν τελείωνε με νέα γραμμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Shell Integration is enabled, this prevents command prompts from starting in the middle of a line when the previous command did not end with a newline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la integración con el shell está activada, esto evita que los prompts de comandos empiecen en mitad de una línea cuando el comando anterior no terminó con un salto de línea."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la integración con el shell está activada, esto evita que los prompts de comandos empiecen en mitad de una línea cuando el comando anterior no terminó con un salto de línea."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la integración con el shell está activada, esto evita que los prompts de comandos empiecen en mitad de una línea cuando el comando anterior no terminó con un salto de línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos komentotulkki-integraatio on käytössä, tämä estää komentokehotteita alkamasta rivin keskeltä, kun edellinen komento ei päättynyt rivinvaihtoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’intégration du shell est activée, cela empêche les invites de commande de démarrer au milieu d’une ligne quand la commande précédente ne s’est pas terminée par un saut de ligne."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’intégration de la coque logicielle est activée, cela empêche les invites de commande de démarrer au milieu d’une ligne quand la commande précédente ne s’est pas terminée par un saut de ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेल इंटीग्रेशन सक्षम होने पर, यह पिछली कमांड नई लाइन पर समाप्त न होने की स्थिति में कमांड प्रॉम्प्ट को लाइन के बीच से शुरू होने से रोकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako je Integracija ljuske omogućena, ovo sprječava da odzivnici naredbi počinju usred retka kad prethodna naredba nije završila novim retkom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a Shellintegráció engedélyezve van, ez megakadályozza, hogy a parancspromptok egy sor közepén kezdődjenek, ha az előző parancs nem újsorral végződött."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Integrasi Shell diaktifkan, ini mencegah prompt perintah dimulai di tengah baris saat perintah sebelumnya tidak diakhiri dengan baris baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’integrazione shell è abilitata, impedisce che i prompt dei comandi inizino a metà riga quando il comando precedente non è terminato con un ritorno a capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェル統合が有効な場合、これにより、前のコマンドが改行で終わらなかったときにコマンドプロンプトが行の途中から始まるのを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 통합이 켜져 있으면, 이전 명령이 줄바꿈으로 끝나지 않았을 때 명령 프롬프트가 줄 중간에서 시작되지 않도록 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika Integrasi Cangkerang didayakan, ini menghalang gesaan perintah daripada bermula di tengah baris apabila perintah sebelumnya tidak berakhir dengan baris baharu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis skallintegrering er aktivert, hindrer dette at ledetekster starter midt i en linje når forrige kommando ikke endte med et linjeskift."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Shell-integratie is ingeschakeld, voorkomt dit dat commandoprompts midden in een regel beginnen als het vorige commando niet met een regeleinde eindigde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli integracja z powłoką jest włączona, zapobiega to rozpoczynaniu znaków zachęty w środku wiersza, gdy poprzednie polecenie nie zakończyło się znakiem nowego wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a Shell Integration estiver ativada, isto evita que os prompts de comando comecem no meio de uma linha quando o comando anterior não terminou com uma quebra de linha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a Shell Integration estiver ativada, isto evita que os prompts de comando comecem a meio de uma linha quando o comando anterior não terminou com uma mudança de linha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă Integrarea shell este activată, aceasta împiedică începerea prompturilor de comandă în mijlocul unei linii când comanda anterioară nu s-a încheiat cu newline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включена интеграция с оболочкой, это предотвращает начало приглашения командной строки в середине строки, если предыдущая команда не завершилась переводом строки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnutá integrácia shellu, zabráni to začiatku výziev príkazov uprostred riadka, keď predchádzajúci príkaz neskončil novým riadkom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je omogočena integracija lupine, to prepreči, da bi se ukazni pozivi začeli sredi vrstice, kadar prejšnji ukaz ni končal z znakom za novo vrstico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om skalintegrering är aktiverad förhindrar detta att kommandopromptar börjar mitt på en rad när föregående kommando inte avslutades med en radbrytning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเปิดใช้การผสานรวมเชลล์ ตัวเลือกนี้จะป้องกันไม่ให้พร้อมท์คำสั่งเริ่มต้นกลางบรรทัดเมื่อคำสั่งก่อนหน้าไม่ได้จบด้วยการขึ้นบรรทัดใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabuk Entegrasyonu etkinse, önceki komut satır sonuyla bitmediğinde komut istemlerinin satırın ortasında başlamasını engeller."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо інтеграцію з командним процесором увімкнено, це не дозволяє запрошенням командного рядка починатися посеред рядка, коли попередня команда не завершилася символом нового рядка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu Tích hợp shell được bật, tùy chọn này ngăn dấu nhắc lệnh bắt đầu giữa một dòng khi lệnh trước không kết thúc bằng dòng mới."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用Shell集成后，如果上一条命令未以换行符结尾，可防止命令提示符在行中间开始。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如已啟用 Shell 整合，當上一個指令不是以換行字元結尾時，這可避免指令提示符號從行中間開始。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果启用了 Shell 集成，此选项可防止在上一条命令未以换行结束时，命令提示符从行中间开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若已啟用 Shell 整合，當上一個指令不是以換行字元結尾時，這可避免指令提示符號從行中間開始。"
          }
        }
      }
    },
