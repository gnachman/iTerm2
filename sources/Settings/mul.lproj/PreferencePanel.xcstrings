    "evF-qt-9wo.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"This dims all colors except that of the cursor. A pure white cursor with Smart Cursor Color off is recommended when using cursor boost.\"; ObjectID = \"evF-qt-9wo\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztlumí všechny barvy kromě barvy kurzoru. Při použití zvýraznění kurzoru se doporučuje čistě bílý kurzor s vypnutou chytrou barvou kurzoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette dæmper alle farver undtagen markørens. En helt hvid markør med Smart markørfarve slået fra anbefales, når markørforstærkning bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies dunkelt alle Farben außer der des Cursors ab. Bei Verwendung des Cursor-Boosts wird ein reinweißer Cursor mit deaktivierter intelligenter Cursorfarbe empfohlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This dims all colors except that of the cursor. A pure white cursor with Smart Cursor Color off is recommended when using cursor boost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto atenúa todos los colores excepto el del cursor. Se recomienda un cursor blanco puro con el color inteligente del cursor desactivado al usar el realce del cursor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä himmentää kaikki värit paitsi kohdistimen värin. Täysin valkoista kohdistinta ja pois päältä olevaa älykästä kohdistinväriä suositellaan kohdistimen korostusta käytettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci atténue toutes les couleurs sauf celle du curseur. Un curseur blanc pur avec la couleur de curseur intelligente désactivée est recommandé avec l’accentuation du curseur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenua tutti i colori tranne quello del cursore. Quando usi l’esaltazione del cursore, si consiglia un cursore bianco puro con il colore intelligente del cursore disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはカーソルの色を除くすべての色を暗くします。カーソルブーストを使用する場合は、スマートカーソルカラーをオフにした純白のカーソルを推奨します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서를 제외한 모든 색상을 흐리게 합니다. 커서 부스트를 사용할 때는 스마트 커서 색상을 끄고 순백색 커서를 사용하는 것이 좋습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette demper alle farger unntatt markørens. En helhvit markør med smart markørfarge slått av anbefales når du bruker markørforsterkning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle kleuren gedimd behalve die van de cursor. Een zuiver witte cursor met uitgeschakelde slimme cursorkleur wordt aanbevolen bij gebruik van cursorversterking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciemnia wszystkie kolory oprócz koloru kursora. Przy użyciu wzmocnienia kursora zalecany jest czysto biały kursor z wyłączonym inteligentnym kolorem kursora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto escurece todas as cores exceto a do cursor. Recomenda-se um cursor branco puro com a Cor inteligente do cursor desativada ao usar o realce do cursor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это затемняет все цвета, кроме цвета курсора. При отключённом умном цвете курсора рекомендуется использовать чисто белый курсор при усилении курсора."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlmí všetky farby okrem farby kurzora. Pri použití zvýraznenia kurzora sa odporúča čisto biely kurzor s vypnutou inteligentnou farbou kurzora."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zatemni vse barve razen barve kazalca. Pri uporabi okrepitve kazalca priporočamo čisto beli kazalec z izklopljeno pametno barvo kazalca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta dämpar alla färger utom markörens. En helvit markör med smart markörfärg avstängd rekommenderas när markörförstärkning används."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, imlecinki dışındaki tüm renkleri soluklaştırır. İmleç güçlendirme kullanılırken Akıllı İmleç Rengi kapalıyken saf beyaz bir imleç önerilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục này làm mờ mọi màu trừ màu của con trỏ. Nên dùng con trỏ trắng tinh khi tắt màu con trỏ thông minh lúc dùng tăng cường con trỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会调暗除光标颜色外的所有颜色。使用光标增强时，建议使用纯白光标并关闭智能光标颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會調暗除游標顏色以外的所有顏色。使用游標增強時，建議使用純白游標並關閉智慧型游標顏色。"
          }
        }
      }
    },
