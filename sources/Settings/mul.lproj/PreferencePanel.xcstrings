    "5331.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Dimming affects only text, not background.\"; ObjectID = \"5331\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abdunkelung betrifft nur den Text, nicht den Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dimming affects only text, not background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この暗さの調整はテキストのみに影響し、背景には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐리게 하기가 배경에는 적용되지 않고 텍스트에만 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escurecimento afeta apenas o texto, não o plano de fundo."
          }
        },
        "ru" : {
          "stringUnit" : {
