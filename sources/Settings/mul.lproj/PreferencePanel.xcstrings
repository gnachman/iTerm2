    "hpW-Cl-kBV.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Let macOS decide the position of new windows and use size from profile\"; ObjectID = \"hpW-Cl-kBV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa que el macOS decideixi la posició de les finestres noves i fes servir la mida del perfil"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechat macOS určit pozici nových oken a použít velikost z profilu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad macOS bestemme placeringen af nye vinduer, og brug størrelsen fra profilen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS die Position neuer Fenster entscheiden lassen und Größe aus dem Profil verwenden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS αποφασίζει τη θέση των νέων παραθύρων και χρήση του μεγέθους από το προφίλ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
