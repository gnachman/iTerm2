    "X12-cb-Cnf.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Stretch tabs to fill bar\"; ObjectID = \"X12-cb-Cnf\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roztáhnout panely na celý řádek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stræk faner, så de fylder linjen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs strecken, um die Leiste zu füllen"
