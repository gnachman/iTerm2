            "state" : "translated",
            "value" : "По умолчанию отключать прозрачность для ненативных полноэкранных окон"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvolene vypnúť priehľadnosť pre nenatívne okná na celej obrazovke"
          }
        },
        "sl" : {
