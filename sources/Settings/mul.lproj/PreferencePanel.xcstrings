    "hCs-Sl-Dr2.ibShadowedToolTip" : {
      "comment" : "Class = \"NSSlider\"; ibShadowedToolTip = \"Peak brightness of the HDR cursor, as a multiple of normal white. The display shows at most what its current HDR headroom allows, so higher values may look the same.\"; ObjectID = \"hCs-Sl-Dr2\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximální jas kurzoru HDR jako násobek běžné bílé. Displej zobrazí nejvýše to, co dovoluje jeho aktuální rezerva HDR, takže vyšší hodnoty mohou vypadat stejně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal lysstyrke for HDR-markøren som et multiplum af normal hvid. Skærmen viser højst det, dens aktuelle HDR-råderum tillader, så højere værdier kan se ens ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spitzenhelligkeit des HDR-Cursors als Vielfaches des normalen Weiß. Das Display zeigt höchstens das an, was sein aktueller HDR-Spielraum zulässt, daher können höhere Werte gleich aussehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Peak brightness of the HDR cursor, as a multiple of normal white. The display shows at most what its current HDR headroom allows, so higher values may look the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brillo máximo del cursor HDR, como múltiplo del blanco normal. La pantalla muestra como máximo lo que permite su margen HDR actual, por lo que valores más altos pueden verse igual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR-kohdistimen huippukirkkaus tavallisen valkoisen monikertana. Näyttö näyttää enintään sen, minkä sen nykyinen HDR-vara sallii, joten suuremmat arvot saattavat näyttää samalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosité maximale du curseur HDR, en multiple du blanc normal. L’écran affiche au plus ce que sa marge HDR actuelle permet, des valeurs plus élevées peuvent donc paraître identiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminosità di picco del cursore HDR, come multiplo del bianco normale. Lo schermo mostra al massimo ciò che consente il suo margine HDR attuale, quindi valori più alti potrebbero apparire uguali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRカーソルのピーク輝度（通常の白に対する倍率）。ディスプレイは現在のHDRヘッドルームが許す範囲までしか表示できないため、高い値は同じように見えることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 흰색의 배수로 나타낸 HDR 커서의 최대 밝기입니다. 디스플레이는 현재 HDR 헤드룸이 허용하는 범위까지만 표시하므로 값을 높여도 똑같아 보일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimal lysstyrke for HDR-markøren, som et multiplum av vanlig hvitt. Skjermen viser høyst det den nåværende HDR-marginen tillater, så høyere verdier kan se like ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piekhelderheid van de HDR-cursor, als veelvoud van normaal wit. Het scherm toont hooguit wat de huidige HDR-ruimte toelaat, dus hogere waarden kunnen er hetzelfde uitzien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szczytowa jasność kursora HDR jako wielokrotność zwykłej bieli. Wyświetlacz pokazuje co najwyżej tyle, na ile pozwala jego aktualny zapas HDR, więc wyższe wartości mogą wyglądać tak samo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilho máximo do cursor HDR, como múltiplo do branco normal. O monitor mostra no máximo o que sua margem HDR atual permite, então valores mais altos podem parecer iguais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пиковая яркость HDR-курсора, кратная обычному белому. Дисплей показывает не больше, чем позволяет его текущий запас HDR, поэтому более высокие значения могут выглядеть одинаково."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Špičkový jas kurzora HDR ako násobok normálnej bielej. Displej zobrazí najviac to, čo mu dovoľuje aktuálna rezerva HDR, preto môžu vyššie hodnoty vyzerať rovnako."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Največja svetlost kazalca HDR kot večkratnik navadne bele. Zaslon prikaže največ toliko, kolikor dopušča njegova trenutna rezerva HDR, zato so lahko višje vrednosti videti enako."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högsta ljusstyrka för HDR-markören, som en multipel av normal vit. Skärmen visar högst vad dess aktuella HDR-utrymme tillåter, så högre värden kan se likadana ut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR imlecin tepe parlaklığı, normal beyazın katı olarak. Ekran, geçerli HDR payının izin verdiği kadarını gösterir; bu yüzden daha yüksek değerler aynı görünebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ sáng đỉnh của con trỏ HDR, tính theo bội số của màu trắng thông thường. Màn hình chỉ hiển thị tối đa mức mà dải HDR hiện tại cho phép, nên giá trị cao hơn có thể trông giống nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 光标的峰值亮度，以普通白色的倍数表示。显示器最多只能显示其当前 HDR 余量所允许的亮度，因此较高的值可能看起来相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 游標的峰值亮度，以一般白色的倍數表示。顯示器最多只能顯示其目前 HDR 餘裕所允許的亮度，因此較高的值可能看起來相同。"
          }
        }
      }
    },
