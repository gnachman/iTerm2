    "ttF-JA-0vc.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"Apps can change left option key\"; ObjectID = \"ttF-JA-0vc\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps können die linke Wahltaste ändern"
          }
        },
        "en" : {
