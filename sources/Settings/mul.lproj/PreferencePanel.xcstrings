    "Nhj-1F-dbm.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect.\"; ObjectID = \"Nhj-1F-dbm\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dies aktiviert ist, erweitert Umschalt+Pfeiltaste eine bestehende Auswahl. Wenn keine Auswahl vorhanden ist, hat dies keine Wirkung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When this is enabled, shift+arrow key will extend an existing selection. If there is no selection, this has no effect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを有効にすると、shift+矢印キーで既存の選択範囲を拡張できます。選択範囲がない場合、これは効果がありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando isto estiver ativado, Shift+seta estenderá uma seleção existente. Se não houver seleção, isso não terá efeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это включено, shift+стрелка будет расширять существующее выделение. Если выделения нет, это не имеет эффекта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Shift+方向键将扩展现有选区。如果没有选区，则无效果。"
          }
        }
      }
    },
