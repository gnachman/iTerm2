    "CRE-cb-4lA.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong.\"; ObjectID = \"CRE-cb-4lA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud relace skončí ihned po spuštění a toto nastavení je zapnuto, zůstane otevřená, abyste viděli, co se pokazilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en session slutter umiddelbart efter start, og denne indstilling er slået til, holdes den åben, så du kan se, hvad der gik galt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Sitzung sofort nach dem Start endet und diese Einstellung aktiviert ist, bleibt sie geöffnet, damit Sie sehen können, was schiefgelaufen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If a session ends immediately after starting and this setting is enabled, keep it open so you can see what went wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una sesión termina inmediatamente después de iniciarse y este ajuste está activado, se mantiene abierta para que puedas ver qué salió mal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos istunto päättyy heti käynnistyksen jälkeen ja tämä asetus on käytössä, se pidetään auki, jotta näet mikä meni pieleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une session se termine immédiatement après son démarrage et que ce réglage est activé, la garder ouverte pour que vous puissiez voir ce qui a échoué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se una sessione termina subito dopo l’avvio e questa impostazione è attiva, viene tenuta aperta così puoi vedere cosa è andato storto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションが開始直後に終了し、この設定が有効になっている場合、何が問題だったか確認できるように開いたままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정이 켜져 있으면 세션이 시작 직후 종료되었을 때 무엇이 잘못되었는지 볼 수 있도록 세션을 열어 둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en økt avsluttes rett etter start og denne innstillingen er aktivert, holdes den åpen slik at du kan se hva som gikk galt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als een sessie direct na het starten eindigt en deze instelling is ingeschakeld, blijft de sessie open zodat je kunt zien wat er misging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli sesja kończy się natychmiast po uruchomieniu i to ustawienie jest włączone, pozostaje otwarta, aby można było zobaczyć, co poszło nie tak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se uma sessão terminar imediatamente após iniciar e este ajuste estiver ativado, mantê-la aberta para que você possa ver o que deu errado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сессия завершается сразу после запуска и этот параметр включён, оставлять её открытой, чтобы вы могли увидеть, что пошло не так."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa relácia skončí hneď po spustení a toto nastavenie je zapnuté, zostane otvorená, aby ste videli, čo sa pokazilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če se seja konča takoj po zagonu in je ta nastavitev omogočena, ostane odprta, da lahko vidite, kaj je šlo narobe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om en session avslutas direkt efter start och den här inställningen är på hålls den öppen så att du kan se vad som gick fel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturum başladıktan hemen sonra sona erer ve bu ayar etkinse, neyin ters gittiğini görebilmeniz için açık tutulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu phiên kết thúc ngay sau khi khởi động và cài đặt này được bật, phiên sẽ được giữ mở để bạn xem điều gì đã xảy ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果会话在启动后立即结束且此设置已启用，则保持其打开，以便你查看出了什么问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若工作階段在啟動後立即結束，且已啟用此設定，則保持其打開，以便查看發生了什麼問題。"
          }
        }
      }
    },
