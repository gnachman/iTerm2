    "nN3-pV-Hlq.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you always want it on in alternate screen mode.\"; ObjectID = \"nN3-pV-Hlq\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativní posouvání myší je funkce, která v reakci na kolečko myši nebo gesta posouvání odesílá šipky. Zapněte ji, pokud ji chcete mít v režimu alternativní obrazovky vždy zapnutou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ muserulning er en funktion, der sender piletaster som svar på rullehjul og rullebevægelser. Slå det til, hvis du altid vil have det slået til i alternativ skærmtilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternate Mouse Scroll ist eine Funktion, die als Reaktion auf Mausrad- bzw. Scroll-Gesten Pfeiltasten sendet. Aktivieren Sie dies, wenn Sie es im Alternate-Screen-Modus immer eingeschaltet haben möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alternate Mouse Scroll is a feature that sends arrow keys in response to scroll wheel/scroll gestures. Enable this if you always want it on in alternate screen mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desplazamiento alternativo con el ratón es una función que envía teclas de flecha en respuesta a la rueda o a los gestos de desplazamiento. Actívalo si quieres que esté siempre activo en el modo de pantalla alternativa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoinen hiirivieritys on ominaisuus, joka lähettää nuolinäppäimiä vierityspyörän tai vieritysliikkeiden perusteella. Ota tämä käyttöön, jos haluat sen olevan aina päällä vaihtoehtoisen näytön tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défilement alternatif de la souris envoie des touches fléchées en réponse à la molette ou aux gestes de défilement. Activez-le si vous voulez qu’il soit toujours actif en mode écran alternatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scorrimento alternativo del mouse è una funzione che invia i tasti freccia in risposta alla rotellina o ai gesti di scorrimento. Abilitala se vuoi che sia sempre attiva in modalità schermo alternativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替マウススクロールは、スクロールホイールやスクロールジェスチャーに応じて矢印キーを送信する機能です。代替スクリーンモードで常にこれをオンにしたい場合は有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 마우스 스크롤은 스크롤 휠/스크롤 제스처에 반응하여 화살표 키를 보내는 기능입니다. 대체 화면 모드에서 항상 켜 두려면 이 옵션을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrulling er en funksjon som sender piltaster som svar på rullehjul og rullebevegelser. Aktiver dette hvis du alltid vil ha det på i alternativ skjermmodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatief muisscrollen is een functie die pijltoetsen verstuurt als reactie op het scrolwiel of scrolgebaren. Schakel dit in als je het in de modus alternatief scherm altijd aan wilt hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatywne przewijanie myszą to funkcja, która wysyła klawisze strzałek w odpowiedzi na kółko myszy lub gesty przewijania. Włącz ją, jeśli chcesz, aby zawsze działała w trybie ekranu alternatywnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem alternativa do mouse é um recurso que envia teclas de seta em resposta à roda de rolagem ou aos gestos de rolagem. Ative isto se quiser que fique sempre ativa no modo de tela alternativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Альтернативная прокрутка мышью» отправляет клавиши со стрелками в ответ на прокрутку колёсика мыши или жесты прокрутки. Включите эту настройку, если хотите, чтобы она была всегда активна в альтернативном режиме экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatívne rolovanie myšou je funkcia, ktorá v reakcii na koliesko myši alebo gestá rolovania odosiela klávesy so šípkami. Zapnite ju, ak ju chcete mať v režime alternatívnej obrazovky vždy zapnutú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadomestno pomikanje z miško je funkcija, ki pošilja smerne tipke kot odziv na kolesce miške ali kretnje pomikanja. Omogočite jo, če jo želite imeti vedno vklopljeno v načinu nadomestnega zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternativ musrullning är en funktion som skickar piltangenter som svar på rullningshjul och rullningsgester. Aktivera detta om du alltid vill ha den på i läget alternativ skärm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternatif Fare Kaydırma, kaydırma tekerleği veya kaydırma hareketlerine karşılık ok tuşları gönderen bir özelliktir. Alternatif ekran modunda her zaman açık olmasını istiyorsanız bunu etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn chuột thay thế là tính năng gửi phím mũi tên khi bạn dùng con lăn hoặc cử chỉ cuộn. Hãy bật nếu bạn muốn luôn bật tính năng này ở chế độ màn hình thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用鼠标滚动是一项响应滚轮/滚动手势发送方向键的功能。如果你希望在备用屏幕模式下始终开启，请启用此选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替代滑鼠捲動是一項功能，會因應滾輪或捲動手勢傳送方向鍵。如果你希望在替代螢幕模式下一律開啟，請啟用此選項。"
          }
        }
      }
    },
