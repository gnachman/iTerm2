    "eyh-Oh-a4E.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Remember the position of previously closed windows and use size from profile\"; ObjectID = \"eyh-Oh-a4E\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamatovat si pozici dříve zavřených oken a použít velikost z profilu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk placeringen af tidligere lukkede vinduer, og brug størrelsen fra profilen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position zuvor geschlossener Fenster merken und Größe aus dem Profil verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remember the position of previously closed windows and use size from profile"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordar la posición de las ventanas cerradas anteriormente y usar el tamaño del perfil"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muista aiemmin suljettujen ikkunoiden sijainti ja käytä profiilin kokoa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoriser la position des fenêtres fermées précédemment et utiliser la taille du profil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorda la posizione delle finestre chiuse in precedenza e usa le dimensioni del profilo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前に閉じたウィンドウの位置を記憶し、サイズはプロファイルから使用する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 닫은 윈도우의 위치를 기억하고 크기는 프로파일 설정 사용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Husk posisjonen til tidligere lukkede vinduer og bruk størrelsen fra profilen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onthoud de positie van eerder gesloten vensters en gebruik de grootte uit het profiel"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamiętuj pozycję wcześniej zamkniętych okien i używaj rozmiaru z profilu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrar a posição de janelas fechadas anteriormente e usar o tamanho do perfil"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запоминать положение ранее закрытых окон и использовать размер из профиля"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapamätať si polohu predtým zatvorených okien a použiť veľkosť z profilu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomni si položaj prej zaprtih oken in uporabi velikost iz profila"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom ihåg positionen för tidigare stängda fönster och använd storleken från profilen"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce kapatılan pencerelerin konumunu hatırla ve boyutu profilden kullan"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi nhớ vị trí của các cửa sổ đã đóng trước đó và dùng kích thước từ hồ sơ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记住先前关闭窗口的位置并使用配置文件中的大小"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記住先前關閉視窗的位置，並使用描述檔中的大小"
          }
        }
      }
    },
