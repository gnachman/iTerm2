            "value" : "Forzar sólo una vez por sesión, cuando recibe el foco del teclado por primera vez"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakota vain kerran istuntoa kohti, kun se saa ensimmäisen kerran näppäimistön kohdistuksen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne forcer qu’une fois par session, au premier focus clavier"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne forcer qu’une fois par session, au premier focus clavier"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रति सत्र केवल एक बार बाध्य करें, जब उसे पहली बार कीबोर्ड फ़ोकस मिले"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisili samo jednom po sesiji kad prvi put dobije fokus tipkovnice"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
