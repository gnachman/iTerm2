    "YoO-mR-uX5.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"When enabled, terminals are rendered using the GPU. This improves performance.\"; ObjectID = \"YoO-mR-uX5\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si està activat, els terminals es renderitzen amb la GPU. Això millora el rendiment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, terminály se vykreslují pomocí GPU. To zlepšuje výkon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er slået til, gengives terminaler med GPU’en. Det forbedrer ydelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Terminals mit der GPU gerendert. Dies verbessert die Leistung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργοποιημένο, τα τερματικά αποδίδονται με χρήση της GPU. Αυτό βελτιώνει τις επιδόσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, terminals are rendered using the GPU. This improves performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las terminales se renderizan con la GPU. Esto mejora el rendimiento."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las terminales se renderizan con la GPU. Esto mejora el rendimiento."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, las terminales se renderizan con la GPU. Esto mejora el rendimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on käytössä, päätteet renderöidään GPU:lla. Tämä parantaa suorituskykyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les terminaux sont rendus avec le GPU, ce qui améliore les performances."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les terminaux sont rendus avec le GPU, ce qui améliore les performances."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, टर्मिनल GPU से रेंडर किए जाते हैं। इससे प्रदर्शन बेहतर होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je omogućeno, terminali se renderiraju pomoću GPU-a. To poboljšava performanse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a terminálok renderelése a GPU-val történik. Ez javítja a teljesítményt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, terminal dirender menggunakan GPU. Ini meningkatkan performa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, i terminali vengono renderizzati con la GPU. Questo migliora le prestazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、ターミナルはGPUを使用して描画されます。これによりパフォーマンスが向上します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 GPU를 사용하여 터미널을 렌더링합니다. 이렇게 하면 성능이 향상됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila didayakan, terminal dipaparkan menggunakan GPU. Ini meningkatkan prestasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, gjengis terminaler med GPU-en. Dette forbedrer ytelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, worden terminals met de GPU weergegeven. Dit verbetert de prestaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest włączona, terminale są renderowane przy użyciu GPU. Poprawia to wydajność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os terminais são renderizados usando a GPU. Isto melhora o desempenho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os terminais são renderizados usando a GPU. Isto melhora o desempenho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activată, terminalele sunt randate folosind GPU. Aceasta îmbunătățește performanța."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если этот параметр включён, терминалы отрисовываются с использованием GPU. Это повышает производительность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, terminály sa vykresľujú pomocou GPU. Zlepšuje to výkon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je to omogočeno, se terminali upodabljajo z GPU. To izboljša zmogljivost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När detta är på renderas terminaler med GPU:n. Det förbättrar prestandan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ เทอร์มินัลจะถูกเรนเดอร์โดยใช้ GPU ซึ่งช่วยปรับปรุงประสิทธิภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde terminaller GPU kullanılarak işlenir. Bu, performansı artırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ввімкнено, термінали рендеряться за допомогою GPU. Це покращує продуктивність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, terminal được kết xuất bằng GPU. Điều này cải thiện hiệu năng."
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，终端会使用GPU渲染。这可以提升性能。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，終端機會使用 GPU 繪製。這可提升效能。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，终端使用 GPU 渲染。这可以提高性能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，終端機會使用 GPU 繪製。這可提升效能。"
          }
        }
      }
    },
