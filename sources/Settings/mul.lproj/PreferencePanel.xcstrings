            "value" : "Eine Sitzung kann die Fenstergröße ändern, auch wenn sie sich in einem nicht ausgewählten Tab/Bereich befindet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションは、選択されていないタブ/ペインにある場合でもウィンドウをリサイズすることがあります"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sessão pode fazer a janela ser redimensionada mesmo estando em uma aba/painel não selecionado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессия может вызывать изменение размера окна, даже если она находится в невыбранной вкладке или панели"
