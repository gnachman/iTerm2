    "4499.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Show tab bar even when there is only one tab\"; ObjectID = \"4499\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
