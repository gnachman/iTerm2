    "upX-YT-gci.ibExternalAccessibilityDescription" : {
      "comment" : "Class = \"NSButton\"; ibExternalAccessibilityDescription = \"A session may cause the window to resize even if it is in an unselected tab/pane\"; ObjectID = \"upX-YT-gci\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessió pot fer que la finestra canviï de mida encara que sigui en una pestanya o subfinestra no seleccionada"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relace může způsobit změnu velikosti okna, i když je v nevybraném panelu nebo podokně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session kan få vinduet til at ændre størrelse, selv om den er i en fane eller rude, der ikke er valgt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sitzung kann die Fenstergröße ändern, auch wenn sie sich in einem nicht ausgewählten Tab/Bereich befindet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια συνεδρία μπορεί να προκαλέσει αλλαγή μεγέθους του παραθύρου ακόμη και αν βρίσκεται σε μη επιλεγμένη καρτέλα ή πλαίσιο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "en-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session may cause the window to resize even if it is in an unselected tab/pane"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión puede hacer que la ventana cambie de tamaño aunque esté en una pestaña o panel no seleccionado"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión puede hacer que la ventana cambie de tamaño aunque esté en una pestaña o panel no seleccionado"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión puede hacer que la ventana cambie de tamaño aunque esté en una pestaña o panel no seleccionado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istunto voi muuttaa ikkunan kokoa, vaikka se olisi valitsemattomassa välilehdessä tai paneelissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session peut redimensionner la fenêtre même si elle se trouve dans un onglet ou un volet non sélectionné"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session peut redimensionner la fenêtre même si elle se trouve dans un onglet ou un volet non sélectionné"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई सत्र विंडो का आकार बदल सकता है, भले ही वह अचयनित टैब/पेन में हो"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesija može uzrokovati promjenu veličine prozora čak i ako je u neodabranoj kartici ili oknu"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy munkamenet akkor is átméretezheti az ablakot, ha nem kijelölt lapon vagy panelen van"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi dapat membuat jendela berubah ukuran meskipun berada di tab/panel yang tidak dipilih"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sessione può far ridimensionare la finestra anche se si trova in un pannello o riquadro non selezionato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションは、選択されていないタブ/ペインにある場合でもウィンドウをリサイズすることがあります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 선택되지 않은 탭/패널에 있어도 윈도우 크기를 조절할 수 있음"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi boleh menyebabkan tetingkap diubah saiz walaupun ia berada dalam tab/anak tetingkap yang tidak dipilih"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En økt kan få vinduet til å endre størrelse selv om den er i en fane eller rute som ikke er valgt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een sessie kan het formaat van het venster wijzigen, ook als die in een niet-geselecteerd tabblad of paneel staat"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesja może zmienić rozmiar okna, nawet jeśli znajduje się w niezaznaczonej karcie lub panelu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sessão pode fazer a janela ser redimensionada mesmo estando em uma aba/painel não selecionado"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma sessão pode fazer com que a janela seja redimensionada mesmo estando num separador/painel não selecionado"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sesiune poate determina redimensionarea ferestrei chiar dacă se află într-o filă sau într-un panou neselectat"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессия может вызывать изменение размера окна, даже если она находится в невыбранной вкладке или панели"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relácia môže spôsobiť zmenu veľkosti okna, aj keď je v nevybranom tabe alebo paneli"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja lahko povzroči spremembo velikosti okna, tudi če je v neizbranem zavihku ali podoknu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En session kan få fönstret att ändra storlek även om den ligger i en omarkerad flik eller panel"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชั่นอาจทำให้หน้าต่างเปลี่ยนขนาดแม้อยู่ในแถบหรือบานหน้าต่างที่ไม่ได้เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir oturum, seçili olmayan bir sekme veya bölmede olsa bile pencerenin yeniden boyutlanmasına neden olabilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс може змінювати розмір вікна, навіть якщо він на невибраній вкладці чи панелі"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phiên có thể khiến cửa sổ đổi kích thước dù nó nằm trong tab hoặc khung không được chọn"
          }
        },
        "yue-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使会话位于未选中的标签页或窗格中，也可能导致窗口调整大小"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使工作階段位於未選取的分頁或窗格中，也可能導致視窗調整大小"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使会话位于未选中的标签页/窗格中，也可能导致窗口调整大小"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使工作階段位於未選取的標籤頁或窗格中，也可能導致視窗調整大小"
          }
        }
      }
    },
