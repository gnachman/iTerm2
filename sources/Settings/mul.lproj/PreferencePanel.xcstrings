        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정이 켜진 세션이 있는 동안 시스템이 잠자기에 들어가지 않게 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
