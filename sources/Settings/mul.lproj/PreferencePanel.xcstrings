            "value" : "Privzeto onemogoči prosojnost za neizvorna okna v celozaslonskem načinu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaktivera transparens för icke-inbyggda helskärmsfönster som förval"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel olmayan tam ekran pencerelerde saydamlığı varsayılan olarak devre dışı bırak"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định tắt độ trong suốt cho cửa sổ toàn màn hình không gốc"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认停用非原生全屏幕窗口的透明度"
          }
        },
        "zh-Hant" : {
