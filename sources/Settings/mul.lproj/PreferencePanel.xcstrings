    "6377.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"If enabled, changes to font size will try to preserve session dimensions.\"; ObjectID = \"6377\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je-li zapnuto, změny velikosti písma se pokusí zachovat rozměry relace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis dette er slået til, forsøger ændringer af skriftstørrelsen at bevare sessionens dimensioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird bei Änderungen der Schriftgröße versucht, die Sitzungsabmessungen beizubehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If enabled, changes to font size will try to preserve session dimensions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, los cambios en el tamaño del tipo de letra intentarán conservar las dimensiones de la sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on käytössä, fonttikoon muutokset yrittävät säilyttää istunnon mitat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, les changements de taille de police tenteront de préserver les dimensions de la session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è attivo, le modifiche alla dimensione del font cercheranno di mantenere le dimensioni della sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、フォントサイズの変更時にセッションの寸法を維持しようとします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 서체 크기를 변경할 때 세션 크기를 유지하려고 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er aktivert, prøver endringer i fontstørrelsen å beholde øktens dimensjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is ingeschakeld, proberen wijzigingen van de lettertypegrootte de afmetingen van de sessie te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli ta opcja jest włączona, zmiany rozmiaru czcionki będą próbowały zachować wymiary sesji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ativado, as alterações no tamanho da fonte tentarão preservar as dimensões da sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, изменения размера шрифта будут пытаться сохранить размеры сессии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je zapnuté, zmeny veľkosti písma sa pokúsia zachovať rozmery relácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je omogočeno, bodo spremembe velikosti pisave poskusile ohraniti mere seje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om detta är på försöker ändringar av typsnittsstorleken behålla sessionens mått."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirilirse font boyutu değişiklikleri oturum boyutlarını korumaya çalışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
