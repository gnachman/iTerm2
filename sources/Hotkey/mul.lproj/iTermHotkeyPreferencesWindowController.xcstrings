    "3jk-f9-QFs.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Pin hotkey window (stays open on loss of keyboard focus)\"; ObjectID = \"3jk-f9-QFs\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připnout okno horké klávesy (zůstane otevřené po ztrátě fokusu klávesnice)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fastgør genvejstastvindue (forbliver åbent, når tastaturfokus mistes)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotkey-Fenster anheften (bleibt geöffnet, wenn es den Tastaturfokus verliert)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καρφίτσωμα παραθύρου πλήκτρου άμεσης πρόσβασης (παραμένει ανοιχτό όταν χάνεται η εστίαση πληκτρολογίου)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin hotkey window (stays open on loss of keyboard focus)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijar ventana de tecla rápida (permanece abierta al perder el foco del teclado)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinnitä pikanäppäinikkuna (pysyy auki, kun näppäimistökohdistus menetetään)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épingler la fenêtre à raccourci global (reste ouverte quand le clavier perd le focus)"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हॉटकी विंडो पिन करें (कीबोर्ड फ़ोकस हटने पर भी खुली रहती है)"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakvači prozor brze tipke (ostaje otvoren kad izgubi fokus tipkovnice)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyorsbillentyűs ablak kitűzése (megmarad, ha a billentyűzetfókusz elvész)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin jendela tombol pintas (tetap terbuka saat fokus papan ketik hilang)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa finestra ad abbreviazione globale (resta aperta quando perde il focus della tastiera)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットキーウインドウを固定する（キーボードフォーカスを失っても開いたままにする）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키 윈도우 고정(키보드 포커스를 잃어도 열린 상태 유지)"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin tetingkap kekunci panas (kekal terbuka apabila fokus papan kekunci hilang)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fest hurtigtastvindu (forblir åpent når tastaturfokus går tapt)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak sneltoetsvenster vast (blijft open als het toetsenbordfocus verliest)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypnij okno klawisza skrótu (pozostaje otwarte po utracie fokusu klawiatury)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixar janela de hotkey (permanece aberta ao perder o foco do teclado)"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixați fereastra cu tastă rapidă (rămâne deschisă la pierderea focalizării tastaturii)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепить окно горячей клавиши (остаётся открытым при потере фокуса клавиатуры)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripnúť okno aktivačnej skratky (zostane otvorené po strate fokusu klávesnice)"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripni okno hitre tipke (ostane odprto ob izgubi fokusa tipkovnice)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fäst snabbtangentsfönster (förblir öppet när tangentbordsfokus förloras)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayol tuşu penceresini sabitle (klavye odağı kaybolunca açık kalır)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закріпити вікно гарячої клавіші (залишається відкритим, коли клавіатура втрачає фокус)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghim cửa sổ phím nóng (vẫn mở khi mất tiêu điểm bàn phím)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定热键窗口（失去键盘焦点时保持打开）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釘選全域快速鍵視窗（失去鍵盤焦點時保持打開）"
          }
        }
      }
    },
