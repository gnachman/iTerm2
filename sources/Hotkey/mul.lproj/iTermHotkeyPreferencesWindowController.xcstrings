    "dHI-y9-qMI.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"When you press the hotkey bound to this profile a dedicated window will show or hide. Each profile with a hotkey controls its own Hotkey Window.\"; ObjectID = \"dHI-y9-qMI\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po stisknutí horké klávesy přiřazené k tomuto profilu se zobrazí nebo skryje vyhrazené okno. Každý profil s horkou klávesou ovládá své vlastní okno horké klávesy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du trykker på den genvejstast, der er knyttet til denne profil, vises eller skjules et dedikeret vindue. Hver profil med en genvejstast styrer sit eget genvejstastvindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie den diesem Profil zugewiesenen Hotkey drücken, wird ein dediziertes Fenster ein- oder ausgeblendet. Jedes Profil mit einem Hotkey steuert sein eigenes Hotkey-Fenster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν πατάτε το πλήκτρο άμεσης πρόσβασης που έχει αντιστοιχιστεί σε αυτό το προφίλ, ένα ειδικό παράθυρο θα εμφανίζεται ή θα αποκρύπτεται. Κάθε προφίλ με πλήκτρο άμεσης πρόσβασης ελέγχει το δικό του παράθυρο πλήκτρου άμεσης πρόσβασης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you press the hotkey bound to this profile a dedicated window will show or hide. Each profile with a hotkey controls its own Hotkey Window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pulsar la tecla rápida asignada a este perfil, se mostrará u ocultará una ventana dedicada. Cada perfil con una tecla rápida controla su propia ventana de tecla rápida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun painat tähän profiiliin sidottua pikanäppäintä, oma ikkuna näytetään tai kätketään. Jokainen pikanäppäimellä varustettu profiili ohjaa omaa pikanäppäinikkunaansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous appuyez sur le raccourci global associé à ce profil, une fenêtre dédiée s’affiche ou se masque. Chaque profil doté d’un raccourci global contrôle sa propre fenêtre à raccourci global."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्रोफ़ाइल से जुड़ी हॉटकी दबाने पर एक समर्पित विंडो दिखेगी या छिप जाएगी। हॉटकी वाला हर प्रोफ़ाइल अपनी हॉटकी विंडो को नियंत्रित करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad pritisnete brzu tipku dodijeljenu ovom profilu, namjenski prozor bit će prikazan ili sakriven. Svaki profil s brzom tipkom upravlja vlastitim prozorom brze tipke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilhoz rendelt gyorsbillentyű lenyomásakor egy dedikált ablak jelenik meg vagy rejtőzik el. Minden gyorsbillentyűvel rendelkező profil a saját gyorsbillentyűs ablakát vezérli."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda menekan tombol pintas yang terikat ke profil ini, jendela khusus akan ditampilkan atau disembunyikan. Setiap profil dengan tombol pintas mengendalikan Jendela Tombol Pintasnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando premi l’abbreviazione globale associata a questo profilo, una finestra dedicata viene mostrata o nascosta. Ogni profilo con un’abbreviazione globale controlla la propria finestra ad abbreviazione globale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルに割り当てられたホットキーを押すと、専用のウインドウが表示または非表示になります。ホットキーを持つ各プロファイルは、それぞれ独自のホットキーウインドウを制御します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로파일에 지정된 단축키를 누르면 전용 윈도우가 보이거나 가려집니다. 단축키가 있는 각 프로파일은 자체 단축키 윈도우를 제어합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila anda menekan kekunci panas yang terikat pada profil ini, tetingkap khusus akan ditunjukkan atau disembunyikan. Setiap profil dengan kekunci panas mengawal Tetingkap Kekunci Panasnya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du trykker på hurtigtasten som er knyttet til denne profilen, vises eller skjules et eget vindu. Hver profil med en hurtigtast styrer sitt eget hurtigtastvindu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je de sneltoets voor dit profiel indrukt, wordt een apart venster getoond of verborgen. Elk profiel met een sneltoets bedient zijn eigen sneltoetsvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po naciśnięciu klawisza skrótu przypisanego do tego profilu dedykowane okno zostanie pokazane lub ukryte. Każdy profil z klawiszem skrótu steruje własnym oknem klawisza skrótu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao pressionar a hotkey vinculada a este perfil, uma janela dedicada será exibida ou ocultada. Cada perfil com uma hotkey controla sua própria janela de hotkey."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când apăsați tasta rapidă asociată acestui profil, o fereastră dedicată se va afișa sau se va ascunde. Fiecare profil cu o tastă rapidă controlează propria fereastră cu tastă rapidă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При нажатии горячей клавиши, привязанной к этому профилю, отдельное окно будет показано или скрыто. Каждый профиль с горячей клавишей управляет своим собственным окном горячей клавиши."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po stlačení aktivačnej skratky priradenej tomuto profilu sa zobrazí alebo skryje vyhradené okno. Každý profil s aktivačnou skratkou ovláda vlastné okno aktivačnej skratky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko pritisnete hitro tipko, dodeljeno temu profilu, se namensko okno prikaže ali skrije. Vsak profil s hitro tipko upravlja svoje okno hitre tipke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du trycker på snabbtangenten som är kopplad till den här profilen visas eller göms ett dedikerat fönster. Varje profil med en snabbtangent styr sitt eget snabbtangentsfönster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu profile atanan kısayol tuşuna bastığınızda ayrılmış bir pencere görünür veya gizlenir. Kısayol tuşu olan her profil kendi Kısayol Tuşu Penceresini denetler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви натискаєте гарячу клавішу, призначену цьому профілю, відповідне вікно показується або ховається. Кожен профіль із гарячою клавішею керує власним вікном гарячої клавіші."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn nhấn phím nóng gán cho hồ sơ này, một cửa sổ riêng sẽ hiển thị hoặc ẩn. Mỗi hồ sơ có phím nóng điều khiển cửa sổ phím nóng của riêng nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下此配置文件绑定的热键时，专用窗口将显示或隐藏。每个带热键的配置文件都控制自己的热键窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下與此描述檔綁定的全域快速鍵時，專用視窗會顯示或隱藏。每個設有全域快速鍵的描述檔都控制各自的全域快速鍵視窗。"
          }
        }
      }
    },
    "EOt-Jx-9Xl.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Don’t do anything special\"; ObjectID = \"EOt-Jx-9Xl\";",
