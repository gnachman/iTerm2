    "Njf-zs-yLP.title" : {
      "comment" : "Class = \"NSButtonCell\"; title = \"Show this Hotkey Window if no other window is open\"; ObjectID = \"Njf-zs-yLP\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit toto okno horké klávesy, pokud není otevřeno žádné jiné okno"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis dette genvejstastvindue, hvis der ikke er andre vinduer åbne"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Hotkey-Fenster anzeigen, wenn kein anderes Fenster geöffnet ist"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση αυτού του παραθύρου πλήκτρου άμεσης πρόσβασης αν δεν είναι ανοιχτό άλλο παράθυρο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show this Hotkey Window if no other window is open"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar esta ventana de tecla rápida si no hay otra ventana abierta"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä tämä pikanäppäinikkuna, jos mikään muu ikkuna ei ole auki"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher cette fenêtre à raccourci global si aucune autre fenêtre n’est ouverte"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अन्य विंडो खुली न होने पर यह हॉटकी विंडो दिखाएँ"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži ovaj prozor brze tipke ako nijedan drugi prozor nije otvoren"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyorsbillentyűs ablak megjelenítése, ha nincs más ablak megnyitva"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan Jendela Tombol Pintas ini jika tidak ada jendela lain yang terbuka"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra questa finestra ad abbreviazione globale se non ci sono altre finestre aperte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のウインドウが開いていない場合はこのホットキーウインドウを表示する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려 있는 다른 윈도우가 없으면 이 단축키 윈도우 보기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan Tetingkap Kekunci Panas ini jika tiada tetingkap lain dibuka"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis dette hurtigtastvinduet hvis ingen andre vinduer er åpne"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon dit sneltoetsvenster als er geen ander venster open is"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż to okno klawisza skrótu, jeśli nie jest otwarte żadne inne okno"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar esta janela de hotkey se nenhuma outra janela estiver aberta"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați această fereastră cu tastă rapidă dacă nu este deschisă nicio altă fereastră"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать это окно горячей клавиши, если не открыто ни одно другое окно"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť toto okno aktivačnej skratky, ak nie je otvorené žiadne iné okno"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži to okno hitre tipke, če ni odprto nobeno drugo okno"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa det här snabbtangentsfönstret om inget annat fönster är öppet"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka pencere açık değilse bu Kısayol Tuşu Penceresini göster"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати це вікно гарячої клавіші, якщо немає інших відкритих вікон"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị cửa sổ phím nóng này nếu không có cửa sổ nào khác đang mở"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果没有其他窗口打开，则显示此热键窗口"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有其他視窗打開時，顯示此全域快速鍵視窗"
          }
        }
      }
    },
    "NTW-IM-ZXD.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"Floating windows overlap other windows and the dock, and other apps’ Full Screen windows (if the Hotkey Window’s Space is set to All Spaces).\"; ObjectID = \"NTW-IM-ZXD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plovoucí okna překrývají ostatní okna, Dock a okna ostatních aplikací v režimu celé obrazovky (pokud je plocha okna horké klávesy nastavena na Všechny plochy)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flydende vinduer ligger oven på andre vinduer, Dock og andre programmers vinduer i fuld skærm (hvis genvejstastvinduets skrivebord er indstillet til Alle skriveborde)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebende Fenster überlagern andere Fenster und das Dock sowie Vollbildfenster anderer Apps (wenn für den Schreibtisch des Hotkey-Fensters „Alle Schreibtische“ eingestellt ist)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αιωρούμενα παράθυρα επικαλύπτουν άλλα παράθυρα, το Dock και τα παράθυρα πλήρους οθόνης άλλων εφαρμογών (αν το γραφείο εργασίας του παραθύρου πλήκτρου άμεσης πρόσβασης έχει οριστεί σε «Όλα τα γραφεία εργασίας»)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating windows overlap other windows and the dock, and other apps’ Full Screen windows (if the Hotkey Window’s Space is set to All Spaces)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas flotantes se superponen a otras ventanas, al Dock y a las ventanas en pantalla completa de otras apps (si el espacio de la ventana de tecla rápida está configurado como Todos los espacios)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelluvat ikkunat peittävät muut ikkunat, Dockin ja muiden sovellusten koko näytön ikkunat (jos pikanäppäinikkunan työpöytä on asetettu kaikille työpöydille)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres flottantes recouvrent les autres fenêtres, le Dock et les fenêtres en plein écran des autres apps (si l’espace de la fenêtre à raccourci global est réglé sur Tous les espaces)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लोटिंग विंडो अन्य विंडो, Dock और अन्य ऐप्लिकेशन की फ़ुल स्क्रीन विंडो के ऊपर दिखती हैं (यदि हॉटकी विंडो का स्पेस “सभी स्पेस” पर सेट हो)।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plutajući prozori preklapaju druge prozore i Dock te prozore drugih aplikacija u prikazu preko cijelog zaslona (ako je radna površina prozora brze tipke postavljena na Sve radne površine)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lebegő ablakok átfedik a többi ablakot, a Dockot és más alkalmazások teljes képernyős ablakait (ha a gyorsbillentyűs ablak Spaces-íróasztala az összes Spaces-íróasztalra van állítva)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jendela mengambang menimpa jendela lain, Dock, dan jendela Layar Penuh app lain (jika Space Jendela Tombol Pintas diatur ke Semua Spaces)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre mobili si sovrappongono alle altre finestre, al Dock e alle finestre a tutto schermo di altre app (se lo spazio della finestra ad abbreviazione globale è impostato su Tutti gli spazi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングウインドウは、他のウインドウやDock、および他のアプリのフルスクリーンウインドウ（ホットキーウインドウのSpaceが「すべてのSpace」に設定されている場合）の上に重なって表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 윈도우는 다른 윈도우와 Dock, 그리고 다른 앱의 전체 화면 윈도우 위에 겹쳐 표시됩니다(단축키 윈도우의 데스크탑이 모든 데스크탑으로 설정된 경우)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetingkap terapung bertindih dengan tetingkap lain dan dock, serta tetingkap Skrin Penuh app lain (jika Space Tetingkap Kekunci Panas ditetapkan kepada Semua Space)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytende vinduer legger seg over andre vinduer, Dock og andre appers fullskjermvinduer (hvis arbeidsområdet til hurtigtastvinduet er satt til Alle arbeidsområder)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwevende vensters overlappen andere vensters, het Dock en schermvullende vensters van andere apps (als de Space van het sneltoetsvenster is ingesteld op Alle Spaces)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okna pływające nakładają się na inne okna, Dock oraz okna pełnoekranowe innych aplikacji (jeśli biurko okna klawisza skrótu jest ustawione na Wszystkie biurka)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janelas flutuantes se sobrepõem a outras janelas e ao Dock, e às janelas em tela cheia de outros apps (se o espaço da janela de hotkey estiver definido como Todos os espaços)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferestrele flotante se suprapun peste alte ferestre, peste Dock și peste ferestrele pe tot ecranul ale altor aplicații (dacă spațiul ferestrei cu tastă rapidă este setat la Toate spațiile)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавающие окна перекрывают другие окна и Dock, а также полноэкранные окна других приложений (если пространству окна горячей клавиши назначены все пространства)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plávajúce okná sa prekrývajú s inými oknami, Dockom a oknami iných apiek na celej obrazovke (ak je plocha okna aktivačnej skratky nastavená na Všetky plochy)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plavajoča okna prekrivajo druga okna, Dock in celozaslonska okna drugih aplikacij (če je namizje okna hitre tipke nastavljeno na vsa namizja)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytande fönster ligger över andra fönster, Dock och andra programs helskärmsfönster (om snabbtangentsfönstrets Space är inställt på Alla Spaces)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzen pencereler diğer pencerelerin, Dock’un ve (Kısayol Tuşu Penceresinin alanı Tüm Alanlar olarak ayarlıysa) diğer uygulamaların Tam Ekran pencerelerinin üzerinde görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавучі вікна перекривають інші вікна, Dock і повноекранні вікна інших програм (якщо для простору вікна гарячої клавіші вибрано «Усі простори»)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ nổi nằm đè lên các cửa sổ khác, Dock và cửa sổ toàn màn hình của ứng dụng khác (nếu không gian của cửa sổ phím nóng được đặt là Tất cả không gian)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮动窗口会与其他窗口和 Dock 以及其他应用的“全屏幕”窗口重叠（如果热键窗口的空间设置为“所有空间”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浮動視窗會與其他視窗、Dock 以及其他 App 的全螢幕視窗重疊（如果全域快速鍵視窗的空間設為「所有空間」）。"
          }
        }
      }
    },
