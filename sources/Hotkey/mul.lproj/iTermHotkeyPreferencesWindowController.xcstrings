    "6tA-bg-olR.ibShadowedToolTip" : {
      "comment" : "Class = \"NSButton\"; ibShadowedToolTip = \"Note: the window is reopened only if it was closed because another app became active.\"; ObjectID = \"6tA-bg-olR\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: okno se znovu otevře, jen pokud bylo zavřeno proto, že se aktivovala jiná aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Vinduet åbnes kun igen, hvis det blev lukket, fordi et andet program blev aktivt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Das Fenster wird nur dann erneut geöffnet, wenn es geschlossen wurde, weil eine andere App aktiv wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημείωση: το παράθυρο ανοίγει ξανά μόνο αν είχε κλείσει επειδή ενεργοποιήθηκε άλλη εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: the window is reopened only if it was closed because another app became active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: la ventana solo se vuelve a abrir si se cerró porque otra app pasó a estar activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa: ikkuna avataan uudelleen vain, jos se suljettiin, koska toinen sovellus aktivoitui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : la fenêtre n’est rouverte que si elle a été fermée parce qu’une autre app est devenue active."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट : विंडो तभी फिर से खुलती है जब उसे किसी अन्य ऐप के सक्रिय होने के कारण बंद किया गया हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napomena: prozor se ponovno otvara samo ako je zatvoren zato što je druga aplikacija postala aktivna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjegyzés: az ablak csak akkor nyílik meg újra, ha azért záródott be, mert egy másik alkalmazás vált aktívvá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan: jendela hanya dibuka kembali jika ditutup karena app lain menjadi aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: la finestra viene riaperta solo se è stata chiusa perché un’altra app è diventata attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注: このウインドウは、他のアプリがアクティブになったために閉じられた場合にのみ再度開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 다른 앱이 활성화되어 윈도우가 닫힌 경우에만 윈도우가 다시 열립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: tetingkap hanya dibuka semula jika ia ditutup kerana app lain menjadi aktif."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk: Vinduet åpnes bare igjen hvis det ble lukket fordi en annen app ble aktivt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: het venster wordt alleen opnieuw geopend als het is gesloten doordat een andere app actief werd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: okno jest ponownie otwierane tylko wtedy, gdy zostało zamknięte, ponieważ aktywna stała się inna aplikacja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: a janela só é reaberta se tiver sido fechada porque outro app se tornou ativo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notă: fereastra se redeschide numai dacă a fost închisă deoarece o altă aplicație a devenit activă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: окно открывается повторно, только если оно было закрыто из-за активации другого приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka: okno sa znova otvorí, len ak bolo zatvorené preto, že sa aktivovala iná apka."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opomba: okno se znova odpre le, če je bilo zaprto zato, ker je postala aktivna druga aplikacija."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs! Fönstret öppnas igen endast om det stängdes för att ett annat program blev aktivt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not: Pencere yalnızca başka bir uygulama etkin hale geldiği için kapatıldıysa yeniden açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примітка: вікно знову відкривається, лише якщо його було закрито через активацію іншої програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ý: cửa sổ chỉ được mở lại nếu nó bị đóng do một ứng dụng khác trở thành ứng dụng đang hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：仅当窗口因其他应用变为活动而关闭时，才会重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：只有在視窗是因為其他 App 變成使用中而關閉時，才會重新打開。"
          }
        }
      }
    },
